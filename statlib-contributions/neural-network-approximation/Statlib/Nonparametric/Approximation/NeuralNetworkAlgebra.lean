        (fun a y => ∏ q, (y (a.snd q) - center (a.snd q))) x with hPdef
    have htri : |N.realize x - f x| ≤ |N.realize x - P x| + |P x - f x| := by
      have hsum : (N.realize x - P x) + (P x - f x) = N.realize x - f x := by ring
      rw [← hsum]
