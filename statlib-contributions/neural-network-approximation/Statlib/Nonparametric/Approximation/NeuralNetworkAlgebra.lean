theorem exists_fullyConnectedReLUNet_holderSmooth_local_approx_on_centered_box
    {d r : ℕ} (hd : 0 < d) {beta C B R rho ε : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (hR : 0 < R) (hε : 0 < ε)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center : Fin d → ℝ) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      ∀ x : Fin d → ℝ,
        (∀ q : Fin d, |x q - center q| ≤ R) →
        ‖x - center‖ ≤ rho →
          |N.realize x - f x| ≤
            ε + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
  rcases exists_fullyConnectedReLUNet_taylor_polynomial_approx_on_centered_box
    (d := d) (r := r) hd (R := R) (ε := ε) hR hε f center with ⟨N, hNdepth, hNapprox⟩
  refine ⟨N, hNdepth, ?_⟩
  intro x hxbox hxnorm
  let T : ℝ :=
    ∑ k ∈ Finset.range (r + 1),
      (↑k.factorial)⁻¹ *
        (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)
  have hNapp : |N.realize x - T| ≤ ε := by
    dsimp [T]
    exact hNapprox x hxbox
  have hTaylorRem :
      |f x - T| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
    dsimp [T]
    exact holderSmoothBall_taylor_remainder_bound_on_box hbeta_nonneg hC hrho f hf center x hxnorm
  have hTf : |T - f x| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
    rwa [abs_sub_comm] at hTaylorRem
  calc
    |N.realize x - f x| ≤ |N.realize x - T| + |T - f x| := by
      have hsub : N.realize x - f x = (N.realize x - T) + (T - f x) := by ring
      rw [hsub]
      simpa [Real.norm_eq_abs] using (norm_add_le (N.realize x - T) (T - f x))
    _ ≤ ε + (C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta)) := by
      exact add_le_add hNapp hTf

