  intro x hbox hnorm
  let T : ℝ :=
    ∑ k ∈ Finset.range (r + 1),
      ((Nat.factorial k : ℝ)⁻¹) *
        (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)
  have hTaylorErr :
      |N.realize x - T| ≤
        finiteCenteredMonomialPolynomialApproxError R n
