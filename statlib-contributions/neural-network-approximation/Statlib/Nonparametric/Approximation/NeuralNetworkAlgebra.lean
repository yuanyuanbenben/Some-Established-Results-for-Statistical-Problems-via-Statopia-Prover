    linarith
  refine ⟨cDepth, hcDepth_pos, ?_, ?_⟩
  · dsimp [cDepth]
    congr 1
    exact Finset.sum_congr rfl (fun i hi => by rw [hcDi_eq i])
  intro n hn R hR center
  have hnet : ∀ i : ι,
      ∃ D P : ℕ,
        0 < D ∧
        (D : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (Wmono i) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (Wmono i) P ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |g x - ∏ q : Fin (degree i),
                (x (coord i q) - center (coord i q))| ≤
                  centeredMonomialFixedWidthApproxError cMulErr R n (degree i) := by
    intro i
    exact (hcDi_spec i).2.2 n hn R hR center (coord i)
  let Dnet : ι → ℕ := fun i => Classical.choose (hnet i)
  have hDnet : ∀ i : ι,
      ∃ P : ℕ,
        0 < Dnet i ∧
        (Dnet i : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d (Dnet i) (Wmono i) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d (Dnet i) (Wmono i) P ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |g x - ∏ q : Fin (degree i),
                (x (coord i q) - center (coord i q))| ≤
                  centeredMonomialFixedWidthApproxError cMulErr R n (degree i) :=
    fun i => Classical.choose_spec (hnet i)
  have hDnet_pos : ∀ i, 0 < Dnet i :=
    fun i => (Classical.choose_spec (hDnet i)).1
  have hDnet_le : ∀ i,
      (Dnet i : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) :=
    fun i => (Classical.choose_spec (hDnet i)).2.1
  let Pnet : ι → ℕ := fun i => Classical.choose (hDnet i)
  have hPnet_eq : ∀ i,
      Pnet i = fullyConnectedReLUParameterCount d (Dnet i) (Wmono i) :=
    fun i => (Classical.choose_spec (hDnet i)).2.2.1
  have hPnet : ∀ i : ι,
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d (Dnet i) (Wmono i) (Pnet i) ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |g x - ∏ q : Fin (degree i),
              (x (coord i q) - center (coord i q))| ≤
                centeredMonomialFixedWidthApproxError cMulErr R n (degree i) :=
    fun i => (Classical.choose_spec (hDnet i)).2.2.2
  let gnet : ι → (Fin d → ℝ) → ℝ := fun i => Classical.choose (hPnet i)
  have hgnet : ∀ i : ι,
      gnet i ∈ reluNetworkClass d (Dnet i) (Wmono i) (Pnet i) ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
          |gnet i x - ∏ q : Fin (degree i),
