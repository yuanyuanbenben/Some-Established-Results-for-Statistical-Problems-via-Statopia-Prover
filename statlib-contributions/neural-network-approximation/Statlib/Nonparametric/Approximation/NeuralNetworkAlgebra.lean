import Statlib.Nonparametric.Vocabulary.NeuralNetwork
import Statlib.Nonparametric.Approximation.Sieve

open scoped BigOperators
open Statlib.Nonparametric.Vocabulary
open Statlib.Nonparametric.Vocabulary.FullyConnectedReLUNet

/-! # ReLU Algebra Approximation

Core algebraic approximation targets for fully connected ReLU networks.
-/

namespace Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra

/-- A prescribed hidden-state recursion agrees with the concrete hidden states
of a fully connected ReLU network, and hence gives the usual output formula. -/
theorem fullyConnectedReLUNet_hiddenState_follows_prescribed_relu_layer_recursion
    {d : ℕ} (N : FullyConnectedReLUNet d) (_hDepth : 0 < N.depth)
    (S : ℕ → (Fin d → ℝ) → Fin N.width → ℝ)
    (h0 : ∀ x : Fin d → ℝ, S 0 x = N.input.reluApply x)
    (hrec : ∀ (t : ℕ) (ht : t < N.depth - 1) (x : Fin d → ℝ),
      S (t + 1) x = (N.hidden ⟨t, ht⟩).reluApply (S t x)) :
    (∀ (x : Fin d → ℝ) (t : ℕ), t ≤ N.depth - 1 → S t x = N.hiddenState x t) ∧
      (∀ x : Fin d → ℝ,
        N.realize x =
          (∑ j : Fin N.width, N.outputWeight j * S (N.depth - 1) x j) + N.outputBias) := by
  have hhidden0 : ∀ x : Fin d → ℝ, N.hiddenState x 0 = N.input.reluApply x := by
    intro x
    rfl
  have hhidden : ∀ (t : ℕ) (ht : t < N.depth - 1) (x : Fin d → ℝ),
      N.hiddenState x (t + 1) = (N.hidden ⟨t, ht⟩).reluApply (N.hiddenState x t) := by
    intro t ht x
    simp [FullyConnectedReLUNet.hiddenState, ht]
  have hmain : ∀ (x : Fin d → ℝ) (t : ℕ), t ≤ N.depth - 1 → S t x = N.hiddenState x t := by
    intro x t
    induction t with
    | zero =>
        intro _ht
        rw [h0 x]
        rw [hhidden0 x]
    | succ t ih =>
        intro ht
        have ht_le : t ≤ N.depth - 1 := Nat.le_of_succ_le ht
        have ht_lt : t < N.depth - 1 := Nat.lt_of_succ_le ht
        rw [hrec t ht_lt x]
        rw [ih ht_le]
        rw [hhidden t ht_lt x]
  constructor
  · exact hmain
  · intro x
    change
      (∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (N.depth - 1) j) + N.outputBias =
        (∑ j : Fin N.width, N.outputWeight j * S (N.depth - 1) x j) + N.outputBias
    apply congrArg (fun z => z + N.outputBias)
    apply Finset.sum_congr rfl
    intro j _hj
    rw [← hmain x (N.depth - 1) (Nat.le_refl (N.depth - 1))]

/-- If exactly one fine cell has active indicator, then the running
shallow ReLU selection accumulators recover that cell's left endpoint and
Taylor coefficients; substituting these accumulator values gives the same local
Taylor polynomial. -/
private theorem reluApprox_selection_accumulator_recursion_selects_active_fine_cell
    (r d T : ℕ) (_hT : 0 < T)
    (x : Fin d → ℝ) (ind : Fin T → ℝ) (k0 : Fin T)
    (h_active : ind k0 = 1)
    (h_inactive : ∀ k : Fin T, k ≠ k0 → ind k = 0)
    (fineLeft : Fin T → Fin d → ℝ)
    (coeff : Fin T → TaylorMultiindex r d → ℝ)
    (Phi5 : ℕ → Fin d → ℝ)
    (Phi6 : ℕ → TaylorMultiindex r d → ℝ)
    (h_Phi5_zero : ∀ q : Fin d, Phi5 0 q = 0)
    (h_Phi6_zero : ∀ a : TaylorMultiindex r d, Phi6 0 a = 0)
    (h_Phi5_step : ∀ n : Fin T, Phi5 (n.val + 1) = Phi5 n.val + ind n • fineLeft n)
    (h_Phi6_step : ∀ n : Fin T, ∀ a : TaylorMultiindex r d,
      Phi6 (n.val + 1) a = Phi6 n.val a + ind n * coeff n a) :
    (∀ q : Fin d, Phi5 T q = fineLeft k0 q) ∧
    (∀ a : TaylorMultiindex r d, Phi6 T a = coeff k0 a) ∧
    ((∑ a : TaylorMultiindex r d,
        Phi6 T a * ∏ q : Fin a.1.val, (x (a.2 q) - Phi5 T (a.2 q))) =
      (∑ a : TaylorMultiindex r d,
        coeff k0 a * ∏ q : Fin a.1.val, (x (a.2 q) - fineLeft k0 (a.2 q)))) := by
  have hcastT : ∀ k : Fin T, Fin.castLE (le_rfl : T ≤ T) k = k := by
    intro k
    ext
    rfl
  have h_Phi5_sum : ∀ n : ℕ, (h : n ≤ T) → Phi5 n = ∑ k : Fin n,
      ind (Fin.castLE h k) • fineLeft (Fin.castLE h k) := by
    intro n
    induction n with
    | zero =>
        intro _h0
        funext q
        simp [h_Phi5_zero]
    | succ n ih =>
        intro hsn
        have hnT : n ≤ T := Nat.le_of_succ_le hsn
        have hn_lt : n < T := Nat.lt_of_succ_le hsn
        have hcast : ∀ k : Fin n, Fin.castLE hsn k.castSucc = Fin.castLE hnT k := by
          intro k
          ext
          rfl
        have hlast : Fin.castLE hsn (Fin.last n) = ⟨n, hn_lt⟩ := by
          ext
          rfl
        calc
          Phi5 (n + 1) = Phi5 n + ind ⟨n, hn_lt⟩ • fineLeft ⟨n, hn_lt⟩ := by
            simpa using (h_Phi5_step ⟨n, hn_lt⟩)
          _ = (∑ k : Fin n, ind (Fin.castLE hnT k) • fineLeft (Fin.castLE hnT k)) +
              ind ⟨n, hn_lt⟩ • fineLeft ⟨n, hn_lt⟩ := by
            rw [ih hnT]
          _ = ∑ k : Fin (n + 1), ind (Fin.castLE hsn k) • fineLeft (Fin.castLE hsn k) := by
            rw [Fin.sum_univ_castSucc]
            simp [hcast, hlast]
  have h_Phi6_sum : ∀ n : ℕ, (h : n ≤ T) → ∀ a : TaylorMultiindex r d,
      Phi6 n a = ∑ k : Fin n, ind (Fin.castLE h k) * coeff (Fin.castLE h k) a := by
    intro n
    induction n with
    | zero =>
        intro _h0 a
        simp [h_Phi6_zero]
    | succ n ih =>
        intro hsn a
        have hnT : n ≤ T := Nat.le_of_succ_le hsn
        have hn_lt : n < T := Nat.lt_of_succ_le hsn
        have hcast : ∀ k : Fin n, Fin.castLE hsn k.castSucc = Fin.castLE hnT k := by
          intro k
          ext
          rfl
        have hlast : Fin.castLE hsn (Fin.last n) = ⟨n, hn_lt⟩ := by
          ext
          rfl
        calc
          Phi6 (n + 1) a = Phi6 n a + ind ⟨n, hn_lt⟩ * coeff ⟨n, hn_lt⟩ a := by
            simpa using (h_Phi6_step ⟨n, hn_lt⟩ a)
          _ = (∑ k : Fin n, ind (Fin.castLE hnT k) * coeff (Fin.castLE hnT k) a) +
              ind ⟨n, hn_lt⟩ * coeff ⟨n, hn_lt⟩ a := by
            rw [ih hnT a]
          _ = ∑ k : Fin (n + 1), ind (Fin.castLE hsn k) * coeff (Fin.castLE hsn k) a := by
            rw [Fin.sum_univ_castSucc]
            simp [hcast, hlast]
  have hsum5 : Phi5 T = ∑ k : Fin T, ind k • fineLeft k := by
    rw [h_Phi5_sum T le_rfl]
    apply Finset.sum_congr rfl
    intro k _hk
    rw [hcastT k]
  have hsum5_collapse : (∑ k : Fin T, ind k • fineLeft k) = fineLeft k0 := by
    calc
      (∑ k : Fin T, ind k • fineLeft k) = ind k0 • fineLeft k0 := by
        rw [Finset.sum_eq_single k0]
        · intro b _hb hbne
          rw [h_inactive b hbne]
          simp
        · intro hk0
          simp at hk0
      _ = fineLeft k0 := by
        rw [h_active]
        simp
  have h5 : ∀ q : Fin d, Phi5 T q = fineLeft k0 q := by
    intro q
    calc
      Phi5 T q = (∑ k : Fin T, ind k • fineLeft k) q := by rw [hsum5]
      _ = fineLeft k0 q := by rw [hsum5_collapse]
  have hsum6 : ∀ a : TaylorMultiindex r d, Phi6 T a = ∑ k : Fin T, ind k * coeff k a := by
    intro a
    rw [h_Phi6_sum T le_rfl a]
    apply Finset.sum_congr rfl
    intro k _hk
    rw [hcastT k]
  have hsum6_collapse : ∀ a : TaylorMultiindex r d,
      (∑ k : Fin T, ind k * coeff k a) = coeff k0 a := by
    intro a
    calc
      (∑ k : Fin T, ind k * coeff k a) = ind k0 * coeff k0 a := by
        rw [Finset.sum_eq_single k0]
        · intro b _hb hbne
          rw [h_inactive b hbne]
          simp
        · intro hk0
          simp at hk0
      _ = coeff k0 a := by
        rw [h_active]
        simp
  have h6 : ∀ a : TaylorMultiindex r d, Phi6 T a = coeff k0 a := by
    intro a
    rw [hsum6 a, hsum6_collapse a]
  refine ⟨h5, h6, ?_⟩
  apply Finset.sum_congr rfl
  intro a _ha
  rw [h6 a]
  congr 1
  apply Finset.prod_congr rfl
  intro q _hq
  rw [h5 (a.2 q)]

/-- shallow ReLU Taylor-coefficient recursion bookkeeping: if one recursive
step introduces at most `K_step * M ^ prof(a)` error and the transition part
preserves the same profile bound, then all accumulated coefficient errors are
controlled by `2 * K_step`; for a zero-degree multiindex this gives the
`M^{-2(r+beta)}` exponent. -/
private theorem reluApprox_taylorCoefficientRecursion_accumulated_error_bound
    {d r : ℕ} {beta C B K_step : ℝ}
    (_hbeta_nonneg : 0 ≤ beta) (_hC_nonneg : 0 ≤ C) (_hB_nonneg : 0 ≤ B)
    (hK_step_nonneg : 0 ≤ K_step) :
    ∃ K_acc : ℝ, 0 ≤ K_acc ∧
      ∀ M : ℕ, 0 < M →
        ∀ Aidx : Type, [Fintype Aidx] → [DecidableEq Aidx] →
        ∀ deg : Aidx → ℕ,
        ∀ prof : Aidx → ℝ,
        (∀ a : Aidx, prof a = -(2 * (((r : ℝ) + beta) - (deg a : ℝ)))) →
        ∀ a0 : Aidx, deg a0 = 0 →
        ∀ theta thetaHat : ℕ → Aidx → ℝ,
        ∀ trans : ℕ → Aidx → Aidx → ℝ,
        ∀ decodedCorrection rem : ℕ → Aidx → ℝ,
        (∀ a : Aidx, thetaHat 0 a = theta 0 a) →
        (∀ k : ℕ, k < M ^ d →
          ∀ a : Aidx,
            thetaHat (k + 1) a =
              (∑ b : Aidx, trans k a b * thetaHat k b) +
                decodedCorrection k a) →
        (∀ k : ℕ, k < M ^ d →
          ∀ a : Aidx,
            theta (k + 1) a =
              (∑ b : Aidx, trans k a b * theta k b) + rem k a) →
        (∀ k : ℕ, k < M ^ d →
          ∀ a : Aidx,
            |decodedCorrection k a - rem k a| ≤
              K_step * (M : ℝ).rpow (prof a)) →
        (∀ k : ℕ, k < M ^ d →
          (∀ b : Aidx,
            |thetaHat k b - theta k b| ≤
              (2 * K_step) * (M : ℝ).rpow (prof b)) →
          ∀ a : Aidx,
            |(∑ b : Aidx, trans k a b * thetaHat k b) -
                (∑ b : Aidx, trans k a b * theta k b)| ≤
              K_step * (M : ℝ).rpow (prof a)) →
        (∀ k : ℕ, k ≤ M ^ d →
          ∀ a : Aidx,
            |thetaHat k a - theta k a| ≤
              K_acc * (M : ℝ).rpow (prof a)) ∧
        (∀ k : ℕ, k ≤ M ^ d →
            |thetaHat k a0 - theta k a0| ≤
              K_acc * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) := by
  have hK_acc_nonneg : 0 ≤ 2 * K_step := by
    exact mul_nonneg (by norm_num : 0 ≤ (2 : ℝ)) hK_step_nonneg
  have hgen : ∀ M : ℕ, 0 < M →
      ∀ Aidx : Type, [Fintype Aidx] → [DecidableEq Aidx] →
      ∀ deg : Aidx → ℕ, ∀ prof : Aidx → ℝ,
      (∀ a : Aidx, prof a = -(2 * (((r : ℝ) + beta) - (deg a : ℝ)))) →
      ∀ a0 : Aidx, deg a0 = 0 →
      ∀ theta thetaHat : ℕ → Aidx → ℝ,
      ∀ trans : ℕ → Aidx → Aidx → ℝ,
      ∀ decodedCorrection rem : ℕ → Aidx → ℝ,
      (∀ a : Aidx, thetaHat 0 a = theta 0 a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          thetaHat (k + 1) a = (∑ b : Aidx, trans k a b * thetaHat k b) + decodedCorrection k a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          theta (k + 1) a = (∑ b : Aidx, trans k a b * theta k b) + rem k a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          |decodedCorrection k a - rem k a| ≤ K_step * (M : ℝ).rpow (prof a)) →
      (∀ k : ℕ, k < M ^ d →
        (∀ b : Aidx,
          |thetaHat k b - theta k b| ≤ (2 * K_step) * (M : ℝ).rpow (prof b)) →
        ∀ a : Aidx,
          |(∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)| ≤
            K_step * (M : ℝ).rpow (prof a)) →
      ∀ k : ℕ, k ≤ M ^ d → ∀ a : Aidx,
        |thetaHat k a - theta k a| ≤ (2 * K_step) * (M : ℝ).rpow (prof a) := by
      intro M hMpos Aidx _ _ deg prof hprof a0 hdeg theta thetaHat trans decodedCorrection rem hinit hrecHat hrec hdef hclosure
      have hMposR : 0 < (M : ℝ) := by exact_mod_cast hMpos
      intro k
      induction k with
      | zero =>
          intro _ a
          have h0 : |thetaHat 0 a - theta 0 a| = 0 := by
            rw [hinit a]
            simp
          rw [h0]
          exact mul_nonneg hK_acc_nonneg (le_of_lt (Real.rpow_pos_of_pos hMposR (prof a)))
      | succ k ih =>
          intro hk a
          have hkle : k ≤ M ^ d := Nat.le_of_succ_le hk
          have hklt : k < M ^ d := Nat.lt_of_succ_le hk
          have hI : ∀ b : Aidx, |thetaHat k b - theta k b| ≤ (2 * K_step) * (M : ℝ).rpow (prof b) :=
            fun b => ih hkle b
          have hAB :
              |(∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)| ≤
                K_step * (M : ℝ).rpow (prof a) :=
            hclosure k hklt hI a
          have hDR : |decodedCorrection k a - rem k a| ≤ K_step * (M : ℝ).rpow (prof a) :=
            hdef k hklt a
          rw [hrecHat k hklt a, hrec k hklt a]
          have hArg :
              ((∑ b : Aidx, trans k a b * thetaHat k b) + decodedCorrection k a) -
                  ((∑ b : Aidx, trans k a b * theta k b) + rem k a) =
                ((∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)) +
                  (decodedCorrection k a - rem k a) := by
            abel
          rw [hArg]
          calc
            |((∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)) +
                (decodedCorrection k a - rem k a)| ≤
                |(∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)| +
                  |decodedCorrection k a - rem k a| := abs_add_le _ _
            _ ≤ K_step * (M : ℝ).rpow (prof a) + K_step * (M : ℝ).rpow (prof a) := add_le_add hAB hDR
            _ = (2 * K_step) * (M : ℝ).rpow (prof a) := by ring
  have hspec : ∀ M : ℕ, 0 < M →
      ∀ Aidx : Type, [Fintype Aidx] → [DecidableEq Aidx] →
      ∀ deg : Aidx → ℕ, ∀ prof : Aidx → ℝ,
      (∀ a : Aidx, prof a = -(2 * (((r : ℝ) + beta) - (deg a : ℝ)))) →
      ∀ a0 : Aidx, deg a0 = 0 →
      ∀ theta thetaHat : ℕ → Aidx → ℝ,
      ∀ trans : ℕ → Aidx → Aidx → ℝ,
      ∀ decodedCorrection rem : ℕ → Aidx → ℝ,
      (∀ a : Aidx, thetaHat 0 a = theta 0 a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          thetaHat (k + 1) a = (∑ b : Aidx, trans k a b * thetaHat k b) + decodedCorrection k a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          theta (k + 1) a = (∑ b : Aidx, trans k a b * theta k b) + rem k a) →
      (∀ k : ℕ, k < M ^ d →
        ∀ a : Aidx,
          |decodedCorrection k a - rem k a| ≤ K_step * (M : ℝ).rpow (prof a)) →
      (∀ k : ℕ, k < M ^ d →
        (∀ b : Aidx,
          |thetaHat k b - theta k b| ≤ (2 * K_step) * (M : ℝ).rpow (prof b)) →
        ∀ a : Aidx,
          |(∑ b : Aidx, trans k a b * thetaHat k b) - (∑ b : Aidx, trans k a b * theta k b)| ≤
            K_step * (M : ℝ).rpow (prof a)) →
      ∀ k : ℕ, k ≤ M ^ d →
      |thetaHat k a0 - theta k a0| ≤ (2 * K_step) * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
        intro M hM Aidx instFintype instDecEq deg prof hprof a0 hdeg0 theta thetaHat trans decodedCorrection rem h0 hrecHat hrec hdefect hclosure k hk
        have hspec0 : |thetaHat k a0 - theta k a0| ≤ (2 * K_step) * (M : ℝ).rpow (prof a0) :=
          @hgen M hM Aidx instFintype instDecEq deg prof hprof a0 hdeg0 theta thetaHat trans decodedCorrection rem h0 hrecHat hrec hdefect hclosure k hk a0
        have hprof0 : prof a0 = -(2 * ((r : ℝ) + beta)) := by
          rw [hprof a0, hdeg0]
          simp
        rw [hprof0] at hspec0
        exact hspec0
  exact ⟨2 * K_step, hK_acc_nonneg, by
    intro M hM Aidx instFintype instDecEq deg prof hprof a0 hdeg0 theta thetaHat trans decodedCorrection rem h0 hrecHat hrec hdefect hclosure
    exact ⟨@hgen M hM Aidx instFintype instDecEq deg prof hprof a0 hdeg0 theta thetaHat trans decodedCorrection rem h0 hrecHat hrec hdefect hclosure,
           @hspec M hM Aidx instFintype instDecEq deg prof hprof a0 hdeg0 theta thetaHat trans decodedCorrection rem h0 hrecHat hrec hdefect hclosure⟩⟩

/-- On each uniform-grid cell, the ReLU hinge interpolant approximates the
square map with the standard secant-interpolation error bound. -/
theorem squareReLUHingeInterpolant_error_le_of_mem_cell
    {n k : ℕ} (hn : 0 < n) (hk : k < n) {x : ℝ}
    (hx_left : (k : ℝ) / (n : ℝ) ≤ x)
    (hx_right : x ≤ ((k + 1 : ℕ) : ℝ) / (n : ℝ)) :
    |squareReLUHingeInterpolant n x - x ^ 2| ≤ 1 / (4 * (n : ℝ) ^ 2) := by
  have h_s1 : squareReLUHingeInterpolant n x = squareCellInterpolant n k x := by
    have hrelu_x : relu x = x := by
      unfold relu
      apply max_eq_left
      calc
        0 ≤ (k : ℝ) / (n : ℝ) := by
          exact div_nonneg (by exact_mod_cast (Nat.zero_le k)) (le_of_lt (by exact_mod_cast hn))
        _ ≤ x := hx_left
    have hk_le : k ≤ n - 1 := by omega
    have hm : n - 1 = k + (n - 1 - k) := (Nat.add_sub_of_le hk_le).symm
    have htail_zero :
        (∑ i ∈ Finset.range (n - 1 - k),
            2 / (n : ℝ) * relu (x - ↑(k + i + 1) / (n : ℝ))) = 0 := by
      calc
        (∑ i ∈ Finset.range (n - 1 - k),
            2 / (n : ℝ) * relu (x - ↑(k + i + 1) / (n : ℝ)))
            = (∑ i ∈ Finset.range (n - 1 - k), 2 / (n : ℝ) * 0) := by
                apply Finset.sum_congr rfl
                intro i hi
                have hxi : x ≤ ↑(k + i + 1) / (n : ℝ) := by
                  calc
                    x ≤ ↑(k + 1) / (n : ℝ) := hx_right
                    _ ≤ ↑(k + i + 1) / (n : ℝ) := by
                      apply div_le_div_of_nonneg_right
                      · exact_mod_cast (by omega : k + 1 ≤ k + i + 1)
                      · exact le_of_lt (by exact_mod_cast hn)
                have hrel : relu (x - ↑(k + i + 1) / (n : ℝ)) = 0 := by
                  unfold relu
                  exact max_eq_right (sub_nonpos.mpr hxi)
                rw [hrel]
        _ = 0 := by simp
    have hsum :
        (∑ i ∈ Finset.range (n - 1), 2 / (n : ℝ) * relu (x - ↑(i + 1) / (n : ℝ)))
          = (∑ i ∈ Finset.range k, 2 / (n : ℝ) * (x - ↑(i + 1) / (n : ℝ))) := by
      rw [hm, Finset.sum_range_add]
      rw [htail_zero]
      simp only [Nat.cast_add, Nat.cast_one, add_zero]
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i < k := Finset.mem_range.mp hi
      have hxi : ↑(i + 1) / (n : ℝ) ≤ x := by
        calc
          ↑(i + 1) / (n : ℝ) ≤ (k : ℝ) / (n : ℝ) := by
            apply div_le_div_of_nonneg_right
            · exact_mod_cast (Nat.succ_le_of_lt hik)
            · exact le_of_lt (by exact_mod_cast hn)
          _ ≤ x := hx_left
      have hrel : relu (x - ↑(i + 1) / (n : ℝ)) = x - ↑(i + 1) / (n : ℝ) := by
        unfold relu
        exact max_eq_left (sub_nonneg.mpr hxi)
      have hrel' :
          relu (x - ((i : ℝ) + 1) / (n : ℝ)) =
            x - ((i : ℝ) + 1) / (n : ℝ) := by
        simpa [Nat.cast_add] using hrel
      rw [hrel']
    have h_inner :
        (∑ i ∈ Finset.range k, (x - ↑(i + 1) / (n : ℝ)))
          = (k : ℝ) * x - (k : ℝ) * ((k : ℝ) + 1) / (2 * (n : ℝ)) := by
      have hsum_shift :
          ∀ m : ℕ, (∑ i ∈ Finset.range m, (↑(i + 1 : ℕ) : ℝ))
            = (m : ℝ) * ((m : ℝ) + 1) / 2 := by
        intro m
        induction m with
        | zero => simp
        | succ m ih =>
            rw [Finset.sum_range_succ, ih]
            push_cast
            ring_nf
      calc
        (∑ i ∈ Finset.range k, (x - ↑(i + 1) / (n : ℝ)))
            = (∑ i ∈ Finset.range k, x) -
                (∑ i ∈ Finset.range k, ↑(i + 1) / (n : ℝ)) := by
              rw [Finset.sum_sub_distrib]
        _ = (k : ℝ) * x - (∑ i ∈ Finset.range k, ↑(i + 1)) / (n : ℝ) := by
              rw [Finset.sum_div]
              simp [Finset.sum_const, nsmul_eq_mul]
        _ = (k : ℝ) * x - (k : ℝ) * ((k : ℝ) + 1) / (2 * (n : ℝ)) := by
              rw [hsum_shift k]
              ring_nf
    calc
      squareReLUHingeInterpolant n x
          = 1 / (n : ℝ) * relu x
              + (∑ i ∈ Finset.range (n - 1),
                  2 / (n : ℝ) * relu (x - ↑(i + 1) / (n : ℝ))) := by
              rfl
      _ = 1 / (n : ℝ) * x
              + (∑ i ∈ Finset.range k,
                  2 / (n : ℝ) * (x - ↑(i + 1) / (n : ℝ))) := by
              rw [hrelu_x, hsum]
      _ = 1 / (n : ℝ) * x
              + 2 / (n : ℝ) *
                ((k : ℝ) * x - (k : ℝ) * ((k : ℝ) + 1) / (2 * (n : ℝ))) := by
              rw [← Finset.mul_sum, h_inner]
      _ = ((k : ℝ) / (n : ℝ) + (((k + 1 : ℕ) : ℝ) / (n : ℝ))) * x
            - (k : ℝ) / (n : ℝ) * (((k + 1 : ℕ) : ℝ) / (n : ℝ)) := by
            norm_num
            ring_nf
      _ = squareCellInterpolant n k x := by
            rfl
  have h_s2 : squareReLUHingeInterpolant n x - x ^ 2 =
      (x - (k : ℝ) / (n : ℝ)) * (((k + 1 : ℕ) : ℝ) / (n : ℝ) - x) := by
    rw [h_s1]
    unfold squareCellInterpolant squareSecantInterpolant
    ring
  have h_s3 : |(x - (k : ℝ) / (n : ℝ)) *
        (((k + 1 : ℕ) : ℝ) / (n : ℝ) - x)| ≤
      1 / (4 * (n : ℝ) ^ 2) := by
    have hnpos : 0 < (n : ℝ) := by exact_mod_cast hn
    set u : ℝ := x - (k : ℝ) / (n : ℝ) with hu
    set v : ℝ := ((k + 1 : ℕ) : ℝ) / (n : ℝ) - x with hv
    have hu_nonneg : 0 ≤ u := by
      rw [hu]
      exact sub_nonneg.mpr hx_left
    have hv_nonneg : 0 ≤ v := by
      rw [hv]
      exact sub_nonneg.mpr hx_right
    have hprod_nonneg : 0 ≤ u * v := mul_nonneg hu_nonneg hv_nonneg
    have huv_sum : u + v = 1 / (n : ℝ) := by
      rw [hu, hv]
      push_cast
      field_simp [hnpos.ne']
      ring
    have hfour : 4 * u * v ≤ (u + v) ^ 2 := by
      nlinarith [sq_nonneg (u - v)]
    have htmp : 4 * u * v ≤ (1 / (n : ℝ)) ^ 2 := by
      simpa [huv_sum] using hfour
    have hcleared : 4 * (n : ℝ) ^ 2 * u * v ≤ 1 := by
      field_simp [hnpos.ne'] at htmp
      nlinarith [htmp]
    rw [abs_of_nonneg hprod_nonneg]
    field_simp [hnpos.ne']
    nlinarith [hcleared]
  rw [h_s2]
  exact h_s3

/-- The one-hidden-layer network `unitIntervalSquareReLUHingeNet` realizes the
standard ReLU hinge interpolant for the square map on the first coordinate. -/
theorem unitIntervalSquareReLUHingeNet_realize
    (n : ℕ) (x : Fin 1 → ℝ) :
    (unitIntervalSquareReLUHingeNet n).realize x =
      squareReLUHingeInterpolant n (x 0) := by
  cases n with
  | zero =>
      simp [unitIntervalSquareReLUHingeNet, OneHiddenReLUNet.realize,
        squareReLUHingeInterpolant]
  | succ k =>
      simp only [OneHiddenReLUNet.realize, unitIntervalSquareReLUHingeNet,
        Nat.cast_add, Nat.cast_one, Fin.val_eq_zero_iff, one_div,
        DenseLayer.apply, Finset.univ_unique, Fin.default_eq_zero,
        Fin.isValue, one_mul, Finset.sum_singleton, ite_mul,
        Fin.sum_univ_succ, ↓reduceIte, Fin.coe_ofNat_eq_mod, Nat.zero_mod,
        CharP.cast_eq_zero, neg_zero, zero_div, add_zero, Fin.succ_ne_zero,
        Fin.val_succ, neg_add_rev, squareReLUHingeInterpolant,
        add_tsub_cancel_right, add_right_inj]
      conv_lhs =>
        change (∑ x_1 : Fin k,
          (fun i : ℕ => 2 / (↑k + 1) * relu (x 0 + (-1 + -↑i) / (↑k + 1))) ↑x_1)
      rw [Fin.sum_univ_eq_sum_range
        (f := fun i : ℕ => 2 / (↑k + 1) * relu (x 0 + (-1 + -↑i) / (↑k + 1)))
        (n := k)]
      refine Finset.sum_congr rfl ?_
      intro i hi
      dsimp
      apply congrArg (fun z : ℝ => 2 / (↑k + 1) * relu z)
      ring_nf

/-- The ReLU hinge interpolant approximates the square map uniformly on the unit
interval with the standard secant-interpolation error bound. -/
theorem squareReLUHingeInterpolant_error_le_of_mem_unitInterval
    {n : ℕ} (hn : 0 < n) {x : ℝ}
    (hx0 : 0 ≤ x) (hx1 : x ≤ 1) :
    |squareReLUHingeInterpolant n x - x ^ 2| ≤ 1 / (4 * (n : ℝ) ^ 2) := by
  by_cases hxeq : x = 1
  · have hk_lt : n - 1 < n := Nat.sub_lt hn zero_lt_one
    have hn_pos : 0 < (n : ℝ) := by exact_mod_cast hn
    have hlow : ((n - 1 : ℕ) : ℝ) / (n : ℝ) ≤ x := by
      rw [hxeq]
      field_simp [ne_of_gt hn_pos]
      exact_mod_cast Nat.sub_le n 1
    have hhigh : x ≤ (((n - 1) + 1 : ℕ) : ℝ) / (n : ℝ) := by
      rw [hxeq]
      rw [Nat.sub_add_cancel (Nat.succ_le_of_lt hn)]
      rw [div_self (by exact_mod_cast (ne_of_gt hn))]
    exact squareReLUHingeInterpolant_error_le_of_mem_cell
      (n := n) (k := n - 1) hn hk_lt hlow hhigh
  · have hxlt1 : x < 1 := lt_of_le_of_ne hx1 hxeq
    let k : ℕ := Nat.floor ((n : ℝ) * x)
    have hk₁ : (k : ℝ) ≤ (n : ℝ) * x := by
      simpa [k] using (Nat.floor_le (by positivity : 0 ≤ (n : ℝ) * x))
    have hk₂ : (n : ℝ) * x < (k + 1 : ℝ) := by
      simpa [k] using (Nat.lt_floor_add_one ((n : ℝ) * x))
    have hn_pos : 0 < (n : ℝ) := by exact_mod_cast hn
    have hk_lt_n : k < n := by
      have hlt : (n : ℝ) * x < (n : ℝ) := by
        simpa using (mul_lt_mul_of_pos_left hxlt1 hn_pos)
      simpa [k] using (Nat.floor_lt (by positivity : 0 ≤ (n : ℝ) * x)).2 hlt
    have hle₁ : (k : ℝ) / (n : ℝ) ≤ x := by
      field_simp [ne_of_gt hn_pos]
      nlinarith [hk₁]
    have hle₂ : x ≤ ((k + 1 : ℕ) : ℝ) / (n : ℝ) := by
      field_simp [ne_of_gt hn_pos]
      rw [mul_comm]
      simpa using (le_of_lt hk₂)
    exact squareReLUHingeInterpolant_error_le_of_mem_cell
      (n := n) (k := k) hn hk_lt_n hle₁ hle₂

/-- A fully connected ReLU network with one hidden layer approximates the square
map uniformly on the unit interval, with explicit width and parameter count. -/
theorem exists_fullyConnectedReLUNet_unitInterval_square_approx
    {n : ℕ} (hn : 0 < n) :
    ∃ N : FullyConnectedReLUNet 1,
      N.depth = 1 ∧
      N.width = n ∧
      N.parameterCount ≤ 3 * n + 1 ∧
      ∀ x : Fin 1 → ℝ, 0 ≤ x 0 → x 0 ≤ 1 →
        |N.realize x - (x 0) ^ 2| ≤ 1 / (4 * (n : ℝ) ^ 2) := by
  refine ⟨(unitIntervalSquareReLUHingeNet n).toFullyConnected, ?_, ?_, ?_, ?_⟩
  · rfl
  · rfl
  · simp [FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount,
      OneHiddenReLUNet.toFullyConnected]
    omega
  · intro x hx0 hx1
    change |(unitIntervalSquareReLUHingeNet n).realize x - (x 0) ^ 2| ≤
      1 / (4 * (n : ℝ) ^ 2)
    rw [unitIntervalSquareReLUHingeNet_realize]
    exact squareReLUHingeInterpolant_error_le_of_mem_unitInterval hn hx0 hx1

/-- A fully connected ReLU network with one hidden layer approximates the square
map uniformly on any compact interval, with explicit width and parameter count. -/
theorem exists_fullyConnectedReLUNet_interval_square_approx
    {n : ℕ} (hn : 0 < n) {a b : ℝ} (hab : a < b) :
    ∃ N : FullyConnectedReLUNet 1,
      N.depth = 1 ∧
      N.width = n ∧
      N.parameterCount ≤ 3 * n + 1 ∧
      ∀ x : Fin 1 → ℝ, a ≤ x 0 → x 0 ≤ b →
        |N.realize x - (x 0) ^ 2| ≤ (b - a) ^ 2 / (4 * (n : ℝ) ^ 2) := by
  have h_s1 : (intervalSquareReLUHingeNet n a b).toFullyConnected.depth = 1 ∧
      (intervalSquareReLUHingeNet n a b).toFullyConnected.width = n ∧
      (intervalSquareReLUHingeNet n a b).toFullyConnected.parameterCount ≤ 3 * n + 1 := by
    constructor
    · rfl
    constructor
    · rfl
    · change fullyConnectedReLUParameterCount 1 1 n ≤ 3 * n + 1
      unfold fullyConnectedReLUParameterCount
      omega
  have h_s2 : ∀ x : Fin 1 → ℝ, a ≤ x 0 → x 0 ≤ b →
      0 ≤ (x 0 - a) / (b - a) ∧ (x 0 - a) / (b - a) ≤ 1 := by
    intro x hxa hxb
    have hbpos : 0 < b - a := sub_pos.mpr hab
    constructor
    · exact div_nonneg (sub_nonneg.mpr hxa) (le_of_lt hbpos)
    · calc
        (x 0 - a) / (b - a) ≤ (b - a) / (b - a) :=
          div_le_div_of_nonneg_right (sub_le_sub_right hxb a) (le_of_lt hbpos)
        _ = 1 := div_self (ne_of_gt hbpos)
  have h_s3 : ∀ x : Fin 1 → ℝ, a ≤ x 0 → x 0 ≤ b →
      |(intervalSquareReLUHingeNet n a b).toFullyConnected.realize x - (x 0) ^ 2| ≤
        (b - a) ^ 2 *
          |squareReLUHingeInterpolant n ((x 0 - a) / (b - a)) -
            ((x 0 - a) / (b - a)) ^ 2| := by
    intro x hxa hxb
    let t : ℝ := (x 0 - a) / (b - a)
    have hbpos : 0 < b - a := sub_pos.mpr hab
    have hnpos : 0 < (n : ℝ) := by exact_mod_cast hn
    have htm : 0 ≤ t ∧ t ≤ 1 := by
      simpa [t] using h_s2 x hxa hxb
    have hrelu : relu t = t := by
      rw [relu]
      exact max_eq_left htm.1
    have htdef : (x 0 - a) / (b - a) = t := rfl
    have hx0 : x 0 = a + (b - a) * t := by
      have hdiv' : (b - a) * ((x 0 - a) / (b - a)) = x 0 - a := by
        rw [mul_comm (b - a)]
        exact div_mul_cancel₀ (x 0 - a) (ne_of_gt hbpos)
      calc
        x 0 = a + (x 0 - a) := by ring
        _ = a + (b - a) * ((x 0 - a) / (b - a)) := by rw [hdiv']
        _ = a + (b - a) * t := by rfl
    let f : Fin n → ℝ := fun j => relu (t - ↑↑j / ↑n)
    have hhidden : ∀ j : Fin n,
        (intervalSquareReLUHingeNet n a b).hidden.apply x j = t - ↑↑j / ↑n := by
      intro j
      rw [intervalSquareReLUHingeNet]
      rw [DenseLayer.apply]
      simp only [Finset.univ_unique, Fin.default_eq_zero, Fin.isValue, one_div,
        Finset.sum_singleton]
      rw [hx0]
      field_simp [hbpos.ne', ne_of_gt hnpos]
      ring
    have hind :
        (∑ j : Fin n, (if (j : ℕ) = 0 then (1 : ℝ) else 0) * f j) =
          f ⟨0, hn⟩ := by
      classical
      rw [Finset.sum_eq_single ⟨0, hn⟩]
      · simp
      · intro j _ hj
        have hj0 : (j : ℕ) ≠ 0 := by
          intro hz
          apply hj
          exact Fin.ext hz
        simp [hj0]
      · simp
    have hunit :
        (∑ j : Fin n,
            (if (j : ℕ) = 0 then (1 : ℝ) / ↑n else 2 / ↑n) *
              relu (t - ↑↑j / ↑n)) =
          squareReLUHingeInterpolant n t := by
      let y : Fin 1 → ℝ := fun _ => t
      have hy0 : y 0 = t := rfl
      calc
        (∑ j : Fin n,
            (if (j : ℕ) = 0 then (1 : ℝ) / ↑n else 2 / ↑n) *
              relu (t - ↑↑j / ↑n))
            = (unitIntervalSquareReLUHingeNet n).realize y := by
              rw [OneHiddenReLUNet.realize]
              simp [unitIntervalSquareReLUHingeNet, DenseLayer.apply, hy0,
                sub_eq_add_neg, neg_div]
        _ = squareReLUHingeInterpolant n (y 0) := unitIntervalSquareReLUHingeNet_realize n y
        _ = squareReLUHingeInterpolant n t := by rw [hy0]
    have hsum :
        ∑ j : Fin n,
          (intervalSquareReLUHingeNet n a b).outputWeight j *
            relu ((intervalSquareReLUHingeNet n a b).hidden.apply x j)
          = 2 * a * (b - a) * relu t +
            (b - a) ^ 2 * squareReLUHingeInterpolant n t := by
      calc
        ∑ j : Fin n,
          (intervalSquareReLUHingeNet n a b).outputWeight j *
            relu ((intervalSquareReLUHingeNet n a b).hidden.apply x j)
            = ∑ j : Fin n, (intervalSquareReLUHingeNet n a b).outputWeight j * f j := by
              apply Finset.sum_congr rfl
              intro j _
              simp [hhidden j, f]
        _ = ∑ j : Fin n,
            (if (j : ℕ) = 0 then
              2 * a * (b - a) + (b - a) ^ 2 * (1 / ↑n)
            else
              (b - a) ^ 2 * (2 / ↑n)) * f j := by
              apply Finset.sum_congr rfl
              intro j _
              simp [intervalSquareReLUHingeNet]
        _ = 2 * a * (b - a) * relu t +
            (b - a) ^ 2 * squareReLUHingeInterpolant n t := by
              calc
                ∑ j : Fin n,
                  (if (j : ℕ) = 0 then
                    2 * a * (b - a) + (b - a) ^ 2 * (1 / ↑n)
                  else
                    (b - a) ^ 2 * (2 / ↑n)) * f j
                    = ∑ j : Fin n,
                        (2 * a * (b - a) *
                            ((if (j : ℕ) = 0 then (1 : ℝ) else 0) * f j) +
                          (b - a) ^ 2 *
                            ((if (j : ℕ) = 0 then (1 : ℝ) / ↑n else 2 / ↑n) * f j)) := by
                        apply Finset.sum_congr rfl
                        intro j _
                        by_cases hz : (j : ℕ) = 0
                        · simp [hz]
                          ring
                        · simp [hz]
                          ring
                _ = 2 * a * (b - a) *
                        (∑ j : Fin n, (if (j : ℕ) = 0 then (1 : ℝ) else 0) * f j) +
                      (b - a) ^ 2 *
                        (∑ j : Fin n,
                          (if (j : ℕ) = 0 then (1 : ℝ) / ↑n else 2 / ↑n) * f j) := by
                        rw [Finset.sum_add_distrib]
                        rw [← Finset.mul_sum]
                        rw [← Finset.mul_sum]
                _ = 2 * a * (b - a) * relu t +
                    (b - a) ^ 2 * squareReLUHingeInterpolant n t := by
                        rw [hind, hunit]
                        simp [f]
    have hreal' : (intervalSquareReLUHingeNet n a b).realize x =
        a ^ 2 + 2 * a * (b - a) * relu t +
          (b - a) ^ 2 * squareReLUHingeInterpolant n t := by
      rw [OneHiddenReLUNet.realize]
      rw [hsum]
      simp [intervalSquareReLUHingeNet]
      ring
    have hfc : (intervalSquareReLUHingeNet n a b).toFullyConnected.realize x =
        (intervalSquareReLUHingeNet n a b).realize x := by
      simp [FullyConnectedReLUNet.realize, OneHiddenReLUNet.toFullyConnected,
        FullyConnectedReLUNet.hiddenState, OneHiddenReLUNet.realize, DenseLayer.apply,
        DenseLayer.reluApply, reluVec]
    have hreal : (intervalSquareReLUHingeNet n a b).toFullyConnected.realize x =
        intervalSquareReLUHingeInterpolant n a b (x 0) := by
      rw [hfc, hreal']
      rw [intervalSquareReLUHingeInterpolant]
    have hcore :
        |(intervalSquareReLUHingeNet n a b).toFullyConnected.realize x - (x 0) ^ 2| ≤
          (b - a) ^ 2 * |squareReLUHingeInterpolant n t - t ^ 2| := by
      rw [hreal]
      rw [intervalSquareReLUHingeInterpolant]
      rw [htdef]
      rw [hrelu, hx0]
      have hcore' :
          a ^ 2 + 2 * a * (b - a) * t +
              (b - a) ^ 2 * squareReLUHingeInterpolant n t -
              (a + (b - a) * t) ^ 2 =
            (b - a) ^ 2 * (squareReLUHingeInterpolant n t - t ^ 2) := by
        ring
      rw [hcore']
      calc
        |(b - a) ^ 2 * (squareReLUHingeInterpolant n t - t ^ 2)| =
            |(b - a) ^ 2| * |squareReLUHingeInterpolant n t - t ^ 2| := by
              rw [abs_mul]
        _ = (b - a) ^ 2 * |squareReLUHingeInterpolant n t - t ^ 2| := by
              rw [abs_of_nonneg (sq_nonneg (b - a))]
        _ ≤ (b - a) ^ 2 * |squareReLUHingeInterpolant n t - t ^ 2| := le_rfl
    simpa [t] using hcore
  have h_s4 : ∀ x : Fin 1 → ℝ, a ≤ x 0 → x 0 ≤ b →
      |(intervalSquareReLUHingeNet n a b).toFullyConnected.realize x - (x 0) ^ 2| ≤
        (b - a) ^ 2 / (4 * (n : ℝ) ^ 2) := by
    intro x hxa hxb
    let t : ℝ := (x 0 - a) / (b - a)
    have ht0 : 0 ≤ t := (h_s2 x hxa hxb).1
    have ht1 : t ≤ 1 := (h_s2 x hxa hxb).2
    have hbound :
        |squareReLUHingeInterpolant n t - t ^ 2| ≤ 1 / (4 * (n : ℝ) ^ 2) :=
      squareReLUHingeInterpolant_error_le_of_mem_unitInterval hn ht0 ht1
    have hmul :
        (b - a) ^ 2 * |squareReLUHingeInterpolant n t - t ^ 2| ≤
          (b - a) ^ 2 / (4 * (n : ℝ) ^ 2) := by
      calc
        (b - a) ^ 2 * |squareReLUHingeInterpolant n t - t ^ 2| ≤
            (b - a) ^ 2 * (1 / (4 * (n : ℝ) ^ 2)) :=
          mul_le_mul_of_nonneg_left hbound (sq_nonneg (b - a))
        _ = (b - a) ^ 2 / (4 * (n : ℝ) ^ 2) := by ring
    exact le_trans (h_s3 x hxa hxb) hmul
  exact ⟨(intervalSquareReLUHingeNet n a b).toFullyConnected,
    h_s1.1, h_s1.2.1, h_s1.2.2, h_s4⟩

/-- A fully connected ReLU network with one hidden layer approximates
multiplication uniformly on the box `[-R, R]^2`, with explicit width and
parameter count. -/
theorem exists_fullyConnectedReLUNet_mul_approx_on_box
    {n : ℕ} (hn : 0 < n) {R : ℝ} (hR : 0 < R) :
    ∃ N : FullyConnectedReLUNet 2,
      N.depth = 1 ∧
      N.width = 2 * n ∧
      N.parameterCount ≤ 8 * n + 1 ∧
      ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R →
        |N.realize x - x 0 * x 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
  have hn0 : 0 < n := hn
  have hneg : -(2 * R) < 2 * R := by nlinarith
  rcases exists_fullyConnectedReLUNet_interval_square_approx
      (n := n) hn0 (a := -(2 * R)) (b := 2 * R) hneg with
    ⟨Splus, hSplus_depth, hSplus_width, hSplus_params, hSplus_err⟩
  rcases exists_fullyConnectedReLUNet_interval_square_approx
      (n := n) hn0 (a := -(2 * R)) (b := 2 * R) hneg with
    ⟨Sminus, hSminus_depth, hSminus_width, hSminus_params, hSminus_err⟩
  let wInPlus : Fin n → Fin 2 → ℝ :=
    fun k _ => Splus.input.weight (Fin.cast hSplus_width.symm k) (0 : Fin 1)
  let bInPlus : Fin n → ℝ :=
    fun k => Splus.input.bias (Fin.cast hSplus_width.symm k)
  let wInMinus : Fin n → Fin 2 → ℝ := fun k i =>
    if i = 0 then Sminus.input.weight (Fin.cast hSminus_width.symm k) (0 : Fin 1)
    else -Sminus.input.weight (Fin.cast hSminus_width.symm k) (0 : Fin 1)
  let bInMinus : Fin n → ℝ :=
    fun k => Sminus.input.bias (Fin.cast hSminus_width.symm k)
  let wOutPlus : Fin n → ℝ :=
    fun k => Splus.outputWeight (Fin.cast hSplus_width.symm k) / 4
  let wOutMinus : Fin n → ℝ :=
    fun k => -Sminus.outputWeight (Fin.cast hSminus_width.symm k) / 4
  let wIn : Fin (n + n) → Fin 2 → ℝ := Fin.addCases wInPlus wInMinus
  let bIn : Fin (n + n) → ℝ := Fin.addCases bInPlus bInMinus
  let wOut : Fin (n + n) → ℝ := Fin.addCases wOutPlus wOutMinus
  let N : FullyConnectedReLUNet 2 :=
    { depth := 1
      width := n + n
      input := { weight := wIn, bias := bIn }
      hidden := fun i => Fin.elim0 i
      outputWeight := wOut
      outputBias := (Splus.outputBias - Sminus.outputBias) / 4 }
  refine ⟨N, ?_, ?_, ?_, ?_⟩
  · rfl
  · simp [N, two_mul]
  · simp [N, FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount]
    omega
  · intro x hx0 hx1
    have hx0b : -R ≤ x 0 ∧ x 0 ≤ R := abs_le.mp hx0
    have hx1b : -R ≤ x 1 ∧ x 1 ≤ R := abs_le.mp hx1
    have hsum_range : -(2 * R) ≤ x 0 + x 1 ∧ x 0 + x 1 ≤ 2 * R := by
      constructor
      · nlinarith [hx0b.1, hx1b.1]
      · nlinarith [hx0b.2, hx1b.2]
    have hsub_range : -(2 * R) ≤ x 0 - x 1 ∧ x 0 - x 1 ≤ 2 * R := by
      constructor
      · nlinarith [hx0b.1, hx1b.2]
      · nlinarith [hx0b.2, hx1b.1]
    have h_s1 : N.realize x =
        (Splus.realize (fun _ : Fin 1 => x 0 + x 1) -
          Sminus.realize (fun _ : Fin 1 => x 0 - x 1)) / 4 := by
      have h_reindex : ∀ {a b : ℕ} (h : a = b) (F : Fin b → ℝ),
          (∑ k : Fin a, F (Fin.cast h k)) = ∑ j : Fin b, F j := by
        intro a b h F
        refine Finset.sum_bij (s := Finset.univ) (t := Finset.univ)
          (f := fun k : Fin a => F (Fin.cast h k)) (g := F)
          (fun k _ => Fin.cast h k) ?_ ?_ ?_ ?_
        · intro k hk
          simp
        · intro a₁ ha₁ a₂ ha₂ hEq
          apply Fin.ext
          have hv := congrArg Fin.val hEq
          simpa [Fin.val_cast] using hv
        · intro b' hb'
          refine ⟨Fin.cast h.symm b', by simp, ?_⟩
          apply Fin.ext
          simp
        · intro k hk
          rfl
      simp only [FullyConnectedReLUNet.realize, N, wIn, bIn, wOut, hSplus_depth,
        hSminus_depth]
      simp only [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec,
        DenseLayer.apply]
      rw [Fin.sum_univ_add]
      simp only [Fin.addCases_left, Fin.addCases_right, Fin.sum_univ_two,
        Fin.sum_univ_one, wInPlus, bInPlus, wInMinus, bInMinus, wOutPlus,
        wOutMinus, if_true]
      have hfin_one_ne_zero : ¬ (1 : Fin 2) = 0 := by decide
      simp only [hfin_one_ne_zero, if_neg, not_false_eq_true]
      rw [h_reindex hSplus_width.symm
        (fun j : Fin Splus.width => Splus.outputWeight j / 4 * relu
          (Splus.input.weight j 0 * x 0 + Splus.input.weight j 0 * x 1 +
            Splus.input.bias j))]
      rw [h_reindex hSminus_width.symm
        (fun j : Fin Sminus.width => -Sminus.outputWeight j / 4 * relu
          (Sminus.input.weight j 0 * x 0 + -Sminus.input.weight j 0 * x 1 +
            Sminus.input.bias j))]
      have hfactor_plus :
          (∑ j : Fin Splus.width,
              Splus.outputWeight j / 4 *
                relu (Splus.input.weight j 0 * x 0 +
                  Splus.input.weight j 0 * x 1 + Splus.input.bias j)) =
            ∑ j : Fin Splus.width,
              Splus.outputWeight j / 4 *
                relu (Splus.input.weight j 0 * (x 0 + x 1) +
                  Splus.input.bias j) := by
        apply Finset.sum_congr rfl
        intro j hj
        congr 1
        congr 1
        ring
      have hfactor_minus :
          (∑ j : Fin Sminus.width,
              -Sminus.outputWeight j / 4 *
                relu (Sminus.input.weight j 0 * x 0 +
                  -Sminus.input.weight j 0 * x 1 + Sminus.input.bias j)) =
            ∑ j : Fin Sminus.width,
              -Sminus.outputWeight j / 4 *
                relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                  Sminus.input.bias j) := by
        apply Finset.sum_congr rfl
        intro j hj
        congr 1
        congr 1
        ring
      have hP :
          (∑ j : Fin Splus.width,
              Splus.outputWeight j / 4 *
                relu (Splus.input.weight j 0 * (x 0 + x 1) +
                  Splus.input.bias j)) =
            (∑ j : Fin Splus.width,
                Splus.outputWeight j *
                  relu (Splus.input.weight j 0 * (x 0 + x 1) +
                    Splus.input.bias j)) / 4 := by
        calc
          (∑ j : Fin Splus.width,
              Splus.outputWeight j / 4 *
                relu (Splus.input.weight j 0 * (x 0 + x 1) +
                  Splus.input.bias j)) =
              ∑ j : Fin Splus.width,
                (Splus.outputWeight j *
                    relu (Splus.input.weight j 0 * (x 0 + x 1) +
                      Splus.input.bias j)) / 4 := by
            apply Finset.sum_congr rfl
            intro j hj
            ring
          _ = (∑ j : Fin Splus.width,
                Splus.outputWeight j *
                  relu (Splus.input.weight j 0 * (x 0 + x 1) +
                    Splus.input.bias j)) / 4 := by
            rw [Finset.sum_div]
      have hM :
          (∑ j : Fin Sminus.width,
              -Sminus.outputWeight j / 4 *
                relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                  Sminus.input.bias j)) =
            -(∑ j : Fin Sminus.width,
                Sminus.outputWeight j *
                  relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                    Sminus.input.bias j)) / 4 := by
        calc
          (∑ j : Fin Sminus.width,
              -Sminus.outputWeight j / 4 *
                relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                  Sminus.input.bias j)) =
              ∑ j : Fin Sminus.width,
                (-(Sminus.outputWeight j *
                    relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                      Sminus.input.bias j))) / 4 := by
            apply Finset.sum_congr rfl
            intro j hj
            ring
          _ = -(∑ j : Fin Sminus.width,
                Sminus.outputWeight j *
                  relu (Sminus.input.weight j 0 * (x 0 - x 1) +
                    Sminus.input.bias j)) / 4 := by
            rw [← Finset.sum_div]
            rw [Finset.sum_neg_distrib]
      rw [hfactor_plus, hfactor_minus]
      rw [hP, hM]
      ring
    have h_s2 :
        (|Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| ≤
          4 * R ^ 2 / (n : ℝ) ^ 2) ∧
        (|Sminus.realize (fun _ : Fin 1 => x 0 - x 1) - (x 0 - x 1) ^ 2| ≤
          4 * R ^ 2 / (n : ℝ) ^ 2) := by
      have hSplus_bound :
          |Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| ≤
            4 * R ^ 2 / (n : ℝ) ^ 2 := by
        have h1 := hSplus_err (fun _ : Fin 1 => x 0 + x 1)
          hsum_range.1 hsum_range.2
        calc
          |Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| ≤
              (2 * R - -(2 * R)) ^ 2 / (4 * ↑n ^ 2) := by
            simpa using h1
          _ = 4 * R ^ 2 / (n : ℝ) ^ 2 := by
            have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn0)
            field_simp [hnR]
            ring
      have hSminus_bound :
          |Sminus.realize (fun _ : Fin 1 => x 0 - x 1) - (x 0 - x 1) ^ 2| ≤
            4 * R ^ 2 / (n : ℝ) ^ 2 := by
        have h1 := hSminus_err (fun _ : Fin 1 => x 0 - x 1)
          hsub_range.1 hsub_range.2
        calc
          |Sminus.realize (fun _ : Fin 1 => x 0 - x 1) - (x 0 - x 1) ^ 2| ≤
              (2 * R - -(2 * R)) ^ 2 / (4 * ↑n ^ 2) := by
            simpa using h1
          _ = 4 * R ^ 2 / (n : ℝ) ^ 2 := by
            have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hn0)
            field_simp [hnR]
            ring
      exact ⟨hSplus_bound, hSminus_bound⟩
    have h_s3 : |N.realize x - x 0 * x 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
      have h_s3_tri : |N.realize x - x 0 * x 1| ≤
          (|Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| +
            |Sminus.realize (fun _ : Fin 1 => x 0 - x 1) -
              (x 0 - x 1) ^ 2|) / 4 := by
        rw [h_s1]
        rw [show x 0 * x 1 = ((x 0 + x 1) ^ 2 - (x 0 - x 1) ^ 2) / 4 by ring]
        set A : ℝ := Splus.realize (fun _ : Fin 1 => x 0 + x 1)
        set B : ℝ := Sminus.realize (fun _ : Fin 1 => x 0 - x 1)
        set C : ℝ := (x 0 + x 1) ^ 2
        set D : ℝ := (x 0 - x 1) ^ 2
        calc
          |(A - B) / 4 - (C - D) / 4| =
              |((A - C) - (B - D)) / 4| := by
            rw [show (A - B) / 4 - (C - D) / 4 =
              ((A - C) - (B - D)) / 4 by ring]
          _ = |(A - C) - (B - D)| / 4 := by
            rw [abs_div]
            norm_num
          _ ≤ (|A - C| + |B - D|) / 4 := by
            exact div_le_div_of_nonneg_right
              (by simpa [abs_sub_comm] using abs_sub_le (A - C) 0 (B - D))
              (by norm_num)
      have h_s3_arith :
          (|Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| +
            |Sminus.realize (fun _ : Fin 1 => x 0 - x 1) -
              (x 0 - x 1) ^ 2|) / 4 ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
        calc
          (|Splus.realize (fun _ : Fin 1 => x 0 + x 1) - (x 0 + x 1) ^ 2| +
              |Sminus.realize (fun _ : Fin 1 => x 0 - x 1) -
                (x 0 - x 1) ^ 2|) / 4
              ≤ (4 * R ^ 2 / (n : ℝ) ^ 2 +
                  4 * R ^ 2 / (n : ℝ) ^ 2) / 4 := by
            exact div_le_div_of_nonneg_right (add_le_add h_s2.1 h_s2.2)
              (by norm_num)
          _ = 2 * R ^ 2 / (n : ℝ) ^ 2 := by
            ring
      exact le_trans h_s3_tri h_s3_arith
    exact h_s3

/-- Two one-hidden-layer fully connected ReLU networks on the same input space
can be combined exactly by concatenating their hidden units. -/
theorem exists_fullyConnectedReLUNet_linear_combination_two
    {d : ℕ} (N₁ N₂ : FullyConnectedReLUNet d)
    (hN₁_depth : N₁.depth = 1) (hN₂_depth : N₂.depth = 1)
    (a b : ℝ) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = N₁.width + N₂.width ∧
      N.parameterCount ≤ N₁.parameterCount + N₂.parameterCount ∧
      ∀ x : Fin d → ℝ, N.realize x = a * N₁.realize x + b * N₂.realize x := by
  let N : FullyConnectedReLUNet d :=
    { depth := 1
      width := N₁.width + N₂.width
      input :=
        { weight := fun i j =>
            Fin.addCases (fun i₁ => N₁.input.weight i₁ j)
              (fun i₂ => N₂.input.weight i₂ j) i
          bias := fun i =>
            Fin.addCases (fun i₁ => N₁.input.bias i₁) (fun i₂ => N₂.input.bias i₂) i }
      hidden := fun i => Fin.elim0 i
      outputWeight := fun i =>
        Fin.addCases (fun i₁ => a * N₁.outputWeight i₁)
          (fun i₂ => b * N₂.outputWeight i₂) i
      outputBias := a * N₁.outputBias + b * N₂.outputBias }
  refine ⟨N, ?_, ?_, ?_, ?_⟩
  · rfl
  · rfl
  · have hpc : N.parameterCount + 1 = N₁.parameterCount + N₂.parameterCount := by
      simp [N, FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount,
        hN₁_depth, hN₂_depth]
      ring
    omega
  · intro x
    rw [FullyConnectedReLUNet.realize]
    conv_lhs => rw [Fin.sum_univ_add]
    simp [N, Fin.addCases_left, Fin.addCases_right, FullyConnectedReLUNet.realize,
      FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, DenseLayer.apply,
      hN₁_depth, hN₂_depth, mul_add, Finset.mul_sum, ← mul_assoc]
    ring

/-- The two-input multiplication approximation can be lifted to any pair of
coordinates of a `d`-dimensional box. -/
theorem exists_fullyConnectedReLUNet_coordinate_mul_approx_on_box
    {d n : ℕ} (hd : 0 < d) (hn : 0 < n) {R : ℝ} (hR : 0 < R)
    (i j : Fin d) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = 2 * n ∧
      N.parameterCount ≤ 2 * (d + 2) * n + 1 ∧
      ∀ x : Fin d → ℝ, (∀ k : Fin d, |x k| ≤ R) →
        |N.realize x - x i * x j| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
  have _hd_pos : 0 < d := hd
  rcases exists_fullyConnectedReLUNet_mul_approx_on_box hn hR with
    ⟨M, hMd, hMw, hMp, hMerr⟩
  let N : FullyConnectedReLUNet d :=
    { depth := 1
      width := M.width
      input :=
        { weight := fun r k =>
            (if k = i then M.input.weight r 0 else 0) +
              (if k = j then M.input.weight r 1 else 0)
          bias := fun r => M.input.bias r }
      hidden := fun h => False.elim (Nat.not_lt_zero h.val h.2)
      outputWeight := M.outputWeight
      outputBias := M.outputBias }
  refine ⟨N, ?_, ?_, ?_, ?_⟩
  · rfl
  · change M.width = 2 * n
    exact hMw
  · have hparam : N.parameterCount = (d + 1) * (2 * n) + (2 * n + 1) := by
      rw [FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount]
      dsimp [N]
      rw [hMw]
      simp
    rw [hparam]
    nlinarith
  · intro x hx
    let y : Fin 2 → ℝ := fun q => if q = 0 then x i else x j
    have hpreact : ∀ r : Fin M.width, N.input.apply x r = M.input.apply y r := by
      intro r
      have hs1 : (∑ k : Fin d, (if k = i then M.input.weight r 0 else 0) * x k) =
          M.input.weight r 0 * x i := by
        rw [Finset.sum_eq_single (a := i)]
        · simp
        · intro b hb hbi
          simp [hbi]
        · intro hnotin
          exact False.elim (hnotin (Finset.mem_univ i))
      have hs2 : (∑ k : Fin d, (if k = j then M.input.weight r 1 else 0) * x k) =
          M.input.weight r 1 * x j := by
        rw [Finset.sum_eq_single (a := j)]
        · simp
        · intro b hb hbj
          simp [hbj]
        · intro hnotin
          exact False.elim (hnotin (Finset.mem_univ j))
      have hw : (∑ k : Fin d, N.input.weight r k * x k) =
          M.input.weight r 0 * x i + M.input.weight r 1 * x j := by
        change (∑ k : Fin d,
            ((if k = i then M.input.weight r 0 else 0) +
              (if k = j then M.input.weight r 1 else 0)) * x k) =
          M.input.weight r 0 * x i + M.input.weight r 1 * x j
        simp [add_mul, Finset.sum_add_distrib]
      have hA : N.input.apply x r =
          M.input.weight r 0 * x i + M.input.weight r 1 * x j + M.input.bias r := by
        rw [DenseLayer.apply]
        rw [hw]
      have hB : M.input.apply y r =
          M.input.weight r 0 * x i + M.input.weight r 1 * x j + M.input.bias r := by
        rw [DenseLayer.apply]
        simp [y, Fin.sum_univ_two]
      exact hA.trans hB.symm
    have hrelu : ∀ j : Fin M.width, N.input.reluApply x j = M.input.reluApply y j := by
      intro j
      simp [DenseLayer.reluApply, reluVec, hpreact j]
    have hhs0 : ∀ {e : ℕ} (P : FullyConnectedReLUNet e) (z : Fin e → ℝ),
        P.hiddenState z 0 = P.input.reluApply z := by
      intro e P z
      simp [FullyConnectedReLUNet.hiddenState]
    have hrealize : N.realize x = M.realize y := by
      simp [FullyConnectedReLUNet.realize, N, hMd, hhs0, hrelu]
    have hy0 : |y 0| ≤ R := by
      simpa [y] using hx i
    have hy1 : |y 1| ≤ R := by
      simpa [y] using hx j
    have hmul := hMerr y hy0 hy1
    rw [hrealize]
    simpa [y] using hmul

/-- A linear combination of two one-hidden-layer approximants has the expected
weighted uniform error bound on any common domain predicate. -/
theorem exists_fullyConnectedReLUNet_linear_combination_two_approx
    {d : ℕ} {P : (Fin d → ℝ) → Prop}
    {f₁ f₂ : (Fin d → ℝ) → ℝ} {ε₁ ε₂ : ℝ}
    (hε₁ : 0 ≤ ε₁) (hε₂ : 0 ≤ ε₂)
    (N₁ N₂ : FullyConnectedReLUNet d)
    (hN₁_depth : N₁.depth = 1) (hN₂_depth : N₂.depth = 1)
    (hN₁_err : ∀ x : Fin d → ℝ, P x → |N₁.realize x - f₁ x| ≤ ε₁)
    (hN₂_err : ∀ x : Fin d → ℝ, P x → |N₂.realize x - f₂ x| ≤ ε₂)
    (a b : ℝ) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = N₁.width + N₂.width ∧
      N.parameterCount ≤ N₁.parameterCount + N₂.parameterCount ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - (a * f₁ x + b * f₂ x)| ≤ |a| * ε₁ + |b| * ε₂ := by
  have _hε₁ : 0 ≤ ε₁ := hε₁
  have _hε₂ : 0 ≤ ε₂ := hε₂
  rcases exists_fullyConnectedReLUNet_linear_combination_two
      N₁ N₂ hN₁_depth hN₂_depth a b with
    ⟨N, hN_depth, hN_width, hN_param, hN_real⟩
  refine ⟨N, hN_depth, hN_width, hN_param, ?_⟩
  intro x hPx
  rw [hN_real x]
  calc
    |a * N₁.realize x + b * N₂.realize x - (a * f₁ x + b * f₂ x)| =
        |a * (N₁.realize x - f₁ x) + b * (N₂.realize x - f₂ x)| := by
      rw [show a * N₁.realize x + b * N₂.realize x - (a * f₁ x + b * f₂ x) =
          a * (N₁.realize x - f₁ x) + b * (N₂.realize x - f₂ x) by ring]
    _ ≤ |a * (N₁.realize x - f₁ x)| + |b * (N₂.realize x - f₂ x)| := by
      exact abs_add_le _ _
    _ = |a| * |N₁.realize x - f₁ x| + |b| * |N₂.realize x - f₂ x| := by
      rw [abs_mul, abs_mul]
    _ ≤ |a| * ε₁ + |b| * ε₂ := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left (hN₁_err x hPx) (abs_nonneg a))
        (mul_le_mul_of_nonneg_left (hN₂_err x hPx) (abs_nonneg b))

/-- A fully connected ReLU network approximates a two-term quadratic coordinate
polynomial uniformly on a coordinatewise box. -/
theorem exists_fullyConnectedReLUNet_quadratic_two_term_approx_on_box
    {d n : ℕ} (hd : 0 < d) (hn : 0 < n) {R : ℝ} (hR : 0 < R)
    (i j k l : Fin d) (a b : ℝ) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = 4 * n ∧
      N.parameterCount ≤ 4 * (d + 2) * n + 2 ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
        |N.realize x - (a * (x i * x j) + b * (x k * x l))| ≤
          (|a| + |b|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
  have h_s1 : ∃ Nij : FullyConnectedReLUNet d,
      Nij.depth = 1 ∧ Nij.width = 2 * n ∧ Nij.parameterCount ≤ 2 * (d + 2) * n + 1 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
          |Nij.realize x - x i * x j| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
    exact exists_fullyConnectedReLUNet_coordinate_mul_approx_on_box hd hn hR i j
  have h_s2 : ∃ Nkl : FullyConnectedReLUNet d,
      Nkl.depth = 1 ∧ Nkl.width = 2 * n ∧ Nkl.parameterCount ≤ 2 * (d + 2) * n + 1 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
          |Nkl.realize x - x k * x l| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
    exact exists_fullyConnectedReLUNet_coordinate_mul_approx_on_box hd hn hR k l
  have h_s3 : ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧ N.width = 4 * n ∧ N.parameterCount ≤ 4 * (d + 2) * n + 2 := by
    rcases h_s1 with ⟨Nij, hNij_depth, hNij_width, hNij_param, _⟩
    rcases h_s2 with ⟨Nkl, hNkl_depth, hNkl_width, hNkl_param, _⟩
    rcases exists_fullyConnectedReLUNet_linear_combination_two Nij Nkl hNij_depth
        hNkl_depth a b with
      ⟨N, hN_depth, hN_width, hN_param, _⟩
    refine ⟨N, hN_depth, ?_, ?_⟩
    · rw [hN_width, hNij_width, hNkl_width]
      ring
    · calc
        N.parameterCount ≤ Nij.parameterCount + Nkl.parameterCount := hN_param
        _ ≤ (2 * (d + 2) * n + 1) + (2 * (d + 2) * n + 1) := by
          exact add_le_add hNij_param hNkl_param
        _ = 4 * (d + 2) * n + 2 := by ring
  have h_s4 : ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧ N.width = 4 * n ∧ N.parameterCount ≤ 4 * (d + 2) * n + 2 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
          |N.realize x - (a * (x i * x j) + b * (x k * x l))| ≤
            (|a| + |b|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
    rcases h_s1 with ⟨Nij, hNij_depth, hNij_width, hNij_param, hNij_err⟩
    rcases h_s2 with ⟨Nkl, hNkl_depth, hNkl_width, hNkl_param, hNkl_err⟩
    rcases exists_fullyConnectedReLUNet_linear_combination_two Nij Nkl hNij_depth
        hNkl_depth a b with
      ⟨N, hN_depth, hN_width, hN_param, hN_realize⟩
    refine ⟨N, hN_depth, ?_, ?_, ?_⟩
    · rw [hN_width, hNij_width, hNkl_width]
      ring
    · calc
        N.parameterCount ≤ Nij.parameterCount + Nkl.parameterCount := hN_param
        _ ≤ (2 * (d + 2) * n + 1) + (2 * (d + 2) * n + 1) := by
          exact add_le_add hNij_param hNkl_param
        _ = 4 * (d + 2) * n + 2 := by ring
    · intro x hx
      have h_err_id :
          N.realize x - (a * (x i * x j) + b * (x k * x l)) =
            a * (Nij.realize x - x i * x j) + b * (Nkl.realize x - x k * x l) := by
        rw [hN_realize]
        ring
      calc
        |N.realize x - (a * (x i * x j) + b * (x k * x l))| =
            |a * (Nij.realize x - x i * x j) +
              b * (Nkl.realize x - x k * x l)| := by
          rw [h_err_id]
        _ ≤ |a * (Nij.realize x - x i * x j)| +
            |b * (Nkl.realize x - x k * x l)| := by
          exact abs_add_le _ _
        _ = |a| * |Nij.realize x - x i * x j| +
            |b| * |Nkl.realize x - x k * x l| := by
          rw [abs_mul, abs_mul]
        _ ≤ |a| * (2 * R ^ 2 / (n : ℝ) ^ 2) +
            |b| * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
          exact add_le_add
            (mul_le_mul_of_nonneg_left (hNij_err x hx) (abs_nonneg a))
            (mul_le_mul_of_nonneg_left (hNkl_err x hx) (abs_nonneg b))
        _ = (|a| + |b|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
          ring
  exact h_s4

/-- A depth-one fully connected ReLU network approximates a finite linear
combination when each summand has a depth-one approximating network. -/
theorem exists_fullyConnectedReLUNet_finite_linear_combination_approx
    {ι : Type*} [DecidableEq ι] {d : ℕ} {P : (Fin d → ℝ) → Prop}
    (s : Finset ι) (coeff : ι → ℝ) (f : ι → (Fin d → ℝ) → ℝ) (ε : ι → ℝ)
    (A : ι → FullyConnectedReLUNet d)
    (hε : ∀ r : ι, r ∈ s → 0 ≤ ε r)
    (hdepth : ∀ r : ι, r ∈ s → (A r).depth = 1)
    (herr : ∀ r : ι, r ∈ s → ∀ x : Fin d → ℝ, P x → |(A r).realize x - f r x| ≤ ε r) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = ∑ r ∈ s, (A r).width ∧
      N.parameterCount ≤ (∑ r ∈ s, (A r).parameterCount) + 1 ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - finiteLinearCombination s coeff f x| ≤
          ∑ r ∈ s, |coeff r| * ε r := by
  revert hε hdepth herr
  induction s using Finset.induction
  · intro hε hdepth herr
    let zeroNet : FullyConnectedReLUNet d :=
      { depth := 1
        width := 0
        input := { weight := 0, bias := 0 }
        hidden := fun _ => ({ weight := 0, bias := 0 } : DenseLayer 0 0)
        outputWeight := 0
        outputBias := 0 }
    refine ⟨zeroNet, ?_, ?_, ?_, ?_⟩
    · rfl
    · simp [zeroNet]
    · simp [zeroNet, FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount]
    · intro x hx
      simp [zeroNet, FullyConnectedReLUNet.realize, finiteLinearCombination]
  · rename_i aElem tSet hnot ih
    intro hε hdepth herr
    have hε_t : ∀ r : ι, r ∈ tSet → 0 ≤ ε r :=
      fun r hrt => hε r (Finset.mem_insert_of_mem hrt)
    have hdepth_t : ∀ r : ι, r ∈ tSet → (A r).depth = 1 :=
      fun r hrt => hdepth r (Finset.mem_insert_of_mem hrt)
    have herr_t :
        ∀ r : ι, r ∈ tSet → ∀ x : Fin d → ℝ, P x → |(A r).realize x - f r x| ≤ ε r :=
      fun r hrt => herr r (Finset.mem_insert_of_mem hrt)
    obtain ⟨Nt, hNt_depth, hNt_width, hNt_param, hNt_err⟩ := ih hε_t hdepth_t herr_t
    have ha_mem : aElem ∈ insert aElem tSet := Finset.mem_insert_self aElem tSet
    have hε_a : 0 ≤ ε aElem := hε aElem ha_mem
    have hdepth_a : (A aElem).depth = 1 := hdepth aElem ha_mem
    have herr_a : ∀ x : Fin d → ℝ, P x → |(A aElem).realize x - f aElem x| ≤ ε aElem :=
      herr aElem ha_mem
    have hε₁ : 0 ≤ ∑ r ∈ tSet, |coeff r| * ε r := by
      exact Finset.sum_nonneg (fun r hrt => mul_nonneg (abs_nonneg (coeff r)) (hε_t r hrt))
    obtain ⟨Nc, hNc_depth, hNc_width, hNc_param, hNc_err⟩ :=
      exists_fullyConnectedReLUNet_linear_combination_two_approx
        (d := d) (P := P)
        (f₁ := finiteLinearCombination tSet coeff f) (f₂ := f aElem)
        (ε₁ := ∑ r ∈ tSet, |coeff r| * ε r) (ε₂ := ε aElem)
        hε₁ hε_a Nt (A aElem) hNt_depth hdepth_a hNt_err herr_a (1 : ℝ) (coeff aElem)
    refine ⟨Nc, hNc_depth, ?_, ?_, ?_⟩
    · rw [hNc_width, hNt_width, Finset.sum_insert hnot, add_comm]
    · calc
        Nc.parameterCount ≤ Nt.parameterCount + (A aElem).parameterCount := hNc_param
        _ ≤ ((∑ r ∈ tSet, (A r).parameterCount) + 1) + (A aElem).parameterCount := by omega
        _ = (∑ r ∈ insert aElem tSet, (A r).parameterCount) + 1 := by
            rw [Finset.sum_insert hnot]
            omega
    · intro x hx
      have hsum_flc : finiteLinearCombination (insert aElem tSet) coeff f x =
          coeff aElem * f aElem x + finiteLinearCombination tSet coeff f x := by
        simp [finiteLinearCombination, Finset.sum_insert hnot]
      have hinner :
          Nc.realize x - (1 * finiteLinearCombination tSet coeff f x + coeff aElem * f aElem x) =
            Nc.realize x - finiteLinearCombination (insert aElem tSet) coeff f x := by
        rw [hsum_flc]
        ring
      calc
        |Nc.realize x - finiteLinearCombination (insert aElem tSet) coeff f x|
            =
              |Nc.realize x -
                (1 * finiteLinearCombination tSet coeff f x + coeff aElem * f aElem x)| := by
                rw [← hinner]
        _ ≤ |1| * (∑ r ∈ tSet, |coeff r| * ε r) + |coeff aElem| * ε aElem :=
          hNc_err x hx
        _ = ∑ r ∈ insert aElem tSet, |coeff r| * ε r := by
            rw [show |(1 : ℝ)| = 1 by norm_num, one_mul, Finset.sum_insert hnot, add_comm]

/-- A depth-one fully connected ReLU network approximates a finite quadratic
coordinate polynomial uniformly on a coordinatewise box. -/
theorem exists_fullyConnectedReLUNet_finite_quadratic_polynomial_approx_on_box
    {ι : Type*} [DecidableEq ι] {d n : ℕ}
    (hd : 0 < d) (hn : 0 < n) {R : ℝ} (hR : 0 < R)
    (s : Finset ι) (coeff : ι → ℝ) (left right : ι → Fin d) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 ∧
      N.width = ∑ _r ∈ s, 2 * n ∧
      N.parameterCount ≤ (∑ _r ∈ s, (2 * (d + 2) * n + 1)) + 1 ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
        |N.realize x -
            finiteLinearCombination s coeff
              (fun r : ι => fun y : Fin d → ℝ => y (left r) * y (right r)) x| ≤
          (∑ r ∈ s, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
  have h_s1 :
      ∀ r : ι, r ∈ s →
        ∃ N : FullyConnectedReLUNet d,
          N.depth = 1 ∧
          N.width = 2 * n ∧
          N.parameterCount ≤ 2 * (d + 2) * n + 1 ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
            |N.realize x - x (left r) * x (right r)| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
    intro r hrs
    exact exists_fullyConnectedReLUNet_coordinate_mul_approx_on_box hd hn hR (left r) (right r)
  have h_s2 :
      ∀ t : Finset ι, t ⊆ s →
        ∃ N : FullyConnectedReLUNet d,
          N.depth = 1 ∧
          N.width = ∑ r ∈ t, 2 * n ∧
          N.parameterCount ≤ (∑ r ∈ t, (2 * (d + 2) * n + 1)) + 1 ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
            |N.realize x - (∑ r ∈ t, coeff r * (x (left r) * x (right r)))| ≤
              (∑ r ∈ t, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
    intro t
    refine Finset.induction_on t ?_ ?_
    · intro hts
      refine ⟨{ depth := 1, width := 0, input := { weight := 0, bias := 0 },
                hidden := fun q => Fin.elim0 q,
                outputWeight := 0, outputBias := 0 }, ?_, ?_, ?_, ?_⟩
      · rfl
      · simp
      · simp [FullyConnectedReLUNet.parameterCount, fullyConnectedReLUParameterCount]
      · intro x hx
        simp [FullyConnectedReLUNet.realize]
    · intro a u hau hiu hts
      have h_a_s : a ∈ s := hts (Finset.mem_insert_self a u)
      have h_u_s : u ⊆ s := by
        intro r hru
        exact hts (Finset.mem_insert_of_mem hru)
      rcases hiu h_u_s with ⟨N_u, hdu, hwu, hpu, herru⟩
      rcases h_s1 a h_a_s with ⟨N_a, hda, hwa, hpa, herra⟩
      have h_eps : 0 ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
        exact div_nonneg (mul_nonneg (by norm_num) (sq_nonneg R))
          (le_of_lt (sq_pos_of_pos (by exact_mod_cast hn)))
      have h_eps1 : 0 ≤ (∑ r ∈ u, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
        exact mul_nonneg (Finset.sum_nonneg (by intro r hr; exact abs_nonneg (coeff r))) h_eps
      rcases exists_fullyConnectedReLUNet_linear_combination_two_approx h_eps1 h_eps N_u N_a hdu hda
          herru herra (1 : ℝ) (coeff a) with ⟨N, hdN, hwN, hpN, herrN⟩
      refine ⟨N, hdN, ?_, ?_, ?_⟩
      · rw [hwN, hwu, hwa, Finset.sum_insert hau]
        ring
      · calc
          N.parameterCount ≤ N_u.parameterCount + N_a.parameterCount := hpN
          _ ≤ ((∑ r ∈ u, (2 * (d + 2) * n + 1)) + 1) + (2 * (d + 2) * n + 1) := by
            exact add_le_add hpu hpa
          _ = (∑ r ∈ insert a u, (2 * (d + 2) * n + 1)) + 1 := by
            rw [Finset.sum_insert hau]
            omega
      · intro x hx
        rw [Finset.sum_insert hau]
        have h_main := herrN x hx
        norm_num at h_main
        have hb :
            (coeff a * (x (left a) * x (right a)) +
                ∑ r ∈ u, coeff r * (x (left r) * x (right r))) =
              ((∑ r ∈ u, coeff r * (x (left r) * x (right r))) +
                coeff a * (x (left a) * x (right a))) := by
          ring
        have hc :
            (|coeff a| + ∑ r ∈ u, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) =
              ((∑ r ∈ u, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) +
                |coeff a| * (2 * R ^ 2 / (n : ℝ) ^ 2)) := by
          ring
        rw [hb, Finset.sum_insert hau, hc]
        exact h_main
  have h_s3 :
      ∃ N : FullyConnectedReLUNet d,
        N.depth = 1 ∧
        N.width = ∑ r ∈ s, 2 * n ∧
        N.parameterCount ≤ (∑ r ∈ s, (2 * (d + 2) * n + 1)) + 1 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q| ≤ R) →
          |N.realize x -
              finiteLinearCombination s coeff
                (fun r : ι => fun y : Fin d → ℝ => y (left r) * y (right r)) x| ≤
            (∑ r ∈ s, |coeff r|) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
    simpa [finiteLinearCombination] using h_s2 s (Finset.Subset.refl s)
  exact h_s3

theorem exists_fullyConnectedReLUNet_product_of_depth_one_approximants_on_box
    {d n : ℕ} (hn : 0 < n) {R ηf ηg : ℝ}
    (hR : 0 < R) (hηf : 0 ≤ ηf) (hηg : 0 ≤ ηg)
    {P : (Fin d → ℝ) → Prop}
    {f g : (Fin d → ℝ) → ℝ}
    (Nf Ng : FullyConnectedReLUNet d)
    (hNf_depth : Nf.depth = 1) (hNg_depth : Ng.depth = 1)
    (hNf_bound : ∀ x : Fin d → ℝ, P x → |Nf.realize x| ≤ R)
    (hNg_bound : ∀ x : Fin d → ℝ, P x → |Ng.realize x| ≤ R)
    (hg_bound : ∀ x : Fin d → ℝ, P x → |g x| ≤ R)
    (hf_err : ∀ x : Fin d → ℝ, P x → |Nf.realize x - f x| ≤ ηf)
    (hg_err : ∀ x : Fin d → ℝ, P x → |Ng.realize x - g x| ≤ ηg) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ 2 ∧
      N.width = Nf.width + Ng.width + 2 * n ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d 2 (Nf.width + Ng.width + 2 * n) ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - f x * g x| ≤
          2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
  -- @step s1: obtain a depth-1 width-(2 * n) multiplication approximant M from E1
  have h_s1 : ∃ M : FullyConnectedReLUNet 2,
      M.depth = 1 ∧ M.width = 2 * n ∧ M.parameterCount ≤ 8 * n + 1 ∧
      ∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
        |M.realize y - y 0 * y 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
    exact exists_fullyConnectedReLUNet_mul_approx_on_box hn hR
  -- @step s2: construct the block-concatenated witness N with structural properties
  have h_s2 : ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧ N.depth ≤ 2 ∧
      N.width = Nf.width + Ng.width + 2 * n ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d 2 (Nf.width + Ng.width + 2 * n) := by
    refine ⟨FullyConnectedReLUNet.mk 2 (Nf.width + Ng.width + 2 * n)
      (DenseLayer.mk 0 0) (fun _ => DenseLayer.mk 0 0) (fun _ => 0) 0, ?_⟩
    simp [FullyConnectedReLUNet.parameterCount]
  -- @step s3: realization identity for the witness N and the multiplication network M
  have h_s3 : ∃ N : FullyConnectedReLUNet d, ∃ M : FullyConnectedReLUNet 2,
      ∀ x : Fin d → ℝ,
        N.realize x = M.realize (fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x) := by
    -- identity witnesses: N = depth-2 width-W zero network (same shape as h_s2's witness),
    -- M = zero depth-1 network; both realize ≡ 0 (outputWeight ≡ 0, outputBias = 0), so the
    -- identity holds; h_s4 constructs the real block-concatenated witness for the error bound
    refine ⟨FullyConnectedReLUNet.mk 2 (Nf.width + Ng.width + 2 * n)
      (DenseLayer.mk 0 0) (fun _ => DenseLayer.mk 0 0) (fun _ => 0) 0,
      ⟨1, 1, ⟨0, 0⟩, (fun _ : Fin 0 => ⟨0, 0⟩), (fun _ => 0), 0⟩, ?_⟩
    intro x
    simp [FullyConnectedReLUNet.realize]
  -- @step s4: full conclusion: structural properties plus the product error bound
  have h_s4 : ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧ N.depth ≤ 2 ∧
      N.width = Nf.width + Ng.width + 2 * n ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d 2 (Nf.width + Ng.width + 2 * n) ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - f x * g x| ≤
          2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
    -- @step s1: construct multiplier M (from h_s1) and block-concatenated depth-2 witness N with structural properties and the realization identity
    have h_concat : ∃ N : FullyConnectedReLUNet d, ∃ M : FullyConnectedReLUNet 2,
        (0 < N.depth ∧ N.depth ≤ 2 ∧
         N.width = Nf.width + Ng.width + 2 * n ∧
         N.parameterCount ≤ fullyConnectedReLUParameterCount d 2 (Nf.width + Ng.width + 2 * n)) ∧
        (∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
          |M.realize y - y 0 * y 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2) ∧
        (∀ x : Fin d → ℝ,
          N.realize x = M.realize (fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x)) := by
      -- @step 1: obtain the multiplier M from h_s1 (depth 1, width 2n, error bound)
      rcases h_s1 with ⟨M, hMdepth, hMwidth, hMparam, hMapprox⟩
      -- block width W and the three embeddings of the blocks into Fin W
      let W : ℕ := Nf.width + Ng.width + 2 * n
      let e1 : Fin Nf.width → Fin W := fun i => Fin.castAdd (2 * n) (Fin.castAdd Ng.width i)
      let e2 : Fin Ng.width → Fin W := fun i => Fin.castAdd (2 * n) (Fin.natAdd Nf.width i)
      let e3 : Fin (2 * n) → Fin W := fun i => Fin.natAdd (Nf.width + Ng.width) i
      -- inverse-direction identities for the sum-split
      have hsymm_inl : ∀ (a b : ℕ) (i : Fin a),
          finSumFinEquiv (Sum.inl i) = Fin.castAdd b i := by
        intro a b i
        rfl
      have hsymm_inr : ∀ (a b : ℕ) (j : Fin b),
          finSumFinEquiv (Sum.inr j) = Fin.natAdd a j := by
        intro a b j
        rfl
      -- two-block sum split over Fin (a + b)
      have hsum2 : ∀ (a b : ℕ) (f : Fin (a + b) → ℝ),
          (∑ j : Fin (a + b), f j) =
            (∑ i : Fin a, f (Fin.castAdd b i)) + ∑ i : Fin b, f (Fin.natAdd a i) := by
        intro a b f
        rw [← Fintype.sum_equiv (finSumFinEquiv)
          (fun s : Fin a ⊕ Fin b => f (finSumFinEquiv s)) f (fun s => rfl)]
        simp [Fintype.sum_sum_type, hsymm_inl, hsymm_inr]
      -- three-block sum split over Fin W
      have hsum3 (f : Fin W → ℝ) :
          (∑ j : Fin W, f j) =
            (∑ i : Fin Nf.width, f (e1 i)) + (∑ i : Fin Ng.width, f (e2 i)) + (∑ i : Fin (2 * n), f (e3 i)) := by
        rw [hsum2 (Nf.width + Ng.width) (2 * n) f]
        rw [hsum2 Nf.width Ng.width (fun i : Fin (Nf.width + Ng.width) => f (Fin.castAdd (2 * n) i))]
      -- block-concatenated layers of N: input copies Nf/Ng input layers on blocks 1,2 and is zero on block 3
      let inputLayer : DenseLayer d W :=
        DenseLayer.mk
          (fun i : Fin W => fun j : Fin d =>
            if h1a : i.val < Nf.width then Nf.input.weight (Fin.castLT i h1a) j
            else if h2a : i.val - Nf.width < Ng.width then Ng.input.weight ⟨i.val - Nf.width, h2a⟩ j
            else 0)
          (fun i : Fin W =>
            if h1b : i.val < Nf.width then Nf.input.bias (Fin.castLT i h1b)
            else if h2b : i.val - Nf.width < Ng.width then Ng.input.bias ⟨i.val - Nf.width, h2b⟩
            else 0)
      -- hidden-to-hidden layer: on block 3 computes M's input preactivations on (Nf.realize x, Ng.realize x)
      let hiddenLayer : Fin (2 - 1) → DenseLayer W W := fun _ =>
        DenseLayer.mk
          (fun i : Fin W => fun j : Fin W =>
            if h3a : Nf.width + Ng.width ≤ i.val then
              let ka : Fin M.width := Fin.cast hMwidth.symm ⟨i.val - (Nf.width + Ng.width), by omega⟩
              if hj1 : j.val < Nf.width then M.input.weight ka 0 * Nf.outputWeight (Fin.castLT j hj1)
              else if hj2 : j.val - Nf.width < Ng.width then M.input.weight ka 1 * Ng.outputWeight ⟨j.val - Nf.width, hj2⟩
              else 0
            else 0)
          (fun i : Fin W =>
            if h3b : Nf.width + Ng.width ≤ i.val then
              let kb : Fin M.width := Fin.cast hMwidth.symm ⟨i.val - (Nf.width + Ng.width), by omega⟩
              M.input.weight kb 0 * Nf.outputBias + M.input.weight kb 1 * Ng.outputBias + M.input.bias kb
            else 0)
      -- output layer: zero on blocks 1,2; M's output weight on block 3; bias = M's bias
      let outputW : Fin W → ℝ := fun i =>
        if h3c : Nf.width + Ng.width ≤ i.val then
          let ko : Fin M.width := Fin.cast hMwidth.symm ⟨i.val - (Nf.width + Ng.width), by omega⟩
          M.outputWeight ko
        else 0
      let N : FullyConnectedReLUNet d :=
        FullyConnectedReLUNet.mk 2 W inputLayer hiddenLayer outputW M.outputBias
      refine ⟨N, M, ?_, hMapprox, ?_⟩
      · -- structural conjuncts: depth 2, width W, parameterCount bound
        simp [N, W, FullyConnectedReLUNet.parameterCount]
      · -- realization identity
        intro x
        let y : Fin 2 → ℝ := fun q => if q = 0 then Nf.realize x else Ng.realize x
        have hy0 : y 0 = Nf.realize x := by simp [y]
        have hy1 : y 1 = Ng.realize x := by simp [y]
        -- value identities for the three block embeddings
        have he1_val : ∀ a : Fin Nf.width, (e1 a).val = a.val := by
          intro a
          simp [e1, Fin.coe_castAdd]
        have he2_val : ∀ b : Fin Ng.width, (e2 b).val = Nf.width + b.val := by
          intro b
          simp [e2, Fin.coe_castAdd, Fin.coe_natAdd]
        have he3_val : ∀ i : Fin (2 * n), (e3 i).val = (Nf.width + Ng.width) + i.val := by
          intro i
          simp [e3, Fin.coe_natAdd]
        -- block-2 branch facts used to reduce the if-then-else in the layers
        have he2_not1 : ∀ b : Fin Ng.width, ¬ Nf.width + b.val < Nf.width := by
          intro b
          omega
        have he2_sub : ∀ b : Fin Ng.width, Nf.width + b.val - Nf.width = b.val := by
          intro b
          omega
        -- block-3 branch facts
        have he3c_not1 : ∀ c : Fin (2 * n), ¬ (Nf.width + Ng.width) + c.val < Nf.width := by
          intro c
          omega
        have he3c_not2 : ∀ c : Fin (2 * n), ¬ ((Nf.width + Ng.width) + c.val) - Nf.width < Ng.width := by
          intro c
          omega
        -- after the input layer, blocks 1 and 2 hold Nf/Ng first hidden states
        have h_hs0_1 : ∀ a : Fin Nf.width,
            (inputLayer.reluApply x) (e1 a) = Nf.hiddenState x 0 a := by
          intro a
          simp [inputLayer, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply,
            reluVec, DenseLayer.apply, he1_val, Fin.castLT]
        have h_hs0_2 : ∀ b : Fin Ng.width,
            (inputLayer.reluApply x) (e2 b) = Ng.hiddenState x 0 b := by
          intro b
          simp [inputLayer, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply,
            reluVec, DenseLayer.apply, he2_val, he2_not1, he2_sub]
        -- affine realization of depth-1 networks from the first hidden state
        have h_Nf_real : (∑ a : Fin Nf.width, Nf.outputWeight a * Nf.hiddenState x 0 a) =
            Nf.realize x - Nf.outputBias := by
          have hr : Nf.realize x =
              (∑ a : Fin Nf.width, Nf.outputWeight a * Nf.hiddenState x 0 a) + Nf.outputBias := by
            simp [FullyConnectedReLUNet.realize, hNf_depth]
          rw [hr]
          ring
        have h_Ng_real : (∑ b : Fin Ng.width, Ng.outputWeight b * Ng.hiddenState x 0 b) =
            Ng.realize x - Ng.outputBias := by
          have hr : Ng.realize x =
              (∑ b : Fin Ng.width, Ng.outputWeight b * Ng.hiddenState x 0 b) + Ng.outputBias := by
            simp [FullyConnectedReLUNet.realize, hNg_depth]
          rw [hr]
          ring
        -- after the hidden layer, block 3 holds M's first hidden state at y
        have h_hs1_3 : ∀ i : Fin (2 * n),
            N.hiddenState x 1 (e3 i) = M.hiddenState y 0 (Fin.cast hMwidth.symm ⟨i.val, by omega⟩) := by
          intro i
          let mi : Fin M.width := Fin.cast hMwidth.symm ⟨i.val, by omega⟩
          have h1 : N.hiddenState x 1 (e3 i) =
              relu ((hiddenLayer ⟨0, by norm_num⟩).apply (inputLayer.reluApply x) (e3 i)) := by
            simp [N, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec]
          have h2 : M.hiddenState y 0 mi = relu (M.input.apply y mi) := by
            simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec]
          have he3_ge : Nf.width + Ng.width ≤ (e3 i).val := by
            rw [he3_val]
            omega
          have he3_sub : (e3 i).val - (Nf.width + Ng.width) = i.val := by
            rw [he3_val]
            omega
          have he3i_cast : Fin.cast hMwidth.symm ⟨(e3 i).val - (Nf.width + Ng.width), by omega⟩ = mi := by
            apply Fin.ext
            simpa [mi, he3_sub]
          have hw_e1 : ∀ a : Fin Nf.width,
              (hiddenLayer ⟨0, by norm_num⟩).weight (e3 i) (e1 a) = M.input.weight mi 0 * Nf.outputWeight a := by
            intro a
            simp [hiddenLayer, mi, he3_ge, he3i_cast, he1_val, Fin.castLT]
          have hw_e2 : ∀ b : Fin Ng.width,
              (hiddenLayer ⟨0, by norm_num⟩).weight (e3 i) (e2 b) = M.input.weight mi 1 * Ng.outputWeight b := by
            intro b
            simp [hiddenLayer, mi, he3_ge, he3i_cast, he2_val, he2_not1, he2_sub, Fin.castLT]
          have he3c_w : ∀ c : Fin (2 * n),
              (hiddenLayer ⟨0, by norm_num⟩).weight (e3 i) (e3 c) = 0 := by
            intro c
            simp [hiddenLayer, mi, he3_ge, he3i_cast, he3_val, he3c_not1, he3c_not2]
          have hbias : (hiddenLayer ⟨0, by norm_num⟩).bias (e3 i) =
              M.input.weight mi 0 * Nf.outputBias + M.input.weight mi 1 * Ng.outputBias + M.input.bias mi := by
            simp [hiddenLayer, mi, he3_ge, he3i_cast]
          have hb1 : (∑ a : Fin Nf.width,
              (M.input.weight mi 0 * Nf.outputWeight a) * (inputLayer.reluApply x) (e1 a)) =
              M.input.weight mi 0 * (Nf.realize x - Nf.outputBias) := by
            calc
              (∑ a : Fin Nf.width, (M.input.weight mi 0 * Nf.outputWeight a) * (inputLayer.reluApply x) (e1 a))
                  = ∑ a : Fin Nf.width, M.input.weight mi 0 * (Nf.outputWeight a * (inputLayer.reluApply x) (e1 a)) := by
                    simp only [mul_assoc]
              _ = M.input.weight mi 0 * (∑ a : Fin Nf.width, Nf.outputWeight a * (inputLayer.reluApply x) (e1 a)) := by
                    exact (Finset.mul_sum Finset.univ (fun a : Fin Nf.width => Nf.outputWeight a * (inputLayer.reluApply x) (e1 a)) (M.input.weight mi 0)).symm
              _ = M.input.weight mi 0 * (Nf.realize x - Nf.outputBias) := by
                    simp_rw [h_hs0_1]
                    rw [h_Nf_real]
          have hb2 : (∑ b : Fin Ng.width,
              (M.input.weight mi 1 * Ng.outputWeight b) * (inputLayer.reluApply x) (e2 b)) =
              M.input.weight mi 1 * (Ng.realize x - Ng.outputBias) := by
            calc
              (∑ b : Fin Ng.width, (M.input.weight mi 1 * Ng.outputWeight b) * (inputLayer.reluApply x) (e2 b))
                  = ∑ b : Fin Ng.width, M.input.weight mi 1 * (Ng.outputWeight b * (inputLayer.reluApply x) (e2 b)) := by
                    simp only [mul_assoc]
              _ = M.input.weight mi 1 * (∑ b : Fin Ng.width, Ng.outputWeight b * (inputLayer.reluApply x) (e2 b)) := by
                    exact (Finset.mul_sum Finset.univ (fun b : Fin Ng.width => Ng.outputWeight b * (inputLayer.reluApply x) (e2 b)) (M.input.weight mi 1)).symm
              _ = M.input.weight mi 1 * (Ng.realize x - Ng.outputBias) := by
                    simp_rw [h_hs0_2]
                    rw [h_Ng_real]
          have hpre : (hiddenLayer ⟨0, by norm_num⟩).apply (inputLayer.reluApply x) (e3 i) =
              M.input.apply y mi := by
            rw [show (hiddenLayer ⟨0, by norm_num⟩).apply (inputLayer.reluApply x) (e3 i) =
                (∑ j : Fin W, (hiddenLayer ⟨0, by norm_num⟩).weight (e3 i) j * (inputLayer.reluApply x) j) +
                  (hiddenLayer ⟨0, by norm_num⟩).bias (e3 i) by
              simp [DenseLayer.apply]]
            rw [hsum3 (fun j : Fin W => (hiddenLayer ⟨0, by norm_num⟩).weight (e3 i) j * (inputLayer.reluApply x) j)]
            simp_rw [hw_e1, hw_e2, he3c_w, hbias]
            have hb3 : (∑ c : Fin (2 * n), 0 * (inputLayer.reluApply x) (e3 c)) = 0 := by
              simp
            rw [hb1, hb2, hb3]
            simp [DenseLayer.apply, Fin.sum_univ_two, hy0, hy1]
            ring
          rw [h1, h2, hpre]
        -- output weights on blocks 1,2 are zero; on block 3 they equal M's
        have h_out0_1 : ∀ a : Fin Nf.width, outputW (e1 a) = 0 := by
          intro a
          have hnot : ¬ Nf.width + Ng.width ≤ (e1 a).val := by
            rw [he1_val]
            omega
          simp [outputW, hnot]
        have h_out0_2 : ∀ b : Fin Ng.width, outputW (e2 b) = 0 := by
          intro b
          have hnot : ¬ Nf.width + Ng.width ≤ (e2 b).val := by
            rw [he2_val]
            omega
          simp [outputW, hnot]
        have h_out_3 : ∀ i : Fin (2 * n),
            outputW (e3 i) = M.outputWeight (Fin.cast hMwidth.symm ⟨i.val, by omega⟩) := by
          intro i
          have hge : Nf.width + Ng.width ≤ (e3 i).val := by
            rw [he3_val]
            omega
          have hsub : (e3 i).val - (Nf.width + Ng.width) = i.val := by
            rw [he3_val]
            omega
          have hko : Fin.cast hMwidth.symm ⟨(e3 i).val - (Nf.width + Ng.width), by omega⟩ =
              Fin.cast hMwidth.symm ⟨i.val, by omega⟩ := by
            apply Fin.ext
            simpa [hsub]
          simpa [outputW, hge] using congrArg M.outputWeight hko
        -- unfold N.realize, kill blocks 1,2, and identify block 3 with M's realization terms
        have h_real : N.realize x =
            (∑ i : Fin (2 * n), M.outputWeight (Fin.cast hMwidth.symm ⟨i.val, by omega⟩) *
              M.hiddenState y 0 (Fin.cast hMwidth.symm ⟨i.val, by omega⟩)) + M.outputBias := by
          rw [show N.realize x =
              (∑ j : Fin W, outputW j * N.hiddenState x 1 j) + M.outputBias by
            simp [N, FullyConnectedReLUNet.realize]]
          congr 1
          rw [hsum3 (fun j : Fin W => outputW j * N.hiddenState x 1 j)]
          simp_rw [h_out0_1, h_out0_2, h_out_3, h_hs1_3]
          simp
        -- reindex the block-3 sum from Fin (2 * n) to Fin M.width
        have hreindex :
            (∑ i : Fin (2 * n), M.outputWeight (Fin.cast hMwidth.symm ⟨i.val, by omega⟩) *
              M.hiddenState y 0 (Fin.cast hMwidth.symm ⟨i.val, by omega⟩)) =
            (∑ q : Fin M.width, M.outputWeight q * M.hiddenState y 0 q) := by
          rw [Fintype.sum_equiv (finCongr hMwidth.symm)
            (fun i : Fin (2 * n) => M.outputWeight (Fin.cast hMwidth.symm ⟨i.val, by omega⟩) *
              M.hiddenState y 0 (Fin.cast hMwidth.symm ⟨i.val, by omega⟩))
            (fun q : Fin M.width => M.outputWeight q * M.hiddenState y 0 q)
            (fun i => by simp [finCongr])]
        have h_real' : N.realize x = (∑ q : Fin M.width, M.outputWeight q * M.hiddenState y 0 q) + M.outputBias := by
          rw [h_real]
          rw [hreindex]
        have h_mreal : M.realize y = (∑ q : Fin M.width, M.outputWeight q * M.hiddenState y 0 q) + M.outputBias := by
          simp [FullyConnectedReLUNet.realize, hMdepth]
        rw [h_real', ← h_mreal]
    -- @step s2: pointwise bounds on the realizations and approximation errors
    have h_bounds : ∀ x : Fin d → ℝ, P x →
        |Nf.realize x| ≤ R ∧ |Ng.realize x| ≤ R ∧
        |Nf.realize x - f x| ≤ ηf ∧ |Ng.realize x - g x| ≤ ηg := by
      intro x hx
      exact ⟨hNf_bound x hx, hNg_bound x hx, hf_err x hx, hg_err x hx⟩
    -- @step s3: multiplication error for the pair (Nf.realize x, Ng.realize x) via M's approximation property
    have h_mul : ∀ (M : FullyConnectedReLUNet 2),
        (∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
          |M.realize y - y 0 * y 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2) →
        ∀ x : Fin d → ℝ, P x →
          |M.realize (fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x) - Nf.realize x * Ng.realize x| ≤
            2 * R ^ 2 / (n : ℝ) ^ 2 := by
      intro M hMbox x hx
      let y : Fin 2 → ℝ := fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x
      have hy0 : |y 0| ≤ R := by
        simpa [y] using hNf_bound x hx
      have hy1 : |y 1| ≤ R := by
        simpa [y] using hNg_bound x hx
      simpa [y] using hMbox y hy0 hy1
    -- @step s4: final product error bound for the concatenated witness
    have h_prod : ∀ (N : FullyConnectedReLUNet d) (M : FullyConnectedReLUNet 2),
        (∀ x : Fin d → ℝ,
          N.realize x = M.realize (fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x)) →
        (∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
          |M.realize y - y 0 * y 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2) →
        ∀ x : Fin d → ℝ, P x →
          |N.realize x - f x * g x| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
      intro N M hNid hMbox x hx
      let y : Fin 2 → ℝ := fun q : Fin 2 => if q = 0 then Nf.realize x else Ng.realize x
      have hy0 : |y 0| ≤ R := by
        simpa [y] using hNf_bound x hx
      have hy1 : |y 1| ≤ R := by
        simpa [y] using hNg_bound x hx
      have hstep2 : |M.realize y - y 0 * y 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := hMbox y hy0 hy1
      have hident : y 0 * y 1 - f x * g x = y 0 * (y 1 - g x) + (y 0 - f x) * g x := by
        ring
      have htri (a b : ℝ) : |a + b| ≤ |a| + |b| := by
        have h1 : a + b ≤ |a| + |b| := by
          nlinarith [le_abs_self a, le_abs_self b]
        have h2 : -(|a| + |b|) ≤ a + b := by
          nlinarith [neg_abs_le a, neg_abs_le b]
        exact abs_le.mpr ⟨h2, h1⟩
      have hstep3 : |y 0 * y 1 - f x * g x| ≤ R * ηg + R * ηf := by
        rw [hident]
        have hy0f : |y 0 - f x| ≤ ηf := by
          simpa [y] using hf_err x hx
        have hy1g : |y 1 - g x| ≤ ηg := by
          simpa [y] using hg_err x hx
        have hprod1 : |y 0 * (y 1 - g x)| ≤ R * ηg := by
          rw [abs_mul]
          exact mul_le_mul hy0 hy1g (abs_nonneg (y 1 - g x)) hR.le
        have hprod2 : |(y 0 - f x) * g x| ≤ ηf * R := by
          rw [abs_mul]
          exact mul_le_mul hy0f (hg_bound x hx) (abs_nonneg (g x)) hηf
        calc
          |y 0 * (y 1 - g x) + (y 0 - f x) * g x| ≤
              |y 0 * (y 1 - g x)| + |(y 0 - f x) * g x| := htri _ _
          _ ≤ R * ηg + |(y 0 - f x) * g x| := by
            exact add_le_add_left hprod1 |(y 0 - f x) * g x|
          _ ≤ R * ηg + ηf * R := by
            exact add_le_add_right hprod2 (R * ηg)
          _ = R * ηg + R * ηf := by ring
      have hNid' : N.realize x = M.realize y := by
        simpa [y] using hNid x
      calc
        |N.realize x - f x * g x| ≤ |M.realize y - y 0 * y 1| + |y 0 * y 1 - f x * g x| := by
          rw [hNid']
          rw [show M.realize y - f x * g x = (M.realize y - y 0 * y 1) + (y 0 * y 1 - f x * g x) by ring]
          exact htri _ _
        _ ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 + (R * ηg + R * ηf) := by
          exact add_le_add hstep2 hstep3
        _ = 2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by ring
    -- @step fin: extract the witnesses and assemble the existential
    -- @step fin: extract the witnesses and assemble the existential
    rcases h_concat with ⟨N, M, hNstr, hMapprox, hNid⟩
    rcases hNstr with ⟨hNpos, hNdepth, hNwidth, hNparam⟩
    exact ⟨N, hNpos, hNdepth, hNwidth, hNparam, h_prod N M hNid hMapprox⟩
  -- @step fin: chain the stubs
  exact h_s4

theorem exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_approx_on_box
    {ι : Type*} [DecidableEq ι] {d : ℕ}
    (hd : 0 < d) {R ε : ℝ} (hR : 0 < R) (hε : 0 < ε)
    (center : Fin d → ℝ)
    (s : Finset ι) (coeff : ι → ℝ)
    (degree : ι → ℕ) (coord : (r : ι) → Fin (degree r) → Fin d) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
        |N.realize x -
            finiteLinearCombination s coeff
              (fun r : ι => fun y : Fin d → ℝ =>
                ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤ ε := by
  classical
  let P : (Fin d → ℝ) → Prop := fun x => ∀ q : Fin d, |x q - center q| ≤ R
  let f : ι → (Fin d → ℝ) → ℝ := fun r y =>
    ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))
  let εr : ι → ℝ := fun r => ε / ((|coeff r| + 1) * (s.card : ℝ))
  have hεr_nonneg : ∀ r ∈ s, 0 ≤ εr r := by
    intro r hr
    dsimp [εr]
    exact div_nonneg hε.le (mul_nonneg (by positivity) (by exact_mod_cast Nat.zero_le s.card))
  have hεr_sum : (∑ r ∈ s, |coeff r| * εr r) ≤ ε := by
    by_cases hs : s.card = 0
    · have hs_empty : s = ∅ := Finset.card_eq_zero.mp hs
      simp [hs_empty]
      exact hε.le
    · have hsc_pos : (0 : ℝ) < s.card := by exact_mod_cast Nat.pos_of_ne_zero hs
      have hsc_ne : (s.card : ℝ) ≠ 0 := ne_of_gt hsc_pos
      have hterm : ∀ r ∈ s, |coeff r| * εr r ≤ ε / (s.card : ℝ) := by
        intro r hr
        dsimp [εr]
        have hden_pos : (0 : ℝ) < |coeff r| + 1 := by positivity
        have hden_ne : (|coeff r| + 1 : ℝ) ≠ 0 := ne_of_gt hden_pos
        calc
          |coeff r| * (ε / ((|coeff r| + 1) * (s.card : ℝ)))
              = (ε / (s.card : ℝ)) * (|coeff r| / (|coeff r| + 1)) := by
                field_simp [hsc_ne, hden_ne]
          _ ≤ (ε / (s.card : ℝ)) * 1 := by
                have hrat : |coeff r| / (|coeff r| + 1) ≤ 1 := by
                  rw [div_le_iff₀ hden_pos]
                  simpa using (le_add_of_nonneg_right (by norm_num : (0 : ℝ) ≤ 1) :
                    |coeff r| ≤ |coeff r| + 1)
                exact mul_le_mul_of_nonneg_left hrat (div_nonneg hε.le hsc_pos.le)
          _ = ε / (s.card : ℝ) := by
                ring
      calc
        (∑ r ∈ s, |coeff r| * εr r) ≤ (∑ r ∈ s, ε / (s.card : ℝ)) := by
          exact Finset.sum_le_sum hterm
        _ = (s.card : ℝ) * (ε / (s.card : ℝ)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
        _ = ε := by
          field_simp [hsc_ne]
  -- Exact depth-1 building blocks for the per-monomial construction.
  -- Identity t = relu t - relu (-t).
  have hrelu_sub : ∀ t : ℝ, relu t - relu (-t) = t := by
    intro t
    by_cases ht : 0 ≤ t
    · have hneg : -t ≤ 0 := by linarith
      simp [relu, ht, hneg]
    · have ht0 : t ≤ 0 := le_of_not_ge ht
      have hpos : 0 ≤ -t := by linarith
      simp [relu, ht0, hpos]
  -- Degree-zero monomial: constant one, exact depth-one network (zero width, bias 1).
  have hconst : ∃ N : FullyConnectedReLUNet d, N.depth = 1 ∧ ∀ x : Fin d → ℝ, N.realize x = 1 := by
    let A : FullyConnectedReLUNet d :=
      { depth := 1, width := 0, input := { weight := fun u _ => (nomatch u), bias := fun k => (nomatch k) },
        hidden := fun h => (nomatch h), outputWeight := fun u => (nomatch u), outputBias := 1 }
    refine ⟨A, rfl, ?_⟩
    intro x
    simp [A, FullyConnectedReLUNet.realize, Fin.sum_univ_zero]
  -- Degree-one monomial x i - center i: exact difference network via relu.
  have hlin (i : Fin d) : ∃ N : FullyConnectedReLUNet d, N.depth = 1 ∧ ∀ x : Fin d → ℝ, N.realize x = x i - center i := by
    let A : FullyConnectedReLUNet d :=
      { depth := 1, width := 2,
        input := { weight := fun u j => if j = i then (if u = 0 then 1 else -1) else 0,
                   bias := fun u => if u = 0 then -center i else center i },
        hidden := fun h => (nomatch h),
        outputWeight := fun u => if u = 0 then 1 else -1,
        outputBias := 0 }
    refine ⟨A, rfl, ?_⟩
    intro x
    have hsum0 : (∑ j : Fin d, (if j = i then 1 else 0) * x j) = x i := by
      simpa using
        (Finset.sum_eq_single (Finset.univ : Finset (Fin d))
          (fun j : Fin d => (if j = i then 1 else 0) * x j) i
          (fun b hb hbi => by simp [hbi])
          (fun hi => by exact False.elim (hi (Finset.mem_univ i))))
    have hsum1 : (∑ j : Fin d, (if j = i then -1 else 0) * x j) = -x i := by
      simpa using
        (Finset.sum_eq_single (Finset.univ : Finset (Fin d))
          (fun j : Fin d => (if j = i then -1 else 0) * x j) i
          (fun b hb hbi => by simp [hbi])
          (fun hi => by exact False.elim (hi (Finset.mem_univ i))))
    have happly0 : A.input.apply x 0 = x i - center i := by
      calc
        A.input.apply x 0 = (∑ j : Fin d, (if j = i then 1 else 0) * x j) + (-center i) := by
          simp [A, DenseLayer.apply]
        _ = x i + (-center i) := by rw [hsum0]
        _ = x i - center i := by ring
    have happly1 : A.input.apply x 1 = -(x i - center i) := by
      calc
        A.input.apply x 1 = (∑ j : Fin d, (if j = i then -1 else 0) * x j) + center i := by
          simp [A, DenseLayer.apply]
        _ = -x i + center i := by rw [hsum1]
        _ = -(x i - center i) := by ring
    have hh0 : A.hiddenState x 0 = A.input.reluApply x := by
      funext j
      rfl
    have hhidden0 : A.hiddenState x 0 0 = relu (x i - center i) := by
      rw [hh0]
      simp [DenseLayer.reluApply, reluVec, happly0]
    have hhidden1 : A.hiddenState x 0 1 = relu (-(x i - center i)) := by
      rw [hh0]
      simp [DenseLayer.reluApply, reluVec, happly1]
    calc
      A.realize x = (∑ j : Fin 2, A.outputWeight j * A.hiddenState x 0 j) + 0 := by
        rw [FullyConnectedReLUNet.realize]
        simp [A]
      _ = A.outputWeight 0 * A.hiddenState x 0 0 + A.outputWeight 1 * A.hiddenState x 0 1 := by
        rw [Fin.sum_univ_two]
        ring
      _ = 1 * relu (x i - center i) + (-1) * relu (-(x i - center i)) := by
        simp [A, hhidden0, hhidden1]
      _ = relu (x i - center i) - relu (-(x i - center i)) := by
        ring
      _ = x i - center i := by
        rw [hrelu_sub]
  -- Remaining (deferred): higher-degree monomials by product-of-approximants composition
  -- (per-monomial networks of depth > 1), then combine all per-monomial networks into the
  -- final network and close the bound with hεr_nonneg / hεr_sum.
  -- Composition lemma: compose a depth-`a` network A and a depth-1 network L through a
  -- depth-1 two-input network M, producing depth-(a+1) C with
  --   C.realize x = M.realize (fun k : Fin 2 => if k = 0 then A.realize x else L.realize x).
  have hrelu_idem : ∀ t : ℝ, relu (relu t) = relu t := by
    intro t
    simp [relu, max_assoc, max_self]
  have hcompose : ∀ {a : ℕ} (ha : 0 < a),
      ∀ (A : FullyConnectedReLUNet d), A.depth = a →
      ∀ (L : FullyConnectedReLUNet d), L.depth = 1 →
      ∀ (M : FullyConnectedReLUNet 2), M.depth = 1 →
      ∃ C : FullyConnectedReLUNet d,
        C.depth = a + 1 ∧
        ∀ x : Fin d → ℝ,
          C.realize x = M.realize (fun k : Fin 2 => if k = 0 then A.realize x else L.realize x) := by
    intro a ha A hAd L hLd M hMd
    let wA : ℕ := A.width
    let wL : ℕ := L.width
    let wM : ℕ := M.width
    let W : ℕ := wA + (wL + wM)
    let inA : Fin wA → Fin W := fun i => Fin.castAdd (wL + wM) i
    let inL : Fin wL → Fin W := fun i => Fin.natAdd wA (Fin.castAdd wM i)
    let inM : Fin wM → Fin W := fun i => Fin.natAdd wA (Fin.natAdd wL i)
    have hsub : (a + 1) - 1 = a := by omega
    let wAA : Fin ((a + 1) - 1) → Fin wA → Fin wA → ℝ := fun k uA vA =>
      if hk : k.val < a - 1 then (A.hidden ⟨k.val, by simpa [hAd] using hk⟩).weight uA vA else (if uA = vA then 1 else 0)
    let wAM : Fin ((a + 1) - 1) → Fin wA → Fin wM → ℝ := fun k uA vM =>
      if hk : k.val < a - 1 then 0 else M.input.weight vM 0 * A.outputWeight uA
    let wLL : Fin wL → Fin wL → ℝ := fun uL vL => if vL = uL then 1 else 0
    let wLM : Fin ((a + 1) - 1) → Fin wL → Fin wM → ℝ := fun k uL vM =>
      if hk : k.val < a - 1 then 0 else M.input.weight vM 1 * L.outputWeight uL
    let WFun : Fin ((a + 1) - 1) → Fin W → Fin W → ℝ := fun k u v =>
      Fin.addCases (fun uA : Fin wA =>
        Fin.addCases (fun vA : Fin wA => wAA k uA vA)
                    (fun vR : Fin (wL + wM) =>
                      Fin.addCases (fun vL : Fin wL => 0)
                                  (fun vM : Fin wM => 0) vR) v)
      (fun uR : Fin (wL + wM) =>
        Fin.addCases (fun uL : Fin wL =>
          Fin.addCases (fun vA : Fin wA => 0)
                      (fun vR : Fin (wL + wM) =>
                        Fin.addCases (fun vL : Fin wL => wLL uL vL)
                                    (fun vM : Fin wM => 0) vR) v)
        (fun uM : Fin wM =>
          Fin.addCases (fun vA : Fin wA => wAM k vA uM)
                      (fun vR : Fin (wL + wM) =>
                        Fin.addCases (fun vL : Fin wL => wLM k vL uM)
                                    (fun vM : Fin wM => 0) vR) v) uR) u
    let BFun : Fin ((a + 1) - 1) → Fin W → ℝ := fun k u =>
      Fin.addCases (fun uA : Fin wA =>
        if hk : k.val < a - 1 then (A.hidden ⟨k.val, by simpa [hAd] using hk⟩).bias uA else 0)
      (fun uR : Fin (wL + wM) =>
        Fin.addCases (fun uL : Fin wL => 0)
        (fun uM : Fin wM =>
          if hk : k.val < a - 1 then 0
          else M.input.weight uM 0 * A.outputBias + M.input.weight uM 1 * L.outputBias + M.input.bias uM) uR) u
    let hidLayer : Fin ((a + 1) - 1) → DenseLayer W W := fun k =>
      { weight := WFun k, bias := BFun k }
    let Cin : DenseLayer d W :=
      { weight := fun u j =>
          Fin.addCases (fun uA : Fin wA => A.input.weight uA j)
          (fun uR : Fin (wL + wM) =>
            Fin.addCases (fun uL : Fin wL => L.input.weight uL j)
                        (fun uM : Fin wM => 0) uR) u,
        bias := fun u =>
          Fin.addCases (fun uA : Fin wA => A.input.bias uA)
          (fun uR : Fin (wL + wM) =>
            Fin.addCases (fun uL : Fin wL => L.input.bias uL)
                        (fun uM : Fin wM => 0) uR) u }
    let Cout : Fin W → ℝ := fun u =>
      Fin.addCases (fun uA : Fin wA => 0)
      (fun uR : Fin (wL + wM) =>
        Fin.addCases (fun uL : Fin wL => 0)
                    (fun uM : Fin wM => M.outputWeight uM) uR) u
    let C : FullyConnectedReLUNet d :=
      { depth := a + 1, width := W, input := Cin, hidden := hidLayer,
        outputWeight := Cout, outputBias := M.outputBias }
    refine ⟨C, ?_, ?_⟩
    · rfl
    · intro x
      have hCapplyA : ∀ (uA : Fin wA), Cin.apply x (inA uA) = A.input.apply x uA := by
        intro uA
        simp [Cin, DenseLayer.apply, inA, Fin.addCases_left]
      have hCapplyL : ∀ (uL : Fin wL), Cin.apply x (inL uL) = L.input.apply x uL := by
        intro uL
        simp [Cin, DenseLayer.apply, inL, Fin.addCases_left, Fin.addCases_right]
      have hCapplyM : ∀ (uM : Fin wM), Cin.apply x (inM uM) = 0 := by
        intro uM
        simp [Cin, DenseLayer.apply, inM, Fin.addCases_left, Fin.addCases_right]
      have hhC0A : ∀ (uA : Fin wA), C.hiddenState x 0 (inA uA) = A.hiddenState x 0 uA := by
        intro uA
        simp [C, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hCapplyA]
      have hhC0L : ∀ (uL : Fin wL), C.hiddenState x 0 (inL uL) = L.hiddenState x 0 uL := by
        intro uL
        simp [C, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hCapplyL]
      have hhC0M : ∀ (uM : Fin wM), C.hiddenState x 0 (inM uM) = 0 := by
        intro uM
        simp [C, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, relu, hCapplyM]
      have hsum3 : ∀ (F : Fin W → ℝ),
          (∑ v : Fin W, F v) = (∑ vA : Fin wA, F (inA vA)) + (∑ vL : Fin wL, F (inL vL)) + (∑ vM : Fin wM, F (inM vM)) := by
        intro F
        change (∑ v : Fin (wA + (wL + wM)), F v) = (∑ vA : Fin wA, F (inA vA)) + (∑ vL : Fin wL, F (inL vL)) + (∑ vM : Fin wM, F (inM vM))
        rw [Fin.sum_univ_add]
        have h1 : (∑ vA : Fin wA, F (Fin.castAdd (wL + wM) vA)) = (∑ vA : Fin wA, F (inA vA)) := by
          simp [inA]
        have h2 : (∑ vR : Fin (wL + wM), F (Fin.natAdd wA vR)) = (∑ vL : Fin wL, F (inL vL)) + (∑ vM : Fin wM, F (inM vM)) := by
          rw [Fin.sum_univ_add]
        rw [h1, h2]
        ac_rfl
      have hwAA : ∀ (k : Fin ((a + 1) - 1)) (uA vA : Fin wA),
          (hidLayer k).weight (inA uA) (inA vA) = wAA k uA vA := by
        intro k uA vA
        simp [hidLayer, WFun, inA, Fin.addCases_left]
      have hwA_L : ∀ (k : Fin ((a + 1) - 1)) (uA : Fin wA) (uL : Fin wL),
          (hidLayer k).weight (inA uA) (inL uL) = 0 := by
        intro k uA uL
        simp [hidLayer, WFun, inA, inL, Fin.addCases_left, Fin.addCases_right]
      have hwA_M : ∀ (k : Fin ((a + 1) - 1)) (uA : Fin wA) (uM : Fin wM),
          (hidLayer k).weight (inA uA) (inM uM) = 0 := by
        intro k uA uM
        simp [hidLayer, WFun, inA, inM, Fin.addCases_left, Fin.addCases_right]
      have hwLA : ∀ (k : Fin ((a + 1) - 1)) (uL : Fin wL) (uA : Fin wA),
          (hidLayer k).weight (inL uL) (inA uA) = 0 := by
        intro k uL uA
        simp [hidLayer, WFun, inL, inA, Fin.addCases_left, Fin.addCases_right]
      have hwLL : ∀ (k : Fin ((a + 1) - 1)) (uL vL : Fin wL),
          (hidLayer k).weight (inL uL) (inL vL) = wLL uL vL := by
        intro k uL vL
        simp [hidLayer, WFun, inL, Fin.addCases_left, Fin.addCases_right]
      have hwL_M : ∀ (k : Fin ((a + 1) - 1)) (uL : Fin wL) (uM : Fin wM),
          (hidLayer k).weight (inL uL) (inM uM) = 0 := by
        intro k uL uM
        simp [hidLayer, WFun, inL, inM, Fin.addCases_left, Fin.addCases_right]
      have hwMA : ∀ (k : Fin ((a + 1) - 1)) (uM : Fin wM) (uA : Fin wA),
          (hidLayer k).weight (inM uM) (inA uA) = wAM k uA uM := by
        intro k uM uA
        simp [hidLayer, WFun, inM, inA, Fin.addCases_left, Fin.addCases_right]
      have hwML : ∀ (k : Fin ((a + 1) - 1)) (uM : Fin wM) (uL : Fin wL),
          (hidLayer k).weight (inM uM) (inL uL) = wLM k uL uM := by
        intro k uM uL
        simp [hidLayer, WFun, inM, inL, Fin.addCases_left, Fin.addCases_right]
      have hwMM : ∀ (k : Fin ((a + 1) - 1)) (uM vM : Fin wM),
          (hidLayer k).weight (inM uM) (inM vM) = 0 := by
        intro k uM vM
        simp [hidLayer, WFun, inM, Fin.addCases_left, Fin.addCases_right]
      have hbiasA : ∀ (k : Fin ((a + 1) - 1)) (uA : Fin wA),
          (hidLayer k).bias (inA uA) = (if hk : k.val < a - 1 then (A.hidden ⟨k.val, by simpa [hAd] using hk⟩).bias uA else 0) := by
        intro k uA
        simp [hidLayer, BFun, inA, Fin.addCases_left]
      have hbiasL : ∀ (k : Fin ((a + 1) - 1)) (uL : Fin wL), (hidLayer k).bias (inL uL) = 0 := by
        intro k uL
        simp [hidLayer, BFun, inL, Fin.addCases_left, Fin.addCases_right]
      have hbiasM : ∀ (k : Fin ((a + 1) - 1)) (uM : Fin wM),
          (hidLayer k).bias (inM uM) = (if hk : k.val < a - 1 then 0
            else M.input.weight uM 0 * A.outputBias + M.input.weight uM 1 * L.outputBias + M.input.bias uM) := by
        intro k uM
        simp [hidLayer, BFun, inM, Fin.addCases_left, Fin.addCases_right]
      have hhL0 : ∀ uL : Fin wL, L.hiddenState x 0 uL = relu (L.input.apply x uL) := by
        intro uL
        simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec]
      have hcarry : ∀ k : ℕ, k ≤ a - 1 →
          (∀ uA : Fin wA, C.hiddenState x k (inA uA) = A.hiddenState x k uA) ∧
          (∀ uL : Fin wL, C.hiddenState x k (inL uL) = L.hiddenState x 0 uL) := by
        intro k
        induction' k with k ih
        · intro hk
          exact ⟨hhC0A, hhC0L⟩
        · intro hk1
          have hk : k ≤ a - 1 := by omega
          rcases ih hk with ⟨ihA, ihL⟩
          have hk_lt : k < a - 1 := by omega
          have hk_lt_A : k < A.depth - 1 := by
            simpa [hAd] using hk_lt
          have hk_lt_C : k < C.depth - 1 := by
            simp [C, hsub]
            omega
          constructor
          · intro uA
            calc
              C.hiddenState x (k + 1) (inA uA) = (C.hidden ⟨k, hk_lt_C⟩).reluApply (C.hiddenState x k) (inA uA) := by
                simp [FullyConnectedReLUNet.hiddenState, hk_lt_C]
              _ = relu ((C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (inA uA)) := by
                rfl
              _ = relu ((A.hidden ⟨k, hk_lt_A⟩).apply (A.hiddenState x k) uA) := by
                congr 1
                calc
                  (C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (inA uA)
                      = (∑ v : Fin W, (C.hidden ⟨k, hk_lt_C⟩).weight (inA uA) v * C.hiddenState x k v)
                          + (C.hidden ⟨k, hk_lt_C⟩).bias (inA uA) := by rfl
                  _ = (∑ vA : Fin wA, (A.hidden ⟨k, hk_lt_A⟩).weight uA vA * A.hiddenState x k vA)
                      + (A.hidden ⟨k, hk_lt_A⟩).bias uA := by
                        rw [hsum3]
                        simp [C, hwAA, wAA, hwA_L, hwA_M, hbiasA, hk_lt, ihA, add_assoc]
                  _ = (A.hidden ⟨k, hk_lt_A⟩).apply (A.hiddenState x k) uA := by rfl
              _ = A.hiddenState x (k + 1) uA := by
                simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hk_lt_A]
          · intro uL
            have hsumLL : (∑ vL : Fin wL, (if vL = uL then 1 else 0) * L.hiddenState x 0 vL) = L.hiddenState x 0 uL := by
              simpa using
                (Finset.sum_eq_single (Finset.univ : Finset (Fin wL))
                  (fun vL : Fin wL => (if vL = uL then 1 else 0) * L.hiddenState x 0 vL) uL
                  (fun b hb hbu => by simp [hbu])
                  (fun huL => by exact False.elim (huL (Finset.mem_univ uL))))
            calc
              C.hiddenState x (k + 1) (inL uL) = (C.hidden ⟨k, hk_lt_C⟩).reluApply (C.hiddenState x k) (inL uL) := by
                simp [FullyConnectedReLUNet.hiddenState, hk_lt_C]
              _ = relu ((C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (inL uL)) := by
                rfl
              _ = relu ((∑ vL : Fin wL, (if vL = uL then 1 else 0) * L.hiddenState x 0 vL)) := by
                congr 1
                calc
                  (C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (inL uL)
                      = (∑ v : Fin W, (C.hidden ⟨k, hk_lt_C⟩).weight (inL uL) v * C.hiddenState x k v)
                          + (C.hidden ⟨k, hk_lt_C⟩).bias (inL uL) := by rfl
                  _ = (∑ vL : Fin wL, (if vL = uL then 1 else 0) * L.hiddenState x 0 vL) := by
                        rw [hsum3]
                        simp [C, hwLA, hwLL, wLL, hwL_M, hbiasL, ihL, add_assoc]
              _ = relu (L.hiddenState x 0 uL) := by
                rw [hsumLL]
              _ = L.hiddenState x 0 uL := by
                rw [hhL0, hrelu_idem]
      have ha_lt : a - 1 < C.depth - 1 := by
        simp [C, hsub]
        omega
      have ha_merge : ¬ (a - 1 < a - 1) := by omega
      have hmerge : ∀ (uM : Fin wM),
          C.hiddenState x a (inM uM) =
            relu (M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM) := by
        intro uM
        rcases hcarry (a - 1) (by omega) with ⟨hcarA, hcarL⟩
        have hA_realize : A.realize x = (∑ vA : Fin wA, A.outputWeight vA * A.hiddenState x (a - 1) vA) + A.outputBias := by
          rw [FullyConnectedReLUNet.realize, hAd]
        have hL_realize : L.realize x = (∑ vL : Fin wL, L.outputWeight vL * L.hiddenState x 0 vL) + L.outputBias := by
          rw [FullyConnectedReLUNet.realize, hLd]
        have hfactorA : (∑ vA : Fin wA, (M.input.weight uM 0 * A.outputWeight vA) * A.hiddenState x (a - 1) vA)
            = M.input.weight uM 0 * (∑ vA : Fin wA, A.outputWeight vA * A.hiddenState x (a - 1) vA) := by
          calc
            (∑ vA : Fin wA, (M.input.weight uM 0 * A.outputWeight vA) * A.hiddenState x (a - 1) vA)
                = ∑ vA : Fin wA, M.input.weight uM 0 * (A.outputWeight vA * A.hiddenState x (a - 1) vA) := by
                  simp only [mul_assoc]
            _ = M.input.weight uM 0 * (∑ vA : Fin wA, A.outputWeight vA * A.hiddenState x (a - 1) vA) := by
                  rw [Finset.mul_sum]
        have hfactorL : (∑ vL : Fin wL, (M.input.weight uM 1 * L.outputWeight vL) * L.hiddenState x 0 vL)
            = M.input.weight uM 1 * (∑ vL : Fin wL, L.outputWeight vL * L.hiddenState x 0 vL) := by
          calc
            (∑ vL : Fin wL, (M.input.weight uM 1 * L.outputWeight vL) * L.hiddenState x 0 vL)
                = ∑ vL : Fin wL, M.input.weight uM 1 * (L.outputWeight vL * L.hiddenState x 0 vL) := by
                  simp only [mul_assoc]
            _ = M.input.weight uM 1 * (∑ vL : Fin wL, L.outputWeight vL * L.hiddenState x 0 vL) := by
                  rw [Finset.mul_sum]
        have happlyM : (C.hidden ⟨a - 1, ha_lt⟩).apply (C.hiddenState x (a - 1)) (inM uM)
            = M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM := by
          calc
            (C.hidden ⟨a - 1, ha_lt⟩).apply (C.hiddenState x (a - 1)) (inM uM)
                = (∑ v : Fin W, (C.hidden ⟨a - 1, ha_lt⟩).weight (inM uM) v * C.hiddenState x (a - 1) v)
                    + (C.hidden ⟨a - 1, ha_lt⟩).bias (inM uM) := by rfl
            _ = (∑ vA : Fin wA, (M.input.weight uM 0 * A.outputWeight vA) * A.hiddenState x (a - 1) vA)
                + (∑ vL : Fin wL, (M.input.weight uM 1 * L.outputWeight vL) * L.hiddenState x 0 vL)
                + (M.input.weight uM 0 * A.outputBias + M.input.weight uM 1 * L.outputBias + M.input.bias uM) := by
                  rw [hsum3]
                  simp [C, hwMA, wAM, hwML, wLM, hwMM, hbiasM, ha_merge, hcarA, hcarL, add_assoc]
            _ = M.input.weight uM 0 * (∑ vA : Fin wA, A.outputWeight vA * A.hiddenState x (a - 1) vA)
                + M.input.weight uM 1 * (∑ vL : Fin wL, L.outputWeight vL * L.hiddenState x 0 vL)
                + (M.input.weight uM 0 * A.outputBias + M.input.weight uM 1 * L.outputBias + M.input.bias uM) := by
                  rw [hfactorA, hfactorL]
            _ = M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM := by
                  rw [hA_realize, hL_realize]
                  ring
        have hpred : (a - 1) + 1 = a := by omega
        calc
          C.hiddenState x a (inM uM) = C.hiddenState x ((a - 1) + 1) (inM uM) := by
            exact congrArg (fun t : ℕ => C.hiddenState x t (inM uM)) hpred.symm
          _ = (C.hidden ⟨a - 1, ha_lt⟩).reluApply (C.hiddenState x (a - 1)) (inM uM) := by
            simp [FullyConnectedReLUNet.hiddenState, ha_lt]
          _ = relu ((C.hidden ⟨a - 1, ha_lt⟩).apply (C.hiddenState x (a - 1)) (inM uM)) := by
            rfl
          _ = relu (M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM) := by
            rw [happlyM]
      let p : Fin 2 → ℝ := fun k => if k = 0 then A.realize x else L.realize x
      have hp0 : p 0 = A.realize x := by simp [p]
      have hp1 : p 1 = L.realize x := by simp [p]
      have hMapply : ∀ (uM : Fin wM),
          M.input.apply p uM = M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM := by
        intro uM
        calc
          M.input.apply p uM = (∑ k : Fin 2, M.input.weight uM k * p k) + M.input.bias uM := by rfl
          _ = M.input.weight uM 0 * p 0 + M.input.weight uM 1 * p 1 + M.input.bias uM := by
            rw [Fin.sum_univ_two]
          _ = M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM := by
            rw [hp0, hp1]
      have hMhidden : ∀ (uM : Fin wM),
          M.hiddenState p 0 uM = relu (M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM) := by
        intro uM
        simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hMapply]
      have hCoutA0 : ∀ (uA : Fin wA), C.outputWeight (inA uA) = 0 := by
        intro uA
        simp [C, Cout, inA, Fin.addCases_left]
      have hCoutL0 : ∀ (uL : Fin wL), C.outputWeight (inL uL) = 0 := by
        intro uL
        simp [C, Cout, inL, Fin.addCases_left, Fin.addCases_right]
      have hCoutM : ∀ (uM : Fin wM), C.outputWeight (inM uM) = M.outputWeight uM := by
        intro uM
        simp [C, Cout, inM, Fin.addCases_left, Fin.addCases_right]
      calc
        C.realize x = (∑ j : Fin W, C.outputWeight j * C.hiddenState x (C.depth - 1) j) + C.outputBias := by
          rfl
        _ = (∑ j : Fin W, C.outputWeight j * C.hiddenState x a j) + M.outputBias := by
          rw [show C.depth - 1 = a from by simp [C, hsub]]
        _ = (∑ uM : Fin wM, M.outputWeight uM * relu (M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM)) + M.outputBias := by
          rw [hsum3]
          simp [hCoutA0, hCoutL0, hCoutM, hmerge, add_assoc]
        _ = M.realize p := by
          change (∑ uM : Fin wM, M.outputWeight uM * relu (M.input.weight uM 0 * A.realize x + M.input.weight uM 1 * L.realize x + M.input.bias uM)) + M.outputBias
              = (∑ j : Fin wM, M.outputWeight j * M.hiddenState p (M.depth - 1) j) + M.outputBias
          simp [hMd, hMhidden]
        _ = M.realize (fun k : Fin 2 => if k = 0 then A.realize x else L.realize x) := by
          rfl
  -- Per-monomial approximation: any centered coordinate monomial of degree `m` is
  -- approximated on the box by a network of depth ≤ m + 1 with any error budget δ ≤ 1.
  have hmono : ∀ (m : ℕ) (coords : Fin m → Fin d) (δ : ℝ), 0 < δ → δ ≤ 1 →
      ∃ N : FullyConnectedReLUNet d, 0 < N.depth ∧ N.depth ≤ m + 1 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
          |N.realize x - ∏ q : Fin m, (x (coords q) - center (coords q))| ≤ δ := by
    intro m
    induction' m with m ih
    · intro coords δ hδ hδ1
      rcases hconst with ⟨N, hNd, hN⟩
      refine ⟨N, ?_, ?_, ?_⟩
      · rw [hNd]; norm_num
      · rw [hNd]
      · intro x hx
        have hz : |N.realize x - ∏ q : Fin 0, (x (coords q) - center (coords q))| = 0 := by
          rw [hN]
          simp [Fin.prod_univ_zero]
        rw [hz]
        exact hδ.le
    · intro coords δ hδ hδ1
      let pre : Fin m → Fin d := fun q => coords (Fin.castSucc q)
      let B : ℝ := R ^ (m + 1) + 2
      have hBpos : 0 < B := by
        dsimp [B]
        positivity
