    have hn0 : (0 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (Nat.zero_le n)
    linarith
  have hD_le : (D : ℝ) ≤ cDepth * ((n : ℝ) + 1) := by
    dsimp [D, cDepth]
