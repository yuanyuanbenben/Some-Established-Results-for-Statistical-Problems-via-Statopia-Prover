            have hnonneg : 0 ≤ 1 - (((n : ℝ) + 1) - t) := by linarith [hn_le_t, ht_le_n1]
            simp [g, en1]
            rw [abs_of_nonpos (sub_nonpos.mpr ht_le_n1)]
            have hring : -(t - ((n : ℝ) + 1)) = ((n : ℝ) + 1) - t := by ring
            rw [hring, max_eq_left hnonneg]
          have hzero : ∀ i : Fin (K + 1), i ≠ en → i ≠ en1 → g i = 0 := by
            intro i hi_en hi_en1
            have hi_ne_n : (i : ℕ) ≠ n := by
