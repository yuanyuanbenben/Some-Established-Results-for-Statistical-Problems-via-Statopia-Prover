theorem exists_reluNetworkClass_holderSmooth_local_approx_on_centered_box_with_symbolic_budget
    {d r n depthBudget widthBudget parameterBudget : ℕ}
    (hd : 0 < d) (hn : 0 < n) {beta C B R rho eps : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho) (hR : 0 < R)
    (hdepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ depthBudget)
    (hwidthBudget :
      finiteCenteredMonomialPolynomialWidthBound n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ widthBudget)
    (hparameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ parameterBudget)
    (f : (Fin d → ℝ) → ℝ) (hf : f ∈ holderSmoothBall r beta C B) (center : Fin d → ℝ)
    (herrBudget :
      finiteCenteredMonomialPolynomialApproxError R n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a =>
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f center)
              (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0))
        (fun a => a.1.val)
      + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤ eps) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ,
        (∀ q : Fin d, |x q - center q| ≤ R) → ‖x - center‖ ≤ rho → |g x - f x| ≤ eps := by
  let ι := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
  let coeff : ι → ℝ := fun a =>
    ((Nat.factorial a.1.val : ℝ)⁻¹) *
      (iteratedFDeriv ℝ a.1.val f center)
        (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0)
  let degree : ι → ℕ := fun a => a.1.val
  let coord : (a : ι) → Fin (degree a) → Fin d := fun a => a.2
  let P : (Fin d → ℝ) → ℝ := fun y =>
    finiteLinearCombination (Finset.univ : Finset ι) coeff
      (fun a y => ∏ q : Fin (degree a), (y (coord a q) - center (coord a q))) y
  let errB : ℝ := finiteCenteredMonomialPolynomialApproxError R n (Finset.univ : Finset ι) coeff degree
  let tailB : ℝ := C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta)
  rcases exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_uniform_resolution_size_bound
      (ι := ι) hd hn hR center (Finset.univ : Finset ι) coeff degree coord with
    ⟨N, hN_pos, hN_depth, hN_width, hN_param, hN_err⟩
  refine ⟨N.realize, ?_, ?_⟩
  · rw [reluNetworkClass]
    exact ⟨N, hN_pos, le_trans hN_depth hdepthBudget, le_trans hN_width hwidthBudget,
      le_trans hN_param hparameterBudget, fun x => rfl⟩
  · intro x hbox hnorm
    have hN_err_x : |N.realize x - P x| ≤ errB := by
      simpa [P, errB] using hN_err x hbox
    have hTaylor : |f x - P x| ≤ tailB := by
      simpa [P, coeff, degree, coord, tailB] using
        (holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
          hbeta_nonneg hC hrho f hf center x hnorm)
    have hP : |P x - f x| ≤ tailB := by
      have hneg : P x - f x = -(f x - P x) := by ring
      rw [hneg]
      rw [abs_neg]
      exact hTaylor
    have hsub : N.realize x - f x = (N.realize x - P x) + (P x - f x) := by ring
    have hlast : |N.realize x - P x| + |P x - f x| ≤ errB + tailB := by
      exact add_le_add hN_err_x hP
    have hbound : |N.realize x - f x| ≤ errB + tailB := by
      calc
        |N.realize x - f x| = |(N.realize x - P x) + (P x - f x)| := by rw [hsub]
        _ ≤ |N.realize x - P x| + |P x - f x| := by
          simpa [Real.norm_eq_abs] using
            (norm_add_le (N.realize x - P x) (P x - f x))
        _ ≤ errB + tailB := hlast
    exact le_trans hbound herrBudget

theorem exists_reluNetworkClass_holderSmooth_local_approx_on_centered_box_with_coefficient_budget
    {d r n depthBudget widthBudget parameterBudget : ℕ}
    (hd : 0 < d) (hn : 0 < n) {beta C B R rho A eps : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (hA : 0 ≤ A) (hR : 0 < R)
    (hdepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ depthBudget)
    (hwidthBudget :
      finiteCenteredMonomialPolynomialWidthBound n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ widthBudget)
    (hparameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ parameterBudget)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center : Fin d → ℝ)
    (hcoeff :
      ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |((Nat.factorial a.1.val : ℝ)⁻¹) *
          (iteratedFDeriv ℝ a.1.val f center)
            (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0)| ≤ A)
    (herrBudget :
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialApproxError R n a.1.val)
        + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤ eps) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ,
        (∀ q : Fin d, |x q - center q| ≤ R) →
        ‖x - center‖ ≤ rho →
          |g x - f x| ≤ eps := by
  obtain ⟨N, hN_depth_pos, hN_depth, hN_width, hN_parameter, hN_approx⟩ :=
    exists_fullyConnectedReLUNet_holderSmooth_local_approx_on_centered_box_with_size_bound
      hd hn hbeta_nonneg hC hrho hR f hf center
  refine ⟨N.realize, ?mem, ?bound⟩
  · unfold reluNetworkClass
    exact ⟨N, hN_depth_pos, le_trans hN_depth hdepthBudget, le_trans hN_width hwidthBudget,
      le_trans hN_parameter hparameterBudget, fun x => rfl⟩
  · intro x hx_box hx_rho
    have hnR : 0 < (n : ℝ) := by
      exact_mod_cast hn
    have hrec : ∀ m : ℕ,
        centeredMonomialApproxError R n (Nat.succ (Nat.succ m)) =
          2 * (R ^ (Nat.succ m) + centeredMonomialApproxError R n (Nat.succ m) + R + 1) ^ 2 /
              (n : ℝ) ^ 2 +
            (R ^ (Nat.succ m) + centeredMonomialApproxError R n (Nat.succ m) + R + 1) *
              centeredMonomialApproxError R n (Nat.succ m) := by
      intro m
      rw [centeredMonomialApproxError.eq_3]
    have hmono : ∀ k : ℕ, 0 ≤ centeredMonomialApproxError R n k := by
      intro k
      refine Nat.strong_induction_on k ?_
      intro m ih
      cases m with
      | zero => simp [centeredMonomialApproxError.eq_1]
      | succ m =>
          cases m with
          | zero => simp [centeredMonomialApproxError.eq_2]
          | succ m =>
              have hprev : 0 ≤ centeredMonomialApproxError R n (Nat.succ m) :=
                ih (Nat.succ m) (by omega)
              rw [hrec m]
              have hB : 0 ≤ R ^ (Nat.succ m) + centeredMonomialApproxError R n (Nat.succ m) + R + 1 := by
                positivity
              positivity
    calc
      |N.realize x - f x| ≤
          (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f center)
                  (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0)| *
              centeredMonomialApproxError R n a.1.val) +
            C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
          have hNx := hN_approx x hx_box hx_rho
          rw [finiteCenteredMonomialPolynomialApproxError] at hNx
          exact hNx
      _ ≤
          (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))), A * centeredMonomialApproxError R n a.1.val) +
            C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
        have hsum :
            (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
              |((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f center)
                    (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0)| *
                centeredMonomialApproxError R n a.1.val) ≤
              (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                A * centeredMonomialApproxError R n a.1.val) := by
          exact Finset.sum_le_sum (fun a ha => mul_le_mul_of_nonneg_right (hcoeff a) (hmono a.1.val))
        exact add_le_add hsum
          (le_rfl : C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤
            C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta))
      _ =
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError R n a.1.val) +
            C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
        rw [Finset.mul_sum]
      _ ≤ eps := by
        exact herrBudget

theorem exists_fullyConnectedReLUNet_finite_linear_combination_same_depth_approx
    {ι : Type*} [DecidableEq ι] {d D : ℕ} {P : (Fin d → ℝ) → Prop}
    (hD : 0 < D)
    (s : Finset ι) (coeff : ι → ℝ)
    (f : ι → (Fin d → ℝ) → ℝ) (ε : ι → ℝ)
    (A : ι → FullyConnectedReLUNet d)
    (hε : ∀ r : ι, r ∈ s → 0 ≤ ε r)
    (hdepth : ∀ r : ι, r ∈ s → (A r).depth = D)
    (herr : ∀ r : ι, r ∈ s → ∀ x : Fin d → ℝ, P x →
      |(A r).realize x - f r x| ≤ ε r) :
    ∃ N : FullyConnectedReLUNet d,
      N.depth = D ∧
      0 < N.depth ∧
      N.width = ∑ r ∈ s, (A r).width ∧
      N.parameterCount ≤ fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ∧
      (∀ x : Fin d → ℝ,
        N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x) ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - finiteLinearCombination s coeff f x| ≤
          ∑ r ∈ s, |coeff r| * ε r := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: Binary depth-D block-diagonal combination: for any A₁ A₂ : FullyConnectedReLUNet d with depth D and any a b : ℝ, exists C with C.depth = D, C.width = A₁.width + A₂.width, parameter bound, and C.realize x = a * A₁.realize x + b * A₂.realize x for all x.
  have h_s1 :
      ∀ (A₁ A₂ : FullyConnectedReLUNet d), A₁.depth = D → A₂.depth = D →
      ∀ (a b : ℝ), ∃ C : FullyConnectedReLUNet d,
        C.depth = D ∧ C.width = A₁.width + A₂.width ∧
        C.parameterCount ≤ fullyConnectedReLUParameterCount d D (A₁.width + A₂.width) ∧
        (∀ x : Fin d → ℝ, C.realize x = a * A₁.realize x + b * A₂.realize x) := by
      intro A₁ A₂ hA₁ hA₂ a b
      let inBlk : DenseLayer d (A₁.width + A₂.width) :=
        { weight := fun i j =>
            Fin.addCases (fun i₁ => A₁.input.weight i₁ j) (fun i₂ => A₂.input.weight i₂ j) i,
          bias := fun i =>
            Fin.addCases (fun i₁ => A₁.input.bias i₁) (fun i₂ => A₂.input.bias i₂) i }
      let hidBlk : Fin (D - 1) → DenseLayer (A₁.width + A₂.width) (A₁.width + A₂.width) :=
        fun k =>
          { weight := fun i j =>
              Fin.addCases
                (fun i₁ : Fin A₁.width =>
                  Fin.addCases (fun j₁ : Fin A₁.width => (A₁.hidden ⟨k.1, by simpa [hA₁] using k.2⟩).weight i₁ j₁)
                    (fun _ : Fin A₂.width => (0 : ℝ)) j)
                (fun i₂ : Fin A₂.width =>
                  Fin.addCases (fun _ : Fin A₁.width => (0 : ℝ))
                    (fun j₂ : Fin A₂.width => (A₂.hidden ⟨k.1, by simpa [hA₂] using k.2⟩).weight i₂ j₂) j)
                i,
            bias := fun i =>
              Fin.addCases
                (fun i₁ : Fin A₁.width => (A₁.hidden ⟨k.1, by simpa [hA₁] using k.2⟩).bias i₁)
                (fun i₂ : Fin A₂.width => (A₂.hidden ⟨k.1, by simpa [hA₂] using k.2⟩).bias i₂) i }
      let outBlk : Fin (A₁.width + A₂.width) → ℝ :=
        Fin.addCases (fun i₁ => a * A₁.outputWeight i₁) (fun i₂ => b * A₂.outputWeight i₂)
      let C : FullyConnectedReLUNet d :=
        { depth := D, width := A₁.width + A₂.width, input := inBlk, hidden := hidBlk,
          outputWeight := outBlk, outputBias := a * A₁.outputBias + b * A₂.outputBias }
      have hIn : ∀ x : Fin d → ℝ,
          inBlk.reluApply x = Fin.addCases (A₁.input.reluApply x) (A₂.input.reluApply x) := by
        intro x
        funext j
        by_cases hj : j.1 < A₁.width
        · simp [inBlk, Fin.addCases, DenseLayer.reluApply, DenseLayer.apply, reluVec, hj]
        · simp [inBlk, Fin.addCases, DenseLayer.reluApply, DenseLayer.apply, reluVec, hj]
      have hHid : ∀ (t : ℕ) (ht₁ : t < A₁.depth - 1) (ht₂ : t < A₂.depth - 1)
          (u : Fin A₁.width → ℝ) (v : Fin A₂.width → ℝ),
          (hidBlk ⟨t, by simpa [hA₁] using ht₁⟩).reluApply (Fin.addCases u v) =
            Fin.addCases (fun j₁ => (A₁.hidden ⟨t, ht₁⟩).reluApply u j₁)
              (fun j₂ => (A₂.hidden ⟨t, ht₂⟩).reluApply v j₂) := by
        intro t ht₁ ht₂ u v
        funext j
        by_cases hj : j.1 < A₁.width
        · simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
          rw [Fin.sum_univ_add]
          simp [hidBlk, Fin.addCases_left, Fin.addCases_right, Fin.addCases,
            DenseLayer.reluApply, DenseLayer.apply, reluVec, hj, Fin.mk.injEq]
        · simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
          rw [Fin.sum_univ_add]
          simp [hidBlk, Fin.addCases_left, Fin.addCases_right, Fin.addCases,
            DenseLayer.reluApply, DenseLayer.apply, reluVec, hj, Fin.mk.injEq]
      have hhd : ∀ (x : Fin d → ℝ) (t : ℕ),
          C.hiddenState x t = Fin.addCases (A₁.hiddenState x t) (A₂.hiddenState x t) := by
        intro x
        intro t
        induction t with
        | zero =>
            change C.input.reluApply x =
              Fin.addCases (A₁.input.reluApply x) (A₂.input.reluApply x)
            simp [C, hIn]
        | succ t ih =>
            by_cases ht : t < D - 1
            · have ht₁ : t < A₁.depth - 1 := by simpa [hA₁] using ht
              have ht₂ : t < A₂.depth - 1 := by simpa [hA₂] using ht
              have hCsucc : C.hiddenState x (t + 1) =
                  (C.hidden ⟨t, ht⟩).reluApply (C.hiddenState x t) := by
                change (if ht' : t < C.depth - 1 then
                    (C.hidden ⟨t, ht'⟩).reluApply (C.hiddenState x t) else C.hiddenState x t) =
                  (C.hidden ⟨t, ht⟩).reluApply (C.hiddenState x t)
                simp [C, ht]
              have hA₁succ : A₁.hiddenState x (t + 1) =
                  (A₁.hidden ⟨t, ht₁⟩).reluApply (A₁.hiddenState x t) := by
                change (if ht' : t < A₁.depth - 1 then
                    (A₁.hidden ⟨t, ht'⟩).reluApply (A₁.hiddenState x t) else A₁.hiddenState x t) =
                  (A₁.hidden ⟨t, ht₁⟩).reluApply (A₁.hiddenState x t)
                simp [ht₁]
              have hA₂succ : A₂.hiddenState x (t + 1) =
                  (A₂.hidden ⟨t, ht₂⟩).reluApply (A₂.hiddenState x t) := by
                change (if ht' : t < A₂.depth - 1 then
                    (A₂.hidden ⟨t, ht'⟩).reluApply (A₂.hiddenState x t) else A₂.hiddenState x t) =
                  (A₂.hidden ⟨t, ht₂⟩).reluApply (A₂.hiddenState x t)
                simp [ht₂]
              rw [hCsucc, hA₁succ, hA₂succ, ih]
              have hidx : (⟨t, ht⟩ : Fin (D - 1)) = ⟨t, by simpa [hA₁] using ht₁⟩ := by
                apply Fin.ext
                rfl
              rw [hidx]
              exact hHid t ht₁ ht₂ (A₁.hiddenState x t) (A₂.hiddenState x t)
            · have nht₁ : ¬ t < A₁.depth - 1 := by simpa [hA₁] using ht
              have nht₂ : ¬ t < A₂.depth - 1 := by simpa [hA₂] using ht
              change (if ht' : t < C.depth - 1 then
                  (C.hidden ⟨t, ht'⟩).reluApply (C.hiddenState x t) else C.hiddenState x t) =
                Fin.addCases
                  (if ht₁' : t < A₁.depth - 1 then
                      (A₁.hidden ⟨t, ht₁'⟩).reluApply (A₁.hiddenState x t) else A₁.hiddenState x t)
                  (if ht₂' : t < A₂.depth - 1 then
                      (A₂.hidden ⟨t, ht₂'⟩).reluApply (A₂.hiddenState x t) else A₂.hiddenState x t)
              simp [C, hA₁, hA₂, ht, ih]
      refine ⟨C, ?_, ?_, ?_, ?_⟩
      · rfl
      · rfl
      · simp [C, FullyConnectedReLUNet.parameterCount]
      · intro x
        have hhdD : C.hiddenState x (D - 1) =
            Fin.addCases (A₁.hiddenState x (D - 1)) (A₂.hiddenState x (D - 1)) :=
          hhd x (D - 1)
        calc
          C.realize x = (∑ j : Fin (A₁.width + A₂.width),
                outBlk j * Fin.addCases (A₁.hiddenState x (D - 1)) (A₂.hiddenState x (D - 1)) j) +
                (a * A₁.outputBias + b * A₂.outputBias) := by
                  simp [C, FullyConnectedReLUNet.realize, hhdD]
          _ = (∑ j₁ : Fin A₁.width, a * A₁.outputWeight j₁ * A₁.hiddenState x (D - 1) j₁) +
                (∑ j₂ : Fin A₂.width, b * A₂.outputWeight j₂ * A₂.hiddenState x (D - 1) j₂) +
                (a * A₁.outputBias + b * A₂.outputBias) := by
                  rw [Fin.sum_univ_add]
                  simp [outBlk, Fin.addCases_left, Fin.addCases_right]
          _ = a * A₁.realize x + b * A₂.realize x := by
                  simp only [FullyConnectedReLUNet.realize, hA₁, hA₂]
                  simp only [mul_add, add_mul, Finset.mul_sum, Finset.sum_mul]
                  ring
  -- @step s2: Fold the binary combination over s: exists N with N.depth = D, N.width = ∑ r ∈ s, (A r).width, parameter bound, and N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x for all x.
  have h_s2 : ∃ N : FullyConnectedReLUNet d,
      N.depth = D ∧ N.width = ∑ r ∈ s, (A r).width ∧
      N.parameterCount ≤ fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ∧
      (∀ x : Fin d → ℝ, N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x) := by
      -- @step s1: Stronger subset-indexed claim: for every t ⊆ s there is a depth-D network N_t with width ∑ r ∈ t, (A r).width, parameter bound, and N_t.realize x = finiteLinearCombination t coeff (fun r y => (A r).realize y) x; proved by Finset induction with base the zero-width depth-D network and insert step using h_s1 with A₁ = A r, A₂ = N_t, a = coeff r, b = 1.
      have h_sub : ∀ (t : Finset ι), t ⊆ s →
          ∃ N_t : FullyConnectedReLUNet d,
            N_t.depth = D ∧ N_t.width = ∑ r ∈ t, (A r).width ∧
            N_t.parameterCount ≤ fullyConnectedReLUParameterCount d D (∑ r ∈ t, (A r).width) ∧
            (∀ x : Fin d → ℝ, N_t.realize x = finiteLinearCombination t coeff (fun r y => (A r).realize y) x) := by
        intro t
        refine Finset.induction_on t ?_ ?_
        · intro _
          let zeroNet : FullyConnectedReLUNet d :=
            { depth := D, width := 0,
              input := { weight := fun _ _ => 0, bias := fun _ => 0 },
              hidden := fun _ => { weight := fun _ _ => 0, bias := fun _ => 0 },
              outputWeight := fun _ => 0, outputBias := 0 }
          refine ⟨zeroNet, rfl, ?_, ?_, ?_⟩
          · simp [zeroNet]
          · simp [zeroNet, FullyConnectedReLUNet.parameterCount]
          · intro x
            simp [zeroNet, FullyConnectedReLUNet.realize, finiteLinearCombination,
              Fin.sum_univ_zero]
        · intro a u hau ih hsub
          have hru : u ⊆ s := by
            intro x hx
            exact hsub (Finset.subset_insert a u hx)
          have has : a ∈ s := hsub (Finset.mem_insert_self a u)
          have hda : (A a).depth = D := hdepth a has
          rcases ih hru with ⟨N_u, hNud, hNuw, _, hNur⟩
          rcases h_s1 (A a) N_u hda hNud (coeff a) 1 with ⟨C, hCd, hCw, hCpc, hCr⟩
          refine ⟨C, hCd, ?_, ?_, ?_⟩
          · rw [hCw, hNuw, Finset.sum_insert hau]
          · simpa [hNuw, Finset.sum_insert hau] using hCpc
          · intro x
            rw [hCr, hNur x]
            simp [finiteLinearCombination, Finset.sum_insert hau]
      -- @step s2: Instantiate the subset-indexed claim at t = s to obtain the required network N with all four conjuncts, closing the existential target.
      have h_s2' : ∃ N : FullyConnectedReLUNet d,
          N.depth = D ∧ N.width = ∑ r ∈ s, (A r).width ∧
          N.parameterCount ≤ fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ∧
          (∀ x : Fin d → ℝ, N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x) := by
        exact h_sub s (by intro x hx; exact hx)
      exact h_s2'
  -- @step s3: Error bound: for the constructed N (via its exact realize), ∀ x, P x → |N.realize x - finiteLinearCombination s coeff f x| ≤ ∑ r ∈ s, |coeff r| * ε r.
  have h_s3 : ∀ N : FullyConnectedReLUNet d,
      (∀ x : Fin d → ℝ, N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x) →
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - finiteLinearCombination s coeff f x| ≤ ∑ r ∈ s, |coeff r| * ε r := by
      intro N hN_realize x hP
      rw [hN_realize x]
      simp only [finiteLinearCombination]
      rw [← Finset.sum_sub_distrib]
      simp_rw [← mul_sub]
      exact (Finset.abs_sum_le_sum_abs (fun r => coeff r * ((A r).realize x - f r x)) s).trans
        (Finset.sum_le_sum (by
          intro r hrs
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_left (herr r hrs x hP) (abs_nonneg (coeff r))))
  -- @step fin
  rcases h_s2 with ⟨N, hNdepth, hNwidth, hNparam, hNrealize⟩
  exact ⟨N, hNdepth, by rw [hNdepth]; exact hD, hNwidth, hNparam, hNrealize,
    h_s3 N hNrealize⟩

/-- Finite grid Taylor table cardinality for ordered multi-indices.

For a finite grid with `m` cells and Taylor expansion order `r` in dimension
`d`, the table storing one coefficient for every cell and every ordered Taylor
multi-index `Σ_{0≤k≤r} (Fin k → Fin d)` has cardinality `m * ∑_{k=0}^{r} d^k`. -/
theorem finite_grid_ordered_taylor_table_cardinality (m r d : ℕ) :
    Fintype.card
        (Fin m × Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) =
      m * (∑ k : Fin (r + 1), d ^ k.val) := by
  norm_num

theorem coordinatewise_cell_midpoint_box_bound
    {d : ℕ} {step : ℝ} (hstep : 0 ≤ step)
    (left x : Fin d → ℝ)
    (hcell : ∀ q : Fin d, left q ≤ x q ∧ x q ≤ left q + 2 * step) :
    ∀ q : Fin d, |x q - (left q + step)| ≤ step := by
  intro q
  rcases hcell q with ⟨hq1, hq2⟩
  rw [abs_le]
  constructor
  · linarith
  · linarith

open Statlib.Nonparametric.Vocabulary
open scoped BigOperators

theorem finite_grid_selector_indicator_local_reluNetworkClass_approximation_bound
    {d m : ℕ} (center : Fin m → Fin d → ℝ)
    (pi : (Fin d → ℝ) → Fin m) (domain : (Fin d → ℝ) → Prop)
    (target : (Fin d → ℝ) → ℝ) (R rho eps : ℝ)
    (depthBudget widthBudget parameterBudget : ℕ)
    (hselect_coord : ∀ x : Fin d → ℝ, domain x → ∀ q : Fin d, |x q - center (pi x) q| ≤ R)
    (hselect_norm : ∀ x : Fin d → ℝ, domain x → ‖x - center (pi x)‖ ≤ rho)
    (hlocal : ∀ j : Fin m, ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center j q| ≤ R) → ‖x - center j‖ ≤ rho →
        |g x - target x| ≤ eps) :
    ∃ table : Fin m → (Fin d → ℝ) → ℝ,
      (∀ j : Fin m, table j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget) ∧
      ∀ x : Fin d → ℝ, domain x →
        |(∑ j : Fin m, (if pi x = j then (1 : ℝ) else 0) * table j x) - target x| ≤ eps := by
  classical
  let table : Fin m → (Fin d → ℝ) → ℝ := fun j => Classical.choose (hlocal j)
  refine ⟨table, ?_, ?_⟩
  · intro j
    exact (Classical.choose_spec (hlocal j)).1
  · intro x hx
    have hsum :
        (∑ j : Fin m, (if pi x = j then (1 : ℝ) else 0) * table j x) = table (pi x) x := by
      calc
        (∑ j : Fin m, (if pi x = j then (1 : ℝ) else 0) * table j x)
            = (if pi x = pi x then (1 : ℝ) else 0) * table (pi x) x := by
          apply Finset.sum_eq_single (pi x)
          · intro b _ hbne
            simp [hbne.symm]
          · intro hnotin
            exact False.elim (hnotin (Finset.mem_univ (pi x)))
        _ = table (pi x) x := by
          simp
    rw [hsum]
    exact (Classical.choose_spec (hlocal (pi x))).2 x (hselect_coord x hx) (hselect_norm x hx)

theorem coordinateTentReLUNet_realize
    {d : ℕ} (coord : Fin d) (center scale : ℝ) :
    ∀ x : Fin d → ℝ,
      (coordinateTentReLUNet coord center scale).realize x =
        coordinateTentReLUFunction coord center scale x := by
  intro x
  have hsum_coord : (∑ q : Fin d, (if q = coord then 1 else 0) * x q) = x coord := by
    rw [Finset.sum_eq_single coord (f := fun q => (if q = coord then 1 else 0) * x q)]
    · simp
    · intro b _ hb
      simp [hb]
    · simp
  have hsum_neg : (∑ q : Fin d, (if q = coord then -1 else 0) * x q) = -x coord := by
    rw [Finset.sum_eq_single coord (f := fun q => (if q = coord then -1 else 0) * x q)]
    · simp
    · intro b _ hb
      simp [hb]
    · simp
  have hinput0 : (coordinateTentReLUNet coord center scale).input.apply x (0 : Fin 2) =
      x coord - center := by
    simp [coordinateTentReLUNet, DenseLayer.apply, hsum_coord]
    ring
  have hinput1 : (coordinateTentReLUNet coord center scale).input.apply x (1 : Fin 2) =
      center - x coord := by
    simp [coordinateTentReLUNet, DenseLayer.apply, hsum_neg]
    ring
  have hz0 : (coordinateTentReLUNet coord center scale).input.reluApply x (0 : Fin 2) =
      relu (x coord - center) := by
    simp [DenseLayer.reluApply, reluVec, hinput0]
  have hz1 : (coordinateTentReLUNet coord center scale).input.reluApply x (1 : Fin 2) =
      relu (center - x coord) := by
    simp [DenseLayer.reluApply, reluVec, hinput1]
  have hhiddenRaw0 :
      ((coordinateTentReLUNet coord center scale).hidden
        ⟨0, (by norm_num [coordinateTentReLUNet] : 0 < (coordinateTentReLUNet coord center scale).depth - 1)⟩).apply
        ((coordinateTentReLUNet coord center scale).input.reluApply x) (0 : Fin 2) =
      1 - scale * (relu (x coord - center) + relu (center - x coord)) := by
    simp [DenseLayer.apply, DenseLayer.reluApply, reluVec, coordinateTentReLUNet,
      hz0, hz1, hsum_coord, hsum_neg, Fin.sum_univ_two]
    ring
  have hhidden0 : (coordinateTentReLUNet coord center scale).hiddenState x 1 (0 : Fin 2) =
      relu (1 - scale * (relu (x coord - center) + relu (center - x coord))) := by
    rw [FullyConnectedReLUNet.hiddenState.eq_2]
    have hdepth0 : (coordinateTentReLUNet coord center scale).depth - 1 = 1 := by
      norm_num [coordinateTentReLUNet]
    simp [FullyConnectedReLUNet.hiddenState.eq_1, hdepth0]
    rw [DenseLayer.reluApply, reluVec]
    congr 1
  have hO0 : (coordinateTentReLUNet coord center scale).outputWeight (0 : Fin 2) = 1 := by
    simp [coordinateTentReLUNet]
  have hO1 : (coordinateTentReLUNet coord center scale).outputWeight (1 : Fin 2) = 0 := by
    simp [coordinateTentReLUNet]
  have hOB : (coordinateTentReLUNet coord center scale).outputBias = 0 := by
    simp [coordinateTentReLUNet]
  unfold FullyConnectedReLUNet.realize
  have hdepth : (coordinateTentReLUNet coord center scale).depth - 1 = 1 := by
    norm_num [coordinateTentReLUNet]
  change (∑ j : Fin 2,
        (coordinateTentReLUNet coord center scale).outputWeight j *
          (coordinateTentReLUNet coord center scale).hiddenState x 1 j +
        (coordinateTentReLUNet coord center scale).outputBias) =
      coordinateTentReLUFunction coord center scale x
  rw [Fin.sum_univ_two]
  simp [hdepth, hhidden0, hO0, hO1, hOB, coordinateTentReLUFunction]

theorem coordinateTentReLUFunction_mem_reluNetworkClass_with_parameter_bound
    {d depthBudget widthBudget parameterBudget : ℕ}
    (coord : Fin d) (center scale : ℝ)
    (hdepth : 2 ≤ depthBudget) (hwidth : 2 ≤ widthBudget)
    (hparameter : coordinateTentReLUParameterBound d ≤ parameterBudget) :
    coordinateTentReLUFunction coord center scale ∈
      reluNetworkClass d depthBudget widthBudget parameterBudget := by
  simp [reluNetworkClass]
  refine ⟨coordinateTentReLUNet coord center scale, ?_, ?_, ?_, ?_, ?_⟩
  · norm_num [coordinateTentReLUNet]
  · simpa [coordinateTentReLUNet] using hdepth
  · simpa [coordinateTentReLUNet] using hwidth
  · simpa [FullyConnectedReLUNet.parameterCount, coordinateTentReLUParameterBound,
      coordinateTentReLUNet] using hparameter
  · intro x
    simp [coordinateTentReLUFunction, coordinateTentReLUNet, FullyConnectedReLUNet.realize,
      FullyConnectedReLUNet.hiddenState, DenseLayer.apply, DenseLayer.reluApply, reluVec, relu,
      Fin.sum_univ_two, Finset.sum_ite_eq, Finset.sum_ite_eq']
    norm_num
    refine congrArg (fun t => max t 0) ?_
    ring

theorem axisAlignedBoxTentWeight_bounds_and_support
    {d : ℕ} (center scale x : Fin d → ℝ)
    (hscale : ∀ q : Fin d, 0 ≤ scale q) :
    0 ≤ axisAlignedBoxTentWeight center scale x ∧
    axisAlignedBoxTentWeight center scale x ≤ 1 ∧
    ((∃ q : Fin d,
        1 ≤ scale q * (relu (x q - center q) + relu (center q - x q))) →
      axisAlignedBoxTentWeight center scale x = 0) := by
  have h_s1 : ∀ q : Fin d, 0 ≤ coordinateTentReLUFunction q (center q) (scale q) x ∧
      coordinateTentReLUFunction q (center q) (scale q) x ≤ 1 := by
    intro q
    let D : ℝ := relu (x q - center q) + relu (center q - x q)
    have hD : 0 ≤ D := by
      dsimp [D]
      exact add_nonneg (by unfold relu; exact le_max_right (x q - center q) 0)
        (by unfold relu; exact le_max_right (center q - x q) 0)
    have hscD : 0 ≤ scale q * D := mul_nonneg (hscale q) hD
    have hle : 1 - scale q * D ≤ 1 := by linarith
    constructor
    · change 0 ≤ relu (1 - scale q * D)
      unfold relu
      exact le_max_right (1 - scale q * D) 0
    · change relu (1 - scale q * D) ≤ 1
      calc
        relu (1 - scale q * D) ≤ relu 1 := by
          unfold relu
          exact max_le_max hle (le_refl 0)
        _ = 1 := by simp [relu]
  have h_s2 : 0 ≤ axisAlignedBoxTentWeight center scale x ∧
      axisAlignedBoxTentWeight center scale x ≤ 1 := by
    unfold axisAlignedBoxTentWeight
    constructor
    · exact Finset.prod_nonneg (fun q _ => (h_s1 q).1)
    · exact Finset.prod_le_one (fun q _ => (h_s1 q).1) (fun q _ => (h_s1 q).2)
  have h_s3 : (∃ q : Fin d,
      1 ≤ scale q * (relu (x q - center q) + relu (center q - x q))) →
      axisAlignedBoxTentWeight center scale x = 0 := by
    rintro ⟨q0, hq0⟩
    have hle0 :
        1 - scale q0 * (relu (x q0 - center q0) + relu (center q0 - x q0)) ≤ 0 := by
      linarith
    have hrelu0 :
        relu (1 - scale q0 * (relu (x q0 - center q0) + relu (center q0 - x q0))) = 0 := by
      change max (1 - scale q0 * (relu (x q0 - center q0) + relu (center q0 - x q0))) 0 = 0
      exact max_eq_right hle0
    have hf0 : coordinateTentReLUFunction q0 (center q0) (scale q0) x = 0 := by
      unfold coordinateTentReLUFunction
      exact hrelu0
    unfold axisAlignedBoxTentWeight
    exact Finset.prod_eq_zero (Finset.mem_univ q0) hf0
  exact ⟨h_s2.1, ⟨h_s2.2, h_s3⟩⟩


theorem exists_fullyConnectedReLUNet_product_approx_on_box_with_size_bound
    {d D n : ℕ} (hD : 0 < D) (hn : 0 < n) {R ηf ηg : ℝ}
    (hR : 0 < R) (hηf : 0 ≤ ηf) (hηg : 0 ≤ ηg)
    {P : (Fin d → ℝ) → Prop}
    {f g : (Fin d → ℝ) → ℝ}
    (Nf Ng : FullyConnectedReLUNet d)
    (hNf_depth_pos : 0 < Nf.depth) (hNg_depth_pos : 0 < Ng.depth)
    (hNf_depth : Nf.depth ≤ D) (hNg_depth : Ng.depth ≤ D)
    (hNf_bound : ∀ x : Fin d → ℝ, P x → |Nf.realize x| ≤ R)
    (hNg_bound : ∀ x : Fin d → ℝ, P x → |Ng.realize x| ≤ R)
    (hg_bound : ∀ x : Fin d → ℝ, P x → |g x| ≤ R)
    (hf_err : ∀ x : Fin d → ℝ, P x → |Nf.realize x - f x| ≤ ηf)
    (hg_err : ∀ x : Fin d → ℝ, P x → |Ng.realize x - g x| ≤ ηg) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ D + 1 ∧
      N.width = Nf.width + Ng.width + 2 * n ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d (D + 1)
          (Nf.width + Ng.width + 2 * n) ∧
      ∀ x : Fin d → ℝ, P x →
        |N.realize x - f x * g x| ≤
          2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
  -- @step s1: existence of identity-padded Nf_pad with depth D, width Nf.width, parameter bound fullyConnectedReLUParameterCount d D Nf.width, realization equal to Nf.realize on all inputs
  have h_pad_f :
      ∃ Nf_pad : FullyConnectedReLUNet d,
        Nf_pad.depth = D ∧
        Nf_pad.width = Nf.width ∧
        Nf_pad.parameterCount ≤ fullyConnectedReLUParameterCount d D Nf.width ∧
            (∀ x : Fin d → ℝ, Nf_pad.realize x = Nf.realize x) := by
        let idLayer : DenseLayer Nf.width Nf.width := ⟨1, 0⟩
        let hiddenPad : Fin (D - 1) → DenseLayer Nf.width Nf.width :=
          fun k => if hk : k.val < Nf.depth - 1 then Nf.hidden ⟨k.val, hk⟩ else idLayer
        let Nf_pad : FullyConnectedReLUNet d :=
          ⟨D, Nf.width, Nf.input, hiddenPad, Nf.outputWeight, Nf.outputBias⟩
        refine ⟨Nf_pad, ?_, ?_, ?_, ?_⟩
        · rfl
        · rfl
        · change fullyConnectedReLUParameterCount d D Nf.width ≤
            fullyConnectedReLUParameterCount d D Nf.width
          exact le_rfl
        · intro x
          have h_id_apply :
              ∀ (v : Fin Nf.width → ℝ), (∀ j : Fin Nf.width, 0 ≤ v j) → idLayer.reluApply v = v := by
            intro v hv
            funext j
            simp [DenseLayer.reluApply, reluVec, DenseLayer.apply, relu, idLayer,
              Matrix.one_apply, Finset.sum_ite_eq', max_eq_left (hv j)]
          have h_nonneg_pad :
              ∀ (x : Fin d → ℝ) (k : ℕ) (j : Fin Nf.width), 0 ≤ Nf_pad.hiddenState x k j := by
            intro x k
            induction k with
            | zero =>
                intro j
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad, DenseLayer.reluApply, reluVec, relu]
            | succ k ih =>
                intro j
                by_cases hk : k < D - 1
                · simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad, DenseLayer.reluApply, reluVec, relu, hk]
                · simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad, hk]
                  exact ih j
          have h_agree :
              ∀ (x : Fin d → ℝ) (k : ℕ), k ≤ Nf.depth - 1 →
                Nf_pad.hiddenState x k = Nf.hiddenState x k := by
            intro x k
            induction k with
            | zero =>
                intro hk0
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad]
            | succ k ih =>
                intro hkle
                have hk : k < Nf.depth - 1 := Nat.lt_of_succ_le hkle
                have hkD : k < D - 1 := by omega
                have hih := ih (Nat.le_of_lt hk)
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad, hiddenPad, hkD, hk, hih]
          have h_const_pad :
              ∀ (x : Fin d → ℝ) (k : ℕ), Nf.depth - 1 ≤ k → k ≤ D - 1 →
                Nf_pad.hiddenState x k = Nf_pad.hiddenState x (Nf.depth - 1) := by
            intro x k
            induction k with
            | zero =>
                intro hk_low hk_high
                have h0 : Nf.depth - 1 = 0 := by omega
                rw [h0]
            | succ k ih =>
                intro hk_low hk_high
                by_cases hEq : Nf.depth - 1 = k + 1
                · rw [hEq]
                · have hk_ge : Nf.depth - 1 ≤ k := by omega
                  have hk_high' : k ≤ D - 1 := by omega
                  have hih := ih hk_ge hk_high'
                  have hn_lt : k < D - 1 := Nat.lt_of_succ_le hk_high
                  have hn' : ¬ k < Nf.depth - 1 := by omega
                  have hstep : Nf_pad.hiddenState x (k + 1) = Nf_pad.hiddenState x k := by
                    simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Nf_pad, hiddenPad, hn_lt, hn']
                    exact h_id_apply (Nf_pad.hiddenState x k) (h_nonneg_pad x k)
                  rw [hstep]
                  exact hih
          have h_state :
              ∀ j : Fin Nf.width, Nf_pad.hiddenState x (D - 1) j = Nf.hiddenState x (Nf.depth - 1) j := by
            intro j
            calc
              Nf_pad.hiddenState x (D - 1) j = Nf_pad.hiddenState x (Nf.depth - 1) j := by
                exact congr_fun (h_const_pad x (D - 1) (Nat.sub_le_sub_right hNf_depth 1) le_rfl) j
              _ = Nf.hiddenState x (Nf.depth - 1) j := by
                exact congr_fun (h_agree x (Nf.depth - 1) le_rfl) j
          calc
            Nf_pad.realize x = ∑ j : Fin Nf.width, Nf.outputWeight j * Nf_pad.hiddenState x (D - 1) j + Nf.outputBias := by
              simp [FullyConnectedReLUNet.realize, Nf_pad]
            _ = ∑ j : Fin Nf.width, Nf.outputWeight j * Nf.hiddenState x (Nf.depth - 1) j + Nf.outputBias := by
              simp [h_state]
            _ = Nf.realize x := by
              simp [FullyConnectedReLUNet.realize]
  -- @step s2: existence of identity-padded Ng_pad with depth D, width Ng.width, parameter bound fullyConnectedReLUParameterCount d D Ng.width, realization equal to Ng.realize on all inputs
  have h_pad_g :
      ∃ Ng_pad : FullyConnectedReLUNet d,
        Ng_pad.depth = D ∧
        Ng_pad.width = Ng.width ∧
        Ng_pad.parameterCount ≤ fullyConnectedReLUParameterCount d D Ng.width ∧
        (∀ x : Fin d → ℝ, Ng_pad.realize x = Ng.realize x) := by
        let idLayer : DenseLayer Ng.width Ng.width := ⟨1, 0⟩
        let hiddenPad : Fin (D - 1) → DenseLayer Ng.width Ng.width :=
          fun k => if hk : k.val < Ng.depth - 1 then Ng.hidden ⟨k.val, hk⟩ else idLayer
        let Ng_pad : FullyConnectedReLUNet d :=
          ⟨D, Ng.width, Ng.input, hiddenPad, Ng.outputWeight, Ng.outputBias⟩
        refine ⟨Ng_pad, ?_, ?_, ?_, ?_⟩
        · rfl
        · rfl
        · change fullyConnectedReLUParameterCount d D Ng.width ≤
            fullyConnectedReLUParameterCount d D Ng.width
          exact le_rfl
        · intro x
          have h_id_apply :
              ∀ (v : Fin Ng.width → ℝ), (∀ j : Fin Ng.width, 0 ≤ v j) → idLayer.reluApply v = v := by
            intro v hv
            funext j
            simp [DenseLayer.reluApply, reluVec, DenseLayer.apply, relu, idLayer,
              Matrix.one_apply, Finset.sum_ite_eq', max_eq_left (hv j)]
          have h_nonneg_pad :
              ∀ (x : Fin d → ℝ) (k : ℕ) (j : Fin Ng.width), 0 ≤ Ng_pad.hiddenState x k j := by
            intro x k
            induction k with
            | zero =>
                intro j
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad, DenseLayer.reluApply, reluVec, relu]
            | succ k ih =>
                intro j
                by_cases hk : k < D - 1
                · simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad, DenseLayer.reluApply, reluVec, relu, hk]
                · simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad, hk]
                  exact ih j
          have h_agree :
              ∀ (x : Fin d → ℝ) (k : ℕ), k ≤ Ng.depth - 1 →
                Ng_pad.hiddenState x k = Ng.hiddenState x k := by
            intro x k
            induction k with
            | zero =>
                intro hk0
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad]
            | succ k ih =>
                intro hkle
                have hk : k < Ng.depth - 1 := Nat.lt_of_succ_le hkle
                have hkD : k < D - 1 := by omega
                have hih := ih (Nat.le_of_lt hk)
                simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad, hiddenPad, hkD, hk, hih]
          have h_const_pad :
              ∀ (x : Fin d → ℝ) (k : ℕ), Ng.depth - 1 ≤ k → k ≤ D - 1 →
                Ng_pad.hiddenState x k = Ng_pad.hiddenState x (Ng.depth - 1) := by
            intro x k
            induction k with
            | zero =>
                intro hk_low hk_high
                have h0 : Ng.depth - 1 = 0 := by omega
                rw [h0]
            | succ k ih =>
                intro hk_low hk_high
                by_cases hEq : Ng.depth - 1 = k + 1
                · rw [hEq]
                · have hk_ge : Ng.depth - 1 ≤ k := by omega
                  have hk_high' : k ≤ D - 1 := by omega
                  have hih := ih hk_ge hk_high'
                  have hn_lt : k < D - 1 := Nat.lt_of_succ_le hk_high
                  have hn' : ¬ k < Ng.depth - 1 := by omega
                  have hstep : Ng_pad.hiddenState x (k + 1) = Ng_pad.hiddenState x k := by
                    simp [FullyConnectedReLUNet.hiddenState, Nat.brecOn, Ng_pad, hiddenPad, hn_lt, hn']
                    exact h_id_apply (Ng_pad.hiddenState x k) (h_nonneg_pad x k)
                  rw [hstep]
                  exact hih
          have h_state :
              ∀ j : Fin Ng.width, Ng_pad.hiddenState x (D - 1) j = Ng.hiddenState x (Ng.depth - 1) j := by
            intro j
            calc
              Ng_pad.hiddenState x (D - 1) j = Ng_pad.hiddenState x (Ng.depth - 1) j := by
                exact congr_fun (h_const_pad x (D - 1) (Nat.sub_le_sub_right hNg_depth 1) le_rfl) j
              _ = Ng.hiddenState x (Ng.depth - 1) j := by
                exact congr_fun (h_agree x (Ng.depth - 1) le_rfl) j
          calc
            Ng_pad.realize x = ∑ j : Fin Ng.width, Ng.outputWeight j * Ng_pad.hiddenState x (D - 1) j + Ng.outputBias := by
              simp [FullyConnectedReLUNet.realize, Ng_pad]
            _ = ∑ j : Fin Ng.width, Ng.outputWeight j * Ng.hiddenState x (Ng.depth - 1) j + Ng.outputBias := by
              simp [h_state]
            _ = Ng.realize x := by
              simp [FullyConnectedReLUNet.realize]
  -- @step s3: one-hidden-layer multiplication network Mul with input dimension 2, depth 1, width 2*n, parameter count ≤ 8*n+1, error |Mul.realize x - x0*x1| ≤ 2*R^2/n^2 on [-R,R]^2
  have h_mul :
      ∃ Mul : FullyConnectedReLUNet 2,
        Mul.depth = 1 ∧
        Mul.width = 2 * n ∧
        Mul.parameterCount ≤ 8 * n + 1 ∧
        (∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R →
          |Mul.realize x - x 0 * x 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2) := by
          exact exists_fullyConnectedReLUNet_mul_approx_on_box hn hR
  -- @step s4: final existential output: compose Nf_pad and Ng_pad through Mul to get N with depth D+1, width Nf.width + Ng.width + 2*n, parameter bound, and error 2*R^2/n^2 + R*ηg + R*ηf
  have h_final :
      ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤ D + 1 ∧
        N.width = Nf.width + Ng.width + 2 * n ∧
        N.parameterCount ≤
          fullyConnectedReLUParameterCount d (D + 1)
            (Nf.width + Ng.width + 2 * n) ∧
        ∀ x : Fin d → ℝ, P x →
          |N.realize x - f x * g x| ≤
                    2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
            -- @step s1: from h_pad_f, h_pad_g, and h_mul choose Nf_pad, Ng_pad, and Mul and construct the composite network N with depth D+1, width Nf.width + Ng.width + 2*n, parameter bound, and realization identity N.realize x = Mul.realize (fun i : Fin 2 => if i = 0 then Nf_pad.realize x else Ng_pad.realize x)
            have h_s1 :
                ∃ N : FullyConnectedReLUNet d,
                  0 < N.depth ∧
                  N.depth ≤ D + 1 ∧
                  N.width = Nf.width + Ng.width + 2 * n ∧
                  N.parameterCount ≤
                    fullyConnectedReLUParameterCount d (D + 1)
                      (Nf.width + Ng.width + 2 * n) ∧
                  (∀ x : Fin d → ℝ,
                    N.realize x =
                      (Classical.choose h_mul).realize
                        (fun i : Fin 2 =>
                          if i = 0 then (Classical.choose h_pad_f).realize x
                          else (Classical.choose h_pad_g).realize x)) := by
                                          -- witnesses for the three approximation networks
                                          let Nf_pad : FullyConnectedReLUNet d := Classical.choose h_pad_f
                                          let Ng_pad : FullyConnectedReLUNet d := Classical.choose h_pad_g
                                          let Mul : FullyConnectedReLUNet 2 := Classical.choose h_mul
                                          have hNf_spec : Nf_pad.depth = D ∧ Nf_pad.width = Nf.width ∧ Nf_pad.parameterCount ≤ fullyConnectedReLUParameterCount d D Nf.width ∧ (∀ x : Fin d → ℝ, Nf_pad.realize x = Nf.realize x) := by
                                            simpa [Nf_pad] using Classical.choose_spec h_pad_f
                                          have hNg_spec : Ng_pad.depth = D ∧ Ng_pad.width = Ng.width ∧ Ng_pad.parameterCount ≤ fullyConnectedReLUParameterCount d D Ng.width ∧ (∀ x : Fin d → ℝ, Ng_pad.realize x = Ng.realize x) := by
                                            simpa [Ng_pad] using Classical.choose_spec h_pad_g
                                          have hMul_spec : Mul.depth = 1 ∧ Mul.width = 2 * n ∧ Mul.parameterCount ≤ 8 * n + 1 ∧ (∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R → |Mul.realize x - x 0 * x 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2) := by
                                            simpa [Mul] using Classical.choose_spec h_mul
                                          have hNf_width : Nf_pad.width = Nf.width := hNf_spec.2.1
                                          have hNg_width : Ng_pad.width = Ng.width := hNg_spec.2.1
                                          have hMul_width : Mul.width = 2 * n := hMul_spec.2.1
                                          have hNf_depth : Nf_pad.depth = D := hNf_spec.1
                                          have hNg_depth : Ng_pad.depth = D := hNg_spec.1
                                          have hMul_depth : Mul.depth = 1 := hMul_spec.1
                                          -- block decomposition of the width
                                          let W : ℕ := Nf_pad.width + Ng_pad.width + Mul.width
                                          let toA : Fin Nf_pad.width → Fin W := fun a => ⟨a.val, by omega⟩
                                          let toB : Fin Ng_pad.width → Fin W := fun b => ⟨Nf_pad.width + b.val, by omega⟩
                                          let toC : Fin Mul.width → Fin W := fun c => ⟨Nf_pad.width + Ng_pad.width + c.val, by omega⟩
                                          -- sum splitting over the three blocks
                                          have split_last : ∀ (a b : ℕ) (φ : Fin (a + b) → ℝ),
                                              (∑ j : Fin (a + b), φ j) =
                                                (∑ j : Fin a, φ ⟨j.val, by omega⟩) + (∑ j : Fin b, φ ⟨a + j.val, by omega⟩) := by
                                            intro a b φ
                                            let g : ℕ → ℝ := fun i => if h : i < a + b then φ ⟨i, h⟩ else 0
                                            calc
                                              (∑ j : Fin (a + b), φ j) = ∑ i : Fin (a + b), g i.val := by
                                                apply Finset.sum_congr rfl
                                                intro j hj
                                                simp [g, j.isLt]
                                              _ = ∑ i ∈ Finset.range (a + b), g i := by
                                                rw [Fin.sum_univ_eq_sum_range g (a + b)]
                                              _ = (∑ i ∈ Finset.range a, g i) + (∑ i ∈ Finset.range b, g (a + i)) := by
                                                rw [Finset.sum_range_add g a b]
                                              _ = (∑ j : Fin a, φ ⟨j.val, by omega⟩) + (∑ j : Fin b, φ ⟨a + j.val, by omega⟩) := by
                                                congr 1
                                                · calc
                                                    (∑ i ∈ Finset.range a, g i) = ∑ i ∈ Finset.range a, (if h : i < a then φ ⟨i, by omega⟩ else 0) := by
                                                      apply Finset.sum_congr rfl
                                                      intro i hi
                                                      have hi' : i < a := Finset.mem_range.mp hi
                                                      have hi'' : i < a + b := by omega
                                                      simp [g, hi', hi'']
                                                    _ = ∑ j : Fin a, (if h : j.val < a then φ ⟨j.val, by omega⟩ else 0) := by
                                                      rw [← Fin.sum_univ_eq_sum_range (fun i : ℕ => if h : i < a then φ ⟨i, by omega⟩ else 0) a]
                                                    _ = ∑ j : Fin a, φ ⟨j.val, by omega⟩ := by
                                                      apply Finset.sum_congr rfl
                                                      intro j hj
                                                      simp [j.isLt]
                                                · calc
                                                    (∑ i ∈ Finset.range b, g (a + i)) = ∑ i ∈ Finset.range b, (if h : i < b then φ ⟨a + i, by omega⟩ else 0) := by
                                                      apply Finset.sum_congr rfl
                                                      intro i hi
                                                      have hi' : i < b := Finset.mem_range.mp hi
                                                      have hi'' : a + i < a + b := by omega
                                                      simp [g, hi', hi'']
                                                    _ = ∑ j : Fin b, (if h : j.val < b then φ ⟨a + j.val, by omega⟩ else 0) := by
                                                      rw [← Fin.sum_univ_eq_sum_range (fun i : ℕ => if h : i < b then φ ⟨a + i, by omega⟩ else 0) b]
                                                    _ = ∑ j : Fin b, φ ⟨a + j.val, by omega⟩ := by
                                                      apply Finset.sum_congr rfl
                                                      intro j hj
                                                      simp [j.isLt]
                                          have sum_split : ∀ (φ : Fin W → ℝ),
                                              (∑ j : Fin W, φ j) =
                                                (∑ a : Fin Nf_pad.width, φ (toA a)) +
                                                (∑ b : Fin Ng_pad.width, φ (toB b)) +
                                                (∑ c : Fin Mul.width, φ (toC c)) := by
                                            intro φ
                                            have h1 := split_last (Nf_pad.width + Ng_pad.width) Mul.width φ
                                            have h2 := split_last Nf_pad.width Ng_pad.width (fun j : Fin (Nf_pad.width + Ng_pad.width) => φ ⟨j.val, by omega⟩)
                                            calc
                                              (∑ j : Fin W, φ j) = (∑ j : Fin (Nf_pad.width + Ng_pad.width), φ ⟨j.val, by omega⟩) + (∑ c : Fin Mul.width, φ ⟨Nf_pad.width + Ng_pad.width + c.val, by omega⟩) := h1
                                              _ = ((∑ a : Fin Nf_pad.width, φ ⟨a.val, by omega⟩) + (∑ b : Fin Ng_pad.width, φ ⟨Nf_pad.width + b.val, by omega⟩)) + (∑ c : Fin Mul.width, φ ⟨Nf_pad.width + Ng_pad.width + c.val, by omega⟩) := by
                                                rw [h2]
                                              _ = (∑ a : Fin Nf_pad.width, φ (toA a)) + (∑ b : Fin Ng_pad.width, φ (toB b)) + (∑ c : Fin Mul.width, φ (toC c)) := by
                                                simp [toA, toB, toC]
                                          -- layer builders
                                          let zeroL (w : ℕ) : DenseLayer w w :=
                                            { weight := fun _ _ => 0, bias := fun _ => 0 }
                                          let bd (Lf : DenseLayer Nf_pad.width Nf_pad.width)
                                              (Lg : DenseLayer Ng_pad.width Ng_pad.width)
                                              (L0 : DenseLayer Mul.width Mul.width) : DenseLayer W W :=
                                            { weight := fun k i =>
                                                if hi : i.val < Nf_pad.width then
                                                  if hk : k.val < Nf_pad.width then Lf.weight ⟨k.val, hk⟩ ⟨i.val, hi⟩ else 0
                                                else if hi : i.val < Nf_pad.width + Ng_pad.width then
                                                  if hk : Nf_pad.width ≤ k.val ∧ k.val < Nf_pad.width + Ng_pad.width then
                                                    Lg.weight ⟨k.val - Nf_pad.width, by omega⟩ ⟨i.val - Nf_pad.width, by omega⟩ else 0
                                                else
                                                  if hk : Nf_pad.width + Ng_pad.width ≤ k.val then
                                                    L0.weight ⟨k.val - (Nf_pad.width + Ng_pad.width), by omega⟩ ⟨i.val - (Nf_pad.width + Ng_pad.width), by omega⟩ else 0,
                                              bias := fun i =>
                                                if hi : i.val < Nf_pad.width then Lf.bias ⟨i.val, hi⟩
                                                else if hi : i.val < Nf_pad.width + Ng_pad.width then Lg.bias ⟨i.val - Nf_pad.width, by omega⟩
                                                else L0.bias ⟨i.val - (Nf_pad.width + Ng_pad.width), by omega⟩ }
                                          let inL : DenseLayer d W :=
                                            { weight := fun j i =>
                                                if hj : j.val < Nf_pad.width then Nf_pad.input.weight ⟨j.val, hj⟩ i
                                                else if hj : j.val < Nf_pad.width + Ng_pad.width then Ng_pad.input.weight ⟨j.val - Nf_pad.width, by omega⟩ i
                                                else 0,
                                              bias := fun j =>
                                                if hj : j.val < Nf_pad.width then Nf_pad.input.bias ⟨j.val, hj⟩
                                                else if hj : j.val < Nf_pad.width + Ng_pad.width then Ng_pad.input.bias ⟨j.val - Nf_pad.width, by omega⟩
                                                else 0 }
                                          let mulL : DenseLayer W W :=
                                            { weight := fun k i =>
                                                if hk : k.val < Nf_pad.width then 0
                                                else if hk : k.val < Nf_pad.width + Ng_pad.width then 0
                                                else
                                                  if hi : i.val < Nf_pad.width then
                                                    Mul.input.weight ⟨k.val - (Nf_pad.width + Ng_pad.width), by omega⟩ 0 * Nf_pad.outputWeight ⟨i.val, hi⟩
                                                  else if hi : i.val < Nf_pad.width + Ng_pad.width then
                                                    Mul.input.weight ⟨k.val - (Nf_pad.width + Ng_pad.width), by omega⟩ 1 * Ng_pad.outputWeight ⟨i.val - Nf_pad.width, by omega⟩
                                                  else 0,
                                              bias := fun i =>
                                                if hi : i.val < Nf_pad.width then 0
                                                else if hi : i.val < Nf_pad.width + Ng_pad.width then 0
                                                else
                                                  Mul.input.weight ⟨i.val - (Nf_pad.width + Ng_pad.width), by omega⟩ 0 * Nf_pad.outputBias +
                                                  Mul.input.weight ⟨i.val - (Nf_pad.width + Ng_pad.width), by omega⟩ 1 * Ng_pad.outputBias +
                                                  Mul.input.bias ⟨i.val - (Nf_pad.width + Ng_pad.width), by omega⟩ }
                                          let N : FullyConnectedReLUNet d :=
                                            { depth := D + 1,
                                              width := W,
                                              input := inL,
                                              hidden := fun t => if ht : t.val < D - 1 then
                                                  bd (Nf_pad.hidden ⟨t.val, by omega⟩) (Ng_pad.hidden ⟨t.val, by omega⟩) (zeroL Mul.width)
                                                else mulL,
                                              outputWeight := fun j =>
                                                if hj : Nf_pad.width + Ng_pad.width ≤ j.val then
                                                  Mul.outputWeight ⟨j.val - (Nf_pad.width + Ng_pad.width), by omega⟩ else 0,
                                              outputBias := Mul.outputBias }
                                          -- block structure of the input layer
                                          have inL_applyA : ∀ (x : Fin d → ℝ) (a : Fin Nf_pad.width), inL.apply x (toA a) = Nf_pad.input.apply x a := by
                                            intro x a
                                            simp [inL, toA, DenseLayer.apply, a.isLt]
                                          have inL_applyB : ∀ (x : Fin d → ℝ) (b : Fin Ng_pad.width), inL.apply x (toB b) = Ng_pad.input.apply x b := by
                                            intro x b
                                            have hb1 : ¬ Nf_pad.width + b.val < Nf_pad.width := by omega
                                            have hb2 : Nf_pad.width + b.val < Nf_pad.width + Ng_pad.width := by omega
                                            simp [inL, toA, toB, DenseLayer.apply, hb1, hb2]
                                          have inL_applyC : ∀ (x : Fin d → ℝ) (c : Fin Mul.width), inL.apply x (toC c) = 0 := by
                                            intro x c
                                            have hc1 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                            have hc2 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                            simp [inL, toA, toB, toC, DenseLayer.apply, hc1, hc2]
                                          have inL_reluA : ∀ (x : Fin d → ℝ) (a : Fin Nf_pad.width), inL.reluApply x (toA a) = Nf_pad.input.reluApply x a := by
                                            intro x a
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            congr 1
                                            exact inL_applyA x a
                                          have inL_reluB : ∀ (x : Fin d → ℝ) (b : Fin Ng_pad.width), inL.reluApply x (toB b) = Ng_pad.input.reluApply x b := by
                                            intro x b
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            congr 1
                                            exact inL_applyB x b
                                          have inL_reluC : ∀ (x : Fin d → ℝ) (c : Fin Mul.width), inL.reluApply x (toC c) = 0 := by
                                            intro x c
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            rw [inL_applyC x c]
                                            simp [relu]
                                          -- block structure of the block-diagonal hidden layer
                                          have bd_reluA : ∀ (Lf : DenseLayer Nf_pad.width Nf_pad.width)
                                              (Lg : DenseLayer Ng_pad.width Ng_pad.width) (L0 : DenseLayer Mul.width Mul.width)
                                              (v : Fin W → ℝ) (i : Fin Nf_pad.width),
                                              (bd Lf Lg L0).reluApply v (toA i) = Lf.reluApply (fun a => v (toA a)) i := by
                                            intro Lf Lg L0 v i
                                            have hpre : ∀ i : Fin Nf_pad.width,
                                                (∑ j : Fin W, (bd Lf Lg L0).weight (toA i) j * v j) + (bd Lf Lg L0).bias (toA i)
                                                  = (∑ a : Fin Nf_pad.width, Lf.weight i a * v (toA a)) + Lf.bias i := by
                                              intro i
                                              rw [sum_split (fun j : Fin W => (bd Lf Lg L0).weight (toA i) j * v j)]
                                              have hΦA : ∀ a : Fin Nf_pad.width, (bd Lf Lg L0).weight (toA i) (toA a) * v (toA a) = Lf.weight i a * v (toA a) := by
                                                intro a
                                                simp [bd, toA, toB, toC, i.isLt, a.isLt]
                                              have hΦB : ∀ b : Fin Ng_pad.width, (bd Lf Lg L0).weight (toA i) (toB b) * v (toB b) = 0 := by
                                                intro b
                                                have hb1 : ¬ Nf_pad.width + b.val < Nf_pad.width := by omega
                                                have hb2 : Nf_pad.width + b.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hi : ¬ (Nf_pad.width ≤ i.val ∧ i.val < Nf_pad.width + Ng_pad.width) := by omega
                                                simp [bd, toA, toB, toC, hb1, hb2, hi]
                                              have hΦC : ∀ c : Fin Mul.width, (bd Lf Lg L0).weight (toA i) (toC c) * v (toC c) = 0 := by
                                                intro c
                                                have hc1 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                have hc2 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hc3 : ¬ (Nf_pad.width + Ng_pad.width ≤ i.val) := by omega
                                                simp [bd, toA, toB, toC, hc1, hc2, hc3]
                                              have hbias : (bd Lf Lg L0).bias (toA i) = Lf.bias i := by
                                                simp [bd, toA, i.isLt]
                                              rw [Finset.sum_congr rfl (fun a ha => hΦA a)]
                                              rw [Finset.sum_congr rfl (fun b hb => hΦB b)]
                                              rw [Finset.sum_congr rfl (fun c hc => hΦC c)]
                                              rw [hbias]
                                              simp
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            congr 1
                                            unfold DenseLayer.apply
                                            exact hpre i
                                          have bd_reluB : ∀ (Lf : DenseLayer Nf_pad.width Nf_pad.width)
                                              (Lg : DenseLayer Ng_pad.width Ng_pad.width) (L0 : DenseLayer Mul.width Mul.width)
                                              (v : Fin W → ℝ) (i : Fin Ng_pad.width),
                                              (bd Lf Lg L0).reluApply v (toB i) = Lg.reluApply (fun b => v (toB b)) i := by
                                            intro Lf Lg L0 v i
                                            have hpre : ∀ i : Fin Ng_pad.width,
                                                (∑ j : Fin W, (bd Lf Lg L0).weight (toB i) j * v j) + (bd Lf Lg L0).bias (toB i)
                                                  = (∑ b : Fin Ng_pad.width, Lg.weight i b * v (toB b)) + Lg.bias i := by
                                              intro i
                                              rw [sum_split (fun j : Fin W => (bd Lf Lg L0).weight (toB i) j * v j)]
                                              have hΦA : ∀ a : Fin Nf_pad.width, (bd Lf Lg L0).weight (toB i) (toA a) * v (toA a) = 0 := by
                                                intro a
                                                have hi1 : ¬ Nf_pad.width + i.val < Nf_pad.width := by omega
                                                simp [bd, toA, toB, toC, a.isLt, hi1]
                                              have hΦB : ∀ b : Fin Ng_pad.width, (bd Lf Lg L0).weight (toB i) (toB b) * v (toB b) = Lg.weight i b * v (toB b) := by
                                                intro b
                                                have hb1 : ¬ Nf_pad.width + b.val < Nf_pad.width := by omega
                                                have hb2 : Nf_pad.width + b.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hi : Nf_pad.width ≤ Nf_pad.width + i.val ∧ Nf_pad.width + i.val < Nf_pad.width + Ng_pad.width := by omega
                                                simp [bd, toA, toB, toC, hb1, hb2, hi]
                                              have hΦC : ∀ c : Fin Mul.width, (bd Lf Lg L0).weight (toB i) (toC c) * v (toC c) = 0 := by
                                                intro c
                                                have hc1 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                have hc2 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hc3 : ¬ (Nf_pad.width + Ng_pad.width ≤ Nf_pad.width + i.val) := by omega
                                                simp [bd, toA, toB, toC, hc1, hc2, hc3]
                                              have hbias : (bd Lf Lg L0).bias (toB i) = Lg.bias i := by
                                                have hi1 : ¬ Nf_pad.width + i.val < Nf_pad.width := by omega
                                                have hi2 : Nf_pad.width + i.val < Nf_pad.width + Ng_pad.width := by omega
                                                simp [bd, toA, toB, toC, hi1, hi2]
                                              rw [Finset.sum_congr rfl (fun a ha => hΦA a)]
                                              rw [Finset.sum_congr rfl (fun b hb => hΦB b)]
                                              rw [Finset.sum_congr rfl (fun c hc => hΦC c)]
                                              rw [hbias]
                                              simp
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            congr 1
                                            unfold DenseLayer.apply
                                            exact hpre i
                                          have bd_reluC : ∀ (Lf : DenseLayer Nf_pad.width Nf_pad.width)
                                              (Lg : DenseLayer Ng_pad.width Ng_pad.width) (L0 : DenseLayer Mul.width Mul.width)
                                              (v : Fin W → ℝ) (i : Fin Mul.width),
                                              (bd Lf Lg L0).reluApply v (toC i) = L0.reluApply (fun c => v (toC c)) i := by
                                            intro Lf Lg L0 v i
                                            have hpre : ∀ i : Fin Mul.width,
                                                (∑ j : Fin W, (bd Lf Lg L0).weight (toC i) j * v j) + (bd Lf Lg L0).bias (toC i)
                                                  = (∑ c : Fin Mul.width, L0.weight i c * v (toC c)) + L0.bias i := by
                                              intro i
                                              rw [sum_split (fun j : Fin W => (bd Lf Lg L0).weight (toC i) j * v j)]
                                              have hΦA : ∀ a : Fin Nf_pad.width, (bd Lf Lg L0).weight (toC i) (toA a) * v (toA a) = 0 := by
                                                intro a
                                                have hi1 : ¬ Nf_pad.width + Ng_pad.width + i.val < Nf_pad.width := by omega
                                                simp [bd, toA, toB, toC, a.isLt, hi1]
                                              have hΦB : ∀ b : Fin Ng_pad.width, (bd Lf Lg L0).weight (toC i) (toB b) * v (toB b) = 0 := by
                                                intro b
                                                have hb1 : ¬ Nf_pad.width + b.val < Nf_pad.width := by omega
                                                have hb2 : Nf_pad.width + b.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hi2 : ¬ (Nf_pad.width ≤ Nf_pad.width + Ng_pad.width + i.val ∧ Nf_pad.width + Ng_pad.width + i.val < Nf_pad.width + Ng_pad.width) := by omega
                                                simp [bd, toA, toB, toC, hb1, hb2, hi2]
                                              have hΦC : ∀ c : Fin Mul.width, (bd Lf Lg L0).weight (toC i) (toC c) * v (toC c) = L0.weight i c * v (toC c) := by
                                                intro c
                                                have hc1 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                have hc2 : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                have hc3 : Nf_pad.width + Ng_pad.width ≤ Nf_pad.width + Ng_pad.width + i.val := by omega
                                                simp [bd, toA, toB, toC, hc1, hc2, hc3]
                                              have hbias : (bd Lf Lg L0).bias (toC i) = L0.bias i := by
                                                have hi1 : ¬ Nf_pad.width + Ng_pad.width + i.val < Nf_pad.width := by omega
                                                have hi2 : ¬ Nf_pad.width + Ng_pad.width + i.val < Nf_pad.width + Ng_pad.width := by omega
                                                simp [bd, toA, toB, toC, hi1, hi2]
                                              rw [Finset.sum_congr rfl (fun a ha => hΦA a)]
                                              rw [Finset.sum_congr rfl (fun b hb => hΦB b)]
                                              rw [Finset.sum_congr rfl (fun c hc => hΦC c)]
                                              rw [hbias]
                                              simp
                                            unfold DenseLayer.reluApply
                                            simp only [reluVec]
                                            congr 1
                                            unfold DenseLayer.apply
                                            exact hpre i
                                          -- recursion facts for hiddenState
                                          have hidden_zero : ∀ (M : FullyConnectedReLUNet d) (y : Fin d → ℝ), M.hiddenState y 0 = M.input.reluApply y := by
                                            intro M y
                                            simp [FullyConnectedReLUNet.hiddenState]
                                          have hidden_succ : ∀ (M : FullyConnectedReLUNet d) (y : Fin d → ℝ) (t : ℕ) (ht : t < M.depth - 1),
                                              M.hiddenState y (t + 1) = (M.hidden ⟨t, ht⟩).reluApply (M.hiddenState y t) := by
                                            intro M y t ht
                                            simp [FullyConnectedReLUNet.hiddenState, ht]
                                          -- block claims: for t < D the composite's hidden state follows the padded networks on blocks A/B and is 0 on block C
                                          have hblock : ∀ (x : Fin d → ℝ) (t : ℕ), t < D →
                                              (∀ a : Fin Nf_pad.width, N.hiddenState x t (toA a) = Nf_pad.hiddenState x t a) ∧
                                              (∀ b : Fin Ng_pad.width, N.hiddenState x t (toB b) = Ng_pad.hiddenState x t b) ∧
                                              (∀ c : Fin Mul.width, N.hiddenState x t (toC c) = 0) := by
                                            intro x t ht
                                            induction t with
                                            | zero =>
                                                constructor
                                                · intro a
                                                  change inL.reluApply x (toA a) = Nf_pad.input.reluApply x a
                                                  exact inL_reluA x a
                                                · constructor
                                                  · intro b
                                                    change inL.reluApply x (toB b) = Ng_pad.input.reluApply x b
                                                    exact inL_reluB x b
                                                  · intro c
                                                    change inL.reluApply x (toC c) = 0
                                                    exact inL_reluC x c
                                            | succ t ih =>
                                                have htD : t < D := by omega
                                                have htD1 : t < D - 1 := by omega
                                                have htDN : t < (D + 1) - 1 := by omega
                                                have htF : t < Nf_pad.depth - 1 := by omega
                                                have htG : t < Ng_pad.depth - 1 := by omega
                                                have ih' := ih htD
                                                have hrecN : N.hiddenState x (t + 1) = (N.hidden ⟨t, htDN⟩).reluApply (N.hiddenState x t) := hidden_succ N x t htDN
                                                have hrecF : Nf_pad.hiddenState x (t + 1) = (Nf_pad.hidden ⟨t, htF⟩).reluApply (Nf_pad.hiddenState x t) := by
                                                  simp [FullyConnectedReLUNet.hiddenState, htF]
                                                have hrecG : Ng_pad.hiddenState x (t + 1) = (Ng_pad.hidden ⟨t, htG⟩).reluApply (Ng_pad.hiddenState x t) := by
                                                  simp [FullyConnectedReLUNet.hiddenState, htG]
                                                have hlayer : N.hidden ⟨t, htDN⟩ = bd (Nf_pad.hidden ⟨t, htF⟩) (Ng_pad.hidden ⟨t, htG⟩) (zeroL Mul.width) := by
                                                  simp [N, htD1]
                                                constructor
                                                · intro a
                                                  rw [hrecN, hrecF, hlayer]
                                                  rw [bd_reluA (Nf_pad.hidden ⟨t, htF⟩) (Ng_pad.hidden ⟨t, htG⟩) (zeroL Mul.width) (N.hiddenState x t) a]
                                                  have hargA : (fun a' : Fin Nf_pad.width => N.hiddenState x t (toA a')) = Nf_pad.hiddenState x t := by
                                                    funext a'
                                                    exact ih'.1 a'
                                                  rw [hargA]
                                                · constructor
                                                  · intro b
                                                    rw [hrecN, hrecG, hlayer]
                                                    rw [bd_reluB (Nf_pad.hidden ⟨t, htF⟩) (Ng_pad.hidden ⟨t, htG⟩) (zeroL Mul.width) (N.hiddenState x t) b]
                                                    have hargB : (fun b' : Fin Ng_pad.width => N.hiddenState x t (toB b')) = Ng_pad.hiddenState x t := by
                                                      funext b'
                                                      exact ih'.2.1 b'
                                                    rw [hargB]
                                                  · intro c
                                                    rw [hrecN, hlayer]
                                                    rw [bd_reluC (Nf_pad.hidden ⟨t, htF⟩) (Ng_pad.hidden ⟨t, htG⟩) (zeroL Mul.width) (N.hiddenState x t) c]
                                                    have hz : (fun c' : Fin Mul.width => N.hiddenState x t (toC c')) = (fun _ : Fin Mul.width => 0) := by
                                                      funext c'
                                                      exact ih'.2.2 c'
                                                    rw [hz]
                                                    simp [DenseLayer.reluApply, DenseLayer.apply, zeroL, reluVec, relu]
                                          -- the two scalar inputs to Mul
                                          let z (x : Fin d → ℝ) : Fin 2 → ℝ := fun i => if i = 0 then Nf_pad.realize x else Ng_pad.realize x
                                          -- final hidden stage: block C of N's state at D is Mul's hidden state
                                          have hDstageC : ∀ (x : Fin d → ℝ) (c : Fin Mul.width),
                                              N.hiddenState x D (toC c) = Mul.hiddenState (z x) 0 c := by
                                            intro x c
                                            have hDminusN : D - 1 < (D + 1) - 1 := by omega
                                            have hDrec : D = (D - 1) + 1 := by omega
                                            rw [hDrec]
                                            have hrecN : N.hiddenState x ((D - 1) + 1) = (N.hidden ⟨D - 1, hDminusN⟩).reluApply (N.hiddenState x (D - 1)) := hidden_succ N x (D - 1) hDminusN
                                            rw [hrecN]
                                            have hnot : ¬ D - 1 < D - 1 := by omega
                                            have hlayer : N.hidden ⟨D - 1, hDminusN⟩ = mulL := by
                                              simp [N, hnot]
                                            rw [hlayer]
                                            have hD1 : D - 1 < D := by omega
                                            have hbA := (hblock x (D - 1) hD1).1
                                            have hbB := (hblock x (D - 1) hD1).2.1
                                            have hz0 : z x 0 = Nf_pad.realize x := by simp [z]
                                            have hz1 : z x 1 = Ng_pad.realize x := by norm_num [z]
                                            have hsumA : (∑ a : Fin Nf_pad.width, Nf_pad.outputWeight a * N.hiddenState x (D - 1) (toA a)) + Nf_pad.outputBias = Nf_pad.realize x := by
                                              calc
                                                (∑ a : Fin Nf_pad.width, Nf_pad.outputWeight a * N.hiddenState x (D - 1) (toA a)) + Nf_pad.outputBias
                                                    = (∑ a : Fin Nf_pad.width, Nf_pad.outputWeight a * Nf_pad.hiddenState x (D - 1) a) + Nf_pad.outputBias := by
                                                        apply congrArg (fun t : ℝ => t + Nf_pad.outputBias)
                                                        apply Finset.sum_congr rfl
                                                        intro a ha
                                                        rw [hbA a]
                                                _ = Nf_pad.realize x := by
                                                        simp [FullyConnectedReLUNet.realize, hNf_depth]
                                            have hsumB : (∑ b : Fin Ng_pad.width, Ng_pad.outputWeight b * N.hiddenState x (D - 1) (toB b)) + Ng_pad.outputBias = Ng_pad.realize x := by
                                              calc
                                                (∑ b : Fin Ng_pad.width, Ng_pad.outputWeight b * N.hiddenState x (D - 1) (toB b)) + Ng_pad.outputBias
                                                    = (∑ b : Fin Ng_pad.width, Ng_pad.outputWeight b * Ng_pad.hiddenState x (D - 1) b) + Ng_pad.outputBias := by
                                                        apply congrArg (fun t : ℝ => t + Ng_pad.outputBias)
                                                        apply Finset.sum_congr rfl
                                                        intro b hb
                                                        rw [hbB b]
                                                _ = Ng_pad.realize x := by
                                                        simp [FullyConnectedReLUNet.realize, hNg_depth]
                                            have hpre : mulL.apply (N.hiddenState x (D - 1)) (toC c) = Mul.input.apply (z x) c := by
                                              let v : Fin W → ℝ := N.hiddenState x (D - 1)
                                              have hsplit : mulL.apply v (toC c)
                                                  = (∑ a : Fin Nf_pad.width, Mul.input.weight c 0 * (Nf_pad.outputWeight a * v (toA a)))
                                                      + (∑ b : Fin Ng_pad.width, Mul.input.weight c 1 * (Ng_pad.outputWeight b * v (toB b)))
                                                      + (Mul.input.weight c 0 * Nf_pad.outputBias + Mul.input.weight c 1 * Ng_pad.outputBias + Mul.input.bias c) := by
                                                simp only [DenseLayer.apply]
                                                rw [sum_split (fun j : Fin W => mulL.weight (toC c) j * v j)]
                                                have hΦA : ∀ a : Fin Nf_pad.width, mulL.weight (toC c) (toA a) * v (toA a) = Mul.input.weight c 0 * (Nf_pad.outputWeight a * v (toA a)) := by
                                                  intro a
                                                  have hc1A : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                  have hc2A : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                  simp [mulL, toA, toB, toC, hc1A, hc2A, a.isLt]
                                                  ring
                                                have hΦB : ∀ b : Fin Ng_pad.width, mulL.weight (toC c) (toB b) * v (toB b) = Mul.input.weight c 1 * (Ng_pad.outputWeight b * v (toB b)) := by
                                                  intro b
                                                  have hc1B : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                  have hc2B : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                  have hb1B : ¬ Nf_pad.width + b.val < Nf_pad.width := by omega
                                                  have hb2B : Nf_pad.width + b.val < Nf_pad.width + Ng_pad.width := by omega
                                                  simp [mulL, toA, toB, toC, hc1B, hc2B, hb1B, hb2B]
                                                  ring
                                                have hΦC : ∀ c' : Fin Mul.width, mulL.weight (toC c) (toC c') * v (toC c') = 0 := by
                                                  intro c'
                                                  have hc1C : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                  have hc2C : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                  have hc3C : ¬ Nf_pad.width + Ng_pad.width + c'.val < Nf_pad.width := by omega
                                                  have hc4C : ¬ Nf_pad.width + Ng_pad.width + c'.val < Nf_pad.width + Ng_pad.width := by omega
                                                  simp [mulL, toA, toB, toC, hc1C, hc2C, hc3C, hc4C]
                                                have hbias : mulL.bias (toC c) = Mul.input.weight c 0 * Nf_pad.outputBias + Mul.input.weight c 1 * Ng_pad.outputBias + Mul.input.bias c := by
                                                  have hc1bias : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width := by omega
                                                  have hc2bias : ¬ Nf_pad.width + Ng_pad.width + c.val < Nf_pad.width + Ng_pad.width := by omega
                                                  simp [mulL, toA, toB, toC, hc1bias, hc2bias]
                                                rw [Finset.sum_congr rfl (fun a ha => hΦA a)]
                                                rw [Finset.sum_congr rfl (fun b hb => hΦB b)]
                                                rw [Finset.sum_congr rfl (fun c' hc => hΦC c')]
                                                rw [hbias]
                                                simp
                                              have hfactorA : (∑ a : Fin Nf_pad.width, Mul.input.weight c 0 * (Nf_pad.outputWeight a * v (toA a))) = Mul.input.weight c 0 * (∑ a : Fin Nf_pad.width, Nf_pad.outputWeight a * v (toA a)) := by
                                                rw [Finset.mul_sum]
                                              have hfactorB : (∑ b : Fin Ng_pad.width, Mul.input.weight c 1 * (Ng_pad.outputWeight b * v (toB b))) = Mul.input.weight c 1 * (∑ b : Fin Ng_pad.width, Ng_pad.outputWeight b * v (toB b)) := by
                                                rw [Finset.mul_sum]
                                              calc
                                                mulL.apply (N.hiddenState x (D - 1)) (toC c)
                                                    = mulL.apply v (toC c) := rfl
                                                _ = (∑ a : Fin Nf_pad.width, Mul.input.weight c 0 * (Nf_pad.outputWeight a * v (toA a)))
                                                      + (∑ b : Fin Ng_pad.width, Mul.input.weight c 1 * (Ng_pad.outputWeight b * v (toB b)))
                                                      + (Mul.input.weight c 0 * Nf_pad.outputBias + Mul.input.weight c 1 * Ng_pad.outputBias + Mul.input.bias c) := hsplit
                                                _ = Mul.input.weight c 0 * ((∑ a : Fin Nf_pad.width, Nf_pad.outputWeight a * v (toA a)) + Nf_pad.outputBias)
                                                      + Mul.input.weight c 1 * ((∑ b : Fin Ng_pad.width, Ng_pad.outputWeight b * v (toB b)) + Ng_pad.outputBias)
                                                      + Mul.input.bias c := by
                                                        rw [hfactorA, hfactorB]
                                                        ring
                                                _ = Mul.input.weight c 0 * Nf_pad.realize x + Mul.input.weight c 1 * Ng_pad.realize x + Mul.input.bias c := by
                                                        rw [hsumA, hsumB]
                                                _ = Mul.input.weight c 0 * (z x 0) + Mul.input.weight c 1 * (z x 1) + Mul.input.bias c := by
                                                        rw [hz0, hz1]
                                                _ = Mul.input.apply (z x) c := by
                                                        simp [DenseLayer.apply]
                                            have hM0 : Mul.hiddenState (z x) 0 c = Mul.input.reluApply (z x) c := by
                                              simp [FullyConnectedReLUNet.hiddenState]
                                            rw [hM0]
                                            simp only [DenseLayer.reluApply, reluVec]
                                            rw [hpre]
                                          -- output readout on the three blocks
                                          have hOA : ∀ (x : Fin d → ℝ) (a : Fin Nf_pad.width), N.outputWeight (toA a) * N.hiddenState x D (toA a) = 0 := by
                                            intro x a
                                            have ha : ¬ Nf_pad.width + Ng_pad.width ≤ a.val := by omega
                                            simp [N, toA, ha]
                                          have hOB : ∀ (x : Fin d → ℝ) (b : Fin Ng_pad.width), N.outputWeight (toB b) * N.hiddenState x D (toB b) = 0 := by
                                            intro x b
                                            have hb : ¬ Nf_pad.width + Ng_pad.width ≤ Nf_pad.width + b.val := by omega
                                            simp [N, toB, hb]
                                          have hOC : ∀ (x : Fin d → ℝ) (c : Fin Mul.width), N.outputWeight (toC c) * N.hiddenState x D (toC c) = Mul.outputWeight c * Mul.hiddenState (z x) 0 c := by
                                            intro x c
                                            have hc : Nf_pad.width + Ng_pad.width ≤ Nf_pad.width + Ng_pad.width + c.val := by omega
                                            rw [hDstageC x c]
                                            simp [N, toC, hc]
                                          -- the realization identity
                                          have hreal : ∀ x : Fin d → ℝ, N.realize x = Mul.realize (z x) := by
                                            intro x
                                            calc
                                              N.realize x = (∑ j : Fin W, N.outputWeight j * N.hiddenState x D j) + N.outputBias := by
                                                simp [FullyConnectedReLUNet.realize, N, W]
                                              _ = ((∑ a : Fin Nf_pad.width, N.outputWeight (toA a) * N.hiddenState x D (toA a))
                                                    + (∑ b : Fin Ng_pad.width, N.outputWeight (toB b) * N.hiddenState x D (toB b))
                                                    + (∑ c : Fin Mul.width, N.outputWeight (toC c) * N.hiddenState x D (toC c))) + N.outputBias := by
                                                rw [sum_split (fun j : Fin W => N.outputWeight j * N.hiddenState x D j)]
                                              _ = (0 + 0 + (∑ c : Fin Mul.width, Mul.outputWeight c * Mul.hiddenState (z x) 0 c)) + Mul.outputBias := by
                                                rw [Finset.sum_congr rfl (fun a ha => hOA x a)]
                                                rw [Finset.sum_congr rfl (fun b hb => hOB x b)]
                                                rw [Finset.sum_congr rfl (fun c hc => hOC x c)]
                                                simp [N]
                                              _ = (∑ c : Fin Mul.width, Mul.outputWeight c * Mul.hiddenState (z x) 0 c) + Mul.outputBias := by
                                                simp
                                              _ = Mul.realize (z x) := by
                                                simp [FullyConnectedReLUNet.realize, hMul_depth]
                                          -- shape constraints
                                          have hNdepth_pos : 0 < N.depth := by simp [N]
                                          have hNdepth_le : N.depth ≤ D + 1 := by simp [N]
                                          have hNwidth : N.width = Nf.width + Ng.width + 2 * n := by
                                            simp [N, W, hNf_width, hNg_width, hMul_width]
                                          have hNparam : N.parameterCount ≤ fullyConnectedReLUParameterCount d (D + 1) (Nf.width + Ng.width + 2 * n) := by
                                            simp [FullyConnectedReLUNet.parameterCount, N, W, hNf_width, hNg_width, hMul_width]
                                          exact ⟨N, hNdepth_pos, hNdepth_le, hNwidth, hNparam, hreal⟩
            -- @step s2: for every x with P x, combine the realization identity with h_mul's approximation bound, the padding equalities, the bounds hNf_bound/hNg_bound/hg_bound/hf_err/hg_err and the triangle-inequality product-error decomposition to prove the final error bound
            have h_s2 :
                ∃ N : FullyConnectedReLUNet d,
                  0 < N.depth ∧
                  N.depth ≤ D + 1 ∧
                  N.width = Nf.width + Ng.width + 2 * n ∧
                  N.parameterCount ≤
                    fullyConnectedReLUParameterCount d (D + 1)
                      (Nf.width + Ng.width + 2 * n) ∧
                  ∀ x : Fin d → ℝ, P x →
                    |N.realize x - f x * g x| ≤
                      2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
                        rcases h_s1 with ⟨N, hNdepth_pos, hNdepth_le, hNwidth, hNparam, hNreal⟩
                        refine ⟨N, hNdepth_pos, hNdepth_le, hNwidth, hNparam, ?_⟩
                        intro x hx
                        let Mul : FullyConnectedReLUNet 2 := Classical.choose h_mul
                        let Nf_pad : FullyConnectedReLUNet d := Classical.choose h_pad_f
                        let Ng_pad : FullyConnectedReLUNet d := Classical.choose h_pad_g
                        have hNf_pad_real : ∀ x : Fin d → ℝ, Nf_pad.realize x = Nf.realize x := by
                          simpa [Nf_pad] using (Classical.choose_spec h_pad_f).2.2.2
                        have hNg_pad_real : ∀ x : Fin d → ℝ, Ng_pad.realize x = Ng.realize x := by
                          simpa [Ng_pad] using (Classical.choose_spec h_pad_g).2.2.2
                        have hMul_err : ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R → |Mul.realize x - x 0 * x 1| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
                          simpa [Mul] using (Classical.choose_spec h_mul).2.2.2
                        let v : Fin 2 → ℝ := fun i => if i = 0 then Nf_pad.realize x else Ng_pad.realize x
                        have hNreal' : N.realize x = Mul.realize v := by
                          simpa [Mul, Nf_pad, Ng_pad, v] using hNreal x
                        have h1_ne_0 : (1 : Fin 2) ≠ 0 := by decide
                        have hv0 : v 0 = Nf.realize x := by
                          simp [v, hNf_pad_real x]
                        have hv1 : v 1 = Ng.realize x := by
                          simp [v, h1_ne_0, hNg_pad_real x]
                        have hv0_le : |v 0| ≤ R := by
                          rw [hv0]
                          exact hNf_bound x hx
                        have hv1_le : |v 1| ≤ R := by
                          rw [hv1]
                          exact hNg_bound x hx
                        have hfirst : |N.realize x - Nf.realize x * Ng.realize x| ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 := by
                          rw [hNreal']
                          rw [← hv0, ← hv1]
                          exact hMul_err v hv0_le hv1_le
                        have hprod_err : |Nf.realize x * Ng.realize x - f x * g x| ≤ R * ηg + R * ηf := by
                          have htri : |Nf.realize x * Ng.realize x - f x * g x| ≤ |Nf.realize x| * |Ng.realize x - g x| + |Nf.realize x - f x| * |g x| := by
                            calc
                              |Nf.realize x * Ng.realize x - f x * g x|
                                  = |Nf.realize x * (Ng.realize x - g x) + (Nf.realize x - f x) * g x| := by
                                      exact congrArg abs (by ring)
                              _ ≤ |Nf.realize x * (Ng.realize x - g x)| + |(Nf.realize x - f x) * g x| := by
                                        exact abs_add_le _ _
                              _ = |Nf.realize x| * |Ng.realize x - g x| + |Nf.realize x - f x| * |g x| := by
                                      rw [abs_mul, abs_mul]
                          have h1 : |Nf.realize x| * |Ng.realize x - g x| ≤ R * ηg :=
                            mul_le_mul (hNf_bound x hx) (hg_err x hx) (abs_nonneg _) (le_of_lt hR)
                          have h2 : |Nf.realize x - f x| * |g x| ≤ ηf * R :=
                            mul_le_mul (hf_err x hx) (hg_bound x hx) (abs_nonneg _) hηf
                          nlinarith [htri, h1, h2]
                        have htri2 : |N.realize x - f x * g x| ≤ |N.realize x - Nf.realize x * Ng.realize x| + |Nf.realize x * Ng.realize x - f x * g x| := by
                          calc
                            |N.realize x - f x * g x|
                                = |(N.realize x - Nf.realize x * Ng.realize x) + (Nf.realize x * Ng.realize x - f x * g x)| := by
                                    exact congrArg abs (by ring)
                            _ ≤ |N.realize x - Nf.realize x * Ng.realize x| + |Nf.realize x * Ng.realize x - f x * g x| := by
                                    exact abs_add_le _ _
                        calc
                          |N.realize x - f x * g x| ≤
                              |N.realize x - Nf.realize x * Ng.realize x| + |Nf.realize x * Ng.realize x - f x * g x| := htri2
                          _ ≤ 2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηg + R * ηf := by
                              rw [add_assoc]
                              exact add_le_add hfirst hprod_err
            exact h_s2
  exact h_final

theorem finite_linear_combination_same_depth_reluNetworkClass_approximation_bound
    {ι : Type*} [DecidableEq ι] {d D widthBudget parameterBudget : ℕ}
    {P : (Fin d → ℝ) → Prop}
    (hD : 0 < D)
    (s : Finset ι) (coeff : ι → ℝ)
    (f : ι → (Fin d → ℝ) → ℝ) (ε : ι → ℝ)
    (A : ι → FullyConnectedReLUNet d)
    (hε : ∀ r : ι, r ∈ s → 0 ≤ ε r)
    (hdepth : ∀ r : ι, r ∈ s → (A r).depth = D)
    (hwidthBudget : (∑ r ∈ s, (A r).width) ≤ widthBudget)
    (hparameterBudget :
      fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ≤ parameterBudget)
    (herr : ∀ r : ι, r ∈ s → ∀ x : Fin d → ℝ, P x →
      |(A r).realize x - f r x| ≤ ε r) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d D widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ, P x →
        |g x - finiteLinearCombination s coeff f x| ≤ ∑ r ∈ s, |coeff r| * ε r := by
  rcases exists_fullyConnectedReLUNet_finite_linear_combination_same_depth_approx hD s coeff f ε A hε hdepth herr with
    ⟨N, hNdepth, hNdepthPos, hNwidth, hNparam, _, hNerr⟩
  refine ⟨N.realize, ?_, ?_⟩
  · unfold reluNetworkClass
    refine ⟨N, hNdepthPos, ?_, ?_, ?_, ?_⟩
    · simpa [hNdepth]
    · simpa [hNwidth] using hwidthBudget
    · exact le_trans hNparam hparameterBudget
    · intro x
      rfl
  · intro x hPx
    exact hNerr x hPx

theorem axisAlignedBoxTentWeight_partition_pointwise_approximation_error_bound
    {d m : ℕ} (center scale : Fin m → Fin d → ℝ)
    (approx : Fin m → (Fin d → ℝ) → ℝ)
    (target : (Fin d → ℝ) → ℝ) (eps : ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |approx j x - target x| ≤ eps) :
    ∀ x : Fin d → ℝ,
      |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * approx j x) - target x| ≤ eps := by
  refine Statlib.Nonparametric.Approximation.Sieve.partition_of_unity_weighted_function_pointwise_approximation_error_bound
    (X := Fin d → ℝ) (m := m)
    (weight := fun j x => axisAlignedBoxTentWeight (center j) (scale j) x)
    (approx := approx) (target := target) (eps := eps) ?_ ?_ ?_
  · intro j x
    exact (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1
  · intro x
    exact hpartition x
  · intro j x hw
    apply hlocal j x
    intro q
    by_contra hnot
    have hge : 1 ≤ scale j q * (relu (x q - center j q) + relu (center j q - x q)) := not_lt.mp hnot
    have hzero : axisAlignedBoxTentWeight (center j) (scale j) x = 0 :=
      (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).2.2 ⟨q, hge⟩
    exact hw hzero


theorem exists_reluNetworkClass_axisAlignedBoxTentWeight_approx_with_size_bound
    {d n depthBudget widthBudget parameterBudget : ℕ}
    (hn : 0 < n) {R η : ℝ}
    (hR : 1 < R) (hη_nonneg : 0 ≤ η)
    (hstepError : (∑ k ∈ Finset.range d, R ^ k) * (2 * R ^ 2 / (n : ℝ) ^ 2) ≤ η)
    (hη_bound : η ≤ R - 1)
    (center scale : Fin d → ℝ)
    (hscale : ∀ q : Fin d, 0 ≤ scale q)
    (hdepthBudget : 2 + d ≤ depthBudget)
    (hwidthBudget : d * (2 + 2 * n) ≤ widthBudget)
    (hparameterBudget : fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * n)) ≤ parameterBudget) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ, |g x - axisAlignedBoxTentWeight center scale x| ≤ η := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: induction over k ≤ d: for every prefix of the coordinate product, a fully connected
  --   ReLU network N approximates ∏_{q<k} coordinateTentReLUFunction q (center q) (scale q) x with
  --   error (∑ j∈Finset.range k, R^j)*(2*R^2/n^2), depth ≤ 2+k, width ≤ k*(2+2*n), and
  --   parameterCount ≤ fullyConnectedReLUParameterCount d (2+k) (k*(2+2*n))
  have h_prefix :
      ∀ k : ℕ, ∀ hk : k ≤ d,
        ∃ N : FullyConnectedReLUNet d,
          0 < N.depth ∧ N.depth ≤ 2 + k ∧
          N.width ≤ k * (2 + 2 * n) ∧
          N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + k) (k * (2 + 2 * n)) ∧
          ∀ x : Fin d → ℝ,
            |N.realize x - (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x)| ≤
                        (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
              -- @step s1: base case k=0: constant-1 network via E12/E13, zero error, all size bounds
              have h_s1 :
                  ∃ N : FullyConnectedReLUNet d,
                    0 < N.depth ∧ N.depth ≤ 2 + 0 ∧
                    N.width ≤ 0 * (2 + 2 * n) ∧
                    N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + 0) (0 * (2 + 2 * n)) ∧
                    ∀ x : Fin d → ℝ,
                      |N.realize x - (∏ q : Fin 0, coordinateTentReLUFunction (Fin.castLE (Nat.zero_le d) q) (center (Fin.castLE (Nat.zero_le d) q)) (scale (Fin.castLE (Nat.zero_le d) q)) x)| ≤
                        (∑ j ∈ Finset.range 0, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                          let N : FullyConnectedReLUNet d :=
                            { depth := 1,
                              width := 0,
                              input := { weight := fun _ _ => 0, bias := fun _ => 0 },
                              hidden := fun _ => { weight := fun _ _ => 0, bias := fun _ => 0 },
                              outputWeight := fun _ => 0,
                              outputBias := 1 }
                          refine ⟨N, ?_d0, ?_d1, ?_w, ?_p, ?_err⟩
                          · norm_num
                          · norm_num
                          · norm_num
                          · norm_num [fullyConnectedReLUParameterCount, FullyConnectedReLUNet.parameterCount]
                          · intro x
                            norm_num [FullyConnectedReLUNet.realize, Finset.range_zero]
              -- @step s2: successor step: from the k-instance apply E5 with coordinateTentReLUNet k to build the (k+1)-instance
              have h_s2 : ∀ k : ℕ, ∀ hk : k + 1 ≤ d,
                  (∃ N : FullyConnectedReLUNet d,
                    0 < N.depth ∧ N.depth ≤ 2 + k ∧
                    N.width ≤ k * (2 + 2 * n) ∧
