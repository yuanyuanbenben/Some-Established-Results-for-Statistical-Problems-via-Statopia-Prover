                                                     intro k hk Nk Ng hpremises; have hbounds := hs2_s1 k hk Nk Ng hpremises; rcases hbounds with ⟨hNk_bnd, hNg_bnd, hg_bnd⟩; rcases hpremises with ⟨hNk_dep, hNk_deple, hNk_w, hNk_pc, hNk_err, hNg_dep, hNg_deple, hNg_w, hNg_err⟩; have hR0 : 0 < R := lt_trans zero_lt_one hR; have hDpos : 0 < 2 + k := (by omega); have hηf_nonneg : 0 ≤ (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := mul_nonneg (Finset.sum_nonneg (fun j hj => pow_nonneg (le_of_lt hR0) j)) (div_nonneg (mul_nonneg (by norm_num : 0 ≤ (2 : ℝ)) (sq_nonneg R)) (sq_nonneg (n : ℝ))); rcases (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_fullyConnectedReLUNet_product_approx_on_box_with_size_bound (D := 2 + k) (n := n) hDpos hn (R := R) (ηf := (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2)) (ηg := 0) hR0 hηf_nonneg (by simp) (P := fun _ => True) (f := fun x : Fin d → ℝ => ∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q) (center (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) (scale (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) x) (g := fun x : Fin d → ℝ => coordinateTentReLUFunction (Fin.castLE hk (Fin.last k)) (center (Fin.castLE hk (Fin.last k))) (scale (Fin.castLE hk (Fin.last k))) x) Nk Ng hNk_dep hNg_dep hNk_deple hNg_deple (fun x _ => hNk_bnd x) (fun x _ => hNg_bnd x) (fun x _ => hg_bnd x) (fun x _ => hNk_err x) (fun x _ => hNg_err x)) with ⟨N, hNdep, hNdeple, hNw, hNpc, hNerr⟩; exact ⟨N, hNdep, by simpa [Nat.add_assoc] using hNdeple, hNw, by simpa [Nat.add_assoc] using hNpc, fun x => by have hx := hNerr x trivial; simpa [mul_assoc] using hx⟩
                                      exact hs2_s2
                          -- @step s3: combine the E5 conclusion with the size/algebra rewrites to obtain the
                          --   Fin(k+1)-prefix network with the declared depth/width/parameter/error bounds
                          have hs3 : ∀ k : ℕ, ∀ hk : k + 1 ≤ d,
                              (∃ N : FullyConnectedReLUNet d,
                                0 < N.depth ∧ N.depth ≤ 2 + k ∧
                                N.width ≤ k * (2 + 2 * n) ∧
                                N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + k) (k * (2 + 2 * n)) ∧
                                ∀ x : Fin d → ℝ,
                                  |N.realize x - (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q) (center (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) (scale (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) x)| ≤
                                    (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2)) →
                              ∃ N : FullyConnectedReLUNet d,
                                0 < N.depth ∧ N.depth ≤ 2 + (k + 1) ∧
                                N.width ≤ (k + 1) * (2 + 2 * n) ∧
                                N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + (k + 1)) ((k + 1) * (2 + 2 * n)) ∧
                                ∀ x : Fin d → ℝ,
                                  |N.realize x - (∏ q : Fin (k + 1), coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x)| ≤
                                    (∑ j ∈ Finset.range (k + 1), R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                                            intro k hk hprem
                                            -- @step s1: destruct the induction-hypothesis premise into Nk (Fin k-prefix net) and Ng (last-coordinate tent net) with their bounds
                                            have hs3_s1 : ∃ Nk Ng : FullyConnectedReLUNet d,
                                                0 < Nk.depth ∧ Nk.depth ≤ 2 + k ∧
                                                Nk.width ≤ k * (2 + 2 * n) ∧
                                                Nk.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + k) (k * (2 + 2 * n)) ∧
                                                (∀ x : Fin d → ℝ,
                                                  |Nk.realize x - (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q) (center (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) (scale (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) x)| ≤
                                                    (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2)) ∧
                                                0 < Ng.depth ∧ Ng.depth ≤ 2 + k ∧ Ng.width = 2 ∧
                                                (∀ x : Fin d → ℝ,
                                                  |Ng.realize x - coordinateTentReLUFunction (Fin.castLE hk (Fin.last k)) (center (Fin.castLE hk (Fin.last k))) (scale (Fin.castLE hk (Fin.last k))) x| ≤ 0) := by
                                                    rcases hprem with ⟨Nk, hNk_dep, hNk_deple, hNk_w, hNk_pc, hNk_err⟩
                                                    refine ⟨Nk, coordinateTentReLUNet (Fin.castLE hk (Fin.last k)) (center (Fin.castLE hk (Fin.last k))) (scale (Fin.castLE hk (Fin.last k))), hNk_dep, hNk_deple, hNk_w, hNk_pc, hNk_err, ?_, ?_, ?_, ?_⟩
                                                    · norm_num [coordinateTentReLUNet]
                                                    · dsimp [coordinateTentReLUNet]
                                                      omega
                                                    · norm_num [coordinateTentReLUNet]
                                                    · intro x
                                                      rw [coordinateTentReLUNet_realize]
                                                      simp
                                            rcases hs3_s1 with ⟨Nk, Ng, hNk_dep, hNk_deple, hNk_w, hNk_pc, hNk_err, hNg_dep, hNg_deple, hNg_w, hNg_err⟩
                                            -- @step s2: apply hs2 to Nk Ng to obtain N with the E5 depth/width/parameter/error bounds
                                            have hs3_s2 : ∃ N : FullyConnectedReLUNet d,
                                                0 < N.depth ∧ N.depth ≤ 2 + (k + 1) ∧
                                                N.width = Nk.width + Ng.width + 2 * n ∧
                                                N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + (k + 1)) (Nk.width + Ng.width + 2 * n) ∧
                                                (∀ x : Fin d → ℝ,
                                                  |N.realize x - (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q) (center (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) (scale (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) x) * coordinateTentReLUFunction (Fin.castLE hk (Fin.last k)) (center (Fin.castLE hk (Fin.last k))) (scale (Fin.castLE hk (Fin.last k))) x| ≤
                                                    (2 * R ^ 2 / (n : ℝ) ^ 2) + R * (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2)) := by
                                                      exact hs2 k hk Nk Ng ⟨hNk_dep, hNk_deple, hNk_w, hNk_pc, hNk_err, hNg_dep, hNg_deple, hNg_w, hNg_err⟩
                                            rcases hs3_s2 with ⟨N, hNdep, hNdeple, hNw, hNpc, hNerr⟩
                                            -- @step s3: prove the width and parameter-count size bounds for N
                                            have hs3_s3 : N.width ≤ (k + 1) * (2 + 2 * n) ∧ N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + (k + 1)) ((k + 1) * (2 + 2 * n)) := by
                                              constructor
                                              · rw [hNw, hNg_w]
                                                nlinarith [hNk_w]
                                              ·
                                                rw [hNg_w] at hNpc
                                                refine le_trans hNpc ?_
                                                have hw : Nk.width + 2 + 2 * n ≤ (k + 1) * (2 + 2 * n) := by nlinarith [hNk_w]
                                                have hD : 2 + (k + 1) - 1 = k + 2 := by omega
                                                unfold fullyConnectedReLUParameterCount
                                                rw [hD]
                                                have h1 : (d + 1) * (Nk.width + 2 + 2 * n) ≤ (d + 1) * ((k + 1) * (2 + 2 * n)) := by
                                                  exact Nat.mul_le_mul_left (d + 1) hw
                                                have h2a : Nk.width + 2 + 2 * n + 1 ≤ (k + 1) * (2 + 2 * n) + 1 := by
                                                  omega
                                                have h2b1 : (Nk.width + 2 + 2 * n + 1) * (Nk.width + 2 + 2 * n) ≤
                                                    (Nk.width + 2 + 2 * n + 1) * ((k + 1) * (2 + 2 * n)) := by
                                                  exact Nat.mul_le_mul_left (Nk.width + 2 + 2 * n + 1) hw
                                                have h2b2 : (Nk.width + 2 + 2 * n + 1) * ((k + 1) * (2 + 2 * n)) ≤
                                                    ((k + 1) * (2 + 2 * n) + 1) * ((k + 1) * (2 + 2 * n)) := by
                                                  exact Nat.mul_le_mul_right ((k + 1) * (2 + 2 * n)) h2a
                                                have h2b : (Nk.width + 2 + 2 * n + 1) * (Nk.width + 2 + 2 * n) ≤
                                                    ((k + 1) * (2 + 2 * n) + 1) * ((k + 1) * (2 + 2 * n)) := by
                                                  exact le_trans h2b1 h2b2
                                                have h2 : (k + 2) * ((Nk.width + 2 + 2 * n + 1) * (Nk.width + 2 + 2 * n)) ≤
                                                    (k + 2) * (((k + 1) * (2 + 2 * n) + 1) * ((k + 1) * (2 + 2 * n))) := by
                                                  exact Nat.mul_le_mul_left (k + 2) h2b
                                                nlinarith only [h1, h2, h2a]
                                            -- @step s4: prove the final Fin(k+1)-prefix error bound for N
                                            have hs3_s4 : ∀ x : Fin d → ℝ, |N.realize x - (∏ q : Fin (k + 1), coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x)| ≤ (∑ j ∈ Finset.range (k + 1), R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                                              -- @step s1: for every x, split the Fin (k+1) product at the last coordinate into the k-prefix product (as in hNerr) times the last-coordinate tent factor
                                              have h_prod_split : ∀ x : Fin d → ℝ,
                                                  (∏ q : Fin (k + 1), coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x) =
                                                  (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q) (center (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) (scale (Fin.castLE (Nat.le_trans (Nat.le_succ k) hk) q)) x) *
                                                    coordinateTentReLUFunction (Fin.castLE hk (Fin.last k)) (center (Fin.castLE hk (Fin.last k))) (scale (Fin.castLE hk (Fin.last k))) x := by
                                                      intro x
                                                      rw [Fin.prod_univ_succAbove (x := Fin.last k)]
                                                      rw [Fin.succAbove_last]
                                                      rw [mul_comm]
                                                      rfl
                                              -- @step s2: prove the finite-sum budget identity C + R * S_k * C = S_{k+1} * C with C = 2*R^2/(n:ℝ)^2
                                              have h_budget : (2 * R ^ 2 / (n : ℝ) ^ 2) + (R * (∑ j ∈ Finset.range k, R ^ j)) * (2 * R ^ 2 / (n : ℝ) ^ 2) =
                                                  (∑ j ∈ Finset.range (k + 1), R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                                                      have hgeo : ∀ k : ℕ, 1 + R * (∑ j ∈ Finset.range k, R ^ j) = (∑ j ∈ Finset.range (k + 1), R ^ j) := by
                                                        intro k
                                                        induction k with
                                                        | zero =>
                                                            simp [Finset.sum_range_one]
                                                        | succ k ih =>
                                                            have ih' : 1 + R * (∑ j ∈ Finset.range k, R ^ j) = (∑ j ∈ Finset.range k, R ^ j) + R ^ k := by
                                                              simpa [Finset.sum_range_succ] using ih
                                                            rw [Finset.sum_range_succ]
                                                            rw [Finset.sum_range_succ]
                                                            rw [Finset.sum_range_succ]
                                                            rw [mul_add]
                                                            rw [← add_assoc]
                                                            rw [ih']
                                                            rw [pow_succ]
                                                            ring
                                                      rw [← hgeo k]
                                                      ring
                                              -- @step s3: for each x, rewrite the error expression with h_prod_split, apply hNerr x, and convert the budget via h_budget
                                              have h_err : ∀ x : Fin d → ℝ, |N.realize x - (∏ q : Fin (k + 1), coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x)| ≤ (∑ j ∈ Finset.range (k + 1), R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                                                intro x
                                                rw [h_prod_split x]
                                                exact le_trans (hNerr x) (le_of_eq h_budget)
                                              exact h_err
                                            exact ⟨N, hNdep, hNdeple, hs3_s3.1, hs3_s3.2, hs3_s4⟩
                          exact hs3
              -- @step s3: assemble the base case and the successor step by induction over k ≤ d (Nat.le_induction)
              have h_s3 : ∀ k : ℕ, ∀ hk : k ≤ d,
                  ∃ N : FullyConnectedReLUNet d,
                    0 < N.depth ∧ N.depth ≤ 2 + k ∧
                    N.width ≤ k * (2 + 2 * n) ∧
                    N.parameterCount ≤ fullyConnectedReLUParameterCount d (2 + k) (k * (2 + 2 * n)) ∧
                    ∀ x : Fin d → ℝ,
                      |N.realize x - (∏ q : Fin k, coordinateTentReLUFunction (Fin.castLE hk q) (center (Fin.castLE hk q)) (scale (Fin.castLE hk q)) x)| ≤
                        (∑ j ∈ Finset.range k, R ^ j) * (2 * R ^ 2 / (n : ℝ) ^ 2) := by
                          intro k
                          induction k with
                          | zero =>
                              intro hk
                              -- h_s1 states the k=0 case with the proof Nat.zero_le d; the goal has an
                              -- arbitrary hk : 0 ≤ d.  Both are proofs of the same proposition, so they
                              -- are equal by proof irrelevance, and the Fin 0 products coincide.
                              have hk_eq : hk = Nat.zero_le d := Subsingleton.elim hk (Nat.zero_le d)
                              simpa [hk_eq] using h_s1
                          | succ k ih =>
                              intro hk
                              exact h_s2 k hk (ih (Nat.le_trans (Nat.le_succ k) hk))
              exact h_s3
  -- @step s2: instantiate the prefix construction at k = d, identify the final product with
  --   axisAlignedBoxTentWeight center scale x via E1, and combine depth/width/parameter/error bounds
  --   with the declared budgets to produce g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget
  have h_final : ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
        ∀ x : Fin d → ℝ, |g x - axisAlignedBoxTentWeight center scale x| ≤ η := by
      rcases h_prefix d (Nat.le_refl d) with ⟨N, hNpos, hNdepth, hNwidth, hNpc, hNerr⟩
      refine ⟨N.realize, ?_, ?_⟩
      · -- membership: the network N itself is the witness inside reluNetworkClass; chain the
        -- prefix size bounds with the declared budgets.
        simp [reluNetworkClass]
        refine ⟨N, hNpos, le_trans hNdepth hdepthBudget, le_trans hNwidth hwidthBudget,
          le_trans hNpc hparameterBudget, ?_⟩
        intro x
        rfl
      · -- error: at k = d, Fin.castLE (Nat.le_refl d) is the identity, so the prefix product is
        -- exactly axisAlignedBoxTentWeight; then chain with hstepError.
        intro x
        have hcast : ∀ q : Fin d, Fin.castLE (Nat.le_refl d) q = q := by
          intro q
          exact Fin.ext rfl
        exact le_trans (by simpa [axisAlignedBoxTentWeight, hcast] using hNerr x) hstepError
  -- @step fin
  exact h_final


theorem exists_reluNetworkClass_weighted_local_product_approx_with_size_bound
    {d D n depthBudget widthBudget parameterBudget : ℕ}
    (hD : 0 < D) (hn : 0 < n) {R ηw ηa : ℝ}
    (hR : 0 < R) (hηw : 0 ≤ ηw) (hηa : 0 ≤ ηa)
    {P : (Fin d → ℝ) → Prop}
    {weight local_ : (Fin d → ℝ) → ℝ}
    (Nweight Nlocal : FullyConnectedReLUNet d)
    (hNweight_depth_pos : 0 < Nweight.depth)
    (hNlocal_depth_pos : 0 < Nlocal.depth)
    (hNweight_depth : Nweight.depth ≤ D)
    (hNlocal_depth : Nlocal.depth ≤ D)
    (hNweight_bound : ∀ x : Fin d → ℝ, P x → |Nweight.realize x| ≤ R)
    (hNlocal_bound : ∀ x : Fin d → ℝ, P x → |Nlocal.realize x| ≤ R)
    (hlocal_bound : ∀ x : Fin d → ℝ, P x → |local_ x| ≤ R)
    (hweight_err : ∀ x : Fin d → ℝ, P x → |Nweight.realize x - weight x| ≤ ηw)
    (hlocal_err : ∀ x : Fin d → ℝ, P x → |Nlocal.realize x - local_ x| ≤ ηa)
    (hdepthBudget : D + 1 ≤ depthBudget)
    (hwidthBudget : Nweight.width + Nlocal.width + 2 * n ≤ widthBudget)
    (hparameterBudget :
        fullyConnectedReLUParameterCount d (D + 1)
          (Nweight.width + Nlocal.width + 2 * n) ≤ parameterBudget)
    :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ, P x →
        |g x - weight x * local_ x| ≤
          2 * R ^ 2 / (n : ℝ) ^ 2 + R * ηa + R * ηw := by
  rcases exists_fullyConnectedReLUNet_product_approx_on_box_with_size_bound
      (ηf := ηw) (ηg := ηa) (f := weight) (g := local_) hD hn hR hηw hηa
      Nweight Nlocal hNweight_depth_pos hNlocal_depth_pos hNweight_depth hNlocal_depth
      hNweight_bound hNlocal_bound hlocal_bound hweight_err hlocal_err with
      ⟨N, hNpos, hNdepth, hNwidth, hNparam, hNerr⟩
  refine ⟨N.realize, ?_, ?_⟩
  · simp [reluNetworkClass]
    refine ⟨N, hNpos, hNdepth.trans hdepthBudget, ?_, hNparam.trans hparameterBudget, ?_⟩
    · rw [hNwidth]
      exact hwidthBudget
    · intro x
      rfl
  · simpa using hNerr


theorem finite_axisAligned_tent_weighted_local_reluNetworkClass_global_error_bound
    {d m D widthBudget parameterBudget : ℕ}
    (hD : 0 < D)
    (center scale : Fin m → Fin d → ℝ)
    (loc : Fin m → (Fin d → ℝ) → ℝ)
    (target : (Fin d → ℝ) → ℝ)
    (A : Fin m → FullyConnectedReLUNet d)
    (δ : Fin m → ℝ) (eps : ℝ)
    (hδ : ∀ j : Fin m, 0 ≤ δ j)
    (hdepth : ∀ j : Fin m, (A j).depth = D)
    (hwidthBudget : (∑ j : Fin m, (A j).width) ≤ widthBudget)
    (hparameterBudget :
      fullyConnectedReLUParameterCount d D (∑ j : Fin m, (A j).width) ≤ parameterBudget)
    (hprodErr : ∀ j : Fin m, ∀ x : Fin d → ℝ,
      |(A j).realize x -
        axisAlignedBoxTentWeight (center j) (scale j) x * loc j x| ≤ δ j)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |loc j x - target x| ≤ eps) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d D widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ,
        |g x - target x| ≤ (∑ j : Fin m, δ j) + eps := by
  obtain ⟨g, hg_class, hg_bound⟩ :=
    finite_linear_combination_same_depth_reluNetworkClass_approximation_bound
      (ι := Fin m) (d := d) (D := D) (widthBudget := widthBudget)
      (parameterBudget := parameterBudget) (P := fun _ => True) hD
      (s := Finset.univ) (coeff := fun _ => (1 : ℝ))
      (f := fun j x => axisAlignedBoxTentWeight (center j) (scale j) x * loc j x)
      (ε := δ) (A := A)
      (by intro r hr; exact hδ r)
      (by intro r hr; exact hdepth r)
      hwidthBudget
      hparameterBudget
      (by intro r hr x hP; exact hprodErr r x)
  let S : (Fin d → ℝ) → ℝ := fun x =>
    ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * loc j x
  refine ⟨g, hg_class, ?_⟩
  intro x
  have hnet : |g x - S x| ≤ ∑ j : Fin m, δ j := by
    simpa [S, finiteLinearCombination] using hg_bound x trivial
  have hpart : |S x - target x| ≤ eps := by
    simpa [S] using
      (axisAlignedBoxTentWeight_partition_pointwise_approximation_error_bound center scale loc target eps
        hscale hpartition hlocal x)
  calc
    |g x - target x| = |(g x - S x) + (S x - target x)| := by
      rw [← sub_add_sub_cancel]
    _ ≤ |g x - S x| + |S x - target x| := abs_add_le _ _
    _ ≤ (∑ j : Fin m, δ j) + eps := add_le_add hnet hpart


theorem finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
    {ι : Type*} [DecidableEq ι] {d D widthBudget parameterBudget : ℕ}
    {P : (Fin d → ℝ) → Prop}
    (hD : 0 < D)

    (s : Finset ι) (coeff : ι → ℝ)
    (target approx : ι → (Fin d → ℝ) → ℝ)
    (ε : ι → ℝ) (widthOf parameterOf : ι → ℕ)
    (hε : ∀ r : ι, r ∈ s → 0 ≤ ε r)
    (hclass : ∀ r : ι, r ∈ s →
      approx r ∈ reluNetworkClass d D (widthOf r) (parameterOf r))
    (hwidthBudget : (∑ r ∈ s, widthOf r) ≤ widthBudget)
    (hparameterBudget :
      fullyConnectedReLUParameterCount d D (∑ r ∈ s, widthOf r) ≤
        parameterBudget)
    (herr : ∀ r : ι, r ∈ s → ∀ x : Fin d → ℝ, P x →
      |approx r x - target r x| ≤ ε r) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d D widthBudget parameterBudget ∧
      ∀ x : Fin d → ℝ, P x →
        |g x - finiteLinearCombination s coeff target x| ≤
          ∑ r ∈ s, |coeff r| * ε r := by
  -- @step s1: from hclass, extract for each active r a depth-D identity-padded FullyConnectedReLUNet witness:
  -- depth = D, width ≤ widthOf r, realization still equals approx r on active r, and the width sum fits the budget
  have hA : ∃ A : ι → FullyConnectedReLUNet d,
      (∀ r : ι, r ∈ s → (A r).depth = D) ∧
      (∀ r : ι, r ∈ s → (A r).width ≤ widthOf r) ∧
      (∀ r : ι, r ∈ s → ∀ x : Fin d → ℝ, (A r).realize x = approx r x) ∧
      (∑ r ∈ s, (A r).width) ≤ widthBudget := by
        let idLayer : ∀ {w : ℕ}, DenseLayer w w := fun {w} =>
          ⟨fun i j => if i = j then 1 else 0, fun _ => 0⟩
        have hrelu_nonneg : ∀ {m n : ℕ} (L : DenseLayer m n) (z : Fin m → ℝ) (i : Fin n),
            0 ≤ L.reluApply z i := by
          intro m n L z i
          simp [DenseLayer.reluApply, reluVec, relu]
        have hid_id : ∀ {w : ℕ} (z : Fin w → ℝ), (∀ i : Fin w, 0 ≤ z i) → idLayer.reluApply z = z := by
          intro w z hz
          funext i
          have hsum : (∑ j : Fin w, (if i = j then 1 else 0) * z j) = z i := by
            calc
              (∑ j : Fin w, (if i = j then 1 else 0) * z j)
                  = ∑ j : Fin w, (if j = i then z j else 0) := by
                      refine Finset.sum_congr rfl ?_
                      intro j hj
                      by_cases h : i = j
                      · simp [h]
                      · have hji : j ≠ i := fun hji => h hji.symm
                        simp [h, hji]
              _ = z i := by simp
          simp only [idLayer, DenseLayer.reluApply, reluVec, DenseLayer.apply, relu]
          rw [hsum]
          simp only [zero_add, add_zero]
          exact max_eq_left (hz i)
        have hstate_zero : ∀ (M : FullyConnectedReLUNet d) (x : Fin d → ℝ),
            FullyConnectedReLUNet.hiddenState M x 0 = M.input.reluApply x := by
          intro M x
          rfl
        have hstate_succ : ∀ (M : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ),
            FullyConnectedReLUNet.hiddenState M x t.succ =
              (if ht : t < M.depth - 1 then
                (M.hidden ⟨t, ht⟩).reluApply (FullyConnectedReLUNet.hiddenState M x t)
              else FullyConnectedReLUNet.hiddenState M x t) := by
          intro M x t
          rfl
        have hstate_nonneg : ∀ (M : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ) (i : Fin M.width),
            0 ≤ FullyConnectedReLUNet.hiddenState M x t i := by
          intro M x t
          induction t with
          | zero =>
            intro i
            rw [hstate_zero M x]
            exact hrelu_nonneg M.input x i
          | succ t ih =>
            intro i
            by_cases ht : t < M.depth - 1
            · rw [hstate_succ M x t]
              simp [ht]
              exact hrelu_nonneg (M.hidden ⟨t, ht⟩) (FullyConnectedReLUNet.hiddenState M x t) i
            · rw [hstate_succ M x t]
              simp [ht]
              exact ih i
        have hpad : ∀ (N : FullyConnectedReLUNet d), 0 < N.depth → N.depth ≤ D →
            ∃ N' : FullyConnectedReLUNet d, N'.depth = D ∧ N'.width = N.width ∧
              ∀ x : Fin d → ℝ, N'.realize x = N.realize x := by
          intro N hpos hle
          let m := N.depth - 1
          let N' : FullyConnectedReLUNet d := {
            depth := D
            width := N.width
            input := N.input
            hidden := fun i : Fin (D - 1) =>
              if hi : i.1 < m then N.hidden ⟨i.1, hi⟩ else idLayer
            outputWeight := N.outputWeight
            outputBias := N.outputBias }
          refine ⟨N', rfl, rfl, ?_⟩
          intro x
          have hmle : m ≤ D - 1 := by dsimp [m]; omega
          have hstate_a : ∀ t : ℕ, t ≤ m →
              FullyConnectedReLUNet.hiddenState N' x t = FullyConnectedReLUNet.hiddenState N x t := by
            intro t
            induction t with
            | zero =>
              intro _
              simp [hstate_zero N' x, hstate_zero N x, N']
            | succ t ih =>
              intro ht
              have htm : t < m := Nat.lt_of_succ_le ht
              have htmD : t < D - 1 := lt_of_lt_of_le htm hmle
              rw [hstate_succ N' x t, hstate_succ N x t]
              have htmD' : t < N'.depth - 1 := by simpa [N'] using htmD
              have htmN : t < N.depth - 1 := by simpa [m] using htm
              rw [dif_pos htmD', dif_pos htmN]
              have hlayer : N'.hidden ⟨t, htmD'⟩ = N.hidden ⟨t, htmN⟩ := by
                change (if hi : (⟨t, htmD'⟩ : Fin (D - 1)).val < m then
                          N.hidden ⟨(⟨t, htmD'⟩ : Fin (D - 1)).val, hi⟩ else idLayer) = N.hidden ⟨t, htmN⟩
                rw [dif_pos (by simpa using htm)]

              rw [hlayer, ih (Nat.le_of_lt htm)]
          have hstate_b : ∀ t : ℕ, m ≤ t → t ≤ D - 1 →
              FullyConnectedReLUNet.hiddenState N' x t = FullyConnectedReLUNet.hiddenState N' x m := by
            intro t
            induction t with
            | zero =>
              intro hmt htm
              have hm0 : m = 0 := by omega
              simp [hstate_zero N' x, hm0]
            | succ t ih =>
              intro hmt htm
              have htm_lt : t < D - 1 := Nat.lt_of_succ_le htm
              by_cases ht_m : t < m
              · have htm_eq : t + 1 = m := by omega
                rw [← htm_eq, ← Nat.succ_eq_add_one]
              · have hmt' : m ≤ t := le_of_not_gt ht_m
                rw [hstate_succ N' x t]
                simp [N', htm_lt, ht_m]
                rw [hid_id (FullyConnectedReLUNet.hiddenState N' x t) (hstate_nonneg N' x t)]
                exact ih hmt' (Nat.le_trans (Nat.le_succ t) htm)
          have hstate : FullyConnectedReLUNet.hiddenState N' x (D - 1) =
              FullyConnectedReLUNet.hiddenState N x m := by
            exact (hstate_b (D - 1) hmle le_rfl).trans (hstate_a m le_rfl)
          have hN'depth : N'.depth = D := rfl
          unfold FullyConnectedReLUNet.realize
          rw [hN'depth]
          rw [hstate]

        have hwitness : ∀ r : ι, r ∈ s →
            ∃ N : FullyConnectedReLUNet d, 0 < N.depth ∧ N.depth ≤ D ∧
              N.width ≤ widthOf r ∧ N.parameterCount ≤ parameterOf r ∧
              ∀ x : Fin d → ℝ, approx r x = N.realize x := by
          intro r hr
          simpa [reluNetworkClass] using hclass r hr
        have hNpos : ∀ r : ι, ∀ hr : r ∈ s, 0 < (Classical.choose (hwitness r hr)).depth := by
          intro r hr
          exact (Classical.choose_spec (hwitness r hr)).1
        have hNdepth : ∀ r : ι, ∀ hr : r ∈ s, (Classical.choose (hwitness r hr)).depth ≤ D := by
          intro r hr
          exact (Classical.choose_spec (hwitness r hr)).2.1
        have hNwidth : ∀ r : ι, ∀ hr : r ∈ s, (Classical.choose (hwitness r hr)).width ≤ widthOf r := by
          intro r hr
          exact (Classical.choose_spec (hwitness r hr)).2.2.1
        have hNrealize : ∀ r : ι, ∀ hr : r ∈ s, ∀ x : Fin d → ℝ,
            approx r x = (Classical.choose (hwitness r hr)).realize x := by
          intro r hr x
          exact (Classical.choose_spec (hwitness r hr)).2.2.2.2 x
        let defNet : FullyConnectedReLUNet d := {
          depth := D
          width := 1
          input := ⟨fun _ _ => 0, fun _ => 0⟩
          hidden := fun _ : Fin (D - 1) => idLayer
          outputWeight := fun _ => 0
          outputBias := 0 }
        let A : ι → FullyConnectedReLUNet d := fun r =>
          if hr : r ∈ s then
            Classical.choose (hpad (Classical.choose (hwitness r hr)) (hNpos r hr) (hNdepth r hr))
          else defNet
        refine ⟨A, ?_, ?_, ?_, ?_⟩
        · intro r hr
          simp [A, hr]
          exact (Classical.choose_spec (hpad (Classical.choose (hwitness r hr)) (hNpos r hr) (hNdepth r hr))).1
        · intro r hr
          simp [A, hr]
          have hspec := Classical.choose_spec (hpad (Classical.choose (hwitness r hr)) (hNpos r hr) (hNdepth r hr))
          rw [hspec.2.1]
          exact hNwidth r hr
        · intro r hr x
          simp [A, hr]
          have hspec := Classical.choose_spec (hpad (Classical.choose (hwitness r hr)) (hNpos r hr) (hNdepth r hr))
          exact (hspec.2.2 x).trans (hNrealize r hr x).symm
        · calc
            (∑ r ∈ s, (A r).width) ≤ ∑ r ∈ s, widthOf r := by
              refine Finset.sum_le_sum ?_
              intro r hr
              simp [A, hr]
              have hspec := Classical.choose_spec (hpad (Classical.choose (hwitness r hr)) (hNpos r hr) (hNdepth r hr))
              rw [hspec.2.1]
              exact hNwidth r hr
            _ ≤ widthBudget := hwidthBudget
  -- @step s2: the parameter budget transfers via monotonicity of fullyConnectedReLUParameterCount in its width argument
  have hparam : ∀ A : ι → FullyConnectedReLUNet d,
      (∀ r : ι, r ∈ s → (A r).width ≤ widthOf r) →
        fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ≤ parameterBudget := by
      intro A hAwidth
      -- @step s1: termwise monotonicity of finite sums over s (Finset.sum_le_sum) from hAwidth
      have hsum_le : (∑ r ∈ s, (A r).width) ≤ (∑ r ∈ s, widthOf r) := by
        exact Finset.sum_le_sum hAwidth
      -- @step s2: fullyConnectedReLUParameterCount is monotone in its width argument; chain with hparameterBudget
      have hmono : fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ≤ parameterBudget := by
        have hpc_le : fullyConnectedReLUParameterCount d D (∑ r ∈ s, (A r).width) ≤
            fullyConnectedReLUParameterCount d D (∑ r ∈ s, widthOf r) := by
          unfold fullyConnectedReLUParameterCount
          gcongr
          all_goals exact hsum_le
        exact hpc_le.trans hparameterBudget
      exact hmono
  -- @step fin: apply E1 (finite_linear_combination_same_depth_reluNetworkClass_approximation_bound) with f = target
  rcases hA with ⟨A, hAdepth, hAwidth, hArealize, hAwidthSum⟩
  exact finite_linear_combination_same_depth_reluNetworkClass_approximation_bound hD s coeff target ε A hε hAdepth hAwidthSum
    (hparam A hAwidth)
    (by
      intro r hr x hx
      rw [hArealize r hr x]
      exact herr r hr x hx)


theorem finite_holderSmooth_local_table_reluNetworkClass_active_cell_error_bound
    {d m r n depthBudget widthBudget parameterBudget : ℕ}
    (hd : 0 < d) (hn : 0 < n) {beta C B R rho A eps : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (hA : 0 ≤ A) (hR : 0 < R)
    (hdepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ depthBudget)
    (hwidthBudget :
      finiteCenteredMonomialPolynomialWidthBound n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ widthBudget)
    (hparameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ parameterBudget)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center scale : Fin m → Fin d → ℝ)
    (hcoeff :
      ∀ j : Fin m,
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center j))
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A)
    (herrBudget :
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialApproxError R n a.1.val)
        + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤ eps)
    (hactive_coord : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ R)
    (hactive_norm : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ‖x - center j‖ ≤ rho) :
    ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
      (∀ j : Fin m,
        localApprox j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget) ∧
      ∀ (j : Fin m) (x : Fin d → ℝ),
        (∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |localApprox j x - f x| ≤ eps := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: For each j : Fin m, there exists a network N_j : FullyConnectedReLUNet d
  --   such that N_j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget and for
  --   every x : Fin d → ℝ satisfying the active-cell condition, |N_j.realize x - f x| ≤ eps.
  have h_s1 :
      ∀ j : Fin m,
        ∃ N : FullyConnectedReLUNet d,
          N.realize ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
          ∀ x : Fin d → ℝ,
            (∀ q : Fin d,
              scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
            |N.realize x - f x| ≤ eps := by
              intro j
              let ι : Type := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
              let coeff : ι → ℝ := fun a =>
                ((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f (center j))
                    (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
              let degree : ι → ℕ := fun a => a.1.val
              let coord : (a : ι) → Fin (degree a) → Fin d := fun a => a.2
              let T : (Fin d → ℝ) → ℝ := fun x =>
                finiteLinearCombination (Finset.univ : Finset ι) coeff
                  (fun r y => ∏ q : Fin (degree r), (y (coord r q) - center j (coord r q))) x
              obtain ⟨N, hN⟩ :=
                exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_uniform_resolution_size_bound
                  (ι := ι) (d := d) (n := n) hd hn (R := R) hR (center j)
                  (Finset.univ : Finset ι) coeff degree coord
              refine ⟨N, ?_, ?_⟩
              · simp [reluNetworkClass]
                refine ⟨N, hN.1, ?_, ?_, ?_, ?_⟩
                · exact le_trans hN.2.1 hdepthBudget
                · exact le_trans hN.2.2.1 hwidthBudget
                · exact le_trans hN.2.2.2.1 hparameterBudget
                · intro x; rfl
              · intro x hx
                have hcoord : ∀ q : Fin d, |x q - center j q| ≤ R := hactive_coord j x hx
                have hnorm : ‖x - center j‖ ≤ rho := hactive_norm j x hx
                have hErr_nonneg : ∀ k : ℕ, 0 ≤ centeredMonomialApproxError R n k := by
                  intro k
                  induction k with
                  | zero => simp [centeredMonomialApproxError]
                  | succ m ih =>
                      cases m with
                      | zero => simp [centeredMonomialApproxError]
                      | succ m' =>
                          simp [centeredMonomialApproxError]
                          have hRge : 0 ≤ R := le_of_lt hR
                          have hc : 0 ≤ centeredMonomialApproxError R n (Nat.succ m') := ih
                          have hBge :
                              0 ≤ R ^ (m' + 1) + centeredMonomialApproxError R n (Nat.succ m') + R + 1 := by
                            positivity
                          have hB2 :
                              0 ≤ (R ^ (m' + 1) + centeredMonomialApproxError R n (Nat.succ m') + R + 1) ^ 2 :=
                            sq_nonneg _
                          have h1 :
                              0 ≤ 2 * (R ^ (m' + 1) + centeredMonomialApproxError R n (Nat.succ m') + R + 1) ^ 2 / ↑n ^ 2 := by
                            exact div_nonneg (mul_nonneg (by norm_num) hB2) (sq_nonneg (n : ℝ))
                          have h2 :
                              0 ≤ (R ^ (m' + 1) + centeredMonomialApproxError R n (Nat.succ m') + R + 1) *
                                centeredMonomialApproxError R n (Nat.succ m') :=
                            mul_nonneg hBge hc
                          nlinarith
                have hsum_le :
                    finiteCenteredMonomialPolynomialApproxError R n (Finset.univ : Finset ι) coeff degree ≤
                      A * (∑ a : ι, centeredMonomialApproxError R n a.1.val) := by
                  dsimp [finiteCenteredMonomialPolynomialApproxError]
                  calc
                    (∑ r ∈ (Finset.univ : Finset ι),
                        |coeff r| * centeredMonomialApproxError R n (degree r))
                        ≤ (∑ r ∈ (Finset.univ : Finset ι),
                            A * centeredMonomialApproxError R n (degree r)) := by
                            exact Finset.sum_le_sum
                              (fun r hr => mul_le_mul_of_nonneg_right
                                (by simpa [coeff] using hcoeff j r) (hErr_nonneg (degree r)))
                    _ = A * (∑ r ∈ (Finset.univ : Finset ι),
                          centeredMonomialApproxError R n (degree r)) := by
                            rw [← Finset.mul_sum]
                    _ = A * (∑ a : ι, centeredMonomialApproxError R n a.1.val) := by
                            simp [degree]
                have hNerr : |N.realize x - T x| ≤
                    A * (∑ a : ι, centeredMonomialApproxError R n a.1.val) := by
                  exact le_trans (by simpa [T] using hN.2.2.2.2 x hcoord) hsum_le
                have hE1 :
                    |f x - finiteLinearCombination (Finset.univ : Finset ι) coeff
                        (fun a y => ∏ q : Fin (degree a), (y (coord a q) - center j (coord a q))) x| ≤
                      C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) :=
                  holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
                    (d := d) (r := r) (beta := beta) (C := C) (B := B) (rho := rho)
                    hbeta_nonneg hC hrho f hf (center j) x hnorm
                have hTerr : |f x - T x| ≤
                    C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
                  simpa [T] using hE1
                have htri : |N.realize x - f x| ≤ |N.realize x - T x| + |T x - f x| := by
                  calc
                    |N.realize x - f x| = |(N.realize x - T x) + (T x - f x)| := by
                        congr 1
                        ring
                    _ ≤ |N.realize x - T x| + |T x - f x| := by
                        simpa [Real.dist_eq] using dist_triangle (N.realize x) (T x) (f x)
                have hcomb :
                    |N.realize x - T x| + |T x - f x| ≤
                      A * (∑ a : ι, centeredMonomialApproxError R n a.1.val) +
                        C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
                  rw [abs_sub_comm (T x) (f x)]
                  exact add_le_add hNerr hTerr
                exact le_trans (le_trans htri hcomb) herrBudget
  -- @step s2: From the per-center witnesses in s1, construct the global function
  --   localApprox : Fin m → (Fin d → ℝ) → ℝ by classical choice so that
  --   (∀ j, localApprox j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget)
  --   and the active-cell error bound both hold.
  have h_s2 :
      ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          localApprox j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget) ∧
        ∀ (j : Fin m) (x : Fin d → ℝ),
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ eps := by
            refine ⟨fun j => (Classical.choose (h_s1 j)).realize, ?_, ?_⟩
            · intro j
              exact (Classical.choose_spec (h_s1 j)).1
            · intro j x hx
              exact (Classical.choose_spec (h_s1 j)).2 x hx
  -- @step fin
  -- @suggested: exact h_s2
  exact h_s2


theorem exists_reluNetworkClass_holderSmooth_axisAligned_tent_partition_approximation_on_domain_bound
    {d m r nLocal nWeight nMul Dbase
      weightDepthBudget weightWidthBudget
      localDepthBudget localWidthBudget localParameterBudget
      productDepthBudget productWidthBudget productParameterBudget
      globalWidthBudget globalParameterBudget : ℕ}
    (hd : 0 < d) (hnLocal : 0 < nLocal) (hnWeight : 0 < nWeight)
    (hnMul : 0 < nMul) (hDbase : 0 < Dbase)
    {beta C B localBoxRadius activeNormRadius coeffBound localEps
      weightRadius productRadius weightEta productDelta : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (hactiveNorm : 0 ≤ activeNormRadius) (hCoeff : 0 ≤ coeffBound)
    (hLocalBox : 0 < localBoxRadius)
    (hWeightRadius : 1 < weightRadius) (hProductRadius : 0 < productRadius)
    (hWeightEta_nonneg : 0 ≤ weightEta)
    (domain : (Fin d → ℝ) → Prop)
    (hWeightStepError :
      (∑ k ∈ Finset.range d, weightRadius ^ k) *
        (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta)
    (hWeightEta_internal : weightEta ≤ weightRadius - 1)
    (hWeightApprox_bound : 1 + weightEta ≤ productRadius)
    (hWeightDepthLower : 2 + d ≤ weightDepthBudget)
    (hWeightWidthLower : d * (2 + 2 * nWeight) ≤ weightWidthBudget)
    (hLocalDepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localDepthBudget)
    (hLocalWidthBudget :
      finiteCenteredMonomialPolynomialWidthBound nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localWidthBudget)
    (hLocalParameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localParameterBudget)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center scale : Fin m → Fin d → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ, domain x →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hcoeff :
      ∀ j : Fin m,
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center j))
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            coeffBound)
    (hLocalErrBudget :
      coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError localBoxRadius nLocal a.1.val)
        + C / (Nat.factorial r : ℝ) *
          Real.rpow activeNormRadius ((r : ℝ) + beta) ≤ localEps)
    (hactive_coord : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ localBoxRadius)
    (hactive_norm : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ‖x - center j‖ ≤ activeNormRadius)
    (hLocalTableBound :
      ∀ localApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          localApprox j ∈
            reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) →
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ localEps) →
        ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius)
    (hWeightDepthBudget : weightDepthBudget ≤ Dbase)
    (hLocalDepthToBase : localDepthBudget ≤ Dbase)
    (hProductDepthBudget : Dbase + 1 ≤ productDepthBudget)
    (hProductWidthBudget :
      weightWidthBudget + localWidthBudget + 2 * nMul ≤ productWidthBudget)
    (hProductParameterBudget :
      ∀ wWeight wLocal : ℕ,
        wWeight ≤ weightWidthBudget →
        wLocal ≤ localWidthBudget →
        fullyConnectedReLUParameterCount d (Dbase + 1)
          (wWeight + wLocal + 2 * nMul) ≤ productParameterBudget)
    (hProductErrBudget :
      2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 +
          productRadius * weightEta ≤ productDelta)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hGlobalWidthBudget :
      (∑ j : Fin m, productWidthBudget) ≤ globalWidthBudget)
    (hGlobalParameterBudget :
      fullyConnectedReLUParameterCount d productDepthBudget
        (∑ j : Fin m, productWidthBudget) ≤ globalParameterBudget) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈
        reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
      ∀ x : Fin d → ℝ, domain x →
        |g x - f x| ≤ (∑ j : Fin m, productDelta) + localEps := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: For each cell j, construct a local approximation `localApprox j` of `f` in
  --   `reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget`, with active-cell error
  --   `|localApprox j x - f x| ≤ localEps` and global bound `|localApprox j x| ≤ productRadius`.
  have h_s1 :
      ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          localApprox j ∈ reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ localEps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x → |localApprox j x| ≤ productRadius) := by
    classical
    have hE7 :
        ∀ j : Fin m,
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center j q| ≤ localBoxRadius) →
              ‖x - center j‖ ≤ activeNormRadius → |g x - f x| ≤ localEps := by
      intro j
      exact exists_reluNetworkClass_holderSmooth_local_approx_on_centered_box_with_coefficient_budget
        (d := d) (r := r) (n := nLocal)
        (depthBudget := localDepthBudget) (widthBudget := localWidthBudget)
        (parameterBudget := localParameterBudget)
        (beta := beta) (C := C) (B := B) (R := localBoxRadius)
        (rho := activeNormRadius) (A := coeffBound) (eps := localEps)
        hd hnLocal hbeta_nonneg hC hactiveNorm hCoeff hLocalBox
        hLocalDepthBudget hLocalWidthBudget hLocalParameterBudget
        f hf (center j) (hcoeff j) hLocalErrBudget
    let la : Fin m → (Fin d → ℝ) → ℝ := fun j => Classical.choose (hE7 j)
    have hla_mem :
        ∀ j : Fin m,
          la j ∈ reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget := by
      intro j
      exact (Classical.choose_spec (hE7 j)).1
    have hla_err :
        ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |la j x - f x| ≤ localEps := by
      intro j x hx hact
      exact (Classical.choose_spec (hE7 j)).2 x
        (hactive_coord j x hx hact) (hactive_norm j x hx hact)
    have hla_bnd : ∀ (j : Fin m) (x : Fin d → ℝ), domain x → |la j x| ≤ productRadius := by
      exact hLocalTableBound la hla_mem hla_err
    exact ⟨la, hla_mem, hla_err, hla_bnd⟩
  -- @step s2: For each cell j, approximate `axisAlignedBoxTentWeight (center j) (scale j)` by a ReLU
  --   network within `weightEta`, combine it with `localApprox j` into a product network in
  --   `reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget` with error `productDelta`.
  have h_s2 :
      ∀ (localApprox : Fin m → (Fin d → ℝ) → ℝ),
        (∀ j : Fin m,
          localApprox j ∈ reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) →
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x → |localApprox j x| ≤ productRadius) →
        ∃ g : Fin m → (Fin d → ℝ) → ℝ,
          (∀ j : Fin m,
            g j ∈ reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget) ∧
          (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
            |g j x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤ productDelta) := by
    intro localApprox hmem hbnd
    classical
    -- Per-cell tent-weight networks via E3 with the MINIMAL budget expressions.
    -- The enclosing statement supplies the depth/width lower bounds needed later;
    -- hProductParameterBudget handles the final product network parameter count, so the minimal
    -- instantiation is the only way to apply the tent-weight approximation theorem.
    have hE3 : ∀ j : Fin m,
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d (2 + d) (d * (2 + 2 * nWeight))
            (fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * nWeight))) ∧
          ∀ x : Fin d → ℝ, |g x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ weightEta := by
      intro j
      exact exists_reluNetworkClass_axisAlignedBoxTentWeight_approx_with_size_bound
        (n := nWeight) (depthBudget := 2 + d) (widthBudget := d * (2 + 2 * nWeight))
        (parameterBudget := fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * nWeight)))
        (R := weightRadius) (η := weightEta) (center := center j) (scale := scale j)
        hnWeight hWeightRadius hWeightEta_nonneg hWeightStepError hWeightEta_internal
        (hscale j) (le_rfl) (le_rfl) (le_rfl)
    -- Extract concrete tent-weight networks; the explicit depth and width lower
    -- bounds below are used by the weighted-product theorem.
    -- (a) Extract the concrete tent-weight networks from hE3 (minimal budgets).
    let gW : Fin m → (Fin d → ℝ) → ℝ := fun j => Classical.choose (hE3 j)
    have hgW_mem : ∀ j : Fin m,
        gW j ∈ reluNetworkClass d (2 + d) (d * (2 + 2 * nWeight))
          (fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * nWeight))) := by
      intro j
      exact (Classical.choose_spec (hE3 j)).1
    have hgW_err : ∀ (j : Fin m) (x : Fin d → ℝ),
        |gW j x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ weightEta := by
      intro j x
      exact (Classical.choose_spec (hE3 j)).2 x
    let Nw : Fin m → FullyConnectedReLUNet d := fun j => Classical.choose (hgW_mem j)
    have hNw_props : ∀ j : Fin m,
        0 < (Nw j).depth ∧ (Nw j).depth ≤ 2 + d ∧
          (Nw j).width ≤ d * (2 + 2 * nWeight) ∧
          (Nw j).parameterCount ≤
            fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * nWeight)) ∧
          ∀ x : Fin d → ℝ, gW j x = (Nw j).realize x := by
      intro j
      exact Classical.choose_spec (hgW_mem j)
    have hNw_realize_err : ∀ (j : Fin m) (x : Fin d → ℝ),
        |(Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ weightEta := by
      intro j x
      rw [← (hNw_props j).2.2.2.2 x]
      exact hgW_err j x
    -- (b) The axis-aligned box tent weight takes values in [0,1].
    have hrelu_nonneg : ∀ a : ℝ, 0 ≤ relu a := by
      intro a
      unfold relu
      exact (le_max_iff.mpr (Or.inr le_rfl) : 0 ≤ max a 0)
    have hrelu_mono : ∀ {a b : ℝ}, a ≤ b → relu a ≤ relu b := by
      intro a b hab
      unfold relu
      exact max_le_max hab (le_rfl : (0 : ℝ) ≤ 0)
    have hrelu_one : relu (1 : ℝ) = 1 := by
      unfold relu
      norm_num
    have hcoord_nonneg : ∀ (j : Fin m) (q : Fin d) (x : Fin d → ℝ),
        0 ≤ coordinateTentReLUFunction q (center j q) (scale j q) x := by
      intro j q x
      unfold coordinateTentReLUFunction
      exact hrelu_nonneg _
    have hcoord_le_one : ∀ (j : Fin m) (q : Fin d) (x : Fin d → ℝ),
        coordinateTentReLUFunction q (center j q) (scale j q) x ≤ 1 := by
      intro j q x
      unfold coordinateTentReLUFunction
      have harg : 1 - scale j q * (relu (x q - center j q) + relu (center j q - x q)) ≤ 1 := by
        have hmul : 0 ≤ scale j q * (relu (x q - center j q) + relu (center j q - x q)) :=
          mul_nonneg (hscale j q) (add_nonneg (hrelu_nonneg _) (hrelu_nonneg _))
        linarith
      have hrelu_le :
          relu (1 - scale j q * (relu (x q - center j q) + relu (center j q - x q))) ≤ relu 1 :=
        hrelu_mono harg
      linarith [hrelu_le, hrelu_one]
    have htent_unit : ∀ (j : Fin m) (x : Fin d → ℝ),
        |axisAlignedBoxTentWeight (center j) (scale j) x| ≤ 1 := by
      intro j x
      unfold axisAlignedBoxTentWeight
      have hprod_nonneg :
          0 ≤ ∏ q : Fin d, coordinateTentReLUFunction q (center j q) (scale j q) x := by
        exact Finset.prod_nonneg (fun q hq => hcoord_nonneg j q x)
      have hprod_le_one :
          (∏ q : Fin d, coordinateTentReLUFunction q (center j q) (scale j q) x) ≤ 1 := by
        exact Finset.prod_le_one (fun q hq => hcoord_nonneg j q x)
          (fun q hq => hcoord_le_one j q x)
      rw [abs_of_nonneg hprod_nonneg]
      exact hprod_le_one
    -- (c) Global productRadius bound for the tent networks.
    have hNw_bnd : ∀ (j : Fin m) (x : Fin d → ℝ), |(Nw j).realize x| ≤ productRadius := by
      intro j x
      have htri : |(Nw j).realize x| ≤
          |axisAlignedBoxTentWeight (center j) (scale j) x| + weightEta := by
        have htri0 : |(Nw j).realize x| ≤
            |(Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x| +
              |axisAlignedBoxTentWeight (center j) (scale j) x| := by
          simpa using (abs_add_le ((Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x)
            (axisAlignedBoxTentWeight (center j) (scale j) x))
        linarith [htri0, hNw_realize_err j x]
      calc
        |(Nw j).realize x| ≤
            |axisAlignedBoxTentWeight (center j) (scale j) x| + weightEta := htri
        _ ≤ 1 + weightEta := by linarith [htent_unit j x]
        _ ≤ productRadius := hWeightApprox_bound
    -- (d) Extract the concrete local networks from hmem.
    let Nl : Fin m → FullyConnectedReLUNet d := fun j => Classical.choose (hmem j)
    have hNl_props : ∀ j : Fin m,
        0 < (Nl j).depth ∧ (Nl j).depth ≤ localDepthBudget ∧
          (Nl j).width ≤ localWidthBudget ∧
          (Nl j).parameterCount ≤ localParameterBudget ∧
          ∀ x : Fin d → ℝ, localApprox j x = (Nl j).realize x := by
      intro j
      exact Classical.choose_spec (hmem j)
    have hNl_realize : ∀ (j : Fin m) (x : Fin d → ℝ),
        (Nl j).realize x = localApprox j x := by
      intro j x
      exact ((hNl_props j).2.2.2.2 x).symm
    have hNl_bnd : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        |(Nl j).realize x| ≤ productRadius := by
      intro j x hx
      rw [hNl_realize j x]
      exact hbnd j x hx
    have hNl_err : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        |(Nl j).realize x - localApprox j x| ≤ 0 := by
      intro j x hx
      rw [hNl_realize j x]
      simp
    -- Per-cell product networks from the tent-weight and local-table witnesses.
    -- The declared lower bounds place the concrete tent networks inside the
    -- weight depth and width budgets before applying the weighted-product theorem.
    have hprod : ∀ j : Fin m,
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤ productDelta := by
      intro j
      have hd_w : (Nw j).depth ≤ Dbase :=
        le_trans (hNw_props j).2.1 (le_trans hWeightDepthLower hWeightDepthBudget)
      have hd_l : (Nl j).depth ≤ Dbase :=
        le_trans (hNl_props j).2.1 hLocalDepthToBase
      have hw_w : (Nw j).width ≤ weightWidthBudget :=
        le_trans (hNw_props j).2.2.1 hWeightWidthLower
      have hl_w : (Nl j).width ≤ localWidthBudget :=
        (hNl_props j).2.2.1
      have hwidth : (Nw j).width + (Nl j).width + 2 * nMul ≤ productWidthBudget := by
        omega
      have hparam : fullyConnectedReLUParameterCount d (Dbase + 1)
          ((Nw j).width + (Nl j).width + 2 * nMul) ≤ productParameterBudget :=
        hProductParameterBudget (Nw j).width (Nl j).width hw_w hl_w
      have hres := exists_reluNetworkClass_weighted_local_product_approx_with_size_bound
        (D := Dbase) (n := nMul)
        (depthBudget := productDepthBudget) (widthBudget := productWidthBudget)
        (parameterBudget := productParameterBudget)
        hDbase hnMul
        (R := productRadius) (ηw := weightEta) (ηa := 0)
        hProductRadius hWeightEta_nonneg (by norm_num : (0 : ℝ) ≤ 0)
        (P := domain)
        (weight := axisAlignedBoxTentWeight (center j) (scale j))
        (local_ := localApprox j)
        (Nweight := Nw j) (Nlocal := Nl j)
        (hNw_props j).1 (hNl_props j).1 hd_w hd_l
        (fun x _hx => hNw_bnd j x)
        (fun x hx => hNl_bnd j x hx)
        (fun x hx => hbnd j x hx)
        (fun x _hx => hNw_realize_err j x)
        (fun x hx => hNl_err j x hx)
        hProductDepthBudget hwidth hparam
      rcases hres with ⟨g, hgmem, hgerr⟩
      refine ⟨g, hgmem, ?_⟩
      intro x hx
      have hb : |g x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
          2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 + productRadius * 0 + productRadius * weightEta :=
        hgerr x hx
      have hbound :
          2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 + productRadius * 0 + productRadius * weightEta ≤
            productDelta := by
        simpa [mul_zero] using hProductErrBudget
      exact le_trans hb hbound
    refine ⟨fun j => Classical.choose (hprod j), ?_, ?_⟩
    · intro j
      exact (Classical.choose_spec (hprod j)).1
    · intro j x hx
      exact (Classical.choose_spec (hprod j)).2 x hx
  -- @step s3: Assemble the per-cell product networks into one global network in
  --   `reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget` approximating
  --   `∑ j, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x` within `∑ j, productDelta`.
  have h_s3 :
      ∀ (localApprox : Fin m → (Fin d → ℝ) → ℝ),
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ localEps) →
        ∀ g : Fin m → (Fin d → ℝ) → ℝ,
          (∀ j : Fin m,
            g j ∈ reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget) →
          (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
            |g j x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤ productDelta) →
          ∃ gGlobal : (Fin d → ℝ) → ℝ,
            gGlobal ∈ reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
            (∀ x : Fin d → ℝ, domain x →
              |gGlobal x - (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)| ≤
                ∑ j : Fin m, productDelta) := by
    intro localApprox _
    intro g hg hgerr
    have hDpos : 0 < productDepthBudget := by
      omega
    have hcomb :=
      Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
        (ι := Fin m) (d := d) (D := productDepthBudget)
        (widthBudget := globalWidthBudget) (parameterBudget := globalParameterBudget)
        (P := domain) hDpos Finset.univ
        (fun _ : Fin m => (1 : ℝ))
        (fun r x => axisAlignedBoxTentWeight (center r) (scale r) x * localApprox r x)
        g (fun _ : Fin m => productDelta)
        (fun _ : Fin m => productWidthBudget) (fun _ : Fin m => productParameterBudget)
        (fun r _ => hProductDelta_nonneg)
        (fun r _ => hg r)
        hGlobalWidthBudget
        hGlobalParameterBudget
        (fun r _ x hx => hgerr r x hx)
    rcases hcomb with ⟨gGlobal, hmem, herr⟩
    refine ⟨gGlobal, hmem, ?_⟩
    intro x hx
    simpa [finiteLinearCombination] using herr x hx
  -- @step s4: The exact weighted sum `∑ j, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x`
  --   approximates `f x` within `localEps` on the domain, via the partition of unity, tent support, and active-cell error.
  have h_s4 :
      ∀ (localApprox : Fin m → (Fin d → ℝ) → ℝ),
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ localEps) →
        ∀ x : Fin d → ℝ, domain x →
          |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) - f x| ≤ localEps := by
    intro localApprox hlocerr
    intro x hx
    have hpart : (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1 :=
      hpartition x hx
    have htent_nonneg : ∀ j : Fin m, 0 ≤ axisAlignedBoxTentWeight (center j) (scale j) x := by
      intro j
      exact (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1
    have htent_active : ∀ j : Fin m,
        axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 →
        ∀ q : Fin d, scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1 := by
      intro j ht
      by_contra hnot
      have hge : ∃ q : Fin d,
          1 ≤ scale j q * (relu (x q - center j q) + relu (center j q - x q)) := by
        push_neg at hnot
        simpa [not_lt] using hnot
      have hz := (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).2.2 hge
      exact ht hz
    have hpart_mul : (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * f x) = f x := by
      calc
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * f x)
            = (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) * f x := by
              rw [← Finset.sum_mul]
        _ = 1 * f x := by rw [hpart]
        _ = f x := by simp
    have hrewrite : (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) - f x =
        ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x) := by
      calc
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) - f x
            = (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) -
                (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * f x) := by
              rw [hpart_mul]
        _ = ∑ j : Fin m, (axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x -
              axisAlignedBoxTentWeight (center j) (scale j) x * f x) := by
              rw [Finset.sum_sub_distrib]
        _ = ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x) := by
              apply Finset.sum_congr rfl
              intro j hj
              ring
    have habs : |∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x)| ≤
        ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - f x| := by
      calc
        |∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x)|
            ≤ ∑ j : Fin m, |axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x)| := by
              exact Finset.abs_sum_le_sum_abs _ _
        _ = ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - f x| := by
              apply Finset.sum_congr rfl
              intro j hj
              rw [abs_mul, abs_of_nonneg (htent_nonneg j)]
    have hterm : ∀ j : Fin m,
        axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - f x| ≤
          axisAlignedBoxTentWeight (center j) (scale j) x * localEps := by
      intro j
      by_cases ht : axisAlignedBoxTentWeight (center j) (scale j) x = 0
      · rw [ht]
        simp
      · have hactive : ∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1 :=
          htent_active j ht
        have hle := hlocerr j x hx hactive
        exact mul_le_mul_of_nonneg_left hle (htent_nonneg j)
    have hsum_le : (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - f x|) ≤
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localEps) := by
      exact Finset.sum_le_sum (s := (Finset.univ : Finset (Fin m))) (fun j _ => hterm j)
    have hsum_eps : (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localEps) = localEps := by
      calc
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localEps)
            = (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) * localEps := by
              rw [← Finset.sum_mul]
        _ = 1 * localEps := by rw [hpart]
        _ = localEps := by simp
    calc
      |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) - f x|
          = |∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - f x)| := by
            rw [hrewrite]
      _ ≤ ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - f x| := habs
      _ ≤ ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localEps := hsum_le
      _ = localEps := hsum_eps
  -- @step s5: Triangle inequality between the assembled-network error (s3) and the exact weighted-sum error (s4)
  --   yields the final bound `|g x - f x| ≤ (∑ j, productDelta) + localEps`.
  have h_s5 :
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
        ∀ x : Fin d → ℝ, domain x →
          |g x - f x| ≤ (∑ j : Fin m, productDelta) + localEps := by
    rcases h_s1 with ⟨localApprox, hloc_mem, hloc_err, hloc_bound⟩
    rcases h_s2 localApprox hloc_mem hloc_bound with ⟨A, hA_mem, hA_err⟩
    rcases h_s3 localApprox hloc_err A hA_mem hA_err with ⟨gGlobal, hg_mem, hg_err⟩
    refine ⟨gGlobal, hg_mem, ?_⟩
    intro x hx
    let s : (Fin d → ℝ) → ℝ :=
      fun x => ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x
    have h1 : |gGlobal x - s x| ≤ ∑ j : Fin m, productDelta := hg_err x hx
    have h2 : |s x - f x| ≤ localEps := h_s4 localApprox hloc_err x hx
    have hsub : (gGlobal x - s x) + (s x - f x) = gGlobal x - f x := by ring
    have htri : |gGlobal x - f x| ≤ |gGlobal x - s x| + |s x - f x| := by
      have hsum := norm_add_le (gGlobal x - s x) (s x - f x)
      rw [hsub] at hsum
      simpa [Real.norm_eq_abs] using hsum
    calc
      |gGlobal x - f x| ≤ |gGlobal x - s x| + |s x - f x| := htri
      _ ≤ (∑ j : Fin m, productDelta) + localEps := add_le_add h1 h2
  -- @step fin
  exact h_s5

/-! ## Unit-cube fixed-width instantiation prerequisites -/

theorem exists_reluNetworkClass_axisAligned_tent_partition_approximation_from_bounded_local_table_on_domain
    {d m nWeight nMul Dbase
     weightDepthBudget weightWidthBudget
     localDepthBudget localWidthBudget localParameterBudget
     productDepthBudget productWidthBudget productParameterBudget
     globalWidthBudget globalParameterBudget : ℕ}
    (hnWeight : 0 < nWeight) (hnMul : 0 < nMul) (hDbase : 0 < Dbase)
    {weightRadius productRadius weightEta productDelta localEps : ℝ}
    (hWeightRadius : 1 < weightRadius) (hProductRadius : 0 < productRadius)
    (hWeightEta_nonneg : 0 ≤ weightEta)
    (domain : (Fin d → ℝ) → Prop)
    (target : (Fin d → ℝ) → ℝ)
    (center scale : Fin m → Fin d → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ, domain x →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hLocalTable :
      ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          localApprox j ∈
            reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - target x| ≤ localEps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius))
    (hWeightStepError :
      (∑ k ∈ Finset.range d, weightRadius ^ k) *
        (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta)
    (hWeightEta_internal : weightEta ≤ weightRadius - 1)
    (hWeightApprox_bound : 1 + weightEta ≤ productRadius)
    (hWeightDepthLower : 2 + d ≤ weightDepthBudget)
    (hWeightWidthLower : d * (2 + 2 * nWeight) ≤ weightWidthBudget)
    (hWeightDepthBudget : weightDepthBudget ≤ Dbase)
    (hLocalDepthToBase : localDepthBudget ≤ Dbase)
    (hProductDepthBudget : Dbase + 1 ≤ productDepthBudget)
    (hProductWidthBudget :
      weightWidthBudget + localWidthBudget + 2 * nMul ≤ productWidthBudget)
    (hProductParameterBudget :
      ∀ wWeight wLocal : ℕ,
        wWeight ≤ weightWidthBudget →
        wLocal ≤ localWidthBudget →
        fullyConnectedReLUParameterCount d (Dbase + 1)
          (wWeight + wLocal + 2 * nMul) ≤ productParameterBudget)
    (hProductErrBudget :
      2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 +
        productRadius * weightEta ≤ productDelta)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hGlobalWidthBudget :
      (∑ j : Fin m, productWidthBudget) ≤ globalWidthBudget)
    (hGlobalParameterBudget :
      fullyConnectedReLUParameterCount d productDepthBudget
        (∑ j : Fin m, productWidthBudget) ≤ globalParameterBudget) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈
        reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
      ∀ x : Fin d → ℝ, domain x →
        |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: Destructure `hLocalTable` to obtain `localApprox` and per-cell local networks `Nlocal`
  have h_s1 :
      ∃ (localApprox : Fin m → (Fin d → ℝ) → ℝ)
        (Nlocal : Fin m → FullyConnectedReLUNet d),
        (∀ j : Fin m,
          localApprox j ∈
            reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), localApprox j x = (Nlocal j).realize x) ∧
        (∀ j : Fin m, 0 < (Nlocal j).depth) ∧
        (∀ j : Fin m, (Nlocal j).depth ≤ Dbase) ∧
        (∀ j : Fin m, (Nlocal j).width ≤ localWidthBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - target x| ≤ localEps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius) := by
    rcases hLocalTable with ⟨localApprox, hloc_mem, hloc_err, hloc_bound⟩
    choose Nlocal hNpos hNdepth hNwidth hNparam hNrealize using fun j : Fin m => by
      simpa [reluNetworkClass] using hloc_mem j
    refine ⟨localApprox, Nlocal, hloc_mem, ?_, ?_, ?_, ?_, hloc_err, hloc_bound⟩
    · intro j x
      exact hNrealize j x
    · intro j
      exact hNpos j
    · intro j
      exact le_trans (hNdepth j) hLocalDepthToBase
    · intro j
      exact hNwidth j
  -- @step s2: Apply E1 per cell to build tent-approximation networks `Nw j` with error ≤ weightEta
  have h_s2 :
      ∃ Nw : Fin m → FullyConnectedReLUNet d,
        (∀ j : Fin m, 0 < (Nw j).depth) ∧
        (∀ j : Fin m, (Nw j).depth ≤ Dbase) ∧
        (∀ j : Fin m, (Nw j).width ≤ weightWidthBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ),
          |(Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ weightEta) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x → |(Nw j).realize x| ≤ productRadius) := by
    have hE1 (j : Fin m) :
        ∃ Nw : FullyConnectedReLUNet d,
          (∀ x : Fin d → ℝ,
            |(Nw.realize x) - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ weightEta) ∧
          0 < Nw.depth ∧ Nw.depth ≤ weightDepthBudget ∧ Nw.width ≤ weightWidthBudget := by
      rcases (exists_reluNetworkClass_axisAlignedBoxTentWeight_approx_with_size_bound
          (d := d) (n := nWeight) (depthBudget := weightDepthBudget) (widthBudget := weightWidthBudget)
          (parameterBudget := fullyConnectedReLUParameterCount d (2 + d) (d * (2 + 2 * nWeight)))
          hnWeight (R := weightRadius) (η := weightEta) hWeightRadius hWeightEta_nonneg
          hWeightStepError hWeightEta_internal (center := center j) (scale := scale j) (hscale j)
          hWeightDepthLower hWeightWidthLower (le_rfl)) with ⟨g, hg_mem, hg_err⟩
      rcases (by simpa [reluNetworkClass] using hg_mem) with
        ⟨Nw, hNpos, hNdepth, hNwidth, hNparam, hNreal⟩
      refine ⟨Nw, ?_, hNpos, hNdepth, hNwidth⟩
      intro x
      simpa [hNreal x] using hg_err x
    -- h_s2 complete: per-cell tent networks Nw with depth/width budgets and productRadius bound on domain

    choose Nw hNw_err hNw_pos hNw_depth hNw_width using hE1
    refine ⟨Nw, hNw_pos, ?_, hNw_width, hNw_err, ?_⟩
    · intro j
      exact le_trans (hNw_depth j) hWeightDepthBudget
    · intro j x hxdom
      have htent0 : 0 ≤ axisAlignedBoxTentWeight (center j) (scale j) x :=
        (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1
      have htent1 : axisAlignedBoxTentWeight (center j) (scale j) x ≤ 1 :=
        (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).2.1
      calc
        |(Nw j).realize x| =
            |((Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x) +
              axisAlignedBoxTentWeight (center j) (scale j) x| := by
          rw [sub_add_cancel]
        _ ≤ |(Nw j).realize x - axisAlignedBoxTentWeight (center j) (scale j) x| +
            |axisAlignedBoxTentWeight (center j) (scale j) x| := abs_add_le _ _
        _ ≤ weightEta + 1 := by
          rw [abs_of_nonneg htent0]
          exact add_le_add (hNw_err j x) htent1
        _ = 1 + weightEta := by ring
        _ ≤ productRadius := hWeightApprox_bound
  -- @step s3: Apply E5 per cell to build product networks `Np j` (tent * localApprox) with error ≤ productDelta
  have h_s3 :
      ∃ (localApprox : Fin m → (Fin d → ℝ) → ℝ)
        (Np : Fin m → FullyConnectedReLUNet d),
        (∀ j : Fin m,
          localApprox j ∈
            reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - target x| ≤ localEps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius) ∧
        (∀ j : Fin m,
          (Np j).realize ∈
            reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |(Np j).realize x -
              axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
            productDelta) := by
    rcases h_s1 with
      ⟨localApprox, Nlocal, hloc_mem, hloc_realize, hNlocal_pos, hNlocal_depth, hNlocal_width,
        hloc_err, hloc_bound⟩
    rcases h_s2 with
      ⟨Nw, hNw_pos, hNw_depth, hNw_width, hNw_err, hNw_bound⟩
    have hE5 (j : Fin m) :
        ∃ Np : FullyConnectedReLUNet d,
          (Np.realize ∈
            reluNetworkClass d productDepthBudget productWidthBudget productParameterBudget) ∧
          (∀ x : Fin d → ℝ, domain x →
            |Np.realize x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
              productDelta) := by
      have hNlocal_bound : ∀ x : Fin d → ℝ, domain x → |(Nlocal j).realize x| ≤ productRadius := by
        intro x hxdom
        rw [← hloc_realize j x]
        exact hloc_bound j x hxdom
      have hNlocal_err :
          ∀ x : Fin d → ℝ, domain x → |(Nlocal j).realize x - localApprox j x| ≤ 0 := by
        intro x hxdom
        rw [hloc_realize j x]
        simp
      have hwidth : (Nw j).width + (Nlocal j).width + 2 * nMul ≤ productWidthBudget := by
        calc
          (Nw j).width + (Nlocal j).width + 2 * nMul ≤
              weightWidthBudget + localWidthBudget + 2 * nMul := by
            exact add_le_add (add_le_add (hNw_width j) (hNlocal_width j)) le_rfl
          _ ≤ productWidthBudget := hProductWidthBudget
      have hparam :
          fullyConnectedReLUParameterCount d (Dbase + 1)
            ((Nw j).width + (Nlocal j).width + 2 * nMul) ≤ productParameterBudget := by
        exact hProductParameterBudget ((Nw j).width) ((Nlocal j).width) (hNw_width j) (hNlocal_width j)
      rcases (exists_reluNetworkClass_weighted_local_product_approx_with_size_bound
          (d := d) (D := Dbase) (n := nMul)
          (depthBudget := productDepthBudget) (widthBudget := productWidthBudget)
          (parameterBudget := productParameterBudget)
          (R := productRadius) (ηw := weightEta) (ηa := 0)
          (P := domain)
          (weight := axisAlignedBoxTentWeight (center j) (scale j))
          (local_ := localApprox j)
          hDbase hnMul hProductRadius hWeightEta_nonneg (le_rfl : (0 : ℝ) ≤ 0)
          (Nw j) (Nlocal j)
          (hNw_pos j) (hNlocal_pos j)
          (hNw_depth j) (hNlocal_depth j)
          (hNw_bound j) hNlocal_bound (hloc_bound j)
          (fun x _ => hNw_err j x) hNlocal_err
          hProductDepthBudget hwidth hparam) with ⟨g, hg_mem, hg_err⟩
      rcases (by simpa [reluNetworkClass] using hg_mem) with
        ⟨Np, hNp_pos, hNp_depth, hNp_width, hNp_param, hNp_real⟩
      refine ⟨Np, ?_, ?_⟩
      · rw [← funext hNp_real]
        exact hg_mem
      · intro x hxdom
        calc
          |Np.realize x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
              2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 + productRadius * 0 + productRadius * weightEta := by
            simpa [hNp_real x] using hg_err x hxdom
          _ ≤ productDelta := by
            simpa [mul_zero, add_zero] using hProductErrBudget
    choose Np hNp_mem hNp_err using hE5
    refine ⟨localApprox, Np, hloc_mem, hloc_err, hloc_bound, hNp_mem, hNp_err⟩
  -- @step s4: Assemble per-cell networks via E4 to obtain `g` with combination error ≤ ∑ productDelta
  have h_s4 :
      ∃ (localApprox : Fin m → (Fin d → ℝ) → ℝ) (g : (Fin d → ℝ) → ℝ),
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - target x| ≤ localEps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius) ∧
        g ∈ reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
        (∀ x : Fin d → ℝ, domain x →
          |g x -
              (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)| ≤
            (∑ j : Fin m, productDelta)) := by
    rcases h_s3 with ⟨localApprox, Np, hloc_mem, hloc_err, hloc_bound, hNp_mem, hNp_err⟩
    rcases (finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
      (lt_of_lt_of_le (Nat.succ_pos Dbase) hProductDepthBudget)
      (d := d) (D := productDepthBudget) (widthBudget := globalWidthBudget)
      (parameterBudget := globalParameterBudget) (P := domain)
      (s := Finset.univ) (coeff := fun _ : Fin m => 1)
      (target := fun j x => axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)
      (approx := fun j => (Np j).realize)
      (ε := fun _ : Fin m => productDelta)
      (widthOf := fun _ : Fin m => productWidthBudget)
      (parameterOf := fun _ : Fin m => productParameterBudget)
      (fun r hr => hProductDelta_nonneg)
      (fun r hr => hNp_mem r)
      (by simpa using hGlobalWidthBudget)
      (by simpa using hGlobalParameterBudget)
      (fun r hr x hx => hNp_err r x hx)) with ⟨g, hg_mem, hg_err⟩
    refine ⟨localApprox, g, hloc_err, hloc_bound, hg_mem, ?_⟩
    intro x hx
    simpa [finiteLinearCombination] using hg_err x hx
  -- @step s5: Combine with the partition identity to bound |g x - target x| by (∑ productDelta) + localEps
  have h_s5 :
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
        ∀ x : Fin d → ℝ, domain x →
          |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
    rcases h_s4 with ⟨localApprox, g, hloc_err, hloc_bound, hg_mem, hg_err⟩
    let s : (Fin d → ℝ) → ℝ :=
      fun y => ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) y * localApprox j y
    have hcell : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - target x| ≤
          axisAlignedBoxTentWeight (center j) (scale j) x * localEps := by
      intro j x hx
      by_cases hp : ∀ q : Fin d, scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1
      · have hE : |localApprox j x - target x| ≤ localEps := hloc_err j x hx hp
        have hw : 0 ≤ axisAlignedBoxTentWeight (center j) (scale j) x :=
          (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1
        exact mul_le_mul_of_nonneg_left hE hw
      · have hnot : ∃ q : Fin d, 1 ≤ scale j q * (relu (x q - center j q) + relu (center j q - x q)) := by
          push_neg at hp
          exact hp
        have hw0 : axisAlignedBoxTentWeight (center j) (scale j) x = 0 :=
          (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).2.2 hnot
        simp [hw0]
    have hsum : ∀ (x : Fin d → ℝ), domain x →
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - target x|) ≤
          localEps := by
      intro x hx
      calc
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - target x|) ≤
            (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localEps) := by
          exact Finset.sum_le_sum (fun j hj => hcell j x hx)
        _ = (∑ j : Fin m, localEps * axisAlignedBoxTentWeight (center j) (scale j) x) := by
          apply Finset.sum_congr rfl
          intro j hj
          rw [mul_comm]
        _ = localEps * (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) := by
          rw [Finset.mul_sum]
        _ = localEps := by
          rw [hpartition x hx, mul_one]
    have htri : ∀ (x : Fin d → ℝ), domain x → |s x - target x| ≤ localEps := by
      intro x hx
      calc
        |s x - target x| = |∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x)| := by
          rw [show s x - target x = ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x) by
            calc
              s x - target x = (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) - (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * target x) := by
                rw [← Finset.sum_mul, hpartition x hx, one_mul]
              _ = ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x) := by
                rw [← Finset.sum_sub_distrib]
                apply Finset.sum_congr rfl
                intro j hj
                rw [mul_sub]]
        _ ≤ ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - target x| := by
          calc
            |∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x)| ≤
                ∑ j : Fin m, |axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x)| := by
              exact Finset.abs_sum_le_sum_abs (s := Finset.univ)
                (f := fun j : Fin m => axisAlignedBoxTentWeight (center j) (scale j) x * (localApprox j x - target x))
            _ = ∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * |localApprox j x - target x| := by
              apply Finset.sum_congr rfl
              intro j hj
              rw [abs_mul, abs_of_nonneg (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1]
        _ ≤ localEps := hsum x hx
    refine ⟨g, hg_mem, ?_⟩
    intro x hx
    calc
      |g x - target x| ≤ |g x - s x| + |s x - target x| := by
        calc
          |g x - target x| = |(g x - s x) + (s x - target x)| := by
            rw [show g x - target x = (g x - s x) + (s x - target x) by ring]
          _ ≤ |g x - s x| + |s x - target x| := abs_add_le _ _
      _ ≤ (∑ j : Fin m, productDelta) + localEps := by
        exact add_le_add (hg_err x hx) (htri x hx)
  exact h_s5

theorem finite_holderSmooth_local_table_reluNetworkClass_active_cell_error_and_domain_output_bound
    {d m r n depthBudget widthBudget parameterBudget : ℕ}
    (hd : 0 < d) (hn : 0 < n) {beta C B R rho A eps productRadius : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (hA : 0 ≤ A) (hR : 0 < R)
    (hdepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ depthBudget)
    (hwidthBudget :
      finiteCenteredMonomialPolynomialWidthBound n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ widthBudget)
    (hparameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d n
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ parameterBudget)
    (domain : (Fin d → ℝ) → Prop)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center scale : Fin m → Fin d → ℝ)
    (hcoeff :
      ∀ j : Fin m,
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f (center j))
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            A)
    (herrBudget :
      A *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError R n a.1.val)
        + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤
        eps)
    (hdomain_coord :
      ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        ∀ q : Fin d, |x q - center j q| ≤ R)
    (hactive_coord :
      ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        (∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ R)
    (hactive_norm :
      ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        (∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ‖x - center j‖ ≤ rho)
    (houtputBudget :
      A *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError R n a.1.val)
        + A *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            R ^ a.1.val) ≤
        productRadius) :
    ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
      (∀ j : Fin m,
        localApprox j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          (∀ q : Fin d,
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
          |localApprox j x - f x| ≤ eps) ∧
        (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
          |localApprox j x| ≤ productRadius) := by
  -- @step s1: For each center j, construct a concrete ReLU network N_j with depth, width, and parameter count within the given budgets, approximating the degree-r Taylor polynomial of f at center j on the box {x | ∀ q, |x q - center j q| ≤ R} with error at most A * ∑ a, centeredMonomialApproxError R n a.1.val
  have h_s1 : ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
      (∀ j : Fin m, localApprox j ∈ reluNetworkClass d depthBudget widthBudget parameterBudget) ∧
      (∀ (j : Fin m) (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
        |localApprox j x -
            (∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j))| ≤
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialApproxError R n a.1.val)) := by
            have h_cma_nonneg : ∀ x : ℕ, 0 ≤ centeredMonomialApproxError R n x := by
              intro x
              induction x with
              | zero =>
                simp [centeredMonomialApproxError]
              | succ x ih =>
                cases x with
                | zero =>
                  simp [centeredMonomialApproxError]
                | succ x =>
                  simp [centeredMonomialApproxError]
                  positivity
            have h_cma_sum_bound :
                ∀ j : Fin m,
                  finiteCenteredMonomialPolynomialApproxError R n
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (fun a =>
                                  ((Nat.factorial a.fst.val : ℝ)⁻¹) *
                                    (iteratedFDeriv ℝ a.fst.val f (center j))
                                      (fun q : Fin a.fst.val => fun u : Fin d => if u = a.snd q then 1 else 0))
                                (fun a => a.fst.val) ≤
                            A *
                              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                                centeredMonomialApproxError R n a.1.val) := by
                        intro j
                        rw [finiteCenteredMonomialPolynomialApproxError]
                        calc
                          (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                              |((Nat.factorial a.fst.val : ℝ)⁻¹) *
                                  (iteratedFDeriv ℝ a.fst.val f (center j))
                                    (fun q : Fin a.fst.val => fun u : Fin d => if u = a.snd q then 1 else 0)|
                                * centeredMonomialApproxError R n a.fst.val)
                              ≤ (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                                  A * centeredMonomialApproxError R n a.fst.val) := by
                                apply Finset.sum_le_sum
                                intro a ha
                                exact mul_le_mul_of_nonneg_right (hcoeff j a) (h_cma_nonneg a.fst.val)
                          _ = A *
                              (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                                centeredMonomialApproxError R n a.fst.val) := by
                                rw [Finset.mul_sum]
                          _ = A *
                              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                                centeredMonomialApproxError R n a.1.val) := by
                                rfl
            have h_per_center :
                ∀ j : Fin m,
                  ∃ g : (Fin d → ℝ) → ℝ,
                    g ∈ reluNetworkClass d depthBudget widthBudget parameterBudget ∧
                      (∀ (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
                        |g x -
                            (∑ k ∈ Finset.range (r + 1),
                              ((Nat.factorial k : ℝ)⁻¹) *
                                (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j))| ≤
                          A *
                            (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                              centeredMonomialApproxError R n a.1.val)) := by
              intro j
              rcases exists_fullyConnectedReLUNet_taylor_polynomial_approx_on_centered_box_with_size_bound
                  hd hn hR f (center j) with ⟨N, hNdepth_pos, hNdepth, hNwidth, hNparam, hNerr⟩
              refine ⟨fun x => N.realize x, ?_, ?_⟩
              · simp [reluNetworkClass]
                exact
                  ⟨N, hNdepth_pos, le_trans hNdepth hdepthBudget, le_trans hNwidth hwidthBudget,
                    le_trans hNparam hparameterBudget, fun x => rfl⟩
              · intro x hx
                have hNerr' :
                    |N.realize x -
                        (∑ k ∈ Finset.range (r + 1),
                          ((Nat.factorial k : ℝ)⁻¹) *
                            (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j))| ≤
                      A *
                        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                          centeredMonomialApproxError R n a.1.val) := by
                  exact le_trans (hNerr x hx) (h_cma_sum_bound j)
                simpa using hNerr'
            refine ⟨fun j => Classical.choose (h_per_center j), ?_, ?_⟩
            · intro j
              exact (Classical.choose_spec (h_per_center j)).1
            · intro j x hx
              exact (Classical.choose_spec (h_per_center j)).2 x hx
  -- @step s2: On the same coordinate box, the degree-r Taylor polynomial of f at center j is bounded in absolute value by A * ∑ a, R ^ a.1.val, using hcoeff to bound each coefficient and the box condition to bound each monomial factor by R
  have h_s2 : ∀ (j : Fin m) (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
      |∑ k ∈ Finset.range (r + 1),
        ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j)| ≤
            A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
        intro j x hbox
        have h_mono :
            ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              |∏ q : Fin a.fst.val, (x (a.snd q) - center j (a.snd q))| ≤ R ^ a.fst.val := by
          intro a
          calc
            |∏ q : Fin a.fst.val, (x (a.snd q) - center j (a.snd q))| =
                ∏ q : Fin a.fst.val, |x (a.snd q) - center j (a.snd q)| := by
                  rw [Finset.abs_prod]
            _ ≤ ∏ _ : Fin a.fst.val, R := by
                  apply Finset.prod_le_prod
                  · intro q hq
                    exact abs_nonneg _
                  · intro q hq
                    exact hbox (a.snd q)
            _ = R ^ a.fst.val := by
                  simp [Finset.prod_const]
        calc
          |∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j)|
              = |finiteLinearCombination
                  (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                  (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
                    ((Nat.factorial a.fst.val : ℝ)⁻¹) *
                      (iteratedFDeriv ℝ a.fst.val f (center j))
                        (fun q : Fin a.fst.val => fun u : Fin d => if u = a.snd q then 1 else 0))
                  (fun (a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) (y : Fin d → ℝ) =>
                    ∏ q : Fin a.fst.val, (y (a.snd q) - center j (a.snd q)))
                  x| := by
                rw [taylor_polynomial_as_finite_centered_coordinate_polynomial f (center j) x]
          _ ≤ ∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                |((Nat.factorial a.fst.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.fst.val f (center j))
                      (fun q : Fin a.fst.val => fun u : Fin d => if u = a.snd q then 1 else 0)
                  * (∏ q : Fin a.fst.val, (x (a.snd q) - center j (a.snd q)))| := by
                rw [finiteLinearCombination]
                exact Finset.abs_sum_le_sum_abs _ _
          _ = ∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                |((Nat.factorial a.fst.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.fst.val f (center j))
                      (fun q : Fin a.fst.val => fun u : Fin d => if u = a.snd q then 1 else 0)|
                  * |∏ q : Fin a.fst.val, (x (a.snd q) - center j (a.snd q))| := by
                apply Finset.sum_congr rfl
                intro a ha
                rw [abs_mul]
          _ ≤ ∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                A * R ^ a.fst.val := by
                apply Finset.sum_le_sum
                intro a ha
                exact mul_le_mul (hcoeff j a) (h_mono a) (abs_nonneg _) hA
          _ = A * (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
                  R ^ a.fst.val) := by
                rw [Finset.mul_sum]
          _ = A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
                rfl
  -- @step s3: For every j and x in domain satisfying the active-cell condition, combine the network-to-Taylor error from s1 with the Taylor remainder bound from holderSmoothBall_taylor_remainder_bound_on_box (E7), using hactive_norm and herrBudget, to obtain |N_j x - f x| ≤ eps
  have h_s3 : ∀ (g : Fin m → (Fin d → ℝ) → ℝ),
      (∀ (j : Fin m) (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
        |g j x -
            (∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j))| ≤
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError R n a.1.val)) →
      ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        (∀ q : Fin d, scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |g j x - f x| ≤ eps := by
          intro g hNetErr j x hdom hactive
          let Tj : ℝ :=
            ∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j)
          have htri : |g j x - f x| ≤ |g j x - Tj| + |Tj - f x| := by
            calc
              |g j x - f x| = |(g j x - Tj) + (Tj - f x)| := by
                rw [(by ring : g j x - f x = (g j x - Tj) + (Tj - f x))]
              _ ≤ |g j x - Tj| + |Tj - f x| := abs_add_le (g j x - Tj) (Tj - f x)
          have hbox : ∀ q : Fin d, |x q - center j q| ≤ R := hdomain_coord j x hdom
          have hNerr : |g j x - Tj| ≤
              A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialApproxError R n a.1.val) := by
            simpa [Tj] using hNetErr j x hbox
          have hnorm : ‖x - center j‖ ≤ rho := hactive_norm j x hdom hactive
          have hrem : |Tj - f x| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
            have hrem' :=
              Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.holderSmoothBall_taylor_remainder_bound_on_box
                hbeta_nonneg hC hrho f hf (center j) x hnorm
            rw [abs_sub_comm]
            simpa [Tj] using hrem'
          calc
            |g j x - f x| ≤ |g j x - Tj| + |Tj - f x| := htri
            _ ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialApproxError R n a.1.val) + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := add_le_add hNerr hrem
            _ ≤ eps := herrBudget
  -- @step s4: Under the same active-cell condition, combine s1 and s2 with the triangle inequality to show |N_j x| ≤ A * ∑ a, R ^ a.1.val + A * ∑ a, centeredMonomialApproxError R n a.1, then apply houtputBudget to conclude |N_j x| ≤ productRadius
  have h_s4 : ∀ (g : Fin m → (Fin d → ℝ) → ℝ),
      (∀ (j : Fin m) (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
        |g j x -
            (∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j))| ≤
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError R n a.1.val)) →
      ∀ (j : Fin m) (x : Fin d → ℝ), domain x → |g j x| ≤ productRadius := by
        intro g hAppr j x hdom
        let Tj : ℝ := ∑ k ∈ Finset.range (r + 1), ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f (center j)) (fun _ : Fin k => x - center j)
        have hbox : ∀ q : Fin d, |x q - center j q| ≤ R := hdomain_coord j x hdom
        have hT : |Tj| ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := h_s2 j x hbox
        have hNerr : |g j x - Tj| ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialApproxError R n a.1.val) := hAppr j x hbox
        calc
          |g j x| = |(g j x - Tj) + Tj| := by
            simp
          _ ≤ |g j x - Tj| + |Tj| := abs_add_le (g j x - Tj) Tj
          _ ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialApproxError R n a.1.val) + A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := add_le_add hNerr hT
          _ ≤ productRadius := houtputBudget
  -- @step fin: assemble the existential witness from the four subclaims
  rcases h_s1 with ⟨localApprox, h_class, h_box⟩
  exact ⟨localApprox, h_class, h_s3 localApprox h_box, h_s4 localApprox h_box⟩

-- For any fixed function and finite center table, the finitely many ordered
-- Taylor coefficients up to order r admit one nonnegative real bound.
theorem finite_taylor_coefficient_table_admits_nonnegative_bound
    {d m r : ℕ}
    (f : (Fin d → ℝ) → ℝ)
    (center : Fin m → Fin d → ℝ) :
    ∃ A : ℝ, 0 ≤ A ∧
      ∀ j : Fin m,
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center j))
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A := by
  let β : Type := Fin m × Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
  let c : β → ℝ := fun p =>
    |((Nat.factorial p.2.1.val : ℝ)⁻¹) *
      (iteratedFDeriv ℝ p.2.1.val f (center p.1))
        (fun q : Fin p.2.1.val => fun u : Fin d => if u = p.2.2 q then 1 else 0)|
  let A : ℝ := ∑ p : β, c p
  refine ⟨A, ?_, ?_⟩
  · dsimp [A]
    exact Finset.sum_nonneg (fun p _ => abs_nonneg _)
  · intro j a
    dsimp [A]
    exact Finset.single_le_sum (s := Finset.univ) (f := c) (fun p _ => abs_nonneg _)
      (Finset.mem_univ (j, a))

theorem exists_unitCube_axisAlignedBoxTentWeight_partition_data
    (d K : ℕ) (hK : 0 < K) :
    ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d), 0 ≤ scale j q) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin ((K + 1) ^ d), axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ‖x - center j‖ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: Construct the tensor-grid indexing equivalence Fin ((K+1)^d) ≃ (Fin d → Fin (K+1)),
  --   define `center j q = (idx j q : ℝ) / K` and `scale j q = K`, and prove `0 ≤ scale j q` for all j and q.
  let eGrid : (Fin d → Fin (K + 1)) ≃ Fin ((K + 1) ^ d) :=
    (Fintype.equivFin (Fin d → Fin (K + 1))).trans (Equiv.cast (by simp [Fintype.card_fun, Fintype.card_fin]))
  let center : Fin ((K + 1) ^ d) → Fin d → ℝ :=
    fun j q => (((eGrid.symm j q : ℕ) : ℝ) / (K : ℝ))
  let scale : Fin ((K + 1) ^ d) → Fin d → ℝ :=
    fun _ _ => (K : ℝ)
  have h_s1 : ∀ (j : Fin ((K + 1) ^ d)) (q : Fin d), 0 ≤ scale j q := by
    intro j q
    simp [scale]

  -- @step s2: Prove the one-dimensional tent identity: for every coordinate q and every z ∈ [0,1],
  --   ∑ i : Fin (K+1), coordinateTentReLUFunction q ((i : ℝ) / K) K (fun _ : Fin d => z) = 1.
  have h_s2 : ∀ (q : Fin d) (z : ℝ), z ∈ Set.Icc (0 : ℝ) 1 →
      (∑ i : Fin (K + 1), coordinateTentReLUFunction q (((i : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) (fun _ : Fin d => z)) = 1 := by
        intro q z hz
        have hz0 : 0 ≤ z := (Set.mem_Icc.mp hz).1
        have hz1 : z ≤ 1 := (Set.mem_Icc.mp hz).2
        have hK_posR : (0 : ℝ) < (K : ℝ) := by exact_mod_cast hK
        have hK_neR : (K : ℝ) ≠ 0 := ne_of_gt hK_posR
        let t : ℝ := (K : ℝ) * z
        have ht0 : 0 ≤ t := by
          dsimp [t]
          exact mul_nonneg (le_of_lt hK_posR) hz0
        have hrelu_sum : ∀ a b : ℝ, b = -a → max a 0 + max b 0 = |a| := by
          intro a b hb
          rw [hb]
          by_cases ha : 0 ≤ a
          · rw [max_eq_left ha, abs_of_nonneg ha]
            have hma : max (-a) 0 = 0 := by
              rw [max_eq_right (by linarith)]
            rw [hma]
            ring
          · have ha_neg : a < 0 := lt_of_not_ge ha
            have hna : 0 ≤ -a := by linarith
