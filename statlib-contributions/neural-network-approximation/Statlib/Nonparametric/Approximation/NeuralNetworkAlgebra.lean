      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin ((K + 1) ^ d),
          Statlib.Nonparametric.Vocabulary.axisAlignedBoxTentWeight (center j) (scale j) x) = 1) := by
            let idx : Fin ((K + 1) ^ d) ≃ (Fin d → Fin (K + 1)) := by
