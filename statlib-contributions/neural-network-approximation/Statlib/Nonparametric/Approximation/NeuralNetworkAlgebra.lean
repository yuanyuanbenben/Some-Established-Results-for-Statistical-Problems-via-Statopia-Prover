  have hDsum_le : (s.sum (fun i => (Dnet i : ℝ))) ≤
      (s.sum (fun i => cDi i * ((degree i : ℝ) + 1))) * ((n : ℝ) + 1) := by
    calc
      (s.sum (fun i => (Dnet i : ℝ))) ≤
          s.sum (fun i => cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1)) := by
