/-- shallow ReLU final `L * W^2` display-rate packaging theorem from the
two-scale state-block premise.  The exponent is the squared sup-norm error
rate used by the paper-level risk statement. -/
private theorem holderSmoothBall_unitCube_ReLUApprox_LW2_rate_from_state_block
    {d r W0 Dblock : ℕ} {beta C B A cQuant cState : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0) (hDblock : 0 < Dblock)
    (hbeta_nonneg : 0 ≤ beta) (hsmooth_pos : 0 < ↑r + beta)
    (hC_nonneg : 0 ≤ C) (hB_nonneg : 0 ≤ B) (hA_nonneg : 0 ≤ A)
    (hcoeff : ∀ f ∈ holderSmoothBall r beta C B, ∀ y : Fin d → ℝ,
      (∀ q : Fin d, y q ∈ Set.Icc 0 1) →
      ∀ a : (k : Fin (r + 1)) × (Fin ↑k → Fin d),
        |((a.fst : ℕ).factorial : ℝ)⁻¹ * (iteratedFDeriv ℝ (a.fst : ℕ) f y) (fun q u => if u = a.snd q then 1 else 0)| ≤ A)
    (hcQuant : 0 < cQuant)
    (hcState_nonneg : 0 ≤ cState)
    (hquant : ∀ M : ℕ, 0 < M →
      ∃ (N Q base : ℕ) (eta Rdec : ℝ), 0 < eta ∧ 0 < Q ∧
        2 * A / ↑Q ≤ eta ∧ Q + 1 ≤ base ∧ 2 ≤ Rdec ∧
        ∃ e : (Fin ((M ^ 2 + 1) ^ d) × (k : Fin (r + 1)) × (Fin ↑k → Fin d)) ≃ Fin N,
          eta * ∑ a : (k : Fin (r + 1)) × (Fin ↑k → Fin d), (1 : ℝ) ^ (a.fst : ℕ) ≤
            cQuant * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))))
    (hstate : ∀ (M N Q base code floorBound : ℕ) (eta Rdec : ℝ),
      0 < M → 0 < eta → 0 < Q → 2 * A / ↑Q ≤ eta → Q + 1 ≤ base → 2 ≤ Rdec →
      ∀ (e : (Fin ((M ^ 2 + 1) ^ d) × (k : Fin (r + 1)) × (Fin ↑k → Fin d)) ≃ Fin N)
        (center scale : Fin ((M ^ 2 + 1) ^ d) → Fin d → ℝ),
        (∀ (j : Fin ((M ^ 2 + 1) ^ d)) (q : Fin d), 0 ≤ scale j q) →
        (∀ (j : Fin ((M ^ 2 + 1) ^ d)) (q : Fin d), center j q ∈ Set.Icc 0 1) →
        (∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc 0 1) →
          (∑ j : Fin ((M ^ 2 + 1) ^ d), axisAlignedBoxTentWeight (center j) (scale j) x) = 1) →
        ∀ digit : Fin N → ℕ,
          (∀ k : Fin N, digit k ≤ Q) → (∀ k : Fin N, digit k < base) →
          code = ∑ k : Fin N, digit k * base ^ (k : ℕ) → floorBound = code + 1 →
          ∀ decoded : Fin ((M ^ 2 + 1) ^ d) → (k : Fin (r + 1)) × (Fin ↑k → Fin d) → ℝ,
            (∀ (j : Fin ((M ^ 2 + 1) ^ d)) (a : (k : Fin (r + 1)) × (Fin ↑k → Fin d)),
              decoded j a = -A + 2 * A / ↑Q * ↑(digit (e (j, a)))) →
            (∀ (j : Fin ((M ^ 2 + 1) ^ d)) (a : (k : Fin (r + 1)) × (Fin ↑k → Fin d)),
              |decoded j a| ≤ A + eta) →
            (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
              reluNetworkClass 1 1 (2 * floorBound) (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) →
            (∀ k : Fin N,
              have readout : ℝ := ↑(code / base ^ (k : ℕ)) + 1 / 2;
              0 ≤ readout ∧ readout < ↑floorBound + 1 ∧
                awayFromFiniteIntegerGrid Rdec floorBound readout ∧
                ⌊readout⌋₊ = code / base ^ (k : ℕ) ∧
                truncatedFloorReLUFunction Rdec floorBound readout = ↑(code / base ^ (k : ℕ)) ∧
                ⌊truncatedFloorReLUFunction Rdec floorBound readout⌋₊ % base = digit k) →
            ∃ D P : ℕ, D = M ^ d * (Dblock + 1) ∧ 0 < D ∧
              P = fullyConnectedReLUParameterCount d D W0 ∧
              ∃ g ∈ reluNetworkClass d D W0 P, ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc 0 1) →
                |g x - (∑ j : Fin ((M ^ 2 + 1) ^ d),
                    axisAlignedBoxTentWeight (center j) (scale j) x *
                    finiteLinearCombination Finset.univ (decoded j)
                      (fun a y => ∏ q : Fin (↑a.fst), (y (a.snd q) - center j (a.snd q))) x)|
                  ≤ cState * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))))
    : ∃ cRate : ℝ, 0 < cRate ∧
        ∀ M : ℕ, 0 < M →
          ∃ L W P : ℕ, 0 < L ∧ 0 < W ∧
            P = fullyConnectedReLUParameterCount d L W ∧
            ∀ f ∈ holderSmoothBall r beta C B, ∃ g ∈ reluNetworkClass d L W P,
              ∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc 0 1) →
                |g x - f x| ≤ cRate * (((L : ℝ) * (W : ℝ) ^ 2) : ℝ).rpow (-(2 * ((r : ℝ) + beta) / (d : ℝ))) := by
  rcases holderSmoothBall_unitCube_twoScale_decoded_fixed_width_M_rate_from_state_block
      hd hW0 hDblock hbeta_nonneg hsmooth_pos hC_nonneg hB_nonneg hA_nonneg hcoeff
      hcQuant hcState_nonneg hquant hstate with ⟨cDepth, cErr, hcDepth_pos, hcErr_pos, hMrate⟩
  exact holderSmoothBall_unitCube_LW2_rate_from_fixed_width_M_rate hd hW0 hbeta_nonneg
    hsmooth_pos hcDepth_pos hcErr_pos hMrate

/-- Uniform per-block and per-fine-cell error bounds imply the component-rate
sum bounds used in the shallow ReLU per-block evaluator schedule.

Proof route: bound the coefficient sum by summing `hcoeff_le`; rewrite the
constant sum over `Fin coarse` as `(coarse : Real) * coeffBudget`.  Bound the
local/tent double sum by summing `hlocTent_le` first over `Fin T`, then over
`Fin coarse`, rewriting the constant double sum as
`(coarse : Real) * (T : Real) * locTentBudget`.  Finish with the two supplied
scalar budget inequalities. -/
private theorem reluApprox_component_rate_sums_from_uniform_cell_bounds
    {coarse T M r : Nat} {beta Kcoeff KlocTent coeffBudget locTentBudget : Real}
    (coeffAccErr : Fin coarse -> Real)
    (locErr tentErr : Fin coarse -> Fin T -> Real)
    (hcoeff_le : forall b : Fin coarse, coeffAccErr b <= coeffBudget)
    (hlocTent_le : forall (b : Fin coarse) (i : Fin T),
      locErr b i + tentErr b i <= locTentBudget)
    (hcoeffBudget :
      (coarse : Real) * coeffBudget <= Kcoeff * shallowReLUResolutionRate M r beta)
    (hlocTentBudget :
      (coarse : Real) * (T : Real) * locTentBudget <=
        KlocTent * shallowReLUResolutionRate M r beta) :
    Finset.univ.sum (fun b : Fin coarse => coeffAccErr b) <=
        Kcoeff * shallowReLUResolutionRate M r beta /\
      Finset.univ.sum (fun b : Fin coarse =>
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
        KlocTent * shallowReLUResolutionRate M r beta := by
  constructor
  · have hsum1 : Finset.univ.sum (fun b : Fin coarse => coeffAccErr b) ≤
        Finset.univ.sum (fun _ : Fin coarse => coeffBudget) := by
      exact Finset.sum_le_sum (fun b _hb => hcoeff_le b)
    have hsum2 : Finset.univ.sum (fun _ : Fin coarse => coeffBudget) =
        (coarse : Real) * coeffBudget := by
      rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin]
    exact le_trans (le_trans hsum1 (le_of_eq hsum2)) hcoeffBudget
  · have hpoint : ∀ b : Fin coarse,
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i) ≤
          (T : Real) * locTentBudget := by
      intro b
      have hin1 : Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i) ≤
          Finset.univ.sum (fun _ : Fin T => locTentBudget) := by
        exact Finset.sum_le_sum (fun i _hi => hlocTent_le b i)
      have hin2 : Finset.univ.sum (fun _ : Fin T => locTentBudget) =
          (T : Real) * locTentBudget := by
        rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin]
      exact le_trans hin1 (le_of_eq hin2)
    have hsum3 :
        Finset.univ.sum (fun b : Fin coarse =>
          Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) ≤
          Finset.univ.sum (fun _ : Fin coarse => (T : Real) * locTentBudget) := by
      exact Finset.sum_le_sum (fun b _hb => hpoint b)
    have hsum4 : Finset.univ.sum (fun _ : Fin coarse =>
        (T : Real) * locTentBudget) =
        (coarse : Real) * ((T : Real) * locTentBudget) := by
      rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin]
    have hreassoc : (coarse : Real) * ((T : Real) * locTentBudget) =
        (coarse : Real) * (T : Real) * locTentBudget := by
      ring
    exact le_trans (le_trans (le_trans hsum3 (le_of_eq hsum4)) (le_of_eq hreassoc))
      hlocTentBudget

/-- Exact component schedule interface consumed by the promoted wave75 bridge. -/
private abbrev ReLUApproxExactComponentSchedule
    (d r W0 Dblock : Nat) (beta A cState : Real) : Prop :=
  forall (M N Q base code floorBound : Nat) (eta Rdec : Real),
    0 < M ->
