              rcases hcenter_mem j q with ⟨hc0, hc1⟩
              rw [abs_le]
              constructor <;> linarith
            refine ⟨center, scale, hscale_nonneg, hcenter_mem, hcoarse, ?_⟩
            intro x hx
            let phi : Fin (K + 1) → ℝ → ℝ := fun a t =>
