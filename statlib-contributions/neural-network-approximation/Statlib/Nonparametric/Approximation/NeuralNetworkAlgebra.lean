                                rw [hnegsum]
                                ring
                          _ = -((update r).apply S aP) := by rfl
                      have hstateP : N.hiddenState x ((k + 1) * (D0 + 1)) aP = (update r).reluApply S aP := by
                        rw [hkm]
                        simp [FullyConnectedReLUNet.hiddenState, hrecD, hblockD, hblkD, S]
                      have hstateM : N.hiddenState x ((k + 1) * (D0 + 1)) aM = (update r).reluApply S aM := by
                        rw [hkm]
                        simp [FullyConnectedReLUNet.hiddenState, hrecD, hblockD, hblkD, S]
                      calc
                        N.hiddenState x ((k + 1) * (D0 + 1)) aP - N.hiddenState x ((k + 1) * (D0 + 1)) aM
                            = (update r).reluApply S aP - (update r).reluApply S aM := by
                                rw [hstateP, hstateM]
                        _ = max ((update r).apply S aP) 0 - max ((update r).apply S aM) 0 := by
                                simp [DenseLayer.reluApply, reluVec, relu]
                        _ = max ((update r).apply S aP) 0 - max (-((update r).apply S aP)) 0 := by
                                rw [hupM]
                        _ = (update r).apply S aP := by
                                exact h_relu_sub ((update r).apply S aP)
                        _ = z := hupP
                        _ = (N.hiddenState x (k * (D0 + 1)) aP - N.hiddenState x (k * (D0 + 1)) aM) + coeff r * (B r).realize x := by
                                dsimp [z]
                                rw [hSP, hSM]
                    have hcasteq : ∀ i : Fin k, Fin.castLE hk i.castSucc = Fin.castLE hk' i := by
                      intro i
                      apply Fin.ext
                      change (i.castSucc).1 = i.1
                      simp
                    have hsumk : (∑ j : Fin k, coeff (e.symm (Fin.castLE hk' j)).1 * (B (e.symm (Fin.castLE hk' j)).1).realize x) =
                        ∑ i : Fin k, coeff (e.symm (Fin.castLE hk i.castSucc)).1 * (B (e.symm (Fin.castLE hk i.castSucc)).1).realize x := by
                      apply Finset.sum_congr rfl
                      intro i hi
                      rw [hcasteq i]
                    have hlast : Fin.castLE hk (Fin.last k) = ⟨k, hklt⟩ := by
                      apply Fin.ext
                      simp [Fin.castLE]
                    have hterm : coeff (e.symm (Fin.castLE hk (Fin.last k))).1 * (B (e.symm (Fin.castLE hk (Fin.last k))).1).realize x = coeff r * (B r).realize x := by
                      rw [hlast]
                    rw [hupdate, hik, Fin.sum_univ_castSucc, hsumk, hterm]
              -- (9) the readout equals the finite linear combination over s
              have h_cast_refl : ∀ (h : n ≤ n) (j : Fin n), Fin.castLE h j = j := by
                intro h j
                apply Fin.ext
                rfl
              have h_reindex : (∑ j : Fin n, coeff (e.symm j).1 * (B (e.symm j).1).realize x) =
                  ∑ r ∈ s, coeff r * (B r).realize x := by
                let f : Fin n → ℝ := fun j => coeff (e.symm j).1 * (B (e.symm j).1).realize x
                let g : ι → ℝ := fun r => coeff r * (B r).realize x
                have hbij : (∑ j ∈ (Finset.univ : Finset (Fin n)), f j) = ∑ r ∈ s, g r := by
                  refine Finset.sum_bij (s := Finset.univ) (t := s) (f := f) (g := g)
                    (fun j hj => (e.symm j).1) ?_ ?_ ?_ ?_
                  · intro j hj
                    exact (e.symm j).2
                  · intro j1 hj1 j2 hj2 h
                    exact e.symm.injective (Subtype.ext h)
                  · intro r hr
                    refine ⟨e ⟨r, hr⟩, by simp, ?_⟩
                    simp
                  · intro j hj
                    rfl
                simpa [f, g] using hbij
              have h_realize_comb : N.realize x =
                  finiteLinearCombination s coeff (fun r y => (B r).realize y) x := by
                rw [h_realize]
                rw [h_acc n le_rfl]
                simp [h_cast_refl, finiteLinearCombination]
                rw [← h_reindex]

              exact h_realize_comb
    -- @step s3: instantiate the serial lemma with Finset.univ and the s1 witnesses; verify the five conjuncts
    have h_final : ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
        N.width ≤ 2 * d + W0 + 3 ∧
        N.parameterCount ≤ fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) ∧
        ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x := by
          classical
          let B : ι → FullyConnectedReLUNet d := fun i => Classical.choose (h_witness i)
          have hBdepth : ∀ i : ι, (B i).depth ≤ D0 := by
            intro i
            exact (Classical.choose_spec (h_witness i)).2.1
          have hBwidth : ∀ i : ι, (B i).width ≤ W0 := by
            intro i
            exact (Classical.choose_spec (h_witness i)).2.2.1
          have hBrealize : ∀ i : ι, ∀ x : Fin d → ℝ, approx i x = (B i).realize x := by
            intro i x
            exact (Classical.choose_spec (h_witness i)).2.2.2.2 x
          rcases h_serial Finset.univ B (fun r _hr => hBdepth r) (fun r _hr => hBwidth r) with
            ⟨N, hNdepth, hNwidth, hNparam, hNrealize⟩
          have hpos : 0 < N.depth := by
            rw [hNdepth]
            omega
          have hdepth_le : N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) := by
            rw [hNdepth, Finset.card_univ, Nat.add_mul, one_mul]
            omega
          have hwidth_le : N.width ≤ 2 * d + W0 + 3 := by
            rw [hNwidth]
          have hparam_le : N.parameterCount ≤ fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) := by
            rw [hNparam, hNwidth]
            unfold fullyConnectedReLUParameterCount
            have hsub : N.depth - 1 ≤ ((Fintype.card ι + 1) * (D0 + 1)) - 1 := by
              omega
            have hmul : (N.depth - 1) * (((2 * d + W0 + 3) + 1) * (2 * d + W0 + 3)) ≤
                (((Fintype.card ι + 1) * (D0 + 1)) - 1) * (((2 * d + W0 + 3) + 1) * (2 * d + W0 + 3)) := by
              exact Nat.mul_le_mul_right _ hsub
            have hmono : (d + 1) * (2 * d + W0 + 3) + (N.depth - 1) * (((2 * d + W0 + 3) + 1) * (2 * d + W0 + 3)) ≤
                (d + 1) * (2 * d + W0 + 3) + (((Fintype.card ι + 1) * (D0 + 1)) - 1) * (((2 * d + W0 + 3) + 1) * (2 * d + W0 + 3)) := by
              exact Nat.add_le_add_left hmul ((d + 1) * (2 * d + W0 + 3))
            exact Nat.add_le_add_right hmono ((2 * d + W0 + 3) + 1)
          have hrealize : ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x := by
            intro x
            rw [hNrealize]
            simp [finiteLinearCombination, hBrealize]
          exact ⟨N, hpos, hdepth_le, hwidth_le, hparam_le, hrealize⟩
    exact h_final
  -- @step s2: from the s1 bounds, membership of N.realize in the reluNetworkClass with
  -- depth D = (card ι + 1) * (D0 + 1) and parameter budget P = parameterCount d D (2*d+W0+3).
  have h_mem : ∀ N : FullyConnectedReLUNet d,
      0 < N.depth →
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) →
      N.width ≤ 2 * d + W0 + 3 →
      N.parameterCount ≤ fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) →
      N.realize ∈ reluNetworkClass d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3)
        (fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3)) := by
    intro N hpos hdepth hwidth hparam
    rw [reluNetworkClass]
    exact ⟨N, hpos, hdepth, hwidth, hparam, fun x => rfl⟩
  -- @step s3: approximation bound — rewrite g x via s1, then finite-sum triangle inequality,
  -- |a*b| = |a|*|b|, herr termwise, and heps.
  have h_approx : ∀ N : FullyConnectedReLUNet d,
      (∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x) →
      ∀ x : Fin d → ℝ, domain x →
        |N.realize x - (∑ i : ι, coeff i * target i x)| ≤ ∑ i : ι, |coeff i| * eps i := by
    intro N hN x hx
    rw [hN x]
    calc
      |(∑ i : ι, coeff i * approx i x) - (∑ i : ι, coeff i * target i x)|
          ≤ ∑ i : ι, |coeff i * approx i x - coeff i * target i x| := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.abs_sum_le_sum_abs _ _
      _ = ∑ i : ι, |coeff i| * |approx i x - target i x| := by
            apply Finset.sum_congr rfl
            intro i hi
            rw [← mul_sub, abs_mul]
      _ ≤ ∑ i : ι, |coeff i| * eps i := by
            apply Finset.sum_le_sum
            intro i hi
            exact mul_le_mul_of_nonneg_left (herr i x hx) (abs_nonneg (coeff i))
  -- finisher: choose cDepth = 1, D = (card ι + 1) * (D0 + 1), P = parameterCount, g = N.realize.
  rcases h_comb with ⟨N, hN_pos, hN_depth, hN_width, hN_params, hN_eq⟩
  refine ⟨(1 : ℝ), by norm_num, ⟨(Fintype.card ι + 1) * (D0 + 1),
    fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3),
    by positivity,
    by simpa [Nat.cast_add, Nat.cast_mul, Nat.cast_one, one_mul, mul_assoc], rfl,
    ⟨N.realize, h_mem N hN_pos hN_depth hN_width hN_params, h_approx N hN_eq⟩⟩⟩


theorem exists_reluNetworkClass_mul_fixed_width_depth_rate_on_box :
    ∃ Wmul : ℕ, 0 < Wmul ∧
      ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * (n : ℝ) ∧
            P = Statlib.Nonparametric.Vocabulary.fullyConnectedReLUParameterCount 2 D Wmul ∧
            ∃ g : (Fin 2 → ℝ) → ℝ,
              g ∈ Statlib.Nonparametric.Vocabulary.reluNetworkClass 2 D Wmul P ∧
                ∀ x : Fin 2 → ℝ,
                  |x 0| ≤ R → |x 1| ≤ R →
                    |g x - x 0 * x 1| ≤ cErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) := by
  rcases Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_reluNetworkClass_unitInterval_square_fixed_width_depth_rate with
    ⟨W0, hW0pos, cDepth0, cErr0, hcDepth0, hcErr0, hE4⟩
  let Wmul : ℕ := 2 * W0 + 4
  let cDepth : ℝ := cDepth0
  let cErr : ℝ := 8 * cErr0
  refine ⟨Wmul, ?_, cDepth, cErr, ?_, ?_, ?_⟩
  · dsimp [Wmul]
    omega
  · dsimp [cDepth]
    exact hcDepth0
  · dsimp [cErr]
    positivity
  · intro n hn R hR
    rcases hE4 n hn with ⟨D, P0, hDpos, hDle, hP0, g, hgclass, hg⟩
    refine ⟨D, fullyConnectedReLUParameterCount 2 D Wmul, hDpos, ?_, rfl, ?_⟩
    · dsimp [cDepth]
      exact hDle
    · let s1 : (Fin 2 → ℝ) → ℝ := fun x => (x 0 + x 1) / (4 * R) + 1 / 2
      let s2 : (Fin 2 → ℝ) → ℝ := fun x => (x 0 - x 1) / (4 * R) + 1 / 2
      let approx1 : (Fin 2 → ℝ) → ℝ := fun x => g (fun _ : Fin 1 => s1 x)
      let approx2 : (Fin 2 → ℝ) → ℝ := fun x => g (fun _ : Fin 1 => s2 x)
      let coeff : Fin 4 → ℝ := fun i =>
        if i = 0 then 4 * R ^ 2 else if i = 1 then -(4 * R ^ 2) else if i = 2 then -(4 * R ^ 2) else 4 * R ^ 2
      let target : Fin 4 → (Fin 2 → ℝ) → ℝ := fun i =>
        if i = 0 then fun x => (s1 x) ^ 2
        else if i = 1 then fun x => (s2 x) ^ 2
        else if i = 2 then fun x => s1 x
        else fun x => s2 x
      let approx : Fin 4 → (Fin 2 → ℝ) → ℝ := fun i =>
        if i = 0 then approx1
        else if i = 1 then approx2
        else if i = 2 then fun x => s1 x
        else fun x => s2 x
      let eps : Fin 4 → ℝ := fun i =>
        if i = 0 then cErr0 * (n : ℝ).rpow (-2)
        else if i = 1 then cErr0 * (n : ℝ).rpow (-2)
        else if i = 2 then 0
        else 0
      let widthOf : Fin 4 → ℕ := fun i =>
        if i = 0 then W0 else if i = 1 then W0 else if i = 2 then 2 else 2
      let parameterOf : Fin 4 → ℕ := fun i =>
        if i = 0 then P0 + W0
        else if i = 1 then P0 + W0
        else if i = 2 then fullyConnectedReLUParameterCount 2 1 2
        else fullyConnectedReLUParameterCount 2 1 2
      have hrelu_ident : ∀ t : ℝ, relu t - relu (-t) = t := by
        intro t
        unfold relu
        by_cases ht : 0 ≤ t
        · have hneg : -t ≤ 0 := by linarith
          rw [max_eq_left ht, max_eq_right hneg]
          ring
        · have ht' : t ≤ 0 := le_of_not_ge ht
          have hneg : 0 ≤ -t := by linarith
          rw [max_eq_right ht', max_eq_left hneg]
          ring
      have hprecomp : ∀ (f : (Fin 1 → ℝ) → ℝ), f ∈ reluNetworkClass 1 D W0 P0 →
          ∀ (c0 c1 c : ℝ),
            (fun x : Fin 2 → ℝ => f (fun _ : Fin 1 => c0 * x 0 + c1 * x 1 + c)) ∈
              reluNetworkClass 2 D W0 (P0 + W0) := by
        intro f hf c0 c1 c
        rcases hf with ⟨N, hNdepth, hNdD, hNw, hNp, hNreal⟩
        let N' : FullyConnectedReLUNet 2 :=
          { depth := N.depth
            width := N.width
            input :=
              { weight := fun j i => N.input.weight j 0 * (if i = 0 then c0 else c1)
                bias := fun j => N.input.weight j 0 * c + N.input.bias j }
            hidden := N.hidden
            outputWeight := N.outputWeight
            outputBias := N.outputBias }
        refine ⟨N', hNdepth, hNdD, hNw, ?_, ?_⟩
        · change fullyConnectedReLUParameterCount 2 N.depth N.width ≤ P0 + W0
          have hX : ∀ (X : ℕ), (2 + 1) * N.width + X + (N.width + 1) =
              (1 + 1) * N.width + X + (N.width + 1) + N.width := by
            intro X
            omega
          have hpc : fullyConnectedReLUParameterCount 2 N.depth N.width =
              fullyConnectedReLUParameterCount 1 N.depth N.width + N.width := by
            unfold fullyConnectedReLUParameterCount
            exact hX ((N.depth - 1) * ((N.width + 1) * N.width))
          rw [hpc]
          have hNp' : fullyConnectedReLUParameterCount 1 N.depth N.width ≤ P0 := by
            simpa [FullyConnectedReLUNet.parameterCount] using hNp
          omega
        · intro x
          let y : Fin 1 → ℝ := fun _ => c0 * x 0 + c1 * x 1 + c
          have hhh : ∀ t : ℕ, t < N.depth → hiddenState N' x t = hiddenState N y t := by
            intro t
            induction t with
            | zero =>
                intro ht
                change N'.input.reluApply x = N.input.reluApply y
                funext j
                change reluVec (N'.input.apply x) j = reluVec (N.input.apply y) j
                simp only [reluVec]
                apply congrArg relu
                change (∑ i : Fin 2, N'.input.weight j i * x i) + N'.input.bias j =
                  (∑ i : Fin 1, N.input.weight j i * y i) + N.input.bias j
                simp [N', y, Fin.sum_univ_two, Fin.sum_univ_one] <;> ring
            | succ t ih =>
                intro ht
                have ht' : t < N.depth - 1 := by omega
                have ih' : hiddenState N' x t = hiddenState N y t :=
                  ih (lt_of_le_of_lt (Nat.le_succ t) ht)
                rw [hiddenState, hiddenState]
                simp [N', ht', ih']
          calc
            (fun x : Fin 2 → ℝ => f (fun _ : Fin 1 => c0 * x 0 + c1 * x 1 + c)) x = f y := rfl
            _ = N.realize y := hNreal y
            _ = N'.realize x := by
              rw [realize, realize]
              congr 1
              · apply Finset.sum_congr rfl
                intro j hj
                change N.outputWeight j * N.hiddenState y (N.depth - 1) j =
                  N'.outputWeight j * N'.hiddenState x (N.depth - 1) j
                rw [show N'.outputWeight j = N.outputWeight j by rfl]
                exact congrArg (fun t : ℝ => N.outputWeight j * t)
                  (congrFun (hhh (N.depth - 1) (by omega)) j).symm
      have haff : ∀ (c0 c1 c : ℝ),
          (fun x : Fin 2 → ℝ => c0 * x 0 + c1 * x 1 + c) ∈
            reluNetworkClass 2 D 2 (fullyConnectedReLUParameterCount 2 1 2) := by
        intro c0 c1 c
        let Naff : FullyConnectedReLUNet 2 :=
          { depth := 1
            width := 2
            input :=
              { weight := fun j i =>
                  if j = 0 then (if i = 0 then c0 else c1) else (if i = 0 then -c0 else -c1)
                bias := fun j => if j = 0 then c else -c }
            hidden := fun i => Fin.elim0 i
            outputWeight := fun j => if j = 0 then 1 else -1
            outputBias := 0 }
        refine ⟨Naff, by norm_num, hDpos, by norm_num, le_rfl, ?_⟩
        intro x
        let t : ℝ := c0 * x 0 + c1 * x 1 + c
        have h0 : DenseLayer.apply Naff.input x 0 = t := by
          simp [Naff, DenseLayer.apply, t, Fin.sum_univ_two] <;> ring
        have h1 : DenseLayer.apply Naff.input x 1 = -t := by
          simp [Naff, DenseLayer.apply, t, Fin.sum_univ_two] <;> ring
        calc
          c0 * x 0 + c1 * x 1 + c = t := rfl
          _ = relu t - relu (-t) := (hrelu_ident t).symm
          _ = relu (DenseLayer.apply Naff.input x 0) - relu (DenseLayer.apply Naff.input x 1) := by
            rw [h0, h1]
          _ = reluVec (DenseLayer.apply Naff.input x) 0 + -reluVec (DenseLayer.apply Naff.input x) 1 := by
            simp [reluVec] <;> ring
          _ = Naff.realize x := by
            simp [Naff, realize, hiddenState, DenseLayer.reluApply, DenseLayer.apply, Fin.sum_univ_two] <;> ring
      have hs1eq : ∀ x : Fin 2 → ℝ,
          s1 x = (1 / (4 * R)) * x 0 + (1 / (4 * R)) * x 1 + 1 / 2 := by
        intro x
        dsimp [s1]
        ring_nf
      have hs2eq : ∀ x : Fin 2 → ℝ,
          s2 x = (1 / (4 * R)) * x 0 + (-(1 / (4 * R))) * x 1 + 1 / 2 := by
        intro x
        dsimp [s2]
        ring_nf
      have hs1 : ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R → s1 x ∈ Set.Icc 0 1 := by
        intro x hx0 hx1
        have hx0lo : -R ≤ x 0 := (abs_le.mp hx0).1
        have hx1lo : -R ≤ x 1 := (abs_le.mp hx1).1
        have hx0hi : x 0 ≤ R := (abs_le.mp hx0).2
        have hx1hi : x 1 ≤ R := (abs_le.mp hx1).2
        have hsum_ge : -(2 * R) ≤ x 0 + x 1 := by linarith
        have hsum_le : x 0 + x 1 ≤ 2 * R := by linarith
        have hdiv_ge : -(1 / 2) ≤ (x 0 + x 1) / (4 * R) := by
          rw [le_div_iff₀ (by positivity : 0 < 4 * R)]
          linarith
        have hdiv_le : (x 0 + x 1) / (4 * R) ≤ 1 / 2 := by
          rw [div_le_iff₀ (by positivity : 0 < 4 * R)]
          linarith
        constructor
        · dsimp [s1]
          linarith
        · dsimp [s1]
          linarith
      have hs2 : ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R → s2 x ∈ Set.Icc 0 1 := by
        intro x hx0 hx1
        have hx0lo : -R ≤ x 0 := (abs_le.mp hx0).1
        have hx1lo : -R ≤ x 1 := (abs_le.mp hx1).1
        have hx0hi : x 0 ≤ R := (abs_le.mp hx0).2
        have hx1hi : x 1 ≤ R := (abs_le.mp hx1).2
        have hdsum_ge : -(2 * R) ≤ x 0 - x 1 := by linarith
        have hdsum_le : x 0 - x 1 ≤ 2 * R := by linarith
        have hdiv_ge : -(1 / 2) ≤ (x 0 - x 1) / (4 * R) := by
          rw [le_div_iff₀ (by positivity : 0 < 4 * R)]
          linarith
        have hdiv_le : (x 0 - x 1) / (4 * R) ≤ 1 / 2 := by
          rw [div_le_iff₀ (by positivity : 0 < 4 * R)]
          linarith
        constructor
        · dsimp [s2]
          linarith
        · dsimp [s2]
          linarith
      have hident : ∀ x : Fin 2 → ℝ,
          coeff 0 * target 0 x + coeff 1 * target 1 x + coeff 2 * target 2 x + coeff 3 * target 3 x = x 0 * x 1 := by
        intro x
        simp [coeff, target]
        dsimp [s1, s2]
        field_simp [hR.ne']
        ring
      have hmem1 : (fun x : Fin 2 → ℝ => g (fun _ : Fin 1 => s1 x)) ∈
          reluNetworkClass 2 D W0 (P0 + W0) := by
        have h1 : (fun x : Fin 2 → ℝ => g (fun _ : Fin 1 => (1 / (4 * R)) * x 0 + (1 / (4 * R)) * x 1 + 1 / 2)) ∈
            reluNetworkClass 2 D W0 (P0 + W0) :=
          hprecomp g hgclass (1 / (4 * R)) (1 / (4 * R)) (1 / 2)
        simpa [hs1eq] using h1
      have hmem2 : (fun x : Fin 2 → ℝ => g (fun _ : Fin 1 => s2 x)) ∈
          reluNetworkClass 2 D W0 (P0 + W0) := by
        have h1 : (fun x : Fin 2 → ℝ => g (fun _ : Fin 1 => (1 / (4 * R)) * x 0 + (-(1 / (4 * R))) * x 1 + 1 / 2)) ∈
            reluNetworkClass 2 D W0 (P0 + W0) :=
          hprecomp g hgclass (1 / (4 * R)) (-(1 / (4 * R))) (1 / 2)
        simpa [hs2eq] using h1
      have herr1 : ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R →
          |g (fun _ : Fin 1 => s1 x) - (s1 x) ^ 2| ≤ cErr0 * (n : ℝ).rpow (-2) := by
        intro x hx0 hx1
        exact hg (fun _ : Fin 1 => s1 x) (hs1 x hx0 hx1)
      have herr2 : ∀ x : Fin 2 → ℝ, |x 0| ≤ R → |x 1| ≤ R →
          |g (fun _ : Fin 1 => s2 x) - (s2 x) ^ 2| ≤ cErr0 * (n : ℝ).rpow (-2) := by
        intro x hx0 hx1
        exact hg (fun _ : Fin 1 => s2 x) (hs2 x hx0 hx1)
      have hmem : ∀ r : Fin 4, approx r ∈ reluNetworkClass 2 D (widthOf r) (parameterOf r) := by
        intro r
        fin_cases r
        · simpa [approx, widthOf, parameterOf] using hmem1
        · simpa [approx, widthOf, parameterOf] using hmem2
        · simpa [approx, widthOf, parameterOf, hs1eq] using haff (1 / (4 * R)) (1 / (4 * R)) (1 / 2)
        · simpa [approx, widthOf, parameterOf, hs2eq] using haff (1 / (4 * R)) (-(1 / (4 * R))) (1 / 2)
      have herr : ∀ (r : Fin 4) (x : Fin 2 → ℝ), r ∈ Finset.univ → (|x 0| ≤ R ∧ |x 1| ≤ R) →
          |approx r x - target r x| ≤ eps r := by
        intro r x hr hbox
        fin_cases r
        · simpa [approx, target, eps] using herr1 x hbox.1 hbox.2
        · simpa [approx, target, eps] using herr2 x hbox.1 hbox.2
        · simp [approx, target, eps]
        · simp [approx, target, eps]
      have heps : ∀ r : Fin 4, 0 ≤ eps r := by
        intro r
        fin_cases r <;> simp [eps]
        · have hpow : 0 ≤ ((n : ℝ) ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg (n : ℝ))
          exact mul_nonneg (le_of_lt hcErr0) hpow
        · have hpow : 0 ≤ ((n : ℝ) ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg (n : ℝ))
          exact mul_nonneg (le_of_lt hcErr0) hpow
      have hsumW : (∑ r : Fin 4, widthOf r) = Wmul := by
        simp [widthOf, Wmul, Fin.sum_univ_four]
        omega
      have hwidth : (∑ r : Fin 4, widthOf r) ≤ Wmul := le_of_eq hsumW
      have hparam : fullyConnectedReLUParameterCount 2 D (∑ r : Fin 4, widthOf r) ≤
          fullyConnectedReLUParameterCount 2 D Wmul := by
        rw [hsumW]
      have hcomb := Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
        (d := 2) (D := D) (widthBudget := Wmul)
        (parameterBudget := fullyConnectedReLUParameterCount 2 D Wmul)
        (P := fun x : Fin 2 → ℝ => |x 0| ≤ R ∧ |x 1| ≤ R)
        hDpos Finset.univ coeff target approx eps widthOf parameterOf
        (by intro r hr; exact heps r)
        (by intro r hr; exact hmem r)
        (by simpa using hwidth)
        (by simpa using hparam)
        (by intro r hr x hbox; exact herr r x hr hbox)
      rcases hcomb with ⟨g, hgmem, hgbound⟩
      have hsum_eps : (∑ r : Fin 4, |coeff r| * eps r) = cErr * R ^ 2 * (n : ℝ).rpow (-2) := by
        rw [Fin.sum_univ_four]
        simp [coeff, eps, cErr] <;> ring
      have hsum : (∑ r ∈ Finset.univ, |coeff r| * eps r) = cErr * R ^ 2 * (n : ℝ).rpow (-2) := by
        simpa using hsum_eps
      have hcomb_id : ∀ x : Fin 2 → ℝ, finiteLinearCombination Finset.univ coeff target x = x 0 * x 1 := by
        intro x
        simpa [finiteLinearCombination, Fin.sum_univ_four] using hident x
      have hmain : ∀ x : Fin 2 → ℝ, (|x 0| ≤ R ∧ |x 1| ≤ R) →
          |g x - finiteLinearCombination Finset.univ coeff target x| ≤ cErr * R ^ 2 * (n : ℝ).rpow (-2) := by
        intro x hbox
        exact (hgbound x hbox).trans (le_of_eq hsum)
      refine ⟨g, hgmem, ?_⟩
      intro x hx0 hx1
      rw [← hcomb_id x]
      exact hmain x ⟨hx0, hx1⟩


theorem exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget
    {d Df Dg Wf Wg Pf Pg Wmul : ℕ}
    (hDf : 0 < Df) (hDg : 0 < Dg)
    (hWf : 0 < Wf) (hWg : 0 < Wg) (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    {domain : (Fin d → ℝ) → Prop}
    {targetF targetG approxF approxG : (Fin d → ℝ) → ℝ}
    {ηf ηg R : ℝ}
    (hηf : 0 ≤ ηf) (hηg : 0 ≤ ηg) (hR : 0 < R)
    (hclassF : approxF ∈ reluNetworkClass d Df Wf Pf)
    (hclassG : approxG ∈ reluNetworkClass d Dg Wg Pg)
    (happroxF_bound : ∀ x : Fin d → ℝ, domain x → |approxF x| ≤ R)
    (happroxG_bound : ∀ x : Fin d → ℝ, domain x → |approxG x| ≤ R)
    (htargetG_bound : ∀ x : Fin d → ℝ, domain x → |targetG x| ≤ R)
    (happroxF_err : ∀ x : Fin d → ℝ, domain x →
      |approxF x - targetF x| ≤ ηf)
    (happroxG_err : ∀ x : Fin d → ℝ, domain x →
      |approxG x - targetG x| ≤ ηg) :
    ∃ cDepth : ℝ, 0 < cDepth ∧
      ∀ n : ℕ, 0 < n →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤
            cDepth * ((Nat.max Df Dg : ℝ) + (n : ℝ) + 1) ∧
          P = fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul) ∧
          ∃ h : (Fin d → ℝ) → ℝ,
            h ∈ reluNetworkClass d D (Wf + Wg + Wmul) P ∧
              ∀ x : Fin d → ℝ, domain x →
                |h x - targetF x * targetG x| ≤
                  cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) +
                    R * ηg + R * ηf := by
  refine ⟨cMulDepth + 1, ?_, ?_⟩
  · linarith [hcMulDepth]
  · intro n hn
    rcases hmul n hn R hR with
      ⟨Dmul, Pmul, hDmul_pos, hDmul_le, hPmul_eq, gmul, hgmul_mem, hgmul_err⟩
    change ∃ NF : FullyConnectedReLUNet d,
        0 < NF.depth ∧ NF.depth ≤ Df ∧ NF.width ≤ Wf ∧ NF.parameterCount ≤ Pf ∧
          ∀ x, approxF x = NF.realize x at hclassF
    rcases hclassF with ⟨NF, hNF_pos, hNF_depth, hNF_width, hNF_param, hNF_eq⟩
    change ∃ NG : FullyConnectedReLUNet d,
        0 < NG.depth ∧ NG.depth ≤ Dg ∧ NG.width ≤ Wg ∧ NG.parameterCount ≤ Pg ∧
          ∀ x, approxG x = NG.realize x at hclassG
    rcases hclassG with ⟨NG, hNG_pos, hNG_depth, hNG_width, hNG_param, hNG_eq⟩
    change ∃ Nmul : FullyConnectedReLUNet 2,
        0 < Nmul.depth ∧ Nmul.depth ≤ Dmul ∧ Nmul.width ≤ Wmul ∧
          Nmul.parameterCount ≤ Pmul ∧ ∀ y, gmul y = Nmul.realize y at hgmul_mem
    rcases hgmul_mem with ⟨Nmul, hNmul_pos, hNmul_depth, hNmul_width, hNmul_param, hNmul_eq⟩
    let M : ℕ := Nat.max Df Dg
    let D : ℕ := M + Dmul
    let P : ℕ := fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
    refine ⟨D, P, ?_, ?_, ?_, ?_⟩
    · -- 0 < D
      have hDf_le_M : Df ≤ M := by
        dsimp [M]
        exact le_max_left Df Dg
      have hM_pos : 0 < M := Nat.lt_of_lt_of_le hDf hDf_le_M
      dsimp [D]
      omega
    · -- depth bound
      dsimp [D, M]
      have hcast : ((Nat.max Df Dg + Dmul : ℕ) : ℝ) =
          (Nat.max Df Dg : ℝ) + (Dmul : ℝ) := by
        simp
      rw [hcast]
      have hM0 : (0 : ℝ) ≤ (Nat.max Df Dg : ℝ) := by
        exact_mod_cast Nat.zero_le (Nat.max Df Dg)
      have hn0 : (0 : ℝ) ≤ (n : ℝ) := by
        exact_mod_cast Nat.zero_le n
      nlinarith [hDmul_le, hcMulDepth, hM0, hn0]
    · -- P = fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
      rfl
    · -- Build h: parallel-pair NF and NG (pad to depth M = Nat.max Df Dg by
      -- identity layers), feed the pair into Nmul's net; then
      --   h ∈ reluNetworkClass d D (Wf + Wg + Wmul) P
      -- (depth = D, width Wc := NF.width + NG.width + Nmul.width ≤ Wf + Wg + Wmul,
      --  parameterCount ≤ P by monotonicity of fullyConnectedReLUParameterCount).
      -- The final block proves composition correctness and combines the
      -- multiplication-gadget error with the product algebra error.
      have hD_pos : 0 < D := by
        dsimp [D]
        have hM_pos' : 0 < M := by
          dsimp [M]
          exact Nat.lt_of_lt_of_le hDf (le_max_left Df Dg)
        omega
      have hpc_mono : ∀ a b : ℕ, a ≤ b →
          fullyConnectedReLUParameterCount d D a ≤ fullyConnectedReLUParameterCount d D b := by
        intro a b hab
        have hsq_nat : (a + 1) * a ≤ (b + 1) * b := by
          rw [Nat.succ_mul, Nat.succ_mul]
          exact Nat.add_le_add (Nat.mul_le_mul hab hab) hab
        have h1 : (d + 1) * a ≤ (d + 1) * b := Nat.mul_le_mul_left (d + 1) hab
        have h2 : (D - 1) * ((a + 1) * a) ≤ (D - 1) * ((b + 1) * b) :=
          Nat.mul_le_mul_left (D - 1) hsq_nat
        have h3 : a + 1 ≤ b + 1 := by omega
        change (d + 1) * a + (D - 1) * ((a + 1) * a) + (a + 1) ≤
          (d + 1) * b + (D - 1) * ((b + 1) * b) + (b + 1)
        exact Nat.add_le_add (Nat.add_le_add h1 h2) h3
      let Wc : ℕ := NF.width + NG.width + Nmul.width
      -- auxiliary layers: identity and zero
      let idLayer (m : ℕ) : DenseLayer m m :=
        { weight := fun i j => if i = j then 1 else 0, bias := fun _ => 0 }
      let zeroLayer (m n : ℕ) : DenseLayer m n :=
        { weight := fun _ _ => 0, bias := fun _ => 0 }
      -- block-diagonal layer: pair block (Fin (NF.width + NG.width)) + gadget block
      let fullDiag (Lp : DenseLayer (NF.width + NG.width) (NF.width + NG.width))
          (Lk : DenseLayer Nmul.width Nmul.width) : DenseLayer Wc Wc :=
        { weight := fun (i : Fin Wc) (j : Fin Wc) =>
            match finSumFinEquiv.symm i with
            | Sum.inl pi =>
                match finSumFinEquiv.symm j with
                | Sum.inl pj => Lp.weight pi pj
                | Sum.inr _ => 0
            | Sum.inr ki =>
                match finSumFinEquiv.symm j with
                | Sum.inl _ => 0
                | Sum.inr kj => Lk.weight ki kj,
          bias := fun (i : Fin Wc) =>
            match finSumFinEquiv.symm i with
            | Sum.inl pi => Lp.bias pi
            | Sum.inr ki => Lk.bias ki }
      -- block-diagonal layer on the pair block (F-block + G-block)
      let pairDiag (L1 : DenseLayer NF.width NF.width) (L2 : DenseLayer NG.width NG.width) :
          DenseLayer (NF.width + NG.width) (NF.width + NG.width) :=
        { weight := fun (i : Fin (NF.width + NG.width)) (j : Fin (NF.width + NG.width)) =>
            match finSumFinEquiv.symm i with
            | Sum.inl fi =>
                match finSumFinEquiv.symm j with
                | Sum.inl fj => L1.weight fi fj
                | Sum.inr _ => 0
            | Sum.inr gi =>
                match finSumFinEquiv.symm j with
                | Sum.inl _ => 0
                | Sum.inr gj => L2.weight gi gj,
          bias := fun (i : Fin (NF.width + NG.width)) =>
            match finSumFinEquiv.symm i with
            | Sum.inl fi => L1.bias fi
            | Sum.inr gi => L2.bias gi }
      -- per-block hidden layers: identity padding past a net's own depth
      let hidF (k : ℕ) : DenseLayer NF.width NF.width :=
        if hk : k < NF.depth - 1 then NF.hidden ⟨k, hk⟩ else idLayer NF.width
      let hidG (k : ℕ) : DenseLayer NG.width NG.width :=
        if hk : k < NG.depth - 1 then NG.hidden ⟨k, hk⟩ else idLayer NG.width
      let hidK (t : ℕ) : DenseLayer Nmul.width Nmul.width :=
        if hk : t < Nmul.depth - 1 then Nmul.hidden ⟨t, hk⟩ else idLayer Nmul.width
      -- input layer: NF on F-block, NG on G-block, zero on gadget block
      let inputL : DenseLayer d Wc :=
        { weight := fun (i : Fin Wc) (j : Fin d) =>
            match finSumFinEquiv.symm i with
            | Sum.inl p =>
                match finSumFinEquiv.symm p with
                | Sum.inl f => NF.input.weight f j
                | Sum.inr g => NG.input.weight g j
            | Sum.inr _ => 0,
          bias := fun (i : Fin Wc) =>
            match finSumFinEquiv.symm i with
            | Sum.inl p =>
                match finSumFinEquiv.symm p with
                | Sum.inl f => NF.input.bias f
                | Sum.inr g => NG.input.bias g
            | Sum.inr _ => 0 }
      -- read-out layer (hidden index M - 1): identity on the pair block;
      -- gadget block = Nmul.input applied to the pair of output functionals
      let readOutL : DenseLayer Wc Wc :=
        { weight := fun (i : Fin Wc) (j : Fin Wc) =>
            match finSumFinEquiv.symm i with
            | Sum.inl _ => if j = i then 1 else 0
            | Sum.inr ki =>
                match finSumFinEquiv.symm j with
                | Sum.inl p =>
                    match finSumFinEquiv.symm p with
                    | Sum.inl f => Nmul.input.weight ki 0 * NF.outputWeight f
                    | Sum.inr g => Nmul.input.weight ki 1 * NG.outputWeight g
                | Sum.inr _ => 0,
          bias := fun (i : Fin Wc) =>
            match finSumFinEquiv.symm i with
            | Sum.inl _ => 0
            | Sum.inr ki =>
                Nmul.input.weight ki 0 * NF.outputBias +
                  Nmul.input.weight ki 1 * NG.outputBias + Nmul.input.bias ki }
      -- hidden layers: parallel stage (indices < M - 1), read-out (index M - 1),
      -- gadget stage (indices ≥ M)
      let hid (k : Fin (D - 1)) : DenseLayer Wc Wc :=
        if hkP : k.val < M - 1 then
          fullDiag (pairDiag (hidF k.val) (hidG k.val)) (zeroLayer Nmul.width Nmul.width)
        else if hkR : k.val = M - 1 then
          readOutL
        else
          fullDiag (idLayer (NF.width + NG.width)) (hidK (k.val - M))
      -- output functional: Nmul's output weights on the gadget block, zero on pair
      let outW : Fin Wc → ℝ := fun (j : Fin Wc) =>
        match finSumFinEquiv.symm j with
        | Sum.inl _ => 0
        | Sum.inr kj => Nmul.outputWeight kj
      let Nc : FullyConnectedReLUNet d :=
        { depth := D, width := Wc, input := inputL, hidden := hid,
          outputWeight := outW, outputBias := Nmul.outputBias }
      refine ⟨Nc.realize, ?_mem, ?_err⟩
      · change ∃ N : FullyConnectedReLUNet d,
          0 < N.depth ∧ N.depth ≤ D ∧ N.width ≤ Wf + Wg + Wmul ∧
            N.parameterCount ≤ P ∧ ∀ x, Nc.realize x = N.realize x
        refine ⟨Nc, hD_pos, ?_d, ?_w, ?_p, ?_r⟩
        · dsimp [Nc, D]
          exact le_rfl
        · change NF.width + NG.width + Nmul.width ≤ Wf + Wg + Wmul
          omega
        · change fullyConnectedReLUParameterCount d D (NF.width + NG.width + Nmul.width) ≤
            fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
          apply hpc_mono
          omega
        · intro x
          rfl
      · -- error bound:
        -- |Nc.realize x - targetF x * targetG x| ≤
        --   cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) + R * ηg + R * ηf
        -- via (1) composition correctness Nc.realize x = gmul (approxF x, approxG x)
        -- (hiddenState induction through the parallel / read-out / gadget stages),
        -- (2) hgmul_err with |approxF x| ≤ R, |approxG x| ≤ R
        -- (happroxF_bound / happroxG_bound),
        -- (3) product-algebra bound |approxF x * approxG x - targetF x * targetG x|
        --     ≤ R * ηg + R * ηf via happroxF_err / happroxG_err / htargetG_bound.
        intro x hx
        -- block embeddings and projections (Wc = (NF.width + NG.width) + Nmul.width)
        let eF : Fin NF.width → Fin Wc := fun f =>
          finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inl f)))
        let eG : Fin NG.width → Fin Wc := fun g =>
          finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr g)))
        let eK : Fin Nmul.width → Fin Wc := fun k =>
          finSumFinEquiv (Sum.inr k)
        let projF (v : Fin Wc → ℝ) : Fin NF.width → ℝ := fun f => v (eF f)
        let projG (v : Fin Wc → ℝ) : Fin NG.width → ℝ := fun g => v (eG g)
        let projK (v : Fin Wc → ℝ) : Fin Nmul.width → ℝ := fun k => v (eK k)
        -- pair vector produced by the read-out layer
        let pairV (v : Fin Wc → ℝ) : Fin 2 → ℝ :=
          fun j => if j = 0 then
              (∑ f : Fin NF.width, NF.outputWeight f * projF v f) + NF.outputBias
            else
              (∑ g : Fin NG.width, NG.outputWeight g * projG v g) + NG.outputBias
        -- ReLU outputs are nonnegative
        have hrelu_nonneg : ∀ z : ℝ, 0 ≤ relu z := by
          intro z
          dsimp [relu]
          exact le_max_right z 0
        have hreluApply_nonneg : ∀ {m n : ℕ} (L : DenseLayer m n) (v : Fin m → ℝ) (i : Fin n),
            0 ≤ L.reluApply v i := by
          intro m n L v i
          dsimp [DenseLayer.reluApply, reluVec]
          exact hrelu_nonneg _
        have hstate_nonneg : ∀ {d : ℕ} (N : FullyConnectedReLUNet d) (v : Fin d → ℝ)
            (t : ℕ) (i : Fin N.width), 0 ≤ N.hiddenState v t i := by
          intro d N v t i
          induction t with
          | zero =>
              simpa [FullyConnectedReLUNet.hiddenState] using hreluApply_nonneg N.input v i
          | succ t ih =>
              by_cases ht : t < N.depth - 1
              · simpa [FullyConnectedReLUNet.hiddenState, ht] using
                  hreluApply_nonneg (N.hidden ⟨t, ht⟩) (N.hiddenState v t) i
              · simpa [FullyConnectedReLUNet.hiddenState, ht] using ih
        -- hidden states are constant past depth - 1
        have hstate_const : ∀ {d : ℕ} (N : FullyConnectedReLUNet d) (v : Fin d → ℝ) (t : ℕ),
            N.depth - 1 ≤ t → N.hiddenState v t = N.hiddenState v (N.depth - 1) := by
          intro d N v t
          induction t with
          | zero =>
              intro ht
              have h0 : N.depth - 1 = 0 := by omega
              simp [h0]
          | succ t ih =>
              intro ht
              by_cases hlt : t < N.depth - 1
              · have ht_eq : t + 1 = N.depth - 1 := by omega
                rw [ht_eq]
              · have hge : N.depth - 1 ≤ t := by omega
                simp [FullyConnectedReLUNet.hiddenState, hlt]
                exact ih hge
        -- identity layer is identity on nonnegative states; zero layer outputs zero
        have hidLayer_id : ∀ {m : ℕ} (v : Fin m → ℝ), (∀ i, 0 ≤ v i) →
            (idLayer m).reluApply v = v := by
          intro m v hv
          funext i
          simp [idLayer, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu, Finset.sum_ite_eq]
          exact hv i
        have hzeroLayer : ∀ {m n : ℕ} (v : Fin m → ℝ), (zeroLayer m n).reluApply v = 0 := by
          intro m n v
          funext i
          simp [zeroLayer, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu]
        -- one-step rules for the padded block layers
        have hidF_step : ∀ (t : ℕ) (v : Fin d → ℝ),
            (hidF t).reluApply (NF.hiddenState v t) = NF.hiddenState v (t + 1) := by
          intro t v
          by_cases ht : t < NF.depth - 1
          · simp [hidF, ht, FullyConnectedReLUNet.hiddenState]
          · have hid : hidF t = idLayer NF.width := by simp [hidF, ht]
            rw [hid]
            rw [hidLayer_id (NF.hiddenState v t) (fun i => hstate_nonneg NF v t i)]
            simp [FullyConnectedReLUNet.hiddenState, ht]
        have hidG_step : ∀ (t : ℕ) (v : Fin d → ℝ),
            (hidG t).reluApply (NG.hiddenState v t) = NG.hiddenState v (t + 1) := by
          intro t v
          by_cases ht : t < NG.depth - 1
          · simp [hidG, ht, FullyConnectedReLUNet.hiddenState]
          · have hid : hidG t = idLayer NG.width := by simp [hidG, ht]
            rw [hid]
            rw [hidLayer_id (NG.hiddenState v t) (fun i => hstate_nonneg NG v t i)]
            simp [FullyConnectedReLUNet.hiddenState, ht]
        have hidK_step : ∀ (t : ℕ) (p : Fin 2 → ℝ),
            (hidK t).reluApply (Nmul.hiddenState p t) = Nmul.hiddenState p (t + 1) := by
          intro t p
          by_cases ht : t < Nmul.depth - 1
          · simp [hidK, ht, FullyConnectedReLUNet.hiddenState]
          · have hid : hidK t = idLayer Nmul.width := by simp [hidK, ht]
            rw [hid]
            rw [hidLayer_id (Nmul.hiddenState p t) (fun i => hstate_nonneg Nmul p t i)]
            simp [FullyConnectedReLUNet.hiddenState, ht]
        -- projections of the block-diagonal layers
        have hprojF_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
            (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
            (v : Fin Wc → ℝ),
            projF ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = L1.reluApply (projF v) := by
          intro L1 L2 Lk v
          funext f
          simp only [projF, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
            fullDiag, pairDiag, Equiv.symm_apply_apply]
          rw [Fin.sum_univ_add, Fin.sum_univ_add]
          apply congrArg relu
          simp [Finset.mul_sum, Equiv.symm_apply_apply]
          try ring
        have hprojG_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
            (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
            (v : Fin Wc → ℝ),
            projG ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = L2.reluApply (projG v) := by
          intro L1 L2 Lk v
          funext g
          simp only [projF, projG, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
            fullDiag, pairDiag, Equiv.symm_apply_apply]
          rw [Fin.sum_univ_add, Fin.sum_univ_add]
          apply congrArg relu
          simp [Finset.mul_sum, Equiv.symm_apply_apply]
          try ring
        have hprojK_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
            (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
            (v : Fin Wc → ℝ),
            projK ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = Lk.reluApply (projK v) := by
          intro L1 L2 Lk v
          funext k
          simp only [projF, projG, projK, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply,
            reluVec, fullDiag, pairDiag, Equiv.symm_apply_apply]
          rw [Fin.sum_univ_add]
          apply congrArg relu
          simp [Finset.mul_sum, Equiv.symm_apply_apply]
          try ring
        have hprojK_fullDiag_id : ∀ (Lk : DenseLayer Nmul.width Nmul.width) (v : Fin Wc → ℝ),
            projK ((fullDiag (idLayer (NF.width + NG.width)) Lk).reluApply v) = Lk.reluApply (projK v) := by
          intro Lk v
          funext k
          simp only [projK, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
            fullDiag, Equiv.symm_apply_apply]
          rw [Fin.sum_univ_add]
          apply congrArg relu
          simp [Finset.mul_sum, Equiv.symm_apply_apply]
          try ring
        -- projections of the input layer
        have hprojF_input : projF (inputL.reluApply x) = NF.hiddenState x 0 := by
          funext f
          simp [projF, eF, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu,
            FullyConnectedReLUNet.hiddenState, Equiv.symm_apply_apply]
        have hprojG_input : projG (inputL.reluApply x) = NG.hiddenState x 0 := by
          funext g
          simp [projF, projG, eF, eG, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec,
            relu, FullyConnectedReLUNet.hiddenState, Equiv.symm_apply_apply]
        have hprojK_input : projK (inputL.reluApply x) = 0 := by
          funext k
          simp [projK, eK, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu,
            Equiv.symm_apply_apply]
        -- === composition correctness: Nc.realize x = gmul (approxF x, approxG x) ===
        have hM_ge1 : 1 ≤ M := by
          dsimp [M]
          exact le_trans (Nat.succ_le_of_lt hDf) (le_max_left Df Dg)
        have hlayer_M : M - 1 < D - 1 := by
          dsimp [D]
          omega
        have hrec_M : Nc.hiddenState x M = readOutL.reluApply (Nc.hiddenState x (M - 1)) := by
          have hM_eq : M = (M - 1) + 1 := by omega
          rw [hM_eq]
          have hstep : Nc.hiddenState x ((M - 1) + 1) =
              (Nc.hidden ⟨M - 1, hlayer_M⟩).reluApply (Nc.hiddenState x (M - 1)) := by
            simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer_M]
          rw [hstep]
          change (hid ⟨M - 1, hlayer_M⟩).reluApply (Nc.hiddenState x (M - 1)) =
            readOutL.reluApply (Nc.hiddenState x (M - 1))
          simp [hid, show ¬ M - 1 < M - 1 by omega]
        -- projection of the read-out layer on the gadget block
        have hprojK_readOut : ∀ v : Fin Wc → ℝ,
            projK (readOutL.reluApply v) = Nmul.input.reluApply (pairV v) := by
          intro v
          funext k
          simp only [projF, projG, projK, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply,
            reluVec, readOutL, pairV, Equiv.symm_apply_apply]
          apply congrArg relu
          rw [Fin.sum_univ_add, Fin.sum_univ_add]
          simp [Finset.mul_sum, Finset.sum_ite_eq, Fin.sum_univ_two, Equiv.symm_apply_apply]
          simp [Finset.mul_sum, Finset.sum_mul, mul_add, add_mul, mul_assoc, mul_comm,
            mul_left_comm, add_assoc, add_comm, add_left_comm]
        -- parallel-stage block states
        have hpair_stage : ∀ t : ℕ, t ≤ M - 1 →
            projF (Nc.hiddenState x t) = NF.hiddenState x t ∧
            projG (Nc.hiddenState x t) = NG.hiddenState x t ∧
            projK (Nc.hiddenState x t) = 0 := by
          intro t
          induction t with
          | zero =>
              intro ht
              constructor
              · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojF_input
              constructor
              · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojG_input
              · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojK_input
          | succ t ih =>
              intro ht
              have hlt : t < M - 1 := by omega
              have hlayer : t < D - 1 := by
                dsimp [D]
                omega
              have hhid : Nc.hidden ⟨t, hlayer⟩ =
                  fullDiag (pairDiag (hidF t) (hidG t)) (zeroLayer Nmul.width Nmul.width) := by
                change hid ⟨t, hlayer⟩ =
                  fullDiag (pairDiag (hidF t) (hidG t)) (zeroLayer Nmul.width Nmul.width)
                simp [hid, hlt]
              have hrec : Nc.hiddenState x (t + 1) =
                  (Nc.hidden ⟨t, hlayer⟩).reluApply (Nc.hiddenState x t) := by
                simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer]
              rcases ih (by omega : t ≤ M - 1) with ⟨hF_ih, hG_ih, hK_ih⟩
              constructor
              · rw [hrec, hhid]
                rw [hprojF_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                  (Nc.hiddenState x t)]
                rw [hF_ih]
                exact hidF_step t x
              constructor
              · rw [hrec, hhid]
                rw [hprojG_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                  (Nc.hiddenState x t)]
                rw [hG_ih]
                exact hidG_step t x
              · rw [hrec, hhid]
                rw [hprojK_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                  (Nc.hiddenState x t)]
                rw [hK_ih]
                exact hzeroLayer 0
        -- F/G blocks at the read-out input equal the final hidden states
        have hFM1 : projF (Nc.hiddenState x (M - 1)) = NF.hiddenState x (NF.depth - 1) := by
          rcases hpair_stage (M - 1) (by omega : M - 1 ≤ M - 1) with ⟨hF, _, _⟩
          calc
            projF (Nc.hiddenState x (M - 1)) = NF.hiddenState x (M - 1) := hF
            _ = NF.hiddenState x (NF.depth - 1) := by
                apply hstate_const
                have hle : NF.depth ≤ M := le_trans hNF_depth (le_max_left Df Dg)
                omega
        have hGM1 : projG (Nc.hiddenState x (M - 1)) = NG.hiddenState x (NG.depth - 1) := by
          rcases hpair_stage (M - 1) (by omega : M - 1 ≤ M - 1) with ⟨_, hG, _⟩
          calc
            projG (Nc.hiddenState x (M - 1)) = NG.hiddenState x (M - 1) := hG
            _ = NG.hiddenState x (NG.depth - 1) := by
                apply hstate_const
                have hle : NG.depth ≤ M := le_trans hNG_depth (le_max_right Df Dg)
                omega
        -- pair vector fed to the mul-net at the read-out
        let p : Fin 2 → ℝ := fun j => if j = 0 then NF.realize x else NG.realize x
        have hpairV0 : pairV (Nc.hiddenState x (M - 1)) 0 = NF.realize x := by
          simp only [pairV, ↓reduceIte]
          rw [hFM1]
          rfl
        have hpairV1 : pairV (Nc.hiddenState x (M - 1)) 1 = NG.realize x := by
          simp only [pairV, ↓reduceIte]
          rw [hGM1]
          rfl
        have hpairV_eq : pairV (Nc.hiddenState x (M - 1)) = p := by
          funext j
          fin_cases j
          · simp [p, hpairV0]
          · simp [p, hpairV1]
        -- gadget block right after the read-out equals Nmul.hiddenState p 0
        have hstate_M_K : projK (Nc.hiddenState x M) = Nmul.hiddenState p 0 := by
          rw [hrec_M]
          rw [hprojK_readOut (Nc.hiddenState x (M - 1))]
          rw [hpairV_eq]
          simp [FullyConnectedReLUNet.hiddenState]
        -- gadget-stage block states
        have hgadget_K : ∀ t : ℕ, M ≤ t → t ≤ D - 1 →
            projK (Nc.hiddenState x t) = Nmul.hiddenState p (t - M) := by
          intro t
          induction t with
          | zero =>
              intro htM htD
              omega
          | succ t ih =>
              intro htM htD
              by_cases hM : t + 1 = M
              · rw [hM]
                rw [hstate_M_K]
                rw [show M - M = 0 by omega]
              · have hMle : M ≤ t := by omega
                have hlayer : t < D - 1 := by omega
                have hnotP : ¬ t < M - 1 := by omega
                have hnotR : ¬ t = M - 1 := by omega
                have hhid : Nc.hidden ⟨t, hlayer⟩ =
                    fullDiag (idLayer (NF.width + NG.width)) (hidK (t - M)) := by
                  change hid ⟨t, hlayer⟩ =
                    fullDiag (idLayer (NF.width + NG.width)) (hidK (t - M))
                  simp [hid, hnotP, hnotR]
                have hrec : Nc.hiddenState x (t + 1) =
                    (Nc.hidden ⟨t, hlayer⟩).reluApply (Nc.hiddenState x t) := by
                  simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer]
                rw [hrec, hhid]
                rw [hprojK_fullDiag_id (hidK (t - M)) (Nc.hiddenState x t)]
                rw [ih hMle (by omega : t ≤ D - 1)]
                rw [hidK_step]
                congr 1
                omega
        -- final gadget state at depth D - 1
        have hfinalK : projK (Nc.hiddenState x (D - 1)) = Nmul.hiddenState p (Dmul - 1) := by
          have hg : M ≤ D - 1 := by
            dsimp [D]
            omega
          have hsub : (D - 1) - M = Dmul - 1 := by
            dsimp [D]
            omega
          rw [← hsub]
          exact hgadget_K (D - 1) hg (by omega : D - 1 ≤ D - 1)
        have hfinalK_raw : ∀ k : Fin Nmul.width,
            Nc.hiddenState x (D - 1) (Fin.natAdd (NF.width + NG.width) k) =
              Nmul.hiddenState p (Dmul - 1) k := by
          intro k
          exact congrFun hfinalK k
        have hreal : Nc.realize x = Nmul.realize p := by
          simp only [FullyConnectedReLUNet.realize]
          rw [Fin.sum_univ_add, Fin.sum_univ_add]
          rw [show Nc.outputWeight = outW by rfl]
          rw [show Nc.outputBias = Nmul.outputBias by rfl]
          have hdepth_const : Nmul.hiddenState p (Nmul.depth - 1) =
              Nmul.hiddenState p (Dmul - 1) := by
            exact (hstate_const Nmul p (Dmul - 1) (by omega)).symm
          simp [Nc, outW, hfinalK_raw, hdepth_const, Finset.mul_sum,
            Equiv.symm_apply_apply]
        have hcomp : gmul p = Nc.realize x := by
          rw [hreal]
          exact hNmul_eq p
        have hp0 : p 0 = approxF x := by
          simp [p]
          exact (hNF_eq x).symm
        have hp1 : p 1 = approxG x := by
          simp [p]
          exact (hNG_eq x).symm
        -- gadget error
        have hgmul_le : |gmul p - p 0 * p 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) := by
          apply hgmul_err
          · rw [hp0]
            exact happroxF_bound x hx
          · rw [hp1]
            exact happroxG_bound x hx
        -- product algebra error
        have hprod_le : |p 0 * p 1 - targetF x * targetG x| ≤ R * ηg + R * ηf := by
          have hsplit : p 0 * p 1 - targetF x * targetG x =
              p 0 * (p 1 - targetG x) + (p 0 - targetF x) * targetG x := by ring
          rw [hsplit]
          have hb0 : |p 0| ≤ R := by
            rw [hp0]
            exact happroxF_bound x hx
          have hb1 : |p 1 - targetG x| ≤ ηg := by
            rw [hp1]
            exact happroxG_err x hx
          have hb2 : |p 0 - targetF x| ≤ ηf := by
            rw [hp0]
            exact happroxF_err x hx
          have hb3 : |targetG x| ≤ R := htargetG_bound x hx
          have hterm1 : |p 0| * |p 1 - targetG x| ≤ R * ηg := by
            exact mul_le_mul hb0 hb1 (abs_nonneg _) (le_of_lt hR)
          have hterm2 : |p 0 - targetF x| * |targetG x| ≤ R * ηf := by
            calc
              |p 0 - targetF x| * |targetG x| ≤ ηf * R :=
                mul_le_mul hb2 hb3 (abs_nonneg _) hηf
              _ = R * ηf := by rw [mul_comm]
          calc
            |p 0 * (p 1 - targetG x) + (p 0 - targetF x) * targetG x|
                ≤ |p 0 * (p 1 - targetG x)| + |(p 0 - targetF x) * targetG x| := abs_add_le _ _
            _ ≤ (|p 0| * |p 1 - targetG x|) + (|p 0 - targetF x| * |targetG x|) := by
                exact add_le_add (abs_mul _ _).le (abs_mul _ _).le
            _ ≤ R * ηg + R * ηf := by
                exact add_le_add hterm1 hterm2
        calc
          |Nc.realize x - targetF x * targetG x| = |gmul p - targetF x * targetG x| := by
              rw [hcomp]
          _ = |(gmul p - p 0 * p 1) + (p 0 * p 1 - targetF x * targetG x)| := by
              congr 1
              ring
          _ ≤ |gmul p - p 0 * p 1| + |p 0 * p 1 - targetF x * targetG x| := abs_add_le _ _
          _ ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) + R * ηg + R * ηf := by
              simpa [add_assoc] using (add_le_add hgmul_le hprod_le)

/-- Fixed-width product closure with explicit additive depth from a multiplication gadget. -/
theorem exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget_depth_sum_bound
    {d Df Dg Wf Wg Pf Pg Wmul : ℕ}
    (hDf : 0 < Df) (hDg : 0 < Dg)
    (hWf : 0 < Wf) (hWg : 0 < Wg) (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    {domain : (Fin d → ℝ) → Prop}
    {targetF targetG approxF approxG : (Fin d → ℝ) → ℝ}
    {ηf ηg R : ℝ}
    (hηf : 0 ≤ ηf) (hηg : 0 ≤ ηg) (hR : 0 < R)
    (hclassF : approxF ∈ reluNetworkClass d Df Wf Pf)
    (hclassG : approxG ∈ reluNetworkClass d Dg Wg Pg)
    (happroxF_bound : ∀ x : Fin d → ℝ, domain x → |approxF x| ≤ R)
    (happroxG_bound : ∀ x : Fin d → ℝ, domain x → |approxG x| ≤ R)
    (htargetG_bound : ∀ x : Fin d → ℝ, domain x → |targetG x| ≤ R)
    (happroxF_err : ∀ x : Fin d → ℝ, domain x →
      |approxF x - targetF x| ≤ ηf)
    (happroxG_err : ∀ x : Fin d → ℝ, domain x →
      |approxG x - targetG x| ≤ ηg) :
    ∀ n : ℕ, 0 < n →
      ∃ D P : ℕ,
        0 < D ∧
        (D : ℝ) ≤ (Nat.max Df Dg : ℝ) + cMulDepth * (n : ℝ) ∧
        P = fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul) ∧
        ∃ h : (Fin d → ℝ) → ℝ,
          h ∈ reluNetworkClass d D (Wf + Wg + Wmul) P ∧
            ∀ x : Fin d → ℝ, domain x →
              |h x - targetF x * targetG x| ≤
                cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) +
                  R * ηg + R * ηf := by
  intro n hn
  rcases hmul n hn R hR with
    ⟨Dmul, Pmul, hDmul_pos, hDmul_le, hPmul_eq, gmul, hgmul_mem, hgmul_err⟩
  change ∃ NF : FullyConnectedReLUNet d,
      0 < NF.depth ∧ NF.depth ≤ Df ∧ NF.width ≤ Wf ∧ NF.parameterCount ≤ Pf ∧
        ∀ x, approxF x = NF.realize x at hclassF
  rcases hclassF with ⟨NF, hNF_pos, hNF_depth, hNF_width, hNF_param, hNF_eq⟩
  change ∃ NG : FullyConnectedReLUNet d,
      0 < NG.depth ∧ NG.depth ≤ Dg ∧ NG.width ≤ Wg ∧ NG.parameterCount ≤ Pg ∧
        ∀ x, approxG x = NG.realize x at hclassG
  rcases hclassG with ⟨NG, hNG_pos, hNG_depth, hNG_width, hNG_param, hNG_eq⟩
  change ∃ Nmul : FullyConnectedReLUNet 2,
      0 < Nmul.depth ∧ Nmul.depth ≤ Dmul ∧ Nmul.width ≤ Wmul ∧
        Nmul.parameterCount ≤ Pmul ∧ ∀ y, gmul y = Nmul.realize y at hgmul_mem
  rcases hgmul_mem with ⟨Nmul, hNmul_pos, hNmul_depth, hNmul_width, hNmul_param, hNmul_eq⟩
  let M : ℕ := Nat.max Df Dg
  let D : ℕ := M + Dmul
  let P : ℕ := fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
  refine ⟨D, P, ?_, ?_, ?_, ?_⟩
  · -- 0 < D
    have hDf_le_M : Df ≤ M := by
      dsimp [M]
      exact le_max_left Df Dg
    have hM_pos : 0 < M := Nat.lt_of_lt_of_le hDf hDf_le_M
    dsimp [D]
    omega
  · -- depth bound
    dsimp [D, M]
    have hcast : ((Nat.max Df Dg + Dmul : ℕ) : ℝ) =
        (Nat.max Df Dg : ℝ) + (Dmul : ℝ) := by
      simp
    rw [hcast]
    have hM0 : (0 : ℝ) ≤ (Nat.max Df Dg : ℝ) := by
      exact_mod_cast Nat.zero_le (Nat.max Df Dg)
    have hn0 : (0 : ℝ) ≤ (n : ℝ) := by
      exact_mod_cast Nat.zero_le n
    nlinarith [hDmul_le, hcMulDepth, hM0, hn0]
  · -- P = fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
    rfl
  · -- Build h: parallel-pair NF and NG (pad to depth M = Nat.max Df Dg by
    -- identity layers), feed the pair into Nmul's net; then
    --   h ∈ reluNetworkClass d D (Wf + Wg + Wmul) P
    -- (depth = D, width Wc := NF.width + NG.width + Nmul.width ≤ Wf + Wg + Wmul,
    --  parameterCount ≤ P by monotonicity of fullyConnectedReLUParameterCount).
    -- The final block proves composition correctness and combines the
    -- multiplication-gadget error with the product algebra error.
    have hD_pos : 0 < D := by
      dsimp [D]
      have hM_pos' : 0 < M := by
        dsimp [M]
        exact Nat.lt_of_lt_of_le hDf (le_max_left Df Dg)
      omega
    have hpc_mono : ∀ a b : ℕ, a ≤ b →
        fullyConnectedReLUParameterCount d D a ≤ fullyConnectedReLUParameterCount d D b := by
      intro a b hab
      have hsq_nat : (a + 1) * a ≤ (b + 1) * b := by
        rw [Nat.succ_mul, Nat.succ_mul]
        exact Nat.add_le_add (Nat.mul_le_mul hab hab) hab
      have h1 : (d + 1) * a ≤ (d + 1) * b := Nat.mul_le_mul_left (d + 1) hab
      have h2 : (D - 1) * ((a + 1) * a) ≤ (D - 1) * ((b + 1) * b) :=
        Nat.mul_le_mul_left (D - 1) hsq_nat
      have h3 : a + 1 ≤ b + 1 := by omega
      change (d + 1) * a + (D - 1) * ((a + 1) * a) + (a + 1) ≤
        (d + 1) * b + (D - 1) * ((b + 1) * b) + (b + 1)
      exact Nat.add_le_add (Nat.add_le_add h1 h2) h3
    let Wc : ℕ := NF.width + NG.width + Nmul.width
    -- auxiliary layers: identity and zero
    let idLayer (m : ℕ) : DenseLayer m m :=
      { weight := fun i j => if i = j then 1 else 0, bias := fun _ => 0 }
    let zeroLayer (m n : ℕ) : DenseLayer m n :=
      { weight := fun _ _ => 0, bias := fun _ => 0 }
    -- block-diagonal layer: pair block (Fin (NF.width + NG.width)) + gadget block
    let fullDiag (Lp : DenseLayer (NF.width + NG.width) (NF.width + NG.width))
        (Lk : DenseLayer Nmul.width Nmul.width) : DenseLayer Wc Wc :=
      { weight := fun (i : Fin Wc) (j : Fin Wc) =>
          match finSumFinEquiv.symm i with
          | Sum.inl pi =>
              match finSumFinEquiv.symm j with
              | Sum.inl pj => Lp.weight pi pj
              | Sum.inr _ => 0
          | Sum.inr ki =>
              match finSumFinEquiv.symm j with
              | Sum.inl _ => 0
              | Sum.inr kj => Lk.weight ki kj,
        bias := fun (i : Fin Wc) =>
          match finSumFinEquiv.symm i with
          | Sum.inl pi => Lp.bias pi
          | Sum.inr ki => Lk.bias ki }
    -- block-diagonal layer on the pair block (F-block + G-block)
    let pairDiag (L1 : DenseLayer NF.width NF.width) (L2 : DenseLayer NG.width NG.width) :
        DenseLayer (NF.width + NG.width) (NF.width + NG.width) :=
      { weight := fun (i : Fin (NF.width + NG.width)) (j : Fin (NF.width + NG.width)) =>
          match finSumFinEquiv.symm i with
          | Sum.inl fi =>
              match finSumFinEquiv.symm j with
              | Sum.inl fj => L1.weight fi fj
              | Sum.inr _ => 0
          | Sum.inr gi =>
              match finSumFinEquiv.symm j with
              | Sum.inl _ => 0
              | Sum.inr gj => L2.weight gi gj,
        bias := fun (i : Fin (NF.width + NG.width)) =>
          match finSumFinEquiv.symm i with
          | Sum.inl fi => L1.bias fi
          | Sum.inr gi => L2.bias gi }
    -- per-block hidden layers: identity padding past a net's own depth
    let hidF (k : ℕ) : DenseLayer NF.width NF.width :=
      if hk : k < NF.depth - 1 then NF.hidden ⟨k, hk⟩ else idLayer NF.width
    let hidG (k : ℕ) : DenseLayer NG.width NG.width :=
      if hk : k < NG.depth - 1 then NG.hidden ⟨k, hk⟩ else idLayer NG.width
    let hidK (t : ℕ) : DenseLayer Nmul.width Nmul.width :=
      if hk : t < Nmul.depth - 1 then Nmul.hidden ⟨t, hk⟩ else idLayer Nmul.width
    -- input layer: NF on F-block, NG on G-block, zero on gadget block
    let inputL : DenseLayer d Wc :=
      { weight := fun (i : Fin Wc) (j : Fin d) =>
          match finSumFinEquiv.symm i with
          | Sum.inl p =>
              match finSumFinEquiv.symm p with
              | Sum.inl f => NF.input.weight f j
              | Sum.inr g => NG.input.weight g j
          | Sum.inr _ => 0,
        bias := fun (i : Fin Wc) =>
          match finSumFinEquiv.symm i with
          | Sum.inl p =>
              match finSumFinEquiv.symm p with
              | Sum.inl f => NF.input.bias f
              | Sum.inr g => NG.input.bias g
          | Sum.inr _ => 0 }
    -- read-out layer (hidden index M - 1): identity on the pair block;
    -- gadget block = Nmul.input applied to the pair of output functionals
    let readOutL : DenseLayer Wc Wc :=
      { weight := fun (i : Fin Wc) (j : Fin Wc) =>
          match finSumFinEquiv.symm i with
          | Sum.inl _ => if j = i then 1 else 0
          | Sum.inr ki =>
              match finSumFinEquiv.symm j with
              | Sum.inl p =>
                  match finSumFinEquiv.symm p with
                  | Sum.inl f => Nmul.input.weight ki 0 * NF.outputWeight f
                  | Sum.inr g => Nmul.input.weight ki 1 * NG.outputWeight g
              | Sum.inr _ => 0,
        bias := fun (i : Fin Wc) =>
          match finSumFinEquiv.symm i with
          | Sum.inl _ => 0
          | Sum.inr ki =>
              Nmul.input.weight ki 0 * NF.outputBias +
                Nmul.input.weight ki 1 * NG.outputBias + Nmul.input.bias ki }
    -- hidden layers: parallel stage (indices < M - 1), read-out (index M - 1),
    -- gadget stage (indices ≥ M)
    let hid (k : Fin (D - 1)) : DenseLayer Wc Wc :=
      if hkP : k.val < M - 1 then
        fullDiag (pairDiag (hidF k.val) (hidG k.val)) (zeroLayer Nmul.width Nmul.width)
      else if hkR : k.val = M - 1 then
        readOutL
      else
        fullDiag (idLayer (NF.width + NG.width)) (hidK (k.val - M))
    -- output functional: Nmul's output weights on the gadget block, zero on pair
    let outW : Fin Wc → ℝ := fun (j : Fin Wc) =>
      match finSumFinEquiv.symm j with
      | Sum.inl _ => 0
      | Sum.inr kj => Nmul.outputWeight kj
    let Nc : FullyConnectedReLUNet d :=
      { depth := D, width := Wc, input := inputL, hidden := hid,
        outputWeight := outW, outputBias := Nmul.outputBias }
    refine ⟨Nc.realize, ?_mem, ?_err⟩
    · change ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧ N.depth ≤ D ∧ N.width ≤ Wf + Wg + Wmul ∧
          N.parameterCount ≤ P ∧ ∀ x, Nc.realize x = N.realize x
      refine ⟨Nc, hD_pos, ?_d, ?_w, ?_p, ?_r⟩
      · dsimp [Nc, D]
        exact le_rfl
      · change NF.width + NG.width + Nmul.width ≤ Wf + Wg + Wmul
        omega
      · change fullyConnectedReLUParameterCount d D (NF.width + NG.width + Nmul.width) ≤
          fullyConnectedReLUParameterCount d D (Wf + Wg + Wmul)
        apply hpc_mono
        omega
      · intro x
        rfl
    · -- error bound:
      -- |Nc.realize x - targetF x * targetG x| ≤
      --   cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) + R * ηg + R * ηf
      -- via (1) composition correctness Nc.realize x = gmul (approxF x, approxG x)
      -- (hiddenState induction through the parallel / read-out / gadget stages),
      -- (2) hgmul_err with |approxF x| ≤ R, |approxG x| ≤ R
      -- (happroxF_bound / happroxG_bound),
      -- (3) product-algebra bound |approxF x * approxG x - targetF x * targetG x| ≤
      --     R * ηg + R * ηf via happroxF_err / happroxG_err / htargetG_bound.
      intro x hx
      -- block embeddings and projections (Wc = (NF.width + NG.width) + Nmul.width)
      let eF : Fin NF.width → Fin Wc := fun f =>
        finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inl f)))
      let eG : Fin NG.width → Fin Wc := fun g =>
        finSumFinEquiv (Sum.inl (finSumFinEquiv (Sum.inr g)))
      let eK : Fin Nmul.width → Fin Wc := fun k =>
        finSumFinEquiv (Sum.inr k)
      let projF (v : Fin Wc → ℝ) : Fin NF.width → ℝ := fun f => v (eF f)
      let projG (v : Fin Wc → ℝ) : Fin NG.width → ℝ := fun g => v (eG g)
      let projK (v : Fin Wc → ℝ) : Fin Nmul.width → ℝ := fun k => v (eK k)
      -- pair vector produced by the read-out layer
      let pairV (v : Fin Wc → ℝ) : Fin 2 → ℝ :=
        fun j => if j = 0 then
            (∑ f : Fin NF.width, NF.outputWeight f * projF v f) + NF.outputBias
          else
            (∑ g : Fin NG.width, NG.outputWeight g * projG v g) + NG.outputBias
      -- ReLU outputs are nonnegative
      have hrelu_nonneg : ∀ z : ℝ, 0 ≤ relu z := by
        intro z
        dsimp [relu]
        exact le_max_right z 0
      have hreluApply_nonneg : ∀ {m n : ℕ} (L : DenseLayer m n) (v : Fin m → ℝ) (i : Fin n),
          0 ≤ L.reluApply v i := by
        intro m n L v i
        dsimp [DenseLayer.reluApply, reluVec]
        exact hrelu_nonneg _
      have hstate_nonneg : ∀ {d : ℕ} (N : FullyConnectedReLUNet d) (v : Fin d → ℝ)
          (t : ℕ) (i : Fin N.width), 0 ≤ N.hiddenState v t i := by
        intro d N v t i
        induction t with
        | zero =>
            simpa [FullyConnectedReLUNet.hiddenState] using hreluApply_nonneg N.input v i
        | succ t ih =>
            by_cases ht : t < N.depth - 1
            · simpa [FullyConnectedReLUNet.hiddenState, ht] using
                hreluApply_nonneg (N.hidden ⟨t, ht⟩) (N.hiddenState v t) i
            · simpa [FullyConnectedReLUNet.hiddenState, ht] using ih
      -- hidden states are constant past depth - 1
      have hstate_const : ∀ {d : ℕ} (N : FullyConnectedReLUNet d) (v : Fin d → ℝ) (t : ℕ),
          N.depth - 1 ≤ t → N.hiddenState v t = N.hiddenState v (N.depth - 1) := by
        intro d N v t
        induction t with
        | zero =>
            intro ht
            have h0 : N.depth - 1 = 0 := by omega
            simp [h0]
        | succ t ih =>
            intro ht
            by_cases hlt : t < N.depth - 1
            · have ht_eq : t + 1 = N.depth - 1 := by omega
              rw [ht_eq]
            · have hge : N.depth - 1 ≤ t := by omega
              simp [FullyConnectedReLUNet.hiddenState, hlt]
              exact ih hge
      -- identity layer is identity on nonnegative states; zero layer outputs zero
      have hidLayer_id : ∀ {m : ℕ} (v : Fin m → ℝ), (∀ i, 0 ≤ v i) →
          (idLayer m).reluApply v = v := by
        intro m v hv
        funext i
        simp [idLayer, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu, Finset.sum_ite_eq]
        exact hv i
      have hzeroLayer : ∀ {m n : ℕ} (v : Fin m → ℝ), (zeroLayer m n).reluApply v = 0 := by
        intro m n v
        funext i
        simp [zeroLayer, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu]
      -- one-step rules for the padded block layers
      have hidF_step : ∀ (t : ℕ) (v : Fin d → ℝ),
          (hidF t).reluApply (NF.hiddenState v t) = NF.hiddenState v (t + 1) := by
        intro t v
        by_cases ht : t < NF.depth - 1
        · simp [hidF, ht, FullyConnectedReLUNet.hiddenState]
        · have hid : hidF t = idLayer NF.width := by simp [hidF, ht]
          rw [hid]
          rw [hidLayer_id (NF.hiddenState v t) (fun i => hstate_nonneg NF v t i)]
          simp [FullyConnectedReLUNet.hiddenState, ht]
      have hidG_step : ∀ (t : ℕ) (v : Fin d → ℝ),
          (hidG t).reluApply (NG.hiddenState v t) = NG.hiddenState v (t + 1) := by
        intro t v
        by_cases ht : t < NG.depth - 1
        · simp [hidG, ht, FullyConnectedReLUNet.hiddenState]
        · have hid : hidG t = idLayer NG.width := by simp [hidG, ht]
          rw [hid]
          rw [hidLayer_id (NG.hiddenState v t) (fun i => hstate_nonneg NG v t i)]
          simp [FullyConnectedReLUNet.hiddenState, ht]
      have hidK_step : ∀ (t : ℕ) (p : Fin 2 → ℝ),
          (hidK t).reluApply (Nmul.hiddenState p t) = Nmul.hiddenState p (t + 1) := by
        intro t p
        by_cases ht : t < Nmul.depth - 1
        · simp [hidK, ht, FullyConnectedReLUNet.hiddenState]
        · have hid : hidK t = idLayer Nmul.width := by simp [hidK, ht]
          rw [hid]
          rw [hidLayer_id (Nmul.hiddenState p t) (fun i => hstate_nonneg Nmul p t i)]
          simp [FullyConnectedReLUNet.hiddenState, ht]
      -- projections of the block-diagonal layers
      have hprojF_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
          (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
          (v : Fin Wc → ℝ),
          projF ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = L1.reluApply (projF v) := by
        intro L1 L2 Lk v
        funext f
        simp only [projF, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
          fullDiag, pairDiag, Equiv.symm_apply_apply]
        rw [Fin.sum_univ_add, Fin.sum_univ_add]
        apply congrArg relu
        simp [Finset.mul_sum, Equiv.symm_apply_apply]
        try ring
      have hprojG_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
          (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
          (v : Fin Wc → ℝ),
          projG ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = L2.reluApply (projG v) := by
        intro L1 L2 Lk v
        funext g
        simp only [projF, projG, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
          fullDiag, pairDiag, Equiv.symm_apply_apply]
        rw [Fin.sum_univ_add, Fin.sum_univ_add]
        apply congrArg relu
        simp [Finset.mul_sum, Equiv.symm_apply_apply]
        try ring
      have hprojK_fullDiag : ∀ (L1 : DenseLayer NF.width NF.width)
          (L2 : DenseLayer NG.width NG.width) (Lk : DenseLayer Nmul.width Nmul.width)
          (v : Fin Wc → ℝ),
          projK ((fullDiag (pairDiag L1 L2) Lk).reluApply v) = Lk.reluApply (projK v) := by
        intro L1 L2 Lk v
        funext k
        simp only [projF, projG, projK, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply,
          reluVec, fullDiag, pairDiag, Equiv.symm_apply_apply]
        rw [Fin.sum_univ_add]
        apply congrArg relu
        simp [Finset.mul_sum, Equiv.symm_apply_apply]
        try ring
      have hprojK_fullDiag_id : ∀ (Lk : DenseLayer Nmul.width Nmul.width) (v : Fin Wc → ℝ),
          projK ((fullDiag (idLayer (NF.width + NG.width)) Lk).reluApply v) = Lk.reluApply (projK v) := by
        intro Lk v
        funext k
        simp only [projK, eK, DenseLayer.reluApply, DenseLayer.apply, reluVec,
          fullDiag, Equiv.symm_apply_apply]
        rw [Fin.sum_univ_add]
        apply congrArg relu
        simp [Finset.mul_sum, Equiv.symm_apply_apply]
        try ring
      -- projections of the input layer
      have hprojF_input : projF (inputL.reluApply x) = NF.hiddenState x 0 := by
        funext f
        simp [projF, eF, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu,
          FullyConnectedReLUNet.hiddenState, Equiv.symm_apply_apply]
      have hprojG_input : projG (inputL.reluApply x) = NG.hiddenState x 0 := by
        funext g
        simp [projF, projG, eF, eG, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec,
          relu, FullyConnectedReLUNet.hiddenState, Equiv.symm_apply_apply]
      have hprojK_input : projK (inputL.reluApply x) = 0 := by
        funext k
        simp [projK, eK, inputL, DenseLayer.reluApply, DenseLayer.apply, reluVec, relu,
          Equiv.symm_apply_apply]
      -- === composition correctness: Nc.realize x = gmul (approxF x, approxG x) ===
      have hM_ge1 : 1 ≤ M := by
        dsimp [M]
        exact le_trans (Nat.succ_le_of_lt hDf) (le_max_left Df Dg)
      have hlayer_M : M - 1 < D - 1 := by
        dsimp [D]
        omega
      have hrec_M : Nc.hiddenState x M = readOutL.reluApply (Nc.hiddenState x (M - 1)) := by
        have hM_eq : M = (M - 1) + 1 := by omega
        rw [hM_eq]
        have hstep : Nc.hiddenState x ((M - 1) + 1) =
            (Nc.hidden ⟨M - 1, hlayer_M⟩).reluApply (Nc.hiddenState x (M - 1)) := by
          simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer_M]
        rw [hstep]
        change (hid ⟨M - 1, hlayer_M⟩).reluApply (Nc.hiddenState x (M - 1)) =
          readOutL.reluApply (Nc.hiddenState x (M - 1))
        simp [hid, show ¬ M - 1 < M - 1 by omega]
      -- projection of the read-out layer on the gadget block
      have hprojK_readOut : ∀ v : Fin Wc → ℝ,
          projK (readOutL.reluApply v) = Nmul.input.reluApply (pairV v) := by
        intro v
        funext k
        simp only [projF, projG, projK, eF, eG, eK, DenseLayer.reluApply, DenseLayer.apply,
          reluVec, readOutL, pairV, Equiv.symm_apply_apply]
        apply congrArg relu
        rw [Fin.sum_univ_add, Fin.sum_univ_add]
        simp [Finset.mul_sum, Finset.sum_ite_eq, Fin.sum_univ_two, Equiv.symm_apply_apply]
        simp [Finset.mul_sum, Finset.sum_mul, mul_add, add_mul, mul_assoc, mul_comm,
          mul_left_comm, add_assoc, add_comm, add_left_comm]
      -- parallel-stage block states
      have hpair_stage : ∀ t : ℕ, t ≤ M - 1 →
          projF (Nc.hiddenState x t) = NF.hiddenState x t ∧
          projG (Nc.hiddenState x t) = NG.hiddenState x t ∧
          projK (Nc.hiddenState x t) = 0 := by
        intro t
        induction t with
        | zero =>
            intro ht
            constructor
            · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojF_input
            constructor
            · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojG_input
            · simpa [FullyConnectedReLUNet.hiddenState, Nc] using hprojK_input
        | succ t ih =>
            intro ht
            have hlt : t < M - 1 := by omega
            have hlayer : t < D - 1 := by
              dsimp [D]
              omega
            have hhid : Nc.hidden ⟨t, hlayer⟩ =
                fullDiag (pairDiag (hidF t) (hidG t)) (zeroLayer Nmul.width Nmul.width) := by
              change hid ⟨t, hlayer⟩ =
                fullDiag (pairDiag (hidF t) (hidG t)) (zeroLayer Nmul.width Nmul.width)
              simp [hid, hlt]
            have hrec : Nc.hiddenState x (t + 1) =
                (Nc.hidden ⟨t, hlayer⟩).reluApply (Nc.hiddenState x t) := by
              simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer]
            rcases ih (by omega : t ≤ M - 1) with ⟨hF_ih, hG_ih, hK_ih⟩
            constructor
            · rw [hrec, hhid]
              rw [hprojF_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                (Nc.hiddenState x t)]
              rw [hF_ih]
              exact hidF_step t x
            constructor
            · rw [hrec, hhid]
              rw [hprojG_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                (Nc.hiddenState x t)]
              rw [hG_ih]
              exact hidG_step t x
            · rw [hrec, hhid]
              rw [hprojK_fullDiag (hidF t) (hidG t) (zeroLayer Nmul.width Nmul.width)
                (Nc.hiddenState x t)]
              rw [hK_ih]
              exact hzeroLayer 0
      -- F/G blocks at the read-out input equal the final hidden states
      have hFM1 : projF (Nc.hiddenState x (M - 1)) = NF.hiddenState x (NF.depth - 1) := by
        rcases hpair_stage (M - 1) (by omega : M - 1 ≤ M - 1) with ⟨hF, _, _⟩
        calc
          projF (Nc.hiddenState x (M - 1)) = NF.hiddenState x (M - 1) := hF
          _ = NF.hiddenState x (NF.depth - 1) := by
              apply hstate_const
              have hle : NF.depth ≤ M := le_trans hNF_depth (le_max_left Df Dg)
              omega
      have hGM1 : projG (Nc.hiddenState x (M - 1)) = NG.hiddenState x (NG.depth - 1) := by
        rcases hpair_stage (M - 1) (by omega : M - 1 ≤ M - 1) with ⟨_, hG, _⟩
        calc
          projG (Nc.hiddenState x (M - 1)) = NG.hiddenState x (M - 1) := hG
          _ = NG.hiddenState x (NG.depth - 1) := by
              apply hstate_const
              have hle : NG.depth ≤ M := le_trans hNG_depth (le_max_right Df Dg)
              omega
      -- pair vector fed to the mul-net at the read-out
      let p : Fin 2 → ℝ := fun j => if j = 0 then NF.realize x else NG.realize x
      have hpairV0 : pairV (Nc.hiddenState x (M - 1)) 0 = NF.realize x := by
        simp only [pairV, ↓reduceIte]
        rw [hFM1]
        rfl
      have hpairV1 : pairV (Nc.hiddenState x (M - 1)) 1 = NG.realize x := by
        simp only [pairV, ↓reduceIte]
        rw [hGM1]
        rfl
      have hpairV_eq : pairV (Nc.hiddenState x (M - 1)) = p := by
        funext j
        fin_cases j
        · simp [p, hpairV0]
        · simp [p, hpairV1]
      -- gadget block right after the read-out equals Nmul.hiddenState p 0
      have hstate_M_K : projK (Nc.hiddenState x M) = Nmul.hiddenState p 0 := by
        rw [hrec_M]
        rw [hprojK_readOut (Nc.hiddenState x (M - 1))]
        rw [hpairV_eq]
        simp [FullyConnectedReLUNet.hiddenState]
      -- gadget-stage block states
      have hgadget_K : ∀ t : ℕ, M ≤ t → t ≤ D - 1 →
          projK (Nc.hiddenState x t) = Nmul.hiddenState p (t - M) := by
        intro t
        induction t with
        | zero =>
            intro htM htD
            omega
        | succ t ih =>
            intro htM htD
            by_cases hM : t + 1 = M
            · rw [hM]
              rw [hstate_M_K]
              rw [show M - M = 0 by omega]
            · have hMle : M ≤ t := by omega
              have hlayer : t < D - 1 := by omega
              have hnotP : ¬ t < M - 1 := by omega
              have hnotR : ¬ t = M - 1 := by omega
              have hhid : Nc.hidden ⟨t, hlayer⟩ =
                  fullDiag (idLayer (NF.width + NG.width)) (hidK (t - M)) := by
                change hid ⟨t, hlayer⟩ =
                  fullDiag (idLayer (NF.width + NG.width)) (hidK (t - M))
                simp [hid, hnotP, hnotR]
              have hrec : Nc.hiddenState x (t + 1) =
                  (Nc.hidden ⟨t, hlayer⟩).reluApply (Nc.hiddenState x t) := by
                simp [Nc, FullyConnectedReLUNet.hiddenState, hlayer]
              rw [hrec, hhid]
              rw [hprojK_fullDiag_id (hidK (t - M)) (Nc.hiddenState x t)]
              rw [ih hMle (by omega : t ≤ D - 1)]
              rw [hidK_step]
              congr 1
              omega
      -- final gadget state at depth D - 1
      have hfinalK : projK (Nc.hiddenState x (D - 1)) = Nmul.hiddenState p (Dmul - 1) := by
        have hg : M ≤ D - 1 := by
          dsimp [D]
          omega
        have hsub : (D - 1) - M = Dmul - 1 := by
          dsimp [D]
          omega
        rw [← hsub]
        exact hgadget_K (D - 1) hg (by omega : D - 1 ≤ D - 1)
      have hfinalK_raw : ∀ k : Fin Nmul.width,
          Nc.hiddenState x (D - 1) (Fin.natAdd (NF.width + NG.width) k) =
            Nmul.hiddenState p (Dmul - 1) k := by
        intro k
        exact congrFun hfinalK k
      have hreal : Nc.realize x = Nmul.realize p := by
        simp only [FullyConnectedReLUNet.realize]
        rw [Fin.sum_univ_add, Fin.sum_univ_add]
        rw [show Nc.outputWeight = outW by rfl]
        rw [show Nc.outputBias = Nmul.outputBias by rfl]
        have hdepth_const : Nmul.hiddenState p (Nmul.depth - 1) =
            Nmul.hiddenState p (Dmul - 1) := by
          exact (hstate_const Nmul p (Dmul - 1) (by omega)).symm
        simp [Nc, outW, hfinalK_raw, hdepth_const, Finset.mul_sum,
          Equiv.symm_apply_apply]
      have hcomp : gmul p = Nc.realize x := by
        rw [hreal]
        exact hNmul_eq p
      have hp0 : p 0 = approxF x := by
        simp [p]
        exact (hNF_eq x).symm
      have hp1 : p 1 = approxG x := by
        simp [p]
        exact (hNG_eq x).symm
      -- gadget error
      have hgmul_le : |gmul p - p 0 * p 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) := by
        apply hgmul_err
        · rw [hp0]
          exact happroxF_bound x hx
        · rw [hp1]
          exact happroxG_bound x hx
      -- product algebra error
      have hprod_le : |p 0 * p 1 - targetF x * targetG x| ≤ R * ηg + R * ηf := by
        have hsplit : p 0 * p 1 - targetF x * targetG x =
            p 0 * (p 1 - targetG x) + (p 0 - targetF x) * targetG x := by ring
        rw [hsplit]
        have hb0 : |p 0| ≤ R := by
          rw [hp0]
          exact happroxF_bound x hx
        have hb1 : |p 1 - targetG x| ≤ ηg := by
          rw [hp1]
          exact happroxG_err x hx
        have hb2 : |p 0 - targetF x| ≤ ηf := by
          rw [hp0]
          exact happroxF_err x hx
        have hb3 : |targetG x| ≤ R := htargetG_bound x hx
        have hterm1 : |p 0| * |p 1 - targetG x| ≤ R * ηg := by
          exact mul_le_mul hb0 hb1 (abs_nonneg _) (le_of_lt hR)
        have hterm2 : |p 0 - targetF x| * |targetG x| ≤ R * ηf := by
          calc
            |p 0 - targetF x| * |targetG x| ≤ ηf * R :=
              mul_le_mul hb2 hb3 (abs_nonneg _) hηf
            _ = R * ηf := by rw [mul_comm]
        calc
          |p 0 * (p 1 - targetG x) + (p 0 - targetF x) * targetG x|
              ≤ |p 0 * (p 1 - targetG x)| + |(p 0 - targetF x) * targetG x| := abs_add_le _ _
          _ ≤ (|p 0| * |p 1 - targetG x|) + (|p 0 - targetF x| * |targetG x|) := by
              exact add_le_add (abs_mul _ _).le (abs_mul _ _).le
          _ ≤ R * ηg + R * ηf := by
              exact add_le_add hterm1 hterm2
      calc
        |Nc.realize x - targetF x * targetG x| = |gmul p - targetF x * targetG x| := by
            rw [hcomp]
        _ = |(gmul p - p 0 * p 1) + (p 0 * p 1 - targetF x * targetG x)| := by
            congr 1
            ring
        _ ≤ |gmul p - p 0 * p 1| + |p 0 * p 1 - targetF x * targetG x| := abs_add_le _ _
        _ ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ) + R * ηg + R * ηf := by
            simpa [add_assoc] using (add_le_add hgmul_le hprod_le)

set_option maxHeartbeats 1000000 in
-- The fixed-width tensor tent construction unfolds several explicit network
-- compositions; the isolated waiting-list proof requires this local budget.
theorem exists_reluNetworkClass_axisAlignedBoxTentWeight_fixed_width_depth_rate_from_mul_gadget
    {d Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
      (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
      (hmul :
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
          ∃ Dmul Pmul : ℕ,
            0 < Dmul ∧
            (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
            Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
            ∃ gmul : (Fin 2 → ℝ) → ℝ,
              gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
                ∀ y : Fin 2 → ℝ,
                  |y 0| ≤ R → |y 1| ≤ R →
                    |gmul y - y 0 * y 1| ≤
                      cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ)) :
        ∃ Wtent : ℕ, 0 < Wtent ∧
          ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
            ∀ n : ℕ, 0 < n →
            ∀ center scale : Fin d → ℝ,
              (∀ q : Fin d, 0 ≤ scale q) →
              ∃ D P : ℕ,
                0 < D ∧
                (D : ℝ) ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) ∧
                P = fullyConnectedReLUParameterCount d D Wtent ∧
                ∃ g : (Fin d → ℝ) → ℝ,
                  g ∈ reluNetworkClass d D Wtent P ∧
                    ∀ x : Fin d → ℝ,
                      |g x - axisAlignedBoxTentWeight center scale x| ≤
                        cErr * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) := by
      let Wtent : ℕ := 2 + (d - 1) * (Wmul + 2)
      -- @step s1: Wtent = 2 + (d-1)·(Wmul+2), independent of n, center, scale; prove 0 < Wtent
      have hWtent_pos : 0 < Wtent := by
        unfold Wtent
        omega
      -- @step s2: induction on k: build width-Wtent networks approximating prefix tent products
      have h_approx :
          ∀ n : ℕ, 0 < n → ∀ center scale : Fin d → ℝ, (∀ q : Fin d, 0 ≤ scale q) →
            ∃ (D P : ℕ) (ε : ℝ),
              0 < D ∧
              P = fullyConnectedReLUParameterCount d D Wtent ∧
              ∃ g : (Fin d → ℝ) → ℝ,
                g ∈ reluNetworkClass d D Wtent P ∧
                ∀ x : Fin d → ℝ,
                            |g x - (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale q) x)| ≤ ε := by
                  intro n hn center scale hscale
                  -- @step s1: degenerate d = 0 case: constant-1 network with D := 1, ε := 0
                  have h_degenerate :
                      d = 0 →
                        ∃ (D P : ℕ) (ε : ℝ),
                          0 < D ∧
                          P = fullyConnectedReLUParameterCount d D Wtent ∧
                          ∃ g : (Fin d → ℝ) → ℝ,
                            g ∈ reluNetworkClass d D Wtent P ∧
                            ∀ x : Fin d → ℝ,
                              |g x - (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale q) x)| ≤ ε := by
                    intro hd
                    subst d
                    have hWtent_zero : Wtent = 2 := by
                      simp [Wtent]
                    use 1, fullyConnectedReLUParameterCount 0 1 2, 0
                    constructor
                    · norm_num
                    constructor
                    · rw [hWtent_zero]
                    · use (fun _ : Fin 0 → ℝ => 1)
                      constructor
                      · rw [hWtent_zero]
                        let N : FullyConnectedReLUNet 0 :=
                          { depth := 1, width := 2,
                            input := { weight := fun _ _ => (0 : ℝ), bias := fun _ => (0 : ℝ) },
                            hidden := fun _ => { weight := fun _ _ => (0 : ℝ), bias := fun _ => (0 : ℝ) },
                            outputWeight := fun _ => (0 : ℝ), outputBias := 1 }
                        refine ⟨N, ?_⟩
                        dsimp [N]
                        constructor
                        · norm_num
                        constructor
                        · norm_num
                        constructor
                        · norm_num
                        constructor
                        · exact le_rfl
                        · intro x
                          simp [FullyConnectedReLUNet.realize]
                      · intro x
                        simp
                  -- @step s2: prefix-product boundedness: every prefix tent product lies in [-1, 1]
                  have h_prefix_bound :
                      ∀ (k : ℕ), 1 ≤ k → k ≤ d → ∀ x : Fin d → ℝ,
                        |∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1| ≤ 1 := by
                    intro k hk1 hkd x
                    let scale' : Fin d → ℝ := fun q => if (q : ℕ) < k then scale q else 0
                    -- @step s1: nonnegativity of the truncated scale scale'
                    have hscale' : ∀ q : Fin d, 0 ≤ scale' q := by
                      intro q
                      by_cases hq : (q : ℕ) < k
                      · simp [scale', hq, hscale q]
                      · simp [scale', hq]
                    -- @step s2: factorwise identity (zero-scale tent collapses to 1)
                    have hfactor : ∀ q : Fin d, coordinateTentReLUFunction q (center q) (scale' q) x = if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1 := by
                                          intro q
                                          by_cases hq : (q : ℕ) < k
                                          · simp [scale', hq]
                                          · simp [scale', hq, coordinateTentReLUFunction, relu]
                    -- @step s3: prefix product equals the truncated box tent
                    have hprod : (∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1) = axisAlignedBoxTentWeight center scale' x := by
                      rw [axisAlignedBoxTentWeight]
                      simp [hfactor]
                    -- @step s4: apply E4 bounds + |z| = z for 0 ≤ z
                    have hbound : |∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1| ≤ 1 := by
                      have hE4 := axisAlignedBoxTentWeight_bounds_and_support center scale' x hscale'
                      have hW_lo : 0 ≤ axisAlignedBoxTentWeight center scale' x := hE4.1
                      have hW_hi : axisAlignedBoxTentWeight center scale' x ≤ 1 := hE4.2.1
                      rw [hprod]
                      rw [abs_of_nonneg hW_lo]
                      exact hW_hi
                    exact hbound
                  -- @step s3: base case k = 1: exact network for the first tent factor, width 2
                  have h_base :
                      ∃ (D P : ℕ) (ε : ℝ),
                        0 < D ∧
                        P = fullyConnectedReLUParameterCount d D 2 ∧
                        ∃ v : (Fin d → ℝ) → ℝ,
                          v ∈ reluNetworkClass d D 2 P ∧
                          ∀ x : Fin d → ℝ,
                            |v x - (∏ q : Fin d, if (q : ℕ) < 1 then coordinateTentReLUFunction q (center q) (scale q) x else 1)| ≤ ε := by
                    by_cases hd : d = 0
                    · rcases h_degenerate hd with ⟨D, P, ε, hDpos, hP, g, hg, herr⟩
                      subst d
                      refine ⟨D, P, ε, hDpos, ?_, g, ?_, ?_⟩
                      · simpa [Wtent] using hP
                      · simpa [Wtent] using hg
                      · intro x
                        simpa [Wtent] using herr x
                    · have hdpos : 0 < d := Nat.pos_of_ne_zero hd
                      let q0 : Fin d := ⟨0, hdpos⟩
                      let t : (Fin d → ℝ) → ℝ := fun x => coordinateTentReLUFunction q0 (center q0) (scale q0) x
                      refine ⟨2, fullyConnectedReLUParameterCount d 2 2, 0, by norm_num, by rfl, t, ?_, ?_⟩
                      · simpa [t] using
                          (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.coordinateTentReLUFunction_mem_reluNetworkClass_with_parameter_bound
                            q0 (center q0) (scale q0) (by norm_num) (by norm_num) (by exact le_of_eq rfl))
                      · intro x
                        have hprod :
                            (∏ q : Fin d, if (q : ℕ) < 1 then coordinateTentReLUFunction q (center q) (scale q) x else 1) = t x := by
                          rw [Finset.prod_eq_single q0]
                          · simp [t, q0]
                          · intro b hb hbneq
                            have hb0 : (b : ℕ) ≠ 0 := by
                              intro hb0
                              exact hbneq (Fin.ext (by simp [q0, hb0]))
                            have hbge : ¬ (b : ℕ) < 1 := by omega
                            simp [hbge]
                          · simp
                        rw [hprod]
                        simp
                  -- @step s4: recursion: from a width-W_k network for prefix k, build width-W_{k+1} for prefix k+1
                  have h_step :
                      ∀ (k : ℕ), 1 ≤ k → k < d →
                        (∃ (D P : ℕ) (ε : ℝ),
                          0 < D ∧
                          P = fullyConnectedReLUParameterCount d D (2 + (k - 1) * (Wmul + 2)) ∧
                          ∃ v : (Fin d → ℝ) → ℝ,
                            v ∈ reluNetworkClass d D (2 + (k - 1) * (Wmul + 2)) P ∧
                            ∀ x : Fin d → ℝ,
                              |v x - (∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1)| ≤ ε) →
                        ∃ (D P : ℕ) (ε : ℝ),
                          0 < D ∧
                          P = fullyConnectedReLUParameterCount d D (2 + k * (Wmul + 2)) ∧
                          ∃ v : (Fin d → ℝ) → ℝ,
                            v ∈ reluNetworkClass d D (2 + k * (Wmul + 2)) P ∧
                            ∀ x : Fin d → ℝ,
                              |v x - (∏ q : Fin d, if (q : ℕ) < k + 1 then coordinateTentReLUFunction q (center q) (scale q) x else 1)| ≤ ε := by
                    intro k hk1 hklt hprev
                    rcases hprev with ⟨Dprev, Pprev, ε, hDprev, hPprev, vprev, hvprev, herrprev⟩
                    -- @step s1: qk : Fin d with (qk : ℕ) = k exists (k < d); tent t := coordinateTentReLUFunction qk (center qk) (scale qk) satisfies 0 ≤ t x ≤ 1
                    have h_tent_bounds : ∃ qk : Fin d, (qk : ℕ) = k ∧
                        ∀ x : Fin d → ℝ,
                          0 ≤ coordinateTentReLUFunction qk (center qk) (scale qk) x ∧
                            coordinateTentReLUFunction qk (center qk) (scale qk) x ≤ 1 := by
                      let qk : Fin d := ⟨k, hklt⟩
                      let t : (Fin d → ℝ) → ℝ := fun x => coordinateTentReLUFunction qk (center qk) (scale qk) x
                      let scale' : Fin d → ℝ := fun q => if q = qk then scale qk else 0
                      have hscale' : ∀ q : Fin d, 0 ≤ scale' q := by
                        intro q
                        by_cases hq : q = qk
                        · simp [scale', hq, hscale qk]
                        · simp [scale', hq]
                      refine ⟨qk, rfl, ?_⟩
                      intro x
                      have hfactor : ∀ q : Fin d,
                          coordinateTentReLUFunction q (center q) (scale' q) x = if q = qk then t x else 1 := by
                        intro q
                        by_cases hq : q = qk
                        · simp [scale', hq, t]
                        · simp [scale', hq, coordinateTentReLUFunction, relu]
                      have hfactor_prod :
                          (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale' q) x)
                            = (∏ q : Fin d, if q = qk then t x else 1) := by
                        apply Finset.prod_congr rfl
                        intro q hq
                        exact hfactor q
                      have hprod : axisAlignedBoxTentWeight center scale' x = t x := by
                        unfold axisAlignedBoxTentWeight
                        rw [hfactor_prod]
                        simpa using
                          (Finset.prod_eq_single (s := Finset.univ)
                            (f := fun q : Fin d => if q = qk then t x else 1) qk
                            (by intro b hb hbneq; simp [hbneq])
                            (by intro hnotin; exact (hnotin (Finset.mem_univ qk)).elim))
                      constructor
                      · have hW := (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.axisAlignedBoxTentWeight_bounds_and_support center scale' x hscale').1
                        simpa [t, hprod] using hW
                      · have hW := (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.axisAlignedBoxTentWeight_bounds_and_support center scale' x hscale').2.1
                        simpa [t, hprod] using hW
                    -- @step s2: tent network membership: t ∈ reluNetworkClass d 2 2 (coordinateTentReLUParameterBound d) via E7
                    have h_tent_mem : ∀ qk : Fin d,
                        coordinateTentReLUFunction qk (center qk) (scale qk) ∈
                          reluNetworkClass d 2 2 (coordinateTentReLUParameterBound d) := by
                      intro qk
                      exact (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.coordinateTentReLUFunction_mem_reluNetworkClass_with_parameter_bound
                        (d := d) (depthBudget := 2) (widthBudget := 2)
                        (parameterBudget := coordinateTentReLUParameterBound d) qk (center qk) (scale qk)
                        (by norm_num) (by norm_num) (le_rfl))
                    -- @step s3: E6 gadget gives a width-W_{k+1} network h for T_k * t with the two-error bound
                    have h_gadget : ∀ qk : Fin d,
                        ∃ (D' P' : ℕ),
                          0 < D' ∧
                            P' = fullyConnectedReLUParameterCount d D' (2 + k * (Wmul + 2)) ∧
                            ∃ h : (Fin d → ℝ) → ℝ,
                              h ∈ reluNetworkClass d D' (2 + k * (Wmul + 2)) P' ∧
                                ∀ x : Fin d → ℝ,
                                  |h x - (∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1) * coordinateTentReLUFunction qk (center qk) (scale qk) x| ≤
                                    cMulErr * (1 + ε) ^ 2 * (n : ℝ).rpow (-2 : ℝ) + (1 + ε) * ε := by
                      intro qk
                      let t : (Fin d → ℝ) → ℝ := fun x => coordinateTentReLUFunction qk (center qk) (scale qk) x
                      let Tk : (Fin d → ℝ) → ℝ := fun x => ∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1
                      have hε_nonneg : 0 ≤ ε := by
                        exact le_trans (abs_nonneg _) (by simpa [Tk] using herrprev (fun _ : Fin d => 0))
                      have hTk_bound : ∀ x : Fin d → ℝ, |Tk x| ≤ 1 := by
                        intro x
                        simpa [Tk] using h_prefix_bound k hk1 (le_of_lt hklt) x
                      have ht_bounds : ∀ x : Fin d → ℝ, 0 ≤ t x ∧ t x ≤ 1 := by
                        intro x
                        let scale' : Fin d → ℝ := fun q => if q = qk then scale qk else 0
                        have hscale' : ∀ q : Fin d, 0 ≤ scale' q := by
                          intro q
                          by_cases hq : q = qk
                          · simp [scale', hq, hscale qk]
                          · simp [scale', hq]
                        have hfactor : ∀ q : Fin d,
                            coordinateTentReLUFunction q (center q) (scale' q) x = if q = qk then t x else 1 := by
                          intro q
                          by_cases hq : q = qk
                          · simp [scale', hq, t]
                          · simp [scale', hq, coordinateTentReLUFunction, relu]
                        have hfactor_prod :
                            (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale' q) x)
                              = (∏ q : Fin d, if q = qk then t x else 1) := by
                          apply Finset.prod_congr rfl
                          intro q hq
                          exact hfactor q
                        have hprod : axisAlignedBoxTentWeight center scale' x = t x := by
                          unfold axisAlignedBoxTentWeight
                          rw [hfactor_prod]
                          simpa using
                            (Finset.prod_eq_single (s := Finset.univ)
                              (f := fun q : Fin d => if q = qk then t x else 1) qk
                              (by intro b hb hbneq; simp [hbneq])
                              (by intro hnotin; exact (hnotin (Finset.mem_univ qk)).elim))
                        constructor
                        · have hW := (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.axisAlignedBoxTentWeight_bounds_and_support center scale' x hscale').1
                          simpa [t, hprod] using hW
                        · have hW := (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.axisAlignedBoxTentWeight_bounds_and_support center scale' x hscale').2.1
                          simpa [t, hprod] using hW
                      have ht_abs_bound : ∀ x : Fin d → ℝ, |t x| ≤ 1 := by
                        intro x
                        have h := ht_bounds x
                        rw [abs_of_nonneg h.1]
                        exact h.2
                      have ht_R_bound : ∀ x : Fin d → ℝ, |t x| ≤ 1 + ε := by
                        intro x
                        calc
                          |t x| ≤ 1 := ht_abs_bound x
                          _ ≤ 1 + ε := by linarith [hε_nonneg]
                      have hvprev_R_bound : ∀ x : Fin d → ℝ, |vprev x| ≤ 1 + ε := by
                        intro x
                        calc
                          |vprev x| = |(vprev x - Tk x) + Tk x| := by
                            congr 1
                            ring
                          _ ≤ |vprev x - Tk x| + |Tk x| := abs_add_le _ _
                          _ ≤ ε + 1 := add_le_add (by simpa [Tk] using herrprev x) (hTk_bound x)
                          _ = 1 + ε := by ring
                      have hE6 :=
                        (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget
                          (d := d) (Df := Dprev) (Dg := 2) (Wf := 2 + (k - 1) * (Wmul + 2)) (Wg := 2)
                          (Pf := Pprev) (Pg := coordinateTentReLUParameterBound d) (Wmul := Wmul)
                          hDprev (by norm_num) (by omega) (by norm_num) hWmul
                          hcMulDepth hcMulErr hmul
                          (domain := fun _ : Fin d → ℝ => True)
                          (targetF := Tk) (targetG := t) (approxF := vprev) (approxG := t)
                          (ηf := ε) (ηg := 0) (R := 1 + ε)
                          hε_nonneg (by norm_num) (by linarith)
                          (by simpa using hvprev)
                          (by simpa [t] using h_tent_mem qk)
                          (by intro x hx; exact hvprev_R_bound x)
                          (by intro x hx; exact ht_R_bound x)
                          (by intro x hx; exact ht_R_bound x)
                          (by intro x hx; simpa [Tk] using herrprev x)
                          (by intro x hx; simp))
                      rcases hE6 with ⟨cDepth, hcDepth_pos, hE6res⟩
                      rcases hE6res n hn with ⟨D', P', hD'pos, hDepthBound', hP', h, hmem, hErr⟩
                      have hwidth : (2 + (k - 1) * (Wmul + 2)) + 2 + Wmul = 2 + k * (Wmul + 2) := by
                        calc
                          (2 + (k - 1) * (Wmul + 2)) + 2 + Wmul = 2 + ((k - 1) + 1) * (Wmul + 2) := by ring
                          _ = 2 + k * (Wmul + 2) := by rw [Nat.sub_add_cancel hk1]
                      refine ⟨D', P', hD'pos, ?_, h, ?_, ?_⟩
                      · rw [hP', hwidth]
                      · rw [hwidth] at hmem
                        exact hmem
                      · intro x
                        simpa [Tk, t] using hErr x trivial
                    -- @step s4: prefix-product identity: T_k * t = T_{k+1} at qk
                    have h_prefix_prod : ∀ qk : Fin d, (qk : ℕ) = k →
                        ∀ x : Fin d → ℝ,
                          (∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1) * coordinateTentReLUFunction qk (center qk) (scale qk) x =
                            ∏ q : Fin d, if (q : ℕ) < k + 1 then coordinateTentReLUFunction q (center q) (scale q) x else 1 := by
                      intro qk hqk x
                      let tent : Fin d → ℝ := fun q => coordinateTentReLUFunction q (center q) (scale q) x
                      let f : Fin d → ℝ := fun q => if (q : ℕ) < k then tent q else 1
                      let h : Fin d → ℝ := fun q => if (q : ℕ) < k + 1 then tent q else 1
                      let δ : Fin d → ℝ := fun q => if q = qk then tent qk else 1
                      have h_fact : ∀ q : Fin d, h q = f q * δ q := by
                        intro q
                        by_cases hq : q = qk
                        · subst q
                          have hqk_lt : (qk : ℕ) < k + 1 := by omega
                          have hqk_notlt : ¬ (qk : ℕ) < k := by omega
                          change (if (qk : ℕ) < k + 1 then tent qk else 1) = (if (qk : ℕ) < k then tent qk else 1) * (if qk = qk then tent qk else 1)
                          rw [if_pos hqk_lt, if_neg hqk_notlt, if_pos rfl]
                          simp
                        · have hne : (q : ℕ) ≠ k := by
                            intro hEq
                            exact hq (Fin.ext (hEq.trans hqk.symm))
                          by_cases hlt : (q : ℕ) < k
                          · have hlt' : (q : ℕ) < k + 1 := by omega
                            change (if (q : ℕ) < k + 1 then tent q else 1) = (if (q : ℕ) < k then tent q else 1) * (if q = qk then tent qk else 1)
                            rw [if_pos hlt', if_pos hlt, if_neg hq]
                            simp
                          · have hnot : ¬ (q : ℕ) < k + 1 := by omega
                            change (if (q : ℕ) < k + 1 then tent q else 1) = (if (q : ℕ) < k then tent q else 1) * (if q = qk then tent qk else 1)
                            rw [if_neg hnot, if_neg hlt, if_neg hq]
                            simp
                      have hδ : (∏ q : Fin d, δ q) = tent qk := by
                        have hδqk : δ qk = tent qk := by
                          change (if qk = qk then tent qk else 1) = tent qk
                          simp
                        rw [← hδqk]
                        apply Finset.prod_eq_single qk
                        · intro b hb hneq
                          change (if b = qk then tent qk else 1) = 1
                          rw [if_neg hneq]
                        · intro hnot
                          exfalso
                          exact hnot (by simp)
                      calc
                        (∏ q : Fin d, if (q : ℕ) < k then coordinateTentReLUFunction q (center q) (scale q) x else 1) * coordinateTentReLUFunction qk (center qk) (scale qk) x = (∏ q : Fin d, f q) * tent qk := by
                          simp [f, tent]
                        _ = (∏ q : Fin d, h q) := by
                          rw [← hδ, ← Finset.prod_mul_distrib]
                          exact Finset.prod_congr rfl (by intro q hqmem; exact (h_fact q).symm)
                        _ = ∏ q : Fin d, if (q : ℕ) < k + 1 then coordinateTentReLUFunction q (center q) (scale q) x else 1 := by
                          simp [h, tent]
                    -- @step s5: assemble the h_step existential from s3 + s4
                    have h_final : ∃ (D P : ℕ) (ε' : ℝ),
                        0 < D ∧
