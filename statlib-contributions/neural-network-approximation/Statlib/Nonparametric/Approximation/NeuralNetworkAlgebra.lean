/-- Simultaneously round every normalized Taylor-propagation residual to the
bounded signed alphabet used by shallow ReLU and encode each correction
sequence as a fixed-base fractional tail. -/
theorem exists_reluApprox_bounded_correction_code
    {d r M : Nat} (hM : 0 < M)
    (residual : Fin (M ^ d) -> Fin (M ^ d) -> TaylorMultiindex r d -> Real)
    (scale : TaylorMultiindex r d -> Real)
    (hscale : forall a, 0 < scale a)
    (hresidual : forall i k a,
      |residual i k a / scale a| <= Real.exp (d : Real) + 1) :
    let cDigit : Nat := Nat.ceil (Real.exp (d : Real))
    let base : Nat := 4 + 2 * cDigit
    exists correction : Fin (M ^ d) -> Fin (M ^ d) -> TaylorMultiindex r d -> Int,
    exists digit : Fin (M ^ d) -> Fin (M ^ d) -> TaylorMultiindex r d -> Nat,
    exists code : Fin (M ^ d) -> TaylorMultiindex r d -> Real,
      (forall i k a,
        -(cDigit : Int) - 1 <= correction i k a /\
          correction i k a <= (cDigit : Int) + 1) /\
      (forall i k a,
        (digit i k a : Int) = correction i k a + ((cDigit : Int) + 2) /\
          1 <= digit i k a /\ digit i k a <= 2 * cDigit + 3) /\
      (forall i a,
        code i a = Finset.univ.sum (fun k : Fin (M ^ d) =>
          (digit i k a : Real) / (base : Real) ^ (k.val + 1))) /\
      (forall i k a,
        0 <= residual i k a - (correction i k a : Real) * scale a /\
          residual i k a - (correction i k a : Real) * scale a < scale a) /\
      forall i a, 0 <= code i a /\ code i a < 1 := by
  /-
  Proof route: for every `(i,k,a)`, let `z = residual i k a / scale a`
  and choose `correction = floor z`.  `Int.floor_le` and
  `Int.lt_floor_add_one`, multiplied by the positive `scale a`, give the
  half-open residual interval.  Compare `exp d` with `Nat.ceil (exp d)` to
  obtain the uniform signed bound.  Shift by `cDigit + 2` and use `Int.toNat`
  to define digits in `[1, 2*cDigit+3]`.  Define `code` by the displayed finite
  sum.  Its lower bound is termwise; for the strict upper bound dominate each
  digit by `base-1` and evaluate the finite geometric series.  Use `hM` to know
  the tail length `M^d` is positive.
  -/
  let e : ℝ := Real.exp (d : ℝ)
  let c : Nat := Nat.ceil e
  let B : Nat := 4 + 2 * c
  let corr : Fin (M ^ d) → Fin (M ^ d) → TaylorMultiindex r d → Int :=
    fun i k a => Int.floor (residual i k a / scale a)
  let dig : Fin (M ^ d) → Fin (M ^ d) → TaylorMultiindex r d → Nat :=
    fun i k a => Int.toNat (corr i k a + ((c : Int) + 2))
  let cod : Fin (M ^ d) → TaylorMultiindex r d → ℝ :=
    fun i a => Finset.univ.sum (fun k : Fin (M ^ d) => (dig i k a : ℝ) / (B : ℝ) ^ (k.val + 1))
  have hcorr_b : ∀ i k a, -(c : Int) - 1 ≤ corr i k a ∧ corr i k a ≤ (c : Int) + 1 := by
    intro i k a
    let z : ℝ := residual i k a / scale a
    have hc_exp : e ≤ (c : ℝ) := by simpa [c] using Nat.le_ceil e
    have hzabs : |z| ≤ e + 1 := by simpa [z, e] using hresidual i k a
    have hzlo : -(e + 1) ≤ z := (abs_le.mp hzabs).1
    have hzhi : z ≤ e + 1 := (abs_le.mp hzabs).2
    constructor
    · have h1 : -(c : ℝ) - 1 ≤ z := by linarith
      have h2 : z < (Int.floor z : ℝ) + 1 := Int.lt_floor_add_one z
      have h3 : -(c : ℝ) - 2 < (Int.floor z : ℝ) := by linarith
      have h3i : -(c : Int) - 2 < Int.floor z := by exact_mod_cast h3
      have h4i : -(c : Int) - 1 ≤ Int.floor z := by omega
      simpa [corr, z] using h4i
    · have h1 : z ≤ (c : ℝ) + 1 := by linarith
      have h2 : (Int.floor z : ℝ) ≤ z := Int.floor_le z
      have h3 : (Int.floor z : ℝ) ≤ (c : ℝ) + 1 := by linarith
      have h3i : Int.floor z ≤ (c : Int) + 1 := by exact_mod_cast h3
      simpa [corr, z] using h3i
  have hdig_cast : ∀ i k a, (dig i k a : Int) = corr i k a + ((c : Int) + 2) := by
    intro i k a
    have hw0 : 0 ≤ corr i k a + ((c : Int) + 2) := by
      have hlo := (hcorr_b i k a).1
      omega
    change (Int.toNat (corr i k a + ((c : Int) + 2)) : Int) = corr i k a + ((c : Int) + 2)
    rw [Int.toNat_of_nonneg hw0]
  have hdig_lo : ∀ i k a, 1 ≤ dig i k a := by
    intro i k a
    have hw1 : (1 : Int) ≤ corr i k a + ((c : Int) + 2) := by
      have hlo := (hcorr_b i k a).1
      omega
    have hz : (1 : Int) ≤ (dig i k a : Int) := by
      rw [hdig_cast i k a]
      exact hw1
    exact_mod_cast hz
  have hdig_hi : ∀ i k a, dig i k a ≤ 2 * c + 3 := by
    intro i k a
    have hw2 : corr i k a + ((c : Int) + 2) ≤ (2 : Int) * (c : Int) + 3 := by
      have hhi := (hcorr_b i k a).2
      omega
    have hz : (dig i k a : Int) ≤ (2 : Int) * (c : Int) + 3 := by
      rw [hdig_cast i k a]
      exact hw2
    exact_mod_cast hz
  have hmain :
      (∀ i k a, -(c : Int) - 1 ≤ corr i k a ∧ corr i k a ≤ (c : Int) + 1) ∧
      (∀ i k a, (dig i k a : Int) = corr i k a + ((c : Int) + 2) ∧ 1 ≤ dig i k a ∧ dig i k a ≤ 2 * c + 3) := by
    constructor
    · exact hcorr_b
    · intro i k a
      exact ⟨hdig_cast i k a, ⟨hdig_lo i k a, hdig_hi i k a⟩⟩
  have hBge4 : 4 ≤ B := by dsimp [B]; omega
  have hBge1 : 1 ≤ B := by dsimp [B]; omega
  have hBposN : 0 < B := by dsimp [B]; omega
  have hBpos : (0 : ℝ) < (B : ℝ) := by exact_mod_cast hBposN
  have hBne : (B : ℝ) ≠ 0 := ne_of_gt hBpos
  have hBm1 : ((B - 1 : Nat) : ℝ) = (B : ℝ) - 1 := by
    simpa using (Nat.cast_sub hBge1)
  have hdigB : ∀ i k a, dig i k a ≤ B - 1 := by
    intro i k a
    have hhi := hdig_hi i k a
    dsimp [B]
    omega
  have hgeo :
      (Finset.univ.sum (fun k : Fin (M ^ d) => ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (k.val + 1))) =
        1 - (B : ℝ)⁻¹ ^ (M ^ d) := by
    calc
      (Finset.univ.sum (fun k : Fin (M ^ d) => ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (k.val + 1)))
          = ∑ j ∈ Finset.range (M ^ d), ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (j + 1) := by
            simpa using (Fin.sum_univ_eq_sum_range
              (fun n : ℕ => ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (n + 1)) (M ^ d))
      _ = 1 - (B : ℝ)⁻¹ ^ (M ^ d) := by
            have hterm : ∀ j : ℕ,
                ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (j + 1) =
                  (B : ℝ)⁻¹ ^ j * (1 - (B : ℝ)⁻¹) := by
              intro j
              rw [hBm1, pow_succ, inv_pow]
              field_simp [hBne]

            calc
              (∑ j ∈ Finset.range (M ^ d), ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (j + 1))
                  = ∑ j ∈ Finset.range (M ^ d), ((B : ℝ)⁻¹ ^ j * (1 - (B : ℝ)⁻¹)) := by
                    refine Finset.sum_congr rfl ?_
                    intro j hj
                    exact hterm j
              _ = (∑ j ∈ Finset.range (M ^ d), (B : ℝ)⁻¹ ^ j) * (1 - (B : ℝ)⁻¹) := by
                    rw [Finset.sum_mul]
              _ = 1 - (B : ℝ)⁻¹ ^ (M ^ d) := by
                    exact geom_sum_mul_neg (B : ℝ)⁻¹ (M ^ d)
  refine ⟨corr, dig, cod, ?_, ?_, ?_, ?_, ?_⟩
  · intro i k a
    exact (hmain.1 i k a)
  · intro i k a
    exact (hmain.2 i k a)
  · intro i a
    rfl
  · intro i k a
    have hz1 : (corr i k a : ℝ) ≤ residual i k a / scale a :=
      Int.floor_le (residual i k a / scale a)
    have hz2 : residual i k a / scale a < (corr i k a : ℝ) + 1 :=
      Int.lt_floor_add_one (residual i k a / scale a)
    have hsca_pos : 0 < scale a := hscale a
    have hsca_ne : scale a ≠ 0 := ne_of_gt hsca_pos
    constructor
    · have hmul : (corr i k a : ℝ) * scale a ≤ (residual i k a / scale a) * scale a :=
        mul_le_mul_of_nonneg_right hz1 (le_of_lt hsca_pos)
      have hcancel : (residual i k a / scale a) * scale a = residual i k a := by
        field_simp [hsca_ne]
      nlinarith
    · have hmul : (residual i k a / scale a) * scale a < ((corr i k a : ℝ) + 1) * scale a :=
        mul_lt_mul_of_pos_right hz2 hsca_pos
      have hcancel : (residual i k a / scale a) * scale a = residual i k a := by
        field_simp [hsca_ne]
      nlinarith
  · intro i a
    have hterm0 : ∀ k : Fin (M ^ d), 0 ≤ (dig i k a : ℝ) / (B : ℝ) ^ (k.val + 1) := by
      intro k
      have hd0 : (0 : ℝ) ≤ (dig i k a : ℝ) := by exact_mod_cast (Nat.zero_le (dig i k a))
      have hp : 0 < (B : ℝ) ^ (k.val + 1) := pow_pos hBpos (k.val + 1)
      exact div_nonneg hd0 (le_of_lt hp)
    have hterm1 : ∀ k : Fin (M ^ d),
        (dig i k a : ℝ) / (B : ℝ) ^ (k.val + 1) ≤ ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (k.val + 1) := by
      intro k
      have hnum : (dig i k a : ℝ) ≤ ((B - 1 : Nat) : ℝ) := by
        exact_mod_cast (hdigB i k a)
      have hp : 0 < (B : ℝ) ^ (k.val + 1) := pow_pos hBpos (k.val + 1)
      have hdeninv : 0 ≤ ((B : ℝ) ^ (k.val + 1))⁻¹ := by
        exact inv_nonneg.mpr (le_of_lt hp)
      calc
        (dig i k a : ℝ) / (B : ℝ) ^ (k.val + 1)
            = (dig i k a : ℝ) * ((B : ℝ) ^ (k.val + 1))⁻¹ := by rw [div_eq_mul_inv]
        _ ≤ ((B - 1 : Nat) : ℝ) * ((B : ℝ) ^ (k.val + 1))⁻¹ := by
            exact mul_le_mul_of_nonneg_right hnum hdeninv
        _ = ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (k.val + 1) := by rw [div_eq_mul_inv]
    have hbound : cod i a ≤ 1 - (B : ℝ)⁻¹ ^ (M ^ d) := by
      calc
        cod i a = Finset.univ.sum (fun k : Fin (M ^ d) => (dig i k a : ℝ) / (B : ℝ) ^ (k.val + 1)) := rfl
        _ ≤ Finset.univ.sum (fun k : Fin (M ^ d) => ((B - 1 : Nat) : ℝ) / (B : ℝ) ^ (k.val + 1)) := by
            exact Finset.sum_le_sum (fun k hk => hterm1 k)
        _ = 1 - (B : ℝ)⁻¹ ^ (M ^ d) := hgeo
    have hpow : 0 < (B : ℝ)⁻¹ ^ (M ^ d) := by
      exact pow_pos (inv_pos.mpr hBpos) (M ^ d)
    constructor
    · unfold cod
      exact Finset.sum_nonneg (fun k hk => hterm0 k)
    · have hlt : 1 - (B : ℝ)⁻¹ ^ (M ^ d) < 1 := by linarith
      exact lt_of_le_of_lt hbound hlt


/-- The `M^d` offsets in one coarse cube have a serpentine ordering which
starts at the zero offset and changes exactly one coordinate by one grid step
between consecutive offsets.  The signed step is intentional: in dimensions
greater than one, a Hamilton path through the grid necessarily uses both
directions. -/
theorem exists_reluApprox_serpentine_fineGrid_equiv
    (M d : Nat) (hM : 0 < M) :
    exists order : Fin (M ^ d) ≃ (Fin d -> Fin M),
      order ⟨0, pow_pos hM d⟩ = (fun _ => ⟨0, hM⟩) /\
      forall (k : Nat) (hk : k + 1 < M ^ d),
        exists q : Fin d,
          Int.natAbs
              (((order ⟨k + 1, hk⟩ q).val : Int) -
                ((order ⟨k, lt_trans (Nat.lt_succ_self k) hk⟩ q).val : Int)) = 1 /\
          forall u : Fin d, u != q ->
            order ⟨k + 1, hk⟩ u =
              order ⟨k, lt_trans (Nat.lt_succ_self k) hk⟩ u := by
  /-
  Proof route: induct on `d`.  For the successor step, partition the grid into
  `M` slices according to the last coordinate.  Traverse even slices using the
  lower-dimensional order and odd slices using its reversal.  Consecutive
  points inside a slice inherit the induction hypothesis; slice endpoints agree
  in the first `d` coordinates and differ by one in the new coordinate.  Assemble
  the indexing equivalence using `Fintype.card_congr`, `Fintype.card_fun`, and
  `Fintype.card_fin`.  Do not impose a positive-only increment: that statement
  is false for a multidimensional Hamilton path.
  -/
  induction d with
  | zero =>
      have hcard : Fintype.card (Fin (M ^ 0)) = Fintype.card (Fin 0 → Fin M) := by
        rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
        rfl
      refine ⟨Fintype.equivOfCardEq hcard, ?_, ?_⟩
      · funext x
        rcases x with ⟨x, hx⟩
        omega
      · intro k hk
        exfalso
        simp only [pow_zero] at hk
        omega
  | succ n ih =>
      rcases ih with ⟨E, hE0, hEadj⟩
      let N := M ^ n
      have hNpos : 0 < N := by
        dsimp [N]
        exact pow_pos hM n
      classical
      -- a vector v : Fin (n+1) → Fin M is identified with (first n coords, last)
      let vecEquiv : ((Fin n → Fin M) × Fin M) ≃ (Fin (n + 1) → Fin M) :=
        { toFun := fun p => Fin.lastCases p.2 p.1
          invFun := fun v => (fun i => v i.castSucc, v (Fin.last n))
          left_inv := by
            intro p
            rcases p with ⟨f, x⟩
            apply Prod.ext
            · funext i
              simp [Fin.lastCases_castSucc]
            · simp [Fin.lastCases_last]
          right_inv := by
            intro v
            funext u
            refine Fin.lastCases ?_ ?_ u
            · simp [Fin.lastCases_last]
            · intro i
              simp [Fin.lastCases_castSucc] }
      -- snake equivalence on slice pairs: (slice s, offset t) ↦ (lower, s)
      let snakeEquiv : Fin M × Fin N ≃ ((Fin n → Fin M) × Fin M) :=
        { toFun := fun p => (if Even p.1.val then E p.2 else E (Fin.rev p.2), p.1)
          invFun := fun p => (p.2, if Even p.2.val then E.symm p.1 else Fin.rev (E.symm p.1))
          left_inv := by
            intro p
            rcases p with ⟨s, t⟩
            by_cases hEven : Even s.val
            · dsimp
              simp only [if_pos hEven, Equiv.symm_apply_apply]
            · dsimp
              simp only [if_neg hEven, Equiv.symm_apply_apply, Fin.rev_rev]
          right_inv := by
            intro p
            rcases p with ⟨f, s⟩
            by_cases hEven : Even s.val
            · dsimp
              simp only [if_pos hEven, Equiv.apply_symm_apply]
            · dsimp
              simp only [if_neg hEven, Fin.rev_rev, Equiv.apply_symm_apply] }
      -- compose the pair → vector bijection
      let pairVec : Fin M × Fin N ≃ (Fin (n + 1) → Fin M) := snakeEquiv.trans vecEquiv
      -- index Fin (M * N) ↦ slice pair via div/mod
      let orderMN : Fin (M * N) ≃ (Fin (n + 1) → Fin M) := finProdFinEquiv.symm.trans pairVec
      have hpow : M ^ (n + 1) = M * N := by
        dsimp [N]
        rw [pow_succ]
        exact Nat.mul_comm (M ^ n) M
      -- reindex Fin (M ^ (n+1)) onto Fin (M * N) by the value-preserving Fin.cast
      let idxCast : Fin (M ^ (n + 1)) ≃ Fin (M * N) :=
        { toFun := Fin.cast hpow
          invFun := Fin.cast hpow.symm
          left_inv := by
            intro x
            apply Fin.ext
            simp only [Fin.cast]
          right_inv := by
            intro x
            apply Fin.ext
            simp only [Fin.cast] }
      let order : Fin (M ^ (n + 1)) ≃ (Fin (n + 1) → Fin M) := idxCast.trans orderMN
      refine ⟨order, ?start, ?adj⟩
      · -- order 0 = zero offset
        have h0MN : 0 < M * N := Nat.mul_pos hM hNpos
        have hcast0 : idxCast ⟨0, pow_pos hM (n + 1)⟩ = (⟨0, h0MN⟩ : Fin (M * N)) := by
          apply Fin.ext
          change (⟨0, pow_pos hM (n + 1)⟩ : Fin (M ^ (n + 1))).val = 0
          rfl
        have hpair0 : (⟨0, h0MN⟩ : Fin (M * N)) =
            finProdFinEquiv ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)) := by
          apply Fin.ext
          change 0 = (⟨0, hNpos⟩ : Fin N).val + N * (⟨0, hM⟩ : Fin M).val
          simp
        have hord0 : orderMN (⟨0, h0MN⟩ : Fin (M * N)) =
            pairVec ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)) := by
          rw [hpair0]
          exact congrArg pairVec (finProdFinEquiv.left_inv ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)))
        have hzeroE : E (⟨0, hNpos⟩ : Fin N) = (fun _ => ⟨0, hM⟩) := by
          change E (⟨0, hNpos⟩ : Fin (M ^ n)) = (fun _ => ⟨0, hM⟩)
          rw [show (⟨0, hNpos⟩ : Fin (M ^ n)) = ⟨0, pow_pos hM n⟩ by
            apply Fin.ext
            rfl]
          exact hE0
        have hEven0 : Even (0 : Nat) := ⟨0, rfl⟩
        have hsnake0 : snakeEquiv ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)) =
            (E (⟨0, hNpos⟩ : Fin N), (⟨0, hM⟩ : Fin M)) := by
          change ((if Even ((⟨0, hM⟩ : Fin M).val) then E (⟨0, hNpos⟩ : Fin N)
              else E (Fin.rev (⟨0, hNpos⟩ : Fin N))), (⟨0, hM⟩ : Fin M)) =
            (E (⟨0, hNpos⟩ : Fin N), (⟨0, hM⟩ : Fin M))
          have hv0 : ((⟨0, hM⟩ : Fin M).val) = 0 := rfl
          rw [hv0]
          rw [if_pos hEven0]
        have hvec0 : pairVec ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)) = (fun _ => ⟨0, hM⟩) := by
          funext u
          change vecEquiv (snakeEquiv ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N))) u = ⟨0, hM⟩
          rw [hsnake0]
          dsimp [vecEquiv]
          refine Fin.lastCases ?_ ?_ u
          · simp [Fin.lastCases_last]
          · intro i
            simp [Fin.lastCases_castSucc, hzeroE]
        calc
          order ⟨0, pow_pos hM (n + 1)⟩
              = orderMN (idxCast ⟨0, pow_pos hM (n + 1)⟩) := by rfl
          _ = orderMN (⟨0, h0MN⟩ : Fin (M * N)) := by rw [hcast0]
          _ = pairVec ((⟨0, hM⟩ : Fin M), (⟨0, hNpos⟩ : Fin N)) := hord0
          _ = (fun _ => ⟨0, hM⟩) := hvec0
      · intro k hk
        have hbMN : k + 1 < M * N := by
          rw [← hpow]
          exact hk
        have haMN : k < M * N := lt_trans (Nat.lt_succ_self k) hbMN
        let xb : Fin (M ^ (n + 1)) := ⟨k + 1, hk⟩
        let xa : Fin (M ^ (n + 1)) := ⟨k, lt_trans (Nat.lt_succ_self k) hk⟩
        let yb : Fin (M * N) := ⟨k + 1, hbMN⟩
        let ya : Fin (M * N) := ⟨k, haMN⟩
        have hidxb : idxCast xb = yb := by
          apply Fin.ext
          rfl
        have hidxa : idxCast xa = ya := by
          apply Fin.ext
          rfl
        let sa : Fin M := ya.divNat
        let ta : Fin N := ya.modNat
        let sb : Fin M := yb.divNat
        let tb : Fin N := yb.modNat
        have hsa : sa.val = k / N := by
          dsimp [sa, ya]
        have hta : ta.val = k % N := by
          dsimp [ta, ya]
        have hsb : sb.val = (k + 1) / N := by
          dsimp [sb, yb]
        have htb : tb.val = (k + 1) % N := by
          dsimp [tb, yb]
        have hordMN_ya : orderMN ya = pairVec (sa, ta) := by rfl
        have hordMN_yb : orderMN yb = pairVec (sb, tb) := by rfl
        have horda_eq : order xa = pairVec (sa, ta) := by
          calc
            order xa = orderMN (idxCast xa) := by rfl
            _ = orderMN ya := by rw [hidxa]
            _ = pairVec (sa, ta) := hordMN_ya
        have hordb_eq : order xb = pairVec (sb, tb) := by
          calc
            order xb = orderMN (idxCast xb) := by rfl
            _ = orderMN yb := by rw [hidxb]
            _ = pairVec (sb, tb) := hordMN_yb
        have hvec_cast (p : Fin M × Fin N) (i : Fin n) :
            pairVec p i.castSucc =
              (if Even p.1.val then E p.2 else E (Fin.rev p.2)) i := by
          change vecEquiv (snakeEquiv p) i.castSucc =
              (if Even p.1.val then E p.2 else E (Fin.rev p.2)) i
          dsimp [vecEquiv]
          rw [Fin.lastCases_castSucc]
          rfl
        have hvec_last (p : Fin M × Fin N) : pairVec p (Fin.last n) = p.1 := by
          change vecEquiv (snakeEquiv p) (Fin.last n) = p.1
          dsimp [vecEquiv]
          rw [Fin.lastCases_last]
          rfl
        have hvec_even (p : Fin M × Fin N) (hEven : Even p.1.val) (i : Fin n) :
            pairVec p i.castSucc = E p.2 i := by
          rw [hvec_cast p i]
          rw [if_pos hEven]
        have hvec_odd (p : Fin M × Fin N) (hOdd : ¬ Even p.1.val) (i : Fin n) :
            pairVec p i.castSucc = E (Fin.rev p.2) i := by
          rw [hvec_cast p i]
          rw [if_neg hOdd]

        by_cases hIn : ta.val + 1 < N
        · -- consecutive offsets inside one slice
          have hInN : k % N + 1 < N := by
            have htmp := hIn
            rw [hta] at htmp
            exact htmp
          have hk_decomp : N * (k / N) + k % N = k := by
            rw [Nat.add_comm]
            exact Nat.mod_add_div k N
          have hk1a : k + 1 = (k % N + 1) + N * (k / N) := by
            calc
              k + 1 = (N * (k / N) + k % N) + 1 := by rw [hk_decomp]
              _ = (k % N + 1) + N * (k / N) := by ac_rfl
          have hmod_in : (k + 1) % N = k % N + 1 := by
            rw [hk1a]
            rw [Nat.add_mul_mod_self_left]
            exact Nat.mod_eq_of_lt hInN
          have hdiv_in : (k + 1) / N = k / N := by
            rw [hk1a]
            rw [Nat.add_mul_div_left (k % N + 1) (k / N) hNpos]
            rw [Nat.div_eq_of_lt hInN]
            simp
          have htb_succ : tb = ⟨ta.val + 1, hIn⟩ := by
            apply Fin.ext
            change (k + 1) % N = ta.val + 1
            rw [hta]
            exact hmod_in
          have hsb_sa : sb = sa := by
            apply Fin.ext
            change (k + 1) / N = k / N
            exact hdiv_in
          let tb1 : Fin N := ⟨ta.val + 1, hIn⟩
          have hpairb : (sb, tb) = (sa, tb1) := by
            rw [hsb_sa, htb_succ]
          have hordb2 : order xb = pairVec (sa, tb1) := by
            rw [hordb_eq, hpairb]
          by_cases hEvenSa : Even sa.val
          · -- even slice: run the lower-dimensional order forward
            have hta_mk : (⟨ta.val, lt_trans (Nat.lt_succ_self ta.val) hIn⟩ : Fin N) = ta := by
              apply Fin.ext
              rfl
            obtain ⟨q0, hq0nat, hq0eq⟩ := hEadj ta.val hIn
            refine ⟨q0.castSucc, ?_, ?_⟩
            · rw [hordb2, horda_eq]
              rw [hvec_even (sa, tb1) hEvenSa q0, hvec_even (sa, ta) hEvenSa q0]
              rw [← hta_mk]
              exact hq0nat
            · intro u hu
              by_cases hvu : (u : Nat) < n
              · let i : Fin n := ⟨(u : Nat), hvu⟩
                have hu_cast : u = i.castSucc := by
                  apply Fin.ext
                  rfl
                have hi_ne : i ≠ q0 := by
                  intro hi
                  rw [hu_cast] at hu
                  rw [hi] at hu
                  simp at hu
                rw [hu_cast]
                rw [hordb2, horda_eq]
                rw [hvec_even (sa, tb1) hEvenSa i, hvec_even (sa, ta) hEvenSa i]
                change E tb1 i = E ta i
                have hbase_e : E ⟨ta.val + 1, hIn⟩ i =
                    E ⟨ta.val, lt_trans (Nat.lt_succ_self ta.val) hIn⟩ i := by
                  exact hq0eq i (by simpa using hi_ne)
                calc
                  E tb1 i = E ⟨ta.val + 1, hIn⟩ i := by simp [tb1]
                  _ = E ⟨ta.val, lt_trans (Nat.lt_succ_self ta.val) hIn⟩ i := hbase_e
                  _ = E ta i := congrArg (fun x : Fin N => E x i) hta_mk
              · have hul : u = Fin.last n := by
                  apply Fin.ext
                  change (u : Nat) = n
                  omega
                rw [hul]
                rw [hordb2, horda_eq]
                rw [hvec_last (sa, tb1), hvec_last (sa, ta)]
          · -- odd slice: reflected offsets move backwards
            let r1 : Fin N := Fin.rev tb1
            let r0 : Fin N := Fin.rev ta
            have hRev : r1.val + 1 = r0.val := by
              dsimp [r1, r0, tb1]
              change (N - (ta.val + 1 + 1)) + 1 = N - (ta.val + 1)
              omega
            have hr1lt : r1.val + 1 < N := by
              rw [hRev]
              exact r0.isLt
            have hr0_mk : (⟨r1.val + 1, hr1lt⟩ : Fin N) = r0 := by
              apply Fin.ext
              exact hRev
            have hr1_mk : (⟨r1.val, lt_trans (Nat.lt_succ_self r1.val) hr1lt⟩ : Fin N) = r1 := by
              apply Fin.ext
              rfl
            obtain ⟨q0, hq0nat, hq0eq⟩ := hEadj r1.val hr1lt
            refine ⟨q0.castSucc, ?_, ?_⟩
            · rw [hordb2, horda_eq]
              rw [hvec_odd (sa, tb1) hEvenSa q0, hvec_odd (sa, ta) hEvenSa q0]
              change Int.natAbs
                  (((E r1 q0).val : Int) - ((E r0 q0).val : Int)) = 1
              rw [← hr1_mk, ← hr0_mk]
              have hdiff :
                  ((E ⟨r1.val, lt_trans (Nat.lt_succ_self r1.val) hr1lt⟩ q0).val : Int) -
                    ((E ⟨r1.val + 1, hr1lt⟩ q0).val : Int) =
                  -(((E ⟨r1.val + 1, hr1lt⟩ q0).val : Int) -
                    ((E ⟨r1.val, lt_trans (Nat.lt_succ_self r1.val) hr1lt⟩ q0).val : Int)) := by
                ring
              rw [hdiff]
              rw [Int.natAbs_neg]
              exact hq0nat
            · intro u hu
              by_cases hvu : (u : Nat) < n
              · let i : Fin n := ⟨(u : Nat), hvu⟩
                have hu_cast : u = i.castSucc := by
                  apply Fin.ext
                  rfl
                have hi_ne : i ≠ q0 := by
                  intro hi
                  rw [hu_cast] at hu
                  rw [hi] at hu
                  simp at hu
                rw [hu_cast]
                rw [hordb2, horda_eq]
                rw [hvec_odd (sa, tb1) hEvenSa i, hvec_odd (sa, ta) hEvenSa i]
                change E r1 i = E r0 i
                have hbase_o : E ⟨r1.val + 1, hr1lt⟩ i =
                    E ⟨r1.val, lt_trans (Nat.lt_succ_self r1.val) hr1lt⟩ i := by
                  exact hq0eq i (by simpa using hi_ne)
                calc
                  E r1 i = E ⟨r1.val, lt_trans (Nat.lt_succ_self r1.val) hr1lt⟩ i :=
                    congrArg (fun x : Fin N => E x i) hr1_mk.symm
                  _ = E ⟨r1.val + 1, hr1lt⟩ i := hbase_o.symm
                  _ = E r0 i := congrArg (fun x : Fin N => E x i) hr0_mk
              · have hul : u = Fin.last n := by
                  apply Fin.ext
                  change (u : Nat) = n
                  omega
                rw [hul]
                rw [hordb2, horda_eq]
                rw [hvec_last (sa, tb1), hvec_last (sa, ta)]
        · -- at slice boundary: the slice coordinate increments
          have hta_eq : ta.val + 1 = N := by
            have hle : ta.val + 1 ≤ N := Nat.succ_le_of_lt ta.isLt
            omega
          have hBoundN : k % N + 1 = N := by
            have htmp := hta_eq
            rw [hta] at htmp
            exact htmp
          have hk_decomp : N * (k / N) + k % N = k := by
            rw [Nat.add_comm]
            exact Nat.mod_add_div k N
          have hk1b : k + 1 = N * (k / N + 1) := by
            calc
              k + 1 = (N * (k / N) + k % N) + 1 := by rw [hk_decomp]
              _ = N * (k / N) + (k % N + 1) := by ac_rfl
              _ = N * (k / N) + N := by rw [hBoundN]
              _ = N * (k / N + 1) := by exact (Nat.mul_succ N (k / N)).symm
          have hmod_bound : (k + 1) % N = 0 := by
            rw [hk1b]
            simpa using (Nat.add_mul_mod_self_left 0 N (k / N + 1))
          have hdiv_bound : (k + 1) / N = k / N + 1 := by
            rw [hk1b]
            exact Nat.mul_div_right (k / N + 1) hNpos
          have htb_zero : tb = ⟨0, hNpos⟩ := by
            apply Fin.ext
            change (k + 1) % N = 0
            exact hmod_bound
          have hsb_succ : sb.val = sa.val + 1 := by
            dsimp [sb, sa]
            exact hdiv_bound
          have hssucc_lt : sa.val + 1 < M := by
            rw [← hsb_succ]
            exact sb.isLt
          let sb1 : Fin M := ⟨sa.val + 1, hssucc_lt⟩
          have hsb_mk : sb = sb1 := by
            apply Fin.ext
            change (k + 1) / N = sa.val + 1
            exact hsb_succ
          have hsb1val : sb1.val = sa.val + 1 := rfl
          have hpairb : (sb, tb) = (sb1, ⟨0, hNpos⟩) := by
            rw [hsb_mk, htb_zero]
          have hordb3 : order xb = pairVec (sb1, ⟨0, hNpos⟩) := by
            rw [hordb_eq, hpairb]
          by_cases hEvenSa : Even sa.val
          · -- old slice even: old endpoint E ta equals the reflected zero
            have hNotEvenSb : ¬ Even sb1.val := by
              rw [hsb1val, Nat.even_add_one]
              intro h
              exact h hEvenSa
            have hta_last : ta.val = N - 1 := by
              omega
            have hrev0 : (Fin.rev (⟨0, hNpos⟩ : Fin N)).val = N - 1 := by
              simp [Fin.rev]
            have hrev0_eq : Fin.rev (⟨0, hNpos⟩ : Fin N) = ta := by
              apply Fin.ext
              rw [hrev0, hta_last]
            refine ⟨Fin.last n, ?_, ?_⟩
            · rw [hordb3, horda_eq]
              rw [hvec_last (sb1, ⟨0, hNpos⟩), hvec_last (sa, ta)]
              change Int.natAbs (((sb1.val : Int) - (sa.val : Int))) = 1
              have hdiff1 : ((sb1.val : Int) - (sa.val : Int)) = 1 := by
                rw [hsb1val]
                simp
              rw [hdiff1]
              norm_num
            · intro u hu
              by_cases hvu : (u : Nat) < n
              · let i : Fin n := ⟨(u : Nat), hvu⟩
                have hu_cast : u = i.castSucc := by
                  apply Fin.ext
                  rfl
                rw [hu_cast]
                rw [hordb3, horda_eq]
                rw [hvec_odd (sb1, ⟨0, hNpos⟩) hNotEvenSb i,
                    hvec_even (sa, ta) hEvenSa i]
                rw [hrev0_eq]
              · exfalso
                have hul : u = Fin.last n := by
                  apply Fin.ext
                  change (u : Nat) = n
                  omega
                rw [hul] at hu
                simp at hu
          · -- old slice odd: old endpoint E (rev ta) equals the zero element
            have hEvenSb : Even sb1.val := by
              rw [hsb1val, Nat.even_add_one]
              exact hEvenSa
            have hrevta_zero : Fin.rev ta = ⟨0, hNpos⟩ := by
              apply Fin.ext
              simp [Fin.rev, hta, hBoundN]
            refine ⟨Fin.last n, ?_, ?_⟩
            · rw [hordb3, horda_eq]
              rw [hvec_last (sb1, ⟨0, hNpos⟩), hvec_last (sa, ta)]
              change Int.natAbs (((sb1.val : Int) - (sa.val : Int))) = 1
              have hdiff1 : ((sb1.val : Int) - (sa.val : Int)) = 1 := by
                rw [hsb1val]
                simp
              rw [hdiff1]
              norm_num
            · intro u hu
              by_cases hvu : (u : Nat) < n
              · let i : Fin n := ⟨(u : Nat), hvu⟩
                have hu_cast : u = i.castSucc := by
                  apply Fin.ext
                  rfl
                rw [hu_cast]
                rw [hordb3, horda_eq]
                rw [hvec_even (sb1, ⟨0, hNpos⟩) hEvenSb i,
                    hvec_odd (sa, ta) hEvenSa i]
                rw [hrevta_zero]
              · exfalso
                have hul : u = Fin.last n := by
                  apply Fin.ext
                  change (u : Nat) = n
                  omega
                rw [hul] at hu
                simp at hu


/-- The boundary-inclusive `M^2` knot grid can be factored into `M^d` coarse
blocks and `M^d` serpentine offsets while retaining partition of unity and
signed one-coordinate adjacency. -/
theorem exists_unitCube_twoScale_serpentine_tent_layout
    {d M : Nat} (hd : 0 < d) (hM : 2 <= M) :
    exists center scale : Fin (M ^ d) -> Fin (M ^ d) -> Fin d -> Real,
      IsTwoScaleSerpentineLayout d M center scale := by
  have hMpos : 0 < M := by omega
  obtain ⟨order_c, horder_c⟩ := exists_reluApprox_serpentine_fineGrid_equiv M d hMpos
  obtain ⟨order_f, horder_f⟩ := exists_reluApprox_serpentine_fineGrid_equiv M d hMpos
  let node : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℕ :=
    fun b t q => (order_c b q).val * M + (order_f t q).val
  let ctr : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℝ :=
    fun b t q => (node b t q : ℝ) / ((M ^ 2 - 1 : ℕ) : ℝ)
  let scl : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℝ :=
    fun b t q => ((M ^ 2 - 1 : ℕ) : ℝ)
  refine ⟨ctr, scl, ?_⟩
  simp only [IsTwoScaleSerpentineLayout]
  constructor
  · -- clause 1: scale is the constant (M^2 - 1)
    intro b t q
    rfl
  · constructor
    · -- clause 2: every center lies in [0,1]
      intro b t q
      have hM1 : (1 : ℕ) ≤ M := by omega
      have hM_le_M2 : M ≤ M ^ 2 := by
        have h := Nat.mul_le_mul_left M hM1
        simpa [pow_two] using h
      have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
      have h1lt : (1 : ℕ) < M ^ 2 := by omega
      have h1le : (1 : ℕ) ≤ M ^ 2 := by omega
      have hBpos : (0 : ℝ) < ((M ^ 2 - 1 : ℕ) : ℝ) := by
        exact_mod_cast (Nat.sub_pos_of_lt h1lt)
      have hc1 : (order_c b q).val ≤ M - 1 := Nat.le_sub_one_of_lt (order_c b q).isLt
      have hf1 : (order_f t q).val ≤ M - 1 := Nat.le_sub_one_of_lt (order_f t q).isLt
      have hcR : ((order_c b q).val : ℝ) ≤ (M : ℝ) - 1 := by
        have hcast : ((order_c b q).val : ℝ) ≤ ((M - 1 : ℕ) : ℝ) := by exact_mod_cast hc1
        rw [Nat.cast_sub hM1] at hcast
        simpa using hcast
      have hfR : ((order_f t q).val : ℝ) ≤ (M : ℝ) - 1 := by
        have hcast : ((order_f t q).val : ℝ) ≤ ((M - 1 : ℕ) : ℝ) := by exact_mod_cast hf1
        rw [Nat.cast_sub hM1] at hcast
        simpa using hcast
      have hB_eq : ((M ^ 2 - 1 : ℕ) : ℝ) = (M : ℝ) ^ 2 - 1 := by
        rw [Nat.cast_sub h1le, Nat.cast_pow, Nat.cast_one]
      have hnum : (node b t q : ℝ) =
          ((order_c b q).val : ℝ) * (M : ℝ) + ((order_f t q).val : ℝ) := by
        dsimp [node]
        simp
      have hbnd : ((order_c b q).val : ℝ) * (M : ℝ) + ((order_f t q).val : ℝ) ≤
          (M : ℝ) ^ 2 - 1 := by
        have hMnonneg : (0 : ℝ) ≤ (M : ℝ) := by exact_mod_cast (Nat.zero_le M)
        nlinarith [hcR, hfR, hMnonneg]
      dsimp [ctr]
      apply Set.mem_Icc.mpr
      constructor
      · apply div_nonneg
        · exact_mod_cast (Nat.zero_le (node b t q))
        · exact le_of_lt hBpos
      · rw [div_le_one hBpos]
        rw [hnum]
        rw [hB_eq]
        exact hbnd
    · -- clauses 4-5 (support, adjacency) are closed below; clause 3 (partition of unity) is deferred
      constructor
      swap
      constructor
      · -- clause 4: active support
        intro b t x hxIcc hsupp q
        let B : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
        have h1lt : (1 : ℕ) < M ^ 2 := by
          have hM1 : (1 : ℕ) ≤ M := by omega
          have hM_le_M2 : M ≤ M ^ 2 := by
            have h := Nat.mul_le_mul_left M hM1
            simpa [pow_two] using h
          have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
          omega
        have hBpos : (0 : ℝ) < B := by
          dsimp [B]
          exact_mod_cast (Nat.sub_pos_of_lt h1lt)
        have hs0 : B * (relu (x q - ctr b t q) + relu (ctr b t q - x q)) < 1 := by
          simpa [B, scl] using hsupp q
        have hrelu_sum : ∀ y : ℝ, relu y + relu (-y) = |y| := by
          intro y
          unfold relu
          by_cases h : 0 ≤ y
          · have hneg : -y ≤ 0 := neg_nonpos.mpr h
            rw [max_eq_left h, max_eq_right hneg, abs_of_nonneg h]
            simp
          · have hnonpos : y ≤ 0 := le_of_not_ge h
            have hposneg : 0 ≤ -y := neg_nonneg.mpr hnonpos
            rw [max_eq_right hnonpos, max_eq_left hposneg, abs_of_nonpos hnonpos]
            simp
        have hru : relu (x q - ctr b t q) + relu (ctr b t q - x q) = |x q - ctr b t q| := by
          have hneg : ctr b t q - x q = -(x q - ctr b t q) := by ring
          rw [hneg]
          exact hrelu_sum (x q - ctr b t q)
        have hs1 : B * |x q - ctr b t q| < 1 := by
          simpa [hru] using hs0
        have hlt : |x q - ctr b t q| < B⁻¹ := by
          have hBne : B ≠ 0 := ne_of_gt hBpos
          have hBB : B * B⁻¹ = 1 := mul_inv_cancel₀ hBne
          have hs2 : B * |x q - ctr b t q| < B * B⁻¹ := by
            simpa [hBB] using hs1
          exact lt_of_mul_lt_mul_left hs2 (le_of_lt hBpos)
        simpa [B] using le_of_lt hlt
      · -- clause 5: adjacency along the fine serpentine
        intro b k hk
        have hk0 : k < M ^ d := Nat.lt_of_succ_lt hk
        rcases horder_f.2 k hk with ⟨q, hstep, hfix⟩
        refine ⟨q, ?_, ?_⟩
        · -- selected coordinate changes by ±1/D
          let D : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
          have hsign :
              ((order_f ⟨k + 1, hk⟩ q).val : ℤ) - ((order_f ⟨k, hk0⟩ q).val : ℤ) = 1 ∨
              ((order_f ⟨k + 1, hk⟩ q).val : ℤ) - ((order_f ⟨k, hk0⟩ q).val : ℤ) = -1 := by
            have hz1 : (((order_f ⟨k + 1, hk⟩ q).val : ℤ) -
                ((order_f ⟨k, hk0⟩ q).val : ℤ)).natAbs = 1 := by
              simpa using hstep
            have hz2 : (((order_f ⟨k + 1, hk⟩ q).val : ℤ) -
                ((order_f ⟨k, hk0⟩ q).val : ℤ)).natAbs = (1 : ℤ).natAbs := by
              simpa using hz1
            exact Int.natAbs_eq_natAbs_iff.mp hz2
          rcases hsign with hplus | hminus
          · left
            have hnat : (order_f ⟨k + 1, hk⟩ q).val = (order_f ⟨k, hk0⟩ q).val + 1 := by
              omega
            have hnode1 : node b ⟨k + 1, hk⟩ q = node b ⟨k, hk0⟩ q + 1 := by
              dsimp [node]
              rw [hnat]
              ring_nf
            have hnode1R : (node b ⟨k + 1, hk⟩ q : ℝ) = (node b ⟨k, hk0⟩ q : ℝ) + 1 := by
              norm_num [hnode1]
            calc
              ctr b ⟨k + 1, hk⟩ q = (node b ⟨k + 1, hk⟩ q : ℝ) / D := by
                dsimp [ctr, D]
              _ = ((node b ⟨k, hk0⟩ q : ℝ) + 1) / D := by
                rw [hnode1R]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D + 1 / D := by
                rw [add_div]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D + D⁻¹ := by
                rw [one_div]
              _ = ctr b ⟨k, hk0⟩ q + D⁻¹ := by
                dsimp [ctr, D]
          · right
            have hnat2 : (order_f ⟨k, hk0⟩ q).val = (order_f ⟨k + 1, hk⟩ q).val + 1 := by
              omega
            have hnode2 : node b ⟨k, hk0⟩ q = node b ⟨k + 1, hk⟩ q + 1 := by
              dsimp [node]
              rw [hnat2]
              ring_nf
            have hnode2R : (node b ⟨k, hk0⟩ q : ℝ) = (node b ⟨k + 1, hk⟩ q : ℝ) + 1 := by
              norm_num [hnode2]
            have hnode1sub : (node b ⟨k + 1, hk⟩ q : ℝ) = (node b ⟨k, hk0⟩ q : ℝ) - 1 := by
              linarith
            calc
              ctr b ⟨k + 1, hk⟩ q = (node b ⟨k + 1, hk⟩ q : ℝ) / D := by
                dsimp [ctr, D]
              _ = ((node b ⟨k, hk0⟩ q : ℝ) - 1) / D := by
                rw [hnode1sub]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D - 1 / D := by
                rw [sub_div]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D - D⁻¹ := by
                rw [one_div]
              _ = ctr b ⟨k, hk0⟩ q - D⁻¹ := by
                dsimp [ctr, D]
        · -- other coordinates are fixed
          let D : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
          intro u hu
          have hf : order_f ⟨k + 1, hk⟩ u = order_f ⟨k, hk0⟩ u := hfix u hu
          have hfval : (order_f ⟨k + 1, hk⟩ u).val = (order_f ⟨k, hk0⟩ u).val := by
            exact congrArg Fin.val hf
          have hnodeE : node b ⟨k + 1, hk⟩ u = node b ⟨k, hk0⟩ u := by
            dsimp [node]
            rw [hfval]
          have hnR : (node b ⟨k + 1, hk⟩ u : ℝ) = (node b ⟨k, hk0⟩ u : ℝ) := by
            exact congrArg (fun n : ℕ => (n : ℝ)) hnodeE
          calc
            ctr b ⟨k + 1, hk⟩ u = (node b ⟨k + 1, hk⟩ u : ℝ) / D := by
              dsimp [ctr, D]
            _ = (node b ⟨k, hk0⟩ u : ℝ) / D := by
              rw [hnR]
            _ = ctr b ⟨k, hk0⟩ u := by
              dsimp [ctr, D]
      · -- clause 3: partition of unity
        intro x hx
        let Bnat : ℕ := M ^ 2 - 1
        let B : ℝ := (Bnat : ℝ)
        have hM1 : (1 : ℕ) ≤ M := by omega
        have hM_le_M2 : M ≤ M ^ 2 := by
          have h := Nat.mul_le_mul_left M hM1
          simpa [pow_two] using h
        have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
        have h1lt : (1 : ℕ) < M ^ 2 := by omega
        have hBnat_pos : 0 < Bnat := Nat.sub_pos_of_lt h1lt
        have hBpos : (0 : ℝ) < B := by
          dsimp [B, Bnat]
          exact_mod_cast (Nat.sub_pos_of_lt h1lt)
        have hBne : B ≠ 0 := ne_of_gt hBpos
        have hBnn : (0 : ℝ) ≤ B := le_of_lt hBpos
        let tent1 : Fin d → ℕ → ℝ := fun q i =>
          relu (1 - B * (relu (x q - (i : ℝ) / B) + relu ((i : ℝ) / B - x q)))
        let hq : Fin d → ℕ → ℝ := fun q i => relu (1 - |B * x q - (i : ℝ)|)
        have hrelu_sum : ∀ y : ℝ, relu y + relu (-y) = |y| := by
          intro y
          unfold relu
          by_cases h : 0 ≤ y
          · have hneg : -y ≤ 0 := neg_nonpos.mpr h
            rw [max_eq_left h, max_eq_right hneg, abs_of_nonneg h]
            simp
          · have hnonpos : y ≤ 0 := le_of_not_ge h
            have hposneg : 0 ≤ -y := neg_nonneg.mpr hnonpos
            rw [max_eq_right hnonpos, max_eq_left hposneg, abs_of_nonpos hnonpos]
            simp
        have hxB : ∀ q : Fin d, B * x q ∈ Set.Icc (0 : ℝ) B := by
          intro q
          have hxq : (0 : ℝ) ≤ x q ∧ x q ≤ 1 := by
            exact Set.mem_Icc.mp (hx q)
          constructor
          · exact mul_nonneg hBnn hxq.1
          · calc
              B * x q ≤ B * 1 := mul_le_mul_of_nonneg_left hxq.2 hBnn
              _ = B := by simp
        have hscl : ∀ b t q, scl b t q = B := by
          intro b t q
          rfl
        have hctr_def : ∀ b t q, ctr b t q = (node b t q : ℝ) / B := by
          intro b t q
          rfl
        have hcoord : ∀ b t q,
            coordinateTentReLUFunction q (ctr b t q) (scl b t q) x =
              relu (1 - |B * x q - (node b t q : ℝ)|) := by
          intro b t q
          unfold coordinateTentReLUFunction
          apply congrArg relu
          congr 1
          rw [hscl b t q, hctr_def b t q]
          have hinner : relu (x q - (node b t q : ℝ) / B) +
                relu ((node b t q : ℝ) / B - x q) =
              |x q - (node b t q : ℝ) / B| := by
            have hneg : (node b t q : ℝ) / B - x q = -(x q - (node b t q : ℝ) / B) := by ring
            rw [hneg]
            exact hrelu_sum (x q - (node b t q : ℝ) / B)
          rw [hinner]
          have hdist : B * (x q - (node b t q : ℝ) / B) = B * x q - (node b t q : ℝ) := by
            field_simp [hBne]
          calc
            B * |x q - (node b t q : ℝ) / B| = |B| * |x q - (node b t q : ℝ) / B| := by
              rw [abs_of_nonneg hBnn]
            _ = |B * (x q - (node b t q : ℝ) / B)| := by
              rw [← abs_mul]
            _ = |B * x q - (node b t q : ℝ)| := by
              rw [hdist]
        have hax' : ∀ b t, axisAlignedBoxTentWeight (ctr b t) (scl b t) x =
            ∏ q : Fin d, hq q (node b t q) := by
          intro b t
          unfold axisAlignedBoxTentWeight
          apply Finset.prod_congr rfl
          intro q hqmem
          unfold hq
          exact hcoord b t q
        let W : (Fin d → Fin M) → (Fin d → Fin M) → ℝ :=
          fun a f => ∏ q : Fin d, hq q ((a q).val * M + (f q).val)
        have hnode_c : ∀ (a : Fin d → Fin M) t q,
            node (order_c.symm a) t q = (a q).val * M + (order_f t q).val := by
          intro a t q
          dsimp [node]
          have hca : order_c (order_c.symm a) = a := Equiv.apply_symm_apply order_c a
          have hcq : (order_c (order_c.symm a) q).val = (a q).val :=
            congrArg Fin.val (congrFun hca q)
          rw [hcq]
        have hreindex_b :
            (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q))
              = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
          calc
            (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q))
                = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                    ∏ q : Fin d, hq q (node (order_c.symm a) t q)) := by
                  exact (Equiv.sum_comp order_c.symm
                    (fun b : Fin (M ^ d) => ∑ t : Fin (M ^ d),
                      ∏ q : Fin d, hq q (node b t q))).symm
            _ = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
                  apply Finset.sum_congr rfl
                  intro a ha
                  apply Finset.sum_congr rfl
                  intro t ht
                  apply Finset.prod_congr rfl
                  intro q hq1
                  rw [hnode_c a t q]
        have hreindex_t :
            (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val))
              = (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f) := by
          apply Finset.sum_congr rfl
          intro a ha
          calc
            (∑ t : Fin (M ^ d), ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val))
                = (∑ f : Fin d → Fin M,
                    ∏ q : Fin d, hq q ((a q).val * M + (order_f (order_f.symm f) q).val)) := by
                  exact (Equiv.sum_comp order_f.symm
                    (fun t : Fin (M ^ d) => ∏ q : Fin d,
                      hq q ((a q).val * M + (order_f t q).val))).symm
            _ = (∑ f : Fin d → Fin M, W a f) := by
                  apply Finset.sum_congr rfl
                  intro f hf
                  dsimp [W]
                  apply Finset.prod_congr rfl
                  intro q hq1
                  have hfa : order_f (order_f.symm f) = f := Equiv.apply_symm_apply order_f f
                  have hfq : (order_f (order_f.symm f) q).val = (f q).val :=
                    congrArg Fin.val (congrFun hfa q)
                  rw [hfq]
        calc
          (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d),
              axisAlignedBoxTentWeight (ctr b t) (scl b t) x)
              = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q)) := by
                apply Finset.sum_congr rfl
                intro b hb
                apply Finset.sum_congr rfl
                intro t ht
                exact hax' b t
          _ = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
                exact hreindex_b
          _ = (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f) := by
                exact hreindex_t
          _ = 1 := by
                have hhat_id : ∀ (w : ℝ) (m : ℕ),
                    relu (1 - |w - (m : ℝ)|) =
                      relu (w - (m : ℝ) + 1) - 2 * relu (w - (m : ℝ)) +
                        relu (w - (m : ℝ) - 1) := by
                  intro w m
                  let r : ℝ := (m : ℝ)
                  by_cases h1 : w ≤ r - 1
                  · have hwm : w - r ≤ 0 := by linarith
                    have hwm1 : w - r + 1 ≤ 0 := by linarith
                    have hwm2 : w - r - 1 ≤ 0 := by linarith
                    have harg : 1 - (-(w - r)) ≤ 0 := by linarith
                    unfold relu
                    rw [abs_of_nonpos hwm]
                    rw [max_eq_right harg]
                    rw [max_eq_right hwm1, max_eq_right hwm, max_eq_right hwm2]
                    ring
                  · have hr1 : r - 1 < w := lt_of_not_ge h1
                    by_cases h2 : w ≤ r
                    · have hwm : w - r ≤ 0 := by linarith
                      have hpos1 : 0 ≤ w - r + 1 := by linarith
                      have hwm2 : w - r - 1 ≤ 0 := by linarith
                      have harg : 0 ≤ 1 - (-(w - r)) := by linarith
                      unfold relu
                      rw [abs_of_nonpos hwm]
                      rw [max_eq_left harg]
                      rw [max_eq_left hpos1, max_eq_right hwm, max_eq_right hwm2]
                      ring
                    · have hr : r < w := lt_of_not_ge h2
                      by_cases h3 : w ≤ r + 1
                      · have hwp : 0 ≤ w - r := by linarith
                        have hpos1 : 0 ≤ w - r + 1 := by linarith
                        have hwm2 : w - r - 1 ≤ 0 := by linarith
                        have harg : 0 ≤ 1 - (w - r) := by linarith
                        unfold relu
                        rw [abs_of_nonneg hwp]
                        rw [max_eq_left harg]
                        rw [max_eq_left hpos1, max_eq_left hwp, max_eq_right hwm2]
                        ring
                      · have hwp : 0 ≤ w - r := by linarith
                        have hpos1 : 0 ≤ w - r + 1 := by linarith
                        have hpos2 : 0 ≤ w - r - 1 := by linarith
                        have harg : 1 - (w - r) ≤ 0 := by linarith
                        unfold relu
                        rw [abs_of_nonneg hwp]
                        rw [max_eq_right harg]
                        rw [max_eq_left hpos1, max_eq_left hwp, max_eq_left hpos2]
                        ring
                have hfin_range : ∀ {n : ℕ} (f : ℕ → ℝ),
                    (∑ m : Fin n, f (m.val)) = ∑ m ∈ Finset.range n, f m := by
                  intro n f
                  exact Finset.sum_bij (s := (Finset.univ : Finset (Fin n))) (t := Finset.range n)
                    (f := fun m : Fin n => f (m.val)) (g := f)
                    (fun m hm => (m : ℕ))
                    (by intro m hm; exact Finset.mem_range.mpr m.isLt)
                    (by intro a ha b hb hab; apply Fin.ext; exact hab)
                    (by intro b hb; exact ⟨⟨b, Finset.mem_range.mp hb⟩, by simp, rfl⟩)
                    (by intro m hm; rfl)
                have h1d_hat : ∀ (K : ℕ) (w : ℝ), (0 : ℝ) ≤ w → w ≤ (K : ℝ) →
                    (∑ m ∈ Finset.range (K + 1), relu (1 - |w - (m : ℝ)|)) = 1 := by
                  intro K w hw0 hwK
                  let ψ : ℕ → ℝ := fun m => relu (w - (m : ℝ) + 1) - relu (w - (m : ℝ))
                  have hhat : ∀ m : ℕ, relu (1 - |w - (m : ℝ)|) = ψ m - ψ (m + 1) := by
                    intro m
                    rw [hhat_id w m]
                    dsimp [ψ]
                    simp only [Nat.cast_add, Nat.cast_one]
                    ring
                  have htelescope : ∀ n : ℕ,
                      (∑ m ∈ Finset.range (n + 1), (ψ m - ψ (m + 1))) = ψ 0 - ψ (n + 1) := by
                    intro n
                    induction n with
                    | zero =>
                        simp
                    | succ n ih =>
                        rw [Finset.sum_range_succ]
                        rw [ih]
                        ring
                  calc
                    (∑ m ∈ Finset.range (K + 1), relu (1 - |w - (m : ℝ)|))
                        = (∑ m ∈ Finset.range (K + 1), (ψ m - ψ (m + 1))) := by
                          apply Finset.sum_congr rfl
                          intro m hm
                          exact hhat m
                    _ = ψ 0 - ψ (K + 1) := by
                          exact htelescope K
                    _ = 1 := by
                          have hcastK : ((K + 1 : ℕ) : ℝ) = (K : ℝ) + 1 := by
                            rw [Nat.cast_add, Nat.cast_one]
                          have h1 : (0 : ℝ) ≤ w + 1 := by linarith
                          have h2 : (0 : ℝ) ≤ w := hw0
                          have h5 : w - ((K + 1 : ℕ) : ℝ) ≤ 0 := by
                            linarith [hwK, hcastK]
                          have h6 : w - ((K + 1 : ℕ) : ℝ) + 1 ≤ 0 := by
                            linarith [hwK, hcastK]
                          dsimp [ψ]
                          unfold relu
                          simp only [Nat.cast_zero, sub_zero, add_zero]
                          rw [max_eq_left h1, max_eq_left h2, max_eq_right h6, max_eq_right h5]
                          ring
                have hcoordsum : ∀ q : Fin d,
                    (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val)) = 1 := by
                  intro q
                  have hxq0 : (0 : ℝ) ≤ B * x q := (Set.mem_Icc.mp (hxB q)).1
                  have hxqB : B * x q ≤ (Bnat : ℝ) := by
                    have hb : B * x q ≤ B := (Set.mem_Icc.mp (hxB q)).2
                    simpa [B] using hb
                  have hBnat_succ : Bnat + 1 = M * M := by
                    have h1le : (1 : ℕ) ≤ M ^ 2 := Nat.le_of_lt h1lt
                    dsimp [Bnat]
                    rw [Nat.sub_add_cancel h1le]
                    rw [pow_two]
                  have hterm : ∀ m : ℕ, hq q m = relu (1 - |B * x q - (m : ℝ)|) := by
                    intro m
                    rfl
                  let e : Fin M × Fin M ≃ Fin (M * M) := finProdFinEquiv (m := M) (n := M)
                  have hval : ∀ p : Fin M × Fin M, (e p).val = p.1.val * M + p.2.val := by
                    intro p
                    cases p with
                    | mk i j =>
                        dsimp [e, finProdFinEquiv]
                        ring
                  have hfin : (∑ m : Fin (M * M), hq q (m.val)) =
                      ∑ m ∈ Finset.range (M * M), hq q m :=
                    hfin_range (fun m : ℕ => hq q m)
                  have hstep : (∑ p : Fin M × Fin M, hq q ((e p).val)) =
                      ∑ m : Fin (M * M), hq q (m.val) :=
                    Equiv.sum_comp e (fun m : Fin (M * M) => hq q (m.val))
                  have hpair : (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) = 1 := by
                    calc
                      (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))
                          = ∑ p : Fin M × Fin M, hq q ((e p).val) := by
                            apply Finset.sum_congr rfl
                            intro p hp
                            rw [hval p]
                      _ = ∑ m : Fin (M * M), hq q (m.val) := hstep
                      _ = ∑ m ∈ Finset.range (M * M), hq q m := hfin
                      _ = ∑ m ∈ Finset.range (Bnat + 1), relu (1 - |B * x q - (m : ℝ)|) := by
                            rw [← hBnat_succ]
                      _ = 1 := by
                            exact h1d_hat Bnat (B * x q) hxq0 hxqB
                  have hdq : (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val))
                      = (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) := by
                    exact (Fintype.sum_prod_type (fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))).symm
                  rw [hdq]
                  exact hpair
                have hcoordsum_pair : ∀ q : Fin d,
                    (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) = 1 := by
                  intro q
                  calc
                    (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))
                        = (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val)) := by
                          exact Fintype.sum_prod_type
                            (fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))
                    _ = 1 := hcoordsum q
                let toP : (Fin d → Fin M) × (Fin d → Fin M) → (Fin d → Fin M × Fin M) :=
                  fun p q => (p.1 q, p.2 q)
                let fromP : (Fin d → Fin M × Fin M) → (Fin d → Fin M) × (Fin d → Fin M) :=
                  fun g => (fun q => (g q).1, fun q => (g q).2)
                let eP : (Fin d → Fin M) × (Fin d → Fin M) ≃ (Fin d → Fin M × Fin M) :=
                  { toFun := toP
                    invFun := fromP
                    left_inv := by
                      rintro ⟨a, f⟩
                      apply Prod.ext <;> funext q <;> rfl
                    right_inv := by
                      intro g
                      funext q
                      rfl }
                have heP_symm : ∀ g : Fin d → Fin M × Fin M,
                    eP.symm g = (fun q : Fin d => (g q).1, fun q : Fin d => (g q).2) := by
                  intro g
                  rfl
                have hswap : (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))) =
                    (∑ g : Fin d → Fin M × Fin M, ∏ q : Fin d, hq q ((g q).1.val * M + (g q).2.val)) := by
                  rw [Finset.prod_univ_sum
                    (fun _ : Fin d => (Finset.univ : Finset (Fin M × Fin M)))
                    (fun q : Fin d => fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))]
                  simpa [Fintype.piFinset_univ]
                calc
                  (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f)
                      = (∑ p : (Fin d → Fin M) × (Fin d → Fin M), W p.1 p.2) := by
                        exact (Fintype.sum_prod_type
                          (fun p : (Fin d → Fin M) × (Fin d → Fin M) => W p.1 p.2)).symm
                  _ = (∑ g : Fin d → Fin M × Fin M, W (eP.symm g).1 (eP.symm g).2) := by
                        exact (Equiv.sum_comp eP.symm
                          (fun p : (Fin d → Fin M) × (Fin d → Fin M) => W p.1 p.2)).symm
                  _ = (∑ g : Fin d → Fin M × Fin M, ∏ q : Fin d, hq q ((g q).1.val * M + (g q).2.val)) := by
                        apply Finset.sum_congr rfl
                        intro g hg
                        rw [heP_symm g]
                  _ = (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))) := by
                        exact hswap.symm
                  _ = 1 := by
                        calc
                          (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)))
                              = (∏ q : Fin d, (1 : ℝ)) := by
                                apply Finset.prod_congr rfl
                                intro q hqmem
                                exact hcoordsum_pair q
                          _ = 1 := by
                                simp


/-- On every admissible two-scale layout, the exact weighted Taylor sum has the
uniform `M^(-2(r+beta))` Holder approximation rate. -/
theorem holderSmoothBall_unitCube_recursiveTaylorSum_error_rate
    {d r : Nat} {beta C B : Real}
    (hd : 0 < d)
    (hbeta_pos : 0 < beta) (hbeta_le_one : beta <= 1)
    (hC_nonneg : 0 <= C) (hB_nonneg : 0 <= B) :
    exists Ktaylor : Real, 0 <= Ktaylor /\
      forall M : Nat, 2 <= M ->
        forall center scale : Fin (M ^ d) -> Fin (M ^ d) -> Fin d -> Real,
          IsTwoScaleSerpentineLayout d M center scale ->
          forall f : (Fin d -> Real) -> Real,
            f ∈ holderSmoothBall r beta C B ->
              forall x : Fin d -> Real,
                (forall q, x q ∈ Set.Icc (0 : Real) 1) ->
                  |reluApproxWeightedTaylorSum r d M center scale f x - f x| <=
                    Ktaylor * shallowReLUResolutionRate M r beta := by
  let alpha : ℝ := (r : ℝ) + beta
  let Kexpr : ℝ := (C / (r.factorial : ℝ)) * (2 : ℝ) ^ alpha
  refine ⟨max Kexpr 0, ?_⟩
  constructor
  · exact le_max_right Kexpr 0
  · intro M hM center scale hlayout f hf x hx
    rcases hlayout with ⟨hscale, hcenter, hpartition, hsupport, hserp⟩
    let rho : ℝ := (((M ^ 2 - 1 : ℕ) : ℝ)⁻¹)
    have hM2ge1 : (1 : ℕ) ≤ M ^ 2 := by nlinarith [hM]
    have hR_eq : ((M ^ 2 - 1 : ℕ) : ℝ) = (M : ℝ) ^ 2 - 1 := by
      rw [Nat.cast_sub hM2ge1, Nat.cast_pow]
      norm_num
    have hMreal : (2 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM
    have hR_pos : (0 : ℝ) < ((M ^ 2 - 1 : ℕ) : ℝ) := by
      rw [hR_eq]
      nlinarith
    have hrhopos : 0 < rho := by
      dsimp [rho]
      exact inv_pos.mpr hR_pos
    have hsc_nonneg : ∀ b t q, 0 ≤ scale b t q := by
      intro b t q
      rw [hscale b t q]
      exact_mod_cast Nat.zero_le (M ^ 2 - 1)
    have hbeta0 : 0 ≤ beta := le_of_lt hbeta_pos
    have hnorm_active : ∀ b t,
        (∀ q, scale b t q * (relu (x q - center b t q) + relu (center b t q - x q)) < 1) →
          ‖x - center b t‖ ≤ rho := by
      intro b t hA
      have hcoord : ∀ q, |x q - center b t q| ≤ rho := hsupport b t x hx hA
      rw [Pi.norm_def]
      have hsup_nn : (Finset.univ.sup fun q : Fin d => ‖(x - center b t) q‖₊) ≤
          ⟨rho, le_of_lt hrhopos⟩ := by
        apply Finset.sup_le
        intro q hq
        have hq1 : (‖(x - center b t) q‖₊ : ℝ) ≤ rho := by
          simpa [Real.norm_eq_abs] using hcoord q
        exact NNReal.coe_le_coe.mp hq1
      exact NNReal.coe_le_coe.mp hsup_nn
    have hper_taylor : ∀ b t,
        (∀ q, scale b t q * (relu (x q - center b t q) + relu (center b t q - x q)) < 1) →
          |f x - finiteLinearCombination Finset.univ
              (fun a : TaylorMultiindex r d =>
                ((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f (center b t))
                    (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
              (fun a y => Finset.univ.prod fun q : Fin a.1.val => y (a.2 q) - center b t (a.2 q)) x| ≤
            C / (r.factorial : ℝ) * rho.rpow alpha := by
      intro b t hA
      exact holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
        hbeta0 hC_nonneg (le_of_lt hrhopos) f hf (center b t) x (hnorm_active b t hA)
    let w : Fin (M ^ d) → Fin (M ^ d) → ℝ :=
      fun b t => axisAlignedBoxTentWeight (center b t) (scale b t) x
    let Pfun : Fin (M ^ d) → Fin (M ^ d) → ℝ :=
      fun b t => finiteLinearCombination Finset.univ
        (fun a : TaylorMultiindex r d =>
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center b t))
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
        (fun a y => Finset.univ.prod fun q : Fin a.1.val => y (a.2 q) - center b t (a.2 q)) x
    let rem : ℝ := C / (r.factorial : ℝ) * rho.rpow alpha
    have hpart_x : (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t) = 1 := by
      simpa [w] using hpartition x hx
    have hw_nonneg : ∀ b t, 0 ≤ w b t := by
      intro b t
      dsimp [w]
      exact (axisAlignedBoxTentWeight_bounds_and_support (center b t) (scale b t) x (hsc_nonneg b t)).1
    have hactive_of_pos : ∀ b t, w b t ≠ 0 →
        ∀ q, scale b t q * (relu (x q - center b t q) + relu (center b t q - x q)) < 1 := by
      intro b t hw
      have hbs := axisAlignedBoxTentWeight_bounds_and_support (center b t) (scale b t) x (hsc_nonneg b t)
      have hnot : ¬ ∃ q, 1 ≤ scale b t q * (relu (x q - center b t q) + relu (center b t q - x q)) := by
        intro hex
        exact hw (hbs.2.2 hex)
      intro q
      by_contra hq
      exact hnot ⟨q, le_of_not_gt hq⟩
    have hFLC_err : ∀ b t,
        (∀ q, scale b t q * (relu (x q - center b t q) + relu (center b t q - x q)) < 1) →
          |Pfun b t - f x| ≤ rem := by
      intro b t hA
      rw [abs_sub_comm]
      change |f x - Pfun b t| ≤ (C / (r.factorial : ℝ)) * rho.rpow alpha
      convert hper_taylor b t hA using 1 <;> rfl
    have hterm : ∀ b t, |w b t * (Pfun b t - f x)| ≤ w b t * rem := by
      intro b t
      by_cases hw0 : w b t = 0
      · rw [hw0]
        simp
      · have hA := hactive_of_pos b t hw0
        have hflc := hFLC_err b t hA
        calc
          |w b t * (Pfun b t - f x)| = w b t * |Pfun b t - f x| := by
            rw [abs_mul, abs_of_nonneg (hw_nonneg b t)]
          _ ≤ w b t * rem := mul_le_mul_of_nonneg_left hflc (hw_nonneg b t)
    have hrewrite : ((∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t) - f x)
        = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x)) := by
      calc
        (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t) - f x
            = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t)
                - (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * f x) := by
                congr 1
                calc
                  f x = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t) * f x := by
                          rw [hpart_x]
                          ring
                  _ = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * f x) := by
                          rw [Finset.sum_mul]
                          apply Finset.sum_congr rfl
                          intro b hb
                          rw [Finset.sum_mul]
        _ = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x)) := by
                calc
                  (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t)
                      - (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * f x)
                      = ∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ((w b t * Pfun b t) - (w b t * f x)) := by
                          rw [← Finset.sum_sub_distrib]
                          apply Finset.sum_congr rfl
                          intro b hb
                          rw [← Finset.sum_sub_distrib]
                  _ = ∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x) := by
                          apply Finset.sum_congr rfl
                          intro b hb
                          apply Finset.sum_congr rfl
                          intro t ht
                          ring
    change |(∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t) - f x| ≤
        (max Kexpr 0) * shallowReLUResolutionRate M r beta
    have hmain1 : |(∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * Pfun b t) - f x| ≤ rem := by
      rw [hrewrite]
      calc
        |∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x)|
            ≤ ∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), |w b t * (Pfun b t - f x)| := by
              calc
                |∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x)|
                    ≤ ∑ b : Fin (M ^ d), |∑ t : Fin (M ^ d), w b t * (Pfun b t - f x)| := by
                      exact Finset.abs_sum_le_sum_abs
                        (fun b : Fin (M ^ d) => ∑ t : Fin (M ^ d), w b t * (Pfun b t - f x))
                        Finset.univ
                _ ≤ ∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), |w b t * (Pfun b t - f x)| := by
                      apply Finset.sum_le_sum
                      intro b hb
                      exact Finset.abs_sum_le_sum_abs
                        (fun t : Fin (M ^ d) => w b t * (Pfun b t - f x))
                        Finset.univ
        _ ≤ ∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * rem := by
              apply Finset.sum_le_sum
              intro b hb
              apply Finset.sum_le_sum
              intro t ht
              exact hterm b t
        _ = rem := by
              calc
                (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t * rem)
                    = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), w b t) * rem := by
                        rw [Finset.sum_mul]
                        apply Finset.sum_congr rfl
                        intro b hb
                        rw [Finset.sum_mul]
                _ = rem := by
                        rw [hpart_x]
                        ring
    -- remaining: rem ≤ (max Kexpr 0) * shallowReLUResolutionRate M r beta
    have halpha0 : 0 ≤ alpha := by
      dsimp [alpha]
      exact add_nonneg (Nat.cast_nonneg r) hbeta0
    have hMpos : (0 : ℝ) < (M : ℝ) := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num : (0 : ℕ) < 2) hM)
    have hMpos' : 0 ≤ (M : ℝ) := le_of_lt hMpos
    have hcr0 : 0 ≤ C / (r.factorial : ℝ) := by
      have hf0 : (0 : ℝ) ≤ (r.factorial : ℝ) := by exact_mod_cast Nat.zero_le (r.factorial)
      exact div_nonneg hC_nonneg hf0
    have hM2inv0 : 0 ≤ ((M : ℝ) ^ 2)⁻¹ := by
      exact inv_nonneg.mpr (sq_nonneg (M : ℝ))
    have hsq_ge4 : (4 : ℝ) ≤ (M : ℝ) ^ 2 := by
      nlinarith [sq_nonneg ((M : ℝ) - 2), hMreal]
    have hrho_le_R2 : rho ≤ (2 : ℝ) * ((M : ℝ) ^ 2)⁻¹ := by
      dsimp [rho]
      rw [hR_eq]
      have htA : (0 : ℝ) < ((M : ℝ) ^ 2) / 2 := by nlinarith [hsq_ge4]
      have htAB : ((M : ℝ) ^ 2) / 2 ≤ (M : ℝ) ^ 2 - 1 := by nlinarith [hsq_ge4]
      have hiv := one_div_le_one_div_of_le htA htAB
      calc
        ((M : ℝ) ^ 2 - 1)⁻¹ = 1 / ((M : ℝ) ^ 2 - 1) := by rw [← one_div]
        _ ≤ 1 / (((M : ℝ) ^ 2) / 2) := hiv
        _ = (2 : ℝ) * ((M : ℝ) ^ 2)⁻¹ := by
          rw [one_div]
          rw [inv_div]
          rw [div_eq_mul_inv]
    have hpow_id : (((M : ℝ) ^ 2)⁻¹) ^ alpha = (M : ℝ) ^ (-(2 * alpha)) := by
      rw [← Real.rpow_neg_one ((M : ℝ) ^ 2)]
      rw [← Real.rpow_mul (sq_nonneg (M : ℝ)) (-1 : ℝ) alpha]
      rw [← Real.rpow_natCast (M : ℝ) 2]
      rw [← Real.rpow_mul hMpos' ((2 : ℕ) : ℝ) ((-1 : ℝ) * alpha)]
      have hexp : ((2 : ℕ) : ℝ) * ((-1 : ℝ) * alpha) = -(2 * alpha) := by
        ring
      rw [hexp]
    have hrate : shallowReLUResolutionRate M r beta = (M : ℝ) ^ (-(2 * alpha)) := by
      unfold shallowReLUResolutionRate
      rfl
    have hrate0 : 0 ≤ (M : ℝ) ^ (-(2 * alpha)) := by
      exact Real.rpow_nonneg hMpos' (-(2 * alpha))
    have hremK : rem ≤ Kexpr * (M : ℝ) ^ (-(2 * alpha)) := by
      calc
        rem = (C / (r.factorial : ℝ)) * rho.rpow alpha := rfl
        _ ≤ (C / (r.factorial : ℝ)) * (((2 : ℝ) * ((M : ℝ) ^ 2)⁻¹) ^ alpha) := by
          exact mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow (le_of_lt hrhopos) hrho_le_R2 halpha0) hcr0
        _ = (C / (r.factorial : ℝ)) * ((2 : ℝ) ^ alpha * (((M : ℝ) ^ 2)⁻¹) ^ alpha) := by
          rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hM2inv0]
        _ = (C / (r.factorial : ℝ)) * ((2 : ℝ) ^ alpha * (M : ℝ) ^ (-(2 * alpha))) := by
          rw [hpow_id]
        _ = Kexpr * (M : ℝ) ^ (-(2 * alpha)) := by
          dsimp [Kexpr]
          ring
    have hrem_main : rem ≤ (max Kexpr 0) * shallowReLUResolutionRate M r beta := by
      rw [hrate]
      calc
        rem ≤ Kexpr * (M : ℝ) ^ (-(2 * alpha)) := hremK
        _ ≤ (max Kexpr 0) * (M : ℝ) ^ (-(2 * alpha)) := by
          exact mul_le_mul_of_nonneg_right (le_max_left Kexpr 0) hrate0
    exact le_trans hmain1 hrem_main


/-- The boundary-inclusive `M^2` knot grid can be factored into `M^d` coarse
blocks and `M^d` serpentine offsets while retaining partition of unity and
signed one-coordinate adjacency. -/
theorem exists_unitCube_canonicalTwoScale_serpentine_tent_layout
    {d M : Nat} (hd : 0 < d) (hM : 2 <= M) :
    exists orderC orderF : Fin (M ^ d) ≃ (Fin d -> Fin M),
    exists center scale : Fin (M ^ d) -> Fin (M ^ d) -> Fin d -> Real,
      IsCanonicalTwoScaleLayout d M orderC orderF center scale := by
  have hMpos : 0 < M := by omega
  obtain ⟨order_c, horder_c⟩ := exists_reluApprox_serpentine_fineGrid_equiv M d hMpos
  obtain ⟨order_f, horder_f⟩ := exists_reluApprox_serpentine_fineGrid_equiv M d hMpos
  let node : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℕ :=
    fun b t q => (order_c b q).val * M + (order_f t q).val
  let ctr : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℝ :=
    fun b t q => (node b t q : ℝ) / ((M ^ 2 - 1 : ℕ) : ℝ)
  let scl : Fin (M ^ d) → Fin (M ^ d) → Fin d → ℝ :=
    fun b t q => ((M ^ 2 - 1 : ℕ) : ℝ)
  refine ⟨order_c, order_f, ctr, scl, ?_, ?_, ?_, ?_⟩
  · constructor
    · intro hM'
      simpa only [Subsingleton.elim hM' hMpos] using horder_c.1
    · exact horder_c.2
  · constructor
    · intro hM'
      simpa only [Subsingleton.elim hM' hMpos] using horder_f.1
    · exact horder_f.2
  · intro b t q
    rfl
  simp only [IsTwoScaleSerpentineLayout]
  constructor
  · -- clause 1: scale is the constant (M^2 - 1)
    intro b t q
    rfl
  · constructor
    · -- clause 2: every center lies in [0,1]
      intro b t q
      have hM1 : (1 : ℕ) ≤ M := by omega
      have hM_le_M2 : M ≤ M ^ 2 := by
        have h := Nat.mul_le_mul_left M hM1
        simpa [pow_two] using h
      have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
      have h1lt : (1 : ℕ) < M ^ 2 := by omega
      have h1le : (1 : ℕ) ≤ M ^ 2 := by omega
      have hBpos : (0 : ℝ) < ((M ^ 2 - 1 : ℕ) : ℝ) := by
        exact_mod_cast (Nat.sub_pos_of_lt h1lt)
      have hc1 : (order_c b q).val ≤ M - 1 := Nat.le_sub_one_of_lt (order_c b q).isLt
      have hf1 : (order_f t q).val ≤ M - 1 := Nat.le_sub_one_of_lt (order_f t q).isLt
      have hcR : ((order_c b q).val : ℝ) ≤ (M : ℝ) - 1 := by
        have hcast : ((order_c b q).val : ℝ) ≤ ((M - 1 : ℕ) : ℝ) := by exact_mod_cast hc1
        rw [Nat.cast_sub hM1] at hcast
        simpa using hcast
      have hfR : ((order_f t q).val : ℝ) ≤ (M : ℝ) - 1 := by
        have hcast : ((order_f t q).val : ℝ) ≤ ((M - 1 : ℕ) : ℝ) := by exact_mod_cast hf1
        rw [Nat.cast_sub hM1] at hcast
        simpa using hcast
      have hB_eq : ((M ^ 2 - 1 : ℕ) : ℝ) = (M : ℝ) ^ 2 - 1 := by
        rw [Nat.cast_sub h1le, Nat.cast_pow, Nat.cast_one]
      have hnum : (node b t q : ℝ) =
          ((order_c b q).val : ℝ) * (M : ℝ) + ((order_f t q).val : ℝ) := by
        dsimp [node]
        simp
      have hbnd : ((order_c b q).val : ℝ) * (M : ℝ) + ((order_f t q).val : ℝ) ≤
          (M : ℝ) ^ 2 - 1 := by
        have hMnonneg : (0 : ℝ) ≤ (M : ℝ) := by exact_mod_cast (Nat.zero_le M)
        nlinarith [hcR, hfR, hMnonneg]
      dsimp [ctr]
      apply Set.mem_Icc.mpr
      constructor
      · apply div_nonneg
        · exact_mod_cast (Nat.zero_le (node b t q))
        · exact le_of_lt hBpos
      · rw [div_le_one hBpos]
        rw [hnum]
        rw [hB_eq]
        exact hbnd
    · -- clauses 4-5 (support, adjacency) are closed below; clause 3 (partition of unity) is deferred
      constructor
      swap
      constructor
      · -- clause 4: active support
        intro b t x hxIcc hsupp q
        let B : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
        have h1lt : (1 : ℕ) < M ^ 2 := by
          have hM1 : (1 : ℕ) ≤ M := by omega
          have hM_le_M2 : M ≤ M ^ 2 := by
            have h := Nat.mul_le_mul_left M hM1
            simpa [pow_two] using h
          have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
          omega
        have hBpos : (0 : ℝ) < B := by
          dsimp [B]
          exact_mod_cast (Nat.sub_pos_of_lt h1lt)
        have hs0 : B * (relu (x q - ctr b t q) + relu (ctr b t q - x q)) < 1 := by
          simpa [B, scl] using hsupp q
        have hrelu_sum : ∀ y : ℝ, relu y + relu (-y) = |y| := by
          intro y
          unfold relu
          by_cases h : 0 ≤ y
          · have hneg : -y ≤ 0 := neg_nonpos.mpr h
            rw [max_eq_left h, max_eq_right hneg, abs_of_nonneg h]
            simp
          · have hnonpos : y ≤ 0 := le_of_not_ge h
            have hposneg : 0 ≤ -y := neg_nonneg.mpr hnonpos
            rw [max_eq_right hnonpos, max_eq_left hposneg, abs_of_nonpos hnonpos]
            simp
        have hru : relu (x q - ctr b t q) + relu (ctr b t q - x q) = |x q - ctr b t q| := by
          have hneg : ctr b t q - x q = -(x q - ctr b t q) := by ring
          rw [hneg]
          exact hrelu_sum (x q - ctr b t q)
        have hs1 : B * |x q - ctr b t q| < 1 := by
          simpa [hru] using hs0
        have hlt : |x q - ctr b t q| < B⁻¹ := by
          have hBne : B ≠ 0 := ne_of_gt hBpos
          have hBB : B * B⁻¹ = 1 := mul_inv_cancel₀ hBne
          have hs2 : B * |x q - ctr b t q| < B * B⁻¹ := by
            simpa [hBB] using hs1
          exact lt_of_mul_lt_mul_left hs2 (le_of_lt hBpos)
        simpa [B] using le_of_lt hlt
      · -- clause 5: adjacency along the fine serpentine
        intro b k hk
        have hk0 : k < M ^ d := Nat.lt_of_succ_lt hk
        rcases horder_f.2 k hk with ⟨q, hstep, hfix⟩
        refine ⟨q, ?_, ?_⟩
        · -- selected coordinate changes by ±1/D
          let D : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
          have hsign :
              ((order_f ⟨k + 1, hk⟩ q).val : ℤ) - ((order_f ⟨k, hk0⟩ q).val : ℤ) = 1 ∨
              ((order_f ⟨k + 1, hk⟩ q).val : ℤ) - ((order_f ⟨k, hk0⟩ q).val : ℤ) = -1 := by
            have hz1 : (((order_f ⟨k + 1, hk⟩ q).val : ℤ) -
                ((order_f ⟨k, hk0⟩ q).val : ℤ)).natAbs = 1 := by
              simpa using hstep
            have hz2 : (((order_f ⟨k + 1, hk⟩ q).val : ℤ) -
                ((order_f ⟨k, hk0⟩ q).val : ℤ)).natAbs = (1 : ℤ).natAbs := by
              simpa using hz1
            exact Int.natAbs_eq_natAbs_iff.mp hz2
          rcases hsign with hplus | hminus
          · left
            have hnat : (order_f ⟨k + 1, hk⟩ q).val = (order_f ⟨k, hk0⟩ q).val + 1 := by
              omega
            have hnode1 : node b ⟨k + 1, hk⟩ q = node b ⟨k, hk0⟩ q + 1 := by
              dsimp [node]
              rw [hnat]
              ring_nf
            have hnode1R : (node b ⟨k + 1, hk⟩ q : ℝ) = (node b ⟨k, hk0⟩ q : ℝ) + 1 := by
              norm_num [hnode1]
            calc
              ctr b ⟨k + 1, hk⟩ q = (node b ⟨k + 1, hk⟩ q : ℝ) / D := by
                dsimp [ctr, D]
              _ = ((node b ⟨k, hk0⟩ q : ℝ) + 1) / D := by
                rw [hnode1R]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D + 1 / D := by
                rw [add_div]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D + D⁻¹ := by
                rw [one_div]
              _ = ctr b ⟨k, hk0⟩ q + D⁻¹ := by
                dsimp [ctr, D]
          · right
            have hnat2 : (order_f ⟨k, hk0⟩ q).val = (order_f ⟨k + 1, hk⟩ q).val + 1 := by
              omega
            have hnode2 : node b ⟨k, hk0⟩ q = node b ⟨k + 1, hk⟩ q + 1 := by
              dsimp [node]
              rw [hnat2]
              ring_nf
            have hnode2R : (node b ⟨k, hk0⟩ q : ℝ) = (node b ⟨k + 1, hk⟩ q : ℝ) + 1 := by
              norm_num [hnode2]
            have hnode1sub : (node b ⟨k + 1, hk⟩ q : ℝ) = (node b ⟨k, hk0⟩ q : ℝ) - 1 := by
              linarith
            calc
              ctr b ⟨k + 1, hk⟩ q = (node b ⟨k + 1, hk⟩ q : ℝ) / D := by
                dsimp [ctr, D]
              _ = ((node b ⟨k, hk0⟩ q : ℝ) - 1) / D := by
                rw [hnode1sub]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D - 1 / D := by
                rw [sub_div]
              _ = (node b ⟨k, hk0⟩ q : ℝ) / D - D⁻¹ := by
                rw [one_div]
              _ = ctr b ⟨k, hk0⟩ q - D⁻¹ := by
                dsimp [ctr, D]
        · -- other coordinates are fixed
          let D : ℝ := ((M ^ 2 - 1 : ℕ) : ℝ)
          intro u hu
          have hf : order_f ⟨k + 1, hk⟩ u = order_f ⟨k, hk0⟩ u := hfix u hu
          have hfval : (order_f ⟨k + 1, hk⟩ u).val = (order_f ⟨k, hk0⟩ u).val := by
            exact congrArg Fin.val hf
          have hnodeE : node b ⟨k + 1, hk⟩ u = node b ⟨k, hk0⟩ u := by
            dsimp [node]
            rw [hfval]
          have hnR : (node b ⟨k + 1, hk⟩ u : ℝ) = (node b ⟨k, hk0⟩ u : ℝ) := by
            exact congrArg (fun n : ℕ => (n : ℝ)) hnodeE
          calc
            ctr b ⟨k + 1, hk⟩ u = (node b ⟨k + 1, hk⟩ u : ℝ) / D := by
              dsimp [ctr, D]
            _ = (node b ⟨k, hk0⟩ u : ℝ) / D := by
              rw [hnR]
            _ = ctr b ⟨k, hk0⟩ u := by
              dsimp [ctr, D]
      · -- clause 3: partition of unity
        intro x hx
        let Bnat : ℕ := M ^ 2 - 1
        let B : ℝ := (Bnat : ℝ)
        have hM1 : (1 : ℕ) ≤ M := by omega
        have hM_le_M2 : M ≤ M ^ 2 := by
          have h := Nat.mul_le_mul_left M hM1
          simpa [pow_two] using h
        have h2le : (2 : ℕ) ≤ M ^ 2 := le_trans hM hM_le_M2
        have h1lt : (1 : ℕ) < M ^ 2 := by omega
        have hBnat_pos : 0 < Bnat := Nat.sub_pos_of_lt h1lt
        have hBpos : (0 : ℝ) < B := by
          dsimp [B, Bnat]
          exact_mod_cast (Nat.sub_pos_of_lt h1lt)
        have hBne : B ≠ 0 := ne_of_gt hBpos
        have hBnn : (0 : ℝ) ≤ B := le_of_lt hBpos
        let tent1 : Fin d → ℕ → ℝ := fun q i =>
          relu (1 - B * (relu (x q - (i : ℝ) / B) + relu ((i : ℝ) / B - x q)))
        let hq : Fin d → ℕ → ℝ := fun q i => relu (1 - |B * x q - (i : ℝ)|)
        have hrelu_sum : ∀ y : ℝ, relu y + relu (-y) = |y| := by
          intro y
          unfold relu
          by_cases h : 0 ≤ y
          · have hneg : -y ≤ 0 := neg_nonpos.mpr h
            rw [max_eq_left h, max_eq_right hneg, abs_of_nonneg h]
            simp
          · have hnonpos : y ≤ 0 := le_of_not_ge h
            have hposneg : 0 ≤ -y := neg_nonneg.mpr hnonpos
            rw [max_eq_right hnonpos, max_eq_left hposneg, abs_of_nonpos hnonpos]
            simp
        have hxB : ∀ q : Fin d, B * x q ∈ Set.Icc (0 : ℝ) B := by
          intro q
          have hxq : (0 : ℝ) ≤ x q ∧ x q ≤ 1 := by
            exact Set.mem_Icc.mp (hx q)
          constructor
          · exact mul_nonneg hBnn hxq.1
          · calc
              B * x q ≤ B * 1 := mul_le_mul_of_nonneg_left hxq.2 hBnn
              _ = B := by simp
        have hscl : ∀ b t q, scl b t q = B := by
          intro b t q
          rfl
        have hctr_def : ∀ b t q, ctr b t q = (node b t q : ℝ) / B := by
          intro b t q
          rfl
        have hcoord : ∀ b t q,
            coordinateTentReLUFunction q (ctr b t q) (scl b t q) x =
              relu (1 - |B * x q - (node b t q : ℝ)|) := by
          intro b t q
          unfold coordinateTentReLUFunction
          apply congrArg relu
          congr 1
          rw [hscl b t q, hctr_def b t q]
          have hinner : relu (x q - (node b t q : ℝ) / B) +
                relu ((node b t q : ℝ) / B - x q) =
              |x q - (node b t q : ℝ) / B| := by
            have hneg : (node b t q : ℝ) / B - x q = -(x q - (node b t q : ℝ) / B) := by ring
            rw [hneg]
            exact hrelu_sum (x q - (node b t q : ℝ) / B)
          rw [hinner]
          have hdist : B * (x q - (node b t q : ℝ) / B) = B * x q - (node b t q : ℝ) := by
            field_simp [hBne]
          calc
            B * |x q - (node b t q : ℝ) / B| = |B| * |x q - (node b t q : ℝ) / B| := by
              rw [abs_of_nonneg hBnn]
            _ = |B * (x q - (node b t q : ℝ) / B)| := by
              rw [← abs_mul]
            _ = |B * x q - (node b t q : ℝ)| := by
              rw [hdist]
        have hax' : ∀ b t, axisAlignedBoxTentWeight (ctr b t) (scl b t) x =
            ∏ q : Fin d, hq q (node b t q) := by
          intro b t
          unfold axisAlignedBoxTentWeight
          apply Finset.prod_congr rfl
          intro q hqmem
          unfold hq
          exact hcoord b t q
        let W : (Fin d → Fin M) → (Fin d → Fin M) → ℝ :=
          fun a f => ∏ q : Fin d, hq q ((a q).val * M + (f q).val)
        have hnode_c : ∀ (a : Fin d → Fin M) t q,
            node (order_c.symm a) t q = (a q).val * M + (order_f t q).val := by
          intro a t q
          dsimp [node]
          have hca : order_c (order_c.symm a) = a := Equiv.apply_symm_apply order_c a
          have hcq : (order_c (order_c.symm a) q).val = (a q).val :=
            congrArg Fin.val (congrFun hca q)
          rw [hcq]
        have hreindex_b :
            (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q))
              = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
          calc
            (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q))
                = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                    ∏ q : Fin d, hq q (node (order_c.symm a) t q)) := by
                  exact (Equiv.sum_comp order_c.symm
                    (fun b : Fin (M ^ d) => ∑ t : Fin (M ^ d),
                      ∏ q : Fin d, hq q (node b t q))).symm
            _ = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
                  apply Finset.sum_congr rfl
                  intro a ha
                  apply Finset.sum_congr rfl
                  intro t ht
                  apply Finset.prod_congr rfl
                  intro q hq1
                  rw [hnode_c a t q]
        have hreindex_t :
            (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val))
              = (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f) := by
          apply Finset.sum_congr rfl
          intro a ha
          calc
            (∑ t : Fin (M ^ d), ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val))
                = (∑ f : Fin d → Fin M,
                    ∏ q : Fin d, hq q ((a q).val * M + (order_f (order_f.symm f) q).val)) := by
                  exact (Equiv.sum_comp order_f.symm
                    (fun t : Fin (M ^ d) => ∏ q : Fin d,
                      hq q ((a q).val * M + (order_f t q).val))).symm
            _ = (∑ f : Fin d → Fin M, W a f) := by
                  apply Finset.sum_congr rfl
                  intro f hf
                  dsimp [W]
                  apply Finset.prod_congr rfl
                  intro q hq1
                  have hfa : order_f (order_f.symm f) = f := Equiv.apply_symm_apply order_f f
                  have hfq : (order_f (order_f.symm f) q).val = (f q).val :=
                    congrArg Fin.val (congrFun hfa q)
                  rw [hfq]
        calc
          (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d),
              axisAlignedBoxTentWeight (ctr b t) (scl b t) x)
              = (∑ b : Fin (M ^ d), ∑ t : Fin (M ^ d), ∏ q : Fin d, hq q (node b t q)) := by
                apply Finset.sum_congr rfl
                intro b hb
                apply Finset.sum_congr rfl
                intro t ht
                exact hax' b t
          _ = (∑ a : Fin d → Fin M, ∑ t : Fin (M ^ d),
                  ∏ q : Fin d, hq q ((a q).val * M + (order_f t q).val)) := by
                exact hreindex_b
          _ = (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f) := by
                exact hreindex_t
          _ = 1 := by
                have hhat_id : ∀ (w : ℝ) (m : ℕ),
                    relu (1 - |w - (m : ℝ)|) =
                      relu (w - (m : ℝ) + 1) - 2 * relu (w - (m : ℝ)) +
                        relu (w - (m : ℝ) - 1) := by
                  intro w m
                  let r : ℝ := (m : ℝ)
                  by_cases h1 : w ≤ r - 1
                  · have hwm : w - r ≤ 0 := by linarith
                    have hwm1 : w - r + 1 ≤ 0 := by linarith
                    have hwm2 : w - r - 1 ≤ 0 := by linarith
                    have harg : 1 - (-(w - r)) ≤ 0 := by linarith
                    unfold relu
                    rw [abs_of_nonpos hwm]
                    rw [max_eq_right harg]
                    rw [max_eq_right hwm1, max_eq_right hwm, max_eq_right hwm2]
                    ring
                  · have hr1 : r - 1 < w := lt_of_not_ge h1
                    by_cases h2 : w ≤ r
                    · have hwm : w - r ≤ 0 := by linarith
                      have hpos1 : 0 ≤ w - r + 1 := by linarith
                      have hwm2 : w - r - 1 ≤ 0 := by linarith
                      have harg : 0 ≤ 1 - (-(w - r)) := by linarith
                      unfold relu
                      rw [abs_of_nonpos hwm]
                      rw [max_eq_left harg]
                      rw [max_eq_left hpos1, max_eq_right hwm, max_eq_right hwm2]
                      ring
                    · have hr : r < w := lt_of_not_ge h2
                      by_cases h3 : w ≤ r + 1
                      · have hwp : 0 ≤ w - r := by linarith
                        have hpos1 : 0 ≤ w - r + 1 := by linarith
                        have hwm2 : w - r - 1 ≤ 0 := by linarith
                        have harg : 0 ≤ 1 - (w - r) := by linarith
                        unfold relu
                        rw [abs_of_nonneg hwp]
                        rw [max_eq_left harg]
                        rw [max_eq_left hpos1, max_eq_left hwp, max_eq_right hwm2]
                        ring
                      · have hwp : 0 ≤ w - r := by linarith
                        have hpos1 : 0 ≤ w - r + 1 := by linarith
                        have hpos2 : 0 ≤ w - r - 1 := by linarith
                        have harg : 1 - (w - r) ≤ 0 := by linarith
                        unfold relu
                        rw [abs_of_nonneg hwp]
                        rw [max_eq_right harg]
                        rw [max_eq_left hpos1, max_eq_left hwp, max_eq_left hpos2]
                        ring
                have hfin_range : ∀ {n : ℕ} (f : ℕ → ℝ),
                    (∑ m : Fin n, f (m.val)) = ∑ m ∈ Finset.range n, f m := by
                  intro n f
                  exact Finset.sum_bij (s := (Finset.univ : Finset (Fin n))) (t := Finset.range n)
                    (f := fun m : Fin n => f (m.val)) (g := f)
                    (fun m hm => (m : ℕ))
                    (by intro m hm; exact Finset.mem_range.mpr m.isLt)
                    (by intro a ha b hb hab; apply Fin.ext; exact hab)
                    (by intro b hb; exact ⟨⟨b, Finset.mem_range.mp hb⟩, by simp, rfl⟩)
                    (by intro m hm; rfl)
                have h1d_hat : ∀ (K : ℕ) (w : ℝ), (0 : ℝ) ≤ w → w ≤ (K : ℝ) →
                    (∑ m ∈ Finset.range (K + 1), relu (1 - |w - (m : ℝ)|)) = 1 := by
                  intro K w hw0 hwK
                  let ψ : ℕ → ℝ := fun m => relu (w - (m : ℝ) + 1) - relu (w - (m : ℝ))
                  have hhat : ∀ m : ℕ, relu (1 - |w - (m : ℝ)|) = ψ m - ψ (m + 1) := by
                    intro m
                    rw [hhat_id w m]
                    dsimp [ψ]
                    simp only [Nat.cast_add, Nat.cast_one]
                    ring
                  have htelescope : ∀ n : ℕ,
                      (∑ m ∈ Finset.range (n + 1), (ψ m - ψ (m + 1))) = ψ 0 - ψ (n + 1) := by
                    intro n
                    induction n with
                    | zero =>
                        simp
                    | succ n ih =>
                        rw [Finset.sum_range_succ]
                        rw [ih]
                        ring
                  calc
                    (∑ m ∈ Finset.range (K + 1), relu (1 - |w - (m : ℝ)|))
                        = (∑ m ∈ Finset.range (K + 1), (ψ m - ψ (m + 1))) := by
                          apply Finset.sum_congr rfl
                          intro m hm
                          exact hhat m
                    _ = ψ 0 - ψ (K + 1) := by
                          exact htelescope K
                    _ = 1 := by
                          have hcastK : ((K + 1 : ℕ) : ℝ) = (K : ℝ) + 1 := by
                            rw [Nat.cast_add, Nat.cast_one]
                          have h1 : (0 : ℝ) ≤ w + 1 := by linarith
                          have h2 : (0 : ℝ) ≤ w := hw0
                          have h5 : w - ((K + 1 : ℕ) : ℝ) ≤ 0 := by
                            linarith [hwK, hcastK]
                          have h6 : w - ((K + 1 : ℕ) : ℝ) + 1 ≤ 0 := by
                            linarith [hwK, hcastK]
                          dsimp [ψ]
                          unfold relu
                          simp only [Nat.cast_zero, sub_zero, add_zero]
                          rw [max_eq_left h1, max_eq_left h2, max_eq_right h6, max_eq_right h5]
                          ring
                have hcoordsum : ∀ q : Fin d,
                    (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val)) = 1 := by
                  intro q
                  have hxq0 : (0 : ℝ) ≤ B * x q := (Set.mem_Icc.mp (hxB q)).1
                  have hxqB : B * x q ≤ (Bnat : ℝ) := by
                    have hb : B * x q ≤ B := (Set.mem_Icc.mp (hxB q)).2
                    simpa [B] using hb
                  have hBnat_succ : Bnat + 1 = M * M := by
                    have h1le : (1 : ℕ) ≤ M ^ 2 := Nat.le_of_lt h1lt
                    dsimp [Bnat]
                    rw [Nat.sub_add_cancel h1le]
                    rw [pow_two]
                  have hterm : ∀ m : ℕ, hq q m = relu (1 - |B * x q - (m : ℝ)|) := by
                    intro m
                    rfl
                  let e : Fin M × Fin M ≃ Fin (M * M) := finProdFinEquiv (m := M) (n := M)
                  have hval : ∀ p : Fin M × Fin M, (e p).val = p.1.val * M + p.2.val := by
                    intro p
                    cases p with
                    | mk i j =>
                        dsimp [e, finProdFinEquiv]
                        ring
                  have hfin : (∑ m : Fin (M * M), hq q (m.val)) =
                      ∑ m ∈ Finset.range (M * M), hq q m :=
                    hfin_range (fun m : ℕ => hq q m)
                  have hstep : (∑ p : Fin M × Fin M, hq q ((e p).val)) =
                      ∑ m : Fin (M * M), hq q (m.val) :=
                    Equiv.sum_comp e (fun m : Fin (M * M) => hq q (m.val))
                  have hpair : (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) = 1 := by
                    calc
                      (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))
                          = ∑ p : Fin M × Fin M, hq q ((e p).val) := by
                            apply Finset.sum_congr rfl
                            intro p hp
                            rw [hval p]
                      _ = ∑ m : Fin (M * M), hq q (m.val) := hstep
                      _ = ∑ m ∈ Finset.range (M * M), hq q m := hfin
                      _ = ∑ m ∈ Finset.range (Bnat + 1), relu (1 - |B * x q - (m : ℝ)|) := by
                            rw [← hBnat_succ]
                      _ = 1 := by
                            exact h1d_hat Bnat (B * x q) hxq0 hxqB
                  have hdq : (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val))
                      = (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) := by
                    exact (Fintype.sum_prod_type (fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))).symm
                  rw [hdq]
                  exact hpair
                have hcoordsum_pair : ∀ q : Fin d,
                    (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)) = 1 := by
                  intro q
                  calc
                    (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))
                        = (∑ i : Fin M, ∑ j : Fin M, hq q ((i : Fin M).val * M + (j : Fin M).val)) := by
                          exact Fintype.sum_prod_type
                            (fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))
                    _ = 1 := hcoordsum q
                let toP : (Fin d → Fin M) × (Fin d → Fin M) → (Fin d → Fin M × Fin M) :=
                  fun p q => (p.1 q, p.2 q)
                let fromP : (Fin d → Fin M × Fin M) → (Fin d → Fin M) × (Fin d → Fin M) :=
                  fun g => (fun q => (g q).1, fun q => (g q).2)
                let eP : (Fin d → Fin M) × (Fin d → Fin M) ≃ (Fin d → Fin M × Fin M) :=
                  { toFun := toP
                    invFun := fromP
                    left_inv := by
                      rintro ⟨a, f⟩
                      apply Prod.ext <;> funext q <;> rfl
                    right_inv := by
                      intro g
                      funext q
                      rfl }
                have heP_symm : ∀ g : Fin d → Fin M × Fin M,
                    eP.symm g = (fun q : Fin d => (g q).1, fun q : Fin d => (g q).2) := by
                  intro g
                  rfl
                have hswap : (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))) =
                    (∑ g : Fin d → Fin M × Fin M, ∏ q : Fin d, hq q ((g q).1.val * M + (g q).2.val)) := by
                  rw [Finset.prod_univ_sum
                    (fun _ : Fin d => (Finset.univ : Finset (Fin M × Fin M)))
                    (fun q : Fin d => fun p : Fin M × Fin M => hq q (p.1.val * M + p.2.val))]
                  simpa [Fintype.piFinset_univ]
                calc
                  (∑ a : Fin d → Fin M, ∑ f : Fin d → Fin M, W a f)
                      = (∑ p : (Fin d → Fin M) × (Fin d → Fin M), W p.1 p.2) := by
                        exact (Fintype.sum_prod_type
                          (fun p : (Fin d → Fin M) × (Fin d → Fin M) => W p.1 p.2)).symm
                  _ = (∑ g : Fin d → Fin M × Fin M, W (eP.symm g).1 (eP.symm g).2) := by
                        exact (Equiv.sum_comp eP.symm
                          (fun p : (Fin d → Fin M) × (Fin d → Fin M) => W p.1 p.2)).symm
                  _ = (∑ g : Fin d → Fin M × Fin M, ∏ q : Fin d, hq q ((g q).1.val * M + (g q).2.val)) := by
                        apply Finset.sum_congr rfl
                        intro g hg
                        rw [heP_symm g]
                  _ = (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val))) := by
                        exact hswap.symm
                  _ = 1 := by
                        calc
                          (∏ q : Fin d, (∑ p : Fin M × Fin M, hq q (p.1.val * M + p.2.val)))
                              = (∏ q : Fin d, (1 : ℝ)) := by
                                apply Finset.prod_congr rfl
                                intro q hqmem
                                exact hcoordsum_pair q
                          _ = 1 := by
                                simp



end Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra
