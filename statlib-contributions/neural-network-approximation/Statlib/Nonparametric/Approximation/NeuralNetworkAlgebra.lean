private theorem holder_smooth_ball_unit_cube_lw2_rate_from_block_schedule
    {d r W0 Dblock : ℕ} {beta C B cTaylor cQuant cDecoder cSelector : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcTaylor : 0 ≤ cTaylor) (hcQuant : 0 ≤ cQuant)
    (hcDecoder : 0 ≤ cDecoder) (hcSelector : 0 ≤ cSelector)
    (hblock :
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          D = (M ^ d) * (Dblock + 1) ∧
          0 < D ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤
                  cTaylor *
                      (Real.sqrt (d : ℝ) *
                        (M : ℝ).rpow (-2 : ℝ)).rpow
                          ((r : ℝ) + beta)
                    + cQuant *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cDecoder *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cSelector *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cRate : ℝ, 0 < cRate ∧
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
          P = fullyConnectedReLUParameterCount d L W ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d L W P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ cRate *
                  (((L : ℝ) * (W : ℝ) ^ 2).rpow
                    (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  let cErr0 : ℝ :=
    cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) +
      cQuant + cDecoder + cSelector
  let cErr : ℝ := cErr0 + 1
  have hsqrt_nonneg : 0 ≤ Real.sqrt (d : ℝ) := Real.sqrt_nonneg _
  have hpow_nonneg : 0 ≤ (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) :=
    Real.rpow_nonneg hsqrt_nonneg _
  have hcErr0_nonneg : 0 ≤ cErr0 := by
    have hprod : 0 ≤ cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) :=
      mul_nonneg hcTaylor hpow_nonneg
    dsimp [cErr0]
    exact add_nonneg (add_nonneg (add_nonneg hprod hcQuant) hcDecoder) hcSelector
  have hcErr_pos : 0 < cErr := by
    dsimp [cErr]
    linarith
  have hcDepth_pos : 0 < (Dblock : ℝ) + 1 := by
    positivity
  refine holderSmoothBall_unitCube_LW2_rate_from_fixed_width_M_rate
    (d := d) (r := r) (W0 := W0) (beta := beta) (C := C) (B := B)
    (cDepth := (Dblock : ℝ) + 1) (cErr := cErr)
    hd hW0 hbeta_nonneg hsmooth_pos hcDepth_pos hcErr_pos ?_
  intro M hM
  rcases hblock M hM with ⟨D, P, hD_eq, hD_pos, hP_eq, hnet⟩
  refine ⟨D, P, hD_pos, ?_, hP_eq, ?_⟩
  · have hD_cast : (D : ℝ) = ((Dblock : ℝ) + 1) * (M : ℝ) ^ d := by
      rw [hD_eq]
      norm_num
      ring
    exact le_of_eq hD_cast
  · intro f hf
    rcases hnet f hf with ⟨g, hg_net, hg_err⟩
    refine ⟨g, hg_net, ?_⟩
    intro x hx
    let A : ℝ := (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
    have hM_pos_real : 0 < (M : ℝ) := by
      exact_mod_cast hM
    have hA_pos : 0 < A := by
      dsimp [A]
      exact Real.rpow_pos_of_pos hM_pos_real _
    have hsqrt_nonneg' : 0 ≤ Real.sqrt (d : ℝ) := Real.sqrt_nonneg _
    have hMpow_nonneg : 0 ≤ (M : ℝ).rpow (-2 : ℝ) :=
      le_of_lt (Real.rpow_pos_of_pos hM_pos_real (-2 : ℝ))
