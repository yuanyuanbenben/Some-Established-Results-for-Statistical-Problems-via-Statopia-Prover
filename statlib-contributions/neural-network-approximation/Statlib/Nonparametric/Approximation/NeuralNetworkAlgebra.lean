        (∀ q : Fin d, |x q - center q| ≤ R) →
        ‖x - center‖ ≤ rho →
          |N.realize x - f x| ≤
            ε + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
  have h_s1 :
      ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤
          (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
            (a.1.val + 1)) + 1 ∧
        ∀ x : Fin d → ℝ,
          (∀ q : Fin d, |x q - center q| ≤ R) →
            |N.realize x -
                finiteLinearCombination Finset.univ
                  (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
                    (Nat.factorial a.fst.val : ℝ)⁻¹ *
                      (iteratedFDeriv ℝ a.fst.val f center)
                        fun q j => if j = a.snd q then 1 else 0)
                  (fun a y => ∏ q, (y (a.snd q) - center (a.snd q)))
                  x| ≤ ε := by
    exact exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_approx_on_box_with_depth_bound
      (ι := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))
      hd hR hε center Finset.univ
      (fun a => (Nat.factorial a.fst.val : ℝ)⁻¹ *
        (iteratedFDeriv ℝ a.fst.val f center) (fun q j => if j = a.snd q then 1 else 0))
      (fun a => a.fst.val)
      (fun a q => a.snd q)
  have h_s2 :
      ∀ x : Fin d → ℝ,
        ‖x - center‖ ≤ rho →
