          cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) * A := by
      have hmul : (Real.sqrt (d : ℝ) * (M : ℝ).rpow (-2 : ℝ)).rpow
            ((r : ℝ) + beta) =
          (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) *
            ((M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta) :=
        Real.mul_rpow hsqrt_nonneg' hMpow_nonneg
      have hcomp : ((M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta) = A := by
        dsimp [A]
        have h1 : ((M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta) =
            (M : ℝ).rpow ((-2 : ℝ) * ((r : ℝ) + beta)) :=
          (Real.rpow_mul (le_of_lt hM_pos_real) (-2 : ℝ) ((r : ℝ) + beta)).symm
        exact h1.trans (by
          congr 1
          ring)
      calc
        cTaylor * (Real.sqrt (d : ℝ) * (M : ℝ).rpow (-2 : ℝ)).rpow
              ((r : ℝ) + beta)
            = cTaylor *
                ((Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) *
                  ((M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta)) := by
              rw [hmul]
        _ = cTaylor * ((Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) * A) := by
              rw [hcomp]
        _ = cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) * A := by
              ring
    have hbound : |g x - f x| ≤ cErr0 * A := by
      calc
        |g x - f x| ≤
            cTaylor * (Real.sqrt (d : ℝ) * (M : ℝ).rpow (-2 : ℝ)).rpow
                ((r : ℝ) + beta) +
              cQuant * A + cDecoder * A + cSelector * A := by
          simpa [A] using hg_err x hx
        _ = cErr0 * A := by
          rw [hfirst]
          dsimp [cErr0]
          ring
    have hcErr0_le : cErr0 ≤ cErr := by
      dsimp [cErr]
      linarith
    exact le_trans hbound (mul_le_mul_of_nonneg_right hcErr0_le (le_of_lt hA_pos))

/-- Absorb the one-extra-serial-stage overhead into a fixed per-block depth budget.

This is the arithmetic normalization needed to turn a construction depth
`D ≤ (M^d + 1) * (Dprod + 1)` into the paper-style exact envelope
`D ≤ M^d * (Dblock + 1)` by choosing the fixed block budget large enough.
-/
theorem fixed_width_block_depth_padding_from_subblock_depth_bound
    {d M D Dprod Dblock : ℕ}
    (hM : 0 < M)
    (hD : D ≤ (M ^ d + 1) * (Dprod + 1))
    (hsub : 2 * (Dprod + 1) ≤ Dblock + 1) :
    D ≤ M ^ d * (Dblock + 1) := by
  have hMpow1 : 1 ≤ M ^ d := Nat.succ_le_iff.mpr (pow_pos hM d)
  have hstep : (M ^ d + 1) * (Dprod + 1) ≤ M ^ d * (Dblock + 1) := by
    nlinarith [hMpow1, hsub]
  exact le_trans hD hstep

/-- Construct the paper-style block schedule from explicit box-selector geometry and
component error budgets.

The conclusion is exactly the `hblock` premise consumed by
`holder_smooth_ball_unit_cube_lw2_rate_from_block_schedule`, except that this
theorem also returns the fixed width, block-depth budget, and component constants.
The remaining hypothesis `hschedule` is geometric/combinatorial: for each scale
`M` it supplies centers, box ramps, local/product budgets, and a depth-padding
budget.  The network assembly itself is discharged through the promoted local
Holder table, selector-product, and serial-sum theorems.
-/
private theorem exists_block_schedule_from_box_selector_budget_schedule
    {d r Wmul : ℕ} (hd : 0 < d) (hWmul : 0 < Wmul)
    {beta C B cMulDepth cMulErr : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC_nonneg : 0 ≤ C) (hB_nonneg : 0 ≤ B)
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (hschedule :
      ∀ Wlocal W0 : ℕ,
        0 < Wlocal →
        Wlocal =
          finiteCenteredMonomialPolynomialFixedWidthBound Wmul
            (Finset.univ :
              Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) →
        0 < W0 →
        W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 →
        ∀ cLocalDepth : ℝ, 0 < cLocalDepth →
        ∀ A : ℝ, 0 ≤ A →
          ∃ Dblock : ℕ, 0 < Dblock ∧
          ∃ cTaylor cQuant cDecoder cSelector : ℝ,
            0 ≤ cTaylor ∧ 0 ≤ cQuant ∧
            0 ≤ cDecoder ∧ 0 ≤ cSelector ∧
            ∀ M : ℕ, 0 < M →
              ∃ R rho localEps productRadius productDelta Rbox : ℝ,
              ∃ nLocal nMul : ℕ,
              ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
                0 ≤ rho ∧
                0 < R ∧
                0 < Rbox ∧
                0 < productRadius ∧
                1 ≤ productRadius ∧
                0 < nLocal ∧
                0 < nMul ∧
                cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤
                  productDelta ∧
                0 ≤ productDelta ∧
                A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                  + C / (Nat.factorial r : ℝ) *
                      Real.rpow rho ((r : ℝ) + beta) ≤
                    localEps ∧
                A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                  + A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      R ^ a.1.val) ≤
                    productRadius ∧
                (∑ _ : Fin (M ^ d), productDelta) + localEps ≤
                  cTaylor *
                      (Real.sqrt (d : ℝ) *
                        (M : ℝ).rpow (-2 : ℝ)).rpow
                          ((r : ℝ) + beta)
                    + cQuant *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cDecoder *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cSelector *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) ∧
                (∀ j : Fin (M ^ d), ∀ q : Fin d,
                  center j q ∈ Set.Icc (0 : ℝ) 1) ∧
                (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  ∀ q : Fin d, |x q - center j q| ≤ R) ∧
                (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  (∀ q : Fin d,
                    scale j q *
                      (relu (x q - center j q) + relu (center j q - x q)) < 1) →
                  ‖x - center j‖ ≤ rho) ∧
                (∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  ∃ j0 : Fin (M ^ d),
                    axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
                    (∀ j : Fin (M ^ d), j ≠ j0 →
                      axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
                    (∀ q : Fin d,
                      scale j0 q *
                        (relu (x q - center j0 q) +
                          relu (center j0 q - x q)) < 1)) ∧
                (∀ Dlocal Dprod D : ℕ,
                  0 < Dlocal →
                  (Dlocal : ℝ) ≤ cLocalDepth * ((nLocal : ℝ) + 1) →
                  0 < Dprod →
                  (Dprod : ℝ) ≤
                    (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) →
                  D ≤ (M ^ d + 1) * (Dprod + 1) →
                  D ≤ M ^ d * (Dblock + 1))) :
    ∃ W0 Dblock : ℕ,
      0 < W0 ∧ 0 < Dblock ∧
      ∃ cTaylor cQuant cDecoder cSelector : ℝ,
        0 ≤ cTaylor ∧ 0 ≤ cQuant ∧
        0 ≤ cDecoder ∧ 0 ≤ cSelector ∧
        ∀ M : ℕ, 0 < M →
          ∃ D P : ℕ,
            D = (M ^ d) * (Dblock + 1) ∧
            0 < D ∧
            P = fullyConnectedReLUParameterCount d D W0 ∧
            ∀ f : (Fin d → ℝ) → ℝ,
              f ∈ holderSmoothBall r beta C B →
              ∃ g : (Fin d → ℝ) → ℝ,
                g ∈ reluNetworkClass d D W0 P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  |g x - f x| ≤
                    cTaylor *
                        (Real.sqrt (d : ℝ) *
                          (M : ℝ).rpow (-2 : ℝ)).rpow
                            ((r : ℝ) + beta)
                      + cQuant *
                          (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                      + cDecoder *
                          (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                      + cSelector *
                          (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
  -- s1: apply [E7] once to the m-independent monomial family to obtain the fixed
  -- local width and a cell-count-independent local-depth coefficient (uniform over
  -- every cell count m, every resolution nLocal, and every center)
  obtain ⟨Wlocal, hWlocal_pos, hWlocal_eq, cDepthU, hcDepthU_pos, hE7⟩ :=
    exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_uniform_coeff_bound_from_mul_gadget
      (ι := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))
      (d := d) (Wmul := Wmul) hWmul
      (cMulDepth := cMulDepth) (cMulErr := cMulErr) hcMulDepth hcMulErr hmul
      Finset.univ (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => a.1.val)
      (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => a.2)
  let W0 : ℕ := 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3
  have hW0_pos : 0 < W0 := by
    dsimp [W0]
    positivity
  have hW0_eq : W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 := rfl
  -- s2: obtain the uniform Taylor-coefficient bound A from [E10]
  obtain ⟨A, hA_nonneg, hA_coeff⟩ :=
    holderSmoothBall_unitCube_taylor_coefficients_admit_uniform_bound d r
      (beta := beta) (C := C) (B := B) hbeta_nonneg hC_nonneg hB_nonneg
  -- s3: instantiate the schedule hypothesis with Wlocal, W0, the UNIFORM coefficient cDepthU, A
  obtain ⟨Dblock, hDblock_pos, cTaylor, cQuant, cDecoder, cSelector,
      hcTaylor_nonneg, hcQuant_nonneg, hcDecoder_nonneg, hcSelector_nonneg, hscheduleM⟩ :=
    hschedule Wlocal W0 hWlocal_pos hWlocal_eq hW0_pos hW0_eq cDepthU hcDepthU_pos A hA_nonneg
  -- assemble the outer existentials; the per-scale network assembly remains
  refine ⟨W0, Dblock, hW0_pos, hDblock_pos,
    cTaylor, cQuant, cDecoder, cSelector,
    hcTaylor_nonneg, hcQuant_nonneg, hcDecoder_nonneg, hcSelector_nonneg, ?_⟩
  intro M hM
  -- s4: rcases the per-scale schedule instance for M
  obtain ⟨R, rho, localEps, productRadius, productDelta, Rbox, nLocal, nMul, center, scale, lower, upper,
      hrho_nonneg, hR_pos, hRbox_pos, hproductRadius_pos, hproductRadius_ge_one, hnLocal_pos, hnMul_pos,
      hproductDelta_ge, hproductDelta_nonneg, hlocalEps_chain, hproductRadius_chain, hrate_chain,
      hcenter_mem, hlocal_radius, htent_radius, hbox_partition, hdepth_clause⟩ := hscheduleM M hM
  -- s5: define the four-term rate as the error budget for this scale
  let eps : ℝ :=
    cTaylor * (Real.sqrt (d : ℝ) * (M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta)
      + cQuant * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
      + cDecoder * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
      + cSelector * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
  -- s5 (rest): re-apply the box-selector assembly theorem at m := M^d with the schedule data
  let D' : ℕ := (M ^ d) * (Dblock + 1)
  -- s7-s8: assemble the per-scale existentials; the network assembly runs per f
  refine ⟨D', fullyConnectedReLUParameterCount d D' W0, rfl, ?hDpos, rfl, ?_⟩
  · dsimp [D']
    positivity
  · intro f hf
    -- coefficient bound at centers for this f: instantiate the uniform Taylor bound from [E10] at y := center j
    have hcoeff_centers :
        ∀ j : Fin (M ^ d),
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f (center j))
                  (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A := by
      intro j a
      exact hA_coeff f hf (center j) (hcenter_mem j) a
    -- per-cell local-depth witnesses from [E7] at each center (uniform cDepthU bound)
    let coeffAt : Fin (M ^ d) → (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) → ℝ :=
      fun j a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
        (iteratedFDeriv ℝ a.1.val f (center j))
          (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
    have hcoeffAt_bound : ∀ j : Fin (M ^ d),
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), |coeffAt j a| ≤ A := by
      intro j a
      dsimp [coeffAt]
      exact hcoeff_centers j a
    have hpercell : ∀ j : Fin (M ^ d),
        ∃ D P : ℕ,
          0 < D ∧ (D : ℝ) ≤ cDepthU * ((nLocal : ℝ) + 1) ∧
          P = fullyConnectedReLUParameterCount d D Wlocal ∧
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d D Wlocal P ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center j q| ≤ R) →
              |g x - finiteLinearCombination Finset.univ (coeffAt j)
                  (fun i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
                    fun y : Fin d → ℝ => ∏ q : Fin i.1.val, (y (i.2 q) - center j (i.2 q))) x| ≤
                A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  centeredMonomialFixedWidthApproxError cMulErr R nLocal i.1.val) := by
      intro j
      exact hE7 (coeffAt j) A R hA_nonneg hR_pos
        (fun i hi => hcoeffAt_bound j i) nLocal hnLocal_pos (center j)
    choose Dcell Pcell hDcell using hpercell
    have hDcell_pos : ∀ j : Fin (M ^ d), 0 < Dcell j := fun j => (hDcell j).1
    have hDcell_bound : ∀ j : Fin (M ^ d),
        (Dcell j : ℝ) ≤ cDepthU * ((nLocal : ℝ) + 1) := fun j => (hDcell j).2.1
    have hDcell_P : ∀ j : Fin (M ^ d),
        Pcell j = fullyConnectedReLUParameterCount d (Dcell j) Wlocal := fun j => (hDcell j).2.2.1
    have hgcell : ∀ j : Fin (M ^ d),
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d (Dcell j) Wlocal (Pcell j) ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center j q| ≤ R) →
            |g x - finiteLinearCombination Finset.univ (coeffAt j)
                (fun i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
                  fun y : Fin d → ℝ => ∏ q : Fin i.1.val, (y (i.2 q) - center j (i.2 q))) x| ≤
              A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R nLocal i.1.val) := by
      intro j
      exact (hDcell j).2.2.2
    choose gcell hgcell' using hgcell
    -- common local depth: maximum of the per-cell [E7] witnesses (uniform cDepthU bound)
    let Dlocal : ℕ := (Finset.univ : Finset (Fin (M ^ d))).sup Dcell
    have hMd_pos : 0 < M ^ d := by positivity
    haveI : Nonempty (Fin (M ^ d)) := ⟨0, hMd_pos⟩
    have hDlocal_pos : 0 < Dlocal := by
      dsimp [Dlocal]
      obtain ⟨i, -, hi_eq⟩ :=
        Finset.exists_mem_eq_sup (Finset.univ : Finset (Fin (M ^ d))) Finset.univ_nonempty Dcell
      rw [hi_eq]
      exact hDcell_pos i
    have hDlocal_bound : (Dlocal : ℝ) ≤ cDepthU * ((nLocal : ℝ) + 1) := by
      dsimp [Dlocal]
      obtain ⟨i, -, hi_eq⟩ :=
        Finset.exists_mem_eq_sup (Finset.univ : Finset (Fin (M ^ d))) Finset.univ_nonempty Dcell
      rw [hi_eq]
      exact hDcell_bound i
    have hDcell_le_Dlocal : ∀ j : Fin (M ^ d), Dcell j ≤ Dlocal := by
      intro j
      dsimp [Dlocal]
      exact Finset.le_sup (Finset.mem_univ j)
    -- E9's own returned width W0' agrees with the fixed width W0 from s1
    let W0' : ℕ := W0
    have hW0'_eq_W0 : W0' = W0 := rfl
    -- bottom-half assembly: E17 local products at the common budget (Dlocal, Plocal) and
    -- E19 box-selector serial with the schedule's product/local error + partition clauses.
    -- The E7-chosen Dlocal carries the depth-clause bound hDlocal_bound; the remaining
    -- error/depth clauses come from the schedule instance as in the old [E9] path.
    have hassembled :
        ∃ Dprod D P : ℕ,
          0 < Dprod ∧
          (Dprod : ℝ) ≤ (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) ∧
          D ≤ (M ^ d + 1) * (Dprod + 1) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d D W0 P ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → |g x - f x| ≤ eps := by
      let Plocal : ℕ := fullyConnectedReLUParameterCount d Dlocal Wlocal
      let poly : (Fin (M ^ d)) → (Fin d → ℝ) → ℝ :=
        fun j x => finiteLinearCombination Finset.univ (coeffAt j)
          (fun i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => fun y : Fin d → ℝ =>
            ∏ q : Fin i.1.val, (y (i.2 q) - center j (i.2 q))) x
      have hParamCount_mono : ∀ {a b : ℕ}, a ≤ b →
          fullyConnectedReLUParameterCount d a Wlocal ≤ fullyConnectedReLUParameterCount d b Wlocal := by
        intro a b hab
        unfold fullyConnectedReLUParameterCount
        exact Nat.add_le_add_right
          (Nat.add_le_add_left
            (Nat.mul_le_mul_right ((Wlocal + 1) * Wlocal) (Nat.sub_le_sub_right hab 1))
            ((d + 1) * Wlocal))
          (Wlocal + 1)
      have hglift : ∀ j : Fin (M ^ d), gcell j ∈ reluNetworkClass d Dlocal Wlocal Plocal := by
        intro j
        rcases (hgcell' j).1 with ⟨N, hNpos, hNdepth_le, hNwidth_le, hNparam_le, hNrealize⟩
        refine ⟨N, hNpos, le_trans hNdepth_le (hDcell_le_Dlocal j), hNwidth_le, ?_, hNrealize⟩
        calc
          N.parameterCount ≤ Pcell j := hNparam_le
          _ = fullyConnectedReLUParameterCount d (Dcell j) Wlocal := hDcell_P j
          _ ≤ fullyConnectedReLUParameterCount d Dlocal Wlocal := hParamCount_mono (hDcell_le_Dlocal j)
          _ = Plocal := rfl
      have hmono_abs : ∀ (j : Fin (M ^ d)) (i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))
          (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
          |∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q))| ≤ R ^ i.1.val := by
        intro j i x hcoord
        calc
          |∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q))|
              = ∏ q : Fin i.1.val, |x (i.2 q) - center j (i.2 q)| := by
                rw [Finset.abs_prod]
          _ ≤ ∏ q : Fin i.1.val, R := by
                refine Finset.prod_le_prod ?_ ?_
                · intro q hq
                  exact abs_nonneg _
                · intro q hq
                  exact hcoord (i.2 q)
          _ = R ^ i.1.val := by
                simp
      have hpoly_abs : ∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
          (∀ q : Fin d, |x q - center j q| ≤ R) →
          |poly j x| ≤ A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ i.1.val) := by
        intro j x hcoord
        calc
          |poly j x|
              ≤ ∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  |coeffAt j i * (∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q)))| := by
                simp [poly, finiteLinearCombination]
                simpa [abs_mul] using
                  Finset.abs_sum_le_sum_abs
                    (fun i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
                      coeffAt j i * (∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q))))
                    Finset.univ
          _ ≤ ∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), A * R ^ i.1.val := by
                apply Finset.sum_le_sum
                intro i hi
                rw [abs_mul]
                calc
                  |coeffAt j i| * |∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q))|
                      ≤ A * |∏ q : Fin i.1.val, (x (i.2 q) - center j (i.2 q))| :=
                        mul_le_mul_of_nonneg_right (hcoeffAt_bound j i) (abs_nonneg _)
                  _ ≤ A * R ^ i.1.val :=
                        mul_le_mul_of_nonneg_left (hmono_abs j i x hcoord) hA_nonneg
          _ = A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ i.1.val) := by
                rw [Finset.mul_sum]
      have hgcell_out : ∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
          (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → |gcell j x| ≤ productRadius := by
        intro j x hx
        have hcoord : ∀ q : Fin d, |x q - center j q| ≤ R := hlocal_radius j x hx
        calc
          |gcell j x| = |poly j x + (gcell j x - poly j x)| := by
                congr 1
                ring
          _ ≤ |poly j x| + |gcell j x - poly j x| := abs_add_le _ _
          _ ≤ A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ i.1.val)
                + A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal i.1.val) :=
                add_le_add (hpoly_abs j x hcoord) ((hgcell' j).2 x hcoord)
          _ = A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal i.1.val)
                + A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ i.1.val) := by
                rw [add_comm]
          _ ≤ productRadius := hproductRadius_chain
      have hactive : ∀ (x : Fin d → ℝ), (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
          ∃ j0 : Fin (M ^ d),
            axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
            (∀ j : Fin (M ^ d), j ≠ j0 → axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
            |gcell j0 x - f x| ≤ localEps := by
        intro x hx
        rcases hbox_partition x hx with ⟨j0, hramp1, hramp0, htent1⟩
        refine ⟨j0, hramp1, hramp0, ?_⟩
        have hrho : ‖x - center j0‖ ≤ rho := htent_radius j0 x hx htent1
        have hcoord : ∀ q : Fin d, |x q - center j0 q| ≤ R := hlocal_radius j0 x hx
        have hpoly_taylor : |f x - poly j0 x| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
          have hE20 := holderSmoothBall_taylor_remainder_bound_on_box (d := d) (r := r) (beta := beta)
            (C := C) (B := B) (rho := rho) hbeta_nonneg hC_nonneg hrho_nonneg f hf (center j0) x hrho
          rw [taylor_polynomial_as_finite_centered_coordinate_polynomial f (center j0) x] at hE20
          simpa [poly, coeffAt] using hE20
        calc
          |gcell j0 x - f x| = |(gcell j0 x - poly j0 x) + (poly j0 x - f x)| := by
                rw [show gcell j0 x - f x = (gcell j0 x - poly j0 x) + (poly j0 x - f x) by ring]
          _ ≤ |gcell j0 x - poly j0 x| + |poly j0 x - f x| := abs_add_le _ _
          _ ≤ A * (∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal i.1.val)
                + (C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta)) := by
                exact add_le_add ((hgcell' j0).2 x hcoord) (by rw [abs_sub_comm]; exact hpoly_taylor)
          _ ≤ localEps := hlocalEps_chain
      obtain ⟨Dprod, Pprod, hDprod_pos, hDprod_bound, hPprod_eq, productApprox, hproductApprox_mem,
          hproductApprox_err⟩ :=
        finite_axisAlignedBoxIndicatorRamp_local_products_fixed_width_depth_sum_bound
          (d := d) (m := M ^ d) (Dlocal := Dlocal) (Wlocal := Wlocal) (Plocal := Plocal) (Wmul := Wmul)
          hDlocal_pos hWlocal_pos hWmul
          (Rbox := Rbox) (cMulDepth := cMulDepth) (cMulErr := cMulErr)
          (productRadius := productRadius) (productDelta := productDelta)
          hRbox_pos hcMulDepth hcMulErr hproductRadius_pos hproductRadius_ge_one
          nMul hnMul_pos hproductDelta_ge hmul
          (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
          lower upper gcell hglift hgcell_out
      let Wprod : ℕ := Wlocal + (2 * d + 1) + Wmul
      have hWprod_pos : 0 < Wprod := by
        dsimp [Wprod]
        omega
      have hWprod_eq : 2 * d + Wprod + 3 = W0 := by
        exact hW0_eq.symm
      obtain ⟨D, P, hD_pos, hD_serial, hP_eq, g, hg_mem, hg_err⟩ :=
        finite_axisAlignedBoxIndicatorRamp_selector_reluNetworkClass_serial_fixed_width_global_error_bound
          (d := d) (m := M ^ d) (Dprod := Dprod) (Wprod := Wprod) (Pprod := Pprod)
          hDprod_pos hWprod_pos
          (Rbox := Rbox) (productDelta := productDelta) (localEps := localEps)
          hproductDelta_nonneg lower upper gcell f productApprox
          (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
          hproductApprox_mem hproductApprox_err hactive
      rw [hWprod_eq] at hP_eq hg_mem
      refine ⟨Dprod, D, P, hDprod_pos, hDprod_bound, hD_serial, hP_eq, g, hg_mem, ?_⟩
      intro x hx
      calc
        |g x - f x| ≤ (∑ j : Fin (M ^ d), productDelta) + localEps := hg_err x hx
        _ ≤ eps := hrate_chain
    obtain ⟨Dprod, D, P, hDprod_pos, hDprod_bound, hD_serial, hP_eq, hg_approx⟩ := hassembled
    -- s6: apply the per-scale depth clause to conclude D ≤ M ^ d * (Dblock + 1) = D'
    have hD_le_D' : D ≤ D' := by
      dsimp [D']
      -- the depth clause's structural premises are discharged by the E7-threaded
      -- assembly; the local-depth premise is exactly the E7 uniform bound:
      have hDlocal_bound_fixed : (Dlocal : ℝ) ≤ cDepthU * ((nLocal : ℝ) + 1) := by
        exact hDlocal_bound
      exact hdepth_clause Dlocal Dprod D hDlocal_pos hDlocal_bound_fixed hDprod_pos hDprod_bound hD_serial
    -- parameter-count monotonicity in depth at fixed width
    have hP_mono : fullyConnectedReLUParameterCount d D W0 ≤ fullyConnectedReLUParameterCount d D' W0 := by
      unfold fullyConnectedReLUParameterCount
      have hsub : D - 1 ≤ D' - 1 := Nat.sub_le_sub_right hD_le_D' 1
      have hmul : (D - 1) * ((W0 + 1) * W0) ≤ (D' - 1) * ((W0 + 1) * W0) :=
        Nat.mul_le_mul_right ((W0 + 1) * W0) hsub
      omega
    -- lift the witness to the exact target depth D' and close the per-scale existentials
    obtain ⟨g, hg_class, hg_err⟩ := hg_approx
    refine ⟨g, ?_, hg_err⟩
    rcases hg_class with ⟨N, hN_pos, hN_depth, hN_width, hN_param, hN_realize⟩
    refine ⟨N, hN_pos, le_trans hN_depth hD_le_D', by simpa [hW0'_eq_W0] using hN_width, ?_, hN_realize⟩
    exact le_trans hN_param (by
      rw [hP_eq]
      exact hP_mono)

/-- Final display-rate wrapper from the explicit paper box-selector schedule.

This theorem removes the raw `hblock` premise of
`holder_smooth_ball_unit_cube_lw2_rate_from_block_schedule` by invoking the
promoted schedule-to-block theorem.  It remains conditional on the fixed-width
multiplication gadget and on the explicit geometric/scalar `hschedule`.
-/
theorem holderSmoothBall_unitCube_LW2_rate_from_box_selector_budget_schedule
    {d r Wmul : ℕ} (hd : 0 < d) (hWmul : 0 < Wmul)
    {beta C B cMulDepth cMulErr : ℝ}
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC_nonneg : 0 ≤ C) (hB_nonneg : 0 ≤ B)
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (hschedule :
      ∀ Wlocal W0 : ℕ,
        0 < Wlocal →
        Wlocal =
          finiteCenteredMonomialPolynomialFixedWidthBound Wmul
            (Finset.univ :
              Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) →
        0 < W0 →
        W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 →
        ∀ cLocalDepth : ℝ, 0 < cLocalDepth →
        ∀ A : ℝ, 0 ≤ A →
          ∃ Dblock : ℕ, 0 < Dblock ∧
          ∃ cTaylor cQuant cDecoder cSelector : ℝ,
            0 ≤ cTaylor ∧ 0 ≤ cQuant ∧
            0 ≤ cDecoder ∧ 0 ≤ cSelector ∧
            ∀ M : ℕ, 0 < M →
              ∃ R rho localEps productRadius productDelta Rbox : ℝ,
              ∃ nLocal nMul : ℕ,
              ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
                0 ≤ rho ∧
                0 < R ∧
                0 < Rbox ∧
                0 < productRadius ∧
                1 ≤ productRadius ∧
                0 < nLocal ∧
                0 < nMul ∧
                cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤
                  productDelta ∧
                0 ≤ productDelta ∧
                A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                  + C / (Nat.factorial r : ℝ) *
                      Real.rpow rho ((r : ℝ) + beta) ≤
                    localEps ∧
                A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                  + A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      R ^ a.1.val) ≤
                    productRadius ∧
                (∑ _ : Fin (M ^ d), productDelta) + localEps ≤
                  cTaylor *
                      (Real.sqrt (d : ℝ) *
                        (M : ℝ).rpow (-2 : ℝ)).rpow
                          ((r : ℝ) + beta)
                    + cQuant *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cDecoder *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                    + cSelector *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) ∧
                (∀ j : Fin (M ^ d), ∀ q : Fin d,
                  center j q ∈ Set.Icc (0 : ℝ) 1) ∧
