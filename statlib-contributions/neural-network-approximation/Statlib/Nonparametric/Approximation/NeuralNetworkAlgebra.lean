        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ q : Fin d, |x q - center j q| ≤ 1) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin ((K + 1) ^ d),
          Statlib.Nonparametric.Vocabulary.axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (Statlib.Nonparametric.Vocabulary.relu (x q - center j q) +
            Statlib.Nonparametric.Vocabulary.relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (Statlib.Nonparametric.Vocabulary.relu (x q - center j q) +
            Statlib.Nonparametric.Vocabulary.relu (center j q - x q)) < 1) →
        ‖x - center j‖ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: Construct grid-indexed witnesses center j q = (idx j q : ℝ)/K and scale j q = K; prove 0 ≤ scale j q and center j q ∈ Set.Icc 0 1 for all j,q.
  -- (retry 7: previous failures were missing RKHS .olean build artifacts; skeleton text unchanged — env should be rebuilt)
  have h_s1 : ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d), 0 ≤ scale j q) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d),
        center j q ∈ Set.Icc (0 : ℝ) 1) := by
          let idx : Fin ((K + 1) ^ d) ≃ (Fin d → Fin (K + 1)) := by
            simpa [Fintype.card_fun, Fintype.card_fin] using (Fintype.equivFin (Fin d → Fin (K + 1))).symm
          let center : Fin ((K + 1) ^ d) → Fin d → ℝ :=
            fun j q => ((idx j q : ℕ) : ℝ) / (K : ℝ)
          let scale : Fin ((K + 1) ^ d) → Fin d → ℝ :=
            fun _ _ => (K : ℝ)
