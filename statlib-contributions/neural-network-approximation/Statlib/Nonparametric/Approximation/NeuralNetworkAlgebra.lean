  -- @step s3: For every x with x q ∈ Set.Icc 0 1 for all q, ∑ j, axisAlignedBoxTentWeight (center j) (scale j) x = 1.
  have h_s3 : ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d), 0 ≤ scale j q) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d),
        center j q ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
