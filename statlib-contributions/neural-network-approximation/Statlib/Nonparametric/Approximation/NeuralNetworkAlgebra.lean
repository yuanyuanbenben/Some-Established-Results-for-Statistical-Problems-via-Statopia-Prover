/-- The fully universal selector-geometry oracle used as an explicit premise in
the previous wrapper is too strong.

The obstruction already appears in the coarse-radius clause: if the oracle is
required for every positive `R`, choose `M = 1` and a radius smaller than
`1 / 2`.  A single center cannot be within that radius of both endpoint points
of a nontrivial unit-cube coordinate.  This theorem is a route-correction guard:
future final theorems should use a narrowed, genuinely constructible selector
schedule rather than trying to prove this universal premise.
-/
theorem not_forall_unitCube_two_scale_box_selector_geometry
    {d : ℕ} (hd : 0 < d) :
    ¬ (∀ M : ℕ, 0 < M →
      ∀ R rho Rbox : ℝ,
        0 ≤ rho →
        0 < R →
        0 < Rbox →
          ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
            (∀ j : Fin (M ^ d), ∀ q : Fin d,
              center j q ∈ Set.Icc (0 : ℝ) 1) ∧
            (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              ∀ q : Fin d, |x q - center j q| ≤ R) ∧
            (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              (∀ q : Fin d,
                scale j q *
                  (relu (x q - center j q) + relu (center j q - x q)) < 1) →
              ‖x - center j‖ ≤ rho) ∧
            (∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              ∃ j0 : Fin (M ^ d),
                axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
                (∀ j : Fin (M ^ d), j ≠ j0 →
                  axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
                (∀ q : Fin d,
                  scale j0 q *
                    (relu (x q - center j0 q) +
                      relu (center j0 q - x q)) < 1))) := by
  -- Proof route:
  -- take `M = 1`, `R = 1/3`, `rho = 0`, `Rbox = 1`.  Pick a coordinate
  -- `q0 : Fin d`; for the unique grid index, apply the coarse-radius property
  -- to the two unit-cube points with coordinate `q0` equal to `0` and `1`.
  -- The two inequalities imply `1 <= 2/3`, a contradiction.
  intro H
  let q0 : Fin d := ⟨0, hd⟩
  have hinst := H 1 (by norm_num) (1 / 3 : ℝ) 0 1 (by norm_num) (by norm_num) (by norm_num)
  rcases hinst with ⟨center, scale, lower, upper, hcenter, hcoarse, hscale, hbox⟩
  let j0 : Fin (1 ^ d) := ⟨0, by simp⟩
  let x0 : Fin d → ℝ := fun _ => 0
  let x1 : Fin d → ℝ := fun q => if q = q0 then 1 else 0
  have hx0 : ∀ q : Fin d, x0 q ∈ Set.Icc (0 : ℝ) 1 := by
    intro q
    norm_num [x0]
  have hx1 : ∀ q : Fin d, x1 q ∈ Set.Icc (0 : ℝ) 1 := by
    intro q
    by_cases h : q = q0
    · norm_num [x1, h]
    · norm_num [x1, h]
  have hc0 : |center j0 q0| ≤ (1 / 3 : ℝ) := by
    simpa [x0] using hcoarse j0 x0 hx0 q0
  have hc1 : |1 - center j0 q0| ≤ (1 / 3 : ℝ) := by
    simpa [x1] using hcoarse j0 x1 hx1 q0
  have hc0a : center j0 q0 ≤ (1 / 3 : ℝ) := (abs_le.mp hc0).2
  have hc1a : 1 - center j0 q0 ≤ (1 / 3 : ℝ) := (abs_le.mp hc1).2
  have hle : (1 : ℝ) ≤ (1 / 3 : ℝ) + (1 / 3 : ℝ) := by
    linarith
  exact (by norm_num : ¬ (1 : ℝ) ≤ (1 / 3 : ℝ) + (1 / 3 : ℝ)) hle

/-- Finite bounded real table quantization with half-integer gap readouts:
the half-integer readout points are exactly where the truncated-floor ReLU decoder is stable. -/
theorem finite_bounded_real_table_gap_base_code
    {ι : Type*} [Fintype ι] {N Q base : ℕ} {R : ℝ}
    (e : ι ≃ Fin N) {A eta : ℝ}
    (hA : 0 ≤ A) (heta : 0 < eta) (hQ : 0 < Q)
    (hmesh : 2 * A / (Q : ℝ) ≤ eta)
    (hbase : Q + 1 ≤ base)
    (hR : 2 ≤ R)
    (table : ι → ℝ)
    (htable : ∀ i : ι, |table i| ≤ A) :
    ∃ digit : Fin N → ℕ,
      (∀ k : Fin N, digit k ≤ Q) ∧
      (∀ k : Fin N, digit k < base) ∧
      ∃ code floorBound : ℕ,
        code = ∑ k : Fin N, digit k * base ^ k.val ∧
        floorBound = code + 1 ∧
        (∀ k : Fin N,
          let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
          0 ≤ readout ∧
            readout < (floorBound : ℝ) + 1 ∧
            Statlib.Nonparametric.Vocabulary.awayFromFiniteIntegerGrid R floorBound readout ∧
            Nat.floor readout = code / base ^ k.val ∧
            Nat.floor readout % base = digit k) ∧
        ∃ decoded : ι → ℝ,
          (∀ i : ι,
            decoded i = -A + (2 * A / (Q : ℝ)) * (digit (e i) : ℝ)) ∧
          (∀ i : ι, |decoded i - table i| ≤ eta) ∧
          (∀ i : ι, |decoded i| ≤ A + eta) := by
  rcases finite_bounded_real_table_quantization_and_base_code e hA heta hQ hmesh hbase table htable with
    ⟨digit, hdigit_le, hdigit_lt, ⟨code, hcode, hdigit_rec⟩,
      ⟨decoded, hdecoded_eq, hdecoded_approx, hdecoded_bound⟩⟩
  refine ⟨digit, hdigit_le, hdigit_lt, ?_⟩
  refine ⟨code, code + 1, hcode, rfl, ?_, decoded, hdecoded_eq, hdecoded_approx, hdecoded_bound⟩
  intro k
  let q : ℕ := code / base ^ k.val
  change 0 ≤ (q : ℝ) + (1 / 2 : ℝ) ∧
      (q : ℝ) + (1 / 2 : ℝ) < (((code + 1 : ℕ) : ℝ) + 1) ∧
      Statlib.Nonparametric.Vocabulary.awayFromFiniteIntegerGrid R (code + 1)
        ((q : ℝ) + (1 / 2 : ℝ)) ∧
      Nat.floor ((q : ℝ) + (1 / 2 : ℝ)) = code / base ^ k.val ∧
      Nat.floor ((q : ℝ) + (1 / 2 : ℝ)) % base = digit k
  have hqnonneg : (0 : ℝ) ≤ (q : ℝ) := by
    exact_mod_cast (Nat.zero_le q)
  have hreadout_nonneg : 0 ≤ (q : ℝ) + (1 / 2 : ℝ) := by linarith
  have hqle_code : (q : ℝ) ≤ (code : ℝ) := by
    have hqle : q ≤ code := by
      dsimp [q]
      exact Nat.div_le_self code (base ^ k.val)
    exact_mod_cast hqle
  have hreadout_lt : (q : ℝ) + (1 / 2 : ℝ) < (((code + 1 : ℕ) : ℝ) + 1) := by
    have hcast : (((code + 1 : ℕ) : ℝ) + 1) = (code : ℝ) + 2 := by
      push_cast
      ring
    rw [hcast]
    linarith
  have hfloor : Nat.floor ((q : ℝ) + (1 / 2 : ℝ)) = q := by
    exact (Nat.floor_eq_iff hreadout_nonneg).2 ⟨by linarith, by linarith⟩
  have hRinv : R⁻¹ ≤ (1 / 2 : ℝ) := by
    simpa [one_div] using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hR
  constructor
  · exact hreadout_nonneg
  constructor
  · exact hreadout_lt
  constructor
  · change ∀ j ∈ Finset.Icc 1 (code + 1), R⁻¹ ≤ |(q : ℝ) + (1 / 2 : ℝ) - (j : ℝ)|
    intro j hj
    by_cases hjq : (j : ℝ) ≤ (q : ℝ)
    · have hnonneg : 0 ≤ (q : ℝ) + (1 / 2 : ℝ) - (j : ℝ) := by linarith
      have hle : (1 / 2 : ℝ) ≤ (q : ℝ) + (1 / 2 : ℝ) - (j : ℝ) := by linarith
      rw [abs_of_nonneg hnonneg]
      exact le_trans hRinv hle
    · have hlt : (q : ℝ) < (j : ℝ) := lt_of_not_ge hjq
      have hqj_nat : q < j := by exact_mod_cast hlt
      have hqj : q + 1 ≤ j := by omega
      have hc : (q : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast hqj
      have hdiff_neg : (q : ℝ) + (1 / 2 : ℝ) - (j : ℝ) < 0 := by linarith
      have hdist : (1 : ℝ) ≤ (j : ℝ) - (q : ℝ) := by linarith
      rw [abs_of_neg hdiff_neg]
      linarith
  constructor
  · exact hfloor
  · rw [hfloor]
    dsimp [q]
    exact hdigit_rec k

/-- Two-scale fine partition safe geometry on the unit cube: for every positive
coarse scale `M`, the unit cube admits a ReLU-tent partition at the fine scale
`M^2`, with active tent weights supported within coordinate distance `M⁻²` and
Euclidean distance `√d * M⁻²`. -/
theorem unitCube_twoScale_shifted_partition_safe_geometry
    {d M : ℕ} (hM : 0 < M) :
    ∃ center scale : Fin (((M ^ 2) + 1) ^ d) → Fin d → ℝ,
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d, 0 ≤ scale j q) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d,
        center j q ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ q : Fin d, |x q - center j q| ≤ 1) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin (((M ^ 2) + 1) ^ d),
          axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q *
            (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ ((M : ℝ) ^ 2)⁻¹) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q *
            (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        Real.sqrt (∑ q : Fin d, (x q - center j q) ^ 2) ≤
          Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹) := by
  rcases exists_unitCube_axisAlignedBoxTentWeight_partition_data_with_domain_coord_bound
      (d := d) (K := M ^ 2) (pow_pos hM 2) with
    ⟨center, scale, h_nonneg, h_center, h_diam, h_partition, h_active_coord, h_active_norm⟩
  refine ⟨center, scale, h_nonneg, h_center, h_diam, h_partition, ?_, ?_⟩
  · intro j x hx hloc q
    simpa [Nat.cast_pow] using h_active_coord j x hx hloc q
  · intro j x hx hloc
    have hcoord : ∀ q : Fin d, |x q - center j q| ≤ ((M : ℝ) ^ 2)⁻¹ := by
      intro q
      simpa [Nat.cast_pow] using h_active_coord j x hx hloc q
    have hnonneg : 0 ≤ ((M : ℝ) ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg (M : ℝ))
    have hsq : ∀ q : Fin d, (x q - center j q) ^ 2 ≤ (((M : ℝ) ^ 2)⁻¹) ^ 2 := by
      intro q
      exact sq_le_sq.mpr (by
        rw [abs_of_nonneg hnonneg]
        exact hcoord q)
    have hsum : (∑ q : Fin d, (x q - center j q) ^ 2) ≤
        (d : ℝ) * (((M : ℝ) ^ 2)⁻¹) ^ 2 := by
      calc
        (∑ q : Fin d, (x q - center j q) ^ 2) ≤
            ∑ q : Fin d, (((M : ℝ) ^ 2)⁻¹) ^ 2 := Finset.sum_le_sum (fun q _ => hsq q)
        _ = (d : ℝ) * (((M : ℝ) ^ 2)⁻¹) ^ 2 := by simp
    calc
      Real.sqrt (∑ q : Fin d, (x q - center j q) ^ 2) ≤
          Real.sqrt ((d : ℝ) * (((M : ℝ) ^ 2)⁻¹) ^ 2) := Real.sqrt_le_sqrt hsum
      _ = Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹ := by
        rw [Real.sqrt_mul (by positivity : 0 ≤ (d : ℝ))]
        rw [Real.sqrt_sq_eq_abs]
        rw [abs_of_nonneg hnonneg]

theorem truncatedFloorReLUFunction_base_digit_decoder_exact_on_gap_code
    {N base code floorBound : ℕ} {R : ℝ}
    (hbase : 0 < base)
    (hfloorBound_pos : 0 < floorBound)
    (hR : 0 < R)
    (digit : Fin N → ℕ)
    (hrecover : ∀ k : Fin N, (code / base ^ k.val) % base = digit k)
    (hfloorBound : ∀ k : Fin N, code / base ^ k.val ≤ floorBound)
    (hgap : ∀ k : Fin N,
      let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
      awayFromFiniteIntegerGrid R floorBound readout) :
    (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R floorBound (x 0)) ∈
        reluNetworkClass 1 1 (2 * floorBound)
          (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ∧
      ∀ k : Fin N,
        let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
        truncatedFloorReLUFunction R floorBound readout =
            ((code / base ^ k.val : ℕ) : ℝ) ∧
          Nat.floor (truncatedFloorReLUFunction R floorBound readout) % base =
            digit k := by
  constructor
  · exact (truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid
      (B := floorBound) (R := R) hfloorBound_pos hR).1
  · intro k
    let q : ℕ := code / base ^ k.val
    let readout : ℝ := (q : ℝ) + (1 / 2 : ℝ)
    change truncatedFloorReLUFunction R floorBound readout = (q : ℝ) ∧
      Nat.floor (truncatedFloorReLUFunction R floorBound readout) % base = digit k
    have hq_floor : (q : ℝ) ≤ (floorBound : ℝ) := by
      exact_mod_cast hfloorBound k
    have hreadout_ge0 : 0 ≤ readout := by
      dsimp [readout]
      positivity
    have hhalf_lt_one : (1 / 2 : ℝ) < 1 := by
      norm_num
    have hreadout_lt : readout < (floorBound : ℝ) + 1 := by
      dsimp [readout]
      linarith [hq_floor, hhalf_lt_one]
    have hgap_k : awayFromFiniteIntegerGrid R floorBound readout := by
      dsimp [readout, q]
      exact hgap k
    have hfloor_eq : truncatedFloorReLUFunction R floorBound readout =
        (Nat.floor readout : ℝ) := by
      exact (truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid
        (B := floorBound) (R := R) hfloorBound_pos hR).2 readout hreadout_ge0 hreadout_lt hgap_k
    have hnatfloor : Nat.floor readout = q := by
      rw [Nat.floor_eq_iff hreadout_ge0]
      constructor
      · dsimp [readout]
        linarith
      · dsimp [readout]
        linarith
    constructor
    · rw [hfloor_eq, hnatfloor]
    · have hfloor2 : Nat.floor (truncatedFloorReLUFunction R floorBound readout) = q := by
        rw [hfloor_eq]
        rw [Nat.floor_natCast]
        exact hnatfloor
      rw [hfloor2]
      exact hrecover k

theorem finite_bounded_real_table_gap_decoder_network_code_package
    {ι : Type*} [Fintype ι] {N Q base : ℕ} {R : ℝ}
    (e : ι ≃ Fin N) {A eta : ℝ}
    (hA : 0 ≤ A) (heta : 0 < eta) (hQ : 0 < Q)
    (hmesh : 2 * A / (Q : ℝ) ≤ eta)
    (hbase : Q + 1 ≤ base)
    (hR : 2 ≤ R)
    (table : ι → ℝ)
    (htable : ∀ i : ι, |table i| ≤ A) :
    ∃ digit : Fin N → ℕ,
      (∀ k : Fin N, digit k ≤ Q) ∧
      (∀ k : Fin N, digit k < base) ∧
      ∃ code floorBound : ℕ,
        code = ∑ k : Fin N, digit k * base ^ k.val ∧
        floorBound = code + 1 ∧
        ∃ decoded : ι → ℝ,
          (∀ i : ι,
            decoded i = -A + (2 * A / (Q : ℝ)) * (digit (e i) : ℝ)) ∧
          (∀ i : ι, |decoded i - table i| ≤ eta) ∧
          (∀ i : ι, |decoded i| ≤ A + eta) ∧
          (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R floorBound (x 0)) ∈
            reluNetworkClass 1 1 (2 * floorBound)
              (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ∧
          ∀ k : Fin N,
            let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
            0 ≤ readout ∧
              readout < (floorBound : ℝ) + 1 ∧
              awayFromFiniteIntegerGrid R floorBound readout ∧
              Nat.floor readout = code / base ^ k.val ∧
              truncatedFloorReLUFunction R floorBound readout =
                ((code / base ^ k.val : ℕ) : ℝ) ∧
              Nat.floor (truncatedFloorReLUFunction R floorBound readout) % base =
                digit k := by
  rcases finite_bounded_real_table_gap_base_code (e := e) hA heta hQ hmesh hbase hR table
      htable with
    ⟨digit, hdigitQ, hdigitBase, code, floorBound, hcode, hfloorBound, hreadout,
      decoded, hdecoded, hdecodeErr, hdecodedBound⟩
  have hfloorBound_pos : 0 < floorBound := by
    rw [hfloorBound]
    exact Nat.succ_pos code
  have hR_pos : 0 < R := by
    linarith
  rcases truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid
      (B := floorBound) (R := R) hfloorBound_pos hR_pos with
    ⟨hnet, hfloor_eq⟩
  refine ⟨digit, hdigitQ, hdigitBase, code, floorBound, hcode, hfloorBound, decoded,
    hdecoded, hdecodeErr, hdecodedBound, hnet, ?_⟩
  intro k
  let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
  rcases hreadout k with ⟨hreadout_nonneg, hreadout_lt, haway, hfloor, hmod⟩
  have htfloor :
      truncatedFloorReLUFunction R floorBound readout = (Nat.floor readout : ℝ) :=
    hfloor_eq readout hreadout_nonneg hreadout_lt haway
  have htrunc :
      truncatedFloorReLUFunction R floorBound readout =
        ((code / base ^ k.val : ℕ) : ℝ) := by
    rw [htfloor, hfloor]
  have hmod' : code / base ^ k.val % base = digit k := by
    rw [← hfloor]
    exact hmod
  refine ⟨hreadout_nonneg, hreadout_lt, haway, hfloor, htrunc, ?_⟩
  rw [htrunc, Nat.floor_natCast]
  exact hmod'

theorem unitCube_twoScale_tent_partition_holder_taylor_global_error_bound
    {d r M : ℕ} {beta C B : ℝ}
    (hd : 0 < d) (hM : 0 < M)
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B) :
    ∃ center scale : Fin (((M ^ 2) + 1) ^ d) → Fin d → ℝ,
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d, 0 ≤ scale j q) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d,
        center j q ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin (((M ^ 2) + 1) ^ d),
          axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        |(∑ j : Fin (((M ^ 2) + 1) ^ d),
            axisAlignedBoxTentWeight (center j) (scale j) x *
              finiteLinearCombination
                (Finset.univ :
                  Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                (fun a =>
                  ((Nat.factorial a.1.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.1.val f (center j))
                      (fun q : Fin a.1.val =>
                        fun u : Fin d => if u = a.2 q then 1 else 0))
                (fun a => fun y : Fin d → ℝ =>
                  ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))) x) - f x| ≤
              C / (Nat.factorial r : ℝ) *
                Real.rpow (Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹)
                  ((r : ℝ) + beta) := by
  let rho : ℝ := Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹
  rcases unitCube_twoScale_shifted_partition_safe_geometry hM with
    ⟨center, scale, hscale_nonneg, hcenter_cube, _hdist_one, hpartition, hloc_coord, _hloc_euclid⟩
  refine ⟨center, scale, hscale_nonneg, hcenter_cube, ?_, ?_⟩
  · intro x hx_cube
    exact hpartition x hx_cube
  · intro x hx_cube
    let weight : Fin (((M ^ 2) + 1) ^ d) → Unit → ℝ :=
      fun j _ => axisAlignedBoxTentWeight (center j) (scale j) x
    let approx : Fin (((M ^ 2) + 1) ^ d) → Unit → ℝ := fun j _ =>
      finiteLinearCombination
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
          (iteratedFDeriv ℝ a.1.val f (center j))
            (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
        (fun a => fun y : Fin d → ℝ =>
          ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))) x
    let target : Unit → ℝ := fun _ => f x
    let eps : ℝ := C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta)
    have hweight_nonneg : ∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ u : Unit, 0 ≤ weight j u := by
      intro j u
      exact (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale_nonneg j)).1
    have hpart_unit : ∀ u : Unit, (∑ j : Fin (((M ^ 2) + 1) ^ d), weight j u) = 1 := by
      intro u
      simpa [weight] using hpartition x hx_cube
    have hlocal : ∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ u : Unit,
        weight j u ≠ 0 → |approx j u - target u| ≤ eps := by
      intro j u hjw
      have hjw' : axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 := by
        simpa [weight] using hjw
      have hbs := axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x
        (hscale_nonneg j)
      have hactive : ∀ q : Fin d,
          scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1 := by
        by_contra hnot
        push_neg at hnot
        exact hjw' (hbs.2.2 hnot)
      have hcoord : ∀ q : Fin d, |x q - center j q| ≤ ((M : ℝ) ^ 2)⁻¹ := fun q =>
        hloc_coord j x hx_cube hactive q
      have hM2inv_nonneg : 0 ≤ ((M : ℝ) ^ 2)⁻¹ := by
        exact inv_nonneg.mpr (sq_nonneg (M : ℝ))
      have hnorm_inv : ‖x - center j‖ ≤ ((M : ℝ) ^ 2)⁻¹ := by
        exact (pi_norm_le_iff_of_nonneg hM2inv_nonneg).2 hcoord
      have hd1n : (1 : ℕ) ≤ d := hd
      have hd1 : (1 : ℝ) ≤ (d : ℝ) := by
        exact_mod_cast hd1n
      have hsqrt1 : (1 : ℝ) ≤ Real.sqrt (d : ℝ) := (Real.one_le_sqrt).2 hd1
      have hle_inv : ((M : ℝ) ^ 2)⁻¹ ≤ rho := by
        dsimp [rho]
        simpa using (mul_le_mul_of_nonneg_right hsqrt1 hM2inv_nonneg)
      have hnorm : ‖x - center j‖ ≤ rho := le_trans hnorm_inv hle_inv
      have hrho_nonneg : 0 ≤ rho := by
        dsimp [rho]
        exact mul_nonneg (Real.sqrt_nonneg (d : ℝ)) hM2inv_nonneg
      have ht := holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
        hbeta_nonneg hC hrho_nonneg f hf (center j) x hnorm
      have htaylor :
          |finiteLinearCombination
              (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
              (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f (center j))
                  (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
              (fun a => fun y : Fin d → ℝ =>
                ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))) x - f x| ≤
            C / (Nat.factorial r : ℝ) * rho.rpow ((r : ℝ) + beta) := by
        rwa [abs_sub_comm] at ht
      simpa [weight, approx, target, eps, rho] using htaylor
    have hres := Statlib.Nonparametric.Approximation.Sieve.partition_of_unity_weighted_function_pointwise_approximation_error_bound
      (X := Unit) (((M ^ 2) + 1) ^ d) weight approx target eps hweight_nonneg hpart_unit hlocal
    simpa [weight, approx, target, eps, rho] using hres ()

theorem finite_twoScale_taylor_coefficient_table_gap_decoder_network_code_package
    {d r M N Q base : ℕ} {R A eta : ℝ}
    (e :
      (Fin (((M ^ 2) + 1) ^ d) ×
        Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) ≃ Fin N)
    (hA : 0 ≤ A) (heta : 0 < eta) (hQ : 0 < Q)
    (hmesh : 2 * A / (Q : ℝ) ≤ eta)
    (hbase : Q + 1 ≤ base)
    (hR : 2 ≤ R)
    (coeff : Fin (((M ^ 2) + 1) ^ d) →
      Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ)
    (hcoeff : ∀ j a, |coeff j a| ≤ A) :
    ∃ digit : Fin N → ℕ,
      (∀ k : Fin N, digit k ≤ Q) ∧
      (∀ k : Fin N, digit k < base) ∧
      ∃ code floorBound : ℕ,
        code = ∑ k : Fin N, digit k * base ^ k.val ∧
        floorBound = code + 1 ∧
        ∃ decoded : Fin (((M ^ 2) + 1) ^ d) →
            Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
          (∀ j a,
            decoded j a = -A + (2 * A / (Q : ℝ)) * (digit (e (j, a)) : ℝ)) ∧
          (∀ j a, |decoded j a - coeff j a| ≤ eta) ∧
          (∀ j a, |decoded j a| ≤ A + eta) ∧
          (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R floorBound (x 0)) ∈
            reluNetworkClass 1 1 (2 * floorBound)
              (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ∧
          ∀ k : Fin N,
            let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
            0 ≤ readout ∧
              readout < (floorBound : ℝ) + 1 ∧
              awayFromFiniteIntegerGrid R floorBound readout ∧
              Nat.floor readout = code / base ^ k.val ∧
              truncatedFloorReLUFunction R floorBound readout =
                ((code / base ^ k.val : ℕ) : ℝ) ∧
              Nat.floor (truncatedFloorReLUFunction R floorBound readout) % base =
                digit k := by
  let table : (Fin (((M ^ 2) + 1) ^ d) ×
      Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) → ℝ :=
    fun p => coeff p.1 p.2
  have htable : ∀ p : (Fin (((M ^ 2) + 1) ^ d) ×
      Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)), |table p| ≤ A := by
    intro p
    exact hcoeff p.1 p.2
  rcases finite_bounded_real_table_gap_decoder_network_code_package
      (e := e) hA heta hQ hmesh hbase hR table htable with
    ⟨digit, hdigitQ, hdigitBase, code, floorBound, hcode, hfloorBound, decoded0,
      hdecoded0, hdecodeErr0, hdecodedBound0, hnet, hreadout⟩
  refine ⟨digit, hdigitQ, hdigitBase, code, floorBound, hcode, hfloorBound,
    (fun j a => decoded0 (j, a)), ?_, ?_, ?_, hnet, hreadout⟩
  · intro j a
    simpa [table] using hdecoded0 (j, a)
  · intro j a
    simpa [table] using hdecodeErr0 (j, a)
  · intro j a
    simpa [table] using hdecodedBound0 (j, a)

theorem finite_tent_partition_decoded_taylor_global_error_bound
    {d r m : ℕ} {beta C B eta R rho : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (heta_nonneg : 0 ≤ eta) (hR_nonneg : 0 ≤ R) (hrho_nonneg : 0 ≤ rho)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center scale : Fin m → Fin d → ℝ)
    (decoded : Fin m →
      Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ)
    (hscale : ∀ j : Fin m, ∀ q : Fin d, 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hactive_coord : ∀ j : Fin m, ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ R)
    (hactive_norm : ∀ j : Fin m, ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ‖x - center j‖ ≤ rho)
    (hdecoded : ∀ j : Fin m,
      ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |decoded j a -
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center j))
              (fun q : Fin a.1.val =>
                fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ eta) :
    ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      |(∑ j : Fin m,
          axisAlignedBoxTentWeight (center j) (scale j) x *
            finiteLinearCombination
              (Finset.univ :
                Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
              (decoded j)
              (fun a => fun y : Fin d → ℝ =>
                ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))) x) - f x| ≤
        C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) +
          eta *
            (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              R ^ a.1.val) := by
  intro x hx
  let ι : Type := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
  let coeff : Fin m → ι → ℝ := fun j a =>
    ((Nat.factorial a.1.val : ℝ)⁻¹) *
      (iteratedFDeriv ℝ a.1.val f (center j))
        (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
  let basis : Fin m → ι → (Fin d → ℝ) → ℝ := fun j a y =>
    ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))
  let weight : Fin m → Unit → ℝ := fun j _ =>
    axisAlignedBoxTentWeight (center j) (scale j) x
  let approx : Fin m → Unit → ℝ := fun j _ =>
    finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x
  let target : Unit → ℝ := fun _ => f x
  let epsTaylor : ℝ := C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta)
  let epsQuant : ℝ := eta * (∑ a : ι, R ^ a.1.val)
  let eps : ℝ := epsTaylor + epsQuant
  have hweight_nonneg : ∀ j : Fin m, ∀ u : Unit, 0 ≤ weight j u := by
    intro j u
    exact (axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)).1
  have hpart_unit : ∀ u : Unit, (∑ j : Fin m, weight j u) = 1 := by
    intro u
    simpa [weight] using hpartition x hx
  have hlocal : ∀ j : Fin m, ∀ u : Unit,
      weight j u ≠ 0 → |approx j u - target u| ≤ eps := by
    intro j u hjw
    have hjw' : axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 := by
      simpa [weight] using hjw
    have hbs := axisAlignedBoxTentWeight_bounds_and_support (center j) (scale j) x (hscale j)
    have hactive : ∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1 := by
      by_contra hnot
      push_neg at hnot
      exact hjw' (hbs.2.2 hnot)
    have hcoord : ∀ q : Fin d, |x q - center j q| ≤ R :=
      hactive_coord j x hx hactive
    have hnorm : ‖x - center j‖ ≤ rho := hactive_norm j x hx hactive
    have hqerr :
        |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x -
          finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x| ≤
            epsQuant := by
      simpa [ι, coeff, basis, epsQuant] using
        (finite_centered_monomial_polynomial_quantized_coeff_error_bound
          (center j) x (coeff j) (decoded j) heta_nonneg hR_nonneg
          (by
            intro a
            simpa [coeff] using hdecoded j a)
          hcoord)
    have ht := holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
      hbeta_nonneg hC hrho_nonneg f hf (center j) x hnorm
    have htaylor :
        |finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x - f x| ≤
          epsTaylor := by
      rw [abs_sub_comm]
      simpa [ι, coeff, basis, epsTaylor] using ht
    have htri :
        |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x - f x| ≤
          |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x -
            finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x| +
          |finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x - f x| := by
      calc
        |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x - f x|
            = |(finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x -
                finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x) +
                (finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x -
                  f x)| := by
              congr 1
              ring
        _ ≤ _ := abs_add_le _ _
    calc
      |approx j u - target u| =
          |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x -
            f x| := by
            simp [approx, target]
      _ ≤ |finiteLinearCombination (Finset.univ : Finset ι) (decoded j) (basis j) x -
            finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x| +
          |finiteLinearCombination (Finset.univ : Finset ι) (coeff j) (basis j) x -
            f x| := htri
      _ ≤ epsQuant + epsTaylor := add_le_add hqerr htaylor
      _ = eps := by
        change epsQuant + epsTaylor = epsTaylor + epsQuant
        ring
  have hres :=
    Statlib.Nonparametric.Approximation.Sieve.partition_of_unity_weighted_function_pointwise_approximation_error_bound
      (X := Unit) m weight approx target eps hweight_nonneg hpart_unit hlocal
  simpa [ι, coeff, basis, weight, approx, target, eps, epsTaylor, epsQuant] using hres ()

/-- Fixed-width local polynomial table network for an arbitrary decoded Taylor
coefficient table.  This is the construction-side companion of the Holder
local Taylor table theorem: it only realizes the decoded finite polynomial
table, and leaves the analytic Taylor remainder to the global decoded-error
lemma. -/
theorem finite_decoded_local_table_reluNetworkClass_fixed_width_domain_output_bound_from_mul_gadget
    {d m r Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ)) :
    ∃ Wlocal : ℕ,
      0 < Wlocal ∧
      Wlocal = finiteCenteredMonomialPolynomialFixedWidthBound Wmul
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ∧
      ∃ cLocalDepth : ℝ,
        0 < cLocalDepth ∧
        ∀ {R A polyEps productRadius : ℝ},
          0 ≤ A → 0 < R →
          ∀ n : ℕ, 0 < n →
          ∀ domain : (Fin d → ℝ) → Prop,
          ∀ center : Fin m → Fin d → ℝ,
          ∀ decoded : Fin m →
            Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
          (∀ j : Fin m,
            ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              |decoded j a| ≤ A) →
          A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) ≤
              polyEps →
          A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)
            + A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                R ^ a.1.val) ≤
              productRadius →
          (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
            ∀ q : Fin d, |x q - center j q| ≤ R) →
          ∃ Dlocal Plocal : ℕ,
            0 < Dlocal ∧
            (Dlocal : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
            Plocal = fullyConnectedReLUParameterCount d Dlocal Wlocal ∧
            ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
              (∀ j : Fin m,
                localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal) ∧
              (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
                |localApprox j x -
                  finiteLinearCombination
                    (Finset.univ :
                      Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (decoded j)
                    (fun a => fun y : Fin d → ℝ =>
                      ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                    x| ≤ polyEps) ∧
              (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
                |localApprox j x| ≤ productRadius) := by
  classical
  -- @step s1: Apply E1 to the finite sigma index set of all Taylor monomials:
  -- obtain Wlocal and cLocalDepth with the uniform per-center coefficient-bound clause.
  have h_gadget :
      ∃ Wlocal : ℕ,
        0 < Wlocal ∧
        Wlocal = finiteCenteredMonomialPolynomialFixedWidthBound Wmul
          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) ∧
        ∃ cLocalDepth : ℝ,
          1 ≤ cLocalDepth ∧
          ∀ (coeff : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ)
            (A R : ℝ),
            0 ≤ A → 0 < R → (∀ a ∈ Finset.univ, |coeff a| ≤ A) →
            ∀ n : ℕ, 0 < n → ∀ center : Fin d → ℝ,
              ∃ D P : ℕ,
                0 < D ∧ (D : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
                P = fullyConnectedReLUParameterCount d D Wlocal ∧
                ∃ g : (Fin d → ℝ) → ℝ,
                  g ∈ reluNetworkClass d D Wlocal P ∧
                  ∀ x : Fin d → ℝ,
                    (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x -
                        finiteLinearCombination
                          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                          coeff
                          (fun a => fun y : Fin d → ℝ =>
                            ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q)))
                          x| ≤
                      A *
                        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                                                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) := by
                          rcases Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_uniform_coeff_bound_from_mul_gadget
                              (ι := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) (d := d) (Wmul := Wmul)
                              hWmul (cMulDepth := cMulDepth) (cMulErr := cMulErr) hcMulDepth hcMulErr hmul
                              (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                              (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => a.1.val)
                              (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => a.2) with
                            ⟨Wlocal, hWpos, hWdef, cDepth, hcDepthPos, hclause⟩
                          refine ⟨Wlocal, hWpos, hWdef, max cDepth 1, ?_, ?_⟩
                          · exact le_max_right cDepth 1
                          · intro coeff A R hA hR hb n hn center
                            rcases hclause coeff A R hA hR (by intro a ha; exact hb a ha) n hn center with
                              ⟨D, P, hDpos, hDle, hPdef, g, hgmem, hgerr⟩
                            refine ⟨D, P, hDpos, ?_, hPdef, g, hgmem, ?_⟩
                            · have hmm : cDepth * ((n : ℝ) + 1) ≤ max cDepth 1 * ((n : ℝ) + 1) :=
                                mul_le_mul_of_nonneg_right (le_max_left cDepth 1) (by positivity)
                              linarith
                            · intro x hbox
                              simpa using hgerr x hbox
  -- @step s2: Instantiate the per-center clause for each cell j with coefficient
  -- function `decoded j` and center `center j`, obtaining per-cell networks.
  have h_cells :
      ∀ (Wlocal : ℕ) (cLocalDepth : ℝ),
        (∀ (coeff : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ)
            (A R : ℝ),
          0 ≤ A → 0 < R → (∀ a ∈ Finset.univ, |coeff a| ≤ A) →
          ∀ n : ℕ, 0 < n → ∀ center : Fin d → ℝ,
            ∃ D P : ℕ,
              0 < D ∧ (D : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
              P = fullyConnectedReLUParameterCount d D Wlocal ∧
              ∃ g : (Fin d → ℝ) → ℝ,
                g ∈ reluNetworkClass d D Wlocal P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                  |g x -
                      finiteLinearCombination
                        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                        coeff
                        (fun a => fun y : Fin d → ℝ =>
                          ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q)))
                        x| ≤
                    A *
                      (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                        centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)) →
        ∀ {R A : ℝ}, 0 ≤ A → 0 < R → ∀ n : ℕ, 0 < n →
        ∀ center : Fin m → Fin d → ℝ,
        ∀ decoded : Fin m → Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
        (∀ j : Fin m,
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), |decoded j a| ≤ A) →
        ∀ j : Fin m,
          ∃ D P : ℕ,
            0 < D ∧ (D : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wlocal ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D Wlocal P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center j q| ≤ R) →
                |g x -
                    finiteLinearCombination
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (decoded j)
                      (fun a => fun y : Fin d → ℝ =>
                        ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                      x| ≤
                  A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                                           centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) := by
                      intro Wlocal cLocalDepth hclause R A hA hR n hn center decoded hdec j
                      rcases hclause (decoded j) A R hA hR (by intro a ha; exact hdec j a) n hn (center j) with
                        ⟨D, P, hDpos, hDle, hPdef, g, hgmem, hgerr⟩
                      refine ⟨D, P, hDpos, hDle, hPdef, g, hgmem, ?_⟩
                      intro x hbox
                      exact hgerr x hbox
  -- @step s3: Choose the common depth Dlocal as the finite maximum of the per-cell
  -- depths (and 1), with Plocal the corresponding parameter count.
  have h_depth :
      ∀ (Wlocal : ℕ) (cLocalDepth : ℝ) (n : ℕ),
        1 ≤ cLocalDepth →
        ∀ Dper : Fin m → ℕ,
          (∀ j : Fin m, 0 < Dper j ∧ (Dper j : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1)) →
          ∃ Dlocal Plocal : ℕ,
            0 < Dlocal ∧
            (Dlocal : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
            Plocal = fullyConnectedReLUParameterCount d Dlocal Wlocal ∧
                    (∀ j : Fin m, Dper j ≤ Dlocal) := by
            intro Wlocal cLocalDepth n hc1 Dper hper
            have hn0 : 0 ≤ (n : ℝ) := by exact_mod_cast (Nat.zero_le n)
            have hn1 : 1 ≤ (n : ℝ) + 1 := by linarith
            have hB_one : (1 : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) := by
              calc
                1 ≤ cLocalDepth := hc1
                _ ≤ cLocalDepth * ((n : ℝ) + 1) := by
                  simpa [mul_comm] using le_mul_of_one_le_left (by linarith) hn1
            have hcast_max : ∀ a b : ℕ, ((max a b : ℕ) : ℝ) = max (a : ℝ) (b : ℝ) := by
              intro a b
              by_cases h : a ≤ b
              · rw [max_eq_right h, max_eq_right (by exact_mod_cast h)]
              · have hb : b ≤ a := le_of_not_ge h
                rw [max_eq_left hb, max_eq_left (by exact_mod_cast hb)]
            have hsup_real : ((Finset.univ.sup Dper : ℕ) : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) := by
              have hgen : ∀ s : Finset (Fin m), ((s.sup Dper : ℕ) : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) := by
                intro s
                induction s using Finset.induction with
                | empty =>
                    rw [Finset.sup_empty]
                    simp
                    exact le_trans (by norm_num : (0 : ℝ) ≤ 1) hB_one
                | insert a s ha ih =>
                    rw [Finset.sup_insert]
                    have hcast : ((Dper a ⊔ s.sup Dper : ℕ) : ℝ) =
                        max (Dper a : ℝ) ((s.sup Dper : ℕ) : ℝ) := by
                      simp [hcast_max]
                    rw [hcast]
                    exact max_le (hper a).2 ih
              exact hgen Finset.univ
            let Dlocal : ℕ := max (Finset.univ.sup Dper) 1
            refine ⟨Dlocal, fullyConnectedReLUParameterCount d Dlocal Wlocal, ?_, ?_, rfl, ?_⟩
            · dsimp [Dlocal]
              exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
            · dsimp [Dlocal]
              rw [hcast_max]
              exact max_le hsup_real (by simpa using hB_one)
            · intro j
              dsimp [Dlocal]
              exact le_trans (Finset.le_sup (Finset.mem_univ j)) (le_max_left _ _)
  -- @step s4: Lift each per-cell network into the common class
  -- reluNetworkClass d Dlocal Wlocal Plocal via depth/parameter monotonicity.
  have h_lift :
      ∀ (Dlocal Wlocal Plocal : ℕ),
        ∀ localApprox : Fin m → (Fin d → ℝ) → ℝ,
          (∀ j : Fin m,
            ∃ D P : ℕ,
              P = fullyConnectedReLUParameterCount d D Wlocal ∧
              localApprox j ∈ reluNetworkClass d D Wlocal P ∧
              D ≤ Dlocal ∧
              P ≤ Plocal) →
          ∀ j : Fin m, localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal := by
            intro Dlocal Wlocal Plocal localApprox hmem j
            rcases hmem j with ⟨D, P, hPdef, hgmem, hDle, hPle⟩
            rw [reluNetworkClass] at hgmem ⊢
            rcases hgmem with ⟨N, hNpos, hNdepth, hNwidth, hNparam, hNreal⟩
            refine ⟨N, hNpos, ?_, hNwidth, ?_, hNreal⟩
            · exact le_trans hNdepth hDle
            · exact le_trans hNparam hPle
  -- @step s5: Assemble the full conclusion: common class membership, polynomial
  -- approximation bound via hpolyEps, and output bound via triangle inequality.
  have h_final :
      ∃ Wlocal : ℕ,
        0 < Wlocal ∧
        Wlocal = finiteCenteredMonomialPolynomialFixedWidthBound Wmul
          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) ∧
        ∃ cLocalDepth : ℝ,
          0 < cLocalDepth ∧
          ∀ {R A polyEps productRadius : ℝ},
            0 ≤ A → 0 < R →
            ∀ n : ℕ, 0 < n →
            ∀ domain : (Fin d → ℝ) → Prop,
            ∀ center : Fin m → Fin d → ℝ,
            ∀ decoded : Fin m → Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
            (∀ j : Fin m,
              ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), |decoded j a| ≤ A) →
            A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) ≤
              polyEps →
            A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)
            + A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                R ^ a.1.val) ≤
              productRadius →
            (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
              ∀ q : Fin d, |x q - center j q| ≤ R) →
            ∃ Dlocal Plocal : ℕ,
              0 < Dlocal ∧
              (Dlocal : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
              Plocal = fullyConnectedReLUParameterCount d Dlocal Wlocal ∧
              ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
                (∀ j : Fin m,
                  localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal) ∧
                (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
                  |localApprox j x -
                    finiteLinearCombination
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (decoded j)
                      (fun a => fun y : Fin d → ℝ =>
                        ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                      x| ≤ polyEps) ∧
                (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
                                |localApprox j x| ≤ productRadius) := by
                  rcases h_gadget with ⟨Wlocal, hWpos, hWdef, cLocalDepth, hcDepth, hclause⟩
                  refine ⟨Wlocal, hWpos, hWdef, cLocalDepth, ?_, ?_⟩
                  · linarith
                  · intro R A polyEps productRadius hA hR n hn domain center decoded hdec hpolyEps hproduct hbox
                    choose Dper P hDper' using fun j : Fin m => h_cells Wlocal cLocalDepth hclause (R := R) (A := A) hA hR n hn center decoded hdec j
                    choose g hgmemerr using fun j : Fin m => (hDper' j).2.2.2
                    have hdepth' : ∀ j : Fin m, 0 < Dper j ∧ (Dper j : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) := by
                      intro j
                      exact ⟨(hDper' j).1, (hDper' j).2.1⟩
                    rcases h_depth Wlocal cLocalDepth n hcDepth Dper hdepth' with ⟨Dlocal, Plocal, hDpos, hDle, hPdef, hDmax⟩
                    have hPcount_mono : ∀ (a b : ℕ), a ≤ b →
                        fullyConnectedReLUParameterCount d a Wlocal ≤ fullyConnectedReLUParameterCount d b Wlocal := by
                      intro a b hab
                      unfold fullyConnectedReLUParameterCount
                      exact Nat.add_le_add_right
                        (Nat.add_le_add_left
                          (Nat.mul_le_mul_right ((Wlocal + 1) * Wlocal) (Nat.sub_le_sub_right hab 1))
                          ((d + 1) * Wlocal))
                        (Wlocal + 1)
                    have hPle : ∀ j : Fin m, P j ≤ Plocal := by
                      intro j
                      rw [(hDper' j).2.2.1, hPdef]
                      exact hPcount_mono (Dper j) Dlocal (hDmax j)
                    have hmemall : ∀ j : Fin m,
                        ∃ D P : ℕ, P = fullyConnectedReLUParameterCount d D Wlocal ∧
                          g j ∈ reluNetworkClass d D Wlocal P ∧ D ≤ Dlocal ∧ P ≤ Plocal := by
                      intro j
                      exact ⟨Dper j, P j, (hDper' j).2.2.1, (hgmemerr j).1, hDmax j, hPle j⟩
                    have hmemclass : ∀ j : Fin m, g j ∈ reluNetworkClass d Dlocal Wlocal Plocal :=
                      h_lift Dlocal Wlocal Plocal g hmemall
                    let poly : (j : Fin m) → (Fin d → ℝ) → ℝ := fun j x =>
                      finiteLinearCombination (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                        (decoded j)
                        (fun a => fun y : Fin d → ℝ => ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                        x
                    have hpoly_val : ∀ j : Fin m, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center j q| ≤ R) →
                        |poly j x| ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
                      intro j x hxbox
                      have hmono : ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                          |∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q))| ≤ R ^ a.1.val := by
                        intro a
                        calc
                          |∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q))| =
                              ∏ q : Fin a.1.val, |x (a.2 q) - center j (a.2 q)| := by
                                simpa using Finset.abs_prod Finset.univ (fun q : Fin a.1.val => x (a.2 q) - center j (a.2 q))
                          _ ≤ ∏ q : Fin a.1.val, R := by
                                exact Finset.prod_le_prod (by intro q hq; exact abs_nonneg _) (by intro q hq; exact hxbox (a.2 q))
                          _ = R ^ a.1.val := by
                                simp
                      dsimp [poly, finiteLinearCombination]
                      calc
                        |∑ a ∈ Finset.univ, decoded j a * (∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q)))| ≤
                            ∑ a ∈ Finset.univ, |decoded j a * (∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q)))| := by
                              exact Finset.abs_sum_le_sum_abs
                                (fun a => decoded j a * (∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q)))) Finset.univ
                        _ = ∑ a ∈ Finset.univ, |decoded j a| * |∏ q : Fin a.1.val, (x (a.2 q) - center j (a.2 q))| := by
                              simp only [abs_mul]
                        _ ≤ ∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))), A * R ^ a.1.val := by
                              apply Finset.sum_le_sum
                              intro a ha
                              exact mul_le_mul (hdec j a) (hmono a) (abs_nonneg _) hA
                        _ = A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
                              simpa [Finset.mul_sum]
                    refine ⟨Dlocal, Plocal, hDpos, hDle, hPdef, g, hmemclass, ?_, ?_⟩
                    · intro j x hxdom
                      have hxbox : ∀ q : Fin d, |x q - center j q| ≤ R := hbox j x hxdom
                      exact le_trans ((hgmemerr j).2 x hxbox) hpolyEps
                    · intro j x hxdom
                      have hxbox : ∀ q : Fin d, |x q - center j q| ≤ R := hbox j x hxdom
                      calc
                        |g j x| = |(g j x - poly j x) + poly j x| := by
                              rw [sub_add_cancel]
                        _ ≤ |g j x - poly j x| + |poly j x| := by
                              exact abs_add_le _ _
                        _ ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) + A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
                              exact add_le_add ((hgmemerr j).2 x hxbox) (hpoly_val j x hxbox)
                        _ ≤ productRadius := hproduct
  exact h_final

/-- On the two-scale `M^2` unit-cube tent grid, a uniformly quantized decoded
Taylor coefficient table gives the expected global function error: Taylor
remainder at radius `sqrt d * M^-2` plus the decoded-coefficient quantization
term.  This node packages the grid geometry, finite coefficient coding, and
decoded Taylor error; it does not yet assemble the ReLU network. -/
theorem unitCube_twoScale_decoded_taylor_table_global_error_from_quantization
    {d r M N Q base : ℕ} {beta C B A eta Rdec : ℝ}
    (hd : 0 < d) (hM : 0 < M)
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (hA : 0 ≤ A) (heta : 0 < eta) (hQ : 0 < Q)
    (hmesh : 2 * A / (Q : ℝ) ≤ eta)
    (hbase : Q + 1 ≤ base)
    (hRdec : 2 ≤ Rdec)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (e :
      (Fin (((M ^ 2) + 1) ^ d) ×
        Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) ≃ Fin N)
    (hcoeff :
      ∀ y : Fin d → ℝ,
        (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f y)
                (fun q : Fin a.1.val =>
                  fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A) :
    ∃ center scale : Fin (((M ^ 2) + 1) ^ d) → Fin d → ℝ,
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d, 0 ≤ scale j q) ∧
      (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d,
        center j q ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin (((M ^ 2) + 1) ^ d),
          axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      ∃ digit : Fin N → ℕ,
        (∀ k : Fin N, digit k ≤ Q) ∧
        (∀ k : Fin N, digit k < base) ∧
        ∃ code floorBound : ℕ,
          code = ∑ k : Fin N, digit k * base ^ k.val ∧
          floorBound = code + 1 ∧
          ∃ decoded : Fin (((M ^ 2) + 1) ^ d) →
              Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
            (∀ j a,
              decoded j a = -A + (2 * A / (Q : ℝ)) * (digit (e (j, a)) : ℝ)) ∧
            (∀ j a,
              |decoded j a -
                ((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f (center j))
                    (fun q : Fin a.1.val =>
                      fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ eta) ∧
            (∀ j a, |decoded j a| ≤ A + eta) ∧
            (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
              reluNetworkClass 1 1 (2 * floorBound)
                (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ∧
            (∀ k : Fin N,
              let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
              0 ≤ readout ∧
                readout < (floorBound : ℝ) + 1 ∧
                awayFromFiniteIntegerGrid Rdec floorBound readout ∧
                Nat.floor readout = code / base ^ k.val ∧
                truncatedFloorReLUFunction Rdec floorBound readout =
                  ((code / base ^ k.val : ℕ) : ℝ) ∧
                Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
                  digit k) ∧
            ∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              |(∑ j : Fin (((M ^ 2) + 1) ^ d),
                  axisAlignedBoxTentWeight (center j) (scale j) x *
                    finiteLinearCombination
                      (Finset.univ :
                        Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (decoded j)
                      (fun a => fun y : Fin d → ℝ =>
                        ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                      x) - f x| ≤
                C / (Nat.factorial r : ℝ) *
                    Real.rpow
                      (Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹)
                      ((r : ℝ) + beta)
                  + eta *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      (1 : ℝ) ^ a.1.val) := by
  classical
  let rho : ℝ := Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹
  rcases unitCube_twoScale_shifted_partition_safe_geometry hM with
    ⟨center, scale, hscale_nonneg, hcenter_cube, hdist_one, hpartition, hloc_coord,
      _hloc_euclid⟩
  let coeff : Fin (((M ^ 2) + 1) ^ d) →
      (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) → ℝ :=
    fun j a =>
      ((Nat.factorial a.1.val : ℝ)⁻¹) *
        (iteratedFDeriv ℝ a.1.val f (center j))
          (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
  have hcoeff_bound : ∀ j : Fin (((M ^ 2) + 1) ^ d),
      ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), |coeff j a| ≤ A := by
    intro j a
    exact hcoeff (center j) (hcenter_cube j) a
  rcases finite_twoScale_taylor_coefficient_table_gap_decoder_network_code_package
      (R := Rdec) e hA heta hQ hmesh hbase hRdec coeff hcoeff_bound with
    ⟨digit, hdigitQ, hdigitBase, code, floorBound, hcode, hfloorBound, decoded,
      hdecoded, hdecodedErr, hdecodedBound, hdecoderNet, hreadout⟩
  have hdecodedErr' : ∀ j : Fin (((M ^ 2) + 1) ^ d),
      ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |decoded j a -
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f (center j))
              (fun q : Fin a.1.val =>
                fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ eta := by
    intro j a
    simpa [coeff] using hdecodedErr j a
  have hcoordR : ∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ (1 : ℝ) := by
    intro j x hx hactive q
    exact hdist_one j x hx q
  have hnormR : ∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ‖x - center j‖ ≤ rho := by
    intro j x hx hactive
    have hcoord : ∀ q : Fin d, |x q - center j q| ≤ ((M : ℝ) ^ 2)⁻¹ := fun q =>
      hloc_coord j x hx hactive q
    have hM2inv_nonneg : 0 ≤ ((M : ℝ) ^ 2)⁻¹ := by
      exact inv_nonneg.mpr (sq_nonneg (M : ℝ))
    have hnorm_inv : ‖x - center j‖ ≤ ((M : ℝ) ^ 2)⁻¹ := by
      exact (pi_norm_le_iff_of_nonneg hM2inv_nonneg).2 hcoord
    have hd1n : (1 : ℕ) ≤ d := hd
    have hd1 : (1 : ℝ) ≤ (d : ℝ) := by
      exact_mod_cast hd1n
    have hsqrt1 : (1 : ℝ) ≤ Real.sqrt (d : ℝ) := (Real.one_le_sqrt).2 hd1
    have hle_inv : ((M : ℝ) ^ 2)⁻¹ ≤ rho := by
      dsimp [rho]
      simpa using (mul_le_mul_of_nonneg_right hsqrt1 hM2inv_nonneg)
    exact le_trans hnorm_inv hle_inv
  have hrho_nonneg : 0 ≤ rho := by
    dsimp [rho]
    exact mul_nonneg (Real.sqrt_nonneg (d : ℝ))
      (inv_nonneg.mpr (sq_nonneg (M : ℝ)))
  have hglobal := finite_tent_partition_decoded_taylor_global_error_bound
    (d := d) (r := r) (m := ((M ^ 2) + 1) ^ d)
    (beta := beta) (C := C) (B := B) (eta := eta)
    (R := (1 : ℝ)) (rho := rho)
    hbeta_nonneg hC (le_of_lt heta) (by norm_num) hrho_nonneg
    f hf center scale decoded
    hscale_nonneg hpartition hcoordR hnormR hdecodedErr'
  refine ⟨center, scale, hscale_nonneg, hcenter_cube, hpartition, digit, hdigitQ,
    hdigitBase, code, floorBound, hcode, hfloorBound, decoded, hdecoded,
    hdecodedErr', hdecodedBound, hdecoderNet, hreadout, ?_⟩
  intro x hx
  simpa [rho] using hglobal x hx

/-- Quantization schedule for the two-scale decoded Taylor table.

For every grid parameter `M`, choose a finite table size, base, quantization
level, decoder radius, and index equivalence so that the decoded-coefficient
error contribution is bounded by the target `M^(-2(r+beta))` rate.  This is the
scalar schedule used before the compressed fixed-width state-block assembly.
-/
theorem twoScale_decoded_quantization_schedule_for_M_rate
    {d r : ℕ} {beta A : ℝ}
    (hsmooth_pos : 0 < (r : ℝ) + beta) (hA : 0 ≤ A) :
    ∃ cQuant : ℝ, 0 < cQuant ∧
      ∀ M : ℕ, 0 < M →
        ∃ N Q base : ℕ,
        ∃ eta Rdec : ℝ,
          0 < eta ∧
          0 < Q ∧
          2 * A / (Q : ℝ) ≤ eta ∧
          Q + 1 ≤ base ∧
          2 ≤ Rdec ∧
          ∃ e :
            (Fin (((M ^ 2) + 1) ^ d) ×
              Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) ≃ Fin N,
            eta *
                (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  (1 : ℝ) ^ a.1.val) ≤
              cQuant * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
  classical
  -- @step s1: Define the finite monomial count
  -- `S := sum_a (1:ℝ)^a.1.val`; prove `0 <= S` and `0 < S + 1`.
  -- Use `hsmooth_pos` and `0 < M` to prove
  -- `0 < (M:ℝ).rpow (-(2*((r:ℝ)+beta)))`.
  --
  -- @step s2: Take `cQuant = 1`.  For each `M`, set
  -- `eta := (M:ℝ).rpow (-(2*((r:ℝ)+beta))) / (S + 1)`.
  -- Then `eta > 0` and `eta * S <= (M:ℝ).rpow (-(2*((r:ℝ)+beta)))`.
  --
  -- @step s3: Choose `Q` by the Archimedean property so that `0 < Q` and
  -- `2*A/(Q:ℝ) <= eta`; this is possible because `A >= 0` and `eta > 0`.
  --
  -- @step s4: Set `base := Q + 1`, `Rdec := 2`, and
  -- `N := Fintype.card (Fin (((M^2)+1)^d) × Sigma (...))`.  Use
  -- `Fintype.equivFin` for the required equivalence.
  --
  -- @step s5: Package the witnesses and the quantization-rate inequality.
  refine ⟨1, by norm_num, ?_⟩
  intro M hM
  let S : ℝ := ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val
  have hS_nonneg : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg (fun a ha => by positivity)
  have hS1_pos : 0 < S + 1 := by nlinarith [hS_nonneg]
  let R : ℝ := (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
  have hM_real : 0 < (M : ℝ) := by exact_mod_cast hM
  have hR_pos : 0 < R := by
    dsimp [R]
    exact Real.rpow_pos_of_pos hM_real _
  let eta : ℝ := R / (S + 1)
  have hEta_pos : 0 < eta := by
    dsimp [eta]
    exact div_pos hR_pos hS1_pos
  have hEta_mul : eta * S ≤ R := by
    dsimp [eta]
    rw [div_mul_eq_mul_div]
    rw [div_le_iff₀ hS1_pos]
    nlinarith [hR_pos]
  rcases exists_nat_gt (2 * A / eta) with ⟨Q, hQ_gt⟩
  have hQ_nonneg : 0 ≤ 2 * A / eta := by
    exact div_nonneg (by nlinarith [hA]) (le_of_lt hEta_pos)
  have hQ_real_pos : 0 < (Q : ℝ) := lt_of_le_of_lt hQ_nonneg hQ_gt
  have hQ_pos : 0 < Q := by exact_mod_cast hQ_real_pos
  have hQ_le : 2 * A / (Q : ℝ) ≤ eta := by
    have h1 : 2 * A < (Q : ℝ) * eta := (div_lt_iff₀ hEta_pos).mp hQ_gt
    rw [div_le_iff₀ hQ_real_pos]
    nlinarith [h1]
  let base : ℕ := Q + 1
  let Rdec : ℝ := 2
  let N : ℕ := Fintype.card
    (Fin (((M ^ 2) + 1) ^ d) × Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))
  refine ⟨N, Q, base, eta, Rdec, hEta_pos, hQ_pos, hQ_le, ?_, ?_, ?_⟩
  · dsimp [base]
    exact le_rfl
  · dsimp [Rdec]
    norm_num
  · refine ⟨Fintype.equivFin
      (Fin (((M ^ 2) + 1) ^ d) × Sigma
        (fun k : Fin (r + 1) => Fin k.val → Fin d)), ?_⟩
    simpa [S, R] using hEta_mul

/-- From the two-scale decoded Taylor package plus a compressed state-block
network construction, obtain the fixed-width `M`-rate premise consumed by the
final `L W^2` wrapper.

The `hstate` premise is the remaining paper construction layer: it must realize
the decoded local Taylor table and tent weights as one fixed-width serial ReLU
network with depth `O(M^d)` and error `O(M^(-2(r+beta)))`.  This theorem keeps
the analytic Taylor/quantization package separate from that construction
obligation and only assembles the rate-level conclusion.
-/
theorem holderSmoothBall_unitCube_twoScale_decoded_fixed_width_M_rate_from_state_block
    {d r W0 Dblock : ℕ} {beta C B A cQuant cState : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0) (hDblock : 0 < Dblock)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC_nonneg : 0 ≤ C) (hB_nonneg : 0 ≤ B)
    (hA_nonneg : 0 ≤ A)
    (hcoeff :
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ holderSmoothBall r beta C B →
        ∀ y : Fin d → ℝ,
          (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f y)
                  (fun q : Fin a.1.val =>
                    fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A)
    (hcQuant : 0 < cQuant) (hcState_nonneg : 0 ≤ cState)
    (hquant :
      ∀ M : ℕ, 0 < M →
        ∃ N Q base : ℕ,
        ∃ eta Rdec : ℝ,
          0 < eta ∧
          0 < Q ∧
          2 * A / (Q : ℝ) ≤ eta ∧
          Q + 1 ≤ base ∧
          2 ≤ Rdec ∧
          ∃ e :
            (Fin (((M ^ 2) + 1) ^ d) ×
              Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) ≃ Fin N,
            eta *
                (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  (1 : ℝ) ^ a.1.val) ≤
              cQuant * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))))
    (hstate :
      ∀ M N Q base code floorBound : ℕ,
      ∀ eta Rdec : ℝ,
        0 < M →
        0 < eta →
        0 < Q →
        2 * A / (Q : ℝ) ≤ eta →
        Q + 1 ≤ base →
        2 ≤ Rdec →
        ∀ e :
          (Fin (((M ^ 2) + 1) ^ d) ×
            Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)) ≃ Fin N,
        ∀ center scale : Fin (((M ^ 2) + 1) ^ d) → Fin d → ℝ,
        (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d, 0 ≤ scale j q) →
        (∀ j : Fin (((M ^ 2) + 1) ^ d), ∀ q : Fin d,
          center j q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ x : Fin d → ℝ,
          (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
          (∑ j : Fin (((M ^ 2) + 1) ^ d),
            axisAlignedBoxTentWeight (center j) (scale j) x) = 1) →
        ∀ digit : Fin N → ℕ,
        (∀ k : Fin N, digit k ≤ Q) →
        (∀ k : Fin N, digit k < base) →
        code = ∑ k : Fin N, digit k * base ^ k.val →
        floorBound = code + 1 →
        ∀ decoded : Fin (((M ^ 2) + 1) ^ d) →
          Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ,
        (∀ j a,
          decoded j a = -A + (2 * A / (Q : ℝ)) * (digit (e (j, a)) : ℝ)) →
        (∀ j a, |decoded j a| ≤ A + eta) →
        (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
          reluNetworkClass 1 1 (2 * floorBound)
            (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) →
        (∀ k : Fin N,
          let readout : ℝ := ((code / base ^ k.val : ℕ) : ℝ) + (1 / 2 : ℝ)
          0 ≤ readout ∧
            readout < (floorBound : ℝ) + 1 ∧
            awayFromFiniteIntegerGrid Rdec floorBound readout ∧
            Nat.floor readout = code / base ^ k.val ∧
            truncatedFloorReLUFunction Rdec floorBound readout =
              ((code / base ^ k.val : ℕ) : ℝ) ∧
            Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
              digit k) →
        ∃ D P : ℕ,
          D = (M ^ d) * (Dblock + 1) ∧
          0 < D ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d D W0 P ∧
            ∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              |g x -
                (∑ j : Fin (((M ^ 2) + 1) ^ d),
                  axisAlignedBoxTentWeight (center j) (scale j) x *
                    finiteLinearCombination
                      (Finset.univ :
                        Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (decoded j)
                      (fun a => fun y : Fin d → ℝ =>
                        ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                      x)| ≤
                cState * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤
                  cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
  classical
  let s : ℝ := (r : ℝ) + beta
  let K : ℝ := (C / (Nat.factorial r : ℝ)) * (Real.sqrt (d : ℝ)).rpow s
  let cDepth : ℝ := (Dblock : ℝ) + 1
  let cErr : ℝ := K + cQuant + cState
  refine ⟨cDepth, cErr, ?_, ?_, ?_⟩
  · -- 0 < cDepth
    dsimp [cDepth]
    have hDblockR : (0 : ℝ) < (Dblock : ℝ) := by exact_mod_cast hDblock
    nlinarith
  · -- 0 < cErr
    have hK_nonneg : 0 ≤ K := by
      dsimp [K]
      exact mul_nonneg (div_nonneg hC_nonneg (by positivity))
        (Real.rpow_nonneg (Real.sqrt_nonneg (d : ℝ)) s)
    dsimp [cErr]
    nlinarith [hK_nonneg, hcQuant, hcState_nonneg]
  · -- main: ∀ M, 0 < M → ∃ D P, 0 < D ∧ (D : ℝ) ≤ cDepth * (M : ℝ)^d ∧ P = ... ∧ ∀ f ...
    intro M hM
    rcases hquant M hM with
      ⟨N, Q, base, eta, Rdec, hEta, hQ, h2A, hbase, hRdec, e, hbudget⟩
    let F : ℝ := (M : ℝ).rpow (-(2 * s))
    have hMpos : (0 : ℝ) < (M : ℝ) := by exact_mod_cast hM
    have hMnonneg : (0 : ℝ) ≤ (M : ℝ) := le_of_lt hMpos
    have hpow :
        ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s) =
          (Real.sqrt (d : ℝ)).rpow s * (M : ℝ).rpow (-(2 * s)) := by
      have hM2nonneg : (0 : ℝ) ≤ (M : ℝ) ^ 2 := sq_nonneg (M : ℝ)
      have hM2inv_nonneg : (0 : ℝ) ≤ ((M : ℝ) ^ 2)⁻¹ := inv_nonneg.mpr hM2nonneg
      have hM2rpow : ((M : ℝ) ^ 2).rpow s = (M : ℝ).rpow (2 * s) := by
        exact (congrArg (fun t : ℝ => t.rpow s) (Real.rpow_natCast (M : ℝ) 2).symm).trans
          (Real.rpow_mul hMnonneg (2 : ℝ) s).symm
      calc
        (Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s
            = (Real.sqrt (d : ℝ)).rpow s * (((M : ℝ) ^ 2)⁻¹).rpow s :=
              Real.mul_rpow (Real.sqrt_nonneg (d : ℝ)) hM2inv_nonneg
        _ = (Real.sqrt (d : ℝ)).rpow s * (((M : ℝ) ^ 2).rpow s)⁻¹ := by
              exact congrArg (fun t : ℝ => (Real.sqrt (d : ℝ)).rpow s * t)
                (Real.inv_rpow hM2nonneg s)
        _ = (Real.sqrt (d : ℝ)).rpow s * (M : ℝ).rpow (-(2 * s)) := by
              exact congrArg (fun t : ℝ => (Real.sqrt (d : ℝ)).rpow s * t)
                ((congrArg (fun t : ℝ => t⁻¹) hM2rpow).trans
                  (Real.rpow_neg hMnonneg (2 * s)).symm)
    have hterm1 :
        (C / (Nat.factorial r : ℝ)) * ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s) ≤
          K * F := by
      have hterm1_eq :
          (C / (Nat.factorial r : ℝ)) * ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s) =
            K * F := by
        calc
          (C / (Nat.factorial r : ℝ)) * ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s)
              = (C / (Nat.factorial r : ℝ)) *
                  ((Real.sqrt (d : ℝ)).rpow s * (M : ℝ).rpow (-(2 * s))) := by
                exact congrArg (fun t : ℝ => (C / (Nat.factorial r : ℝ)) * t) hpow
          _ = K * F := by
            dsimp [K, F]
            ring
      exact le_of_eq hterm1_eq
    have hterm2 :
        eta * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) ≤
          cQuant * F := by
      simpa [F, s] using hbudget
    let D : ℕ := (M ^ d) * (Dblock + 1)
    let P : ℕ := fullyConnectedReLUParameterCount d D W0
    refine ⟨D, P, ?_, ?_, ?_, ?_⟩
    · -- 0 < D
      dsimp [D]
      exact mul_pos (pow_pos hM d) (Nat.succ_pos Dblock)
    · -- (D : ℝ) ≤ cDepth * (M : ℝ) ^ d
      have hD_eq : (D : ℝ) = cDepth * ((M : ℝ) ^ d) := by
        dsimp [D, cDepth]
        norm_cast
        ring
      exact le_of_eq hD_eq
    · -- P = fullyConnectedReLUParameterCount d D W0
      rfl
    · -- ∀ f ∈ holderSmoothBall r beta C B, ∃ g ...
      intro f hf
      rcases
          Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.unitCube_twoScale_decoded_taylor_table_global_error_from_quantization
            hd hM hbeta_nonneg hC_nonneg hA_nonneg hEta hQ h2A hbase hRdec f hf e (hcoeff f hf) with
        ⟨center, scale, hscale0, hcenter, hpart, digit, hdigitle, hdigitlt, code, floorBound,
          hcode, hfloor, decoded, hdecoded_eq, hdecoded_taylor, hdecoded_abs, hdecoder_mem,
          hreadout, herr⟩
      let T : (Fin d → ℝ) → ℝ :=
        fun x => ∑ j : Fin (((M ^ 2) + 1) ^ d),
          axisAlignedBoxTentWeight (center j) (scale j) x *
            finiteLinearCombination
              (Finset.univ :
                Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
              (decoded j)
              (fun a => fun y : Fin d → ℝ =>
                ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
              x
      have htf : ∀ x : Fin d → ℝ,
          (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → |T x - f x| ≤ (K + cQuant) * F := by
        intro x hx
        have hT_eq : T x =
            (∑ j : Fin (((M ^ 2) + 1) ^ d),
              axisAlignedBoxTentWeight (center j) (scale j) x *
                finiteLinearCombination
                  (Finset.univ :
                    Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                  (decoded j)
                  (fun a => fun y : Fin d → ℝ =>
                    ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                  x) := rfl
        have herr_le : |T x - f x| ≤
            (C / (Nat.factorial r : ℝ)) * ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s) +
              eta * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) := by
          rw [abs_sub_comm, hT_eq, abs_sub_comm]
          exact herr x hx
        have hsum :
            (C / (Nat.factorial r : ℝ)) * ((Real.sqrt (d : ℝ) * ((M : ℝ) ^ 2)⁻¹).rpow s) +
              eta * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) ≤
              (K + cQuant) * F := by
          nlinarith [hterm1, hterm2]
        exact le_trans herr_le hsum
      rcases hstate M N Q base code floorBound eta Rdec hM hEta hQ h2A hbase hRdec e center scale
          hscale0 hcenter hpart digit hdigitle hdigitlt hcode hfloor decoded hdecoded_eq
          hdecoded_abs hdecoder_mem hreadout with ⟨D', P', hD', hD'pos, hP', g, hg, hgT⟩
      refine ⟨g, ?_, ?_⟩
      · -- g ∈ reluNetworkClass d D W0 P
        have hD'D : D' = D := by
          dsimp [D]
          exact hD'
        have hP'P : P' = P := by
          dsimp [P]
          rw [← hD'D]
          exact hP'
        simpa [hD'D, hP'P] using hg
      · -- ∀ x, |g x - f x| ≤ cErr * F
        intro x hx
        have htri : |g x - f x| ≤ |g x - T x| + |T x - f x| := by
          rw [← Real.dist_eq, ← Real.dist_eq, ← Real.dist_eq]
          exact dist_triangle (g x) (T x) (f x)
        calc
          |g x - f x| ≤ |g x - T x| + |T x - f x| := htri
          _ ≤ cState * F + (K + cQuant) * F := by
            exact add_le_add (hgT x hx) (htf x hx)
          _ = cErr * F := by
            dsimp [cErr]
            ring


theorem twoScale_decoded_taylor_blockwise_serial_global_error_bound
    {d total coarse inner Dblock Wblock Pblock : Nat}
    {blockDelta eps : Real}
    (hDblock : 0 < Dblock) (hWblock : 0 < Wblock)
    (_hblockDelta : 0 <= blockDelta)
    (hbudget : (Finset.univ.sum (fun _b : Fin coarse => blockDelta)) <= eps)
    (blockIndex : Fin coarse × Fin inner ≃ Fin total)
    (domain : (Fin d -> Real) -> Prop)
    (term : Fin total -> (Fin d -> Real) -> Real)
    (blockApprox : Fin coarse -> (Fin d -> Real) -> Real)
      (hclass : forall b : Fin coarse,
        blockApprox b ∈ reluNetworkClass d Dblock Wblock Pblock)
      (herr : forall b : Fin coarse, forall x : Fin d -> Real, domain x ->
        |blockApprox b x -
          (Finset.univ.sum (fun u : Fin inner => term (blockIndex (b, u)) x))|
            <= blockDelta) :
      exists D P : Nat,
        0 < D /\
        D <= (coarse + 1) * (Dblock + 1) /\
        P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
        exists g : (Fin d -> Real) -> Real,
          g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
          forall x : Fin d -> Real, domain x ->
            |g x - (Finset.univ.sum (fun j : Fin total => term j x))| <= eps := by
    -- @step s1: fixed-width combination lemma yields combined network D P g with g = sum of blockApprox
    have h_comb : ∃ D P : Nat,
        0 < D ∧
          D ≤ (coarse + 1) * (Dblock + 1) ∧
          P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) ∧
          ∃ g : (Fin d → Real) → Real,
            g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P ∧
              ∀ x : Fin d → Real, domain x →
                g x = (Finset.univ.sum (fun b : Fin coarse => blockApprox b x)) := by
      have hE1 := Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
        (ι := Fin coarse) (d := d) (D0 := Dblock) (W0 := Wblock) (P0 := Pblock)
        (domain := domain)
        hDblock hWblock
        (fun _ : Fin coarse => (1 : ℝ))
        blockApprox
        blockApprox
        (fun _ : Fin coarse => 0)
        (by intro i; simp)
        (by intro i; exact hclass i)
        (by intro i x hx; simp)
      rcases hE1 with ⟨D, P, hD, hDle, hP, g, hgmem, hge⟩
      refine ⟨D, P, hD, ?_, hP, g, hgmem, ?_⟩
      · simpa using hDle
      · intro x hx
        have hge' : |g x - ∑ i : Fin coarse, blockApprox i x| ≤ 0 := by
          simpa using hge x hx
        exact sub_eq_zero.mp (abs_eq_zero.mp (le_antisymm hge' (abs_nonneg _)))
    -- @step s2: reindex the block-local double sum to the full serial sum
    have h_reindex : ∀ x : Fin d → Real, domain x →
        (Finset.univ.sum (fun b : Fin coarse => Finset.univ.sum (fun u : Fin inner => term (blockIndex (b, u)) x))) =
          (Finset.univ.sum (fun j : Fin total => term j x)) := by
      intro x hx
      rw [← Equiv.sum_comp blockIndex (fun j => term j x)]
      simpa [Finset.univ_product_univ] using
        (Finset.sum_product (Finset.univ : Finset (Fin coarse))
          (Finset.univ : Finset (Fin inner))
          (fun p : Fin coarse × Fin inner => term (blockIndex p) x)).symm
    -- @step s3: eps error bound by triangle inequality and hbudget
    have h_err : ∀ x : Fin d → Real, domain x →
        |(Finset.univ.sum (fun b : Fin coarse => blockApprox b x)) -
            (Finset.univ.sum (fun j : Fin total => term j x))| ≤ eps := by
      intro x hx
      rw [← h_reindex x hx]
      rw [← Finset.sum_sub_distrib]
      exact le_trans
        (Finset.abs_sum_le_sum_abs (fun b : Fin coarse => blockApprox b x -
            Finset.univ.sum (fun u : Fin inner => term (blockIndex (b, u)) x)) Finset.univ)
        (le_trans
          (Finset.sum_le_sum (fun b _hb => herr b x hx))
          hbudget)
    rcases h_comb with ⟨D, P, hDpos, hDle, hP, g, hgclass, hgeq⟩
    refine ⟨D, P, hDpos, hDle, hP, g, hgclass, ?_⟩
    intro x hx
    rw [hgeq x hx]
    exact h_err x hx

set_option maxHeartbeats 1000000
-- Arithmetic-heavy base-tail proof from the shallow ReLU digit decoder.
/-- shallow ReLU base-tail separation for recursive floor digit extraction.

The shifted recursive digit `a_next = b_next + (c + 2)` (with `c = Nat.ceil
(Real.exp d)` and `base ≥ 4 + 2 * c`) is read from the finite base-`base`
expansion `z = a_next + ∑ j, tail j / base^(j.val + 1)`.  The readout stays
`awayFromFiniteIntegerGrid R B` with `B + 1 = base` and `1/R` below the
base-tail separation `base^(-M)`; hence the truncated-floor ReLU network
(Lemma `supple12` /
`truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid`)
recovers `⌊z⌋₊ = a_next` exactly, and unshifting recovers the signed digit. -/
theorem reluApprox_recursiveBaseTail_floorDigit_exact_on_gap
    (d : ℝ) (c : ℕ) (hc : c = Nat.ceil (Real.exp d))
    (base : ℕ) (hbase : 4 + 2 * c ≤ base)
    (a_next : ℕ) (b_next : ℤ) (hshift : (a_next : ℤ) = b_next + (c + 2 : ℤ))
    (ha_next_lower : 1 ≤ a_next) (ha_next_upper : a_next ≤ 2 * c + 3)
    (M : ℕ) (hM : 1 ≤ M) (tail : Fin M → ℕ)
    (htail_lower : ∀ j : Fin M, 1 ≤ tail j)
    (htail_upper : ∀ j : Fin M, tail j ≤ 2 * c + 3)
    (z : ℝ)
    (hz : z = (a_next : ℝ) + ∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1))
    (B : ℕ) (hB : B + 1 = base)
    (R : ℝ) (hR : 0 < R) (hRsep : 1 / R < (base : ℝ) ^ (-(M : ℤ))) :
    awayFromFiniteIntegerGrid R B z ∧
      (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R B (x 0)) ∈
        reluNetworkClass 1 1 (2 * B) (fullyConnectedReLUParameterCount 1 1 (2 * B)) ∧
      truncatedFloorReLUFunction R B z = ↑⌊z⌋₊ ∧
      ⌊z⌋₊ = a_next ∧
      (a_next : ℤ) - (c + 2 : ℤ) = b_next := by
  -- @step s1: prove the grid gap condition `awayFromFiniteIntegerGrid R B z`
  have h_gap : awayFromFiniteIntegerGrid R B z := by
    -- @step s1: digit range: from htail_lower, htail_upper, hbase get `∀ j : Fin M, 1 ≤ tail j ∧ tail j ≤ base - 1`
    have h_digit_range : ∀ j : Fin M, 1 ≤ tail j ∧ tail j ≤ base - 1 := by
      intro j
      constructor
      · exact htail_lower j
      · have hlt : 2 * c + 3 < base := by
          change 2 * c + 3 + 1 ≤ base
          nlinarith only [hbase]
        exact Nat.le_sub_one_of_lt (lt_of_le_of_lt (htail_upper j) hlt)
    -- @step s2: lower bound on the tail sum: `q = base^(-M) ≤ T = ∑ j, tail j / base^(j+1)`
    have h_T_lower : (base : ℝ) ^ (-(M : ℤ)) ≤
        ∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) := by
      -- @step s1: 0 < (base : ℝ), rewrite base^(-M) as (1/base)^M via zpow_neg/zpow_natCast/inv_zpow, and q ≤ 1/base since M ≥ 1 and 0 < 1/base ≤ 1
      have h_s1 : (base : ℝ) ^ (-(M : ℤ)) ≤ 1 / (base : ℝ) := by
        let x : ℝ := 1 / (base : ℝ)
        have hb_pos : 0 < (base : ℝ) := by
          have hb_nat : 0 < base := by omega
          exact_mod_cast hb_nat
        have hb_ne : (base : ℝ) ≠ 0 := ne_of_gt hb_pos
        have hb_one : 1 ≤ (base : ℝ) := by
          have hb_nat_one : 1 ≤ base := by omega
          exact_mod_cast hb_nat_one
        have hx_pos : 0 < x := by
          dsimp [x]
          exact one_div_pos.mpr hb_pos
        have hx_nonneg : 0 ≤ x := le_of_lt hx_pos
        have hx_le_one : x ≤ 1 := by
          dsimp [x]
          have hbx_le_b : (base : ℝ) * (1 / (base : ℝ)) ≤ (base : ℝ) := by
            rw [mul_one_div_cancel hb_ne]
            exact hb_one
          have hbx_le_b1 : (base : ℝ) * (1 / (base : ℝ)) ≤ (base : ℝ) * 1 := by
            simpa using hbx_le_b
          exact le_of_mul_le_mul_left hbx_le_b1 hb_pos
        have hzpow : (base : ℝ) ^ (-(M : ℤ)) = x ^ M := by
          dsimp [x]
          rw [zpow_neg, zpow_natCast]
          rw [← inv_pow]
          rw [inv_eq_one_div]
        have hM_decomp : M = 1 + (M - 1) := by omega
        have hxpowM1 : x ^ (M - 1) ≤ 1 := by
          by_cases hM1 : M - 1 = 0
          · rw [hM1]
            simp
          · exact (pow_le_one_iff_of_nonneg hx_nonneg hM1).2 hx_le_one
        have hxpow : x ^ M ≤ x := by
          rw [hM_decomp]
          rw [pow_add, pow_one]
          have hprod : x * x ^ (M - 1) ≤ x * 1 := by
            exact mul_le_mul_of_nonneg_left hxpowM1 hx_nonneg
          simpa using hprod
        exact le_trans (le_of_eq hzpow) hxpow
      -- @step s2: leading summand at j0 = ⟨0, hM⟩: 1/base ≤ (tail j0) / base^(0+1)
      have h_s2 : 1 / (base : ℝ) ≤
          (tail (⟨0, hM⟩ : Fin M) : ℝ) / (base : ℝ) ^ ((⟨0, hM⟩ : Fin M).val + 1) := by
        have hc1 : (1 : ℝ) ≤ (tail (⟨0, hM⟩ : Fin M) : ℝ) := by
          exact_mod_cast (htail_lower ⟨0, hM⟩)
        have hbase_nonneg : 0 ≤ (base : ℝ) := Nat.cast_nonneg base
        have hdiv : 1 / (base : ℝ) ≤ (tail (⟨0, hM⟩ : Fin M) : ℝ) / (base : ℝ) := by
          exact div_le_div_of_nonneg_right hc1 hbase_nonneg
        simpa using hdiv
      -- @step s3: each summand (tail j)/base^(j+1) is nonnegative
      have h_s3 : ∀ j : Fin M, 0 ≤ (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) := by
        intro j
        have hbase_pos : 0 < (base : ℝ) := by
          have hcast : (4 + 2 * c : ℝ) ≤ (base : ℝ) := by
            exact_mod_cast hbase
          have hnum_pos : 0 < (4 + 2 * c : ℝ) := by positivity
          exact lt_of_lt_of_le hnum_pos hcast
        have hden_pos : 0 < (base : ℝ) ^ (j.val + 1) := pow_pos hbase_pos (j.val + 1)
        have hnum_nonneg : 0 ≤ (tail j : ℝ) := Nat.cast_nonneg (tail j)
        exact div_nonneg hnum_nonneg (le_of_lt hden_pos)
      -- @step s4: extract the j0 summand from the nonnegative sum and chain the three inequalities
      exact
        le_trans h_s1
          (le_trans h_s2
            (Finset.single_le_sum (fun i _ => h_s3 i) (Finset.mem_univ (⟨0, hM⟩ : Fin M))))
    -- @step s3: upper bound on the tail sum: `T ≤ 1 - q`
    have h_T_upper : (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)) ≤
        1 - (base : ℝ) ^ (-(M : ℤ)) := by
      let r : ℝ := (base : ℝ)⁻¹
      have hr_def : (base : ℝ)⁻¹ = r := rfl
      have hb4n : (4 : ℕ) ≤ base := by omega
      have hb4 : (4 : ℝ) ≤ (base : ℝ) := by exact_mod_cast hb4n
      have hbpos : 0 < (base : ℝ) := by nlinarith [hb4]
      have hbne0 : (base : ℝ) ≠ 0 := ne_of_gt hbpos
      have hbne1 : (base : ℝ) ≠ 1 := by
        intro h
        nlinarith [hb4]
      have h1le_base : (1 : ℕ) ≤ base := by omega
      have hbinv_ne_one : (base : ℝ)⁻¹ ≠ 1 := by
        intro h
        have : (base : ℝ) = 1 := by
          calc
            (base : ℝ) = (base : ℝ) * 1 := by ring
            _ = (base : ℝ) * (base : ℝ)⁻¹ := by rw [h]
            _ = 1 := by exact mul_inv_cancel₀ hbne0
        exact hbne1 this
      have hrne1 : r ≠ 1 := by
        rw [← hr_def]
        exact hbinv_ne_one
      have hrpos : 0 < r := by
        rw [← hr_def]
        exact inv_pos.mpr hbpos
      have hrsub_ne : r - 1 ≠ 0 := sub_ne_zero.mpr hrne1
      have hprod : ((base : ℝ) - 1) * r = 1 - r := by
        rw [← hr_def]
        calc
          ((base : ℝ) - 1) * (base : ℝ)⁻¹ = (base : ℝ) * (base : ℝ)⁻¹ - 1 * (base : ℝ)⁻¹ := by ring
          _ = 1 - (base : ℝ)⁻¹ := by
            rw [mul_inv_cancel₀ hbne0]
            ring
      have h_geom : (∑ k ∈ Finset.range M, r ^ k) = (r ^ M - 1) / (r - 1) :=
        geom_sum_eq hrne1 M
      have h_sum_r : (∑ j : Fin M, r ^ (j.val + 1)) = r * ((r ^ M - 1) / (r - 1)) := by
        calc
          (∑ j : Fin M, r ^ (j.val + 1)) = ∑ k ∈ Finset.range M, r ^ (k + 1) := by
            simpa using (Fin.sum_univ_eq_sum_range (fun k : ℕ => r ^ (k + 1)) M)
          _ = ∑ k ∈ Finset.range M, r * r ^ k := by
            refine Finset.sum_congr rfl ?_
            intro k hk
            rw [pow_succ']
          _ = r * ∑ k ∈ Finset.range M, r ^ k := by
            rw [Finset.mul_sum]
          _ = r * ((r ^ M - 1) / (r - 1)) := by
            rw [h_geom]
      have h_geom_identity : (1 - r) * ((r ^ M - 1) / (r - 1)) = 1 - r ^ M := by
        field_simp [hrsub_ne]
        ring
      have h_main : ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) = 1 - r ^ M := by
        calc
          ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1)))
              = (((base : ℝ) - 1) * r) * ((r ^ M - 1) / (r - 1)) := by ring
          _ = (1 - r) * ((r ^ M - 1) / (r - 1)) := by rw [hprod]
          _ = 1 - r ^ M := h_geom_identity
      have h_zpow : (base : ℝ) ^ (-(M : ℤ)) = r ^ M := by
        rw [← hr_def, zpow_neg, zpow_natCast, ← inv_pow]
      calc
        (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1))
            ≤ ∑ j : Fin M, ((base : ℝ) - 1) * r ^ (j.val + 1) := by
              exact Finset.sum_le_sum (fun j _ => by
                have hd : (tail j : ℝ) ≤ (base : ℝ) - 1 := by
                  have h1 : (tail j : ℝ) ≤ ((base - 1 : ℕ) : ℝ) := by
                    exact_mod_cast (h_digit_range j).2
                  simpa [Nat.cast_sub h1le_base] using h1
                have hrp : 0 < r ^ (j.val + 1) := pow_pos hrpos (j.val + 1)
                calc
                  (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) = (tail j : ℝ) * r ^ (j.val + 1) := by
                    rw [div_eq_mul_inv, ← inv_pow]
                  _ ≤ ((base : ℝ) - 1) * r ^ (j.val + 1) := by
                    exact mul_le_mul_of_nonneg_right hd (le_of_lt hrp))
        _ = ((base : ℝ) - 1) * ∑ j : Fin M, r ^ (j.val + 1) := by
              rw [← Finset.mul_sum]
        _ = ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) := by
              rw [h_sum_r]
        _ = 1 - r ^ M := h_main
        _ = 1 - (base : ℝ) ^ (-(M : ℤ)) := by
              rw [h_zpow]
    -- @step s4: combine tail-sum bounds with hRsep to get the grid gap condition
    have h_grid : awayFromFiniteIntegerGrid R B z := by
      intro n hn
      let q : ℝ := (base : ℝ) ^ (-(M : ℤ))
      let T : ℝ := ∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)
      have hzT : z = (a_next : ℝ) + T := by
        simpa [T] using hz
      have hT_lower' : q ≤ T := by
        simpa [q, T] using h_T_lower
      have hT_upper' : T ≤ 1 - q := by
        simpa [q, T] using h_T_upper
      have hq_pos : 0 < q := by
        dsimp [q]
        exact lt_trans (div_pos zero_lt_one hR) hRsep
      have hq_le_abs : q ≤ |z - (n : ℝ)| := by
        rcases lt_trichotomy n a_next with hnlt | hneq | hgt
        · have hcast : (a_next : ℝ) - (n : ℝ) = ((a_next - n : ℕ) : ℝ) := by
            exact (Nat.cast_sub (le_of_lt hnlt)).symm
          have hn_eq : (a_next : ℝ) = (n : ℝ) + ((a_next - n : ℕ) : ℝ) := by
            rw [← hcast]
            ring
          have hsub1 : (1 : ℝ) ≤ ((a_next - n : ℕ) : ℝ) := by
            exact_mod_cast (by omega : 1 ≤ a_next - n)
          have hnonneg : 0 ≤ z - (n : ℝ) := by
            rw [hzT, hn_eq]
            nlinarith [hsub1, hq_pos, hT_lower']
          rw [abs_of_nonneg hnonneg]
          rw [hzT, hn_eq]
          nlinarith [hsub1, hT_lower']
        · subst n
          have hzsub : z - (a_next : ℝ) = T := by
            rw [hzT]
            ring
          have hTpos : 0 < T := lt_of_lt_of_le hq_pos hT_lower'
          rw [hzsub, abs_of_pos hTpos]
          exact hT_lower'
        · have hcast : (n : ℝ) - (a_next : ℝ) = ((n - a_next : ℕ) : ℝ) := by
            exact (Nat.cast_sub (le_of_lt hgt)).symm
          have hn_eq : (n : ℝ) = (a_next : ℝ) + ((n - a_next : ℕ) : ℝ) := by
            rw [← hcast]
            ring
          have hsub1 : (1 : ℝ) ≤ ((n - a_next : ℕ) : ℝ) := by
            exact_mod_cast (by omega : 1 ≤ n - a_next)
          have hneg : z - (n : ℝ) < 0 := by
            rw [hzT, hn_eq]
            nlinarith [hT_upper', hsub1, hq_pos]
          rw [abs_of_neg hneg]
          rw [hzT, hn_eq]
          nlinarith [hT_upper', hsub1]
      rw [← one_div]
      exact le_of_lt (lt_of_lt_of_le hRsep hq_le_abs)
    exact h_grid
  -- @step s2: promoted floor-network lemma on the gap gives network membership and floor equality
  have h_net_floor :
      (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R B (x 0)) ∈
          reluNetworkClass 1 1 (2 * B) (fullyConnectedReLUParameterCount 1 1 (2 * B)) ∧
            truncatedFloorReLUFunction R B z = ↑⌊z⌋₊ := by
        have hBpos : 0 < B := by omega
        have hbase_pos : 0 < (base : ℝ) := by
          have hcast : (4 + 2 * c : ℝ) ≤ (base : ℝ) := by
            exact_mod_cast hbase
          have hnum_pos : 0 < (4 + 2 * c : ℝ) := by positivity
          exact lt_of_lt_of_le hnum_pos hcast
        have hz_nonneg : 0 ≤ z := by
          rw [hz]
          have hz1 : 0 ≤ (a_next : ℝ) := by
            exact_mod_cast (by omega : 0 ≤ a_next)
          have hz2 : 0 ≤ ∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) := by
            refine Finset.sum_nonneg ?_
            intro j hj
            refine div_nonneg ?_ ?_
            · exact_mod_cast (by omega : 0 ≤ tail j)
            · exact le_of_lt (pow_pos hbase_pos (j.val + 1))
          linarith
        have hT_lt_one : (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)) < 1 := by
          have hq_pos : 0 < (base : ℝ) ^ (-(M : ℤ)) := by
            exact lt_trans (div_pos zero_lt_one hR) hRsep
          have hT_le : (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)) ≤
              1 - (base : ℝ) ^ (-(M : ℤ)) := by
            let r : ℝ := (base : ℝ)⁻¹
            have hr_def : (base : ℝ)⁻¹ = r := rfl
            have hb4n : (4 : ℕ) ≤ base := by omega
            have hb4 : (4 : ℝ) ≤ (base : ℝ) := by exact_mod_cast hb4n
            have hbpos : 0 < (base : ℝ) := by nlinarith [hb4]
            have hbne0 : (base : ℝ) ≠ 0 := ne_of_gt hbpos
            have hbne1 : (base : ℝ) ≠ 1 := by
              intro h
              nlinarith [hb4]
            have h1le_base : (1 : ℕ) ≤ base := by omega
            have hbinv_ne_one : (base : ℝ)⁻¹ ≠ 1 := by
              intro h
              have : (base : ℝ) = 1 := by
                calc
                  (base : ℝ) = (base : ℝ) * 1 := by ring
                  _ = (base : ℝ) * (base : ℝ)⁻¹ := by rw [h]
                  _ = 1 := by exact mul_inv_cancel₀ hbne0
              exact hbne1 this
            have hrne1 : r ≠ 1 := by
              rw [← hr_def]
              exact hbinv_ne_one
            have hrpos : 0 < r := by
              rw [← hr_def]
              exact inv_pos.mpr hbpos
            have hrsub_ne : r - 1 ≠ 0 := sub_ne_zero.mpr hrne1
            have hprod : ((base : ℝ) - 1) * r = 1 - r := by
              rw [← hr_def]
              calc
                ((base : ℝ) - 1) * (base : ℝ)⁻¹ = (base : ℝ) * (base : ℝ)⁻¹ - 1 * (base : ℝ)⁻¹ := by ring
                _ = 1 - (base : ℝ)⁻¹ := by
                  rw [mul_inv_cancel₀ hbne0]
                  ring
            have h_geom : (∑ k ∈ Finset.range M, r ^ k) = (r ^ M - 1) / (r - 1) :=
              geom_sum_eq hrne1 M
            have h_sum_r : (∑ j : Fin M, r ^ (j.val + 1)) = r * ((r ^ M - 1) / (r - 1)) := by
              calc
                (∑ j : Fin M, r ^ (j.val + 1)) = ∑ k ∈ Finset.range M, r ^ (k + 1) := by
                  simpa using (Fin.sum_univ_eq_sum_range (fun k : ℕ => r ^ (k + 1)) M)
                _ = ∑ k ∈ Finset.range M, r * r ^ k := by
                  refine Finset.sum_congr rfl ?_
                  intro k hk
                  rw [pow_succ']
                _ = r * ∑ k ∈ Finset.range M, r ^ k := by
                  rw [Finset.mul_sum]
                _ = r * ((r ^ M - 1) / (r - 1)) := by
                  rw [h_geom]
            have h_geom_identity : (1 - r) * ((r ^ M - 1) / (r - 1)) = 1 - r ^ M := by
              field_simp [hrsub_ne]
              ring
            have h_main : ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) = 1 - r ^ M := by
              calc
                ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1)))
                    = (((base : ℝ) - 1) * r) * ((r ^ M - 1) / (r - 1)) := by ring
                _ = (1 - r) * ((r ^ M - 1) / (r - 1)) := by rw [hprod]
                _ = 1 - r ^ M := h_geom_identity
            have h_zpow : (base : ℝ) ^ (-(M : ℤ)) = r ^ M := by
              rw [← hr_def, zpow_neg, zpow_natCast, ← inv_pow]
            calc
              (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1))
                  ≤ ∑ j : Fin M, ((base : ℝ) - 1) * r ^ (j.val + 1) := by
                    exact Finset.sum_le_sum (fun j _ => by
                      have hd : (tail j : ℝ) ≤ (base : ℝ) - 1 := by
                        have htail_le_base_sub : tail j ≤ base - 1 := by
                          have hspec : tail j ≤ 2 * c + 3 := htail_upper j
                          have hbc : 2 * c + 3 ≤ base - 1 := by omega
                          exact le_trans hspec hbc
                        have h1 : (tail j : ℝ) ≤ ((base - 1 : ℕ) : ℝ) := by
                          exact_mod_cast htail_le_base_sub
                        simpa [Nat.cast_sub h1le_base] using h1
                      have hrp : 0 < r ^ (j.val + 1) := pow_pos hrpos (j.val + 1)
                      calc
                        (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) = (tail j : ℝ) * r ^ (j.val + 1) := by
                          rw [div_eq_mul_inv, ← inv_pow]
                        _ ≤ ((base : ℝ) - 1) * r ^ (j.val + 1) := by
                          exact mul_le_mul_of_nonneg_right hd (le_of_lt hrp))
              _ = ((base : ℝ) - 1) * ∑ j : Fin M, r ^ (j.val + 1) := by
                    rw [← Finset.mul_sum]
              _ = ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) := by
                    rw [h_sum_r]
              _ = 1 - r ^ M := h_main
              _ = 1 - (base : ℝ) ^ (-(M : ℤ)) := by
                    rw [h_zpow]
          nlinarith [hT_le, hq_pos]
        have hz_lt : z < ↑B + 1 := by
          rw [hz]
          have hcast_a : (a_next : ℝ) + 1 ≤ (2 * c + 4 : ℝ) := by
            have hcast : (a_next : ℝ) ≤ (2 * c + 3 : ℝ) := by exact_mod_cast ha_next_upper
            nlinarith
          have hcast_b : (2 * c + 4 : ℝ) ≤ (base : ℝ) := by
            have hcast : (4 + 2 * c : ℝ) ≤ (base : ℝ) := by exact_mod_cast hbase
            nlinarith
          have hbase_eq : (base : ℝ) = ↑B + 1 := by
            rw [← hB]
            norm_num
          nlinarith [hT_lt_one, hcast_a, hcast_b, hbase_eq]
        have hE1 :=
          Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid
            (B := B) (R := R) hBpos hR
        exact ⟨hE1.1, hE1.2 z hz_nonneg hz_lt h_gap⟩
  -- @step s3: tail sum in [0,1) forces `⌊z⌋₊ = a_next`
  have h_floor : ⌊z⌋₊ = a_next := by
    -- @step s1: tail sum nonnegativity: 0 ≤ ∑ j, (tail j : ℝ) / (base : ℝ)^(j.val+1)
    have h_tail_nonneg : 0 ≤ ∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) := by
      have hbase_pos : 0 < (base : ℝ) := by
        have hbase_pos_nat : 0 < base := by omega
        exact_mod_cast hbase_pos_nat
      have hnum_nonneg : ∀ j : Fin M, 0 ≤ (tail j : ℝ) := by
        intro j
        exact_mod_cast (Nat.zero_le (tail j))
      have hden_pos : ∀ j : Fin M, 0 < (base : ℝ) ^ (j.val + 1) := by
        intro j
        exact pow_pos hbase_pos (j.val + 1)
      have hsummand_nonneg : ∀ j : Fin M, 0 ≤ (tail j : ℝ) / (base : ℝ) ^ (j.val + 1) := by
        intro j
        exact div_nonneg (hnum_nonneg j) (le_of_lt (hden_pos j))
      exact Finset.sum_nonneg (s := Finset.univ) (fun j _ => hsummand_nonneg j)
    -- @step s2: strict tail bound: (∑ j, (tail j : ℝ) / (base : ℝ)^(j.val+1)) < 1
    have h_tail_lt : (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)) < 1 := by
      -- @step s1: digit bound (tail j ≤ base - 1) and base positivity
      have h_digit : (∀ j : Fin M, (tail j : ℝ) ≤ (base : ℝ) - 1) ∧ 0 < (base : ℝ) := by
        constructor
        · intro j
          have h4base : 4 ≤ base := by omega
          have htu := htail_upper j
          have htail_nat : tail j + 1 ≤ base := by omega
          have htail_real : (tail j : ℝ) + 1 ≤ (base : ℝ) := by
            exact_mod_cast htail_nat
          linarith
        · have hbase_pos : 0 < base := by omega
          exact_mod_cast hbase_pos
      -- @step s2: pointwise quotient bound, summed
      have h_tail_le : (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1)) ≤ ∑ j : Fin M, ((base : ℝ) - 1) / (base : ℝ) ^ (j.val + 1) := by
        apply Finset.sum_le_sum
        intro j hj
        exact div_le_div_of_nonneg_right (h_digit.1 j) (pow_nonneg (le_of_lt h_digit.2) (j.val + 1))
      -- @step s3: geometric identity of the geometric sum
      have h_geom : (∑ j : Fin M, ((base : ℝ) - 1) / (base : ℝ) ^ (j.val + 1)) = 1 - (1 / (base : ℝ)) ^ M := by
        let r : ℝ := (base : ℝ)⁻¹
        have hbne0 : (base : ℝ) ≠ 0 := ne_of_gt h_digit.2
        have hr_def : r = (base : ℝ)⁻¹ := rfl
        have hbgt1 : 1 < (base : ℝ) := by
          have hbase_nat : 4 ≤ base := by omega
          have hb4 : (4 : ℝ) ≤ (base : ℝ) := by exact_mod_cast hbase_nat
          nlinarith
        have hrne1 : r ≠ 1 := by
          rw [hr_def]
          intro h
          have hmul : (base : ℝ) = 1 := by
            rw [← mul_inv_cancel₀ hbne0, h]
            ring
          exact (not_lt_of_ge (le_of_eq hmul)) hbgt1
        have hrsub_ne : r - 1 ≠ 0 := sub_ne_zero.mpr hrne1
        have hprod : ((base : ℝ) - 1) * r = 1 - r := by
          rw [hr_def]
          calc
            ((base : ℝ) - 1) * (base : ℝ)⁻¹ = (base : ℝ) * (base : ℝ)⁻¹ - 1 * (base : ℝ)⁻¹ := by ring
            _ = 1 - (base : ℝ)⁻¹ := by
              rw [mul_inv_cancel₀ hbne0]
              ring
        have h_geom_r : (∑ k ∈ Finset.range M, r ^ k) = (r ^ M - 1) / (r - 1) :=
          geom_sum_eq hrne1 M
        have h_sum_r : (∑ j : Fin M, r ^ (j.val + 1)) = r * ((r ^ M - 1) / (r - 1)) := by
          calc
            (∑ j : Fin M, r ^ (j.val + 1)) = ∑ k ∈ Finset.range M, r ^ (k + 1) := by
              simpa using (Fin.sum_univ_eq_sum_range (fun k : ℕ => r ^ (k + 1)) M)
            _ = ∑ k ∈ Finset.range M, r * r ^ k := by
              refine Finset.sum_congr rfl ?_
              intro k hk
              rw [pow_succ']
            _ = r * ∑ k ∈ Finset.range M, r ^ k := by
              rw [Finset.mul_sum]
            _ = r * ((r ^ M - 1) / (r - 1)) := by
              rw [h_geom_r]
        have h_geom_identity : (1 - r) * ((r ^ M - 1) / (r - 1)) = 1 - r ^ M := by
          field_simp [hrsub_ne]
          ring
        have h_main : ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) = 1 - r ^ M := by
          calc
            ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1)))
                = (((base : ℝ) - 1) * r) * ((r ^ M - 1) / (r - 1)) := by ring
            _ = (1 - r) * ((r ^ M - 1) / (r - 1)) := by rw [hprod]
            _ = 1 - r ^ M := h_geom_identity
        have hzpow : (1 / (base : ℝ)) ^ M = r ^ M := by
          rw [hr_def, one_div]
        calc
          (∑ j : Fin M, ((base : ℝ) - 1) / (base : ℝ) ^ (j.val + 1))
              = ∑ j : Fin M, ((base : ℝ) - 1) * r ^ (j.val + 1) := by
                apply Finset.sum_congr rfl
                intro j hj
                rw [div_eq_mul_inv, ← inv_pow]
          _ = ((base : ℝ) - 1) * ∑ j : Fin M, r ^ (j.val + 1) := by
                rw [← Finset.mul_sum]
          _ = ((base : ℝ) - 1) * (r * ((r ^ M - 1) / (r - 1))) := by
                rw [h_sum_r]
          _ = 1 - r ^ M := h_main
          _ = 1 - (1 / (base : ℝ)) ^ M := by
                rw [hzpow]
      -- @step s4: strictness of the geometric value
      have h_geom_lt : 1 - (1 / (base : ℝ)) ^ M < 1 := by
        have h_base_pos : 0 < (base : ℝ) := h_digit.2
        have h_rec_pos : 0 < 1 / (base : ℝ) := one_div_pos.mpr h_base_pos
        have h_pow_pos : 0 < (1 / (base : ℝ)) ^ M := pow_pos h_rec_pos M
        linarith
      calc
        (∑ j : Fin M, (tail j : ℝ) / (base : ℝ) ^ (j.val + 1))
            ≤ ∑ j : Fin M, ((base : ℝ) - 1) / (base : ℝ) ^ (j.val + 1) := h_tail_le
        _ = 1 - (1 / (base : ℝ)) ^ M := h_geom
        _ < 1 := h_geom_lt
    -- @step s3: combine hz with 0 ≤ t and t < 1 via Nat.floor_eq_iff
    have h_floor_eq : ⌊z⌋₊ = a_next := by
      have ha_next_nonneg : (0 : ℝ) ≤ (a_next : ℝ) := by
        exact_mod_cast (Nat.zero_le a_next)
      have hz_nonneg : 0 ≤ z := by
        nlinarith [ha_next_nonneg, h_tail_nonneg, hz]
      have hz_lo : (a_next : ℝ) ≤ z := by
        nlinarith [h_tail_nonneg, hz]
      have hz_hi : z < (a_next : ℝ) + 1 := by
        nlinarith [h_tail_lt, hz]
      exact (Nat.floor_eq_iff (a := z) (n := a_next) hz_nonneg).2 ⟨hz_lo, hz_hi⟩
    exact h_floor_eq
  exact ⟨h_gap, ⟨h_net_floor.1, ⟨h_net_floor.2, ⟨h_floor, by omega⟩⟩⟩⟩

/-- Serial hstate packaging from per-block ReLU witnesses.

If every one of the `M^d` block approximants has common depth/width class
membership and pointwise error `blockDelta`, and the total block-error budget is
bounded by the shallow ReLU state exponent, then the serial finite linear
combination construction gives the exact hstate depth
`M^d * (Dblock + 1)` with final width `2*d + Wblock + 3`. -/
private theorem reluApprox_serial_stateBlock_hstate_from_block_errors
    {d r M Dsub Wblock Pblock Dblock : Nat}
    {beta cState blockDelta : Real}
    (hM : 0 < M)
    (hDsub : 0 < Dsub)
    (hWblock : 0 < Wblock)
    (hDblock : 0 < Dblock)
    (hblockDelta_nonneg : 0 <= blockDelta)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (center scale : Fin (M ^ d) -> Fin d -> Real)
    (decoded : Fin (M ^ d) -> TaylorMultiindex r d -> Real)
    (blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real)
    (hclass : forall b : Fin (M ^ d),
      blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herr : forall b : Fin (M ^ d), forall x : Fin d -> Real,
      (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
        |blockApprox b x -
          axisAlignedBoxTentWeight (center b) (scale b) x *
            finiteLinearCombination Finset.univ (decoded b)
              (fun a y => Finset.univ.prod
                (fun q : Fin a.1.val => y (a.2 q) - center b (a.2 q))) x|
          <= blockDelta)
    (hbudget : (Finset.univ.sum (fun _b : Fin (M ^ d) => blockDelta)) <=
      cState * (M : Real).rpow (-(2 * ((r : Real) + beta)))) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real,
          (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
            |g x -
              Finset.univ.sum (fun j : Fin (M ^ d) =>
                axisAlignedBoxTentWeight (center j) (scale j) x *
                  finiteLinearCombination Finset.univ (decoded j)
                    (fun a y => Finset.univ.prod
                      (fun q : Fin a.1.val =>
                        y (a.2 q) - center j (a.2 q))) x)|
              <= cState * (M : Real).rpow (-(2 * ((r : Real) + beta))) := by
  let target : Fin (M ^ d) -> (Fin d -> Real) -> Real :=
    fun b x =>
      axisAlignedBoxTentWeight (center b) (scale b) x *
        finiteLinearCombination Finset.univ (decoded b)
          (fun a y => Finset.univ.prod
            (fun q : Fin a.1.val => y (a.2 q) - center b (a.2 q))) x
  let domain : (Fin d -> Real) -> Prop :=
    fun x => forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1
  rcases finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin (M ^ d)) (d := d) (D0 := Dsub) (W0 := Wblock) (P0 := Pblock)
      (domain := domain) (coeff := fun _ => (1 : Real)) (target := target)
      (approx := blockApprox) (eps := fun _ => blockDelta)
      hDsub hWblock (fun _ => hblockDelta_nonneg) hclass herr with
    ⟨D0', P0', hD0pos, hD0bound, hP0def, g0, hg0mem, hg0err⟩
  have hcard : Fintype.card (Fin (M ^ d)) = M ^ d := by
    simp
  have hD0bound' : D0' <= (M ^ d + 1) * (Dsub + 1) := by
    simpa [hcard] using hD0bound
  have hD0leD : D0' <= M ^ d * (Dblock + 1) :=
    fixed_width_block_depth_padding_from_subblock_depth_bound (d := d) (M := M) (D := D0')
      (Dprod := Dsub) (Dblock := Dblock) hM hD0bound' hdepthPad
  have hPmono : fullyConnectedReLUParameterCount d D0' (2 * d + Wblock + 3) <=
      fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3) := by
    unfold fullyConnectedReLUParameterCount
    apply Nat.add_le_add_right
    apply Nat.add_le_add_left
    apply Nat.mul_le_mul_right
    exact Nat.sub_le_sub_right hD0leD 1
  have hDpos : 0 < M ^ d * (Dblock + 1) := by
    exact mul_pos (pow_pos hM d) (Nat.succ_pos Dblock)
  have hg0mem' : g0 ∈ reluNetworkClass d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3)
      (fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3)) := by
    rcases hg0mem with ⟨N, hNpos, hNdepth, hNwidth, hNpar, hNrealize⟩
    refine ⟨N, hNpos, le_trans hNdepth hD0leD, hNwidth, ?_, hNrealize⟩
    calc
      N.parameterCount <= P0' := hNpar
      _ = fullyConnectedReLUParameterCount d D0' (2 * d + Wblock + 3) := hP0def
      _ <= fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3) := hPmono
  have hg0err' : forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
      |g0 x - Finset.univ.sum (fun j : Fin (M ^ d) => target j x)| <=
        Finset.univ.sum (fun _j : Fin (M ^ d) => blockDelta) := by
    intro x hx
    simpa [target, domain] using hg0err x hx
  have herr' : forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
      |g0 x - Finset.univ.sum (fun j : Fin (M ^ d) => target j x)| <=
        cState * (M : Real).rpow (-(2 * ((r : Real) + beta))) := by
    intro x hx
    exact le_trans (hg0err' x hx) (by simpa using hbudget)
  exact ⟨M ^ d * (Dblock + 1),
    fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3),
    rfl, hDpos, rfl, g0, hg0mem', herr'⟩

/-- The `M^(-2 * (r + beta))` decay rate of the shallow ReLU construction. -/
noncomputable def shallowReLUResolutionRate (M r : ℕ) (beta : ℝ) : ℝ :=
  (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))

/-- Exact partition-of-unity Taylor sum associated with a two-scale
shallow ReLU layout. -/
private noncomputable def reluApproxWeightedTaylorSum
    (r d M : Nat)
    (center scale : Fin (M ^ d) -> Fin (M ^ d) -> Fin d -> Real)
    (f : (Fin d -> Real) -> Real) (x : Fin d -> Real) : Real :=
  Finset.univ.sum fun b : Fin (M ^ d) =>
    Finset.univ.sum fun t : Fin (M ^ d) =>
      axisAlignedBoxTentWeight (center b t) (scale b t) x *
        finiteLinearCombination
          (Finset.univ : Finset (TaylorMultiindex r d))
          (fun a =>
            ((Nat.factorial a.1.val : Real)⁻¹) *
              (iteratedFDeriv Real a.1.val f (center b t))
                (fun q : Fin a.1.val =>
                  fun u : Fin d => if u = a.2 q then 1 else 0))
          (fun a y =>
            Finset.univ.prod fun q : Fin a.1.val =>
              y (a.2 q) - center b t (a.2 q)) x

/-- The `q`-th base-`M` digit of `n`. -/
private def reluApproxBaseDigit (M n q : ℕ) : ℕ :=
  (n / M ^ q) % M

/-- Shifted two-scale shallow ReLU fine-cell center inside a coarse block. -/
private noncomputable def reluApproxShiftedTwoScaleCenter
    (M d : ℕ) (b : Fin (M ^ d)) (i : ℕ) (q : Fin d) : ℝ :=
  (reluApproxBaseDigit M b.val q.val : ℝ) / (M : ℝ) +
    ((reluApproxBaseDigit M i q.val : ℝ) + (1 : ℝ) / 2) / (M : ℝ) ^ 2

/-- Fine-cell width `1 / M^2` in the shifted two-scale partition. -/
private noncomputable def reluApproxShiftedTwoScaleScale (M : ℕ) : ℝ :=
  (1 : ℝ) / (M : ℝ) ^ 2

/-- One decoded fine-grid Taylor term with multi-index exponent list `a`. -/
private noncomputable def reluApproxDecodedTaylorTerm (r d : ℕ)
    (decoded : TaylorMultiindex r d → ℝ) (center : Fin d → ℝ)
    (x : Fin d → ℝ) : ℝ :=
  ∑ a : TaylorMultiindex r d,
    decoded a * ∏ j : Fin (a.fst : ℕ), (x (a.snd j) - center (a.snd j))

/-- The weighted coarse-block target: the fine-cell tent weights times decoded
Taylor terms in one block. -/
private noncomputable def reluApproxCoarseBlockTarget (r d T : ℕ)
    (decoded : Fin T → TaylorMultiindex r d → ℝ)
    (center scale : Fin T → Fin d → ℝ) (x : Fin d → ℝ) : ℝ :=
  ∑ i : Fin T,
    axisAlignedBoxTentWeight (center i) (scale i) x *
      reluApproxDecodedTaylorTerm r d (decoded i) (center i) x

/-- The complete fine-grid decoded Taylor sum over coarse blocks. -/
private noncomputable def reluApproxFineGridDecodedTaylorSum (r d coarse T : ℕ)
    (decoded : Fin coarse → Fin T → TaylorMultiindex r d → ℝ)
    (center scale : Fin coarse → Fin T → Fin d → ℝ) (x : Fin d → ℝ) : ℝ :=
  ∑ b : Fin coarse, reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x

/-- Coarse-block error certificate: coefficient plus local and tent errors. -/
private noncomputable def reluApproxBlockDeltaSum (coarse T : ℕ)
    (coeffAccErr : Fin coarse → ℝ) (locErr tentErr : Fin coarse → Fin T → ℝ) :
    Fin coarse → ℝ :=
  fun b => coeffAccErr b + ∑ i : Fin T, (locErr b i + tentErr b i)

private theorem reluApprox_blockDeltaSum_rate_from_component_rates
    {coarse T M r : ℕ} {beta Kcoeff KlocTent cState : ℝ}
    (coeffAccErr : Fin coarse → ℝ) (locErr tentErr : Fin coarse → Fin T → ℝ)
    (hrate_nonneg : 0 ≤ shallowReLUResolutionRate M r beta)
    (hcoeff_nonneg : ∀ b : Fin coarse, 0 ≤ coeffAccErr b)
    (hloc_nonneg : ∀ (b : Fin coarse) (i : Fin T), 0 ≤ locErr b i)
    (htent_nonneg : ∀ (b : Fin coarse) (i : Fin T), 0 ≤ tentErr b i)
    (hCoeffRate : (∑ b : Fin coarse, coeffAccErr b) ≤
      Kcoeff * shallowReLUResolutionRate M r beta)
    (hLocTentRate :
      (∑ b : Fin coarse, ∑ i : Fin T, (locErr b i + tentErr b i)) ≤
        KlocTent * shallowReLUResolutionRate M r beta)
    (hcState : Kcoeff + KlocTent ≤ cState) :
    (∀ b : Fin coarse,
        0 ≤ reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ∧
    (∑ b : Fin coarse, reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ≤
      cState * shallowReLUResolutionRate M r beta := by
  constructor
  · intro b
    unfold reluApproxBlockDeltaSum
    have hsum_nonneg : 0 ≤ ∑ i : Fin T, (locErr b i + tentErr b i) := by
      exact Finset.sum_nonneg (fun i _ => add_nonneg (hloc_nonneg b i) (htent_nonneg b i))
    exact add_nonneg (hcoeff_nonneg b) hsum_nonneg
  · calc
      (∑ b : Fin coarse, reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) = (∑ b : Fin coarse, coeffAccErr b) + (∑ b : Fin coarse, ∑ i : Fin T, (locErr b i + tentErr b i)) := by
        simp [reluApproxBlockDeltaSum, Finset.sum_add_distrib]
      _ ≤ Kcoeff * shallowReLUResolutionRate M r beta + KlocTent * shallowReLUResolutionRate M r beta := by
        exact add_le_add hCoeffRate hLocTentRate
      _ = (Kcoeff + KlocTent) * shallowReLUResolutionRate M r beta := by
        ring
      _ ≤ cState * shallowReLUResolutionRate M r beta := by
        exact mul_le_mul_of_nonneg_right hcState hrate_nonneg

private theorem reluApprox_singleCoarseBlock_evaluator_from_product_local_errors
    {d r T Dprod Wprod Pprod : ℕ} {productDelta : ℝ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (center scale : Fin T → Fin d → ℝ)
    (decoded : Fin T → TaylorMultiindex r d → ℝ)
    (localApprox productApprox : Fin T → (Fin d → ℝ) → ℝ)
    (localDelta : Fin T → ℝ)
    (hscale : ∀ (i : Fin T) (q : Fin d), 0 ≤ scale i q)
    (hproductClass : ∀ i : Fin T, productApprox i ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hproductErr : ∀ (i : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d →
        |productApprox i x -
          axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x| ≤
          productDelta)
    (hlocalErr : ∀ (i : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d →
        |localApprox i x -
          reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| ≤
          localDelta i)
    (hlocalNonneg : ∀ i : Fin T, 0 ≤ localDelta i) :
    ∃ D P : ℕ,
      0 < D ∧ D ≤ (T + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
        ∀ x : Fin d → ℝ, x ∈ unitCubeSet d →
          |g x - reluApproxCoarseBlockTarget r d T decoded center scale x| ≤
            (∑ _i : Fin T, productDelta) + (∑ i : Fin T, localDelta i) := by
  have hpointwise :
      ∀ (i : Fin T) (x : Fin d → ℝ), x ∈ unitCubeSet d →
        |productApprox i x -
          axisAlignedBoxTentWeight (center i) (scale i) x *
            reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| ≤
          productDelta + localDelta i := by
    intro i x hx
    let tent := axisAlignedBoxTentWeight (center i) (scale i) x
    have hb := axisAlignedBoxTentWeight_bounds_and_support (center i) (scale i) x (hscale i)
    rcases hb with ⟨htent0, htent1, _⟩
    have htentAbs : |tent| = tent := abs_of_nonneg htent0
    have hprod : |productApprox i x - tent * localApprox i x| ≤ productDelta := by
      simpa [tent] using hproductErr i x hx
    have hlocMul :
        |tent * localApprox i x -
          tent * reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| ≤
          localDelta i := by
      calc
        |tent * localApprox i x -
            tent * reluApproxDecodedTaylorTerm r d (decoded i) (center i) x|
            = |tent * (localApprox i x - reluApproxDecodedTaylorTerm r d (decoded i) (center i) x)| := by
              congr 1
              ring
        _ = |tent| * |localApprox i x - reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
              rw [abs_mul]
        _ = tent * |localApprox i x - reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
              rw [htentAbs]
        _ ≤ 1 * |localApprox i x - reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
              exact mul_le_mul_of_nonneg_right htent1 (abs_nonneg _)
        _ ≤ localDelta i := by
              simpa using hlocalErr i x hx
    calc
      |productApprox i x -
          tent * reluApproxDecodedTaylorTerm r d (decoded i) (center i) x|
          = |(productApprox i x - tent * localApprox i x) +
              (tent * localApprox i x -
                tent * reluApproxDecodedTaylorTerm r d (decoded i) (center i) x)| := by
              congr 1
              ring
      _ ≤ |productApprox i x - tent * localApprox i x| +
          |tent * localApprox i x -
            tent * reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
              exact abs_add_le _ _
      _ ≤ productDelta + localDelta i := by
              exact add_le_add hprod hlocMul
  have hepsNonneg : ∀ i : Fin T, 0 ≤ productDelta + localDelta i := by
    intro i
    exact add_nonneg hProductDelta_nonneg (hlocalNonneg i)
  have hcomb :=
    finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin T) (d := d) (D0 := Dprod) (W0 := Wprod) (P0 := Pprod)
      hDprod hWprod
      (domain := fun x => x ∈ unitCubeSet d)
      (fun _ => (1 : ℝ))
      (fun i x =>
        axisAlignedBoxTentWeight (center i) (scale i) x *
          reluApproxDecodedTaylorTerm r d (decoded i) (center i) x)
      productApprox
      (fun i => productDelta + localDelta i)
      hepsNonneg hproductClass hpointwise
  rcases hcomb with ⟨D, P, hDpos, hDle, hP, g, hgmem, hgerr⟩
  refine ⟨D, P, hDpos, ?_, hP, g, hgmem, ?_⟩
  · simpa using hDle
  · intro x hx
    simpa [reluApproxCoarseBlockTarget, Finset.sum_add_distrib] using hgerr x hx

private theorem reluApprox_coarseBlock_evaluator_from_local_tent_product_gadgets
    {d r T Dtent Wtent Ptent Dlocal Wlocal Plocal Wmul : ℕ}
    (hDtent : 0 < Dtent) (hWtent : 0 < Wtent) (hDlocal : 0 < Dlocal)
    (hWlocal : 0 < Wlocal) (hWmul : 0 < Wmul)
    {cMulDepth cMulErr ηw R productDelta : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hηw : 0 ≤ ηw) (hR : 0 < R) (hProductDelta_nonneg : 0 ≤ productDelta)
    (nMul : ℕ) (hnMul : 0 < nMul)
    (hProductDelta :
      cMulErr * R ^ 2 * (nMul : ℝ).rpow (-2) + R * ηw ≤ productDelta)
    (hmul : ∀ n : ℕ, 0 < n → ∀ R : ℝ, 0 < R →
      ∃ Dmul Pmul : ℕ,
        0 < Dmul ∧ (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
        Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
        ∃ gmul : (Fin 2 → ℝ) → ℝ,
          gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
          ∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
            |gmul y - y 0 * y 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2))
    (center scale : Fin T → Fin d → ℝ)
    (decoded : Fin T → TaylorMultiindex r d → ℝ)
    (localApprox weightApprox : Fin T → (Fin d → ℝ) → ℝ)
    (localDelta : Fin T → ℝ)
    (hscale : ∀ (i : Fin T) (q : Fin d), 0 ≤ scale i q)
    (hlocalClass :
      ∀ j : Fin T, localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal)
    (hweightClass :
      ∀ j : Fin T, weightApprox j ∈ reluNetworkClass d Dtent Wtent Ptent)
    (hlocalBound : ∀ (j : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d → |localApprox j x| ≤ R)
    (hweightApproxBound : ∀ (j : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d → |weightApprox j x| ≤ R)
    (hweightTargetBound : ∀ (j : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d →
        |axisAlignedBoxTentWeight (center j) (scale j) x| ≤ R)
    (hweightErr : ∀ (j : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d →
        |weightApprox j x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤ ηw)
    (hlocalErr : ∀ (j : Fin T) (x : Fin d → ℝ),
      x ∈ unitCubeSet d →
        |localApprox j x -
          reluApproxDecodedTaylorTerm r d (decoded j) (center j) x| ≤
          localDelta j)
    (hlocalNonneg : ∀ j : Fin T, 0 ≤ localDelta j) :
    ∃ Dprod Pprod D P : ℕ,
      0 < Dprod ∧
      (Dprod : ℝ) ≤ (Dlocal.max Dtent : ℕ) + cMulDepth * (nMul : ℝ) ∧
      Pprod = fullyConnectedReLUParameterCount d Dprod (Wlocal + Wtent + Wmul) ∧
      0 < D ∧ D ≤ (T + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D
        (2 * d + (Wlocal + Wtent + Wmul) + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D
          (2 * d + (Wlocal + Wtent + Wmul) + 3) P ∧
        ∀ x : Fin d → ℝ, x ∈ unitCubeSet d →
          |g x - reluApproxCoarseBlockTarget r d T decoded center scale x| ≤
            (∑ _i : Fin T, productDelta) + (∑ i : Fin T, localDelta i) := by
  rcases finite_axisAligned_tent_weighted_local_products_fixed_width_depth_sum_bound
    hDtent hWtent hDlocal hWlocal hWmul hcMulDepth hcMulErr hηw hR nMul hnMul
    hProductDelta hmul (domain := fun x => x ∈ unitCubeSet d) center scale
    localApprox weightApprox hlocalClass hweightClass hlocalBound hweightApproxBound
    hweightTargetBound hweightErr with
    ⟨Dprod, Pprod, hDprod_pos, hDprod_le, hPprod_eq, productApprox, hprodClass, hprodErr⟩
  let coeff : Fin T → ℝ := fun _ => 1
  let eps : Fin T → ℝ := fun i => productDelta + localDelta i
  have hApproxErr : ∀ (i : Fin T) (x : Fin d → ℝ), x ∈ unitCubeSet d →
      |productApprox i x -
          axisAlignedBoxTentWeight (center i) (scale i) x *
            reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| ≤ eps i := by
    intro i x hx
    have htent01 := axisAlignedBoxTentWeight_bounds_and_support (center i) (scale i) x (hscale i)
    rcases htent01 with ⟨htent_nonneg, htent_le_one, _⟩
    have htent_abs : |axisAlignedBoxTentWeight (center i) (scale i) x| ≤ 1 := by
      rw [abs_of_nonneg htent_nonneg]
      exact htent_le_one
    have hb : |axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x -
          axisAlignedBoxTentWeight (center i) (scale i) x *
            reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| ≤ localDelta i := by
      calc
        |axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x -
            axisAlignedBoxTentWeight (center i) (scale i) x *
              reluApproxDecodedTaylorTerm r d (decoded i) (center i) x|
            = |axisAlignedBoxTentWeight (center i) (scale i) x| *
                |localApprox i x - reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
              rw [← mul_sub, abs_mul]
        _ ≤ 1 * localDelta i := by
              have hm := mul_le_mul htent_abs (hlocalErr i x hx) (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 1)
              nlinarith
        _ = localDelta i := by ring
    calc
      |productApprox i x -
            axisAlignedBoxTentWeight (center i) (scale i) x *
              reluApproxDecodedTaylorTerm r d (decoded i) (center i) x|
          = |(productApprox i x - axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x) +
              (axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x -
                axisAlignedBoxTentWeight (center i) (scale i) x *
                  reluApproxDecodedTaylorTerm r d (decoded i) (center i) x)| := by
            congr 1
            ring
      _ ≤ |productApprox i x - axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x| +
            |axisAlignedBoxTentWeight (center i) (scale i) x * localApprox i x -
                axisAlignedBoxTentWeight (center i) (scale i) x *
                  reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := abs_add_le _ _
      _ ≤ productDelta + localDelta i := by
            nlinarith [hprodErr i x hx, hb]
      _ = eps i := by simp [eps]
  have hEps_nonneg : ∀ i : Fin T, 0 ≤ eps i := by
    intro i
    simpa [eps] using add_nonneg hProductDelta_nonneg (hlocalNonneg i)
  rcases finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
    (ι := Fin T) (D0 := Dprod) (W0 := Wlocal + Wtent + Wmul) (P0 := Pprod)
    hDprod_pos (by positivity : 0 < Wlocal + Wtent + Wmul)
    (domain := fun x => x ∈ unitCubeSet d) coeff
    (fun i x => axisAlignedBoxTentWeight (center i) (scale i) x *
      reluApproxDecodedTaylorTerm r d (decoded i) (center i) x)
    productApprox eps hEps_nonneg hprodClass hApproxErr with
    ⟨D, P, hD_pos, hD_le, hP_eq, g, hgClass, hgErr⟩
  refine ⟨Dprod, Pprod, D, P, hDprod_pos, hDprod_le, hPprod_eq, hD_pos, ?_, hP_eq, g, hgClass, ?_⟩
  · simpa using hD_le
  · intro x hx
    calc
      |g x - reluApproxCoarseBlockTarget r d T decoded center scale x|
          = |g x - ∑ i : Fin T,
              axisAlignedBoxTentWeight (center i) (scale i) x *
                reluApproxDecodedTaylorTerm r d (decoded i) (center i) x| := by
            rfl
      _ ≤ ∑ i : Fin T, (productDelta + localDelta i) := by
            simpa [coeff, eps] using hgErr x hx
      _ = (∑ _i : Fin T, productDelta) + (∑ i : Fin T, localDelta i) := by
            rw [Finset.sum_add_distrib]

/-- Common block approximants with componentwise coefficient, local, and tent
error budgets yield the variable block-error witnesses needed by the
two-scale serial h-state construction. -/
private theorem reluApprox_common_block_witnesses_from_evaluator_errors_and_component_rates
    {coarse T M r d Dsub Wblock Pblock : Nat}
    {beta Kcoeff KlocTent cState productDelta : Real}
    (coeffAccErr : Fin coarse → Real)
    (locErr tentErr : Fin coarse → Fin T → Real)
    (center scale : Fin coarse → Fin T → Fin d → Real)
    (decoded : Fin coarse → Fin T → TaylorMultiindex r d → Real)
    (blockApprox : Fin coarse → (Fin d → Real) → Real)
    (hrate_nonneg : 0 ≤ shallowReLUResolutionRate M r beta)
    (hcoeff_nonneg : ∀ b : Fin coarse, 0 ≤ coeffAccErr b)
    (hloc_nonneg : ∀ (b : Fin coarse) (i : Fin T), 0 ≤ locErr b i)
    (htent_nonneg : ∀ (b : Fin coarse) (i : Fin T), 0 ≤ tentErr b i)
    (hProduct_le_tent : ∀ (b : Fin coarse) (i : Fin T), productDelta ≤ tentErr b i)
    (hCoeffRate :
      Finset.univ.sum (fun b : Fin coarse => coeffAccErr b) ≤
        Kcoeff * shallowReLUResolutionRate M r beta)
    (hLocTentRate :
      Finset.univ.sum (fun b : Fin coarse =>
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) ≤
          KlocTent * shallowReLUResolutionRate M r beta)
    (hcState : Kcoeff + KlocTent ≤ cState)
    (hclass : ∀ b : Fin coarse, blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herrBase : ∀ b : Fin coarse, ∀ x : Fin d → Real,
      x ∈ unitCubeSet d →
        |blockApprox b x - reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x| ≤
          (Finset.univ.sum (fun _i : Fin T => productDelta)) +
            (Finset.univ.sum (fun i : Fin T => locErr b i))) :
    (∀ b : Fin coarse, 0 ≤ reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ∧
    (∀ b : Fin coarse,
        blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock ∧
        ∀ x : Fin d → Real, x ∈ unitCubeSet d →
          |blockApprox b x - reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x| ≤
            reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ∧
    Finset.univ.sum (fun b : Fin coarse =>
        reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ≤
      cState * shallowReLUResolutionRate M r beta := by
  have h_blockRate : (∀ b : Fin coarse, 0 ≤ reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ∧
      Finset.univ.sum (fun b : Fin coarse =>
          reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b) ≤
        cState * shallowReLUResolutionRate M r beta := by
    exact Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.reluApprox_blockDeltaSum_rate_from_component_rates
      coeffAccErr locErr tentErr hrate_nonneg hcoeff_nonneg hloc_nonneg htent_nonneg hCoeffRate hLocTentRate hcState
  have h_blockErr : ∀ b : Fin coarse,
      blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock ∧
      ∀ x : Fin d → Real, x ∈ unitCubeSet d →
        |blockApprox b x - reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x| ≤
          reluApproxBlockDeltaSum coarse T coeffAccErr locErr tentErr b := by
    intro b
    constructor
    · exact hclass b
    · intro x hx
      have hraw := herrBase b x hx
      have hPt :
          Finset.univ.sum (fun _i : Fin T => productDelta) ≤
            Finset.univ.sum (fun i : Fin T => tentErr b i) := by
        apply Finset.sum_le_sum
        intro i _hi
        exact hProduct_le_tent b i
      have hsum_regroup :
          Finset.univ.sum (fun i : Fin T => tentErr b i) +
            Finset.univ.sum (fun i : Fin T => locErr b i) =
          Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i) := by
        rw [add_comm, ← Finset.sum_add_distrib]
      have hbridge :
          Finset.univ.sum (fun _i : Fin T => productDelta) +
            Finset.univ.sum (fun i : Fin T => locErr b i) ≤
          coeffAccErr b +
            Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i) := by
        linarith [hPt, hsum_regroup, hcoeff_nonneg b]
      exact le_trans hraw hbridge
  exact ⟨h_blockRate.1, ⟨h_blockErr, h_blockRate.2⟩⟩

/-- Variable block-error witnesses can be serially assembled into the
two-scale fine-grid h-state approximation with the same global budget. -/
private theorem reluApprox_blockwiseFineGrid_hstate_from_variable_block_witnesses
    {d r M T Dsub Wblock Pblock Dblock : Nat} {beta cState : Real}
    (hM : 0 < M) (hDsub : 0 < Dsub) (hWblock : 0 < Wblock) (hDblock : 0 < Dblock)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (center scale : Fin (M ^ d) -> Fin T -> Fin d -> Real)
    (decoded : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real)
    (blockDelta : Fin (M ^ d) -> Real)
    (blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real)
    (hblockDelta_nonneg : forall b : Fin (M ^ d), 0 <= blockDelta b)
    (hclass : forall b : Fin (M ^ d),
      blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herr : forall b : Fin (M ^ d), forall x : Fin d -> Real,
      x ∈ unitCubeSet d ->
        |blockApprox b x -
          reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x|
          <= blockDelta b)
    (hbudget :
      Finset.univ.sum (fun b : Fin (M ^ d) => blockDelta b) <=
        cState * shallowReLUResolutionRate M r beta) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real, x ∈ unitCubeSet d ->
          |g x -
            reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decoded center scale x|
            <= cState * shallowReLUResolutionRate M r beta := by
  let target : Fin (M ^ d) -> (Fin d -> Real) -> Real :=
    fun b x => reluApproxCoarseBlockTarget r d T (decoded b) (center b) (scale b) x
  let domain : (Fin d -> Real) -> Prop :=
    fun x => x ∈ unitCubeSet d
  rcases finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin (M ^ d)) (d := d) (D0 := Dsub) (W0 := Wblock) (P0 := Pblock)
      (domain := domain) (coeff := fun _ => (1 : Real)) (target := target)
      (approx := blockApprox) (eps := fun b => blockDelta b)
      hDsub hWblock hblockDelta_nonneg hclass herr with
    ⟨D0', P0', hD0pos, hD0bound, hP0def, g0, hg0mem, hg0err⟩
  have hcard : Fintype.card (Fin (M ^ d)) = M ^ d := by
    simp
  have hD0bound' : D0' <= (M ^ d + 1) * (Dsub + 1) := by
    simpa [hcard] using hD0bound
  have hD0leD : D0' <= M ^ d * (Dblock + 1) :=
    fixed_width_block_depth_padding_from_subblock_depth_bound (d := d) (M := M) (D := D0')
      (Dprod := Dsub) (Dblock := Dblock) hM hD0bound' hdepthPad
  have hPmono : fullyConnectedReLUParameterCount d D0' (2 * d + Wblock + 3) <=
      fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3) := by
    unfold fullyConnectedReLUParameterCount
    apply Nat.add_le_add_right
    apply Nat.add_le_add_left
    apply Nat.mul_le_mul_right
    exact Nat.sub_le_sub_right hD0leD 1
  have hDpos : 0 < M ^ d * (Dblock + 1) := by
    exact mul_pos (pow_pos hM d) (Nat.succ_pos Dblock)
  have hg0mem' : g0 ∈ reluNetworkClass d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3)
      (fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3)) := by
    rcases hg0mem with ⟨N, hNpos, hNdepth, hNwidth, hNpar, hNrealize⟩
    refine ⟨N, hNpos, le_trans hNdepth hD0leD, hNwidth, ?_, hNrealize⟩
    calc
      N.parameterCount <= P0' := hNpar
      _ = fullyConnectedReLUParameterCount d D0' (2 * d + Wblock + 3) := hP0def
      _ <= fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3) := hPmono
  have hg0err' : forall x : Fin d -> Real, x ∈ unitCubeSet d ->
      |g0 x - Finset.univ.sum (fun j : Fin (M ^ d) => target j x)| <=
        Finset.univ.sum (fun j : Fin (M ^ d) => blockDelta j) := by
    intro x hx
    simpa [target, domain] using hg0err x hx
  have herr' : forall x : Fin d -> Real, x ∈ unitCubeSet d ->
      |g0 x - reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decoded center scale x| <=
        cState * shallowReLUResolutionRate M r beta := by
    intro x hx
    simpa [reluApproxFineGridDecodedTaylorSum] using le_trans (hg0err' x hx) hbudget
  exact ⟨M ^ d * (Dblock + 1),
    fullyConnectedReLUParameterCount d (M ^ d * (Dblock + 1)) (2 * d + Wblock + 3),
    rfl, hDpos, rfl, g0, hg0mem', herr'⟩

/-- Common-depth block approximants from per-block evaluator existentials.

Suppose for every coarse block `b` there is a fully connected ReLU evaluator of
width `Wblock` and depth at most `Dsub` that approximates `target b` on `domain`
with error `rawErr b`.  Then the chosen evaluators can be packaged as one
`blockApprox` family whose every member belongs to
`reluNetworkClass d Dsub Wblock Pblock` and keeps the same pointwise error
bound. -/
private theorem reluApprox_common_depth_blockApprox_from_per_block_evaluator_exists
    {coarse d Dsub Wblock Pblock : Nat}
    {rawErr : Fin coarse -> Real}
    {target : Fin coarse -> (Fin d -> Real) -> Real}
    {domain : (Fin d -> Real) -> Prop}
    (hPblock : Pblock = fullyConnectedReLUParameterCount d Dsub Wblock)
    (hper : forall b : Fin coarse,
      exists Db Pb : Nat,
        0 < Db /\
        Db <= Dsub /\
        Pb = fullyConnectedReLUParameterCount d Db Wblock /\
        exists gb : (Fin d -> Real) -> Real,
          gb ∈ reluNetworkClass d Db Wblock Pb /\
          forall x : Fin d -> Real, domain x ->
            |gb x - target b x| <= rawErr b) :
    exists blockApprox : Fin coarse -> (Fin d -> Real) -> Real,
      (forall b : Fin coarse,
        blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock) /\
      forall b : Fin coarse, forall x : Fin d -> Real, domain x ->
        |blockApprox b x - target b x| <= rawErr b := by
  have h_param_mono : ∀ {Da Db : Nat}, Da ≤ Db →
      fullyConnectedReLUParameterCount d Da Wblock ≤
        fullyConnectedReLUParameterCount d Db Wblock := by
    intro Da Db hDaDb
    unfold fullyConnectedReLUParameterCount
    exact add_le_add_left
      (add_le_add_right
        (Nat.mul_le_mul_right ((Wblock + 1) * Wblock) (Nat.sub_le_sub_right hDaDb 1))
        ((d + 1) * Wblock))
      (Wblock + 1)
  have h_per_block : ∀ b : Fin coarse,
      ∃ f : (Fin d → Real) → Real,
        f ∈ reluNetworkClass d Dsub Wblock Pblock ∧
          ∀ x : Fin d → Real, domain x → |f x - target b x| ≤ rawErr b := by
    intro b
    rcases hper b with ⟨Db, Pb, _hposDb, hDbDsub, hPb, gb, hmem, hErr⟩
    refine ⟨gb, ?_, ?_⟩
    · rcases hmem with ⟨N, hpos, hdepth, hwidth, hparam, hreal⟩
      refine ⟨N, hpos, ?_, hwidth, ?_, hreal⟩
      · exact le_trans hdepth hDbDsub
      · calc
          N.parameterCount ≤ Pb := hparam
          _ = fullyConnectedReLUParameterCount d Db Wblock := hPb
          _ ≤ fullyConnectedReLUParameterCount d Dsub Wblock := h_param_mono hDbDsub
          _ = Pblock := hPblock.symm
    · exact hErr
  exact
    ⟨fun b => Classical.choose (h_per_block b),
      ⟨fun b => (Classical.choose_spec (h_per_block b)).1,
        fun b x hx => (Classical.choose_spec (h_per_block b)).2 x hx⟩⟩

/-- Flat fine-grid hstate from variable coarse-block witnesses.

Suppose the flat fine-grid decoded Taylor/tent target used by the final
shallow ReLU hstate premise is equal on the unit cube to a finite sum of
`M^d` coarse-block targets.  If each coarse-block target has a common-class
ReLU approximant with block-specific error `blockDelta b`, and the sum of all
`blockDelta b` is bounded by `cState * shallowReLUResolutionRate M r beta`, then one
serial fully connected ReLU network of exact depth `M^d*(Dblock+1)` and width
`2*d+Wblock+3` approximates the flat fine-grid target with the same total error
budget. -/
private theorem reluApprox_flatFineGrid_hstate_from_variable_coarse_block_witnesses
    {d r M Dsub Wblock Pblock Dblock : Nat}
    {beta cState : Real}
    (hM : 0 < M)
    (hDsub : 0 < Dsub)
    (hWblock : 0 < Wblock)
    (_hDblock : 0 < Dblock)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real)
    (decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real)
    (blockTarget blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real)
    (blockDelta : Fin (M ^ d) -> Real)
    (hdecomp :
      forall x : Fin d -> Real, x ∈ unitCubeSet d ->
        Finset.univ.sum (fun b : Fin (M ^ d) => blockTarget b x) =
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x *
              finiteLinearCombination Finset.univ (decoded j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x))
    (hblockDelta_nonneg : forall b : Fin (M ^ d), 0 <= blockDelta b)
    (hclass : forall b : Fin (M ^ d),
      blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herr : forall b : Fin (M ^ d), forall x : Fin d -> Real,
      x ∈ unitCubeSet d ->
        |blockApprox b x - blockTarget b x| <= blockDelta b)
    (hbudget :
      Finset.univ.sum (fun b : Fin (M ^ d) => blockDelta b) <=
        cState * shallowReLUResolutionRate M r beta) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real, x ∈ unitCubeSet d ->
          |g x -
            Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
              axisAlignedBoxTentWeight (center j) (scale j) x *
                finiteLinearCombination Finset.univ (decoded j)
                  (fun a y => Finset.univ.prod
                    (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x)|
            <= cState * shallowReLUResolutionRate M r beta := by
  rcases (finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin (M ^ d)) (d := d) (D0 := Dsub) (W0 := Wblock) (P0 := Pblock)
      hDsub hWblock
      (domain := fun x : Fin d → ℝ => x ∈ unitCubeSet d)
      (fun _ : Fin (M ^ d) => (1 : ℝ)) blockTarget blockApprox blockDelta
      hblockDelta_nonneg hclass herr) with
    ⟨Dser, Pser, _hDser_pos, hDser_depth, hPser, gser, hgser_mem, hgser_err⟩
  let D : ℕ := M ^ d * (Dblock + 1)
  let w : ℕ := 2 * d + Wblock + 3
  have hDser_depth' : Dser ≤ (M ^ d + 1) * (Dsub + 1) := by
    simpa [Fintype.card_fin] using hDser_depth
  have hDser_le_D : Dser ≤ D := by
    dsimp [D]
    exact fixed_width_block_depth_padding_from_subblock_depth_bound (D := Dser) (Dprod := Dsub)
      hM hDser_depth' hdepthPad
  have hPC_le :
      fullyConnectedReLUParameterCount d Dser w ≤ fullyConnectedReLUParameterCount d D w := by
    unfold fullyConnectedReLUParameterCount
    have hsub₁ : Dser - 1 ≤ D - 1 := by omega
    have hmul₁ : (Dser - 1) * ((w + 1) * w) ≤ (D - 1) * ((w + 1) * w) := by
      exact Nat.mul_le_mul_right ((w + 1) * w) hsub₁
    linarith
  have hgser_mem_D : gser ∈ reluNetworkClass d D w (fullyConnectedReLUParameterCount d D w) := by
    rcases hgser_mem with ⟨N, hNpos, hNdepth, hNwidth, hNparam, hNrealize⟩
    refine ⟨N, hNpos, ?_, hNwidth, ?_, hNrealize⟩
    · exact le_trans hNdepth hDser_le_D
    · calc
        N.parameterCount ≤ Pser := hNparam
        _ = fullyConnectedReLUParameterCount d Dser w := hPser
        _ ≤ fullyConnectedReLUParameterCount d D w := hPC_le
  have hgser_err_D : ∀ x : Fin d → ℝ, x ∈ unitCubeSet d →
      |gser x - Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
          axisAlignedBoxTentWeight (center j) (scale j) x *
            finiteLinearCombination Finset.univ (decoded j)
              (fun a y => Finset.univ.prod
                (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x)|
          ≤ cState * shallowReLUResolutionRate M r beta := by
    intro x hx
    have h₁ :
        |gser x - Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x *
              finiteLinearCombination Finset.univ (decoded j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x)|
          ≤ Finset.univ.sum (fun b : Fin (M ^ d) => blockDelta b) := by
      rw [← hdecomp x hx]
      simpa using hgser_err x hx
    exact le_trans h₁ hbudget
  refine ⟨D, fullyConnectedReLUParameterCount d D w, rfl, ?_, rfl, gser, hgser_mem_D, hgser_err_D⟩
  · dsimp [D]
    exact mul_pos (pow_pos hM d) (Nat.succ_pos Dblock)

/-- Common block evaluator errors and component rates give the flat-index
hstate shape needed by the shallow ReLU final display-rate wrapper. -/
private theorem reluApprox_flatFineGrid_hstate_from_common_block_evaluator_errors_and_component_rates
    {T M r d Dsub Wblock Pblock Dblock : Nat}
    {beta Kcoeff KlocTent cState productDelta : Real}
    (hM : 0 < M)
    (hDsub : 0 < Dsub)
    (hWblock : 0 < Wblock)
    (hDblock : 0 < Dblock)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (coeffAccErr : Fin (M ^ d) -> Real)
    (locErr tentErr : Fin (M ^ d) -> Fin T -> Real)
    (centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real)
    (decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real)
    (centerFlat scaleFlat : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real)
    (decodedFlat : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real)
    (blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real)
    (hrate_nonneg : 0 <= shallowReLUResolutionRate M r beta)
    (hcoeff_nonneg : forall b : Fin (M ^ d), 0 <= coeffAccErr b)
    (hloc_nonneg : forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i)
    (htent_nonneg : forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i)
    (hProduct_le_tent : forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i)
    (hCoeffRate :
      Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
        Kcoeff * shallowReLUResolutionRate M r beta)
    (hLocTentRate :
      Finset.univ.sum (fun b : Fin (M ^ d) =>
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
          KlocTent * shallowReLUResolutionRate M r beta)
    (hcState : Kcoeff + KlocTent <= cState)
    (hclass :
      forall b : Fin (M ^ d), blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herrBase :
      forall b : Fin (M ^ d), forall x : Fin d -> Real,
        x ∈ unitCubeSet d ->
          |blockApprox b x -
            reluApproxCoarseBlockTarget r d T (decodedBlock b) (centerBlock b)
              (scaleBlock b) x| <=
            (Finset.univ.sum (fun _i : Fin T => productDelta)) +
              (Finset.univ.sum (fun i : Fin T => locErr b i)))
    (hdecomp :
      forall x : Fin d -> Real, x ∈ unitCubeSet d ->
        reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decodedBlock centerBlock
            scaleBlock x =
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
              finiteLinearCombination Finset.univ (decodedFlat j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x)) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real, x ∈ unitCubeSet d ->
          |g x -
            Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
              axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
                finiteLinearCombination Finset.univ (decodedFlat j)
                  (fun a y => Finset.univ.prod
                    (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x)|
            <= cState * shallowReLUResolutionRate M r beta := by
  have hCommon :=
    reluApprox_common_block_witnesses_from_evaluator_errors_and_component_rates (coarse := M ^ d)
      coeffAccErr locErr tentErr centerBlock scaleBlock decodedBlock blockApprox hrate_nonneg
      hcoeff_nonneg hloc_nonneg htent_nonneg hProduct_le_tent hCoeffRate hLocTentRate hcState
      hclass herrBase
  have hDelta_nonneg := hCommon.1
  have hDelta_info := hCommon.2.1
  have hDelta_budget := hCommon.2.2
  have hDelta_class := fun b : Fin (M ^ d) => (hDelta_info b).1
  have hDelta_err :=
    fun (b : Fin (M ^ d)) (x : Fin d → Real) (hx : x ∈ unitCubeSet d) =>
      (hDelta_info b).2 x hx
  have hBlockwise :=
    reluApprox_blockwiseFineGrid_hstate_from_variable_block_witnesses hM hDsub hWblock hDblock
      hdepthPad centerBlock scaleBlock decodedBlock
      (fun b : Fin (M ^ d) => reluApproxBlockDeltaSum (M ^ d) T coeffAccErr locErr tentErr b)
      blockApprox hDelta_nonneg hDelta_class hDelta_err hDelta_budget
  rcases hBlockwise with ⟨D, P, hDdef, hDpos, hPdef, g, hgclass, hgbound⟩
  refine ⟨D, P, hDdef, hDpos, hPdef, g, hgclass, ?_⟩
  intro x hx
  rw [← hdecomp x hx]
  exact hgbound x hx

/-- A `phi`-state readout is realized by a fully connected ReLU network whose
hidden state follows the prescribed layer recursion. -/
private def reluApproxPhiFollowsLayerRecursion
    (d : ℕ) (readout : (Fin d → ℝ) → ℝ) : Prop :=
  ∃ (N : FullyConnectedReLUNet d) (S : ℕ → (Fin d → ℝ) → Fin N.width → ℝ),
    0 < N.depth ∧
    (∀ x : Fin d → ℝ, S 0 x = N.input.reluApply x) ∧
    (∀ (t : ℕ) (ht : t < N.depth - 1) (x : Fin d → ℝ),
      S (t + 1) x = (N.hidden ⟨t, ht⟩).reluApply (S t x)) ∧
    (∀ (x : Fin d → ℝ) (t : ℕ), t ≤ N.depth - 1 → S t x = N.hiddenState x t) ∧
    (∀ x : Fin d → ℝ, readout x = N.realize x)

/-- Selection-accumulator recursion for one coarse block over `T` fine cells. -/
private def reluApproxSelectionAccumulatorRecursion (r d T : ℕ)
    (fineCenter : Fin T → Fin d → ℝ)
    (fineDecoded : Fin T → TaylorMultiindex r d → ℝ) : Prop :=
  ∃ (iActive : Fin T) (ind : Fin T → ℝ),
    ind iActive = 1 ∧
    (∀ i : Fin T, i ≠ iActive → ind i = 0) ∧
    (∃ selPhi5 : ℕ → Fin d → ℝ,
      (∀ q : Fin d, selPhi5 0 q = 0) ∧
      (∀ (n : Fin T) (q : Fin d),
        selPhi5 (n.val + 1) q = selPhi5 n.val q + ind n * fineCenter n q) ∧
      (∀ q : Fin d, selPhi5 T q = fineCenter iActive q)) ∧
    (∃ selPhi6 : ℕ → TaylorMultiindex r d → ℝ,
      (∀ a : TaylorMultiindex r d, selPhi6 0 a = 0) ∧
      (∀ (n : Fin T) (a : TaylorMultiindex r d),
        selPhi6 (n.val + 1) a = selPhi6 n.val a + ind n * fineDecoded n a) ∧
      (∀ a : TaylorMultiindex r d, selPhi6 T a = fineDecoded iActive a))

/-- Taylor-coefficient recursion certificate for one coarse block. -/
private def reluApproxTaylorCoeffRecursionCertificate
    (M r d T : ℕ) (beta : ℝ) (a0 : TaylorMultiindex r d)
    (fineDecoded : Fin T → TaylorMultiindex r d → ℝ)
    (thetaTrue : TaylorMultiindex r d → ℝ) (coeffErr : ℝ) : Prop :=
  ∃ Phi : ℕ → TaylorMultiindex r d → ℝ,
    (∀ a : TaylorMultiindex r d, Phi 0 a = 0) ∧
    (∀ (n : Fin T) (a : TaylorMultiindex r d),
      Phi (n.val + 1) a = Phi n.val a + fineDecoded n a) ∧
    (∀ a : TaylorMultiindex r d, Phi T a = ∑ i : Fin T, fineDecoded i a) ∧
    |Phi T a0 - thetaTrue a0| ≤ coeffErr * shallowReLUResolutionRate M r beta

/-- If each coarse block is approximated by a fixed-width subnetwork and the
sum of block errors is budgeted at the two-scale shallow ReLU rate, then the
serial fixed-width construction approximates the full fine-grid Taylor/tent
expansion. -/
private theorem reluApprox_twoScale_hstate_from_coarse_block_witnesses
    {d r M Dsub Wblock Pblock Dblock : Nat}
    {beta cState blockDelta : Real}
    (hM : 0 < M)
    (hDsub : 0 < Dsub)
    (hWblock : 0 < Wblock)
    (hDblock : 0 < Dblock)
    (hblockDelta_nonneg : 0 <= blockDelta)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real)
    (decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real)
    (blockTarget blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real)
    (hdecomp :
      forall x : Fin d -> Real,
        (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
          Finset.univ.sum (fun b : Fin (M ^ d) => blockTarget b x) =
            Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
              axisAlignedBoxTentWeight (center j) (scale j) x *
                finiteLinearCombination Finset.univ (decoded j)
                  (fun a y => Finset.univ.prod (fun q : Fin a.1.val =>
                    y (a.2 q) - center j (a.2 q))) x))
    (hclass : forall b : Fin (M ^ d),
      blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock)
    (herr : forall b : Fin (M ^ d),
      forall x : Fin d -> Real,
        (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
          |blockApprox b x - blockTarget b x| <= blockDelta)
    (hbudget :
      Finset.univ.sum (fun _b : Fin (M ^ d) => blockDelta) <=
        cState * (M : Real).rpow (-(2 * ((r : Real) + beta)))) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real,
          (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
            |g x -
                Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                  axisAlignedBoxTentWeight (center j) (scale j) x *
                    finiteLinearCombination Finset.univ (decoded j)
                      (fun a y => Finset.univ.prod (fun q : Fin a.1.val =>
                        y (a.2 q) - center j (a.2 q))) x)|
              <= cState * (M : Real).rpow (-(2 * ((r : Real) + beta))) := by
  have hcard : Fintype.card (Fin (M ^ d)) = M ^ d := by simp
  obtain ⟨Dser, Pser, hDser_pos, hDser_le, hPser, g, hg_mem, hg_err⟩ :=
    finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin (M ^ d)) (D0 := Dsub) (W0 := Wblock) (P0 := Pblock)
      (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
      (coeff := fun _ : Fin (M ^ d) => (1 : ℝ)) (target := blockTarget)
      (approx := blockApprox) (eps := fun _ : Fin (M ^ d) => blockDelta)
      hDsub hWblock (by intro b; exact hblockDelta_nonneg) hclass herr
  have hser_depth : Dser ≤ (M ^ d + 1) * (Dsub + 1) := by
    simpa [hcard] using hDser_le
  have hDser_le_padded : Dser ≤ (M ^ d) * (Dblock + 1) :=
    fixed_width_block_depth_padding_from_subblock_depth_bound hM hser_depth hdepthPad
  have hparam_mono_width : ∀ (w D1 D2 : ℕ), D1 ≤ D2 →
      fullyConnectedReLUParameterCount d D1 w ≤ fullyConnectedReLUParameterCount d D2 w := by
    intro w D1 D2 hle
    unfold fullyConnectedReLUParameterCount
    exact Nat.add_le_add_right
      (Nat.add_le_add_left (Nat.mul_le_mul_right ((w + 1) * w) (Nat.sub_le_sub_right hle 1))
        ((d + 1) * w)) (w + 1)
  have hg_mem_fin : g ∈ reluNetworkClass d ((M ^ d) * (Dblock + 1)) (2 * d + Wblock + 3)
      (fullyConnectedReLUParameterCount d ((M ^ d) * (Dblock + 1)) (2 * d + Wblock + 3)) := by
    rcases hg_mem with ⟨N, hN_pos, hN_depth, hN_width, hN_param, hN_realize⟩
    refine ⟨N, hN_pos, le_trans hN_depth hDser_le_padded, hN_width, ?_, hN_realize⟩
    have hN_param' : N.parameterCount ≤
        fullyConnectedReLUParameterCount d Dser (2 * d + Wblock + 3) := by
      simpa [hPser] using hN_param
    exact le_trans hN_param'
      (hparam_mono_width (2 * d + Wblock + 3) Dser ((M ^ d) * (Dblock + 1)) hDser_le_padded)
  have hserr : ∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      |g x - Finset.univ.sum (fun b : Fin (M ^ d) => blockTarget b x)| ≤
        cState * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
    intro x hx
    have hg := hg_err x hx
    have hg' : |g x - Finset.univ.sum (fun b : Fin (M ^ d) => blockTarget b x)| ≤
        Finset.univ.sum (fun _b : Fin (M ^ d) => blockDelta) := by
      simpa using hg
    exact le_trans hg' hbudget
  refine ⟨(M ^ d) * (Dblock + 1),
    fullyConnectedReLUParameterCount d ((M ^ d) * (Dblock + 1)) (2 * d + Wblock + 3),
    rfl, by positivity, rfl, ⟨g, hg_mem_fin, ?_⟩⟩
  intro x hx
  calc
    |g x -
        Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
          axisAlignedBoxTentWeight (center j) (scale j) x *
            finiteLinearCombination Finset.univ (decoded j)
              (fun a y => Finset.univ.prod (fun q : Fin a.1.val =>
                y (a.2 q) - center j (a.2 q))) x)| =
      |g x - Finset.univ.sum (fun b : Fin (M ^ d) => blockTarget b x)| := by
        rw [← hdecomp x hx]
    _ ≤ cState * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := hserr x hx

/-- Block/fine equivalence gives the flat fine-grid decoded Taylor sum. -/
private theorem reluApproxFineGridDecodedTaylorSum_eq_flat_sum_of_block_equiv
    {M r d T : Nat}
    (eBlock : Fin (M ^ d) × Fin T ≃ Fin (((M ^ 2) + 1) ^ d))
    (centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real)
    (decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real)
    (centerFlat scaleFlat : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real)
    (decodedFlat : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real)
    (hcenter : forall (b : Fin (M ^ d)) (i : Fin T),
      centerFlat (eBlock (b, i)) = centerBlock b i)
    (hscale : forall (b : Fin (M ^ d)) (i : Fin T),
      scaleFlat (eBlock (b, i)) = scaleBlock b i)
    (hdecoded : forall (b : Fin (M ^ d)) (i : Fin T),
      decodedFlat (eBlock (b, i)) = decodedBlock b i) :
    forall x : Fin d -> Real, x ∈ unitCubeSet d ->
      reluApproxFineGridDecodedTaylorSum r d (M ^ d) T
          decodedBlock centerBlock scaleBlock x =
        Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
          axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
            finiteLinearCombination Finset.univ (decodedFlat j)
              (fun a y => Finset.univ.prod
                (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x) := by
  intro x hx
  calc
    reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decodedBlock centerBlock scaleBlock x
        = ∑ b : Fin (M ^ d), ∑ i : Fin T,
            axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x *
              (∑ a : TaylorMultiindex r d,
                decodedBlock b i a * ∏ q : Fin a.1.val, (x (a.2 q) - centerBlock b i (a.2 q))) := by
          unfold reluApproxFineGridDecodedTaylorSum reluApproxCoarseBlockTarget
            reluApproxDecodedTaylorTerm
          rfl
    _ = ∑ b : Fin (M ^ d), ∑ i : Fin T,
          axisAlignedBoxTentWeight (centerFlat (eBlock (b, i))) (scaleFlat (eBlock (b, i))) x *
            (∑ a : TaylorMultiindex r d,
              decodedFlat (eBlock (b, i)) a *
                ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat (eBlock (b, i)) (a.2 q))) := by
          apply Finset.sum_congr rfl
          intro b hb
          apply Finset.sum_congr rfl
          intro i hi
          rw [← hscale b i, ← hcenter b i, ← hdecoded b i]
    _ = ∑ p : (Fin (M ^ d) × Fin T),
          axisAlignedBoxTentWeight (centerFlat (eBlock p)) (scaleFlat (eBlock p)) x *
            (∑ a : TaylorMultiindex r d,
              decodedFlat (eBlock p) a *
                ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat (eBlock p) (a.2 q))) := by
          exact (Fintype.sum_prod_type
            (fun p : Fin (M ^ d) × Fin T =>
              axisAlignedBoxTentWeight (centerFlat (eBlock p)) (scaleFlat (eBlock p)) x *
                (∑ a : TaylorMultiindex r d,
                  decodedFlat (eBlock p) a *
                    ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat (eBlock p) (a.2 q))))).symm
    _ = ∑ j : Fin (((M ^ 2) + 1) ^ d),
          axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
            (∑ a : TaylorMultiindex r d,
              decodedFlat j a * ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat j (a.2 q))) := by
          exact Fintype.sum_equiv eBlock
            (fun p : Fin (M ^ d) × Fin T =>
              axisAlignedBoxTentWeight (centerFlat (eBlock p)) (scaleFlat (eBlock p)) x *
                (∑ a : TaylorMultiindex r d,
                  decodedFlat (eBlock p) a *
                    ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat (eBlock p) (a.2 q))))
            (fun j : Fin (((M ^ 2) + 1) ^ d) =>
              axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
                (∑ a : TaylorMultiindex r d,
                  decodedFlat j a * ∏ q : Fin a.1.val, (x (a.2 q) - centerFlat j (a.2 q))))
            (fun p => rfl)
    _ = Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
          axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
            finiteLinearCombination Finset.univ (decodedFlat j)
              (fun a y => Finset.univ.prod
                (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x) := by
          apply Finset.sum_congr rfl
          intro j hj
          rw [finiteLinearCombination]

/-- Flat fine-grid hstate from per-block evaluator existentials and component rates. -/
private theorem reluApprox_flatFineGrid_hstate_from_per_block_evaluator_exists_and_component_rates
    {T M r d Dsub Wblock Pblock Dblock : Nat}
    {beta Kcoeff KlocTent cState productDelta : Real}
    (hM : 0 < M)
    (hDsub : 0 < Dsub)
    (hWblock : 0 < Wblock)
    (hDblock : 0 < Dblock)
    (hPblock : Pblock = fullyConnectedReLUParameterCount d Dsub Wblock)
    (hdepthPad : 2 * (Dsub + 1) <= Dblock + 1)
    (coeffAccErr : Fin (M ^ d) -> Real)
    (locErr tentErr : Fin (M ^ d) -> Fin T -> Real)
    (centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real)
    (decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real)
    (centerFlat scaleFlat : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real)
    (decodedFlat : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real)
    (hrate_nonneg : 0 <= shallowReLUResolutionRate M r beta)
    (hcoeff_nonneg : forall b : Fin (M ^ d), 0 <= coeffAccErr b)
    (hloc_nonneg : forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i)
    (htent_nonneg : forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i)
    (hProduct_le_tent : forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i)
    (hCoeffRate : Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
      Kcoeff * shallowReLUResolutionRate M r beta)
    (hLocTentRate :
      Finset.univ.sum (fun b : Fin (M ^ d) =>
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
        KlocTent * shallowReLUResolutionRate M r beta)
    (hcState : Kcoeff + KlocTent <= cState)
    (hper : forall b : Fin (M ^ d),
      exists Db Pb : Nat,
        0 < Db /\
        Db <= Dsub /\
        Pb = fullyConnectedReLUParameterCount d Db Wblock /\
        exists gb : (Fin d -> Real) -> Real,
          gb ∈ reluNetworkClass d Db Wblock Pb /\
          forall x : Fin d -> Real, x ∈ unitCubeSet d ->
            |gb x -
              reluApproxCoarseBlockTarget r d T
                (decodedBlock b) (centerBlock b) (scaleBlock b) x| <=
              (Finset.univ.sum (fun _i : Fin T => productDelta)) +
                (Finset.univ.sum (fun i : Fin T => locErr b i)))
    (hdecomp :
      forall x : Fin d -> Real, x ∈ unitCubeSet d ->
        reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decodedBlock centerBlock scaleBlock x =
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
              finiteLinearCombination Finset.univ (decodedFlat j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x)) :
    exists D P : Nat,
      D = (M ^ d) * (Dblock + 1) /\
      0 < D /\
      P = fullyConnectedReLUParameterCount d D (2 * d + Wblock + 3) /\
      exists g : (Fin d -> Real) -> Real,
        g ∈ reluNetworkClass d D (2 * d + Wblock + 3) P /\
        forall x : Fin d -> Real, x ∈ unitCubeSet d ->
          |g x -
            Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
              axisAlignedBoxTentWeight (centerFlat j) (scaleFlat j) x *
                finiteLinearCombination Finset.univ (decodedFlat j)
                  (fun a y => Finset.univ.prod
                    (fun q : Fin a.1.val => y (a.2 q) - centerFlat j (a.2 q))) x)|
            <= cState * shallowReLUResolutionRate M r beta := by
  rcases reluApprox_common_depth_blockApprox_from_per_block_evaluator_exists
      (coarse := M ^ d) (d := d) (Dsub := Dsub) (Wblock := Wblock) (Pblock := Pblock)
      (rawErr := fun b : Fin (M ^ d) =>
        (Finset.univ.sum (fun _i : Fin T => productDelta)) +
          (Finset.univ.sum (fun i : Fin T => locErr b i)))
      (target := fun b : Fin (M ^ d) =>
        reluApproxCoarseBlockTarget r d T (decodedBlock b) (centerBlock b) (scaleBlock b))
      (domain := fun x : Fin d -> Real => x ∈ unitCubeSet d)
      hPblock hper with ⟨blockApprox, hBlockClass, hBlockErr⟩
  exact reluApprox_flatFineGrid_hstate_from_common_block_evaluator_errors_and_component_rates
    (T := T) (M := M) (r := r) (d := d) (Dsub := Dsub) (Wblock := Wblock) (Pblock := Pblock)
    (Dblock := Dblock) (beta := beta) (Kcoeff := Kcoeff) (KlocTent := KlocTent)
    (cState := cState) (productDelta := productDelta)
    hM hDsub hWblock hDblock hdepthPad coeffAccErr locErr tentErr centerBlock scaleBlock decodedBlock
      centerFlat scaleFlat decodedFlat blockApprox
    hrate_nonneg hcoeff_nonneg hloc_nonneg htent_nonneg hProduct_le_tent hCoeffRate hLocTentRate
      hcState hBlockClass hBlockErr hdecomp

/-- Exact final hstate from a common block component schedule. -/
private theorem reluApprox_final_hstate_from_common_block_component_schedule
    {d r W0 Dblock : Nat} {beta A cState : Real}
    (hDblock : 0 < Dblock)
    (hschedule :
      ∀ (M N Q base code floorBound : Nat) (eta Rdec : Real),
        0 < M ->
        0 < eta ->
        0 < Q ->
        2 * A / (Q : Real) <= eta ->
        Q + 1 <= base ->
        2 <= Rdec ->
        ∀ e : (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
        ∀ center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
          (∀ (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
          (∀ (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
            center j q ∈ Set.Icc (0 : Real) 1) ->
          (∀ x : Fin d -> Real,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
              Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
          ∀ digit : Fin N -> Nat,
            (∀ k : Fin N, digit k <= Q) ->
            (∀ k : Fin N, digit k < base) ->
            code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
            floorBound = code + 1 ->
            ∀ decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
              (∀ j a,
                decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
              (∀ j a, |decoded j a| <= A + eta) ->
              ((fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
                  reluNetworkClass 1 1 (2 * floorBound)
                    (fullyConnectedReLUParameterCount 1 1 (2 * floorBound))) ->
              (∀ k : Fin N,
                let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real);
                0 <= readout /\
                  readout < (floorBound : Real) + 1 /\
                  awayFromFiniteIntegerGrid Rdec floorBound readout /\
                  Nat.floor readout = code / base ^ k.val /\
                  truncatedFloorReLUFunction Rdec floorBound readout =
                    ((code / base ^ k.val : Nat) : Real) /\
                  Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base = digit k) ->
              ∃ T Dsub Wblock Pblock : Nat,
              ∃ Kcoeff KlocTent productDelta : Real,
                0 < Dsub /\
                0 < Wblock /\
                W0 = 2 * d + Wblock + 3 /\
                Pblock = fullyConnectedReLUParameterCount d Dsub Wblock /\
                2 * (Dsub + 1) <= Dblock + 1 /\
                ∃ coeffAccErr : Fin (M ^ d) -> Real,
                ∃ locErr tentErr : Fin (M ^ d) -> Fin T -> Real,
                ∃ centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real,
                ∃ decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real,
                ∃ blockApprox : Fin (M ^ d) -> (Fin d -> Real) -> Real,
                  (∀ b : Fin (M ^ d), 0 <= coeffAccErr b) /\
                  (∀ (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i) /\
                  (∀ (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i) /\
                  (∀ (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i) /\
                  Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
                    Kcoeff * shallowReLUResolutionRate M r beta /\
                  Finset.univ.sum (fun b : Fin (M ^ d) =>
                    Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
                    KlocTent * shallowReLUResolutionRate M r beta /\
                  Kcoeff + KlocTent <= cState /\
                  (∀ b : Fin (M ^ d), blockApprox b ∈ reluNetworkClass d Dsub Wblock Pblock) /\
                  (∀ (b : Fin (M ^ d)) (x : Fin d -> Real),
                    x ∈ unitCubeSet d ->
                      |blockApprox b x -
                          reluApproxCoarseBlockTarget r d T (decodedBlock b) (centerBlock b)
                            (scaleBlock b) x| <=
                        (Finset.univ.sum (fun _i : Fin T => productDelta)) +
                          (Finset.univ.sum (fun i : Fin T => locErr b i))) /\
                  (∀ x : Fin d -> Real,
                    x ∈ unitCubeSet d ->
                      reluApproxFineGridDecodedTaylorSum r d (M ^ d) T decodedBlock centerBlock
                          scaleBlock x =
                        Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                          axisAlignedBoxTentWeight (center j) (scale j) x *
                            finiteLinearCombination Finset.univ (decoded j)
                              (fun a y =>
                                Finset.univ.prod
                                  (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q)))
                              x))) :
      ∀ (M N Q base code floorBound : Nat) (eta Rdec : Real),
        0 < M ->
        0 < eta ->
        0 < Q ->
        2 * A / (Q : Real) <= eta ->
        Q + 1 <= base ->
        2 <= Rdec ->
        ∀ e : (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
        ∀ center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
          (∀ (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
          (∀ (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
            center j q ∈ Set.Icc (0 : Real) 1) ->
          (∀ x : Fin d -> Real,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
              Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
          ∀ digit : Fin N -> Nat,
            (∀ k : Fin N, digit k <= Q) ->
            (∀ k : Fin N, digit k < base) ->
            code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
            floorBound = code + 1 ->
            ∀ decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
              (∀ j a,
                decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
              (∀ j a, |decoded j a| <= A + eta) ->
              ((fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
                  reluNetworkClass 1 1 (2 * floorBound)
                    (fullyConnectedReLUParameterCount 1 1 (2 * floorBound))) ->
              (∀ k : Fin N,
                let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real);
                0 <= readout /\
                  readout < (floorBound : Real) + 1 /\
                  awayFromFiniteIntegerGrid Rdec floorBound readout /\
                  Nat.floor readout = code / base ^ k.val /\
                  truncatedFloorReLUFunction Rdec floorBound readout =
                    ((code / base ^ k.val : Nat) : Real) /\
                  Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base = digit k) ->
              ∃ D P : Nat,
                D = (M ^ d) * (Dblock + 1) /\
                0 < D /\
                P = fullyConnectedReLUParameterCount d D W0 /\
                ∃ g : (Fin d -> Real) -> Real,
                  g ∈ reluNetworkClass d D W0 P /\
                  ∀ x : Fin d -> Real,
                    (∀ q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
                      |g x -
                          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                            axisAlignedBoxTentWeight (center j) (scale j) x *
                              finiteLinearCombination Finset.univ (decoded j)
                                (fun a y =>
                                  Finset.univ.prod
                                    (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q)))
                              x)| <=
                        cState * shallowReLUResolutionRate M r beta := by
  intro M N Q base code floorBound eta Rdec hM hEta hQ h2A hQbase hRdec e center scale
    hscale_nonneg hcenter_inIcc htentsum digit hdigitQ hdigitBase hcode hfloor decoded
    hdecoded_form hdecoded_bnd htrunc hreadout
  obtain ⟨T, Dsub, Wblock, Pblock, Kcoeff, KlocTent, productDelta, hDsub_pos, hWblock_pos,
      hW0, hPblock, h2Dsub, coeffAccErr, locErr, tentErr, centerBlock, scaleBlock, decodedBlock,
      blockApprox, hcoeff_nonneg, hloc_nonneg, htent_nonneg, hprod_le, hcoeff_sum,
      hlocTent_sum, hKsum, hblockClass, hblockErr, hfineEq⟩ :=
    hschedule M N Q base code floorBound eta Rdec hM hEta hQ h2A hQbase hRdec e center scale
      hscale_nonneg hcenter_inIcc htentsum digit hdigitQ hdigitBase hcode hfloor decoded
      hdecoded_form hdecoded_bnd htrunc hreadout
  have hRateNonneg : 0 ≤ shallowReLUResolutionRate M r beta := by
    unfold shallowReLUResolutionRate
    exact le_of_lt (Real.rpow_pos_of_pos (by exact_mod_cast hM) _)
  rw [hW0]
  exact reluApprox_flatFineGrid_hstate_from_common_block_evaluator_errors_and_component_rates
    (T := T) (M := M) (r := r) (d := d) (Dsub := Dsub) (Wblock := Wblock)
    (Pblock := Pblock) (Dblock := Dblock) (beta := beta) (Kcoeff := Kcoeff)
    (KlocTent := KlocTent) (cState := cState) (productDelta := productDelta)
    hM hDsub_pos hWblock_pos hDblock h2Dsub
    coeffAccErr locErr tentErr centerBlock scaleBlock decodedBlock center scale decoded blockApprox
    hRateNonneg hcoeff_nonneg hloc_nonneg htent_nonneg hprod_le hcoeff_sum hlocTent_sum hKsum
    hblockClass hblockErr hfineEq

/-- A per-block evaluator schedule yields the common block component schedule
needed by the final hstate wrapper. -/
private theorem reluApprox_common_block_component_schedule_from_per_block_evaluator_schedule
    {d r W0 Dblock : Nat} {beta A cState : Real}
    (hsource :
      forall (M N Q base code floorBound : Nat) (eta Rdec : Real),
        0 < M ->
