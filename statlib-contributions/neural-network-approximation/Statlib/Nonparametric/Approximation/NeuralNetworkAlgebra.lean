  -- @step s3: Prove the full partition identity: for every x in the unit cube,
  --   ∑ j, axisAlignedBoxTentWeight (center j) (scale j) x = 1.
  have h_s3 : ∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∑ j : Fin ((K + 1) ^ d), axisAlignedBoxTentWeight (center j) (scale j) x) = 1 := by
        intro x hx
        -- @step s3a: Reindex the sum over j : Fin ((K+1)^d) via eGrid, unfold center/scale/axisAlignedBoxTentWeight
        have hs3a :
            (∑ j : Fin ((K + 1) ^ d), axisAlignedBoxTentWeight (center j) (scale j) x) =
              ∑ f : Fin d → Fin (K + 1), ∏ q : Fin d,
                coordinateTentReLUFunction q (((f q : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x := by
          rw [← Equiv.sum_comp eGrid]
