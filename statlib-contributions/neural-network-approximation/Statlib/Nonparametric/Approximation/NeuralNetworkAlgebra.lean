            simp [N, Ninput, FullyConnectedReLUNet.hiddenState, DenseLayer.apply, DenseLayer.reluApply,
              reluVec, inA, Fin.addCases_left, hNapplyA]
          · intro uB
            simp [N, Ninput, FullyConnectedReLUNet.hiddenState, DenseLayer.apply, DenseLayer.reluApply,
              reluVec, inB, Fin.addCases_right, hNapplyB]
        · intro hk1
          have hk : k ≤ D - 1 := by omega
          rcases ih hk with ⟨ihA, ihB⟩
          have hk_lt : k < D - 1 := by omega
          have hk_lt_A : k < A.depth - 1 := by simpa [hAd] using hk_lt
          have hk_lt_B : k < B.depth - 1 := by simpa [hBd] using hk_lt
          have hk_lt_N : k < N.depth - 1 := by
            simpa [N] using hk_lt
          constructor
          · intro uA
            calc
              N.hiddenState x (k + 1) (inA uA) = (N.hidden ⟨k, hk_lt_N⟩).reluApply (N.hiddenState x k) (inA uA) := by
                simp [FullyConnectedReLUNet.hiddenState, hk_lt_N]
              _ = relu ((N.hidden ⟨k, hk_lt_N⟩).apply (N.hiddenState x k) (inA uA)) := by
                rfl
              _ = relu ((A.hidden ⟨k, hk_lt_A⟩).apply (A.hiddenState x k) uA) := by
                congr 1
                calc
                  (N.hidden ⟨k, hk_lt_N⟩).apply (N.hiddenState x k) (inA uA)
                      = (∑ v : Fin W, (N.hidden ⟨k, hk_lt_N⟩).weight (inA uA) v * N.hiddenState x k v)
                          + (N.hidden ⟨k, hk_lt_N⟩).bias (inA uA) := by rfl
                  _ = (∑ vA : Fin wA, (A.hidden ⟨k, hk_lt_A⟩).weight uA vA * A.hiddenState x k vA)
                      + (A.hidden ⟨k, hk_lt_A⟩).bias uA := by
                        rw [hsum2]
                        simp [N, hwAA, wAA, hwAB, hbiasA, ihA, ihB, add_assoc]
                  _ = (A.hidden ⟨k, hk_lt_A⟩).apply (A.hiddenState x k) uA := by rfl
              _ = A.hiddenState x (k + 1) uA := by
                simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hk_lt_A]
          · intro uB
            calc
              N.hiddenState x (k + 1) (inB uB) = (N.hidden ⟨k, hk_lt_N⟩).reluApply (N.hiddenState x k) (inB uB) := by
                simp [FullyConnectedReLUNet.hiddenState, hk_lt_N]
              _ = relu ((N.hidden ⟨k, hk_lt_N⟩).apply (N.hiddenState x k) (inB uB)) := by
                rfl
              _ = relu ((B.hidden ⟨k, hk_lt_B⟩).apply (B.hiddenState x k) uB) := by
                congr 1
                calc
                  (N.hidden ⟨k, hk_lt_N⟩).apply (N.hiddenState x k) (inB uB)
                      = (∑ v : Fin W, (N.hidden ⟨k, hk_lt_N⟩).weight (inB uB) v * N.hiddenState x k v)
                          + (N.hidden ⟨k, hk_lt_N⟩).bias (inB uB) := by rfl
                  _ = (∑ vB : Fin wB, (B.hidden ⟨k, hk_lt_B⟩).weight uB vB * B.hiddenState x k vB)
                      + (B.hidden ⟨k, hk_lt_B⟩).bias uB := by
                        rw [hsum2]
                        simp [N, hwBA, hwBB, wBB, hbiasB, ihA, ihB, add_assoc]
                  _ = (B.hidden ⟨k, hk_lt_B⟩).apply (B.hiddenState x k) uB := by rfl
              _ = B.hiddenState x (k + 1) uB := by
                simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hk_lt_B]
      rcases hcarry (D - 1) (by omega) with ⟨hcarA, hcarB⟩
      have hA_realize : A.realize x = (∑ vA : Fin wA, A.outputWeight vA * A.hiddenState x (D - 1) vA) + A.outputBias := by
        rw [FullyConnectedReLUNet.realize, hAd]
      have hB_realize : B.realize x = (∑ vB : Fin wB, B.outputWeight vB * B.hiddenState x (D - 1) vB) + B.outputBias := by
        rw [FullyConnectedReLUNet.realize, hBd]
      calc
        N.realize x = (∑ j : Fin W, N.outputWeight j * N.hiddenState x (N.depth - 1) j) + N.outputBias := by
          rfl
        _ = (∑ j : Fin W, N.outputWeight j * N.hiddenState x (D - 1) j) + (a * A.outputBias + b * B.outputBias) := by
          simp [N]
        _ = (∑ vA : Fin wA, (a * A.outputWeight vA) * A.hiddenState x (D - 1) vA)
            + (∑ vB : Fin wB, (b * B.outputWeight vB) * B.hiddenState x (D - 1) vB)
            + (a * A.outputBias + b * B.outputBias) := by
          rw [hsum2]
          simp [N, Noutput, inA, inB, Fin.addCases_left, Fin.addCases_right, hcarA, hcarB, add_assoc]
        _ = a * A.realize x + b * B.realize x := by
          rw [hA_realize, hB_realize]
          rw [mul_add, mul_add]
          rw [Finset.mul_sum, Finset.mul_sum]
          simp only [mul_assoc]
          ring
    -- Combine the padded per-monomial networks into one depth-D network realizing
    -- ∑ r ∈ s, coeff r * (P r).realize x exactly, then close the error bound via hδ_sum.
    have hD_pos : 0 < D := by
      dsimp [D]
      have hsum_ge : s.card ≤ ∑ r ∈ s, (degree r + 1) := by
        calc
          s.card = ∑ r ∈ s, (1 : ℕ) := by simp
          _ ≤ ∑ r ∈ s, (degree r + 1) := Finset.sum_le_sum (fun r hr => by omega)
      exact lt_of_lt_of_le hs_card_pos hsum_ge
    have hzero1 : ∃ Z : FullyConnectedReLUNet d, Z.depth = 1 ∧ ∀ x : Fin d → ℝ, Z.realize x = 0 := by
      let Z : FullyConnectedReLUNet d :=
        { depth := 1, width := 0, input := { weight := fun u _ => (nomatch u), bias := fun k => (nomatch k) },
          hidden := fun h => (nomatch h), outputWeight := fun u => (nomatch u), outputBias := 0 }
      refine ⟨Z, rfl, ?_⟩
      intro x
      simp [Z, FullyConnectedReLUNet.realize, Fin.sum_univ_zero]
    rcases hzero1 with ⟨Z0, hZ0d, hZ0⟩
    rcases hpad Z0 1 D hZ0d (by norm_num) (by omega) with ⟨Zpad, hZpad_d, hZpad⟩
    let Pnet : ι → FullyConnectedReLUNet d := fun r =>
      if hr : r ∈ s then Classical.choose (hpad_net r hr) else L0
    have hPnet_d : ∀ r ∈ s, (Pnet r).depth = D := by
      intro r hr
      dsimp [Pnet]
      rw [dif_pos hr]
      exact (Classical.choose_spec (hpad_net r hr)).1
    have hPnet_err : ∀ r ∈ s, ∀ x : Fin d → ℝ,
        (∀ q : Fin d, |x q - center q| ≤ R) →
          |(Pnet r).realize x - f r x| ≤ δ r := by
      intro r hr x hx
      dsimp [Pnet]
      rw [dif_pos hr]
      exact (Classical.choose_spec (hpad_net r hr)).2 x hx
    have hfold : ∀ (t : Finset ι), t ⊆ s →
        ∃ M : FullyConnectedReLUNet d, M.depth = D ∧
          ∀ x : Fin d → ℝ, M.realize x = ∑ r ∈ t, coeff r * (Pnet r).realize x := by
      intro t
      induction t using Finset.induction_on with
      | empty =>
          intro ht
          refine ⟨Zpad, hZpad_d, ?_⟩
          intro x
          rw [hZpad x, hZ0 x]
          simp
      | insert r t hrt ih =>
          intro ht
          have ht_sub : t ⊆ s := by
            intro a ha
            exact ht (Finset.mem_insert_of_mem ha)
          have hr_mem : r ∈ s := ht (Finset.mem_insert_self r t)
          rcases ih ht_sub with ⟨M, hMd, hM⟩
          rcases hcomb2 (Pnet r) M D (coeff r) 1 (hPnet_d r hr_mem) hMd hD_pos with ⟨N, hNd, hN⟩
          refine ⟨N, hNd, ?_⟩
          intro x
          rw [hN x, hM x]
          simp only [one_mul]
          rw [Finset.sum_insert hrt]

    rcases hfold s (by intro r hr; exact hr) with ⟨N, hNd, hN⟩
    refine ⟨N, ?_, ?_⟩
    · rw [hNd]
      exact hD_pos
    · intro x hx
      have hdiff : (∑ r ∈ s, coeff r * (Pnet r).realize x) - (∑ r ∈ s, coeff r * f r x)
          = ∑ r ∈ s, coeff r * ((Pnet r).realize x - f r x) := by
        calc
          (∑ r ∈ s, coeff r * (Pnet r).realize x) - (∑ r ∈ s, coeff r * f r x)
              = ∑ r ∈ s, (coeff r * (Pnet r).realize x - coeff r * f r x) := by
                rw [Finset.sum_sub_distrib]
          _ = ∑ r ∈ s, coeff r * ((Pnet r).realize x - f r x) := by
                apply Finset.sum_congr rfl
                intro r hr
                ring
      have hsum_err : |(∑ r ∈ s, coeff r * (Pnet r).realize x) - (∑ r ∈ s, coeff r * f r x)|
          ≤ ∑ r ∈ s, |coeff r| * δ r := by
        rw [hdiff]
        calc
          |∑ r ∈ s, coeff r * ((Pnet r).realize x - f r x)|
              ≤ ∑ r ∈ s, |coeff r * ((Pnet r).realize x - f r x)| :=
                Finset.abs_sum_le_sum_abs (fun r => coeff r * ((Pnet r).realize x - f r x)) s
          _ ≤ ∑ r ∈ s, |coeff r| * |(Pnet r).realize x - f r x| := by
                exact Finset.sum_le_sum (fun r hr => by rw [abs_mul])
          _ ≤ ∑ r ∈ s, |coeff r| * δ r := by
                exact Finset.sum_le_sum (fun r hr =>
                  mul_le_mul_of_nonneg_left (hPnet_err r hr x hx) (abs_nonneg _))
      calc
        |N.realize x - finiteLinearCombination s coeff f x|
            = |(∑ r ∈ s, coeff r * (Pnet r).realize x) - (∑ r ∈ s, coeff r * f r x)| := by
                rw [hN x]
                simp [finiteLinearCombination]
        _ ≤ ∑ r ∈ s, |coeff r| * δ r := hsum_err
        _ ≤ ε := hδ_sum

theorem isHolderSmoothFunction_taylor_remainder_bound_on_box
    {d r : ℕ} {beta C rho : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (f : (Fin d → ℝ) → ℝ)
    (hf : IsHolderSmoothFunction r beta C f)
    (center x : Fin d → ℝ)
    (hbox : ‖x - center‖ ≤ rho) :
    |f x -
        ∑ k ∈ Finset.range (r + 1),
          ((Nat.factorial k : ℝ)⁻¹) *
            (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)| ≤
      C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
  rcases r with _ | r'
  · -- r = 0 : the Taylor polynomial is just the constant `f center`
    have hf_holder : IsHolderFunction f beta C := by
      simpa [isHolderSmoothFunction_zero] using hf
    have hb : |f x - f center| ≤ C * ‖x - center‖.rpow beta := by
      simpa [dist_eq_norm] using (hf_holder x center)
    have hpow : ‖x - center‖.rpow beta ≤ rho.rpow beta :=
      Real.rpow_le_rpow (norm_nonneg (x - center)) hbox hbeta_nonneg
    have hCmul : C * ‖x - center‖.rpow beta ≤ C * rho.rpow beta :=
      mul_le_mul_of_nonneg_left hpow hC
    simp
    exact le_trans hb hCmul
  · -- r = r' + 1 : Fréchet Taylor theorem with Hölder modulus of the top derivative
    have hf' : ContDiff ℝ (↑(r' + 1)) f ∧
        ∀ (x y : Fin d → ℝ),
          ‖iteratedFDeriv ℝ (r' + 1) f x - iteratedFDeriv ℝ (r' + 1) f y‖ ≤
            C * (dist x y).rpow beta := by
      simpa [isHolderSmoothFunction_succ] using hf
    let v : Fin d → ℝ := x - center
    let g : ℝ → ℝ := fun t : ℝ => f (center + t • v)
    -- affine chain rule: iteratedDeriv k g t = (iteratedFDeriv ℝ k f (center + t • v)) (fun _ : Fin k => v)
    have hchain : ∀ (k : ℕ), k ≤ r' + 1 → ∀ (t : ℝ),
        iteratedDeriv k g t = (iteratedFDeriv ℝ k f (center + t • v)) (fun _ : Fin k => v) := by
      intro k hk t
      rw [iteratedDeriv_eq_iteratedFDeriv]
      change (iteratedFDeriv ℝ k (fun s : ℝ => f (center + s • v)) t) (fun _ : Fin k => 1) =
        (iteratedFDeriv ℝ k f (center + t • v)) (fun _ : Fin k => v)
      let L : ℝ →L[ℝ] (Fin d → ℝ) := ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) v
      have hL : (fun s : ℝ => f (center + s • v)) =
          (fun z : Fin d → ℝ => f (center + z)) ∘ ⇑L := by
        funext s
        rfl
      rw [hL]
      have hc : ContDiff ℝ (↑(r' + 1)) (fun z : Fin d → ℝ => f (center + z)) := by
        exact hf'.1.comp (by fun_prop)
      have hcr : iteratedFDeriv ℝ k ((fun z : Fin d → ℝ => f (center + z)) ∘ ⇑L) t =
          (iteratedFDeriv ℝ k (fun z : Fin d → ℝ => f (center + z)) (⇑L t)).compContinuousLinearMap
            (fun _ : Fin k => L) := by
        exact ContinuousLinearMap.iteratedFDeriv_comp_right
          (𝕜 := ℝ) (E := Fin d → ℝ) (F := ℝ) (G := ℝ) (n := ↑(r' + 1))
          L (f := fun z : Fin d → ℝ => f (center + z)) hc t (i := k) (by exact_mod_cast hk)
      rw [hcr]
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      have hLt : ⇑L t = t • v := by
        simp [L, ContinuousLinearMap.smulRight]
      have hL1 : (fun _ : Fin k => ⇑L 1) = (fun _ : Fin k => v) := by
        funext i
        simp [L, ContinuousLinearMap.smulRight, one_smul]
      rw [hLt, hL1]
      rw [iteratedFDeriv_comp_add_left]
    -- next: 1-D Taylor with Lagrange remainder on g over [0, 1]
    have hgCd : ContDiff ℝ (↑(r' + 1)) g := by
      change ContDiff ℝ (↑(r' + 1)) (fun t : ℝ => f (center + t • v))
      exact hf'.1.comp (by fun_prop)
    have hgCon : ContDiffOn ℝ (↑r' + 1) g (Set.Icc (0 : ℝ) 1) := by
      simpa using hgCd.contDiffOn
    have hrem_exists : ∃ x' ∈ Set.Ioo 0 1,
        g 1 - taylorWithinEval g r' (Set.Icc 0 1) 0 1 =
          iteratedDeriv (r' + 1) g x' * (1 - 0) ^ (r' + 1) / ↑(r' + 1).factorial := by
      exact taylor_mean_remainder_lagrange_iteratedDeriv (f := g) (x := 1) (x₀ := 0) (n := r')
        (by norm_num) hgCon
    rcases hrem_exists with ⟨x', hx'mem, hrem⟩
    -- rewrite the 1-D Taylor polynomial into the partial sum of fderiv terms (via the chain rule)
    have htw : taylorWithinEval g r' (Set.Icc (0 : ℝ) 1) 0 1 =
        ∑ k ∈ Finset.range (r' + 1),
          ((Nat.factorial k : ℝ)⁻¹) * (iteratedFDeriv ℝ k f center) (fun _ : Fin k => v) := by
      rw [taylor_within_apply]
      apply Finset.sum_congr rfl
      intro k hk
      have hk_lt : k < r' + 1 := Finset.mem_range.mp hk
      have hk_le : k ≤ r' + 1 := Nat.le_of_lt hk_lt
      have hwd : iteratedDerivWithin k g (Set.Icc (0 : ℝ) 1) 0 = iteratedDeriv k g 0 := by
        exact iteratedDerivWithin_eq_iteratedDeriv (𝕜 := ℝ) (F := ℝ) (n := k) (f := g)
          (s := Set.Icc (0 : ℝ) 1) (x := (0 : ℝ)) uniqueDiffOn_Icc_zero_one
          (by exact (hgCd.of_le (by exact_mod_cast hk_le)).contDiffAt)
          (by simp)
      have hch0 : iteratedDeriv k g 0 = (iteratedFDeriv ℝ k f center) (fun _ : Fin k => v) := by
        simpa using hchain k hk_le 0
      rw [hwd, hch0]
      simp [smul_eq_mul]
    -- rpow product formula on the nonneg base (also covers the base = 0 case)
    have hrpow_add_aux : ∀ a : ℝ, 0 ≤ a → a.rpow (↑(r' + 1)) * a.rpow beta = a.rpow (↑(r' + 1) + beta) := by
      intro a ha
      rcases eq_or_lt_of_le ha with hazero | hapos
      · rw [← hazero]
        have hposE : 0 < (↑(r' + 1) : ℝ) := by exact_mod_cast (Nat.succ_pos r')
        have hpos : 0 < (↑(r' + 1) : ℝ) + beta := by linarith
        have hz1 : (0 : ℝ).rpow (↑(r' + 1)) = 0 := by
          rw [Real.rpow_eq_pow]
          exact Real.zero_rpow (ne_of_gt hposE)
        have hz3 : (0 : ℝ).rpow (↑(r' + 1) + beta) = 0 := by
          rw [Real.rpow_eq_pow]
          exact Real.zero_rpow (ne_of_gt hpos)
        rw [hz1, hz3]
        simp
      · simpa [Real.rpow_eq_pow] using (Real.rpow_add hapos (↑(r' + 1)) beta).symm
    have hx'pos : 0 < x' := hx'mem.1
    have hx'lt : x' < 1 := hx'mem.2
    have hxv : ‖x' • v‖ ≤ ‖v‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hx'pos]
      exact mul_le_of_le_one_left (norm_nonneg v) (le_of_lt hx'lt)
    -- Hölder bound on the top derivative at the intermediate point
    have htop0 : |iteratedDeriv (r' + 1) g x' - iteratedDeriv (r' + 1) g 0| ≤ C * ‖v‖.rpow (↑(r' + 1) + beta) := by
      have hchx : iteratedDeriv (r' + 1) g x' = (iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) (fun _ : Fin (r' + 1) => v) := by
        simpa using hchain (r' + 1) le_rfl x'
      have hch0 : iteratedDeriv (r' + 1) g 0 = (iteratedFDeriv ℝ (r' + 1) f center) (fun _ : Fin (r' + 1) => v) := by
        simpa using hchain (r' + 1) le_rfl 0
      rw [hchx, hch0]
      rw [← ContinuousMultilinearMap.sub_apply]
      have hD : ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖ ≤ C * ‖v‖.rpow beta := by
        calc
          ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖
              ≤ C * (dist (center + x' • v) center).rpow beta := hf'.2 (center + x' • v) center
          _ ≤ C * ‖v‖.rpow beta := by
                exact mul_le_mul_of_nonneg_left (by
                  rw [dist_eq_norm]
                  rw [show (center + x' • v) - center = x' • v by abel]
                  exact Real.rpow_le_rpow (norm_nonneg (x' • v)) hxv hbeta_nonneg) hC
      have hle_op : ‖((iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)) (fun _ : Fin (r' + 1) => v)‖
          ≤ ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖ * ‖v‖ ^ (r' + 1) := by
        calc
          ‖((iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)) (fun _ : Fin (r' + 1) => v)‖
              ≤ ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖ * ∏ _ : Fin (r' + 1), ‖v‖ :=
                ContinuousMultilinearMap.le_opNorm
                  ((iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center))
                  (fun _ : Fin (r' + 1) => v)
          _ = ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖ * ‖v‖ ^ (r' + 1) := by simp
      calc
        |((iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)) (fun _ : Fin (r' + 1) => v)|
            ≤ ‖((iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)) (fun _ : Fin (r' + 1) => v)‖ := by
              rw [Real.norm_eq_abs]
        _ ≤ ‖(iteratedFDeriv ℝ (r' + 1) f (center + x' • v)) - (iteratedFDeriv ℝ (r' + 1) f center)‖ * ‖v‖ ^ (r' + 1) := hle_op
        _ ≤ (C * ‖v‖.rpow beta) * ‖v‖ ^ (r' + 1) := by
              exact mul_le_mul_of_nonneg_right hD (pow_nonneg (norm_nonneg v) (r' + 1))
        _ = C * (‖v‖.rpow beta * ‖v‖ ^ (r' + 1)) := by ring
        _ = C * ‖v‖.rpow (↑(r' + 1) + beta) := by
              congr 1
              have hnat : ‖v‖ ^ (r' + 1) = ‖v‖.rpow (↑(r' + 1)) := by
                rw [← Real.rpow_natCast ‖v‖ (r' + 1)]
                rw [Real.rpow_eq_pow]
              rw [hnat]
              rw [mul_comm]
              exact hrpow_add_aux ‖v‖ (norm_nonneg v)
    have htop : |iteratedDeriv (r' + 1) g x' - iteratedDeriv (r' + 1) g 0| ≤ C * rho.rpow (↑(r' + 1) + beta) := by
      have hvle : ‖v‖ ≤ rho := by simpa [v] using hbox
      have hposE : 0 < (↑(r' + 1) : ℝ) := by exact_mod_cast (Nat.succ_pos r')
      have hE0 : 0 ≤ (↑(r' + 1) : ℝ) + beta := by linarith
      calc
        |iteratedDeriv (r' + 1) g x' - iteratedDeriv (r' + 1) g 0| ≤ C * ‖v‖.rpow (↑(r' + 1) + beta) := htop0
        _ ≤ C * rho.rpow (↑(r' + 1) + beta) := by
              exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (norm_nonneg v) hvle hE0) hC
    -- assemble: goal sum = taylorWithinEval + top term, so the LHS is the Lagrange remainder
    have hg1 : g 1 = f x := by
      simp [g, v]
    have hrem' : g 1 - taylorWithinEval g r' (Set.Icc (0 : ℝ) 1) 0 1 =
        iteratedDeriv (r' + 1) g x' / ((Nat.factorial (r' + 1) : ℝ)) := by
      simpa using hrem
    have hterm : ((Nat.factorial (r' + 1) : ℝ)⁻¹) * (iteratedFDeriv ℝ (r' + 1) f center) (fun _ : Fin (r' + 1) => v) =
        ((Nat.factorial (r' + 1) : ℝ)⁻¹) * iteratedDeriv (r' + 1) g 0 := by
      congr 1
      simpa using (hchain (r' + 1) le_rfl 0).symm
    have harg : g 1 - (taylorWithinEval g r' (Set.Icc (0 : ℝ) 1) 0 1 + ((Nat.factorial (r' + 1) : ℝ)⁻¹) * iteratedDeriv (r' + 1) g 0) =
        (g 1 - taylorWithinEval g r' (Set.Icc (0 : ℝ) 1) 0 1) - ((Nat.factorial (r' + 1) : ℝ)⁻¹) * iteratedDeriv (r' + 1) g 0 := by
      ring
    have harg2 : iteratedDeriv (r' + 1) g x' / ((Nat.factorial (r' + 1) : ℝ)) - ((Nat.factorial (r' + 1) : ℝ)⁻¹) * iteratedDeriv (r' + 1) g 0 =
        (iteratedDeriv (r' + 1) g x' - iteratedDeriv (r' + 1) g 0) / ((Nat.factorial (r' + 1) : ℝ)) := by
      ring
    have hfact_pos : 0 < (Nat.factorial (r' + 1) : ℝ) := by
      exact_mod_cast (Nat.factorial_pos (r' + 1))
    rw [Finset.sum_range_succ]
    rw [← htw]
    rw [hterm]
    rw [← hg1]
    rw [harg]
    rw [hrem']
    rw [harg2]
    rw [abs_div]
    rw [abs_of_pos hfact_pos]
    rw [show C / (Nat.factorial (r' + 1) : ℝ) * rho.rpow (↑(r' + 1) + beta) =
        (C * rho.rpow (↑(r' + 1) + beta)) / (Nat.factorial (r' + 1) : ℝ) by ring]
    exact div_le_div_of_nonneg_right htop (le_of_lt hfact_pos)

/-- Taylor remainder bound specialized to a Holder smoothness ball.  The
envelope component is irrelevant to the analytic remainder estimate. -/
theorem holderSmoothBall_taylor_remainder_bound_on_box
    {d r : ℕ} {beta C B rho : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center x : Fin d → ℝ)
    (hbox : ‖x - center‖ ≤ rho) :
    |f x -
        ∑ k ∈ Finset.range (r + 1),
          ((Nat.factorial k : ℝ)⁻¹) *
            (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)| ≤
      C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
  have hfSmooth : IsHolderSmoothFunction r beta C f := hf.1
  exact isHolderSmoothFunction_taylor_remainder_bound_on_box
    hbeta_nonneg hC hrho f hfSmooth center x hbox

set_option maxHeartbeats 800000 in
theorem exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_approx_on_box_with_depth_bound
    {ι : Type*} [DecidableEq ι] {d : ℕ}
    (hd : 0 < d) {R ε : ℝ} (hR : 0 < R) (hε : 0 < ε)
    (center : Fin d → ℝ)
    (s : Finset ι) (coeff : ι → ℝ)
    (degree : ι → ℕ) (coord : (r : ι) → Fin (degree r) → Fin d) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (∑ r ∈ s, (degree r + 1)) + 1 ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
        |N.realize x -
            finiteLinearCombination s coeff
              (fun r : ι => fun y : Fin d → ℝ =>
                ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤ ε := by
  -- @step s1: Choose nonnegative per-monomial error budgets εr with ∑_{r∈s} |coeff r| * εr r ≤ ε,
  -- and for each r ∈ s build a ReLU net of depth ≤ degree r + 1 approximating the centered monomial
  -- y ↦ ∏ q, (y (coord r q) - center (coord r q)) on the box.
  have h_s1 :
      ∃ εr : ι → ℝ,
        (∀ r ∈ s, 0 ≤ εr r) ∧
        (∑ r ∈ s, |coeff r| * εr r) ≤ ε ∧
        ∀ r ∈ s, ∃ Ar : FullyConnectedReLUNet d,
          Ar.depth ≤ degree r + 1 ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |Ar.realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r := by
      -- @step s1: Choose a nonnegative per-monomial error budget function εr : ι → ℝ with
      -- (∀ r ∈ s, 0 < εr r) and ∑ r ∈ s, |coeff r| * εr r ≤ ε (εr r = ε / (s.card * (1 + |coeff r|))
      -- when s is nonempty, and εr r = 0 when s is empty).
      have h_s1_1 :
          ∃ εr : ι → ℝ, (∀ r ∈ s, 0 < εr r) ∧ (∑ r ∈ s, |coeff r| * εr r) ≤ ε := by
        classical
        by_cases hs : s = ∅
        · refine ⟨fun _ => 0, ?_, ?_⟩
          · intro r hr
            exfalso
            simpa [hs] using hr
          · simpa [hs] using hε.le
        · let C : ℝ := (s.card : ℝ)
          have hCpos0 : 0 < s.card :=
            Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hs)
          have hCpos : 0 < C := by
            dsimp [C]
            exact_mod_cast hCpos0
          let εr : ι → ℝ := fun r => ε / (C * (1 + |coeff r|))
          refine ⟨εr, ?_, ?_⟩
          · intro r hr
            dsimp [εr]
            exact div_pos hε (mul_pos hCpos (by positivity))
          · have hterm : ∀ r ∈ s, |coeff r| * εr r ≤ ε / C := by
              intro r hr
              dsimp [εr]
              have ha : 0 ≤ |coeff r| := abs_nonneg _
              have h1pos : 0 < 1 + |coeff r| := by linarith
              have h1 : (1 + |coeff r|) ≠ 0 := ne_of_gt h1pos
              have hden : 0 < C * (1 + |coeff r|) := mul_pos hCpos h1pos
              have hεC : 0 < ε / C := div_pos hε hCpos
              have hfrac : |coeff r| / (1 + |coeff r|) ≤ 1 := by
                rw [div_le_iff₀ h1pos]
                linarith
              calc
                |coeff r| * (ε / (C * (1 + |coeff r|))) =
                    (ε / C) * (|coeff r| / (1 + |coeff r|)) := by
                  field_simp [hCpos.ne', hden.ne', h1]

                _ ≤ (ε / C) * 1 := mul_le_mul_of_nonneg_left hfrac hεC.le
                _ = ε / C := by ring
            calc
              (∑ r ∈ s, |coeff r| * εr r) ≤ ∑ r ∈ s, ε / C := by
                exact Finset.sum_le_sum hterm
              _ = (s.card : ℝ) * (ε / C) := by
                rw [Finset.sum_const, nsmul_eq_mul]
              _ = ε := by
                have hCne' : (s.card : ℝ) ≠ 0 := by
                  exact_mod_cast Nat.ne_of_gt hCpos0
                dsimp [C]
                field_simp [hCne']

      -- @step s2: For every r ∈ s, with m = degree r, build Ar : FullyConnectedReLUNet d with
      -- Ar.depth ≤ m + 1 approximating the centered monomial y ↦ ∏ q, (y (coord r q) - center (coord r q))
      -- within εr r on the box (by induction on m, composing the depth-one multiplication network
      -- with the induction network and a depth-one affine factor).
      have h_s1_2 :
          ∀ εr : ι → ℝ, (∀ r ∈ s, 0 < εr r) → ∀ r ∈ s, ∃ Ar : FullyConnectedReLUNet d,
            Ar.depth ≤ degree r + 1 ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |Ar.realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r := by
        -- @step s1: Prove the uniform induction claim: for every m : ℕ, τ > 0, c : Fin m → Fin d,
        -- there is a depth ≤ m + 1 ReLU net approximating ∏ q, (x (c q) - center (c q)) within τ on the box.
        have h_s1_2_1 :
            ∀ m : ℕ, ∀ τ : ℝ, 0 < τ → ∀ c : Fin m → Fin d, ∃ A : FullyConnectedReLUNet d,
              A.depth ≤ m + 1 ∧
              ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
          -- @step s1: Base case m = 0: the centered monomial is the empty product, equal to the
          -- constant 1; a depth-one constant-1 ReLU net realizes it exactly (error 0 ≤ τ).
          have h_base0 :
              ∀ τ : ℝ, 0 < τ → ∀ c : Fin 0 → Fin d, ∃ A : FullyConnectedReLUNet d,
                A.depth ≤ 0 + 1 ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin 0, (x (c q) - center (c q))| ≤ τ := by
            intro τ hτ c
            let A : FullyConnectedReLUNet d :=
              FullyConnectedReLUNet.mk 1 1
                (DenseLayer.mk (fun _ _ => 0) (fun _ => 0))
                (fun i => Fin.elim0 i)
                (fun _ => 0)
                1
            refine ⟨A, ?_, ?_⟩
            · simp [A]
            · intro x hx
              have hprod : (∏ q : Fin 0, (x (c q) - center (c q))) = 1 := by
                simp
              have hreal : A.realize x = 1 := by
                simp [A, FullyConnectedReLUNet.realize]
              rw [hprod, hreal]
              norm_num
              exact le_of_lt hτ
          -- @step s2: Base case m = 1: the centered monomial is the affine factor x (c 0) - center (c 0);
          -- a depth-one affine network realizes it exactly (error 0 ≤ τ, depth 1 ≤ 1 + 1).
          have h_base1 :
              ∀ τ : ℝ, 0 < τ → ∀ c : Fin 1 → Fin d, ∃ A : FullyConnectedReLUNet d,
                A.depth ≤ 1 + 1 ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin 1, (x (c q) - center (c q))| ≤ τ := by
            intro τ hτ c
            let w : Matrix (Fin 2) (Fin d) ℝ := fun j i =>
              if j = 0 then (if c 0 = i then 1 else 0) else (if c 0 = i then -1 else 0)
            let b : Fin 2 → ℝ := fun j =>
              if j = 0 then -center (c 0) else center (c 0)
            let ow : Fin 2 → ℝ := fun j =>
              if j = 0 then 1 else -1
            let A : FullyConnectedReLUNet d :=
              FullyConnectedReLUNet.mk 1 2 (DenseLayer.mk w b) (fun i => Fin.elim0 i) ow 0
            refine ⟨A, ?_, ?_⟩
            · dsimp [A]
              norm_num
            · intro x hx
              have hrelu_sub : ∀ t : ℝ, relu t - relu (-t) = t := by
                intro t
                unfold relu
                by_cases ht : 0 ≤ t
                · have ht' : -t ≤ 0 := by linarith
                  rw [max_eq_left ht, max_eq_right ht']
                  ring
                · have ht' : t ≤ 0 := le_of_not_ge ht
                  have hneg : 0 ≤ -t := by linarith
                  rw [max_eq_right ht', max_eq_left hneg]
                  ring
              have hhid : ∀ j : Fin 2, A.hiddenState x 0 j = relu (A.input.apply x j) := by
                intro j
                rfl
              have happly0 : A.input.apply x 0 = x (c 0) - center (c 0) := by
                simp [A, w, b, DenseLayer.apply, Finset.sum_ite_eq]
                try ring
              have happly1 : A.input.apply x 1 = -(x (c 0) - center (c 0)) := by
                simp [A, w, b, DenseLayer.apply, Finset.sum_ite_eq]
                try ring
              have hreal : A.realize x = x (c 0) - center (c 0) := by
                calc
                  A.realize x = relu (x (c 0) - center (c 0)) - relu (-(x (c 0) - center (c 0))) := by
                    simp [A, w, b, ow, FullyConnectedReLUNet.realize, DenseLayer.reluApply,
                      reluVec, Fin.sum_univ_two, hhid, happly0, happly1, neg_one_mul]
                    try norm_num
                    try ring
                  _ = x (c 0) - center (c 0) := by
                    exact hrelu_sub (x (c 0) - center (c 0))
              have hprod : (∏ q : Fin 1, (x (c q) - center (c q))) = x (c 0) - center (c 0) := by
                simp [Fin.prod_univ_one]
              rw [hprod, hreal, sub_self]
              norm_num
              exact le_of_lt hτ
          -- @step s3: Induction step for m ≥ 2: split off the first factor x (c 0) - center (c 0),
          -- apply the IH to the residual product over Fin (m - 1) with tolerance τ/(2R), and compose
          -- with a depth-one multiplication network (E4) to get depth ≤ m + 1 and total error ≤ τ.
          have h_step :
              ∀ m : ℕ, 2 ≤ m →
                (∀ τ : ℝ, 0 < τ → ∀ c : Fin (m - 1) → Fin d, ∃ A : FullyConnectedReLUNet d,
                  A.depth ≤ (m - 1) + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A.realize x - ∏ q : Fin (m - 1), (x (c q) - center (c q))| ≤ τ) →
                ∀ τ : ℝ, 0 < τ → ∀ c : Fin m → Fin d, ∃ A : FullyConnectedReLUNet d,
                  A.depth ≤ m + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
            intro m hm ih τ hτ c
            -- @step s1: Instantiate the induction hypothesis at m − 1 with tolerance η = τ/(2R) on the
            -- tail coordinate map i ↦ c (i + 1), obtaining A_P; from the box bounds set B = max R (R^(m-1) + η)
            -- so that B > 0 and both |A_P.realize x| and |x (c 0) − center (c 0)| are ≤ B on the box.
            have h_s1 :
                ∃ (A_P : FullyConnectedReLUNet d) (B : ℝ),
                  0 < B ∧
                  A_P.depth ≤ (m - 1) + 1 ∧
                  (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A_P.realize x -
                        ∏ i : Fin (m - 1),
                          let t : Fin m := Fin.cast (by omega) (Fin.succ i); x (c t) - center (c t)| ≤
                      τ / (2 * R)) ∧
                  (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A_P.realize x| ≤ B ∧ |x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)| ≤ B) := by
                have hη : 0 < τ / (2 * R) := div_pos hτ (mul_pos (by norm_num) hR)
                let tail : Fin (m - 1) → Fin d := fun i => c (Fin.cast (by omega) (Fin.succ i))
                rcases ih (τ / (2 * R)) hη tail with ⟨A_P, hA_P_depth, hA_P_approx⟩
                let B : ℝ := max R (R ^ (m - 1) + τ / (2 * R))
                have hB : 0 < B := by
                  exact lt_max_iff.mpr (Or.inl hR)
                refine ⟨A_P, B, hB, hA_P_depth, ?_, ?_⟩
                · intro x hx
                  simpa [tail] using hA_P_approx x hx
                · intro x hx
                  have hP :
                      |∏ i : Fin (m - 1), (x (tail i) - center (tail i))| ≤ R ^ (m - 1) := by
                    rw [Finset.abs_prod]
                    calc
                      (∏ i : Fin (m - 1), |x (tail i) - center (tail i)|) ≤
                          ∏ i : Fin (m - 1), R := by
                        exact Finset.prod_le_prod (fun i hi => abs_nonneg _) (fun i hi => hx (tail i))
                      _ = R ^ (m - 1) := by simp
                  have hAP1 : |A_P.realize x| ≤ R ^ (m - 1) + τ / (2 * R) := by
                    let P : ℝ := ∏ i : Fin (m - 1), (x (tail i) - center (tail i))
                    have h1 : |A_P.realize x - P| ≤ τ / (2 * R) := by
                      simpa [P, tail] using hA_P_approx x hx
                    calc
                      |A_P.realize x| = |(A_P.realize x - P) + P| := by
                        rw [show (A_P.realize x - P) + P = A_P.realize x by ring]
                      _ ≤ |A_P.realize x - P| + |P| := by
                        simpa [Real.norm_eq_abs] using (norm_add_le (a := A_P.realize x - P) (b := P))
                      _ ≤ τ / (2 * R) + R ^ (m - 1) := add_le_add h1 hP
                      _ = R ^ (m - 1) + τ / (2 * R) := by ring
                  constructor
                  · exact le_trans hAP1 (le_max_right R (R ^ (m - 1) + τ / (2 * R)))
                  · exact le_trans (hx (c ⟨0, by omega⟩)) (le_max_left R (R ^ (m - 1) + τ / (2 * R)))
            -- @step s2: Choose n : ℕ with n > 0 and 2 * B^2 / n^2 ≤ τ/2 (Archimedean property of ℝ),
            -- and apply exists_fullyConnectedReLUNet_mul_approx_on_box to obtain a depth-one network M on Fin 2
            -- with |M.realize y − y 0 * y 1| ≤ τ/2 whenever |y 0| ≤ B and |y 1| ≤ B.
            have h_s2 :
                ∀ (A_P : FullyConnectedReLUNet d) (B : ℝ), 0 < B →
                  (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A_P.realize x| ≤ B ∧ |x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)| ≤ B) →
                  ∃ (n : ℕ) (M : FullyConnectedReLUNet 2),
                    0 < n ∧
                    M.depth = 1 ∧
                    2 * B ^ 2 / (n : ℝ) ^ 2 ≤ τ / 2 ∧
                    (∀ y : Fin 2 → ℝ, |y 0| ≤ B → |y 1| ≤ B →
                      |M.realize y - y 0 * y 1| ≤ τ / 2) := by
                intro A_P B hB hBnd
                obtain ⟨n, hn_gt⟩ := exists_nat_gt (4 * B ^ 2 / τ)
                have hpos4 : 0 < 4 * B ^ 2 / τ := by positivity
                have hn : 0 < n := by
                  exact_mod_cast (lt_trans hpos4 hn_gt)
                have hnℝ : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
                have hn_sq_ge : (n : ℝ) ≤ (n : ℝ) ^ 2 := by
                  have h1 : (1 : ℝ) ≤ (n : ℝ) := by
                    exact_mod_cast (Nat.succ_le_of_lt hn)
                  nlinarith [sq_nonneg ((n : ℝ) - 1)]
                have hn2_bound : 4 * B ^ 2 < τ * (n : ℝ) ^ 2 := by
                  have hτne : τ ≠ 0 := ne_of_gt hτ
                  field_simp [hτne] at hn_gt
                  have hτn : τ * (n : ℝ) ≤ τ * (n : ℝ) ^ 2 :=
                    mul_le_mul_of_nonneg_left hn_sq_ge (le_of_lt hτ)
                  nlinarith [hn_gt, hτn]
                have hn_bound : 2 * B ^ 2 / (n : ℝ) ^ 2 ≤ τ / 2 := by
                  have hn2pos : 0 < (n : ℝ) ^ 2 := by positivity
                  field_simp [ne_of_gt hn2pos]
                  nlinarith [hn2_bound]
                obtain ⟨M, hM_depth, hM_width, hM_param, hM_approx⟩ :=
                  exists_fullyConnectedReLUNet_mul_approx_on_box (n := n) (R := B) hn hB
                refine ⟨n, M, hn, hM_depth, hn_bound, ?_⟩
                intro y hy0 hy1
                have hM_le : |M.realize y - y 0 * y 1| ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 := by
                  simpa [Nat.cast_pow] using hM_approx y hy0 hy1
                exact le_trans hM_le hn_bound
            -- @step s3: Compose A_P, the exact depth-one affine network for the first factor x (c 0) − center (c 0),
            -- and the multiplication network M into A : FullyConnectedReLUNet d; prove A.depth ≤ m + 1 and the box
            -- error bound ≤ τ using the product splitting, triangle inequality, multiplication error τ/2 and R * η = τ/2.
            have h_s3 :
                ∃ A : FullyConnectedReLUNet d,
                  A.depth ≤ m + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
                -- @step s1: Construct L : FullyConnectedReLUNet d with L.depth = 1 realizing exactly
                -- the first factor x (c 0) − center (c 0) on the box (depth-one affine network, as in h_base1).
                have h_s3_s1 :
                    ∃ L : FullyConnectedReLUNet d,
                      L.depth = 1 ∧
                      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                              L.realize x = x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩) := by
                        let w : Matrix (Fin 2) (Fin d) ℝ := fun j i =>
                          if j = 0 then (if c ⟨0, by omega⟩ = i then 1 else 0)
                          else (if c ⟨0, by omega⟩ = i then -1 else 0)
                        let b : Fin 2 → ℝ := fun j =>
                          if j = 0 then -center (c ⟨0, by omega⟩) else center (c ⟨0, by omega⟩)
                        let ow : Fin 2 → ℝ := fun j =>
                          if j = 0 then 1 else -1
                        let L : FullyConnectedReLUNet d :=
                          FullyConnectedReLUNet.mk 1 2 (DenseLayer.mk w b) (fun i => Fin.elim0 i) ow 0
                        refine ⟨L, ?_, ?_⟩
                        · dsimp [L]
                        · intro x hx
                          have hrelu_sub : ∀ t : ℝ, relu t - relu (-t) = t := by
                            intro t
                            unfold relu
                            by_cases ht : 0 ≤ t
                            · have ht' : -t ≤ 0 := by linarith
                              rw [max_eq_left ht, max_eq_right ht']
                              ring
                            · have ht' : t ≤ 0 := le_of_not_ge ht
                              have hneg : 0 ≤ -t := by linarith
                              rw [max_eq_right ht', max_eq_left hneg]
                              ring
                          have hhid : ∀ j : Fin 2, L.hiddenState x 0 j = relu (L.input.apply x j) := by
                            intro j
                            rfl
                          have happly0 :
                              L.input.apply x 0 = x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩) := by
                            simp [L, w, b, DenseLayer.apply, Finset.sum_ite_eq]
                            try ring
                          have happly1 :
                              L.input.apply x 1 = -(x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) := by
                            simp [L, w, b, DenseLayer.apply, Finset.sum_ite_eq]
                            try ring
                          have hreal : L.realize x = x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩) := by
                            calc
                              L.realize x =
                                  relu (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) -
                                    relu (-(x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩))) := by
                                simp [L, w, b, ow, FullyConnectedReLUNet.realize, DenseLayer.reluApply,
                                  reluVec, Fin.sum_univ_two, hhid, happly0, happly1, neg_one_mul]
                                try norm_num
                                try ring
                              _ = x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩) := by
                                exact hrelu_sub (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩))
                          exact hreal
                -- @step s2: Given the tail network A_P, its positive bound B and box bounds, and the exact
                -- first-factor network L, compose A_P and L in parallel padded to common depth m and append
                -- the depth-one multiplication network M (from h_s2) to form A : FullyConnectedReLUNet d with
                -- A.depth ≤ m + 1 and |A.realize x − (x (c 0) − center (c 0)) * A_P.realize x| ≤ τ/2 on the box.
                have h_s3_s2 :
                    ∀ (A_P : FullyConnectedReLUNet d) (B : ℝ), 0 < B →
                      (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                        |A_P.realize x| ≤ B ∧ |x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)| ≤ B) →
                      A_P.depth ≤ (m - 1) + 1 →
                      ∀ (L : FullyConnectedReLUNet d), L.depth = 1 →
                      (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                        L.realize x = x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) →
                      ∃ A : FullyConnectedReLUNet d, A.depth ≤ m + 1 ∧
                        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                          |A.realize x - (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) * A_P.realize x| ≤
                            τ / 2 := by
                  intro A_P B hB hbounds hAdepth L hLdepth hLrealize
                  -- @step s1: Choose n > 0 and a depth-one two-input network M from h_s2 (instantiated with A_P
                  -- and B) such that for all y : Fin 2 → ℝ with |y 0| ≤ B and |y 1| ≤ B,
                  -- |M.realize y - y 0 * y 1| ≤ τ/2.
                  have hs2_s1 :
                      ∃ (n : ℕ) (M : FullyConnectedReLUNet 2),
                        0 < n ∧ M.depth = 1 ∧ 2 * B ^ 2 / (n : ℝ) ^ 2 ≤ τ / 2 ∧
                          (∀ y : Fin 2 → ℝ, |y 0| ≤ B → |y 1| ≤ B → |M.realize y - y 0 * y 1| ≤ τ / 2) := by
                    exact h_s2 A_P B hB hbounds
                  rcases hs2_s1 with ⟨n, M, hn, hMdepth, hMbound, hMerr⟩
                  -- @step s2: Using the depth-one exact linear network L, the tail network A_P, and the chosen
                  -- multiplication net M, construct a composed network A whose realization on the box is
                  -- M.realize (A_P.realize x, L.realize x), padding A_P and L to a common depth and appending M;
                  -- prove A.depth ≤ m + 1 using A_P.depth ≤ (m - 1) + 1.
                  have hs2_s2 :
                      ∃ A : FullyConnectedReLUNet d,
                        A.depth ≤ m + 1 ∧
                          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                            A.realize x =
                              M.realize (fun i : Fin 2 => if (i : ℕ) = 0 then A_P.realize x else L.realize x) := by
                    -- @step s1: There exist padded networks A_P_pad and L_pad with A_P_pad.depth = m and
                    -- L_pad.depth = m such that for every x, A_P_pad.realize x = A_P.realize x and
                    -- L_pad.realize x = L.realize x (pad with identity layers to common depth m).
                    have hs2_s2_s1 :
                        ∃ A_P_pad L_pad : FullyConnectedReLUNet d,
                          A_P_pad.depth = m ∧ L_pad.depth = m ∧
                            (∀ x : Fin d → ℝ, A_P_pad.realize x = A_P.realize x) ∧
                            (∀ x : Fin d → ℝ, L_pad.realize x = L.realize x) := by
                              -- Identity padding layer; on nonnegative vectors its relu-application is the identity.
                              let hidLayer : ∀ w : ℕ, DenseLayer w w :=
                                fun w => { weight := fun i j => if j = i then (1 : ℝ) else 0, bias := fun _ => 0 }
                              have relu_nonneg : ∀ a : ℝ, 0 ≤ relu a := by
                                intro a
                                unfold relu
                                exact le_max_iff.mpr (Or.inr le_rfl)
                              have hid_apply : ∀ w (v : Fin w → ℝ), (hidLayer w).apply v = v := by
                                intro w v
                                funext i
                                simp [hidLayer, DenseLayer.apply]
                              have hid_reluApply : ∀ w (v : Fin w → ℝ), (∀ i, 0 ≤ v i) → (hidLayer w).reluApply v = v := by
                                intro w v hv
                                calc
                                  (hidLayer w).reluApply v = reluVec ((hidLayer w).apply v) := by simp [DenseLayer.reluApply]
                                  _ = reluVec v := by rw [hid_apply]
                                  _ = v := by
                                    funext i
                                    have h0 : 0 ≤ v i := hv i
                                    simp [reluVec, relu, max_eq_left h0]
                              -- hiddenState recursion equations (definitional unfolding of the brecOn definition)
                              have hs_zero : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ), N.hiddenState x 0 = N.input.reluApply x := by
                                intro N x
                                rfl
                              have hs_succ : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ),
                                  N.hiddenState x (t + 1) =
                                    if ht : t < N.depth - 1 then (N.hidden ⟨t, ht⟩).reluApply (N.hiddenState x t) else N.hiddenState x t := by
                                intro N x t
                                rfl
                              -- Every hidden state of every network is coordinatewise nonnegative.
                              have hstate_nonneg : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ) (i : Fin N.width),
                                  0 ≤ N.hiddenState x t i := by
                                intro N x t
                                induction t with
                                | zero =>
                                    intro i
                                    simp [hs_zero, DenseLayer.reluApply, reluVec, relu_nonneg]
                                | succ t ih =>
                                    intro i
                                    by_cases ht : t < N.depth - 1
                                    · simp [hs_succ, ht, DenseLayer.reluApply, reluVec, relu_nonneg]
                                    · simp [hs_succ, ht, ih]
                              -- Generic padding: pad N with identity layers to depth k ≥ N.depth, preserving realization.
                              have hpad_generic : ∀ (N : FullyConnectedReLUNet d) (k : ℕ), N.depth ≤ k →
                                  ∃ N' : FullyConnectedReLUNet d, N'.depth = k ∧ ∀ x : Fin d → ℝ, N'.realize x = N.realize x := by
                                intro N k hk
                                let N' : FullyConnectedReLUNet d :=
                                  { depth := k, width := N.width, input := N.input,
                                    hidden := fun j : Fin (k - 1) =>
                                      if h : j.1 < N.depth - 1 then N.hidden ⟨j.1, h⟩ else hidLayer N.width,
                                    outputWeight := N.outputWeight, outputBias := N.outputBias }
                                refine ⟨N', rfl, ?_⟩
                                intro x
                                -- states agree up to depth N.depth - 1
                                have hstate_le : ∀ t : ℕ, t ≤ N.depth - 1 → N'.hiddenState x t = N.hiddenState x t := by
                                  intro t ht
                                  induction t with
                                  | zero =>
                                      simp [hs_zero, N']
                                  | succ t ih =>
                                      have ht1 : t < N.depth - 1 := Nat.lt_of_succ_le ht
                                      have hk1 : t < k - 1 := lt_of_lt_of_le ht1 (Nat.sub_le_sub_right hk 1)
                                      simpa [hs_succ, N', hk1, ht1, ih (by omega)]
                                -- states stay constant over the padding part
                                have hstate_stable : ∀ t : ℕ, N.depth - 1 ≤ t → t < k →
                                    N'.hiddenState x (t + 1) = N'.hiddenState x t := by
                                  intro t ht_le ht_lt
                                  by_cases htk : t < k - 1
                                  · have hnot : ¬ t < N.depth - 1 := by omega
                                    have hnn : ∀ i : Fin N.width, 0 ≤ N'.hiddenState x t i := hstate_nonneg N' x t
                                    calc
                                      N'.hiddenState x (t + 1) = (hidLayer N.width).reluApply (N'.hiddenState x t) := by
                                        simp [hs_succ, N', htk, hnot]
                                      _ = N'.hiddenState x t := hid_reluApply N.width (N'.hiddenState x t) hnn
                                  · simp [hs_succ, N', htk]
                                -- iterate the constant-state step from N.depth - 1 up to k - 1
                                have hiter : ∀ t : ℕ, N.depth - 1 ≤ t → t ≤ k - 1 →
                                    N'.hiddenState x t = N'.hiddenState x (N.depth - 1) := by
                                  intro t ht1 ht2
                                  induction t with
                                  | zero =>
                                      have hz : N.depth - 1 = 0 := by omega
                                      simp [hz]
                                  | succ t ih =>
                                      by_cases ht_eq : t + 1 = N.depth - 1
                                      · simp [ht_eq]
                                      · have ht_ge : N.depth - 1 ≤ t := by omega
                                        have ht_lt : t < k := by omega
                                        calc
                                          N'.hiddenState x (t + 1) = N'.hiddenState x t := hstate_stable t ht_ge ht_lt
                                          _ = N'.hiddenState x (N.depth - 1) := ih ht_ge (by omega)
                                have hstate : N'.hiddenState x (k - 1) = N.hiddenState x (N.depth - 1) := by
                                  calc
                                    N'.hiddenState x (k - 1) = N'.hiddenState x (N.depth - 1) :=
                                      hiter (k - 1) (Nat.sub_le_sub_right hk 1) le_rfl
                                    _ = N.hiddenState x (N.depth - 1) := hstate_le (N.depth - 1) le_rfl
                                simp [FullyConnectedReLUNet.realize, N', hstate]
                              -- pad A_P and L to common depth m
                              have hAdepth_m : A_P.depth ≤ m := by
                                calc A_P.depth ≤ (m - 1) + 1 := hAdepth
                                  _ = m := by omega
                              rcases hpad_generic A_P m hAdepth_m with ⟨A_P_pad, hApad_depth, hApad_realize⟩
                              have hLdepth_m : L.depth ≤ m := by
                                rw [hLdepth]
                                omega
                              rcases hpad_generic L m hLdepth_m with ⟨L_pad, hLpad_depth, hLpad_realize⟩
                              exact ⟨A_P_pad, L_pad, hApad_depth, hLpad_depth, hApad_realize, hLpad_realize⟩
                    -- @step s2: For any two depth-m d-networks N1, N2 and any depth-one two-input network M2,
                    -- there exists A : FullyConnectedReLUNet d with A.depth ≤ m + 1 and
                    -- A.realize x = M2.realize (fun i : Fin 2 => if (i : ℕ) = 0 then N1.realize x else N2.realize x).
                    have hs2_s2_s2 :
                        ∀ (N1 N2 : FullyConnectedReLUNet d), N1.depth = m → N2.depth = m →
                          ∀ (M2 : FullyConnectedReLUNet 2), M2.depth = 1 →
                            ∃ A : FullyConnectedReLUNet d,
                              A.depth ≤ m + 1 ∧
                                ∀ x : Fin d → ℝ,
                                  A.realize x = M2.realize (fun i : Fin 2 => if (i : ℕ) = 0 then N1.realize x else N2.realize x) := by
                                    intro N1 N2 hN1depth hN2depth M2 hM2depth
                                    have hm_pos : 0 < m := by omega
                                    let w1 : ℕ := N1.width
                                    let w2 : ℕ := N2.width
                                    let w3 : ℕ := M2.width
                                    let w : ℕ := w1 + (w2 + w3)
                                    have happly_form : ∀ (L : DenseLayer w w) (x : Fin w → ℝ) (i : Fin w),
                                        L.apply x i = (∑ j : Fin w, L.weight i j * x j) + L.bias i := by
                                      intro L x i
                                      rfl
                                    have relu_nonneg : ∀ a : ℝ, 0 ≤ relu a := by
                                      intro a
                                      unfold relu
                                      exact le_max_iff.mpr (Or.inr le_rfl)
                                    have hs_zero : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ), N.hiddenState x 0 = N.input.reluApply x := by
                                      intro N x
                                      rfl
                                    have hs_succ : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ),
                                        N.hiddenState x (t + 1) =
                                          if ht : t < N.depth - 1 then (N.hidden ⟨t, ht⟩).reluApply (N.hiddenState x t) else N.hiddenState x t := by
                                      intro N x t
                                      rfl
                                    have hstate_nonneg : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ) (i : Fin N.width),
                                        0 ≤ N.hiddenState x t i := by
                                      intro N x t
                                      induction t with
                                      | zero =>
                                          intro i
                                          simp [hs_zero, DenseLayer.reluApply, reluVec, relu_nonneg]
                                      | succ t ih =>
                                          intro i
                                          by_cases ht : t < N.depth - 1
                                          · simp [hs_succ, ht, DenseLayer.reluApply, reluVec, relu_nonneg]
                                          · simp [hs_succ, ht, ih]
                                    let bs (s1 : Fin w1 → ℝ) (s2 : Fin w2 → ℝ) (s3 : Fin w3 → ℝ) : Fin w → ℝ :=
                                      fun j => if h1 : j.val < w1 then s1 ⟨j.val, h1⟩ else
                                               if h2 : j.val < w1 + w2 then s2 ⟨j.val - w1, by omega⟩ else
                                               s3 ⟨j.val - (w1 + w2), by omega⟩
                                    have hsplit : ∀ f : Fin w → ℝ,
                                        (∑ i : Fin w, f i) =
                                          (∑ i1 : Fin w1, f (Fin.castAdd (w2 + w3) i1)) +
                                            ((∑ i2 : Fin w2, f (Fin.natAdd w1 (Fin.castAdd w3 i2))) +
                                              (∑ i3 : Fin w3, f (Fin.natAdd w1 (Fin.natAdd w2 i3)))) := by
                                      intro f
                                      calc
                                        (∑ i : Fin w, f i) = ∑ i : Fin (w1 + (w2 + w3)), f i := by rfl
                                        _ = (∑ i1 : Fin w1, f (Fin.castAdd (w2 + w3) i1)) +
                                              ∑ i : Fin (w2 + w3), f (Fin.natAdd w1 i) := by
                                            rw [Fin.sum_univ_add]
                                        _ = (∑ i1 : Fin w1, f (Fin.castAdd (w2 + w3) i1)) +
                                              ((∑ i2 : Fin w2, f (Fin.natAdd w1 (Fin.castAdd w3 i2))) +
                                                (∑ i3 : Fin w3, f (Fin.natAdd w1 (Fin.natAdd w2 i3)))) := by
                                            congr 1
                                            rw [Fin.sum_univ_add]
                                    let inpLayer : DenseLayer d w :=
                                      { weight := fun j i =>
                                          if h1 : j.val < w1 then N1.input.weight ⟨j.val, h1⟩ i
                                          else if h2 : j.val < w1 + w2 then N2.input.weight ⟨j.val - w1, by omega⟩ i
                                          else 0,
                                        bias := fun j =>
                                          if h1 : j.val < w1 then N1.input.bias ⟨j.val, h1⟩
                                          else if h2 : j.val < w1 + w2 then N2.input.bias ⟨j.val - w1, by omega⟩
                                          else 0 }
                                    let parLayer (t : Fin m) : DenseLayer w w :=
                                      if ht : t.val < m - 1 then
                                        { weight := fun j i =>
                                            if h1 : j.val < w1 then
                                              if h2 : i.val < w1 then (N1.hidden ⟨t.val, by omega⟩).weight ⟨j.val, h1⟩ ⟨i.val, h2⟩
                                              else 0
                                            else if h3 : j.val < w1 + w2 then
                                              if h4 : i.val < w1 then 0
                                              else if h5 : i.val < w1 + w2 then (N2.hidden ⟨t.val, by omega⟩).weight ⟨j.val - w1, by omega⟩ ⟨i.val - w1, by omega⟩
                                              else 0
                                            else if j = i then (1 : ℝ) else 0,
                                          bias := fun j =>
                                            if h1 : j.val < w1 then (N1.hidden ⟨t.val, by omega⟩).bias ⟨j.val, h1⟩
                                            else if h3 : j.val < w1 + w2 then (N2.hidden ⟨t.val, by omega⟩).bias ⟨j.val - w1, by omega⟩
                                            else 0 }
                                      else
                                        { weight := fun j i =>
                                            if h3 : w1 + w2 ≤ j.val then
                                              if h4 : i.val < w1 then M2.input.weight ⟨j.val - (w1 + w2), by omega⟩ 0 * N1.outputWeight ⟨i.val, h4⟩
                                              else if h5 : i.val < w1 + w2 then M2.input.weight ⟨j.val - (w1 + w2), by omega⟩ 1 * N2.outputWeight ⟨i.val - w1, by omega⟩
                                              else 0
                                            else if j = i then (1 : ℝ) else 0,
                                          bias := fun j =>
                                            if h3 : w1 + w2 ≤ j.val then
                                              M2.input.weight ⟨j.val - (w1 + w2), by omega⟩ 0 * N1.outputBias +
                                                M2.input.weight ⟨j.val - (w1 + w2), by omega⟩ 1 * N2.outputBias +
                                                M2.input.bias ⟨j.val - (w1 + w2), by omega⟩
                                            else 0 }
                                    let outW : Fin w → ℝ := fun j =>
                                      if h3 : w1 + w2 ≤ j.val then M2.outputWeight ⟨j.val - (w1 + w2), by omega⟩ else 0
                                    let A : FullyConnectedReLUNet d :=
                                      { depth := m + 1, width := w, input := inpLayer,
                                        hidden := fun j : Fin ((m + 1) - 1) => parLayer ⟨j.val, by omega⟩,
                                        outputWeight := outW, outputBias := M2.outputBias }
                                    have hN1idx : ∀ (t : Fin m), t.val < m - 1 → t.val < N1.depth - 1 := by
                                      intro t ht
                                      rw [hN1depth]
                                      exact ht
                                    have hN2idx : ∀ (t : Fin m), t.val < m - 1 → t.val < N2.depth - 1 := by
                                      intro t ht
                                      rw [hN2depth]
                                      exact ht
                                    have hsum_id : ∀ (v : Fin w → ℝ) (j : Fin w),
                                        (∑ i : Fin w, (if j = i then (1 : ℝ) else 0) * v i) = v j := by
                                      intro v j
                                      rw [Finset.sum_eq_single j]
                                      · simp
                                      · intro b hb hbj
                                        have hbj' : j ≠ b := by
                                          intro hj
                                          exact hbj hj.symm
                                        simp [hbj']
                                      · intro hj
                                        exact (hj (Finset.mem_univ j)).elim
                                    have hpar_step : ∀ (t : Fin m) (a : Fin w1 → ℝ) (b : Fin w2 → ℝ),
                                        (ht : t.val < m - 1) →
                                        (parLayer t).reluApply (bs a b 0) =
                                          bs ((N1.hidden ⟨t.val, hN1idx t ht⟩).reluApply a) ((N2.hidden ⟨t.val, hN2idx t ht⟩).reluApply b) 0 := by
                                      intro t a b ht
                                      funext j
                                      by_cases h1 : j.val < w1
                                      · simp [bs, h1]
                                        simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
                                        rw [hsplit]
                                        simp [parLayer, ht, h1, DenseLayer.apply, reluVec, Fin.castAdd, Fin.natAdd, zero_add, Fin.isLt]
                                        congr!
                                      · by_cases h2 : j.val < w1 + w2
                                        · simp [bs, h1, h2]
                                          simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
                                          rw [hsplit]
                                          simp [parLayer, ht, h1, h2, DenseLayer.apply, reluVec, Fin.castAdd, Fin.natAdd, zero_add, Fin.isLt]
                                          congr!
                                        · have hweight3 : ∀ x : Fin w, (parLayer t).weight j x = if j = x then (1 : ℝ) else 0 := by
                                            intro x
                                            simp [parLayer, ht, h1, h2]
                                          have hsum3 : (∑ x : Fin w, (parLayer t).weight j x * (bs a b 0) x) = 0 := by
                                            calc
                                              (∑ x : Fin w, (parLayer t).weight j x * (bs a b 0) x)
                                                  = ∑ x : Fin w, (if j = x then (1 : ℝ) else 0) * (bs a b 0) x := by
                                                      apply Finset.sum_congr rfl
                                                      intro x hx
                                                      rw [hweight3 x]
                                              _ = (bs a b 0) j := by
                                                      rw [hsum_id (bs a b 0) j]
                                              _ = 0 := by
                                                      simp [bs, h1, h2]
                                          have hbias3 : (parLayer t).bias j = 0 := by
                                            simp [parLayer, ht, h1, h2]
                                          simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
                                          rw [hsum3, hbias3]
                                          simp [bs, h1, h2, relu]
                                    have hpar_state : ∀ x : Fin d → ℝ, ∀ t : ℕ, t < m →
                                        A.hiddenState x t = bs (N1.hiddenState x t) (N2.hiddenState x t) 0 := by
                                      intro x t
                                      induction t with
                                      | zero =>
                                          intro ht
                                          funext j
                                          by_cases h1 : j.val < w1
                                          · simp [A, inpLayer, bs, h1, hs_zero, DenseLayer.reluApply, reluVec, DenseLayer.apply, relu]
                                          · by_cases h2 : j.val < w1 + w2
                                            · simp [A, inpLayer, bs, h1, h2, hs_zero, DenseLayer.reluApply, reluVec, DenseLayer.apply, relu]
                                            · simp [A, inpLayer, bs, h1, h2, hs_zero, DenseLayer.reluApply, reluVec, DenseLayer.apply, relu]
                                      | succ t ih =>
                                          intro ht2
                                          have ht_lt : t < m - 1 := by omega
                                          have ht_lt_m : t < m := by omega
                                          calc
                                            A.hiddenState x (t + 1) = (A.hidden ⟨t, ht_lt_m⟩).reluApply (A.hiddenState x t) := by
                                              rw [hs_succ]
                                              simp [A, ht_lt_m]
                                            _ = (parLayer ⟨t, ht_lt_m⟩).reluApply (bs (N1.hiddenState x t) (N2.hiddenState x t) 0) := by
                                              simp [A]
                                              congr 1
                                              exact ih ht_lt_m
                                            _ = bs (N1.hiddenState x (t + 1)) (N2.hiddenState x (t + 1)) 0 := by
                                              rw [hpar_step ⟨t, ht_lt_m⟩ (N1.hiddenState x t) (N2.hiddenState x t) ht_lt]
                                              simp [hs_succ, hN1depth, hN2depth, ht_lt]
                                    refine ⟨A, ?_, ?_⟩
                                    · simp [A]
                                    · intro x
                                      let y : Fin 2 → ℝ := fun i => if (i : ℕ) = 0 then N1.realize x else N2.realize x
                                      change A.realize x = M2.realize y
                                      have hy0 : y 0 = N1.realize x := by simp [y]
                                      have hy1 : y 1 = N2.realize x := by simp [y]
                                      have hN1real : (∑ i1 : Fin w1, N1.outputWeight i1 * N1.hiddenState x (m - 1) i1) + N1.outputBias = N1.realize x := by
                                        unfold FullyConnectedReLUNet.realize
                                        simp [hN1depth]
                                        rfl
                                      have hN2real : (∑ i2 : Fin w2, N2.outputWeight i2 * N2.hiddenState x (m - 1) i2) + N2.outputBias = N2.realize x := by
                                        unfold FullyConnectedReLUNet.realize
                                        simp [hN2depth]
                                        rfl
                                      have hfin_idx : ∀ j : Fin w, w1 + w2 ≤ j.val → j.val - (w1 + w2) < w3 := by
                                        intro j hj
                                        have hjlt : j.val < w1 + (w2 + w3) := by simpa [w] using j.isLt
                                        omega
                                      have hfin : ∀ j : Fin w, ∀ hj : w1 + w2 ≤ j.val,
                                              A.hiddenState x m j = M2.input.reluApply y ⟨j.val - (w1 + w2), hfin_idx j hj⟩ := by
                                              intro j hj
                                              have hsucc_m : A.hiddenState x m = (A.hidden ⟨m - 1, by simp [A]; omega⟩).reluApply (A.hiddenState x (m - 1)) := by
                                                  have hstep := hs_succ A x (m - 1)
                                                  have hcond : m - 1 < A.depth - 1 := by
                                                    simp [A]
                                                    omega
                                                  have hmrew : m - 1 + 1 = m := by omega
                                                  simpa [hcond, hmrew] using hstep
                                              rw [hsucc_m]
                                              rw [hpar_state x (m - 1) (by omega : m - 1 < m)]
                                              have hnotlast : ¬(m - 1 < m - 1) := by omega
                                              simp [A, hnotlast, parLayer, bs]
                                              simp only [DenseLayer.reluApply, reluVec, DenseLayer.apply]
                                              congr 1
                                              rw [hsplit]
                                              simp [hj, Fin.castAdd, Fin.natAdd, zero_add, Fin.isLt]
                                              simp [Fin.sum_univ_two, hy0, hy1]
                                              simp_rw [mul_assoc]
                                              rw [(Finset.mul_sum (s := Finset.univ) (a := M2.input.weight ⟨j.val - (w1 + w2), hfin_idx j hj⟩ 0) (f := fun x_1 : Fin w1 => N1.outputWeight x_1 * N1.hiddenState x (m - 1) x_1)).symm]
                                              rw [(Finset.mul_sum (s := Finset.univ) (a := M2.input.weight ⟨j.val - (w1 + w2), hfin_idx j hj⟩ 1) (f := fun x_1 : Fin w2 => N2.outputWeight x_1 * N2.hiddenState x (m - 1) x_1)).symm]
                                              rw [← hN1real, ← hN2real]
                                              ring
                                      have hreal1 : A.realize x = (∑ j : Fin w, outW j * A.hiddenState x m j) + M2.outputBias := by
                                        unfold FullyConnectedReLUNet.realize
                                        simp [A]
                                      have hreal2 : (∑ j : Fin w, outW j * A.hiddenState x m j) + M2.outputBias = (∑ i3 : Fin w3, M2.outputWeight i3 * M2.input.reluApply y i3) + M2.outputBias := by
                                        rw [hsplit]
                                        have hout1 : ∀ i1 : Fin w1, outW (Fin.castAdd (w2 + w3) i1) = 0 := by
                                          intro i1
                                          have hnot : ¬ w1 + w2 ≤ i1.val := by omega
                                          simp [outW, Fin.castAdd, hnot]
                                        have hout2 : ∀ i2 : Fin w2, outW (Fin.natAdd w1 (Fin.castAdd w3 i2)) = 0 := by
                                          intro i2
                                          have hnot : ¬ w1 + w2 ≤ w1 + i2.val := by omega
                                          simp [outW, Fin.natAdd, Fin.castAdd, hnot]
                                        have hout3 : ∀ i3 : Fin w3, outW (Fin.natAdd w1 (Fin.natAdd w2 i3)) = M2.outputWeight i3 := by
                                          intro i3
                                          have hge : w1 + w2 ≤ (Fin.natAdd w1 (Fin.natAdd w2 i3)).val := by
                                            change w1 + w2 ≤ w1 + (w2 + i3.val)
                                            omega
                                          have hidx : (Fin.natAdd w1 (Fin.natAdd w2 i3)).val - (w1 + w2) = i3.val := by
                                            change (w1 + (w2 + i3.val)) - (w1 + w2) = i3.val
                                            omega
                                          have hval : w1 + (w2 + i3.val) - (w1 + w2) = i3.val := by omega
                                          simp [outW, Fin.natAdd, hge, hidx, hval]
                                        have hfin3 : ∀ i3 : Fin w3, A.hiddenState x m (Fin.natAdd w1 (Fin.natAdd w2 i3)) = M2.input.reluApply y i3 := by
                                          intro i3
                                          have hge : w1 + w2 ≤ (Fin.natAdd w1 (Fin.natAdd w2 i3)).val := by
                                            change w1 + w2 ≤ w1 + (w2 + i3.val)
                                            omega
                                          have hidx : (Fin.natAdd w1 (Fin.natAdd w2 i3)).val - (w1 + w2) = i3.val := by
                                            change (w1 + (w2 + i3.val)) - (w1 + w2) = i3.val
                                            omega
                                          have hfs := hfin (Fin.natAdd w1 (Fin.natAdd w2 i3)) hge
                                          exact hfs.trans (congrArg (M2.input.reluApply y) (Fin.ext hidx))

                                        simp [hout1, hout2, hout3, hfin3]
                                      have hreal3 : (∑ i3 : Fin w3, M2.outputWeight i3 * M2.input.reluApply y i3) + M2.outputBias = M2.realize y := by
                                        unfold FullyConnectedReLUNet.realize
                                        rw [hM2depth]
                                        norm_num
                                        rfl

                                      exact hreal1.trans (hreal2.trans hreal3)
                    -- @step s3: Instantiate s2 with N1 = A_P_pad and N2 = L_pad from s1 (using M, hn, hMdepth),
                    -- yielding the existential A with A.depth ≤ m + 1 and the desired realization equality.
                    have hs2_s2_s3 :
                        ∃ A : FullyConnectedReLUNet d,
                          A.depth ≤ m + 1 ∧
                            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                              A.realize x = M.realize (fun i : Fin 2 => if (i : ℕ) = 0 then A_P.realize x else L.realize x) := by
                                rcases hs2_s2_s1 with ⟨A_P_pad, L_pad, hAP_depth, hL_depth, hAP_realize, hL_realize⟩
                                rcases hs2_s2_s2 A_P_pad L_pad hAP_depth hL_depth M hMdepth with ⟨A, hAdepth, hArealize⟩
                                refine ⟨A, hAdepth, ?_⟩
                                intro x hxbox
                                rw [hArealize x]
                                congr 1
                                funext i
                                by_cases hi : (i : ℕ) = 0
                                · simp [hi, hAP_realize x]
                                · simp [hi, hL_realize x]
                    exact hs2_s2_s3
                  rcases hs2_s2 with ⟨A, hAdepthA, hArealize⟩
                  -- @step s3: On the box, with u = A_P.realize x and v = x (c 0) - center (c 0), use the bounds
                  -- |u| ≤ B and |v| ≤ B together with M's error bound and the equality v = L.realize x from
                  -- h_s3_s1 to conclude |A.realize x - v * A_P.realize x| ≤ τ/2.
                  have hs2_s3 :
                      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                        |A.realize x - (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) * A_P.realize x| ≤
                          τ / 2 := by
                    intro x hxbox
                    let y : Fin 2 → ℝ := fun i : Fin 2 => if (i : ℕ) = 0 then A_P.realize x else L.realize x
                    have hy0 : y 0 = A_P.realize x := by simp [y]
                    have hy1 : y 1 = L.realize x := by simp [y]
                    have hb0 : |y 0| ≤ B := by rw [hy0]; exact (hbounds x hxbox).1
                    have hb1 : |y 1| ≤ B := by
                      rw [hy1, hLrealize x hxbox]
                      exact (hbounds x hxbox).2
                    have hMulErr : |M.realize y - y 0 * y 1| ≤ τ / 2 := hMerr y hb0 hb1
                    have hprod : y 0 * y 1 = (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) * A_P.realize x := by
                      rw [hy0, hy1, hLrealize x hxbox]
                      exact mul_comm (A_P.realize x) (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩))
                    rw [hArealize x hxbox]
                    rw [← hprod]
                    exact hMulErr
                  exact ⟨A, hAdepthA, hs2_s3⟩
                -- @step s3: Extract A_P and B from h_s1, obtain L from h_s3_s1, compose via h_s3_s2, and split
                -- the degree-m product as the first factor times the tail to conclude the goal error bound ≤ τ.
                have h_s3_s3 :
                    ∃ A : FullyConnectedReLUNet d,
                      A.depth ≤ m + 1 ∧
                      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                        |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
                          rcases h_s1 with ⟨A_P, B, hB, hAPdepth, hAPerr, hAPbounds⟩
                          rcases h_s3_s1 with ⟨L, hLdepth, hLrealize⟩
                          rcases h_s3_s2 A_P B hB hAPbounds hAPdepth L hLdepth hLrealize with
                            ⟨A, hAdepth, hAerr⟩
                          refine ⟨A, hAdepth, ?_⟩
                          intro x hx
                          let g : Fin d → ℝ := fun q => x q - center q
                          let ℓ : ℝ := g (c ⟨0, by omega⟩)
                          let T : ℝ := ∏ i : Fin (m - 1), g (c (Fin.cast (by omega) (Fin.succ i)))
                          have hFinEq : (m - 1) + 1 = m := by omega
                          have hcast0 : Fin.cast hFinEq (0 : Fin (m - 1 + 1)) = (⟨0, by omega⟩ : Fin m) := by
                            ext <;> simp [Fin.cast]
                          have hprod : (∏ q : Fin m, (x (c q) - center (c q))) = ℓ * T := by
                            let e : Fin (m - 1 + 1) ≃ Fin m :=
                              { toFun := Fin.cast hFinEq
                                invFun := Fin.cast hFinEq.symm
                                left_inv := by intro a; ext <;> rfl
                                right_inv := by intro b; ext <;> rfl }
                            have hreindex :
                                (∏ q : Fin m, (x (c q) - center (c q))) =
                                  ∏ q : Fin (m - 1 + 1),
                                    (x (c (Fin.cast hFinEq q)) - center (c (Fin.cast hFinEq q))) := by
                              exact (Fintype.prod_equiv e
                                (fun q : Fin (m - 1 + 1) => (x (c (Fin.cast hFinEq q)) - center (c (Fin.cast hFinEq q))))
                                (fun q : Fin m => (x (c q) - center (c q)))
                                (by intro q; rfl)).symm
                            calc
                              (∏ q : Fin m, (x (c q) - center (c q))) =
                                  ∏ q : Fin (m - 1 + 1),
                                    (x (c (Fin.cast hFinEq q)) - center (c (Fin.cast hFinEq q))) := hreindex
                              _ = (x (c (Fin.cast hFinEq 0)) - center (c (Fin.cast hFinEq 0))) *
                                    ∏ i : Fin (m - 1), (x (c (Fin.cast hFinEq (Fin.succ i))) - center (c (Fin.cast hFinEq (Fin.succ i)))) := by
                                rw [Fin.prod_univ_succ]
                              _ = (x (c ⟨0, by omega⟩) - center (c ⟨0, by omega⟩)) *
                                    ∏ i : Fin (m - 1), (x (c (Fin.cast hFinEq (Fin.succ i))) - center (c (Fin.cast hFinEq (Fin.succ i)))) := by
                                rw [hcast0]
                              _ = ℓ * T := by
                                rfl
                          have hAerr' : |A.realize x - ℓ * A_P.realize x| ≤ τ / 2 := by
                            simpa [ℓ, g] using hAerr x hx
                          have hAPerr' : |A_P.realize x - T| ≤ τ / (2 * R) := by
                            simpa [T, g] using hAPerr x hx
                          have hℓR : |ℓ| ≤ R := by
                            simpa [ℓ, g] using hx (c ⟨0, by omega⟩)
                          have hTri : |A.realize x - ℓ * T| ≤ |A.realize x - ℓ * A_P.realize x| + |ℓ| * |A_P.realize x - T| := by
                            calc
                              |A.realize x - ℓ * T| = |(A.realize x - ℓ * A_P.realize x) + ℓ * (A_P.realize x - T)| := by
                                congr 1
                                ring
                              _ ≤ |A.realize x - ℓ * A_P.realize x| + |ℓ * (A_P.realize x - T)| := abs_add_le _ _
                              _ = |A.realize x - ℓ * A_P.realize x| + |ℓ| * |A_P.realize x - T| := by
                                rw [abs_mul]
                          have hMulB : |ℓ| * |A_P.realize x - T| ≤ R * (τ / (2 * R)) := by
                            exact mul_le_mul hℓR hAPerr' (abs_nonneg _) (le_of_lt hR)
                          have hRτ : R * (τ / (2 * R)) = τ / 2 := by
                            field_simp [hR.ne']
                          have hMain : |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
                            rw [hprod]
                            linarith [hTri, hAerr', hMulB, hRτ]
                          exact hMain
                exact h_s3_s3
            exact h_s3
          -- @step s4: Combine the base cases and the induction step by induction on m to conclude
          -- the uniform claim.
          have h_combine :
              ∀ m : ℕ, ∀ τ : ℝ, 0 < τ → ∀ c : Fin m → Fin d, ∃ A : FullyConnectedReLUNet d,
                A.depth ≤ m + 1 ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤ τ := by
            intro m
            induction m using Nat.strong_induction_on with
            | h m ih =>
                intro τ hτ c
                by_cases hm0 : m = 0
                · subst m
                  exact h_base0 τ hτ c
                · by_cases hm1 : m = 1
                  · subst m
                    exact h_base1 τ hτ c
                  · have hm2 : 2 ≤ m := by omega
                    have hIH := ih (m - 1) (by omega)
                    exact h_step m hm2 hIH τ hτ c
          exact h_combine
        -- @step s2: Instantiate the uniform claim at m = degree r, τ = εr r, c = coord r,
        -- using 0 < εr r to obtain Ar with depth ≤ degree r + 1 and box error at most εr r.
        have h_s1_2_2 :
            ∀ εr : ι → ℝ, (∀ r ∈ s, 0 < εr r) → ∀ r ∈ s, ∃ Ar : FullyConnectedReLUNet d,
              Ar.depth ≤ degree r + 1 ∧
              ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                |Ar.realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r := by
          intro εr hεr_pos
          intro r hr
          exact h_s1_2_1 (degree r) (εr r) (hεr_pos r hr) (coord r)
        exact h_s1_2_2
      rcases h_s1_1 with ⟨εr, hεr_pos, hεr_budget⟩
      exact ⟨εr, fun r hr => le_of_lt (hεr_pos r hr), hεr_budget, h_s1_2 εr hεr_pos⟩
  -- @step s2: Pad all per-monomial networks to the common depth D = ∑ r∈s (degree r + 1), combine
  -- them into one network N realizing the finite linear combination with error at most
  -- ∑_{r∈s} |coeff r| * εr r, and conclude N.depth ≤ D + 1.
  have h_s2 :
      ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤ (∑ r ∈ s, (degree r + 1)) + 1 ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
          |N.realize x -
              finiteLinearCombination s coeff
                (fun r : ι => fun y : Fin d → ℝ =>
                  ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤ ε := by
      -- @step s1: Choose per-term networks Ar from h_s1 and pad them to the common depth
      -- D = ∑ r∈s (degree r + 1), preserving realization and box error
      let D : ℕ := ∑ r ∈ s, (degree r + 1)
      have h_s2_s1 :
          ∃ εr : ι → ℝ,
            (∀ r ∈ s, 0 ≤ εr r) ∧
            (∑ r ∈ s, |coeff r| * εr r) ≤ ε ∧
            ∃ Ar' : ι → FullyConnectedReLUNet d,
              (∀ r ∈ s, (Ar' r).depth = D) ∧
              ∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r := by
          classical
          rcases h_s1 with ⟨εr, hεr_nonneg, hεr_sum, hAr⟩
          choose Ar hArD hArErr using hAr
          let idLayer (n : ℕ) : DenseLayer n n :=
            { weight := fun i j => if j = i then (1 : ℝ) else 0
              bias := fun _ => 0 }
          have h_relu_idem : ∀ z : ℝ, relu (relu z) = relu z := by
            intro z
            rw [relu, relu]
            rw [max_eq_left (le_max_right z 0)]
          have h_reluVec_idem : ∀ {n : ℕ} (v : Fin n → ℝ), reluVec (reluVec v) = reluVec v := by
            intro n v
            funext i
            change relu (relu (v i)) = relu (v i)
            exact h_relu_idem (v i)
          have h_reluApply_fix : ∀ {m n : ℕ} (L : DenseLayer m n) (v : Fin m → ℝ),
              reluVec (L.reluApply v) = L.reluApply v := by
            intro m n L v
            change reluVec (reluVec (L.apply v)) = reluVec (L.apply v)
            exact h_reluVec_idem (L.apply v)
          have h_hidden_fix : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (t : ℕ),
              reluVec (N.hiddenState x t) = N.hiddenState x t := by
            intro N x t
            induction t with
            | zero =>
                change reluVec (N.input.reluApply x) = N.input.reluApply x
                exact h_reluApply_fix N.input x
            | succ t ih =>
                by_cases ht : t < N.depth - 1
                · simp [FullyConnectedReLUNet.hiddenState, ht, h_reluApply_fix]
                · simp [FullyConnectedReLUNet.hiddenState, ht, ih]
          have h_id_apply : ∀ {n : ℕ} (v : Fin n → ℝ), (idLayer n).apply v = v := by
            intro n v
            funext i
            change (∑ j : Fin n, (idLayer n).weight i j * v j) + (idLayer n).bias i = v i
            simp [idLayer, Finset.sum_ite_eq]
          have h_id_reluApply : ∀ {n : ℕ} (v : Fin n → ℝ), (idLayer n).reluApply v = reluVec v := by
            intro n v
            change reluVec ((idLayer n).apply v) = reluVec v
            rw [h_id_apply v]
          let pad (k : ℕ) (A : FullyConnectedReLUNet d) (_hA : A.depth ≤ k) : FullyConnectedReLUNet d :=
            { depth := k
              width := A.width
              input := A.input
              hidden := fun t : Fin (k - 1) =>
                if ht : t.val < A.depth - 1 then A.hidden ⟨t.val, ht⟩ else idLayer A.width
              outputWeight := A.outputWeight
              outputBias := A.outputBias }
          have h_pad_depth : ∀ (k : ℕ) (A : FullyConnectedReLUNet d) (hA : A.depth ≤ k),
              (pad k A hA).depth = k := by
            intro k A hA
            rfl
          have h_pad_state :
              ∀ (k : ℕ) (A : FullyConnectedReLUNet d) (hA : A.depth ≤ k) (x : Fin d → ℝ),
                (pad k A hA).hiddenState x (k - 1) = A.hiddenState x (A.depth - 1) := by
            intro k A hA x
            let B : FullyConnectedReLUNet d := pad k A hA
            change B.hiddenState x (k - 1) = A.hiddenState x (A.depth - 1)
            have h_main : ∀ t : ℕ, t ≤ k - 1 →
                B.hiddenState x t = A.hiddenState x (min t (A.depth - 1)) := by
              intro t
              induction t with
              | zero =>
                  intro ht0
                  rw [min_eq_left (Nat.zero_le (A.depth - 1))]
                  simp [B, pad, FullyConnectedReLUNet.hiddenState]
              | succ t ih =>
                  intro ht
                  have htk : t < k - 1 := by omega
                  have ht_prev : t ≤ k - 1 := by omega
                  have htkB : t < B.depth - 1 := by
                    simpa [B, pad] using htk
                  by_cases htA : t < A.depth - 1
                  · have hmin_t : min t (A.depth - 1) = t := min_eq_left (Nat.le_of_lt htA)
                    have hmin_st : min (t + 1) (A.depth - 1) = t + 1 :=
                      min_eq_left (Nat.succ_le_of_lt htA)
                    rw [hmin_st]
                    simp only [FullyConnectedReLUNet.hiddenState]
                    simp [B, pad, htkB, htA, ih ht_prev, hmin_t]
                  · have hA2 : A.depth - 1 ≤ t := by omega
                    have hmin_t : min t (A.depth - 1) = A.depth - 1 := min_eq_right hA2
                    have hmin_st : min (t + 1) (A.depth - 1) = A.depth - 1 :=
                      min_eq_right (Nat.le_trans hA2 (Nat.le_succ t))
                    rw [hmin_st]
                    simp only [FullyConnectedReLUNet.hiddenState]
                    simp [B, pad, htkB, htA, h_id_apply, h_id_reluApply, h_hidden_fix, ih ht_prev, hmin_t]
            have hArg : A.depth - 1 ≤ k - 1 := by omega
            rw [h_main (k - 1) (le_rfl), min_eq_right hArg]
          have h_pad_realize :
              ∀ (k : ℕ) (A : FullyConnectedReLUNet d) (hA : A.depth ≤ k) (x : Fin d → ℝ),
                (pad k A hA).realize x = A.realize x := by
            intro k A hA x
            unfold FullyConnectedReLUNet.realize
            simp only [pad]
            rw [h_pad_state k A hA x]
          have hDeg_le_D : ∀ r ∈ s, degree r + 1 ≤ D := by
            intro r hr
            dsimp [D]
            exact Finset.single_le_sum (fun r' hr' => Nat.zero_le (degree r' + 1)) hr
          have hAr_le_D : ∀ (r : ι) (hr : r ∈ s), (Ar r hr).depth ≤ D := by
            intro r hr
            exact le_trans (hArD r hr) (hDeg_le_D r hr)
          let defaultNet : FullyConnectedReLUNet d :=
            { depth := 1
              width := 1
              input := { weight := fun _ _ => 0, bias := fun _ => 0 }
              hidden := fun i => Fin.elim0 i
              outputWeight := fun _ => 0
              outputBias := 0 }
          let A' : ι → FullyConnectedReLUNet d := fun r =>
            if hr : r ∈ s then pad D (Ar r hr) (hAr_le_D r hr) else defaultNet
          refine ⟨εr, hεr_nonneg, hεr_sum, ⟨A', ?_, ?_⟩⟩
          · intro r hr
            simp [A', hr, h_pad_depth]
          · intro r hr x hx
            have hAr' : (A' r).realize x = (Ar r hr).realize x := by
              simp [A', hr, h_pad_realize]
            rw [hAr']
            exact hArErr r hr x hx
      -- @step s2: Equal-depth linear-combination assembly: networks all of depth D combine
      -- into one with depth ≤ D + 1 and box error ≤ ∑ r∈s |coeff r| * εr r
      have h_s2_s2 :
          ∀ (εr : ι → ℝ) (Ar' : ι → FullyConnectedReLUNet d),
            (∀ r ∈ s, 0 ≤ εr r) →
            (∀ r ∈ s, (Ar' r).depth = D) →
            (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r) →
            ∃ N : FullyConnectedReLUNet d,
              N.depth ≤ D + 1 ∧
              ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                |N.realize x -
                  finiteLinearCombination s coeff
                    (fun r : ι => fun y : Fin d → ℝ =>
                      ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                  ∑ r ∈ s, |coeff r| * εr r := by
          -- @step s1: Equal-depth binary combination lemma: two networks of depth D combine into a
          -- network of depth D with pointwise error |a|*ε₁ + |b|*ε₂ for the linear combination
          have h_bin :
              ∀ (P : (Fin d → ℝ) → Prop) (N₁ N₂ : FullyConnectedReLUNet d) (f₁ f₂ : (Fin d → ℝ) → ℝ) (ε₁ ε₂ : ℝ),
                0 ≤ ε₁ → 0 ≤ ε₂ → N₁.depth = D → N₂.depth = D →
                (∀ x : Fin d → ℝ, P x → |N₁.realize x - f₁ x| ≤ ε₁) →
                (∀ x : Fin d → ℝ, P x → |N₂.realize x - f₂ x| ≤ ε₂) →
                ∀ (a b : ℝ), ∃ N : FullyConnectedReLUNet d,
                  N.depth = D ∧ ∀ x : Fin d → ℝ, P x → |N.realize x - (a * f₁ x + b * f₂ x)| ≤ |a| * ε₁ + |b| * ε₂ := by
            intro P N₁ N₂ f₁ f₂ ε₁ ε₂ hε₁ hε₂ hd₁ hd₂ h₁ h₂
            intro a b
            let w₁ : ℕ := N₁.width
            let w₂ : ℕ := N₂.width
            -- parallel-run network of depth D and width w₁ + w₂, with fused readout
            let N : FullyConnectedReLUNet d :=
              { depth := D
                width := w₁ + w₂
                input :=
                  { weight := fun i j => if h : i.1 < w₁ then N₁.input.weight ⟨i.1, h⟩ j else N₂.input.weight ⟨i.1 - w₁, by omega⟩ j
                    bias := fun i => if h : i.1 < w₁ then N₁.input.bias ⟨i.1, h⟩ else N₂.input.bias ⟨i.1 - w₁, by omega⟩ }
                hidden := fun t =>
                  { weight := fun i j =>
                      if h : i.1 < w₁ then
                        (if h' : j.1 < w₁ then (N₁.hidden ⟨t.1, by omega⟩).weight ⟨i.1, h⟩ ⟨j.1, h'⟩ else 0)
                      else
                        (if h' : j.1 < w₁ then 0 else (N₂.hidden ⟨t.1, by omega⟩).weight ⟨i.1 - w₁, by omega⟩ ⟨j.1 - w₁, by omega⟩)
                    bias := fun i =>
                      if h : i.1 < w₁ then (N₁.hidden ⟨t.1, by omega⟩).bias ⟨i.1, h⟩ else (N₂.hidden ⟨t.1, by omega⟩).bias ⟨i.1 - w₁, by omega⟩ }
                outputWeight := fun i => if h : i.1 < w₁ then a * N₁.outputWeight ⟨i.1, h⟩ else b * N₂.outputWeight ⟨i.1 - w₁, by omega⟩
                outputBias := a * N₁.outputBias + b * N₂.outputBias }
            have h_Ndepth : N.depth = D := rfl
            -- generic split of a sum over Fin (w₁+w₂) into left/right blocks
            have h_split_sum :
                ∀ (G : Fin (w₁ + w₂) → ℝ) (F₁ : Fin w₁ → ℝ) (F₂ : Fin w₂ → ℝ),
                  (∀ j₁ : Fin w₁, G (Fin.castAdd w₂ j₁) = F₁ j₁) →
                  (∀ j₂ : Fin w₂, G (Fin.natAdd w₁ j₂) = F₂ j₂) →
                  (∑ j : Fin (w₁ + w₂), G j) = (∑ j₁ : Fin w₁, F₁ j₁) + (∑ j₂ : Fin w₂, F₂ j₂) := by
              intro G F₁ F₂ hG₁ hG₂
              let e : Fin w₁ ⊕ Fin w₂ ≃ Fin (w₁ + w₂) := finSumFinEquiv
              have h1 : (∑ a : Fin w₁ ⊕ Fin w₂, G (e a)) = (∑ j : Fin (w₁ + w₂), G j) := by
                exact Fintype.sum_equiv e (fun a => G (e a)) G (by intro a; rfl)
              rw [← h1]
              rw [Fintype.sum_sum_type]
              have hL : (∑ j₁ : Fin w₁, G (e (Sum.inl j₁))) = ∑ j₁ : Fin w₁, F₁ j₁ := by
                apply Finset.sum_congr rfl
                intro j₁ hj₁
                have hc : e (Sum.inl j₁) = Fin.castAdd w₂ j₁ := finSumFinEquiv_apply_left j₁
                rw [hc]
                exact hG₁ j₁
              have hR : (∑ j₂ : Fin w₂, G (e (Sum.inr j₂))) = ∑ j₂ : Fin w₂, F₂ j₂ := by
                apply Finset.sum_congr rfl
                intro j₂ hj₂
                have hc : e (Sum.inr j₂) = Fin.natAdd w₁ j₂ := finSumFinEquiv_apply_right j₂
                rw [hc]
                exact hG₂ j₂
              rw [hL, hR]
            -- input layer runs N₁ and N₂ in parallel (row split)
            have h_in_apply : ∀ (x : Fin d → ℝ) (i : Fin (w₁ + w₂)),
                N.input.apply x i = if h : i.1 < w₁ then N₁.input.apply x ⟨i.1, h⟩ else N₂.input.apply x ⟨i.1 - w₁, by omega⟩ := by
              intro x i
              by_cases hi : i.1 < w₁
              · simp [N, hi, DenseLayer.apply]
              · simp [N, hi, DenseLayer.apply]
            have h_hid_apply : ∀ (t : Fin (D - 1)) (v : Fin (w₁ + w₂) → ℝ) (i : Fin (w₁ + w₂)),
                (N.hidden t).apply v i =
                  if h : i.1 < w₁ then
                    (N₁.hidden ⟨t.1, by omega⟩).apply (fun j₁ : Fin w₁ => v (Fin.castAdd w₂ j₁)) ⟨i.1, h⟩
                  else
                    (N₂.hidden ⟨t.1, by omega⟩).apply (fun j₂ : Fin w₂ => v (Fin.natAdd w₁ j₂)) ⟨i.1 - w₁, by omega⟩ := by
              intro t v i
              by_cases hi : i.1 < w₁
              · let G₁ : Fin (w₁ + w₂) → ℝ :=
                  fun j => (if h' : j.1 < w₁ then (N₁.hidden ⟨t.1, by omega⟩).weight ⟨i.1, hi⟩ ⟨j.1, h'⟩ else 0) * v j
                have hsplit' : (∑ j : Fin (w₁ + w₂), G₁ j) =
                    (∑ j₁ : Fin w₁, G₁ (Fin.castAdd w₂ j₁)) + (∑ j₂ : Fin w₂, G₁ (Fin.natAdd w₁ j₂)) := by
                  exact h_split_sum G₁ (fun j₁ : Fin w₁ => G₁ (Fin.castAdd w₂ j₁))
                    (fun j₂ : Fin w₂ => G₁ (Fin.natAdd w₁ j₂)) (by intro j₁; rfl) (by intro j₂; rfl)
                have hL₁ : (∑ j₁ : Fin w₁, G₁ (Fin.castAdd w₂ j₁)) =
                    ∑ j₁ : Fin w₁, (N₁.hidden ⟨t.1, by omega⟩).weight ⟨i.1, hi⟩ j₁ * v (Fin.castAdd w₂ j₁) := by
                  apply Finset.sum_congr rfl
                  intro j₁ hj₁
                  simp [G₁, Fin.castAdd, j₁.isLt]
                have hR₁ : (∑ j₂ : Fin w₂, G₁ (Fin.natAdd w₁ j₂)) = 0 := by
                  apply Finset.sum_eq_zero
                  intro j₂ hj₂
                  have hn : ¬ (Fin.natAdd w₁ j₂).1 < w₁ := by
                    simpa [Fin.natAdd] using (show ¬ w₁ + j₂.1 < w₁ by omega)
                  simp [G₁, hn]
                rw [DenseLayer.apply]
                have hw₁ : ∀ j : Fin (w₁ + w₂),
                    (N.hidden t).weight i j =
                      if h' : j.1 < w₁ then (N₁.hidden ⟨t.1, by omega⟩).weight ⟨i.1, hi⟩ ⟨j.1, h'⟩ else 0 := by
                  intro j
                  simp [N, hi]
                have hb₁ : (N.hidden t).bias i = (N₁.hidden ⟨t.1, by omega⟩).bias ⟨i.1, hi⟩ := by
                  simp [N, hi]
                simp only [hw₁, hb₁]
                rw [hsplit', hL₁, hR₁]
                simp [DenseLayer.apply, hi]
                rfl
              · let G₂ : Fin (w₁ + w₂) → ℝ :=
                  fun j => (if h' : j.1 < w₁ then 0 else (N₂.hidden ⟨t.1, by omega⟩).weight ⟨i.1 - w₁, by omega⟩ ⟨j.1 - w₁, by omega⟩) * v j
                have hsplit' : (∑ j : Fin (w₁ + w₂), G₂ j) =
                    (∑ j₁ : Fin w₁, G₂ (Fin.castAdd w₂ j₁)) + (∑ j₂ : Fin w₂, G₂ (Fin.natAdd w₁ j₂)) := by
                  exact h_split_sum G₂ (fun j₁ : Fin w₁ => G₂ (Fin.castAdd w₂ j₁))
                    (fun j₂ : Fin w₂ => G₂ (Fin.natAdd w₁ j₂)) (by intro j₁; rfl) (by intro j₂; rfl)
                have hL₂ : (∑ j₁ : Fin w₁, G₂ (Fin.castAdd w₂ j₁)) = 0 := by
                  apply Finset.sum_eq_zero
                  intro j₁ hj₁
                  simp [G₂, Fin.castAdd, j₁.isLt]
                have hR₂ : (∑ j₂ : Fin w₂, G₂ (Fin.natAdd w₁ j₂)) =
                    ∑ j₂ : Fin w₂, (N₂.hidden ⟨t.1, by omega⟩).weight ⟨i.1 - w₁, by omega⟩ j₂ * v (Fin.natAdd w₁ j₂) := by
                  apply Finset.sum_congr rfl
                  intro j₂ hj₂
                  have hn : ¬ (Fin.natAdd w₁ j₂).1 < w₁ := by
                    simpa [Fin.natAdd] using (show ¬ w₁ + j₂.1 < w₁ by omega)
                  simp [G₂, hn, Fin.natAdd, Nat.add_sub_cancel]
                rw [DenseLayer.apply]
                have hw₂ : ∀ j : Fin (w₁ + w₂),
                    (N.hidden t).weight i j =
                      if h' : j.1 < w₁ then 0 else (N₂.hidden ⟨t.1, by omega⟩).weight ⟨i.1 - w₁, by omega⟩ ⟨j.1 - w₁, by omega⟩ := by
                  intro j
                  simp [N, hi]
                have hb₂ : (N.hidden t).bias i = (N₂.hidden ⟨t.1, by omega⟩).bias ⟨i.1 - w₁, by omega⟩ := by
                  simp [N, hi]
                simp only [hw₂, hb₂]
                rw [hsplit', hL₂, hR₂]
                simp [DenseLayer.apply, hi]
                rfl
            have h_statesucc : ∀ x (k : Fin (D - 1)),
                N.hiddenState x (k.1 + 1) = fun i => (N.hidden k).reluApply (N.hiddenState x k.1) i := by
              intro x k
              simp [FullyConnectedReLUNet.hiddenState, h_Ndepth, k.2]
            have h₁_statesucc : ∀ x (k₁ : Fin (N₁.depth - 1)),
                N₁.hiddenState x (k₁.1 + 1) = fun i => (N₁.hidden k₁).reluApply (N₁.hiddenState x k₁.1) i := by
              intro x k₁
              simp [FullyConnectedReLUNet.hiddenState, k₁.2]
            have h₂_statesucc : ∀ x (k₂ : Fin (N₂.depth - 1)),
                N₂.hiddenState x (k₂.1 + 1) = fun i => (N₂.hidden k₂).reluApply (N₂.hiddenState x k₂.1) i := by
              intro x k₂
              simp [FullyConnectedReLUNet.hiddenState, k₂.2]
            have h_state : ∀ (x : Fin d → ℝ) (k : ℕ), k ≤ D - 1 →
                N.hiddenState x k = fun i : Fin (w₁ + w₂) =>
                  if h : i.1 < w₁ then N₁.hiddenState x k ⟨i.1, h⟩ else N₂.hiddenState x k ⟨i.1 - w₁, by omega⟩ := by
              intro x k
              induction k with
              | zero =>
                  intro hk
                  funext i
                  by_cases hi : i.1 < w₁
                  · simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, h_in_apply, hi]
                  · simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, h_in_apply, hi]
              | succ k ih =>
                  intro hk
                  have hk₁ : k < N₁.depth - 1 := by omega
                  have hk₂ : k < N₂.depth - 1 := by omega
                  have hkD : k < D - 1 := by omega
                  have hle : k ≤ D - 1 := by omega
                  rw [h_statesucc x ⟨k, hkD⟩, h₁_statesucc x ⟨k, hk₁⟩, h₂_statesucc x ⟨k, hk₂⟩]
                  simp
                  funext i
                  by_cases hi : i.1 < w₁
                  · simp [DenseLayer.reluApply, reluVec]
                    rw [h_hid_apply ⟨k, hkD⟩ (N.hiddenState x k) i]
                    simp only [hi]
                    have hfun : (fun j₁ : Fin w₁ => (N.hiddenState x k) (Fin.castAdd w₂ j₁)) = N₁.hiddenState x k := by
                      funext j₁
                      have hc := congrFun (ih hle) (Fin.castAdd w₂ j₁)
                      simpa [Fin.castAdd, j₁.isLt] using hc
                    rw [hfun]
                    rfl
                  · simp [DenseLayer.reluApply, reluVec]
                    rw [h_hid_apply ⟨k, hkD⟩ (N.hiddenState x k) i]
                    simp only [hi]
                    have hfun₂ : (fun j₂ : Fin w₂ => (N.hiddenState x k) (Fin.natAdd w₁ j₂)) = N₂.hiddenState x k := by
                      funext j₂
                      have hc := congrFun (ih hle) (Fin.natAdd w₁ j₂)
                      simpa [Fin.natAdd, show ¬ w₁ + j₂.1 < w₁ by omega, Nat.add_sub_cancel] using hc
                    rw [hfun₂]
                    rfl
            have h_realize : ∀ x : Fin d → ℝ, N.realize x = a * N₁.realize x + b * N₂.realize x := by
              intro x
              have hout : ∀ i : Fin (w₁ + w₂),
                  N.outputWeight i * N.hiddenState x (D - 1) i =
                    if h : i.1 < w₁ then
                      a * (N₁.outputWeight ⟨i.1, h⟩ * N₁.hiddenState x (D - 1) ⟨i.1, h⟩)
                    else
                      b * (N₂.outputWeight ⟨i.1 - w₁, by omega⟩ * N₂.hiddenState x (D - 1) ⟨i.1 - w₁, by omega⟩) := by
                intro i
                by_cases hi : i.1 < w₁
                · rw [h_state x (D - 1) (le_rfl : D - 1 ≤ D - 1)]
                  simp [N, hi, mul_assoc]
                · rw [h_state x (D - 1) (le_rfl : D - 1 ≤ D - 1)]
                  simp [N, hi, mul_assoc]
              have hG₁ : ∀ j₁ : Fin w₁,
                  N.outputWeight (Fin.castAdd w₂ j₁) * N.hiddenState x (D - 1) (Fin.castAdd w₂ j₁) =
                    a * (N₁.outputWeight j₁ * N₁.hiddenState x (D - 1) j₁) := by
                intro j₁
                rw [hout (Fin.castAdd w₂ j₁)]
                simp [Fin.castAdd, j₁.isLt]
              have hG₂ : ∀ j₂ : Fin w₂,
                  N.outputWeight (Fin.natAdd w₁ j₂) * N.hiddenState x (D - 1) (Fin.natAdd w₁ j₂) =
                    b * (N₂.outputWeight j₂ * N₂.hiddenState x (D - 1) j₂) := by
                intro j₂
                rw [hout (Fin.natAdd w₁ j₂)]
                have hn : ¬ (Fin.natAdd w₁ j₂).1 < w₁ := by
                  simpa [Fin.natAdd] using (show ¬ w₁ + j₂.1 < w₁ by omega)
                simp [hn, Fin.natAdd, Nat.add_sub_cancel]
              have hsplit := h_split_sum
                (fun i : Fin (w₁ + w₂) => N.outputWeight i * N.hiddenState x (D - 1) i)
                (fun j₁ : Fin w₁ => a * (N₁.outputWeight j₁ * N₁.hiddenState x (D - 1) j₁))
                (fun j₂ : Fin w₂ => b * (N₂.outputWeight j₂ * N₂.hiddenState x (D - 1) j₂))
                hG₁ hG₂
              simp only [FullyConnectedReLUNet.realize]
              rw [hd₁, hd₂]
              rw [hsplit]
              change (∑ j₁ : Fin w₁, a * (N₁.outputWeight j₁ * N₁.hiddenState x (D - 1) j₁)) +
                  (∑ j₂ : Fin w₂, b * (N₂.outputWeight j₂ * N₂.hiddenState x (D - 1) j₂)) + N.outputBias =
                  a * (∑ j₁ : Fin w₁, N₁.outputWeight j₁ * N₁.hiddenState x (D - 1) j₁ + N₁.outputBias) +
                  b * (∑ j₂ : Fin w₂, N₂.outputWeight j₂ * N₂.hiddenState x (D - 1) j₂ + N₂.outputBias)
              simp only [← Finset.mul_sum]
              ring
            refine ⟨N, h_Ndepth, ?_⟩
            intro x hx
            rw [h_realize x]
            calc
              |a * N₁.realize x + b * N₂.realize x - (a * f₁ x + b * f₂ x)| =
                  |a * (N₁.realize x - f₁ x) + b * (N₂.realize x - f₂ x)| := by
                congr 1
                ring
              _ ≤ |a * (N₁.realize x - f₁ x)| + |b * (N₂.realize x - f₂ x)| := by
                rw [abs_le]
                constructor
                · nlinarith [(abs_le.mp (le_rfl : |a * (N₁.realize x - f₁ x)| ≤ |a * (N₁.realize x - f₁ x)|)).1,
                    (abs_le.mp (le_rfl : |b * (N₂.realize x - f₂ x)| ≤ |b * (N₂.realize x - f₂ x)|)).1]
                · nlinarith [le_abs_self (a * (N₁.realize x - f₁ x)),
                    le_abs_self (b * (N₂.realize x - f₂ x))]
              _ = |a| * |N₁.realize x - f₁ x| + |b| * |N₂.realize x - f₂ x| := by
                rw [abs_mul, abs_mul]
              _ ≤ |a| * ε₁ + |b| * ε₂ := by
                exact add_le_add
                  (mul_le_mul_of_nonneg_left (h₁ x hx) (abs_nonneg a))
                  (mul_le_mul_of_nonneg_left (h₂ x hx) (abs_nonneg b))
          -- @step s2: Finite induction over s assembling the depth-D family Ar' into one network
          -- with N.depth ≤ D + 1 and box error ≤ ∑ r∈s |coeff r| * εr r.
          -- Depth is ≤ D + 1 (not = D): for s = ∅ we get D = 0 and no depth-0 ReLU net exists,
          -- so the empty case is handled by the depth-one zero net (1 = D+1 ≤ D+1); for s ≠ ∅
          -- the induction yields depth exactly D, which satisfies D ≤ D + 1.
          have h_fin :
              ∀ (εr : ι → ℝ) (Ar' : ι → FullyConnectedReLUNet d),
                (∀ r ∈ s, 0 ≤ εr r) →
                (∀ r ∈ s, (Ar' r).depth = D) →
                (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r) →
                ∃ N : FullyConnectedReLUNet d,
                  N.depth ≤ D + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |N.realize x -
                      finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                      ∑ r ∈ s, |coeff r| * εr r := by
            intro εr Ar' hεr_nonneg hAr'_depth hAr'_err
            -- @step nonempty_folding: for s ≠ ∅, a depth-D network via Finset induction using h_bin with a = 1, b = coeff r
            have h_nonempty_folding :
                s ≠ ∅ →
                ∃ N : FullyConnectedReLUNet d,
                  N.depth = D ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |N.realize x -
                      finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                                ∑ r ∈ s, |coeff r| * εr r := by
                      intro hne
                      -- @step s1: finite-subset induction over nonempty T ⊆ s. The ∅ base is vacuous
                      -- (∅.Nonempty = False) and the singleton fold uses h_bin with a = coeff r, b = 0,
                      -- so no depth-D zero net (CSP s2) is needed.
                      have h_subset :
                          ∀ T : Finset ι, T ⊆ s → T.Nonempty →
                          ∃ N : FullyConnectedReLUNet d,
                            N.depth = D ∧
                            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                              |N.realize x -
                                finiteLinearCombination T coeff
                                  (fun r : ι => fun y : Fin d → ℝ =>
                                    ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                                ∑ r ∈ T, |coeff r| * εr r := by
                        intro T
                        refine Finset.induction_on T ?base ?step
                        · intro hTs hTne
                          rcases hTne with ⟨x, hx⟩
                          simp at hx
                        · intro r T hnotin hrec hTs hTne
                          have hTsT : T ⊆ s := by
                            intro x hx
                            exact hTs (Finset.mem_insert_of_mem hx)
                          have hrs : r ∈ s := hTs (Finset.mem_insert_self r T)
                          by_cases hTempty : T = ∅
                          · rcases h_bin (fun x : Fin d → ℝ => ∀ q : Fin d, |x q - center q| ≤ R)
                                (Ar' r) (Ar' r)
                                (fun x : Fin d → ℝ => ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))
                                (fun x : Fin d → ℝ => ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))
                                (εr r) (εr r)
                                (hεr_nonneg r hrs) (hεr_nonneg r hrs)
                                (hAr'_depth r hrs) (hAr'_depth r hrs)
                                (hAr'_err r hrs) (hAr'_err r hrs)
                                (coeff r) 0 with ⟨N, hNd, hNerr⟩
                            refine ⟨N, hNd, ?_⟩
                            intro x hx
                            simpa [hTempty, finiteLinearCombination] using hNerr x hx
                          · have hTne' : T.Nonempty := Finset.nonempty_iff_ne_empty.mpr hTempty
                            rcases hrec hTsT hTne' with ⟨N_T, hNTd, hNTe⟩
                            rcases h_bin (fun x : Fin d → ℝ => ∀ q : Fin d, |x q - center q| ≤ R)
                                (Ar' r) N_T
                                (fun x : Fin d → ℝ => ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))
                                (fun x : Fin d → ℝ =>
                                  finiteLinearCombination T coeff
                                    (fun r : ι => fun y : Fin d → ℝ =>
                                      ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x)
                                (εr r) (∑ r ∈ T, |coeff r| * εr r)
                                (hεr_nonneg r hrs)
                                (Finset.sum_nonneg (by
                                  intro r' hr'
                                  exact mul_nonneg (abs_nonneg (coeff r')) (hεr_nonneg r' (hTsT hr'))))
                                (hAr'_depth r hrs) hNTd
                                (hAr'_err r hrs) hNTe
                                (coeff r) (1 : ℝ) with ⟨N, hNd, hNerr⟩
                            refine ⟨N, hNd, ?_⟩
                            intro x hx
                            simpa [finiteLinearCombination, Finset.sum_insert hnotin, one_mul, abs_one] using hNerr x hx
                      -- @step s3: instantiate the subset-induction claim at T = s
                      rcases h_subset s (fun x hx => hx) (Finset.nonempty_iff_ne_empty.mpr hne) with ⟨N, hNd, hNerr⟩
                      exact ⟨N, hNd, hNerr⟩
            -- @step empty_folding: for s = ∅, the depth-one zero network with depth 1 ≤ D + 1 and zero error
            have h_empty_folding :
                s = ∅ →
                ∃ N : FullyConnectedReLUNet d,
                  N.depth ≤ D + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |N.realize x -
                      finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                      ∑ r ∈ s, |coeff r| * εr r := by
                        intro hs
                        rw [hs]
                        rcases Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_fullyConnectedReLUNet_finite_linear_combination_approx
                            (P := fun x : Fin d → ℝ => ∀ q : Fin d, |x q - center q| ≤ R)
                            (∅ : Finset ι) coeff
                            (fun r : ι => fun y : Fin d → ℝ =>
                              ∏ q : Fin (degree r), (y (coord r q) - center (coord r q)))
                            εr Ar' (by simp) (by simp) (by simp) with
                          ⟨N, hNd1, _, _, hNerr⟩
                        refine ⟨N, ?_, hNerr⟩
                        rw [hNd1]
                        omega
            -- @step combine: case split on s = ∅ to obtain the h_fin existential
            have h_fin_combine :
                (s ≠ ∅ → ∃ N : FullyConnectedReLUNet d,
                    N.depth = D ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |N.realize x -
                        finiteLinearCombination s coeff
                          (fun r : ι => fun y : Fin d → ℝ =>
                            ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                        ∑ r ∈ s, |coeff r| * εr r) →
                (s = ∅ → ∃ N : FullyConnectedReLUNet d,
                    N.depth ≤ D + 1 ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |N.realize x -
                        finiteLinearCombination s coeff
                          (fun r : ι => fun y : Fin d → ℝ =>
                            ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                        ∑ r ∈ s, |coeff r| * εr r) →
                ∃ N : FullyConnectedReLUNet d,
                  N.depth ≤ D + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |N.realize x -
                      finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                      ∑ r ∈ s, |coeff r| * εr r := by
                        intro h_nonempty h_empty
                        by_cases hs : s = ∅
                        · exact h_empty hs
                        · rcases h_nonempty hs with ⟨N, hNd, hNerr⟩
                          refine ⟨N, ?_, hNerr⟩
                          omega
            exact h_fin_combine h_nonempty_folding h_empty_folding
          -- @step fin: instantiate h_fin with the given εr, Ar' and hypotheses
          intro εr Ar' hεr_nonneg hAr'_depth hAr'_err
          rcases h_fin εr Ar' hεr_nonneg hAr'_depth hAr'_err with ⟨N, hNdepth, hNerr⟩
          exact ⟨N, hNdepth, hNerr⟩
      -- @step s3: Instantiate the assembly lemma with the padded networks and budgets from h_s1,
      -- conclude 0 < N.depth, N.depth ≤ D + 1, and box error ≤ ε
      have h_s2_s3 :
          ∃ N : FullyConnectedReLUNet d,
            0 < N.depth ∧
            N.depth ≤ (∑ r ∈ s, (degree r + 1)) + 1 ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |N.realize x -
                finiteLinearCombination s coeff
                  (fun r : ι => fun y : Fin d → ℝ =>
                    ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤ ε := by
          -- @step s1: Strengthened equal-depth assembly: with εr and Ar' from h_s2_s1 (0 ≤ εr r,
          -- (Ar' r).depth = D, per-monomial box error bounds), build N with 0 < N.depth,
          -- N.depth ≤ D + 1, box error ≤ ∑ r∈s |coeff r| * εr r.
          have h_s2_s3_s1 :
              ∀ (εr : ι → ℝ) (Ar' : ι → FullyConnectedReLUNet d),
                (∀ r ∈ s, 0 ≤ εr r) →
                (∀ r ∈ s, (Ar' r).depth = D) →
                (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r) →
                ∃ N : FullyConnectedReLUNet d,
                  0 < N.depth ∧
                  N.depth ≤ D + 1 ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |N.realize x - finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                      ∑ r ∈ s, |coeff r| * εr r := by
            -- @step s1: Fix arbitrary εr : ι → ℝ and Ar' : ι → FullyConnectedReLUNet d; assume the
            -- three hypotheses (nonnegativity, equal depth D, per-monomial box error bounds), and
            -- apply the existing assembly lemma h_s2_s2 to get N with N.depth ≤ D + 1 and box
            -- error ≤ ∑ r∈s |coeff r| * εr r.
            have h_s2_s3_s1_1 :
                ∀ (εr : ι → ℝ) (Ar' : ι → FullyConnectedReLUNet d),
                  (∀ r ∈ s, 0 ≤ εr r) →
                  (∀ r ∈ s, (Ar' r).depth = D) →
                  (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r) →
                  ∃ N : FullyConnectedReLUNet d,
                    N.depth ≤ D + 1 ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |N.realize x - finiteLinearCombination s coeff
                          (fun r : ι => fun y : Fin d → ℝ =>
                            ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                        ∑ r ∈ s, |coeff r| * εr r := by
              exact h_s2_s2
            -- @step s2: Depth normalization lemma: every network M with M.depth ≤ D + 1 admits M'
            -- with 0 < M'.depth, M'.depth ≤ D + 1, and M'.realize x = M.realize x for all x
            -- (if M.depth = 0, re-present with depth 1; otherwise take M' = M).
            have h_s2_s3_s1_2 :
                ∀ M : FullyConnectedReLUNet d,
                  M.depth ≤ D + 1 →
                  ∃ M' : FullyConnectedReLUNet d,
                    0 < M'.depth ∧
                    M'.depth ≤ D + 1 ∧
                    ∀ x : Fin d → ℝ, M'.realize x = M.realize x := by
              intro M hMdepth
              by_cases hpos : 0 < M.depth
              · refine ⟨M, hpos, hMdepth, ?_⟩
                intro x
                rfl
              · have hzero : M.depth = 0 := Nat.eq_zero_of_not_pos hpos
                let M' : FullyConnectedReLUNet d :=
                  { depth := 1
                    width := M.width
                    input := M.input
                    hidden := fun i => nomatch i
                    outputWeight := M.outputWeight
                    outputBias := M.outputBias }
                refine ⟨M', ?_, ?_, ?_⟩
                · dsimp [M']
                  norm_num
                · dsimp [M']
                  omega
                · intro x
                  simp [FullyConnectedReLUNet.realize, FullyConnectedReLUNet.hiddenState, hzero, M']
            -- @step s3: Combine N from s1 with the normalization lemma from s2 to conclude the
            -- existential of h_s2_s3_s1: N with 0 < N.depth, N.depth ≤ D + 1, and the same box
            -- error bound (error transfers because realizations are equal).
            have h_s2_s3_s1_3 :
                ∀ (εr : ι → ℝ) (Ar' : ι → FullyConnectedReLUNet d),
                  (∀ r ∈ s, 0 ≤ εr r) →
                  (∀ r ∈ s, (Ar' r).depth = D) →
                  (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                    |(Ar' r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤ εr r) →
                  ∃ N : FullyConnectedReLUNet d,
                    0 < N.depth ∧
                    N.depth ≤ D + 1 ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |N.realize x - finiteLinearCombination s coeff
                          (fun r : ι => fun y : Fin d → ℝ =>
                            ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
                        ∑ r ∈ s, |coeff r| * εr r := by
              intro εr Ar' hnonneg hdepth herr
              rcases h_s2_s3_s1_1 εr Ar' hnonneg hdepth herr with ⟨N₀, hN₀depth, hN₀err⟩
              rcases h_s2_s3_s1_2 N₀ hN₀depth with ⟨M, hMpos, hMdepth, hMeq⟩
              refine ⟨M, hMpos, hMdepth, ?_⟩
              intro x hx
              calc
                |M.realize x -
                    finiteLinearCombination s coeff
                      (fun r : ι => fun y : Fin d → ℝ =>
                        ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| =
                    |N₀.realize x -
                      finiteLinearCombination s coeff
                        (fun r : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| := by
                  rw [hMeq x]
                _ ≤ ∑ r ∈ s, |coeff r| * εr r := hN₀err x hx
            exact h_s2_s3_s1_3
          -- @step s2: Destructure h_s2_s1 to get εr and Ar', instantiate h_s2_s3_s1 to obtain N
          -- with 0 < N.depth and N.depth ≤ D + 1, then chain the budget ∑ r∈s |coeff r| * εr r ≤ ε
          -- from h_s2_s1 to conclude the target existential.
          have h_s2_s3_s2 :
              ∃ N : FullyConnectedReLUNet d,
                0 < N.depth ∧
                N.depth ≤ (∑ r ∈ s, (degree r + 1)) + 1 ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |N.realize x - finiteLinearCombination s coeff
                      (fun r : ι => fun y : Fin d → ℝ =>
                        ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤ ε := by
            rcases h_s2_s1 with ⟨εr, hεr_nonneg, hεr_budget, Ar', hAr'_depth, hAr'_err⟩
            rcases h_s2_s3_s1 εr Ar' hεr_nonneg hAr'_depth hAr'_err with ⟨M, hM_pos, hM_depth, hM_err⟩
            refine ⟨M, hM_pos, ?_, ?_⟩
            · simpa [D] using hM_depth
            · intro x hx
              exact le_trans (hM_err x hx) hεr_budget
          exact h_s2_s3_s2
      exact h_s2_s3
  exact h_s2

theorem taylor_polynomial_as_finite_centered_coordinate_polynomial
    {d r : ℕ} (f : (Fin d → ℝ) → ℝ) (center x : Fin d → ℝ) :
    (∑ k ∈ Finset.range (r + 1),
        ((Nat.factorial k : ℝ)⁻¹) *
          (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)) =
      finiteLinearCombination
        (Finset.univ :
          Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a =>
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f center)
              (fun q : Fin a.1.val =>
                fun j : Fin d => if j = a.2 q then 1 else 0))
        (fun a => fun y : Fin d → ℝ =>
          ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q))) x := by
  -- @step s1: For each k : ℕ, expand each argument (x - center) in the standard basis of Fin d → ℝ
  -- and apply ContinuousMultilinearMap.map_sum to rewrite the iterated derivative term as a sum
  -- over a : Fin k → Fin d of the derivative on basis tuples times ∏ q, (x (a q) - center (a q)).
  have h_s1 : ∀ k : ℕ,
      (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center) =
        ∑ a : Fin k → Fin d,
          (∏ q : Fin k, (x (a q) - center (a q))) *
            (iteratedFDeriv ℝ k f center)
              (fun q : Fin k => fun j : Fin d => if j = a q then 1 else 0) := by
                intro k
                let e : Fin d → Fin d → ℝ := fun i j => if j = i then 1 else 0
                have h_basis : x - center = ∑ i : Fin d, (x i - center i) • e i := by
                  ext j
                  simp [e]
                calc
                  (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center) =
                      (iteratedFDeriv ℝ k f center)
                        (fun _ : Fin k => ∑ i : Fin d, (x i - center i) • e i) := by
                    rw [h_basis]
                  _ = ∑ a : Fin k → Fin d,
                        (iteratedFDeriv ℝ k f center)
                          (fun q : Fin k => (x (a q) - center (a q)) • e (a q)) := by
                    exact ContinuousMultilinearMap.map_sum (iteratedFDeriv ℝ k f center)
                      (fun i : Fin k => fun j : Fin d => (x j - center j) • e j)
                  _ = ∑ a : Fin k → Fin d,
                        (∏ q : Fin k, (x (a q) - center (a q))) •
                          (iteratedFDeriv ℝ k f center) (fun q : Fin k => e (a q)) := by
                    apply Finset.sum_congr rfl
                    intro a _
                    exact ContinuousMultilinearMap.map_smul_univ (iteratedFDeriv ℝ k f center)
                      (fun q : Fin k => x (a q) - center (a q)) (fun q : Fin k => e (a q))
                  _ = ∑ a : Fin k → Fin d,
                        (∏ q : Fin k, (x (a q) - center (a q))) *
                          (iteratedFDeriv ℝ k f center) (fun q : Fin k => e (a q)) := by
                    simp
  -- @step s2: Multiply the identity from s1 by ((Nat.factorial k : ℝ)⁻¹) and sum over k ∈ Finset.range (r + 1),
  -- so the LHS of the goal becomes a finite double sum over k in range (r+1) and a : Fin k → Fin d.
  have h_s2 :
      (∑ k ∈ Finset.range (r + 1),
          ((Nat.factorial k : ℝ)⁻¹) *
            (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)) =
        ∑ k ∈ Finset.range (r + 1),
          ∑ a : Fin k → Fin d,
            ((Nat.factorial k : ℝ)⁻¹) *
                (iteratedFDeriv ℝ k f center)
                  (fun q : Fin k => fun j : Fin d => if j = a q then 1 else 0) *
              (∏ q : Fin k, (x (a q) - center (a q))) := by
                calc
                  (∑ k ∈ Finset.range (r + 1),
                      ((Nat.factorial k : ℝ)⁻¹) *
                        (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center)) =
                      ∑ k ∈ Finset.range (r + 1),
                        ((Nat.factorial k : ℝ)⁻¹) *
                          ∑ a : Fin k → Fin d,
                            (∏ q : Fin k, (x (a q) - center (a q))) *
                              (iteratedFDeriv ℝ k f center)
                                (fun q : Fin k => fun j : Fin d => if j = a q then 1 else 0) := by
                    apply Finset.sum_congr rfl
                    intro k _
                    rw [h_s1 k]
                  _ = ∑ k ∈ Finset.range (r + 1),
                        ∑ a : Fin k → Fin d,
                          ((Nat.factorial k : ℝ)⁻¹) *
                              (iteratedFDeriv ℝ k f center)
                                (fun q : Fin k => fun j : Fin d => if j = a q then 1 else 0) *
                            (∏ q : Fin k, (x (a q) - center (a q))) := by
                    apply Finset.sum_congr rfl
                    intro k _
                    rw [Finset.mul_sum]
                    apply Finset.sum_congr rfl
                    intro a _
                    ring
  -- @step s3: Reindex this double sum by the sigma type Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
  -- and unfold finiteLinearCombination; the expression then matches the RHS of the goal exactly.
  have h_s3 :
      (∑ k ∈ Finset.range (r + 1),
          ∑ a : Fin k → Fin d,
            ((Nat.factorial k : ℝ)⁻¹) *
                (iteratedFDeriv ℝ k f center)
                  (fun q : Fin k => fun j : Fin d => if j = a q then 1 else 0) *
              (∏ q : Fin k, (x (a q) - center (a q)))) =
        finiteLinearCombination
          (Finset.univ :
            Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a =>
            ((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f center)
                (fun q : Fin a.1.val =>
                  fun j : Fin d => if j = a.2 q then 1 else 0))
          (fun a => fun y : Fin d → ℝ =>
                  ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q))) x := by
            unfold finiteLinearCombination
            rw [← Finset.univ_sigma_univ]
            rw [Finset.sum_sigma]
            rw [Finset.sum_fin_eq_sum_range]
            apply Finset.sum_congr rfl
            intro k hk
            rw [dif_pos (Finset.mem_range.mp hk)]

  exact h_s2.trans h_s3

theorem exists_fullyConnectedReLUNet_taylor_polynomial_approx_on_centered_box
    {d r : ℕ} (hd : 0 < d) {R ε : ℝ} (hR : 0 < R) (hε : 0 < ε)
    (f : (Fin d → ℝ) → ℝ) (center : Fin d → ℝ) :
    ∃ N : Statlib.Nonparametric.Vocabulary.FullyConnectedReLUNet d,
      0 < N.depth ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
        |N.realize x -
            (∑ k ∈ Finset.range (r + 1),
              ((Nat.factorial k : ℝ)⁻¹) *
                (iteratedFDeriv ℝ k f center) (fun _ : Fin k => x - center))| ≤ ε := by
  let ι : Type := Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)
  let coeff : ι → ℝ := fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) * (iteratedFDeriv ℝ a.1.val f center) (fun q : Fin a.1.val => fun j : Fin d => if j = a.2 q then 1 else 0)
  let degree : ι → ℕ := fun a => a.1.val
  let coord : (a : ι) → Fin (degree a) → Fin d := fun a => a.2
  have hinst := exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_approx_on_box (ι := ι) hd (R := R) hR (ε := ε) hε center (s := (Finset.univ : Finset ι)) coeff degree coord
  rcases hinst with ⟨N, hdepth, happrox⟩
  refine ⟨N, hdepth, ?_⟩
  intro x hx
  rw [taylor_polynomial_as_finite_centered_coordinate_polynomial f center x]
  exact happrox x hx

theorem holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
    {d r : ℕ} {beta C B rho : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center : Fin d → ℝ) :
    ∀ x : Fin d → ℝ, ‖x - center‖ ≤ rho →
      |f x -
        finiteLinearCombination
          (Finset.univ :
            Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a =>
            ((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f center)
                (fun q : Fin a.1.val =>
                  fun j : Fin d => if j = a.2 q then 1 else 0))
          (fun a => fun y : Fin d → ℝ =>
            ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q))) x| ≤
        C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
  intro x hx
  have hbound :=
    holderSmoothBall_taylor_remainder_bound_on_box hbeta_nonneg hC hrho f hf center x hx
  rw [taylor_polynomial_as_finite_centered_coordinate_polynomial] at hbound
  exact hbound

set_option maxHeartbeats 800000 in
theorem exists_fullyConnectedReLUNet_finite_centered_monomial_polynomial_uniform_resolution_size_bound
    {ι : Type*} [DecidableEq ι] {d n : ℕ}
    (hd : 0 < d) (hn : 0 < n) {R : ℝ} (hR : 0 < R)
    (center : Fin d → ℝ)
    (s : Finset ι) (coeff : ι → ℝ)
    (degree : ι → ℕ) (coord : (r : ι) → Fin (degree r) → Fin d) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ finiteCenteredMonomialPolynomialDepthBound s degree ∧
      N.width ≤ finiteCenteredMonomialPolynomialWidthBound n s degree ∧
      N.parameterCount ≤
        finiteCenteredMonomialPolynomialParameterBound d n s degree ∧
      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
        |N.realize x -
            finiteLinearCombination s coeff
              (fun r : ι => fun y : Fin d → ℝ =>
                ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
          finiteCenteredMonomialPolynomialApproxError R n s coeff degree := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1: Establish the strengthened per-monomial recursive claim: for every m : ℕ and every coordinate map c : Fin m → Fin d, there exists a network A with 0 < A.depth, A.depth ≤ m + 1, A.width ≤ centeredMonomialWidthBound n m, and error ≤ centeredMonomialApproxError R n m on the centered box.
  have h_s1 :
      ∀ (m : ℕ) (c : Fin m → Fin d),
        ∃ A : FullyConnectedReLUNet d,
          0 < A.depth ∧
          A.depth ≤ m + 1 ∧
          A.width ≤ centeredMonomialWidthBound n m ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |A.realize x - ∏ q : Fin m, (x (c q) - center (c q))| ≤
              centeredMonomialApproxError R n m := by
      -- @step s1: Establish the base cases m = 0 and m = 1: for every coordinate map c, there is an
      -- exact network realizing the constant 1 (depth 1, width 1, zero error) and the single centered
      -- coordinate difference via relu t - relu (-t) (depth 1, width 2, zero error) on the centered box.
      have h_base :
          (∀ c : Fin 0 → Fin d,
            ∃ A : FullyConnectedReLUNet d,
              0 < A.depth ∧ A.depth ≤ 0 + 1 ∧
              A.width ≤ centeredMonomialWidthBound n 0 ∧
              ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                |A.realize x - ∏ q : Fin 0, (x (c q) - center (c q))| ≤
                  centeredMonomialApproxError R n 0) ∧
            (∀ c : Fin 1 → Fin d,
              ∃ A : FullyConnectedReLUNet d,
                0 < A.depth ∧ A.depth ≤ 1 + 1 ∧
                A.width ≤ centeredMonomialWidthBound n 1 ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin 1, (x (c q) - center (c q))| ≤
                    centeredMonomialApproxError R n 1) := by
            -- @step s1: Prove the degree-0 clause: for every c : Fin 0 → Fin d, there is a network A₀
            -- with 0 < A₀.depth, A₀.depth ≤ 1, A₀.width ≤ centeredMonomialWidthBound n 0, and
            -- |A₀.realize x - 1| ≤ centeredMonomialApproxError R n 0 on the centered box (depth-one,
            -- width-one constant-1 network; centeredMonomialWidthBound n 0 = 1,
            -- centeredMonomialApproxError R n 0 = 0).
            have h_base0 :
                ∀ c : Fin 0 → Fin d,
                  ∃ A : FullyConnectedReLUNet d,
                    0 < A.depth ∧ A.depth ≤ 0 + 1 ∧
                    A.width ≤ centeredMonomialWidthBound n 0 ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |A.realize x - ∏ q : Fin 0, (x (c q) - center (c q))| ≤
                        centeredMonomialApproxError R n 0 := by
              intro c
              refine ⟨OneHiddenReLUNet.toFullyConnected
                  { hidden := { weight := 0, bias := fun _ : Fin 1 => 0 },
                    outputWeight := fun _ : Fin 1 => 0, outputBias := 1 }, ?_, ?_, ?_, ?_⟩
              · norm_num [OneHiddenReLUNet.toFullyConnected]
              · norm_num [OneHiddenReLUNet.toFullyConnected]
              · norm_num [OneHiddenReLUNet.toFullyConnected, centeredMonomialWidthBound]
              · intro x hx
                simp [OneHiddenReLUNet.toFullyConnected, FullyConnectedReLUNet.realize,
                  FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply,
                  reluVec, relu, centeredMonomialApproxError, Fin.prod_univ_zero, Fin.sum_univ_one]
            -- @step s2: Prove the degree-1 clause: for every c : Fin 1 → Fin d, there is a network A₁
            -- with 0 < A₁.depth, A₁.depth ≤ 2, A₁.width ≤ centeredMonomialWidthBound n 1, and
            -- |A₁.realize x - (x (c 0) - center (c 0))| ≤ centeredMonomialApproxError R n 1 on the
            -- centered box (relu t - relu (-t) via exists_fullyConnectedReLUNet_linear_combination_two,
            -- width 2; centeredMonomialWidthBound n 1 = 2, centeredMonomialApproxError R n 1 = 0).
            have h_base1 :
                ∀ c : Fin 1 → Fin d,
                  ∃ A : FullyConnectedReLUNet d,
                    0 < A.depth ∧ A.depth ≤ 1 + 1 ∧
                    A.width ≤ centeredMonomialWidthBound n 1 ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |A.realize x - ∏ q : Fin 1, (x (c q) - center (c q))| ≤
                        centeredMonomialApproxError R n 1 := by
              intro c
              let Npos : FullyConnectedReLUNet d :=
                (OneHiddenReLUNet.mk
                  { weight := fun (_ : Fin 1) (j : Fin d) => if j = c 0 then 1 else 0,
                    bias := fun _ : Fin 1 => -center (c 0) }
                  (fun _ : Fin 1 => 1) 0).toFullyConnected
              let Nneg : FullyConnectedReLUNet d :=
                (OneHiddenReLUNet.mk
                  { weight := fun (_ : Fin 1) (j : Fin d) => if j = c 0 then -1 else 0,
                    bias := fun _ : Fin 1 => center (c 0) }
                  (fun _ : Fin 1 => 1) 0).toFullyConnected
              have hNposd : Npos.depth = 1 := rfl
              have hNnegd : Nneg.depth = 1 := rfl
              obtain ⟨A₁, hA₁depth, hA₁width, _hA₁param, hA₁realize⟩ :=
                Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_fullyConnectedReLUNet_linear_combination_two
                  Npos Nneg hNposd hNnegd 1 (-1)
              refine ⟨A₁, ?_, ?_, ?_, ?_⟩
              · rw [hA₁depth]
                norm_num
              · rw [hA₁depth]
                norm_num
              · rw [hA₁width]
                norm_num [Npos, Nneg, OneHiddenReLUNet.toFullyConnected, centeredMonomialWidthBound]
              · intro x _hx
                rw [hA₁realize x, Fin.prod_univ_one]
                set s : ℝ := x (c 0) - center (c 0)
                have hNposrealize : Npos.realize x = relu s := by
                  simp [Npos, s, OneHiddenReLUNet.toFullyConnected, FullyConnectedReLUNet.realize,
                    FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply,
                    reluVec, relu, Fin.sum_univ_one] <;> try congr 1 <;> ring
                have hNnegrealize : Nneg.realize x = relu (-s) := by
                  simp [Nneg, s, OneHiddenReLUNet.toFullyConnected, FullyConnectedReLUNet.realize,
                    FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply,
                    reluVec, relu, Fin.sum_univ_one] <;> try congr 1 <;> ring
                rw [hNposrealize, hNnegrealize]
                have h_relu_id : ∀ u : ℝ, relu u - relu (-u) = u := by
                  intro u
                  unfold relu
                  by_cases h : 0 ≤ u
                  · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h)]
                    ring
                  · have hu : u ≤ 0 := le_of_not_ge h
                    rw [max_eq_right hu, max_eq_left (neg_nonneg.mpr hu)]
                    ring
                have hz : 1 * relu s + (-1) * relu (-s) - s = 0 := by
                  have := h_relu_id s
                  nlinarith
                rw [hz]
                norm_num [centeredMonomialApproxError]
            exact ⟨h_base0, h_base1⟩
      -- @step s2: Establish the induction step from degree m+1 to m+2: given the per-monomial network
      -- for the prefix monomial of degree m+1 and the exact depth-one coordinate-factor network, combine
      -- their outputs through the multiplication approximator exists_fullyConnectedReLUNet_mul_approx_on_box
      -- with box radius B = R^(m+1) + centeredMonomialApproxError R n (m+1) + R + 1, then verify the
      -- resulting depth bound m+3, the recursive width bound centeredMonomialWidthBound n (m+2), and the
      -- recursive error bound centeredMonomialApproxError R n (m+2).
      have h_step :
          ∀ (m : ℕ),
            (∀ c : Fin (m + 1) → Fin d,
              ∃ A : FullyConnectedReLUNet d,
                0 < A.depth ∧ A.depth ≤ (m + 1) + 1 ∧
                A.width ≤ centeredMonomialWidthBound n (m + 1) ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin (m + 1), (x (c q) - center (c q))| ≤
                    centeredMonomialApproxError R n (m + 1)) →
            ∀ c : Fin (m + 2) → Fin d,
              ∃ A : FullyConnectedReLUNet d,
                0 < A.depth ∧ A.depth ≤ (m + 2) + 1 ∧
                A.width ≤ centeredMonomialWidthBound n (m + 2) ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |A.realize x - ∏ q : Fin (m + 2), (x (c q) - center (c q))| ≤
                    centeredMonomialApproxError R n (m + 2) := by
            intro m ih c
            -- (1) Split the degree-(m+2) monomial into the degree-(m+1) prefix and the last factor.
            let j : Fin (m + 2) := Fin.last (m + 1)
            let c' : Fin (m + 1) → Fin d := fun q => c (Fin.castSucc q)
            let f : (Fin d → ℝ) → ℝ := fun x => ∏ q : Fin (m + 1), (x (c' q) - center (c' q))
            let g : (Fin d → ℝ) → ℝ := fun x => x (c j) - center (c j)
            have h_split : ∀ x : Fin d → ℝ,
                ∏ q : Fin (m + 2), (x (c q) - center (c q)) = f x * g x := by
              intro x
              dsimp [f, g, c', j]
              exact Fin.prod_univ_castSucc (fun q : Fin (m + 2) => x (c q) - center (c q))
            -- (2) Prefix network from the induction hypothesis; exact factor network from the base case.
            rcases ih c' with ⟨A_prefix, hAp_pos, hAp_depth, hAp_width, hAp_err⟩
            rcases (h_base.2 (fun _ : Fin 1 => c j)) with
              ⟨A_factor, hAf_pos, hAf_depth, hAf_width, hAf_err⟩
            -- (3) Bound the exact prefix monomial by R^(m+1) on the centered box.
            have hf_le : ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center q| ≤ R) → |f x| ≤ R ^ (m + 1) := by
              intro x hx
              calc
                |f x| = ∏ q : Fin (m + 1), |x (c' q) - center (c' q)| := by
                  dsimp [f]
                  rw [Finset.abs_prod]
                _ ≤ ∏ _ : Fin (m + 1), R := by
                  exact Finset.prod_le_prod
                    (fun q _ => abs_nonneg (x (c' q) - center (c' q)))
                    (fun q _ => hx (c' q))
                _ = R ^ (m + 1) := by simp
            -- (4) Nonnegativity of the recursive approximation error at every degree (needed for B > 0).
            have hErr_nonneg : ∀ k : ℕ, 0 ≤ centeredMonomialApproxError R n (k + 1) := by
              intro k
              induction k with
              | zero =>
                  simp [centeredMonomialApproxError]
              | succ k ih =>
                  let Bk : ℝ := R ^ (k + 1) + centeredMonomialApproxError R n (k + 1) + R + 1
                  have hBk_pos : 0 < Bk := by
                    dsimp [Bk]
                    positivity
                  have hsq : 0 ≤ 2 * Bk ^ 2 / (n : ℝ) ^ 2 := by
                    exact div_nonneg (mul_nonneg (by norm_num) (sq_nonneg Bk))
                      (le_of_lt (sq_pos_of_pos (by exact_mod_cast hn)))
                  have hmul : 0 ≤ Bk * centeredMonomialApproxError R n (k + 1) := by
                    exact mul_nonneg (le_of_lt hBk_pos) ih
                  change 0 ≤ 2 * Bk ^ 2 / (n : ℝ) ^ 2 + Bk * centeredMonomialApproxError R n (k + 1)
                  linarith
            have hη_nonneg : 0 ≤ centeredMonomialApproxError R n (m + 1) := by
              exact hErr_nonneg m
            -- (5) Multiplication radius B and the component bounds on the centered box.
            let B : ℝ := R ^ (m + 1) + centeredMonomialApproxError R n (m + 1) + R + 1
            have hB_pos : 0 < B := by
              dsimp [B]
              positivity
            have hR_le_B : R ≤ B := by
              dsimp [B]
              have htmp : 0 ≤ R ^ (m + 1) + centeredMonomialApproxError R n (m + 1) + 1 := by
                positivity
              linarith
            have hAp_bnd : ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center q| ≤ R) → |A_prefix.realize x| ≤ B := by
              intro x hx
              have htri : |A_prefix.realize x| ≤ |A_prefix.realize x - f x| + |f x| := by
                rw [abs_le]
                constructor
                · linarith [neg_abs_le (A_prefix.realize x - f x), neg_abs_le (f x)]
                · linarith [le_abs_self (A_prefix.realize x - f x), le_abs_self (f x)]
              calc
                |A_prefix.realize x| ≤ |A_prefix.realize x - f x| + |f x| := htri
                _ ≤ centeredMonomialApproxError R n (m + 1) + R ^ (m + 1) := by
                  linarith [hAp_err x hx, hf_le x hx]
                _ ≤ B := by
                  dsimp [B]
                  linarith
            have hAf_eq : ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center q| ≤ R) → A_factor.realize x = g x := by
              intro x hx
              have hz : centeredMonomialApproxError R n 1 = 0 := by simp [centeredMonomialApproxError]
              have hzero : |A_factor.realize x - g x| ≤ 0 := by
                simpa [hz] using hAf_err x hx
              have hle : A_factor.realize x - g x ≤ 0 := (abs_le.mp hzero).2
              have hge : 0 ≤ A_factor.realize x - g x := by
                have hneg : -0 ≤ A_factor.realize x - g x := (abs_le.mp hzero).1
                linarith
              linarith
            have hAf_bnd : ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center q| ≤ R) → |A_factor.realize x| ≤ B := by
              intro x hx
              calc
                |A_factor.realize x| = |g x| := by rw [hAf_eq x hx]
                _ ≤ R := by
                  dsimp [g, j]
                  exact hx (c j)
                _ ≤ B := hR_le_B
            -- (6) Multiplication approximator with radius B (depth-one network of width 2n).
            rcases (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_fullyConnectedReLUNet_mul_approx_on_box
                (n := n) (R := B) hn hB_pos) with
              ⟨N_mul, hNm_depth, hNm_width, hNm_param, hNm_err⟩
            -- (7) Recursion facts for the final depth/width/error bounds of the composed network.
            have hw_rec : centeredMonomialWidthBound n (m + 2) =
                centeredMonomialWidthBound n (m + 1) + 2 + 2 * n := by
              rfl
            have he_rec : centeredMonomialApproxError R n (m + 2) =
                2 * (R ^ (m + 1) + centeredMonomialApproxError R n (m + 1) + R + 1) ^ 2 / (n : ℝ) ^ 2 +
                  (R ^ (m + 1) + centeredMonomialApproxError R n (m + 1) + R + 1) *
                    centeredMonomialApproxError R n (m + 1) := by
              rfl
            -- (8) Assemble the composite network A: A_prefix and A_factor in parallel (blocks of widths
            -- Wp and Wf), padded with identity layers to the common depth m+2, then composed with the
            -- depth-one multiplication network N_mul (width Wm = 2n) at the last hidden layer.
            let Wp : ℕ := A_prefix.width
            let Wf : ℕ := A_factor.width
            let Wm : ℕ := 2 * n
            let W : ℕ := Wp + Wf + Wm
            -- input layer: block-diagonal of A_prefix.input, A_factor.input, and the zero block.
            let inputLayer : DenseLayer d W :=
              { weight := fun j q =>
                  if hjp : j.val < Wp then A_prefix.input.weight ⟨j.val, hjp⟩ q
                  else if hjf : j.val < Wp + Wf then
                    A_factor.input.weight ⟨j.val - Wp, by omega⟩ q
                  else 0
                bias := fun j =>
                  if hjp : j.val < Wp then A_prefix.input.bias ⟨j.val, hjp⟩
                  else if hjf : j.val < Wp + Wf then
                    A_factor.input.bias ⟨j.val - Wp, by omega⟩
                  else 0 }
            -- hidden layers 0..m: parallel block-diagonal evolution of A_prefix and A_factor (identity
            -- padding once a component has exhausted its own depth); the last hidden layer (index m+1)
            -- computes the N_mul input block from the two component outputs.
            let parallelLayer : Fin (m + 2) → DenseLayer W W := fun i =>
              { weight := fun j k =>
                  if hjp : j.val < Wp then
                    if hkp : k.val < Wp then
                      (if hik : i.val < A_prefix.depth - 1 then
                        (A_prefix.hidden ⟨i.val, hik⟩).weight ⟨j.val, hjp⟩ ⟨k.val, hkp⟩
                      else if j = k then (1 : ℝ) else 0)
                    else 0
                  else if hjf : j.val < Wp + Wf then
                    if hkf : Wp ≤ k.val ∧ k.val < Wp + Wf then
                      (if hik : i.val < A_factor.depth - 1 then
                        (A_factor.hidden ⟨i.val, hik⟩).weight ⟨j.val - Wp, by omega⟩ ⟨k.val - Wp, by omega⟩
                      else if j = k then (1 : ℝ) else 0)
                    else 0
                  else if j = k then (1 : ℝ) else 0
                bias := fun j =>
                  if hjp : j.val < Wp then
                    (if hik : i.val < A_prefix.depth - 1 then
                      (A_prefix.hidden ⟨i.val, hik⟩).bias ⟨j.val, hjp⟩ else 0)
                  else if hjf : j.val < Wp + Wf then
                    (if hik : i.val < A_factor.depth - 1 then
                      (A_factor.hidden ⟨i.val, hik⟩).bias ⟨j.val - Wp, by omega⟩ else 0)
                  else 0 }
            let mulLayer : DenseLayer W W :=
              { weight := fun j k =>
                  if hjm : Wp + Wf ≤ j.val then
                    if hkp : k.val < Wp then
                      N_mul.input.weight ⟨j.val - (Wp + Wf), by omega⟩ 0 * A_prefix.outputWeight ⟨k.val, hkp⟩
                    else if hkf : k.val < Wp + Wf then
                      N_mul.input.weight ⟨j.val - (Wp + Wf), by omega⟩ 1 * A_factor.outputWeight ⟨k.val - Wp, by omega⟩
                    else 0
                  else if j = k then (1 : ℝ) else 0
                bias := fun j =>
                  if hjm : Wp + Wf ≤ j.val then
                    N_mul.input.bias ⟨j.val - (Wp + Wf), by omega⟩ +
                      N_mul.input.weight ⟨j.val - (Wp + Wf), by omega⟩ 0 * A_prefix.outputBias +
                      N_mul.input.weight ⟨j.val - (Wp + Wf), by omega⟩ 1 * A_factor.outputBias
                  else 0 }
            let A : FullyConnectedReLUNet d :=
              { depth := (m + 2) + 1
                width := W
                input := inputLayer
                hidden := fun i : Fin (m + 2) =>
                  if hi : i.val < m + 1 then parallelLayer i else mulLayer
                outputWeight := fun j =>
                  if hjm : Wp + Wf ≤ j.val then
                    N_mul.outputWeight ⟨j.val - (Wp + Wf), by omega⟩
                  else 0
                outputBias := N_mul.outputBias }
            refine ⟨A, ?hpos, ?hdepth, ?hwidth, ?herr⟩
            · dsimp [A]
              omega
            · dsimp [A]
              omega
            · change A_prefix.width + A_factor.width + 2 * n ≤ centeredMonomialWidthBound n (m + 2)
              rw [hw_rec]
              have hAf_width_le : A_factor.width ≤ 2 := by
                simpa [centeredMonomialWidthBound] using hAf_width
              omega
            · -- Error bound: prove A.realize x = N_mul.realize (A_prefix.realize x, A_factor.realize x) on
              -- the centered box (block-diagonal hidden-state tracking, identity padding for exhausted
              -- components, last-layer mul block), then apply hNm_err with |u| ≤ B, |v| ≤ B and combine
              -- with hAp_err to reach the exact recursive form he_rec.
              intro x hx
              -- Injection maps for the three blocks of the composite width W.
              let incP : Fin Wp → Fin W := fun j => ⟨j.val, by dsimp [W, Wp, Wf, Wm]; omega⟩
              let incF : Fin Wf → Fin W := fun j => ⟨Wp + j.val, by dsimp [W, Wp, Wf, Wm]; omega⟩
              let incM : Fin N_mul.width → Fin W := fun i => ⟨Wp + Wf + i.val, by dsimp [W, Wp, Wf, Wm]; omega⟩
              -- relu is idempotent (identity-padded layers re-apply relu on stabilized states).
              have hReluIdem : ∀ z : ℝ, relu (relu z) = relu z := by
                intro z
                dsimp [relu]
                exact (max_assoc z 0 0).trans (by simp)
              -- Sum reindexing: sums over Fin W restricted to the prefix block equal sums over Fin Wp.
              have hsumP : ∀ (w : Fin Wp → ℝ) (s : Fin W → ℝ),
                  (∑ k : Fin W, if hk : k.val < Wp then w ⟨k.val, hk⟩ * s k else 0) =
                    ∑ k : Fin Wp, w k * s (incP k) := by
                intro w s
                let p : Fin W → Prop := fun k => k.val < Wp
                let g : Fin W → ℝ := fun k => if hk : k.val < Wp then w ⟨k.val, hk⟩ * s k else 0
                let e : {k : Fin W // p k} ≃ Fin Wp :=
                  { toFun := fun k => ⟨k.val.val, k.property⟩
                    invFun := fun j => ⟨incP j, j.isLt⟩
                    left_inv := by intro k; apply Subtype.ext; apply Fin.ext; rfl
                    right_inv := by intro j; apply Fin.ext; rfl }
                have hmem : ∀ x : Fin W, x ∈ Finset.univ.filter p ↔ p x := by
                  intro x
                  simp [Finset.mem_filter]
                have hstep1 : (∑ k : Fin W, if hk : k.val < Wp then w ⟨k.val, hk⟩ * s k else 0) =
                    (∑ k : Fin W, if p k then g k else 0) := by
                  apply Finset.sum_congr rfl
                  intro k hk
                  by_cases h : p k
                  · simp [g, h, p]
                  · simp [g, h, p]
                rw [hstep1]
                rw [← Finset.sum_filter p g]
                rw [Finset.sum_subtype (Finset.univ.filter p) hmem g]
                rw [← e.sum_comp]
                apply Finset.sum_congr rfl
                intro k hk
                have hklt : k.val.val < Wp := by simpa [p] using k.property
                simp [g, e, p, incP, hklt]
              -- Sum reindexing for the factor block.
              have hsumF : ∀ (w : Fin Wf → ℝ) (s : Fin W → ℝ),
                  (∑ k : Fin W, if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then w ⟨k.val - Wp, by omega⟩ * s k else 0) =
                    ∑ k : Fin Wf, w k * s (incF k) := by
                intro w s
                let p : Fin W → Prop := fun k => Wp ≤ k.val ∧ k.val < Wp + Wf
                let g : Fin W → ℝ := fun k => if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then w ⟨k.val - Wp, by omega⟩ * s k else 0
                let e : {k : Fin W // p k} ≃ Fin Wf :=
                  { toFun := fun k => ⟨k.val.val - Wp, by omega⟩
                    invFun := fun j => ⟨incF j, by
                      change Wp ≤ Wp + j.val ∧ Wp + j.val < Wp + Wf
                      constructor
                      · omega
                      · omega⟩
                    left_inv := by
                      intro k
                      apply Subtype.ext
                      apply Fin.ext
                      change Wp + (k.val.val - Wp) = k.val.val
                      omega
                    right_inv := by
                      intro j
                      apply Fin.ext
                      change (Wp + j.val) - Wp = j.val
                      omega }
                have hmem : ∀ x : Fin W, x ∈ Finset.univ.filter p ↔ p x := by
                  intro x
                  simp [Finset.mem_filter]
                have hstep1 : (∑ k : Fin W, if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then w ⟨k.val - Wp, by omega⟩ * s k else 0) =
                    (∑ k : Fin W, if p k then g k else 0) := by
                  apply Finset.sum_congr rfl
                  intro k hk
                  by_cases h : p k
                  · simp [g, h, p]
                  · simp [g, h, p]
                rw [hstep1]
                rw [← Finset.sum_filter p g]
                rw [Finset.sum_subtype (Finset.univ.filter p) hmem g]
                rw [← e.sum_comp]
                apply Finset.sum_congr rfl
                intro k hk
                have hklt : Wp ≤ k.val.val ∧ k.val.val < Wp + Wf := by simpa [p] using k.property
                have hsub : Wp + (k.val.val - Wp) = k.val.val := by omega
                simp [g, e, p, incF, hklt, hsub]
              -- Sum reindexing for the mul block.
              have hsumM : ∀ (w : Fin N_mul.width → ℝ) (s : Fin W → ℝ),
                  (∑ k : Fin W, if hk : Wp + Wf ≤ k.val then w ⟨k.val - (Wp + Wf), by dsimp [W, Wm]; omega⟩ * s k else 0) =
                    ∑ k : Fin N_mul.width, w k * s (incM k) := by
                intro w s
                let p : Fin W → Prop := fun k => Wp + Wf ≤ k.val
                let g : Fin W → ℝ := fun k => if hk : Wp + Wf ≤ k.val then w ⟨k.val - (Wp + Wf), by dsimp [W, Wm]; omega⟩ * s k else 0
                let e : {k : Fin W // p k} ≃ Fin N_mul.width :=
                  { toFun := fun k => ⟨k.val.val - (Wp + Wf), by dsimp [W, Wm]; omega⟩
                    invFun := fun j => ⟨incM j, by
                      change Wp + Wf ≤ Wp + Wf + j.val
                      omega⟩
                    left_inv := by
                      intro k
                      apply Subtype.ext
                      apply Fin.ext
                      change Wp + Wf + (k.val.val - (Wp + Wf)) = k.val.val
                      omega
                    right_inv := by
                      intro j
                      apply Fin.ext
                      change (Wp + Wf + j.val) - (Wp + Wf) = j.val
                      omega }
                have hmem : ∀ x : Fin W, x ∈ Finset.univ.filter p ↔ p x := by
                  intro x
                  simp [Finset.mem_filter]
                have hstep1 : (∑ k : Fin W, if hk : Wp + Wf ≤ k.val then w ⟨k.val - (Wp + Wf), by dsimp [W, Wm]; omega⟩ * s k else 0) =
                    (∑ k : Fin W, if p k then g k else 0) := by
                  apply Finset.sum_congr rfl
                  intro k hk
                  by_cases h : p k
                  · simp [g, h, p]
                  · simp [g, h, p]
                rw [hstep1]
                rw [← Finset.sum_filter p g]
                rw [Finset.sum_subtype (Finset.univ.filter p) hmem g]
                rw [← e.sum_comp]
                apply Finset.sum_congr rfl
                intro k hk
                have hklt : Wp + Wf ≤ k.val.val := by simpa [p] using k.property
                have hsub : Wp + Wf + (k.val.val - (Wp + Wf)) = k.val.val := by omega
                simp [g, e, p, incM, hklt, hsub]
              -- Frozen-state lemmas: once a component has run past its own depth-1, its hidden state
              -- no longer changes.
              have hFrozenP' : ∀ (u : ℕ),
                  A_prefix.hiddenState x (A_prefix.depth - 1 + u) = A_prefix.hiddenState x (A_prefix.depth - 1) := by
                intro u
                induction u with
                | zero => rfl
                | succ u ih =>
                    have hnot : ¬ (A_prefix.depth - 1 + u) < A_prefix.depth - 1 := by omega
                    have hstep : A_prefix.hiddenState x (A_prefix.depth - 1 + u + 1) = A_prefix.hiddenState x (A_prefix.depth - 1 + u) := by
                      change (if ht : (A_prefix.depth - 1 + u) < A_prefix.depth - 1 then (A_prefix.hidden ⟨A_prefix.depth - 1 + u, ht⟩).reluApply (A_prefix.hiddenState x (A_prefix.depth - 1 + u)) else A_prefix.hiddenState x (A_prefix.depth - 1 + u)) = A_prefix.hiddenState x (A_prefix.depth - 1 + u)
                      simp [hnot]
                    have hassoc : A_prefix.depth - 1 + (u + 1) = (A_prefix.depth - 1 + u) + 1 := by omega
                    rw [hassoc, hstep]
                    exact ih
              have hFrozenP : ∀ t : ℕ, A_prefix.depth - 1 ≤ t →
                  A_prefix.hiddenState x t = A_prefix.hiddenState x (A_prefix.depth - 1) := by
                intro t ht
                have hsplit : A_prefix.depth - 1 + (t - (A_prefix.depth - 1)) = t := by omega
                rw [← hsplit]
                exact hFrozenP' (t - (A_prefix.depth - 1))
              have hFrozenF' : ∀ (u : ℕ),
                  A_factor.hiddenState x (A_factor.depth - 1 + u) = A_factor.hiddenState x (A_factor.depth - 1) := by
                intro u
                induction u with
                | zero => rfl
                | succ u ih =>
                    have hnot : ¬ (A_factor.depth - 1 + u) < A_factor.depth - 1 := by omega
                    have hstep : A_factor.hiddenState x (A_factor.depth - 1 + u + 1) = A_factor.hiddenState x (A_factor.depth - 1 + u) := by
                      change (if ht : (A_factor.depth - 1 + u) < A_factor.depth - 1 then (A_factor.hidden ⟨A_factor.depth - 1 + u, ht⟩).reluApply (A_factor.hiddenState x (A_factor.depth - 1 + u)) else A_factor.hiddenState x (A_factor.depth - 1 + u)) = A_factor.hiddenState x (A_factor.depth - 1 + u)
                      simp [hnot]
                    have hassoc : A_factor.depth - 1 + (u + 1) = (A_factor.depth - 1 + u) + 1 := by omega
                    rw [hassoc, hstep]
                    exact ih
              have hFrozenF : ∀ t : ℕ, A_factor.depth - 1 ≤ t →
                  A_factor.hiddenState x t = A_factor.hiddenState x (A_factor.depth - 1) := by
                intro t ht
                have hsplit : A_factor.depth - 1 + (t - (A_factor.depth - 1)) = t := by omega
                rw [← hsplit]
                exact hFrozenF' (t - (A_factor.depth - 1))
              -- The stabilized state is a relu output, hence a relu fixed point.
              have hReluStableP : ∀ t : ℕ, A_prefix.depth - 1 ≤ t → ∀ j : Fin Wp,
                  relu (A_prefix.hiddenState x t j) = A_prefix.hiddenState x t j := by
                intro t ht j
                rw [hFrozenP t ht]
                by_cases hz : A_prefix.depth - 1 = 0
                · rw [hz]
                  dsimp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply]
                  exact hReluIdem (A_prefix.input.apply x j)
                · rcases Nat.exists_eq_succ_of_ne_zero hz with ⟨t0, ht0⟩
                  rw [ht0]
                  have hlt : t0 < A_prefix.depth - 1 := by rw [ht0]; omega
                  have hvec : A_prefix.hiddenState x (t0 + 1) = (A_prefix.hidden ⟨t0, hlt⟩).reluApply (A_prefix.hiddenState x t0) := by
                    change (if ht : t0 < A_prefix.depth - 1 then (A_prefix.hidden ⟨t0, ht⟩).reluApply (A_prefix.hiddenState x t0) else A_prefix.hiddenState x t0) = (A_prefix.hidden ⟨t0, hlt⟩).reluApply (A_prefix.hiddenState x t0)
                    simp [hlt]
                  have hstep : A_prefix.hiddenState x (t0 + 1) j = (A_prefix.hidden ⟨t0, hlt⟩).reluApply (A_prefix.hiddenState x t0) j := congrFun hvec j
                  rw [hstep]
                  dsimp [DenseLayer.reluApply, reluVec]
                  exact hReluIdem ((A_prefix.hidden ⟨t0, hlt⟩).apply (A_prefix.hiddenState x t0) j)
              have hReluStableF : ∀ t : ℕ, A_factor.depth - 1 ≤ t → ∀ j : Fin Wf,
                  relu (A_factor.hiddenState x t j) = A_factor.hiddenState x t j := by
                intro t ht j
                rw [hFrozenF t ht]
                by_cases hz : A_factor.depth - 1 = 0
                · rw [hz]
                  dsimp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply]
                  exact hReluIdem (A_factor.input.apply x j)
                · rcases Nat.exists_eq_succ_of_ne_zero hz with ⟨t0, ht0⟩
                  rw [ht0]
                  have hlt : t0 < A_factor.depth - 1 := by rw [ht0]; omega
                  have hvec : A_factor.hiddenState x (t0 + 1) = (A_factor.hidden ⟨t0, hlt⟩).reluApply (A_factor.hiddenState x t0) := by
                    change (if ht : t0 < A_factor.depth - 1 then (A_factor.hidden ⟨t0, ht⟩).reluApply (A_factor.hiddenState x t0) else A_factor.hiddenState x t0) = (A_factor.hidden ⟨t0, hlt⟩).reluApply (A_factor.hiddenState x t0)
                    simp [hlt]
                  have hstep : A_factor.hiddenState x (t0 + 1) j = (A_factor.hidden ⟨t0, hlt⟩).reluApply (A_factor.hiddenState x t0) j := congrFun hvec j
                  rw [hstep]
                  dsimp [DenseLayer.reluApply, reluVec]
                  exact hReluIdem ((A_factor.hidden ⟨t0, hlt⟩).apply (A_factor.hiddenState x t0) j)
              -- Identity-layer lemmas: an identity layer on a block row applies relu to the state.
              have hIdP : ∀ (L : DenseLayer W W) (s : Fin W → ℝ) (j : Fin Wp),
                  (∀ k : Fin W, L.weight (incP j) k = if hk : k.val < Wp then (if incP j = k then (1 : ℝ) else 0) else 0) →
                  L.bias (incP j) = 0 →
                  L.reluApply s (incP j) = relu (s (incP j)) := by
                intro L s j hw hb
                change relu (L.apply s (incP j)) = relu (s (incP j))
                congr 1
                change (∑ k : Fin W, L.weight (incP j) k * s k + L.bias (incP j)) = s (incP j)
                have hsum : (∑ k : Fin W, (if hk : k.val < Wp then (if incP j = k then (1 : ℝ) else 0) else 0) * s k + 0) = s (incP j) := by
                  calc
                    (∑ k : Fin W, (if hk : k.val < Wp then (if incP j = k then (1 : ℝ) else 0) else 0) * s k + 0)
                        = ∑ k : Fin W, if incP j = k then s k else 0 := by
                          rw [add_zero]
                          apply Finset.sum_congr rfl
                          intro k hk
                          by_cases h : k.val < Wp
                          · by_cases h2 : incP j = k
                            · simp [h, h2]
                            · simp [h, h2]
                          · by_cases h2 : incP j = k
                            · exfalso
                              exact h (by rw [← h2]; exact j.isLt)
                            · simp [h, h2]
                    _ = s (incP j) := by
                          simpa using (Finset.sum_eq_single (incP j)
                            (by
                              intro b hb hbne
                              have hne' : ¬ incP j = b := by
                                intro h
                                exact hbne h.symm
                              simp [hne'])
                            (by intro hmem; exact (hmem (Finset.mem_univ _)).elim))
                calc
                  (∑ k : Fin W, L.weight (incP j) k * s k + L.bias (incP j))
                      = (∑ k : Fin W, (if hk : k.val < Wp then (if incP j = k then (1 : ℝ) else 0) else 0) * s k + 0) := by
                        simp [hw, hb]

                  _ = s (incP j) := by
                        exact hsum
              have hIdF : ∀ (L : DenseLayer W W) (s : Fin W → ℝ) (j : Fin Wf),
                  (∀ k : Fin W, L.weight (incF j) k = if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then (if incF j = k then (1 : ℝ) else 0) else 0) →
                  L.bias (incF j) = 0 →
                  L.reluApply s (incF j) = relu (s (incF j)) := by
                intro L s j hw hb
                change relu (L.apply s (incF j)) = relu (s (incF j))
                congr 1
                change (∑ k : Fin W, L.weight (incF j) k * s k + L.bias (incF j)) = s (incF j)
                have hsum : (∑ k : Fin W, (if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then (if incF j = k then (1 : ℝ) else 0) else 0) * s k + 0) = s (incF j) := by
                  calc
                    (∑ k : Fin W, (if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then (if incF j = k then (1 : ℝ) else 0) else 0) * s k + 0)
                        = ∑ k : Fin W, if incF j = k then s k else 0 := by
                          rw [add_zero]
                          apply Finset.sum_congr rfl
                          intro k hk
                          by_cases h : Wp ≤ k.val ∧ k.val < Wp + Wf
                          · by_cases h2 : incF j = k
                            · simp [h, h2]
                            · simp [h, h2]
                          · by_cases h2 : incF j = k
                            · exfalso
                              exact h (by rw [← h2]; change Wp ≤ Wp + j.val ∧ Wp + j.val < Wp + Wf; omega)
                            · simp [h, h2]
                    _ = s (incF j) := by
                          simpa using (Finset.sum_eq_single (incF j)
                            (by
                              intro b hb hbne
                              have hne' : ¬ incF j = b := by
                                intro h
                                exact hbne h.symm
                              simp [hne'])
                            (by intro hmem; exact (hmem (Finset.mem_univ _)).elim))
                calc
                  (∑ k : Fin W, L.weight (incF j) k * s k + L.bias (incF j))
                      = (∑ k : Fin W, (if hk : Wp ≤ k.val ∧ k.val < Wp + Wf then (if incF j = k then (1 : ℝ) else 0) else 0) * s k + 0) := by
                              simp [hw, hb]
                        _ = s (incF j) := by
                            exact hsum
              have hMulIdP : ∀ (s : Fin W → ℝ) (j : Fin Wp),
                  mulLayer.reluApply s (incP j) = relu (s (incP j)) := by
                intro s j
                have hnot : ¬ (Wp + Wf ≤ j.val) := by omega
                change relu (mulLayer.apply s (incP j)) = relu (s (incP j))
                congr 1
                change (∑ k : Fin W, mulLayer.weight (incP j) k * s k + mulLayer.bias (incP j)) = s (incP j)
                dsimp [mulLayer]
                simp [incP, hnot]

              have hMulIdF : ∀ (s : Fin W → ℝ) (j : Fin Wf),
                  mulLayer.reluApply s (incF j) = relu (s (incF j)) := by
                intro s j
                have hnot : ¬ (Wp + Wf ≤ Wp + j.val) := by omega
                change relu (mulLayer.apply s (incF j)) = relu (s (incF j))
                congr 1
                change (∑ k : Fin W, mulLayer.weight (incF j) k * s k + mulLayer.bias (incF j)) = s (incF j)
                dsimp [mulLayer]
                simp [incF, hnot]

              -- Hidden-state tracking for the prefix block: A's prefix rows evolve exactly as A_prefix,
              -- with identity (relu) padding once A_prefix has exhausted its own depth.
              have hTrackP : ∀ t : ℕ, t ≤ m + 2 → ∀ j : Fin Wp,
                  A.hiddenState x t (incP j) = A_prefix.hiddenState x t j := by
                intro t
                induction t with
                | zero =>
                    intro hle j
                    change reluVec (inputLayer.apply x) (incP j) = reluVec (A_prefix.input.apply x) j
                    dsimp [reluVec]
                    congr 1
                    change (∑ q : Fin d, inputLayer.weight (incP j) q * x q + inputLayer.bias (incP j)) = (∑ q : Fin d, A_prefix.input.weight j q * x q + A_prefix.input.bias j)
                    dsimp [inputLayer]
                    simp [incP, j.isLt]
                | succ t ih =>
                    intro hle j
                    have ht_lt : t < m + 2 := by omega
                    have hAst : A.hiddenState x (t + 1) = (A.hidden ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) := by
                      change (if ht : t < A.depth - 1 then (A.hidden ⟨t, ht⟩).reluApply (A.hiddenState x t) else A.hiddenState x t) = (A.hidden ⟨t, ht_lt⟩).reluApply (A.hiddenState x t)
                      have ht' : t < A.depth - 1 := by dsimp [A]; omega
                      simp [ht']
                    rw [hAst]
                    have hPstep : A_prefix.hiddenState x (t + 1) j =
                        (if ht_pre : t < A_prefix.depth - 1 then
                           (A_prefix.hidden ⟨t, ht_pre⟩).reluApply (A_prefix.hiddenState x t) j
                         else A_prefix.hiddenState x t j) := by
                      by_cases h : t < A_prefix.depth - 1
                      · have hvec : A_prefix.hiddenState x (t + 1) = (A_prefix.hidden ⟨t, h⟩).reluApply (A_prefix.hiddenState x t) := by
                          change (if ht : t < A_prefix.depth - 1 then (A_prefix.hidden ⟨t, ht⟩).reluApply (A_prefix.hiddenState x t) else A_prefix.hiddenState x t) = (A_prefix.hidden ⟨t, h⟩).reluApply (A_prefix.hiddenState x t)
                          simp [h]
                        rw [hvec]
                        simp [h]
                      · have hvec : A_prefix.hiddenState x (t + 1) = A_prefix.hiddenState x t := by
                          change (if ht : t < A_prefix.depth - 1 then (A_prefix.hidden ⟨t, ht⟩).reluApply (A_prefix.hiddenState x t) else A_prefix.hiddenState x t) = A_prefix.hiddenState x t
                          simp [h]
                        rw [hvec]
                        simp [h]
                    rw [hPstep]
                    by_cases ht_pre : t < A_prefix.depth - 1
                    · by_cases htm : t < m + 1
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = parallelLayer ⟨t, ht_lt⟩ := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        have hPl : (parallelLayer ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) (incP j)
                            = relu ((A_prefix.hidden ⟨t, ht_pre⟩).apply (fun k : Fin Wp => A.hiddenState x t (incP k)) j) := by
                          change relu ((parallelLayer ⟨t, ht_lt⟩).apply (A.hiddenState x t) (incP j)) = relu ((A_prefix.hidden ⟨t, ht_pre⟩).apply (fun k : Fin Wp => A.hiddenState x t (incP k)) j)
                          congr 1
                          change (∑ k : Fin W, (parallelLayer ⟨t, ht_lt⟩).weight (incP j) k * A.hiddenState x t k + (parallelLayer ⟨t, ht_lt⟩).bias (incP j)) = (A_prefix.hidden ⟨t, ht_pre⟩).apply (fun k : Fin Wp => A.hiddenState x t (incP k)) j
                          dsimp [parallelLayer]
                          simp [incP, j.isLt, ht_pre]
                          rw [hsumP (fun k : Fin Wp => (A_prefix.hidden ⟨t, ht_pre⟩).weight ⟨j.val, j.isLt⟩ k) (A.hiddenState x t)]
                          simp [DenseLayer.apply, incP]
                          rfl
                        rw [hPl]
                        have hfun : (fun k : Fin Wp => A.hiddenState x t (incP k)) = A_prefix.hiddenState x t := by
                          funext k
                          exact ih (by omega) k
                        rw [hfun]
                        simp [ht_pre, DenseLayer.reluApply, reluVec]
                      · omega
                    · by_cases htm : t < m + 1
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = parallelLayer ⟨t, ht_lt⟩ := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        have hL : (parallelLayer ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) (incP j)
                            = relu (A.hiddenState x t (incP j)) := by
                          apply hIdP (parallelLayer ⟨t, ht_lt⟩) (A.hiddenState x t) j
                          · intro k
                            dsimp [parallelLayer]
                            simp [incP, j.isLt, ht_pre]
                          · dsimp [parallelLayer]
                            simp [incP, j.isLt, ht_pre]
                        rw [hL]
                        rw [ih (by omega) j]
                        rw [hReluStableP t (by omega) j]
                        simp [ht_pre]
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = mulLayer := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        rw [hMulIdP (A.hiddenState x t) j]
                        rw [ih (by omega) j]
                        rw [hReluStableP t (by omega) j]
                        simp [ht_pre]
              -- Hidden-state tracking for the factor block.
              have hTrackF : ∀ t : ℕ, t ≤ m + 2 → ∀ j : Fin Wf,
                  A.hiddenState x t (incF j) = A_factor.hiddenState x t j := by
                intro t
                induction t with
                | zero =>
                    intro hle j
                    have hnot_lt : ¬ (Wp + j.val < Wp) := by omega
                    have hlt_W : Wp + j.val < Wp + Wf := by omega
                    change reluVec (inputLayer.apply x) (incF j) = reluVec (A_factor.input.apply x) j
                    dsimp [reluVec]
                    congr 1
                    change (∑ q : Fin d, inputLayer.weight (incF j) q * x q + inputLayer.bias (incF j)) = (∑ q : Fin d, A_factor.input.weight j q * x q + A_factor.input.bias j)
                    dsimp [inputLayer]
                    simp [incF, hnot_lt, hlt_W, Nat.add_sub_cancel]
                | succ t ih =>
                    intro hle j
                    have ht_lt : t < m + 2 := by omega
                    have hAst : A.hiddenState x (t + 1) = (A.hidden ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) := by
                      change (if ht : t < A.depth - 1 then (A.hidden ⟨t, ht⟩).reluApply (A.hiddenState x t) else A.hiddenState x t) = (A.hidden ⟨t, ht_lt⟩).reluApply (A.hiddenState x t)
                      have ht' : t < A.depth - 1 := by dsimp [A]; omega
                      simp [ht']
                    rw [hAst]
                    have hPstepF : A_factor.hiddenState x (t + 1) j =
                        (if ht_preF : t < A_factor.depth - 1 then
                           (A_factor.hidden ⟨t, ht_preF⟩).reluApply (A_factor.hiddenState x t) j
                         else A_factor.hiddenState x t j) := by
                      by_cases h : t < A_factor.depth - 1
                      · have hvec : A_factor.hiddenState x (t + 1) = (A_factor.hidden ⟨t, h⟩).reluApply (A_factor.hiddenState x t) := by
                          change (if ht : t < A_factor.depth - 1 then (A_factor.hidden ⟨t, ht⟩).reluApply (A_factor.hiddenState x t) else A_factor.hiddenState x t) = (A_factor.hidden ⟨t, h⟩).reluApply (A_factor.hiddenState x t)
                          simp [h]
                        rw [hvec]
                        simp [h]
                      · have hvec : A_factor.hiddenState x (t + 1) = A_factor.hiddenState x t := by
                          change (if ht : t < A_factor.depth - 1 then (A_factor.hidden ⟨t, ht⟩).reluApply (A_factor.hiddenState x t) else A_factor.hiddenState x t) = A_factor.hiddenState x t
                          simp [h]
                        rw [hvec]
                        simp [h]
                    rw [hPstepF]
                    by_cases ht_preF : t < A_factor.depth - 1
                    · by_cases htm : t < m + 1
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = parallelLayer ⟨t, ht_lt⟩ := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        have hPlF : (parallelLayer ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) (incF j)
                            = relu ((A_factor.hidden ⟨t, ht_preF⟩).apply (fun k : Fin Wf => A.hiddenState x t (incF k)) j) := by
                          change relu ((parallelLayer ⟨t, ht_lt⟩).apply (A.hiddenState x t) (incF j)) = relu ((A_factor.hidden ⟨t, ht_preF⟩).apply (fun k : Fin Wf => A.hiddenState x t (incF k)) j)
                          congr 1
                          change (∑ k : Fin W, (parallelLayer ⟨t, ht_lt⟩).weight (incF j) k * A.hiddenState x t k + (parallelLayer ⟨t, ht_lt⟩).bias (incF j)) = (A_factor.hidden ⟨t, ht_preF⟩).apply (fun k : Fin Wf => A.hiddenState x t (incF k)) j
                          dsimp [parallelLayer]
                          have hnot_lt : ¬ (Wp + j.val < Wp) := by omega
                          have hlt_W : Wp + j.val < Wp + Wf := by omega
                          simp [incF, j.isLt, ht_preF, hnot_lt, hlt_W]
                          rw [hsumF (fun k : Fin Wf => (A_factor.hidden ⟨t, ht_preF⟩).weight ⟨j.val, j.isLt⟩ k) (A.hiddenState x t)]
                          simp [DenseLayer.apply, Nat.add_sub_cancel, incF]
                          rfl
                        rw [hPlF]
                        have hfun : (fun k : Fin Wf => A.hiddenState x t (incF k)) = A_factor.hiddenState x t := by
                          funext k
                          exact ih (by omega) k
                        rw [hfun]
                        simp [ht_preF, DenseLayer.reluApply, reluVec]
                      · omega
                    · by_cases htm : t < m + 1
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = parallelLayer ⟨t, ht_lt⟩ := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        have hL : (parallelLayer ⟨t, ht_lt⟩).reluApply (A.hiddenState x t) (incF j)
                            = relu (A.hiddenState x t (incF j)) := by
                          apply hIdF (parallelLayer ⟨t, ht_lt⟩) (A.hiddenState x t) j
                          · intro k
                            dsimp [parallelLayer]
                            have hnot_lt : ¬ (Wp + j.val < Wp) := by omega
                            have hlt_W : Wp + j.val < Wp + Wf := by omega
                            simp [incF, j.isLt, ht_preF, hnot_lt, hlt_W]
                          · dsimp [parallelLayer]
                            have hnot_lt : ¬ (Wp + j.val < Wp) := by omega
                            have hlt_W : Wp + j.val < Wp + Wf := by omega
                            simp [incF, j.isLt, ht_preF, hnot_lt, hlt_W]
                        rw [hL]
                        rw [ih (by omega) j]
                        rw [hReluStableF t (by omega) j]
                        simp [ht_preF]
                      · have hAh : A.hidden ⟨t, ht_lt⟩ = mulLayer := by
                          dsimp [A]
                          simp [htm]
                        rw [hAh]
                        rw [hMulIdF (A.hiddenState x t) j]
                        rw [ih (by omega) j]
                        rw [hReluStableF t (by omega) j]
                        simp [ht_preF]
              -- (9) The composite network realizes N_mul applied to the two component outputs.
              let u : Fin 2 → ℝ := fun a => if a.val = 0 then A_prefix.realize x else A_factor.realize x
              have hu0 : u 0 = A_prefix.realize x := by simp [u]
              have hu1 : u 1 = A_factor.realize x := by simp [u]
              -- (9a) The mul block of the last hidden layer equals N_mul's input layer applied to u.
              -- (9a) The mul block of the last hidden layer equals N_mul's input layer applied to u.
              have hmul_apply : ∀ i : Fin N_mul.width, mulLayer.apply (A.hiddenState x (m + 1)) (incM i) = N_mul.input.apply u i := by
                intro i
                change (∑ k : Fin W, mulLayer.weight (incM i) k * A.hiddenState x (m + 1) k + mulLayer.bias (incM i)) = N_mul.input.apply u i
                have hjm : Wp + Wf ≤ (incM i).val := by dsimp [incM]; omega
                have hsub : (incM i).val - (Wp + Wf) = i.val := by dsimp [incM]; omega
                have hw : ∀ k : Fin W, mulLayer.weight (incM i) k * A.hiddenState x (m + 1) k =
                    (if hkp : k.val < Wp then N_mul.input.weight i 0 * A_prefix.outputWeight ⟨k.val, hkp⟩ * A.hiddenState x (m + 1) k else 0) +
                    (if hkf : Wp ≤ k.val ∧ k.val < Wp + Wf then N_mul.input.weight i 1 * A_factor.outputWeight ⟨k.val - Wp, by omega⟩ * A.hiddenState x (m + 1) k else 0) := by
                  intro k
                  dsimp [mulLayer]
                  simp [incM, hjm, hsub]
                  by_cases h1 : k.val < Wp
                  · by_cases h2 : Wp ≤ k.val ∧ k.val < Wp + Wf
                    · exfalso; omega
                    · simp [h1, h2]
                  · by_cases h2 : Wp ≤ k.val ∧ k.val < Wp + Wf
                    · have hlt : k.val < Wp + Wf := h2.2
                      simp [h1, h2, hlt]
                    · have hnotlt : ¬ (k.val < Wp + Wf) := by omega
                      simp [h1, h2, hnotlt]
                have hb : mulLayer.bias (incM i) = N_mul.input.bias i + N_mul.input.weight i 0 * A_prefix.outputBias + N_mul.input.weight i 1 * A_factor.outputBias := by
                  dsimp [mulLayer]
                  simp [incM, hjm, hsub]
                calc
                  (∑ k : Fin W, mulLayer.weight (incM i) k * A.hiddenState x (m + 1) k + mulLayer.bias (incM i))
                      = (∑ k : Fin W, ((if hkp : k.val < Wp then N_mul.input.weight i 0 * A_prefix.outputWeight ⟨k.val, hkp⟩ * A.hiddenState x (m + 1) k else 0) +
                          (if hkf : Wp ≤ k.val ∧ k.val < Wp + Wf then N_mul.input.weight i 1 * A_factor.outputWeight ⟨k.val - Wp, by omega⟩ * A.hiddenState x (m + 1) k else 0))) + mulLayer.bias (incM i) := by
                        congr 1
                        apply Finset.sum_congr rfl
                        intro k hk
                        rw [hw k]
                  _ = (∑ k : Fin W, ((if hkp : k.val < Wp then N_mul.input.weight i 0 * A_prefix.outputWeight ⟨k.val, hkp⟩ * A.hiddenState x (m + 1) k else 0) +
                          (if hkf : Wp ≤ k.val ∧ k.val < Wp + Wf then N_mul.input.weight i 1 * A_factor.outputWeight ⟨k.val - Wp, by omega⟩ * A.hiddenState x (m + 1) k else 0))) +
                          (N_mul.input.bias i + N_mul.input.weight i 0 * A_prefix.outputBias + N_mul.input.weight i 1 * A_factor.outputBias) := by
                        rw [hb]
                  _ = N_mul.input.apply u i := by
                        rw [Finset.sum_add_distrib]
                        rw [hsumP (fun k : Fin Wp => N_mul.input.weight i 0 * A_prefix.outputWeight k) (A.hiddenState x (m + 1))]
                        rw [hsumF (fun k : Fin Wf => N_mul.input.weight i 1 * A_factor.outputWeight k) (A.hiddenState x (m + 1))]
                        simp_rw [hTrackP (m + 1) (by omega), hTrackF (m + 1) (by omega)]
                        simp_rw [hFrozenP (m + 1) (by have := hAp_depth; omega), hFrozenF (m + 1) (by have := hAf_depth; omega)]
                        have hP : (∑ k : Fin Wp, (N_mul.input.weight i 0 * A_prefix.outputWeight k) * A_prefix.hiddenState x (A_prefix.depth - 1) k) + N_mul.input.weight i 0 * A_prefix.outputBias = N_mul.input.weight i 0 * A_prefix.realize x := by
                          calc
                            (∑ k : Fin Wp, (N_mul.input.weight i 0 * A_prefix.outputWeight k) * A_prefix.hiddenState x (A_prefix.depth - 1) k) + N_mul.input.weight i 0 * A_prefix.outputBias
                                = N_mul.input.weight i 0 * (∑ k : Fin Wp, A_prefix.outputWeight k * A_prefix.hiddenState x (A_prefix.depth - 1) k) + N_mul.input.weight i 0 * A_prefix.outputBias := by
                                  simp [mul_assoc]
                                  rw [Finset.mul_sum]
                            _ = N_mul.input.weight i 0 * ((∑ k : Fin Wp, A_prefix.outputWeight k * A_prefix.hiddenState x (A_prefix.depth - 1) k) + A_prefix.outputBias) := by ring
                            _ = N_mul.input.weight i 0 * A_prefix.realize x := by rfl
                        have hF : (∑ k : Fin Wf, (N_mul.input.weight i 1 * A_factor.outputWeight k) * A_factor.hiddenState x (A_factor.depth - 1) k) + N_mul.input.weight i 1 * A_factor.outputBias = N_mul.input.weight i 1 * A_factor.realize x := by
                          calc
                            (∑ k : Fin Wf, (N_mul.input.weight i 1 * A_factor.outputWeight k) * A_factor.hiddenState x (A_factor.depth - 1) k) + N_mul.input.weight i 1 * A_factor.outputBias
                                = N_mul.input.weight i 1 * (∑ k : Fin Wf, A_factor.outputWeight k * A_factor.hiddenState x (A_factor.depth - 1) k) + N_mul.input.weight i 1 * A_factor.outputBias := by
                                  simp [mul_assoc]
                                  rw [Finset.mul_sum]
                            _ = N_mul.input.weight i 1 * ((∑ k : Fin Wf, A_factor.outputWeight k * A_factor.hiddenState x (A_factor.depth - 1) k) + A_factor.outputBias) := by ring
                            _ = N_mul.input.weight i 1 * A_factor.realize x := by rfl
                        simp [DenseLayer.apply, Fin.sum_univ_two]
                        rw [hu0, hu1]
                        rw [← hP, ← hF]
                        ring
              -- (9b) The last hidden layer applies the mul layer on the mul block.
              have hMulState : ∀ i : Fin N_mul.width, A.hiddenState x (m + 2) (incM i) = N_mul.hiddenState u 0 i := by
                intro i
                have ht' : m + 1 < A.depth - 1 := by dsimp [A]; omega
                have hAst : A.hiddenState x (m + 2) = (A.hidden ⟨m + 1, ht'⟩).reluApply (A.hiddenState x (m + 1)) := by
                  change (if ht : m + 1 < A.depth - 1 then (A.hidden ⟨m + 1, ht⟩).reluApply (A.hiddenState x (m + 1)) else A.hiddenState x (m + 1)) = (A.hidden ⟨m + 1, ht'⟩).reluApply (A.hiddenState x (m + 1))
                  simp [ht']
                rw [hAst]
                have hhid : A.hidden ⟨m + 1, ht'⟩ = mulLayer := by
                  dsimp [A]
                  have hnot : ¬ (m + 1 < m + 1) := by omega
                  simp [hnot]
                rw [hhid]
                change relu (mulLayer.apply (A.hiddenState x (m + 1)) (incM i)) = relu (N_mul.input.apply u i)
                congr 1
                exact hmul_apply i
              -- (9c) Realize identity: A.realize x = N_mul.realize u.
              have hRealize : A.realize x = N_mul.realize u := by
                change (∑ j : Fin W, A.outputWeight j * A.hiddenState x (A.depth - 1) j + A.outputBias) = (∑ j : Fin N_mul.width, N_mul.outputWeight j * N_mul.hiddenState u (N_mul.depth - 1) j + N_mul.outputBias)
                have hdep : A.depth - 1 = m + 2 := by dsimp [A]
                have hNm_dep0 : N_mul.depth - 1 = 0 := by omega
                rw [hdep, hNm_dep0]
                have hsum_red : (∑ j : Fin W, A.outputWeight j * A.hiddenState x (m + 2) j) = (∑ i : Fin N_mul.width, N_mul.outputWeight i * A.hiddenState x (m + 2) (incM i)) := by
                  calc
                    (∑ j : Fin W, A.outputWeight j * A.hiddenState x (m + 2) j)
                        = (∑ j : Fin W, if hk : Wp + Wf ≤ j.val then N_mul.outputWeight ⟨j.val - (Wp + Wf), by dsimp [W, Wm]; omega⟩ * A.hiddenState x (m + 2) j else 0) := by
                          apply Finset.sum_congr rfl
                          intro j hj
                          dsimp [A]
                          by_cases h : Wp + Wf ≤ j.val
                          · simp [h]
                          · simp [h]
                    _ = (∑ i : Fin N_mul.width, N_mul.outputWeight i * A.hiddenState x (m + 2) (incM i)) := by
                          rw [hsumM (fun i : Fin N_mul.width => N_mul.outputWeight i) (A.hiddenState x (m + 2))]
                rw [hsum_red]
                simp_rw [hMulState]
                dsimp [A]
              -- (9d) Final error combination.
              rw [h_split x]
              have hNm_err' : |N_mul.realize u - u 0 * u 1| ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 := by
                apply hNm_err u
                · rw [hu0]; exact hAp_bnd x hx
                · rw [hu1]; exact hAf_bnd x hx
              have htri : |A.realize x - f x * g x| ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 + B * centeredMonomialApproxError R n (m + 1) := by
                calc
                  |A.realize x - f x * g x| = |N_mul.realize u - f x * g x| := by rw [hRealize]
                  _ ≤ |N_mul.realize u - u 0 * u 1| + |u 0 * u 1 - f x * g x| := by
                    rw [show N_mul.realize u - f x * g x = (N_mul.realize u - u 0 * u 1) + (u 0 * u 1 - f x * g x) by ring]
                    rw [abs_le]
                    constructor
                    · linarith [neg_abs_le (N_mul.realize u - u 0 * u 1), neg_abs_le (u 0 * u 1 - f x * g x)]
                    · linarith [le_abs_self (N_mul.realize u - u 0 * u 1), le_abs_self (u 0 * u 1 - f x * g x)]
                  _ ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 + |u 0 * u 1 - f x * g x| := by
                    linarith [hNm_err']
                  _ ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 + |u 0 - f x| * |g x| := by
                    have hu1g : u 1 = g x := by rw [hu1, hAf_eq x hx]
                    have hstep : |u 0 * u 1 - f x * g x| ≤ |u 0 - f x| * |g x| := by
                      rw [hu1g]
                      rw [← sub_mul]
                      rw [abs_mul]
                    linarith
                  _ ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 + centeredMonomialApproxError R n (m + 1) * R := by
                    have hle1 : |u 0 - f x| ≤ centeredMonomialApproxError R n (m + 1) := by
                      rw [hu0]
                      exact hAp_err x hx
                    have hle2 : |g x| ≤ R := by dsimp [g, j]; exact hx (c j)
                    have hm : |u 0 - f x| * |g x| ≤ centeredMonomialApproxError R n (m + 1) * R := by
                      exact mul_le_mul hle1 hle2 (abs_nonneg (g x)) hη_nonneg
                    linarith
                  _ ≤ 2 * B ^ 2 / (n : ℝ) ^ 2 + B * centeredMonomialApproxError R n (m + 1) := by
                    have hmulB : centeredMonomialApproxError R n (m + 1) * R ≤ B * centeredMonomialApproxError R n (m + 1) := by
                      calc
                        centeredMonomialApproxError R n (m + 1) * R ≤ centeredMonomialApproxError R n (m + 1) * B := by
                          exact mul_le_mul_of_nonneg_left hR_le_B hη_nonneg
                        _ = B * centeredMonomialApproxError R n (m + 1) := by ring
                    linarith
              have hfinal : 2 * B ^ 2 / (n : ℝ) ^ 2 + B * centeredMonomialApproxError R n (m + 1) ≤ centeredMonomialApproxError R n (m + 2) := by
                rw [he_rec]
              exact le_trans htri hfinal
      -- @step fin: chain the base cases and the induction step by strong induction on m.
      intro m
      exact Nat.strong_induction_on m
        (fun n ih =>
          match n with
          | 0 => h_base.1
          | Nat.succ k =>
              match k with
              | 0 => h_base.2
              | Nat.succ j => h_step j (ih (j + 1) (Nat.lt_succ_self (j + 1))))
  -- @step s4: Specialize h_s1 at each r ∈ s (m = degree r, c = coord r): per-monomial networks A_r with
  --   0 < (A r).depth ∧ (A r).depth ≤ degree r + 1, width ≤ centeredMonomialWidthBound n (degree r),
  --   and error ≤ centeredMonomialApproxError R n (degree r) on the centered box.
  --   (No depth-one claim: h_s1 only guarantees depth ≤ degree r + 1, which is what the folding below needs.)
  have h_s4 :
      ∃ A : ι → FullyConnectedReLUNet d,
        (∀ r ∈ s, 0 < (A r).depth ∧ (A r).depth ≤ degree r + 1) ∧
        (∀ r ∈ s, (A r).width ≤ centeredMonomialWidthBound n (degree r)) ∧
        (∀ r ∈ s, ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
          |(A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤
            centeredMonomialApproxError R n (degree r)) := by
      classical
      let A : ι → FullyConnectedReLUNet d := fun r =>
        Classical.choose (h_s1 (degree r) (coord r))
      have hA : ∀ r : ι,
          (0 < (A r).depth ∧ (A r).depth ≤ degree r + 1) ∧
          (A r).width ≤ centeredMonomialWidthBound n (degree r) ∧
          (∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |(A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| ≤
              centeredMonomialApproxError R n (degree r)) := by
        intro r
        rcases Classical.choose_spec (h_s1 (degree r) (coord r)) with ⟨hAr0, hAr1, hAr2, hAr3⟩
        exact ⟨⟨hAr0, hAr1⟩, ⟨hAr2, hAr3⟩⟩
      refine ⟨A, ?_, ?_, ?_⟩
      · intro r hr
        exact (hA r).1
      · intro r hr
        exact (hA r).2.1
      · intro r hr x hx
        exact (hA r).2.2 x hx
  -- @step s5: Fold the per-monomial networks into a single network N with all four bounds.
  --   E1 (finite_linear_combination_approx) is NOT usable here: it requires (A r).depth = 1 for every r ∈ s,
  --   but h_s1/h_s4 only provide depth ≤ degree r + 1 (and depth-one networks cannot achieve the degree-≥3
  --   error rates anyway). Instead compose the columns directly:
  --     • append a value-capture layer to each column of degree ≥ 2, whose features are
  --       relu(v_r), relu(-v_r) (plus zero filler), v_r being the value realized by (A r);
  --     • pad every column with identity layers to the common depth max_r (d_r + 1) — relu is idempotent
  --       on nonnegative ReLU features, so the pairs (relu(v_r), relu(-v_r)) survive, giving v_r exactly;
  --     • stack the padded columns in parallel (block-diagonal layers): width = sum of column widths;
  --     • append one final output layer reading coeff r * (relu(v_r) - relu(-v_r)) per column — an EXACT
  --       linear combination, so the folding adds no approximation error.
  --   Depth: ≤ (max_r (degree r + 2)) + 1 ≤ ∑ (degree r + 1) + 1 when |s| ≥ 2; ≤ d_r + 1 ≤ degree r + 2
  --   when |s| = 1; = 1 for the empty family (constant-zero network). Width ≤ finiteCenteredMonomialPolynomialWidthBound
  --   (E6); error ≤ ∑ |coeff r| · centeredMonomialApproxError R n (degree r) = finiteCenteredMonomialPolynomialApproxError
  --   (E5); parameterCount ≤ fullyConnectedReLUParameterCount d DepthBound WidthBound =
  --   finiteCenteredMonomialPolynomialParameterBound (E7) by monotonicity of the formula (E11) in depth and width.
  have h_s5 :
      ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤ finiteCenteredMonomialPolynomialDepthBound s degree ∧
        N.width ≤ finiteCenteredMonomialPolynomialWidthBound n s degree ∧
        N.parameterCount ≤
          finiteCenteredMonomialPolynomialParameterBound d n s degree ∧
        ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
          |N.realize x -
              finiteLinearCombination s coeff
                (fun r : ι => fun y : Fin d → ℝ =>
                  ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
            finiteCenteredMonomialPolynomialApproxError R n s coeff degree := by
      rcases h_s4 with ⟨A, hA_depth, hA_width, hA_err⟩
      let T := finiteCenteredMonomialPolynomialDepthBound s degree
      -- @step s1: For every r ∈ s, pad the per-monomial network (A r) to the common depth T by
      --   appending identity layers, preserving width and the realized function on every input.
      have h_pad :
          ∃ B : ι → FullyConnectedReLUNet d,
            (∀ r ∈ s, (B r).depth = T) ∧
            (∀ r ∈ s, (B r).width = (A r).width) ∧
            (∀ r ∈ s, ∀ x : Fin d → ℝ, (B r).realize x = (A r).realize x) := by
        let idLayer : ∀ w : ℕ, DenseLayer w w := fun w =>
          ({ weight := (1 : Matrix (Fin w) (Fin w) ℝ), bias := fun _ => 0 } : DenseLayer w w)
        let B : ι → FullyConnectedReLUNet d := fun r =>
          if hr : r ∈ s then
            { depth := T
              width := (A r).width
              input := (A r).input
              hidden := fun t : Fin (T - 1) =>
                if ht : (t : ℕ) < (A r).depth - 1 then (A r).hidden ⟨t, ht⟩
                else idLayer (A r).width
              outputWeight := (A r).outputWeight
              outputBias := (A r).outputBias }
          else A r
        refine ⟨B, ?_, ?_, ?_⟩
        · intro r hr
          simp [B, hr]
        · intro r hr
          simp [B, hr]
        · intro r hr x
          let C : FullyConnectedReLUNet d :=
            { depth := T
              width := (A r).width
              input := (A r).input
              hidden := fun t : Fin (T - 1) =>
                if ht : (t : ℕ) < (A r).depth - 1 then (A r).hidden ⟨t, ht⟩
                else idLayer (A r).width
              outputWeight := (A r).outputWeight
              outputBias := (A r).outputBias }
          have hBrC : B r = C := by
            simp [B, C, hr]
          have hdeg_le : degree r ≤ ∑ r ∈ s, degree r := by
            exact Finset.single_le_sum (fun i _ => Nat.zero_le (degree i)) hr
          have hdeg1_le : degree r + 1 ≤ ∑ r ∈ s, (degree r + 1) := by
            exact Finset.single_le_sum (fun i _ => Nat.zero_le (degree i + 1)) hr
          have hA_le : (A r).depth ≤ T := by
            have h1 : (A r).depth ≤ degree r + 1 := (hA_depth r hr).2
            have h2 : degree r + 1 ≤ degree r + 1 + 1 := Nat.le_succ (degree r + 1)
            have h3 : degree r + 1 + 1 ≤ ∑ r ∈ s, (degree r + 1 + 1) := by
              exact Finset.single_le_sum (fun i _ => Nat.zero_le (degree i + 1 + 1)) hr
            dsimp [T, finiteCenteredMonomialPolynomialDepthBound]
            omega
          have hid_apply : ∀ (w : ℕ) (v : Fin w → ℝ) (j : Fin w), (idLayer w).apply v j = v j := by
            intro w v j
            simp [DenseLayer.apply, idLayer, Matrix.one_apply]
          have hid : ∀ (w : ℕ) (v : Fin w → ℝ), (∀ j : Fin w, 0 ≤ v j) → (idLayer w).reluApply v = v := by
            intro w v hv
            funext j
            rw [DenseLayer.reluApply]
            simp only [Statlib.Nonparametric.Vocabulary.reluVec, hid_apply,
              Statlib.Nonparametric.Vocabulary.relu]
            exact max_eq_left (hv j)
          have hnonneg : ∀ (N : FullyConnectedReLUNet d) (x : Fin d → ℝ) (k : ℕ) (j : Fin N.width),
              0 ≤ N.hiddenState x k j := by
            intro N x k
            induction k with
            | zero =>
                intro j
                rw [FullyConnectedReLUNet.hiddenState.eq_1]
                simp only [DenseLayer.reluApply, Statlib.Nonparametric.Vocabulary.reluVec,
                  Statlib.Nonparametric.Vocabulary.relu]
                exact le_max_right _ _
            | succ k ih =>
                intro j
                rw [FullyConnectedReLUNet.hiddenState.eq_2]
                by_cases hk : k < N.depth - 1
                · simp [hk]
                  simp only [DenseLayer.reluApply, Statlib.Nonparametric.Vocabulary.reluVec,
                    Statlib.Nonparametric.Vocabulary.relu]
                  exact le_max_right _ _
                · simp [hk]
                  exact ih j
          have hstate :
              ∀ k : ℕ, k ≤ T - 1 →
                C.hiddenState x k = (A r).hiddenState x (min k ((A r).depth - 1)) := by
            intro k
            induction k with
            | zero =>
                intro hk
                have hmin0 : min 0 ((A r).depth - 1) = 0 := min_eq_left (Nat.zero_le _)
                rw [FullyConnectedReLUNet.hiddenState.eq_1, hmin0]
                rw [FullyConnectedReLUNet.hiddenState.eq_1]
            | succ k ih =>
                intro hk
                have hkt : k < T - 1 := by omega
                have hk_le : k ≤ T - 1 := by omega
                by_cases hklt : k < (A r).depth - 1
                · have hk1 : k + 1 ≤ (A r).depth - 1 := Nat.succ_le_of_lt hklt
                  have hmin1 : min (k + 1) ((A r).depth - 1) = k + 1 := min_eq_left hk1
                  have hk2 : k ≤ (A r).depth - 1 := le_of_lt hklt
                  have hmin2 : min k ((A r).depth - 1) = k := min_eq_left hk2
                  calc
                    C.hiddenState x (k + 1)
                        = (C.hidden ⟨k, hkt⟩).reluApply (C.hiddenState x k) := by
                            rw [FullyConnectedReLUNet.hiddenState.eq_2]
                            simp [C, hkt]
                    _ = ((A r).hidden ⟨k, hklt⟩).reluApply (C.hiddenState x k) := by
                            simp [C, hklt]
                    _ = ((A r).hidden ⟨k, hklt⟩).reluApply ((A r).hiddenState x k) := by
                            rw [ih hk_le, hmin2]
                    _ = (A r).hiddenState x (k + 1) := by
                            rw [FullyConnectedReLUNet.hiddenState.eq_2]
                            simp [hklt]
                    _ = (A r).hiddenState x (min (k + 1) ((A r).depth - 1)) := by
                            exact congrArg (fun m => (A r).hiddenState x m) hmin1.symm
                · have hk3 : (A r).depth - 1 ≤ k := Nat.le_of_not_gt hklt
                  have hk4 : (A r).depth - 1 ≤ k + 1 := le_trans hk3 (Nat.le_succ k)
                  have hmin3 : min (k + 1) ((A r).depth - 1) = (A r).depth - 1 := min_eq_right hk4
                  have hmin4 : min k ((A r).depth - 1) = (A r).depth - 1 := min_eq_right hk3
                  calc
                    C.hiddenState x (k + 1)
                        = (C.hidden ⟨k, hkt⟩).reluApply (C.hiddenState x k) := by
                            rw [FullyConnectedReLUNet.hiddenState.eq_2]
                            simp [C, hkt]
                    _ = (idLayer (A r).width).reluApply (C.hiddenState x k) := by
                            simp [C, hklt]
                    _ = C.hiddenState x k := by
                            exact hid (A r).width (C.hiddenState x k) (hnonneg C x k)
                    _ = (A r).hiddenState x ((A r).depth - 1) := by
                            rw [ih hk_le, hmin4]
                    _ = (A r).hiddenState x (min (k + 1) ((A r).depth - 1)) := by
                            exact congrArg (fun m => (A r).hiddenState x m) hmin3.symm
          have hfinal : C.hiddenState x (T - 1) = (A r).hiddenState x ((A r).depth - 1) := by
            have hs := hstate (T - 1) (le_rfl : T - 1 ≤ T - 1)
            have ha1_le : (A r).depth - 1 ≤ T - 1 := Nat.sub_le_sub_right hA_le 1
            have hminT : min (T - 1) ((A r).depth - 1) = (A r).depth - 1 := min_eq_right ha1_le
            rw [hminT] at hs
            exact hs
          have hrealC : C.realize x = (A r).realize x := by
            calc
              C.realize x = ∑ j : Fin (A r).width, (A r).outputWeight j * C.hiddenState x (T - 1) j + (A r).outputBias := by
                  simp [FullyConnectedReLUNet.realize, C]
              _ = ∑ j : Fin (A r).width, (A r).outputWeight j * (A r).hiddenState x ((A r).depth - 1) j + (A r).outputBias := by
                  rw [hfinal]
              _ = (A r).realize x := by
                  simp [FullyConnectedReLUNet.realize]
          rw [hBrC]
          exact hrealC
      rcases h_pad with ⟨B, hB_depth, hB_width, hB_real⟩
      -- @step s2: Build the block-diagonal network N of depth T and width ∑ r ∈ s, (B r).width
      --   with N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x;
      --   in particular 0 < N.depth and N.depth ≤ finiteCenteredMonomialPolynomialDepthBound s degree.
      have h_block :
          ∃ N : FullyConnectedReLUNet d,
            N.depth = T ∧
            0 < N.depth ∧
            N.depth ≤ T ∧
            N.width = ∑ r ∈ s, (B r).width ∧
            (∀ x : Fin d → ℝ,
              N.realize x = finiteLinearCombination s coeff (fun r y => (A r).realize y) x) := by
        classical
        have hT_pos : 0 < T := by
          dsimp [T, finiteCenteredMonomialPolynomialDepthBound]
          omega
        have hcomb2 :
            ∀ (A₁ A₂ : FullyConnectedReLUNet d) (D : ℕ) (a b : ℝ),
              A₁.depth = D → A₂.depth = D → 0 < D →
              ∃ C : FullyConnectedReLUNet d,
                C.depth = D ∧ C.width = A₁.width + A₂.width ∧
                ∀ x : Fin d → ℝ, C.realize x = a * A₁.realize x + b * A₂.realize x := by
          intro A₁ A₂ D a b hA₁d hA₂d hDpos
          let w₁ : ℕ := A₁.width
          let w₂ : ℕ := A₂.width
          let W : ℕ := w₁ + w₂
          let in₁ : Fin w₁ → Fin W := fun i => Fin.castAdd w₂ i
          let in₂ : Fin w₂ → Fin W := fun i => Fin.natAdd w₁ i
          let w₁₁ : Fin (D - 1) → Fin w₁ → Fin w₁ → ℝ := fun k u v =>
            (A₁.hidden ⟨k.val, by simpa [hA₁d] using k.isLt⟩).weight u v
          let w₂₂ : Fin (D - 1) → Fin w₂ → Fin w₂ → ℝ := fun k u v =>
            (A₂.hidden ⟨k.val, by simpa [hA₂d] using k.isLt⟩).weight u v
          let WFun : Fin (D - 1) → Fin W → Fin W → ℝ := fun k u v =>
            Fin.addCases
              (fun u₁ : Fin w₁ =>
                Fin.addCases (fun v₁ : Fin w₁ => w₁₁ k u₁ v₁) (fun _ : Fin w₂ => 0) v)
              (fun u₂ : Fin w₂ =>
                Fin.addCases (fun _ : Fin w₁ => 0) (fun v₂ : Fin w₂ => w₂₂ k u₂ v₂) v) u
          let BFun : Fin (D - 1) → Fin W → ℝ := fun k u =>
            Fin.addCases
              (fun u₁ : Fin w₁ => (A₁.hidden ⟨k.val, by simpa [hA₁d] using k.isLt⟩).bias u₁)
              (fun u₂ : Fin w₂ => (A₂.hidden ⟨k.val, by simpa [hA₂d] using k.isLt⟩).bias u₂) u
          let hidLayer : Fin (D - 1) → DenseLayer W W := fun k =>
            { weight := WFun k, bias := BFun k }
          let Ninput : DenseLayer d W :=
            { weight := fun u j =>
                Fin.addCases
                  (fun u₁ : Fin w₁ => A₁.input.weight u₁ j)
                  (fun u₂ : Fin w₂ => A₂.input.weight u₂ j) u
              bias := fun u =>
                Fin.addCases
                  (fun u₁ : Fin w₁ => A₁.input.bias u₁)
                  (fun u₂ : Fin w₂ => A₂.input.bias u₂) u }
          let Noutput : Fin W → ℝ := fun u =>
            Fin.addCases
              (fun u₁ : Fin w₁ => a * A₁.outputWeight u₁)
              (fun u₂ : Fin w₂ => b * A₂.outputWeight u₂) u
          let C : FullyConnectedReLUNet d :=
            { depth := D, width := W, input := Ninput, hidden := hidLayer,
              outputWeight := Noutput, outputBias := a * A₁.outputBias + b * A₂.outputBias }
          refine ⟨C, rfl, rfl, ?_⟩
          intro x
          have hNapply₁ : ∀ u₁ : Fin w₁, C.input.apply x (in₁ u₁) = A₁.input.apply x u₁ := by
            intro u₁
            simp [C, Ninput, DenseLayer.apply, in₁, Fin.addCases_left]
          have hNapply₂ : ∀ u₂ : Fin w₂, C.input.apply x (in₂ u₂) = A₂.input.apply x u₂ := by
            intro u₂
            simp [C, Ninput, DenseLayer.apply, in₂, Fin.addCases_right]
          have hsum2 : ∀ F : Fin W → ℝ,
              (∑ v : Fin W, F v) =
                (∑ v₁ : Fin w₁, F (in₁ v₁)) + (∑ v₂ : Fin w₂, F (in₂ v₂)) := by
            intro F
            change (∑ v : Fin (w₁ + w₂), F v) =
              (∑ v₁ : Fin w₁, F (in₁ v₁)) + (∑ v₂ : Fin w₂, F (in₂ v₂))
            rw [Fin.sum_univ_add]
          have hw₁₁ : ∀ (k : Fin (D - 1)) (u₁ v₁ : Fin w₁),
              (hidLayer k).weight (in₁ u₁) (in₁ v₁) = w₁₁ k u₁ v₁ := by
            intro k u₁ v₁
            simp [hidLayer, WFun, in₁, Fin.addCases_left]
          have hw₁₂ : ∀ (k : Fin (D - 1)) (u₁ : Fin w₁) (v₂ : Fin w₂),
              (hidLayer k).weight (in₁ u₁) (in₂ v₂) = 0 := by
            intro k u₁ v₂
            simp [hidLayer, WFun, in₁, in₂, Fin.addCases_left, Fin.addCases_right]
          have hw₂₁ : ∀ (k : Fin (D - 1)) (u₂ : Fin w₂) (v₁ : Fin w₁),
              (hidLayer k).weight (in₂ u₂) (in₁ v₁) = 0 := by
            intro k u₂ v₁
            simp [hidLayer, WFun, in₂, in₁, Fin.addCases_left, Fin.addCases_right]
          have hw₂₂ : ∀ (k : Fin (D - 1)) (u₂ v₂ : Fin w₂),
              (hidLayer k).weight (in₂ u₂) (in₂ v₂) = w₂₂ k u₂ v₂ := by
            intro k u₂ v₂
            simp [hidLayer, WFun, in₂, Fin.addCases_left, Fin.addCases_right]
          have hbias₁ : ∀ (k : Fin (D - 1)) (u₁ : Fin w₁),
              (hidLayer k).bias (in₁ u₁) =
                (A₁.hidden ⟨k.val, by simpa [hA₁d] using k.isLt⟩).bias u₁ := by
            intro k u₁
            simp [hidLayer, BFun, in₁, Fin.addCases_left]
          have hbias₂ : ∀ (k : Fin (D - 1)) (u₂ : Fin w₂),
              (hidLayer k).bias (in₂ u₂) =
                (A₂.hidden ⟨k.val, by simpa [hA₂d] using k.isLt⟩).bias u₂ := by
            intro k u₂
            simp [hidLayer, BFun, in₂, Fin.addCases_right]
          have hcarry : ∀ k : ℕ, k ≤ D - 1 →
              (∀ u₁ : Fin w₁, C.hiddenState x k (in₁ u₁) = A₁.hiddenState x k u₁) ∧
              (∀ u₂ : Fin w₂, C.hiddenState x k (in₂ u₂) = A₂.hiddenState x k u₂) := by
            intro k
            induction' k with k ih
            · intro hk
              constructor
              · intro u₁
                simp [C, Ninput, FullyConnectedReLUNet.hiddenState, DenseLayer.apply,
                  DenseLayer.reluApply, reluVec, in₁, Fin.addCases_left, hNapply₁]
              · intro u₂
                simp [C, Ninput, FullyConnectedReLUNet.hiddenState, DenseLayer.apply,
                  DenseLayer.reluApply, reluVec, in₂, Fin.addCases_right, hNapply₂]
            · intro hk1
              have hk : k ≤ D - 1 := by omega
              rcases ih hk with ⟨ih₁, ih₂⟩
              have hk_lt : k < D - 1 := by omega
              have hk_lt₁ : k < A₁.depth - 1 := by simpa [hA₁d] using hk_lt
              have hk_lt₂ : k < A₂.depth - 1 := by simpa [hA₂d] using hk_lt
              have hk_lt_C : k < C.depth - 1 := by simpa [C] using hk_lt
              constructor
              · intro u₁
                calc
                  C.hiddenState x (k + 1) (in₁ u₁) =
                      (C.hidden ⟨k, hk_lt_C⟩).reluApply (C.hiddenState x k) (in₁ u₁) := by
                    simp [FullyConnectedReLUNet.hiddenState, hk_lt_C]
                  _ = relu ((C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (in₁ u₁)) := by
                    rfl
                  _ = relu ((A₁.hidden ⟨k, hk_lt₁⟩).apply (A₁.hiddenState x k) u₁) := by
                    congr 1
                    calc
                      (C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (in₁ u₁)
                          = (∑ v : Fin W,
                              (C.hidden ⟨k, hk_lt_C⟩).weight (in₁ u₁) v *
                                C.hiddenState x k v) +
                              (C.hidden ⟨k, hk_lt_C⟩).bias (in₁ u₁) := by rfl
                      _ = (∑ v₁ : Fin w₁,
                              (A₁.hidden ⟨k, hk_lt₁⟩).weight u₁ v₁ *
                                A₁.hiddenState x k v₁) +
                              (A₁.hidden ⟨k, hk_lt₁⟩).bias u₁ := by
                        rw [hsum2]
                        simp [C, hw₁₁, w₁₁, hw₁₂, hbias₁, ih₁, ih₂, add_assoc]
                      _ = (A₁.hidden ⟨k, hk_lt₁⟩).apply (A₁.hiddenState x k) u₁ := by
                        rfl
                  _ = A₁.hiddenState x (k + 1) u₁ := by
                    simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hk_lt₁]
              · intro u₂
                calc
                  C.hiddenState x (k + 1) (in₂ u₂) =
                      (C.hidden ⟨k, hk_lt_C⟩).reluApply (C.hiddenState x k) (in₂ u₂) := by
                    simp [FullyConnectedReLUNet.hiddenState, hk_lt_C]
                  _ = relu ((C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (in₂ u₂)) := by
                    rfl
                  _ = relu ((A₂.hidden ⟨k, hk_lt₂⟩).apply (A₂.hiddenState x k) u₂) := by
                    congr 1
                    calc
                      (C.hidden ⟨k, hk_lt_C⟩).apply (C.hiddenState x k) (in₂ u₂)
                          = (∑ v : Fin W,
                              (C.hidden ⟨k, hk_lt_C⟩).weight (in₂ u₂) v *
                                C.hiddenState x k v) +
                              (C.hidden ⟨k, hk_lt_C⟩).bias (in₂ u₂) := by rfl
                      _ = (∑ v₂ : Fin w₂,
                              (A₂.hidden ⟨k, hk_lt₂⟩).weight u₂ v₂ *
                                A₂.hiddenState x k v₂) +
                              (A₂.hidden ⟨k, hk_lt₂⟩).bias u₂ := by
                        rw [hsum2]
                        simp [C, hw₂₁, hw₂₂, w₂₂, hbias₂, ih₁, ih₂, add_assoc]
                      _ = (A₂.hidden ⟨k, hk_lt₂⟩).apply (A₂.hiddenState x k) u₂ := by
                        rfl
                  _ = A₂.hiddenState x (k + 1) u₂ := by
                    simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, hk_lt₂]
          rcases hcarry (D - 1) (by omega) with ⟨hcar₁, hcar₂⟩
          have hA₁_realize :
              A₁.realize x =
                (∑ v₁ : Fin w₁, A₁.outputWeight v₁ * A₁.hiddenState x (D - 1) v₁) +
                  A₁.outputBias := by
            rw [FullyConnectedReLUNet.realize, hA₁d]
          have hA₂_realize :
              A₂.realize x =
                (∑ v₂ : Fin w₂, A₂.outputWeight v₂ * A₂.hiddenState x (D - 1) v₂) +
                  A₂.outputBias := by
            rw [FullyConnectedReLUNet.realize, hA₂d]
          calc
            C.realize x =
                (∑ j : Fin W, C.outputWeight j * C.hiddenState x (C.depth - 1) j) +
                  C.outputBias := by
              rfl
            _ = (∑ j : Fin W, C.outputWeight j * C.hiddenState x (D - 1) j) +
                  (a * A₁.outputBias + b * A₂.outputBias) := by
              simp [C]
            _ = (∑ v₁ : Fin w₁,
                    (a * A₁.outputWeight v₁) * A₁.hiddenState x (D - 1) v₁) +
                  (∑ v₂ : Fin w₂,
                    (b * A₂.outputWeight v₂) * A₂.hiddenState x (D - 1) v₂) +
                  (a * A₁.outputBias + b * A₂.outputBias) := by
              rw [hsum2]
              simp [C, Noutput, in₁, in₂, Fin.addCases_left, Fin.addCases_right,
                hcar₁, hcar₂, add_assoc]
            _ = a * A₁.realize x + b * A₂.realize x := by
              rw [hA₁_realize, hA₂_realize]
              rw [mul_add, mul_add]
              rw [Finset.mul_sum, Finset.mul_sum]
              simp only [mul_assoc]
              ring
        have hfold :
            ∀ t : Finset ι, t ⊆ s →
              ∃ M : FullyConnectedReLUNet d,
                M.depth = T ∧
                0 < M.depth ∧
                M.depth ≤ T ∧
                M.width = ∑ r ∈ t, (B r).width ∧
                ∀ x : Fin d → ℝ,
                  M.realize x = finiteLinearCombination t coeff (fun r y => (A r).realize y) x := by
          intro t
          refine Finset.induction_on t ?base ?step
          · intro hts
            let Z : FullyConnectedReLUNet d :=
              { depth := T
                width := 0
                input := { weight := 0, bias := 0 }
                hidden := fun _ => ({ weight := 0, bias := 0 } : DenseLayer 0 0)
                outputWeight := 0
                outputBias := 0 }
            refine ⟨Z, rfl, ?_, ?_, ?_, ?_⟩
            · simpa [Z] using hT_pos
            · simp [Z]
            · simp [Z]
            · intro x
              simp [Z, FullyConnectedReLUNet.realize, finiteLinearCombination]
          · intro r t hnot hrec hts
            have ht_sub : t ⊆ s := by
              intro u hu
              exact hts (Finset.mem_insert_of_mem hu)
            have hr_mem : r ∈ s := hts (Finset.mem_insert_self r t)
            rcases hrec ht_sub with ⟨M, hMd, hMpos, hMle, hMw, hMreal⟩
            rcases hcomb2 (B r) M T (coeff r) (1 : ℝ)
                (hB_depth r hr_mem) hMd hT_pos with
              ⟨N, hNd, hNw, hNreal⟩
            refine ⟨N, hNd, ?_, ?_, ?_, ?_⟩
            · rw [hNd]
              exact hT_pos
            · rw [hNd]
            · calc
                N.width = (B r).width + M.width := hNw
                _ = (B r).width + ∑ u ∈ t, (B u).width := by rw [hMw]
                _ = ∑ u ∈ insert r t, (B u).width := by
                  rw [Finset.sum_insert hnot]
            · intro x
              rw [hNreal x, hMreal x, hB_real r hr_mem x]
              simp [finiteLinearCombination, Finset.sum_insert hnot]
        exact hfold s (fun r hr => hr)

      rcases h_block with ⟨N, hN_depth_eq, hN_pos, hN_depth, hN_width, hN_real⟩
      -- @step s3: Verify N.width ≤ finiteCenteredMonomialPolynomialWidthBound n s degree from
      --   hN_width, hB_width, hA_width and definition E6.
      have h_width : N.width ≤ finiteCenteredMonomialPolynomialWidthBound n s degree := by
        calc
          N.width = ∑ r ∈ s, (B r).width := hN_width
          _ = ∑ r ∈ s, (A r).width := by
            exact Finset.sum_congr rfl (fun r hr => hB_width r hr)
          _ ≤ ∑ r ∈ s, centeredMonomialWidthBound n (degree r) := by
            exact Finset.sum_le_sum (fun r hr => hA_width r hr)
          _ = finiteCenteredMonomialPolynomialWidthBound n s degree := by
            rfl
      -- @step s4: Verify N.parameterCount ≤ finiteCenteredMonomialPolynomialParameterBound d n s degree
      --   from hN_depth_eq, hN_width, E7 and E11 (monotonicity of the parameter-count formula).
      have h_param :
          N.parameterCount ≤ finiteCenteredMonomialPolynomialParameterBound d n s degree := by
        rw [FullyConnectedReLUNet.parameterCount, finiteCenteredMonomialPolynomialParameterBound]
        rw [hN_depth_eq]
        change fullyConnectedReLUParameterCount d T N.width ≤
          fullyConnectedReLUParameterCount d T (finiteCenteredMonomialPolynomialWidthBound n s degree)
        unfold fullyConnectedReLUParameterCount
        gcongr
      -- @step s5: Verify the final error bound on the centered box from hN_real, the per-monomial
      --   error bounds hA_err, and definition E5.
      have h_err :
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |N.realize x -
                finiteLinearCombination s coeff
                  (fun r : ι => fun y : Fin d → ℝ =>
                    ∏ q : Fin (degree r), (y (coord r q) - center (coord r q))) x| ≤
              finiteCenteredMonomialPolynomialApproxError R n s coeff degree := by
        intro x hx_box
        rw [hN_real x]
        simp only [finiteLinearCombination]
        rw [← Finset.sum_sub_distrib]
        have hfactor :
            (∑ r ∈ s, (coeff r * (A r).realize x - coeff r * ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))) =
              ∑ r ∈ s, coeff r * ((A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))) := by
          apply Finset.sum_congr rfl
          intro r hr
          ring
        rw [hfactor]
        calc
          |∑ r ∈ s, coeff r * ((A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))| ≤
              ∑ r ∈ s, |coeff r * ((A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))| := by
            exact Finset.abs_sum_le_sum_abs
              (fun r => coeff r * ((A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q)))) s
          _ = ∑ r ∈ s, |coeff r| * |(A r).realize x - ∏ q : Fin (degree r), (x (coord r q) - center (coord r q))| := by
            simp [abs_mul]
          _ ≤ ∑ r ∈ s, |coeff r| * centeredMonomialApproxError R n (degree r) := by
            apply Finset.sum_le_sum
            intro r hr
            exact mul_le_mul_of_nonneg_left (hA_err r hr x hx_box) (abs_nonneg (coeff r))
          _ = finiteCenteredMonomialPolynomialApproxError R n s coeff degree := by
            rfl
      -- @step fin: h_s5 is exactly the assembled conjunction of the four bounds.
      exact ⟨N, hN_pos, hN_depth, h_width, h_param, h_err⟩
  -- @step fin: h_s5 states exactly the theorem's conclusion.
  exact h_s5

theorem exists_fullyConnectedReLUNet_taylor_polynomial_approx_on_centered_box_with_size_bound
    {d r n : ℕ} (hd : 0 < d) (hn : 0 < n) {R : ℝ} (hR : 0 < R)
    (f : (Fin d → ℝ) → ℝ) (center : Fin d → ℝ) :
      ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧
        N.depth ≤
          finiteCenteredMonomialPolynomialDepthBound
            (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) ∧
        N.width ≤
          finiteCenteredMonomialPolynomialWidthBound n
            (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) ∧
        N.parameterCount ≤
