    fun i => (hgnet i).1
  have hmem_D : ∀ i, i ∈ s → gnet i ∈ reluNetworkClass d D (Wmono i) (Pnet i) := by
    intro i hi
    rcases hgnet_mem i with ⟨N, hNpos, hNdepth, hNwidth, hNparam, hNrealize⟩
    refine ⟨N, hNpos, le_trans hNdepth (hDnet_le_D i hi), hNwidth, hNparam,
      hNrealize⟩
  have hε_nonneg : ∀ r ∈ s,
      0 ≤ centeredMonomialFixedWidthApproxError cMulErr R n (degree r) := by
    intro r hr
    rcases (hcDi_spec r).2.2 n hn R hR center (coord r) with
      ⟨Dr, Pr, hDr_pos, hDr_le, hPr_eq, gr, hgr_mem, hgr_err⟩
    exact le_trans
      (abs_nonneg
        (gr center - ∏ q : Fin (degree r), (center (coord r q) - center (coord r q))))
      (hgr_err center (fun q : Fin d => by simpa using (le_of_lt hR)))
  have hWsum_le_Wpoly : s.sum (fun r => Wmono r) ≤ Wpoly := by
    calc
      s.sum (fun r => Wmono r) =
          s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r)) := by
        exact Finset.sum_congr rfl (fun r hr => (hWmono_spec r).2.1)
      _ ≤ max 1 (s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r))) := by
        exact Nat.le_max_right 1
          (s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r)))
      _ = Wpoly := by
        rfl
  have hparamW_mono : ∀ {W1 W2 : ℕ}, W1 ≤ W2 →
      fullyConnectedReLUParameterCount d D W1 ≤ fullyConnectedReLUParameterCount d D W2 := by
    intro W1 W2 hW
    unfold fullyConnectedReLUParameterCount
    have hA : (d + 1) * W1 ≤ (d + 1) * W2 := Nat.mul_le_mul (le_refl (d + 1)) hW
    have hB : (W1 + 1) * W1 ≤ (W2 + 1) * W2 := by
      calc
        (W1 + 1) * W1 = W1 * W1 + W1 := by ring
        _ ≤ W2 * W2 + W2 := by
          exact Nat.add_le_add (Nat.mul_le_mul hW hW) hW
        _ = (W2 + 1) * W2 := by ring
    have hC : (D - 1) * ((W1 + 1) * W1) ≤ (D - 1) * ((W2 + 1) * W2) :=
      Nat.mul_le_mul (le_refl (D - 1)) hB
    have hD1 : W1 + 1 ≤ W2 + 1 := Nat.succ_le_succ hW
    exact Nat.add_le_add (Nat.add_le_add hA hC) hD1
  have hparamW : fullyConnectedReLUParameterCount d D (s.sum (fun r => Wmono r)) ≤
      fullyConnectedReLUParameterCount d D Wpoly := by
    exact hparamW_mono hWsum_le_Wpoly
  refine finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
    (d := d) (D := D) (widthBudget := Wpoly)
    (parameterBudget := fullyConnectedReLUParameterCount d D Wpoly)
    (P := fun x => ∀ q : Fin d, |x q - center q| ≤ R)
    hD_pos s coeff
    (fun i y => ∏ q : Fin (degree i), (y (coord i q) - center (coord i q)))
    gnet (fun i => centeredMonomialFixedWidthApproxError cMulErr R n (degree i))
    (fun i => Wmono i) (fun i => Pnet i)
    hε_nonneg hmem_D hWsum_le_Wpoly hparamW
    (fun r hr x hx => (hgnet r).2 x hx)

/-- Compatibility form of
`exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_from_mul_gadget_explicit`
that leaves the depth constant abstract. -/
theorem exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_from_mul_gadget
    {ι : Type*} [DecidableEq ι]
    {d Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (s : Finset ι) (degree : ι → ℕ)
    (coord : (i : ι) → Fin (degree i) → Fin d) (coeff : ι → ℝ) :
    ∃ Wpoly : ℕ,
      0 < Wpoly ∧
      Wpoly = finiteCenteredMonomialPolynomialFixedWidthBound Wmul s degree ∧
      ∃ cDepth : ℝ,
        0 < cDepth ∧
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
        ∀ center : Fin d → ℝ,
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wpoly ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D Wpoly P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x -
                      finiteLinearCombination s coeff
                        (fun i : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree i),
                            (y (coord i q) - center (coord i q))) x| ≤
                      finiteCenteredMonomialPolynomialFixedWidthApproxError
                        cMulErr R n s coeff degree := by
  rcases
      exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_from_mul_gadget_explicit
        hWmul hcMulDepth hcMulErr hmul s degree coord coeff with
    ⟨Wpoly, hWpoly, hWpoly_eq, cDepth, hcDepth, _hcDepth_eq, happrox⟩
  exact ⟨Wpoly, hWpoly, hWpoly_eq, cDepth, hcDepth, happrox⟩

/-- Uniform-coefficient fixed-width finite centered-monomial polynomial approximation. -/
theorem exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_uniform_coeff_bound_from_mul_gadget
    {ι : Type*} [DecidableEq ι]
    {d Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (s : Finset ι) (degree : ι → ℕ)
    (coord : (i : ι) → Fin (degree i) → Fin d) :
    ∃ Wpoly : ℕ,
      0 < Wpoly ∧
      Wpoly = finiteCenteredMonomialPolynomialFixedWidthBound Wmul s degree ∧
      ∃ cDepth : ℝ,
        0 < cDepth ∧
        ∀ coeff : ι → ℝ,
        ∀ A R : ℝ, 0 ≤ A → 0 < R →
        (∀ i : ι, i ∈ s → |coeff i| ≤ A) →
        ∀ n : ℕ, 0 < n →
        ∀ center : Fin d → ℝ,
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wpoly ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D Wpoly P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x -
                      finiteLinearCombination s coeff
                        (fun i : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree i),
                            (y (coord i q) - center (coord i q))) x| ≤
                      A * s.sum
                        (fun i : ι =>
                          centeredMonomialFixedWidthApproxError
                            cMulErr R n (degree i)) := by
  classical
  -- Per-degree monomial constants chosen before `coeff` is introduced.
  have hmono : ∀ i : ι,
      ∃ Wmono : ℕ, 0 < Wmono ∧ Wmono = centeredMonomialFixedWidthBound Wmul (degree i) ∧
      ∃ cDi : ℝ, 0 < cDi ∧
        ∀ (n : ℕ), 0 < n → ∀ (R : ℝ), 0 < R → ∀ (center : Fin d → ℝ),
        ∃ D P : ℕ, 0 < D ∧ (D : ℝ) ≤ cDi * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
          P = fullyConnectedReLUParameterCount d D Wmono ∧
          ∃ g : (Fin d → ℝ) → ℝ, g ∈ reluNetworkClass d D Wmono P ∧
            ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
              |g x - ∏ q : Fin (degree i), (x (coord i q) - center (coord i q))| ≤
                centeredMonomialFixedWidthApproxError cMulErr R n (degree i) := by
    intro i
    rcases exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget
        (k := degree i) hWmul hcMulDepth hcMulErr hmul with
      ⟨Wmono, hWmono_pos, hWmono_eq, cDi, hcDi_pos, hspec⟩
    refine ⟨Wmono, hWmono_pos, hWmono_eq, cDi, hcDi_pos, ?_⟩
    intro n hn R hR center
    rcases hspec n hn R hR center (coord i) with ⟨D, P, hDpos, hDle, hPeq, g, hgmem, hgerr⟩
    refine ⟨D, P, hDpos, ?_, hPeq, g, hgmem, ?_⟩
    · exact hDle
    · exact hgerr
  let Wmono : ι → ℕ := fun i => Classical.choose (hmono i)
  let cDi : ι → ℝ := fun i => Classical.choose (Classical.choose_spec (hmono i)).2.2
  have hWmono_eq : ∀ i : ι, Wmono i = centeredMonomialFixedWidthBound Wmul (degree i) := by
    intro i
    exact (Classical.choose_spec (hmono i)).2.1
  have hcDi_pos : ∀ i : ι, 0 < cDi i := by
    intro i
    exact (Classical.choose_spec (Classical.choose_spec (hmono i)).2.2).1
  have hcDi_spec : ∀ i : ι,
      ∀ (n : ℕ), 0 < n → ∀ (R : ℝ), 0 < R → ∀ (center : Fin d → ℝ),
      ∃ D P : ℕ, 0 < D ∧ (D : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (Wmono i) ∧
        ∃ g : (Fin d → ℝ) → ℝ, g ∈ reluNetworkClass d D (Wmono i) P ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |g x - ∏ q : Fin (degree i), (x (coord i q) - center (coord i q))| ≤
              centeredMonomialFixedWidthApproxError cMulErr R n (degree i) := by
    intro i n hn R hR center
    exact (Classical.choose_spec (Classical.choose_spec (hmono i)).2.2).2 n hn R hR center
  let Wpoly : ℕ := finiteCenteredMonomialPolynomialFixedWidthBound Wmul s degree
  let cDepth : ℝ := 1 + s.sum (fun i => cDi i * ((degree i : ℝ) + 1))
  have hcDepth_pos : 0 < cDepth := by
    dsimp [cDepth]
    have hS : 0 ≤ s.sum (fun i => cDi i * ((degree i : ℝ) + 1)) := by
      exact Finset.sum_nonneg (fun i hi => mul_nonneg (le_of_lt (hcDi_pos i)) (by positivity : 0 ≤ (degree i : ℝ) + 1))
    nlinarith
  have hWpoly_pos : 0 < Wpoly := by
    dsimp [Wpoly]
    rw [finiteCenteredMonomialPolynomialFixedWidthBound]
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left 1 _)
  refine ⟨Wpoly, hWpoly_pos, rfl, cDepth, hcDepth_pos, ?_⟩
  intro coeff A R hA hR hcoeff n hn center
  have hε_nonneg : ∀ m : ℕ, 0 ≤ centeredMonomialFixedWidthApproxError cMulErr R n m := by
    intro m
    induction m with
    | zero => simp [centeredMonomialFixedWidthApproxError]
    | succ m ih =>
        cases m with
        | zero => simp [centeredMonomialFixedWidthApproxError]
        | succ m' =>
            simp [centeredMonomialFixedWidthApproxError]
            have hB : 0 ≤ R ^ (m' + 1) + centeredMonomialFixedWidthApproxError cMulErr R n (m' + 1) + R + 1 := by
              have hR0 : 0 ≤ R := le_of_lt hR
              have hRp : 0 ≤ R ^ (m' + 1) := pow_nonneg hR0 _
              nlinarith
            have hc : 0 ≤ cMulErr := le_of_lt hcMulErr
            have hrpow : 0 ≤ (↑n ^ 2 : ℝ)⁻¹ := inv_nonneg.mpr (sq_nonneg _)
            have hsq : 0 ≤ (R ^ (m' + 1) + centeredMonomialFixedWidthApproxError cMulErr R n (m' + 1) + R + 1) ^ 2 := sq_nonneg _
            have hprod1 : 0 ≤ cMulErr * (R ^ (m' + 1) + centeredMonomialFixedWidthApproxError cMulErr R n (m' + 1) + R + 1) ^ 2 * (↑n ^ 2 : ℝ)⁻¹ := by
              exact mul_nonneg (mul_nonneg hc hsq) hrpow
            have hprod2 : 0 ≤ (R ^ (m' + 1) + centeredMonomialFixedWidthApproxError cMulErr R n (m' + 1) + R + 1) * centeredMonomialFixedWidthApproxError cMulErr R n (m' + 1) := by
              exact mul_nonneg hB ih
            exact add_nonneg hprod1 hprod2
  let ε : ι → ℝ := fun i => centeredMonomialFixedWidthApproxError cMulErr R n (degree i)
  have hmono_net : ∀ i : ι,
      ∃ D P : ℕ, ∃ g : (Fin d → ℝ) → ℝ,
        0 < D ∧ (D : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (Wmono i) ∧
        g ∈ reluNetworkClass d D (Wmono i) P ∧
          ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
            |g x - ∏ q : Fin (degree i), (x (coord i q) - center (coord i q))| ≤ ε i := by
    intro i
    rcases hcDi_spec i n hn R hR center with ⟨D, P, hDpos, hDle, hPeq, g, hgmem, hgerr⟩
    exact ⟨D, P, g, hDpos, hDle, hPeq, hgmem, hgerr⟩
  choose D_i P_i g_i hprops using hmono_net
  let D : ℕ := s.sum (fun i => D_i i) + 1
  have hD_pos : 0 < D := by
    dsimp [D]
    exact Nat.succ_pos _
  have hpromote : ∀ {D1 D2 W P : ℕ} {g : (Fin d → ℝ) → ℝ},
      D1 ≤ D2 → g ∈ reluNetworkClass d D1 W P → g ∈ reluNetworkClass d D2 W P := by
    intro D1 D2 W P g hle hg
    rcases hg with ⟨N, hNpos, hNd, hNw, hNp, hNr⟩
    exact ⟨N, hNpos, le_trans hNd hle, hNw, hNp, hNr⟩
  have hDi_le_D : ∀ i : ι, i ∈ s → D_i i ≤ D := by
    intro i hi
    dsimp [D]
    exact le_trans (Finset.single_le_sum (fun j hj => Nat.zero_le (D_i j)) hi) (Nat.le_add_right _ 1)
  have hmem : ∀ r : ι, r ∈ s → g_i r ∈ reluNetworkClass d D (Wmono r) (P_i r) := by
    intro r hr
    exact hpromote (hDi_le_D r hr) (hprops r).2.2.2.1
  have hwidth : s.sum (fun r => Wmono r) ≤ Wpoly := by
    dsimp [Wpoly]
    rw [finiteCenteredMonomialPolynomialFixedWidthBound]
    have hcong : s.sum (fun r => Wmono r) = s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r)) := by
      exact Finset.sum_congr rfl (fun r hr => hWmono_eq r)
    rw [hcong]
    exact le_max_right 1 (s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r)))
  have hparam_mono : ∀ {w1 w2 : ℕ}, w1 ≤ w2 →
      fullyConnectedReLUParameterCount d D w1 ≤ fullyConnectedReLUParameterCount d D w2 := by
    intro w1 w2 hw
    dsimp [fullyConnectedReLUParameterCount]
    have h1 : (d + 1) * w1 ≤ (d + 1) * w2 := Nat.mul_le_mul_left (d + 1) hw
    have h2 : (D - 1) * ((w1 + 1) * w1) ≤ (D - 1) * ((w2 + 1) * w2) := by
      apply Nat.mul_le_mul_left
      exact Nat.mul_le_mul (Nat.succ_le_succ hw) hw
    have h3 : w1 + 1 ≤ w2 + 1 := Nat.succ_le_succ hw
    omega
  have hparam : fullyConnectedReLUParameterCount d D (s.sum (fun r => Wmono r)) ≤
      fullyConnectedReLUParameterCount d D Wpoly := by
    exact hparam_mono hwidth
  have hDepth : (D : ℝ) ≤ cDepth * ((n : ℝ) + 1) := by
    let S : ℝ := s.sum (fun i => cDi i * ((degree i : ℝ) + 1))
    have hsum : (s.sum (fun i => D_i i) : ℝ) ≤ S * ((n : ℝ) + 1) := by
      calc
        (s.sum (fun i => D_i i) : ℝ) = s.sum (fun i => (D_i i : ℝ)) := by
          rfl
        _ ≤ s.sum (fun i => cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1)) := by
          exact Finset.sum_le_sum (fun i hi => (hprops i).2.1)
        _ = S * ((n : ℝ) + 1) := by
          dsimp [S]
          rw [Finset.sum_mul]
    have h1 : (1 : ℝ) ≤ (n : ℝ) + 1 := by
      have hn' : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
      nlinarith
    dsimp [D, cDepth, S]
    push_cast
    nlinarith [hsum, h1]
  rcases finite_linear_combination_reluNetworkClass_approximation_bound_from_class_members
      (d := d) (D := D) (widthBudget := Wpoly)
      (parameterBudget := fullyConnectedReLUParameterCount d D Wpoly)
      (P := fun x : Fin d → ℝ => ∀ q : Fin d, |x q - center q| ≤ R)
      hD_pos s coeff
      (fun i : ι => fun y : Fin d → ℝ => ∏ q : Fin (degree i), (y (coord i q) - center (coord i q)))
      g_i ε Wmono P_i
      (fun r hr => hε_nonneg (degree r))
      hmem hwidth hparam
      (fun r hr x hx => (hprops r).2.2.2.2 x hx)
    with ⟨g, hgmem, hgerr⟩
  refine ⟨D, fullyConnectedReLUParameterCount d D Wpoly, hD_pos, hDepth, rfl, g, hgmem, ?_⟩
  intro x hx
  have hsum_le : s.sum (fun r => |coeff r| * ε r) ≤ A * s.sum ε := by
    calc
      s.sum (fun r => |coeff r| * ε r) ≤ s.sum (fun r => A * ε r) := by
        exact Finset.sum_le_sum (fun r hr => mul_le_mul_of_nonneg_right (hcoeff r hr) (hε_nonneg (degree r)))
      _ = A * s.sum ε := by
        rw [Finset.mul_sum]
  exact le_trans (hgerr x hx) hsum_le

/-- Unit-radius fixed-width centered-monomial error sum has a quadratic resolution bound. -/
theorem exists_centeredMonomialFixedWidthApproxError_unit_radius_sigma_sum_quadratic_bound
    {d r : ℕ} {cMulErr : ℝ}
    (hcMulErr_nonneg : 0 ≤ cMulErr) :
    ∃ cErr : ℝ, 0 ≤ cErr ∧
      ∀ n : ℕ, 0 < n →
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n a.1.val) ≤
          cErr * (n : ℝ).rpow (-2 : ℝ) := by
  -- @step s1: for every degree k : Fin (r+1) there is a nonnegative C_k bounding the error by C_k * n^(-2), by induction on k
  have h_per_degree : ∀ k : Fin (r + 1), ∃ C : ℝ, 0 ≤ C ∧
      ∀ n : ℕ, 0 < n →
        Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n k.val ≤
          C * (n : ℝ).rpow (-2 : ℝ) := by
    -- @step s1: prove the recursion identity err (m+2) = cMulErr * (3 + err (m+1))^2 * n^(-2) + (3 + err (m+1)) * err (m+1)
    have h_rec : ∀ (m n : ℕ),
        Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 2) =
          cMulErr * (3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 1)) ^ 2 *
              (n : ℝ).rpow (-2 : ℝ) +
            (3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 1)) *
              Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 1) := by
                intro m n
                simp [Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError]
                ring
    -- @step s2: prove the inductive step with C' := cMulErr * (3 + C)^2 + (3 + C) * C
    have h_step : ∀ (m : ℕ) (C : ℝ), 0 ≤ C →
        (∀ n : ℕ, 0 < n →
          Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 1) ≤ C * (n : ℝ).rpow (-2 : ℝ)) →
          0 ≤ cMulErr * (3 + C) ^ 2 + (3 + C) * C ∧
            ∀ n : ℕ, 0 < n →
              Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (m + 2) ≤
                (cMulErr * (3 + C) ^ 2 + (3 + C) * C) * (n : ℝ).rpow (-2 : ℝ) := by
                  intro m C hC hBd
                  -- s1: nonnegativity of the error for all degrees
                  have hErr_nonneg : ∀ (t n : ℕ), 0 ≤ Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n t := by
                    intro t
                    refine Nat.twoStepInduction (P := fun t => ∀ n : ℕ, 0 ≤ Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n t) ?_ ?_ ?_ t
                    · intro n
                      simp [Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError]
                    · intro n
                      simp [Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError]
                    · intro t' hh0 hh1 n
                      rw [h_rec t' n]
                      have hB : 0 ≤ 3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (t' + 1) := by
                        nlinarith [hh1 n]
                      have hp0 : 0 ≤ (n : ℝ).rpow (-2 : ℝ) := by
                        exact Real.rpow_nonneg (by exact_mod_cast (Nat.zero_le n)) (-2 : ℝ)
                      have hsq0 : 0 ≤ (3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (t' + 1)) ^ 2 := sq_nonneg _
                      have hp1 : 0 ≤ cMulErr * (3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (t' + 1)) ^ 2 := mul_nonneg hcMulErr_nonneg hsq0
                      have hp2 : 0 ≤ cMulErr * (3 + Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n (t' + 1)) ^ 2 * (n : ℝ).rpow (-2 : ℝ) := mul_nonneg hp1 hp0
