        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
          P = fullyConnectedReLUParameterCount d L W ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d L W P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ cRate *
                  (((L : ℝ) * (W : ℝ) ^ 2).rpow
                    (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  rcases exists_reluNetworkClass_mul_fixed_width_depth_rate_on_box with
    ⟨Wmul, hWmul_pos, cMulDepth, cMulErr, hMulDepth_pos, hMulErr_pos, hMulGadget⟩
  have hschedule :=
    exists_unitCube_two_scale_box_selector_budget_schedule_from_geometry_and_scalar_budgets
      (d := d) (r := r) (Wmul := Wmul) (beta := beta) (C := C)
      (cMulDepth := cMulDepth) (cMulErr := cMulErr)
      (hscalar Wmul hWmul_pos cMulDepth cMulErr hMulDepth_pos hMulErr_pos)
      hgeometry
  exact holderSmoothBall_unitCube_LW2_rate_from_box_selector_budget_schedule hd hWmul_pos
    hbeta_nonneg hsmooth_pos hC_nonneg hB_nonneg hMulDepth_pos hMulErr_pos hMulGadget hschedule


/-- Corrected box-selector route interface for the final LW2 display rate.

The earlier paper-block wrapper used a fixed `Dblock` envelope.  This theorem
uses the actual final-size condition instead: the schedule must prove directly
that the constructed network satisfies `D * W^2 <= cSize * M^d` and has
approximation error at most `cErr * M^(-2(r+beta))`.  This is the right
interface for a later concrete construction if local/product resolutions need
to be accounted for in the final `L W^2` budget.
-/
theorem holderSmoothBall_unitCube_LW2_rate_from_box_selector_general_scale_schedule
    {d r : ℕ} (hd : 0 < d)
    {beta C B : ℝ}
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC_nonneg : 0 ≤ C) (hB_nonneg : 0 ≤ B)
    (hschedule :
      ∀ Wmul : ℕ, 0 < Wmul →
      ∀ cMulDepth cMulErr : ℝ,
        0 < cMulDepth → 0 < cMulErr →
      ∀ Wlocal W0 : ℕ,
        0 < Wlocal →
        Wlocal =
          finiteCenteredMonomialPolynomialFixedWidthBound Wmul
            (Finset.univ :
              Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) →
        0 < W0 →
        W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 →
      ∀ cLocalDepth : ℝ, 0 < cLocalDepth →
      ∀ A : ℝ, 0 ≤ A →
        ∃ cSize cErr : ℝ, 0 < cSize ∧ 0 < cErr ∧
          ∀ M : ℕ, 0 < M →
            ∃ R rho localEps productRadius productDelta Rbox : ℝ,
            ∃ nLocal nMul : ℕ,
            ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
              0 ≤ rho ∧
              0 < R ∧
              0 < Rbox ∧
              0 < productRadius ∧
              1 ≤ productRadius ∧
              0 < nLocal ∧
              0 < nMul ∧
              cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤
                productDelta ∧
              0 ≤ productDelta ∧
              A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                + C / (Nat.factorial r : ℝ) *
                    Real.rpow rho ((r : ℝ) + beta) ≤
                  localEps ∧
              A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                + A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    R ^ a.1.val) ≤
                  productRadius ∧
              (∑ _ : Fin (M ^ d), productDelta) + localEps ≤
                cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) ∧
              (∀ j : Fin (M ^ d), ∀ q : Fin d,
                center j q ∈ Set.Icc (0 : ℝ) 1) ∧
              (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                ∀ q : Fin d, |x q - center j q| ≤ R) ∧
              (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                (∀ q : Fin d,
                  scale j q *
                    (relu (x q - center j q) + relu (center j q - x q)) < 1) →
                ‖x - center j‖ ≤ rho) ∧
              (∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                ∃ j0 : Fin (M ^ d),
                  axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
                  (∀ j : Fin (M ^ d), j ≠ j0 →
                    axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
                  (∀ q : Fin d,
                    scale j0 q *
                      (relu (x q - center j0 q) +
                        relu (center j0 q - x q)) < 1)) ∧
              (∀ Dlocal Dprod D : ℕ,
                0 < Dlocal →
                (Dlocal : ℝ) ≤ cLocalDepth * ((nLocal : ℝ) + 1) →
                0 < Dprod →
                (Dprod : ℝ) ≤
                  (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) →
                D ≤ (M ^ d + 1) * (Dprod + 1) →
                (D : ℝ) * (W0 : ℝ) ^ 2 ≤ cSize * (M : ℝ) ^ d)) :
    ∃ cRate : ℝ, 0 < cRate ∧
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
          P = fullyConnectedReLUParameterCount d L W ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d L W P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ cRate *
                  (((L : ℝ) * (W : ℝ) ^ 2).rpow
                    (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  -- Proof route (CSP): [E6] mul gadget -> [E8]+[E7] local table + Taylor bound A (define W0)
  -- -> instantiate hschedule -> per-M fixed-width construction (E8/E10/E11) -> [E5] final cRate.
  -- @step s1: multiplication gadget: Wmul > 0, cMulDepth > 0, cMulErr > 0 with universal mul-gadget hypothesis
  have h_mul_gadget :
      ∃ Wmul : ℕ, 0 < Wmul ∧
        ∃ cMulDepth cMulErr : ℝ, 0 < cMulDepth ∧ 0 < cMulErr ∧
          ∀ n : ℕ, 0 < n → ∀ R : ℝ, 0 < R →
            ∃ Dmul Pmul : ℕ, 0 < Dmul ∧ (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
              Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
              ∃ gmul : (Fin 2 → ℝ) → ℝ, gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
                ∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2) := by
                    exact Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.exists_reluNetworkClass_mul_fixed_width_depth_rate_on_box
  -- @step s2: local table: Wlocal > 0 with identity, cLocalDepth > 0, A >= 0, and W0 > 0 with defining identity
  have h_local :
      ∀ Wmul : ℕ, 0 < Wmul →
      ∀ cMulDepth cMulErr : ℝ, 0 < cMulDepth → 0 < cMulErr →
        (∀ n : ℕ, 0 < n → ∀ R : ℝ, 0 < R →
          ∃ Dmul Pmul : ℕ, 0 < Dmul ∧ (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
            Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
            ∃ gmul : (Fin 2 → ℝ) → ℝ, gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
                |gmul y - y 0 * y 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2)) →
        ∃ Wlocal : ℕ, 0 < Wlocal ∧
          Wlocal = finiteCenteredMonomialPolynomialFixedWidthBound Wmul
            (Finset.univ :
              Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) ∧
          ∃ cLocalDepth : ℝ, 0 < cLocalDepth ∧
          ∃ A : ℝ, 0 ≤ A ∧
          ∃ W0 : ℕ, 0 < W0 ∧ W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 := by
            intro Wmul hWmul cMulDepth cMulErr hcMulDepth hcMulErr hmul
            rcases Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.finite_holderSmooth_local_table_reluNetworkClass_fixed_width_active_cell_error_and_domain_output_bound_from_mul_gadget
                (d := d) (m := 1) (r := r) (Wmul := Wmul) hWmul hcMulDepth hcMulErr hmul with
              ⟨Wlocal, hWlocal_pos, hWlocal_id, cLocalDepth, hcLocalDepth, _⟩
            rcases Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.holderSmoothBall_unitCube_taylor_coefficients_admit_uniform_bound
                d r hbeta_nonneg hC_nonneg hB_nonneg with ⟨A, hA_nonneg, _⟩
            refine ⟨Wlocal, hWlocal_pos, hWlocal_id, cLocalDepth, hcLocalDepth, A, hA_nonneg, ?_⟩
            refine ⟨2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3, ?_, rfl⟩
            omega
  -- @step s3: instantiate hschedule with the witnesses from s1-s2 to obtain cSize > 0 and cErr > 0 with the full schedule
  have h_schedule :
      ∀ Wmul : ℕ, 0 < Wmul →
      ∀ cMulDepth cMulErr : ℝ, 0 < cMulDepth → 0 < cMulErr →
      ∀ Wlocal : ℕ, 0 < Wlocal →
        Wlocal = finiteCenteredMonomialPolynomialFixedWidthBound Wmul
          (Finset.univ :
            Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) →
      ∀ W0 : ℕ, 0 < W0 → W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 →
      ∀ cLocalDepth : ℝ, 0 < cLocalDepth →
      ∀ A : ℝ, 0 ≤ A →
        ∃ cSize cErr : ℝ, 0 < cSize ∧ 0 < cErr ∧
          ∀ M : ℕ, 0 < M →
            ∃ R rho localEps productRadius productDelta Rbox : ℝ,
            ∃ nLocal nMul : ℕ,
            ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
              0 ≤ rho ∧
              0 < R ∧
              0 < Rbox ∧
              0 < productRadius ∧
              1 ≤ productRadius ∧
              0 < nLocal ∧
              0 < nMul ∧
              cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤
                productDelta ∧
              0 ≤ productDelta ∧
              A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                + C / (Nat.factorial r : ℝ) *
                    Real.rpow rho ((r : ℝ) + beta) ≤
                  localEps ∧
              A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val)
                + A *
                  (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    R ^ a.1.val) ≤
                  productRadius ∧
              (∑ _ : Fin (M ^ d), productDelta) + localEps ≤
                cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) ∧
              (∀ j : Fin (M ^ d), ∀ q : Fin d,
                center j q ∈ Set.Icc (0 : ℝ) 1) ∧
              (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                ∀ q : Fin d, |x q - center j q| ≤ R) ∧
              (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ),
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                (∀ q : Fin d,
                  scale j q *
                    (relu (x q - center j q) + relu (center j q - x q)) < 1) →
                ‖x - center j‖ ≤ rho) ∧
              (∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                ∃ j0 : Fin (M ^ d),
                  axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
                  (∀ j : Fin (M ^ d), j ≠ j0 →
                    axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
                  (∀ q : Fin d,
                    scale j0 q *
                      (relu (x q - center j0 q) +
                        relu (center j0 q - x q)) < 1)) ∧
              (∀ Dlocal Dprod D : ℕ,
                0 < Dlocal →
                (Dlocal : ℝ) ≤ cLocalDepth * ((nLocal : ℝ) + 1) →
                0 < Dprod →
                (Dprod : ℝ) ≤
                  (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) →
                D ≤ (M ^ d + 1) * (Dprod + 1) →
                            (D : ℝ) * (W0 : ℝ) ^ 2 ≤ cSize * (M : ℝ) ^ d) := by
                intro Wmul hWmul_pos cMulDepth cMulErr hcMulDepth hcMulErr Wlocal hWlocal_pos hWlocal_id
                  W0 hW0_pos hW0_id cLocalDepth hcLocalDepth A hA_nonneg
                exact hschedule Wmul hWmul_pos cMulDepth cMulErr hcMulDepth hcMulErr Wlocal W0 hWlocal_pos
                  hWlocal_id hW0_pos hW0_id cLocalDepth hcLocalDepth A hA_nonneg
  -- @step s4: per-M fixed-width construction (E8/E10/E11): cDepth > 0 with the M-rate premise for E5
  have h_mrate :
      ∀ Wmul : ℕ, 0 < Wmul →
      ∀ cMulDepth cMulErr : ℝ, 0 < cMulDepth → 0 < cMulErr →
        (∀ n : ℕ, 0 < n → ∀ R : ℝ, 0 < R →
          ∃ Dmul Pmul : ℕ, 0 < Dmul ∧ (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
            Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
            ∃ gmul : (Fin 2 → ℝ) → ℝ, gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ, |y 0| ≤ R → |y 1| ≤ R →
                |gmul y - y 0 * y 1| ≤ cMulErr * R ^ 2 * (n : ℝ).rpow (-2)) →
        ∀ M : ℕ, 0 < M →
          ∃ W0 : ℕ, 0 < W0 ∧
          ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
            ∀ f : (Fin d → ℝ) → ℝ, f ∈ holderSmoothBall r beta C B →
              ∃ D P : ℕ,
                0 < D ∧ (D : ℝ) ≤ cDepth * (M : ℝ) ^ d ∧
                P = fullyConnectedReLUParameterCount d D W0 ∧
                ∃ g : (Fin d → ℝ) → ℝ, g ∈ reluNetworkClass d D W0 P ∧
                  ∀ x : Fin d → ℝ, (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤ cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
    intro Wmul hWmul_pos cMulDepth cMulErr hcMulDepth hcMulErr hmulGadget M hM_pos
    have hPC_mono : ∀ {d D D' W : ℕ}, D ≤ D' →
        fullyConnectedReLUParameterCount d D W ≤ fullyConnectedReLUParameterCount d D' W := by
      intro d D D' W hDD'
      have hmul : (D - 1) * ((W + 1) * W) ≤ (D' - 1) * ((W + 1) * W) := by
        exact Nat.mul_le_mul_right ((W + 1) * W) (by omega)
      unfold fullyConnectedReLUParameterCount
      nlinarith
    have h_relu_mono : ∀ {d D D' W W' P P' : ℕ}, D ≤ D' → W ≤ W' → P ≤ P' →
        ∀ g : (Fin d → ℝ) → ℝ, g ∈ reluNetworkClass d D W P → g ∈ reluNetworkClass d D' W' P' := by
      intro d D D' W W' P P' hD hW hP g hg
      simp [reluNetworkClass] at hg ⊢
      rcases hg with ⟨N, hNpos, hNdepth, hNwidth, hNpar, hNfun⟩
      exact ⟨N, hNpos, le_trans hNdepth hD, le_trans hNwidth hW, le_trans hNpar hP, hNfun⟩
    rcases (finite_holderSmooth_local_table_reluNetworkClass_fixed_width_active_cell_error_and_domain_output_bound_from_mul_gadget
        (d := d) (m := M ^ d) (r := r) (Wmul := Wmul) hWmul_pos hcMulDepth hcMulErr hmulGadget)
      with ⟨Wlocal, hWlocal_pos, hWlocal_id, cLocalDepth, hcLocalDepth, hlocalTable⟩
    rcases (holderSmoothBall_unitCube_taylor_coefficients_admit_uniform_bound d r hbeta_nonneg hC_nonneg hB_nonneg)
      with ⟨A, hA_nonneg, hA_coeff⟩
    let W0 : ℕ := 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3
    have hW0_pos : 0 < W0 := by
      dsimp [W0]
      omega
    have hW0_id : W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 := rfl
    rcases (hschedule Wmul hWmul_pos cMulDepth cMulErr hcMulDepth hcMulErr Wlocal W0 hWlocal_pos hWlocal_id
        hW0_pos hW0_id cLocalDepth hcLocalDepth A hA_nonneg)
      with ⟨cSize, cErr, hcSize, hcErr, hschedM⟩
    let cDepth : ℝ := cSize / (W0 : ℝ) ^ 2
    have hW0R : 0 < (W0 : ℝ) := by exact_mod_cast hW0_pos
    have hcDepth_pos : 0 < cDepth := by
      dsimp [cDepth]
      exact div_pos hcSize (sq_pos_of_pos hW0R)
    rcases hschedM M hM_pos with ⟨R, rho, localEps, productRadius, productDelta, Rbox,
      nLocal, nMul, center, scale, lower, upper, hschedM⟩
    rcases hschedM with ⟨hrho_nonneg, hR_pos, hRbox_pos, hproductRadius_pos,
      hproductRadius_ge_one, hnLocal_pos, hnMul_pos, hbudget, hproductDelta_nonneg,
      hsumLocal, hsumRadius, herror, hcenter_mem, hdist, hscale_norm, hselector, hsize⟩
    let Wprod : ℕ := Wlocal + (2 * d + 1) + Wmul
    have hWprod_pos : 0 < Wprod := by
      dsimp [Wprod]
      omega
    have hWprod_w0 : 2 * d + Wprod + 3 = W0 := by rfl
    refine ⟨W0, hW0_pos, cDepth, cErr, hcDepth_pos, hcErr, ?_⟩
    intro f hf
    have hcoeff : ∀ j : Fin (M ^ d), ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |(Nat.factorial (↑a.fst : ℕ) : ℝ)⁻¹ * (iteratedFDeriv ℝ (↑a.fst : ℕ) f (center j))
          (fun q u => if u = a.snd q then 1 else 0)| ≤ A := by
      intro j a
      exact hA_coeff f hf (center j) (hcenter_mem j) a
    rcases (hlocalTable (beta := beta) (C := C) (R := R) (rho := rho) (A := A)
        (localEps := localEps) (productRadius := productRadius)
        hbeta_nonneg hC_nonneg hrho_nonneg hA_nonneg hR_pos nLocal hnLocal_pos
        (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
        f hf center scale hcoeff hsumLocal hsumRadius hdist hscale_norm)
      with ⟨Dlocal_f, Plocal_f, hDlocal_f_pos, hDlocal_f_le, hPlocal_f_id,
        localApprox_f, hlocalApprox_mem, hlocalApprox_err, hlocalApprox_bd⟩
    rcases (finite_axisAlignedBoxIndicatorRamp_local_products_fixed_width_depth_sum_bound
        (d := d) (m := M ^ d) (Dlocal := Dlocal_f) (Wlocal := Wlocal) (Plocal := Plocal_f) (Wmul := Wmul)
        hDlocal_f_pos hWlocal_pos hWmul_pos
        (Rbox := Rbox) (cMulDepth := cMulDepth) (cMulErr := cMulErr)
        (productRadius := productRadius) (productDelta := productDelta)
        hRbox_pos hcMulDepth hcMulErr hproductRadius_pos hproductRadius_ge_one
        nMul hnMul_pos hbudget hmulGadget
        (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
        lower upper localApprox_f hlocalApprox_mem hlocalApprox_bd)
      with ⟨Dprod_f, Pprod_f, hDprod_f_pos, hDprod_f_le, hPprod_f_id,
        productApprox_f, hproductApprox_mem, hproductApprox_err⟩
    have hselector_premise : ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        ∃ j0 : Fin (M ^ d),
          axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
          (∀ j : Fin (M ^ d), j ≠ j0 →
            axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
          |localApprox_f j0 x - f x| ≤ localEps := by
      intro x hx
      rcases hselector x hx with ⟨j0, hramp1, hramp0, hscale0⟩
      exact ⟨j0, hramp1, hramp0, hlocalApprox_err j0 x hx hscale0⟩
    rcases (finite_axisAlignedBoxIndicatorRamp_selector_reluNetworkClass_serial_fixed_width_global_error_bound
        (d := d) (m := M ^ d) (Dprod := Dprod_f) (Wprod := Wprod) (Pprod := Pprod_f)
        hDprod_f_pos hWprod_pos
        (Rbox := Rbox) (productDelta := productDelta) (localEps := localEps)
        hproductDelta_nonneg
        lower upper localApprox_f (target := f) productApprox_f
        (domain := fun x : Fin d → ℝ => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1)
        hproductApprox_mem hproductApprox_err hselector_premise)
      with ⟨D_f, P_f, hD_f_pos, hD_f_le, hP_f_id, g_f, hg_f_mem, hg_f_err⟩
    have hP_f_id_w0 : P_f = fullyConnectedReLUParameterCount d D_f W0 := by
      rw [hP_f_id, hWprod_w0]
    have hg_f_pad : g_f ∈ reluNetworkClass d D_f W0 P_f := by
      exact h_relu_mono le_rfl (le_of_eq hWprod_w0) le_rfl g_f hg_f_mem
    have hsize_app := hsize Dlocal_f Dprod_f D_f hDlocal_f_pos hDlocal_f_le hDprod_f_pos hDprod_f_le hD_f_le
    have hD_f_le_cDepth : (D_f : ℝ) ≤ cDepth * (M : ℝ) ^ d := by
