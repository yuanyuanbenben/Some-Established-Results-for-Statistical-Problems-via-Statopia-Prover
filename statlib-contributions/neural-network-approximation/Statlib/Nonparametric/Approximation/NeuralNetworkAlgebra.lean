                ∃ nLocal nMul : ℕ,
                ∃ center scale lower upper : Fin (M ^ d) → Fin d → ℝ,
                  0 ≤ rho ∧ 0 < R ∧ 0 < Rbox ∧ 0 < productRadius ∧ 1 ≤ productRadius ∧
                  0 < nLocal ∧ 0 < nMul ∧
                  cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤ productDelta ∧
                  0 ≤ productDelta ∧
                  A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val) + C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) ≤ localEps ∧
                  A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), centeredMonomialFixedWidthApproxError cMulErr R nLocal a.1.val) + A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) ≤ productRadius ∧
                  (∑ _ : Fin (M ^ d), productDelta) + localEps ≤ cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) ∧
