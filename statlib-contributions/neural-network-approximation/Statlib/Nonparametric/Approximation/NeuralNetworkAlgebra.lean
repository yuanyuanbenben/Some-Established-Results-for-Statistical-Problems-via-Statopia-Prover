                              _ = (B r).hiddenState x (min (j + 1) ((B r).depth - 1)) jT := by rw [hmin']
                    have hEq : k * (D0 + 1) + (D0 - 1) + 1 = k * (D0 + 1) + D0 := by omega
                    have hminD : min (D0 - 1) ((B r).depth - 1) = (B r).depth - 1 := by
