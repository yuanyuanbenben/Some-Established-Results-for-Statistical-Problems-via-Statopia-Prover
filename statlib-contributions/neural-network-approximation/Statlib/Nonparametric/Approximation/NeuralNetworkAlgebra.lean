      (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
    forall center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
    (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
    (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
      center j q ∈ Set.Icc (0 : Real) 1) ->
    (forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
      Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
        axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
    forall digit : Fin N -> Nat,
    (forall k : Fin N, digit k <= Q) ->
    (forall k : Fin N, digit k < base) ->
    code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
    floorBound = code + 1 ->
    forall decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
    (forall j a, decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
    (forall j a, |decoded j a| <= A + eta) ->
    (fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
      reluNetworkClass 1 1 (2 * floorBound)
        (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ->
    (forall k : Fin N,
      let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real)
      0 <= readout /\
        readout < (floorBound : Real) + 1 /\
        awayFromFiniteIntegerGrid Rdec floorBound readout /\
        Nat.floor readout = code / base ^ k.val /\
        truncatedFloorReLUFunction Rdec floorBound readout =
          ((code / base ^ k.val : Nat) : Real) /\
        Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
          digit k) ->
    exists T Dsub Dtent Wtent Ptent Dlocal Wlocal Plocal Wmul : Nat,
    exists cMulDepth cMulErr etaW R nMulReal Kcoeff KlocTent productDelta : Real,
    exists nMul : Nat,
    exists coeffAccErr : Fin (M ^ d) -> Real,
    exists locErr tentErr : Fin (M ^ d) -> Fin T -> Real,
    exists centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real,
    exists decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real,
    exists localApprox weightApprox : Fin (M ^ d) -> Fin T -> (Fin d -> Real) -> Real,
      0 < Dsub /\
      0 < Dtent /\ 0 < Wtent /\
      0 < Dlocal /\ 0 < Wlocal /\ 0 < Wmul /\
      0 < cMulDepth /\ 0 < cMulErr /\
      0 <= etaW /\ 0 < R /\ 0 <= productDelta /\ 0 < nMul /\
      nMulReal = (nMul : Real) /\
      W0 = 2 * d + (2 * d + (Wlocal + Wtent + Wmul) + 3) + 3 /\
      2 * (Dsub + 1) <= Dblock + 1 /\
      (forall (Dprod Db : Nat),
        0 < Dprod ->
        (Dprod : Real) <= (Dlocal.max Dtent : Nat) + cMulDepth * nMulReal ->
        Db <= (T + 1) * (Dprod + 1) ->
        Db <= Dsub) /\
      cMulErr * R ^ 2 * (nMul : Real).rpow (-2) + R * etaW <= productDelta /\
      (forall n : Nat, 0 < n -> forall R : Real, 0 < R ->
        exists Dmul Pmul : Nat,
          0 < Dmul /\
          (Dmul : Real) <= cMulDepth * (n : Real) /\
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul /\
          exists gmul : (Fin 2 -> Real) -> Real,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul /\
            forall y : Fin 2 -> Real, |y 0| <= R -> |y 1| <= R ->
              |gmul y - y 0 * y 1| <= cMulErr * R ^ 2 * (n : Real).rpow (-2)) /\
      (forall b : Fin (M ^ d), 0 <= coeffAccErr b) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i) /\
      Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
        Kcoeff * shallowReLUResolutionRate M r beta /\
      Finset.univ.sum (fun b : Fin (M ^ d) =>
        Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
        KlocTent * shallowReLUResolutionRate M r beta /\
      Kcoeff + KlocTent <= cState /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (q : Fin d), 0 <= scaleBlock b i q) /\
      (forall (b : Fin (M ^ d)) (i : Fin T),
        localApprox b i ∈ reluNetworkClass d Dlocal Wlocal Plocal) /\
      (forall (b : Fin (M ^ d)) (i : Fin T),
        weightApprox b i ∈ reluNetworkClass d Dtent Wtent Ptent) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d -> |localApprox b i x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d -> |weightApprox b i x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |weightApprox b i x -
            axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= etaW) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |localApprox b i x -
            reluApproxDecodedTaylorTerm r d (decodedBlock b i) (centerBlock b i) x| <=
            locErr b i) /\
      (forall x : Fin d -> Real, x ∈ unitCubeSet d ->
        reluApproxFineGridDecodedTaylorSum r d (M ^ d) T
            decodedBlock centerBlock scaleBlock x =
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x *
              finiteLinearCombination Finset.univ (decoded j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x))

/--
Paper-style raw exact component schedule where the two component-rate sums are
not assumed directly; they are implied by uniform coefficient and local/tent
budgets.
-/
private abbrev ReLUApproxUniformRawComponentSchedule
    (d r W0 Dblock : Nat) (beta A cState : Real) : Prop :=
  forall (M N Q base code floorBound : Nat) (eta Rdec : Real),
    0 < M ->
    0 < eta ->
    0 < Q ->
    2 * A / (Q : Real) <= eta ->
    Q + 1 <= base ->
    2 <= Rdec ->
    forall e :
      (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
    forall center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
    (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
    (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
      center j q ∈ Set.Icc (0 : Real) 1) ->
    (forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
      Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
        axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
    forall digit : Fin N -> Nat,
    (forall k : Fin N, digit k <= Q) ->
    (forall k : Fin N, digit k < base) ->
    code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
    floorBound = code + 1 ->
    forall decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
    (forall j a, decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
    (forall j a, |decoded j a| <= A + eta) ->
    (fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
      reluNetworkClass 1 1 (2 * floorBound)
        (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ->
    (forall k : Fin N,
      let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real)
      0 <= readout /\
        readout < (floorBound : Real) + 1 /\
        awayFromFiniteIntegerGrid Rdec floorBound readout /\
        Nat.floor readout = code / base ^ k.val /\
        truncatedFloorReLUFunction Rdec floorBound readout =
          ((code / base ^ k.val : Nat) : Real) /\
        Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
          digit k) ->
    exists T Dsub Dtent Wtent Ptent Dlocal Wlocal Plocal Wmul : Nat,
    exists cMulDepth cMulErr etaW R nMulReal Kcoeff KlocTent productDelta : Real,
    exists nMul : Nat,
    exists coeffBudget locTentBudget : Real,
    exists coeffAccErr : Fin (M ^ d) -> Real,
    exists locErr tentErr : Fin (M ^ d) -> Fin T -> Real,
    exists centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real,
    exists decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real,
    exists localApprox weightApprox : Fin (M ^ d) -> Fin T -> (Fin d -> Real) -> Real,
      0 < Dsub /\
      0 < Dtent /\ 0 < Wtent /\
      0 < Dlocal /\ 0 < Wlocal /\ 0 < Wmul /\
      0 < cMulDepth /\ 0 < cMulErr /\
      0 <= etaW /\ 0 < R /\ 0 <= productDelta /\ 0 < nMul /\
      nMulReal = (nMul : Real) /\
      W0 = 2 * d + (2 * d + (Wlocal + Wtent + Wmul) + 3) + 3 /\
      2 * (Dsub + 1) <= Dblock + 1 /\
      (forall (Dprod Db : Nat),
        0 < Dprod ->
        (Dprod : Real) <= (Dlocal.max Dtent : Nat) + cMulDepth * nMulReal ->
        Db <= (T + 1) * (Dprod + 1) ->
        Db <= Dsub) /\
      cMulErr * R ^ 2 * (nMul : Real).rpow (-2) + R * etaW <= productDelta /\
      (forall n : Nat, 0 < n -> forall R : Real, 0 < R ->
        exists Dmul Pmul : Nat,
          0 < Dmul /\
          (Dmul : Real) <= cMulDepth * (n : Real) /\
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul /\
          exists gmul : (Fin 2 -> Real) -> Real,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul /\
            forall y : Fin 2 -> Real, |y 0| <= R -> |y 1| <= R ->
              |gmul y - y 0 * y 1| <= cMulErr * R ^ 2 * (n : Real).rpow (-2)) /\
      (forall b : Fin (M ^ d), 0 <= coeffAccErr b) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i) /\
      (forall b : Fin (M ^ d), coeffAccErr b <= coeffBudget) /\
      (forall (b : Fin (M ^ d)) (i : Fin T), locErr b i + tentErr b i <= locTentBudget) /\
      (M ^ d : Real) * coeffBudget <= Kcoeff * shallowReLUResolutionRate M r beta /\
      (M ^ d : Real) * (T : Real) * locTentBudget <=
        KlocTent * shallowReLUResolutionRate M r beta /\
      Kcoeff + KlocTent <= cState /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (q : Fin d), 0 <= scaleBlock b i q) /\
      (forall (b : Fin (M ^ d)) (i : Fin T),
        localApprox b i ∈ reluNetworkClass d Dlocal Wlocal Plocal) /\
      (forall (b : Fin (M ^ d)) (i : Fin T),
        weightApprox b i ∈ reluNetworkClass d Dtent Wtent Ptent) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d -> |localApprox b i x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d -> |weightApprox b i x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= R) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |weightApprox b i x -
            axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= etaW) /\
      (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
        x ∈ unitCubeSet d ->
          |localApprox b i x -
            reluApproxDecodedTaylorTerm r d (decodedBlock b i) (centerBlock b i) x| <=
            locErr b i) /\
      (forall x : Fin d -> Real, x ∈ unitCubeSet d ->
        reluApproxFineGridDecodedTaylorSum r d (M ^ d) T
            decodedBlock centerBlock scaleBlock x =
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x *
              finiteLinearCombination Finset.univ (decoded j)
                (fun a y => Finset.univ.prod
                  (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x))

/--
Uniform paper-style local/tent/product budgets imply the exact component
schedule interface used by the promoted wave75 bridge.

Proof route for the prover: introduce the shared outer data, destruct `hraw`,
apply `reluApprox_component_rate_sums_from_uniform_cell_bounds` with
`coarse := M ^ d` to obtain the two summed component-rate inequalities, and
repackage every remaining field unchanged.
-/
private theorem reluApprox_exact_component_schedule_from_uniform_local_tent_product_bounds
    {d r W0 Dblock : Nat} {beta A cState : Real}
    (hraw : ReLUApproxUniformRawComponentSchedule d r W0 Dblock beta A cState) :
    ReLUApproxExactComponentSchedule d r W0 Dblock beta A cState := by
  -- @step s1: from the per-cell coefficient budget derive the aggregate coefficient bound
  have h_s1 :
      ∀ (M : Nat) (beta : ℝ) (coeffAccErr : Fin (M ^ d) → ℝ)
        (coeffBudget Kcoeff : ℝ),
        (∀ b : Fin (M ^ d), coeffAccErr b ≤ coeffBudget) →
        (M ^ d : ℝ) * coeffBudget ≤ Kcoeff * shallowReLUResolutionRate M r beta →
        (∑ b : Fin (M ^ d), coeffAccErr b) ≤ Kcoeff * shallowReLUResolutionRate M r beta := by
    intro M beta coeffAccErr coeffBudget Kcoeff hCb hBud
    have hleSum :
        (∑ b : Fin (M ^ d), coeffAccErr b) ≤ ∑ _b : Fin (M ^ d), coeffBudget := by
      simpa using
        (Finset.sum_le_sum (s := (Finset.univ : Finset (Fin (M ^ d))))
          (f := coeffAccErr) (g := fun _ : Fin (M ^ d) => coeffBudget)
          (fun b _hb => hCb b))
    have hsumConst :
        (∑ _b : Fin (M ^ d), coeffBudget) = (M ^ d : ℝ) * coeffBudget := by
      simp [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin]
    calc
      (∑ b : Fin (M ^ d), coeffAccErr b) ≤ ∑ _b : Fin (M ^ d), coeffBudget := hleSum
      _ = (M ^ d : ℝ) * coeffBudget := hsumConst
      _ ≤ Kcoeff * shallowReLUResolutionRate M r beta := hBud
  -- @step s2: from the per-cell local/tent budget derive the aggregate local/tent bound
  have h_s2 :
      ∀ (M T : Nat) (beta : ℝ)
        (locErr tentErr : Fin (M ^ d) → Fin T → ℝ)
        (locTentBudget KlocTent : ℝ),
        (∀ b : Fin (M ^ d), ∀ i : Fin T, locErr b i + tentErr b i ≤ locTentBudget) →
        (M ^ d : ℝ) * (T : ℝ) * locTentBudget ≤
          KlocTent * shallowReLUResolutionRate M r beta →
        (∑ b : Fin (M ^ d), ∑ i : Fin T, (locErr b i + tentErr b i)) ≤
          KlocTent * shallowReLUResolutionRate M r beta := by
    intro M T beta locErr tentErr locTentBudget KlocTent hPt hBud
    have hinner : ∀ b : Fin (M ^ d),
        (∑ i : Fin T, (locErr b i + tentErr b i)) ≤ ∑ _i : Fin T, locTentBudget := by
      intro b
      simpa using
        (Finset.sum_le_sum (s := (Finset.univ : Finset (Fin T)))
          (f := fun i : Fin T => locErr b i + tentErr b i)
          (g := fun _ : Fin T => locTentBudget)
          (fun i _hi => hPt b i))
    have houter :
        (∑ b : Fin (M ^ d), ∑ i : Fin T, (locErr b i + tentErr b i)) ≤
          ∑ _b : Fin (M ^ d), ∑ _i : Fin T, locTentBudget := by
      simpa using
        (Finset.sum_le_sum (s := (Finset.univ : Finset (Fin (M ^ d))))
          (f := fun b : Fin (M ^ d) => ∑ i : Fin T, (locErr b i + tentErr b i))
          (g := fun _ : Fin (M ^ d) => ∑ _i : Fin T, locTentBudget)
          (fun b _hb => hinner b))
    have hsumConst :
        (∑ _b : Fin (M ^ d), ∑ _i : Fin T, locTentBudget) =
          (M ^ d : ℝ) * (T : ℝ) * locTentBudget := by
      simp [Finset.sum_const, nsmul_eq_mul, Finset.card_univ, Fintype.card_fin,
        mul_comm, mul_left_comm]
    calc
      (∑ b : Fin (M ^ d), ∑ i : Fin T, (locErr b i + tentErr b i)) ≤
          ∑ _b : Fin (M ^ d), ∑ _i : Fin T, locTentBudget := houter
      _ = (M ^ d : ℝ) * (T : ℝ) * locTentBudget := hsumConst
      _ ≤ KlocTent * shallowReLUResolutionRate M r beta := hBud
  -- @step s3: unfold the two schedule abbreviations, fix the shared prefix, destruct the
  -- raw existential witnesses, and reassemble the exact schedule from the same data,
  -- replacing the two raw budget conjuncts by the aggregate bounds of s1 and s2.
  have h_s3 : ReLUApproxExactComponentSchedule d r W0 Dblock beta A cState := by
    intro M N Q base code floorBound eta Rdec
    intro hM hEta hQ hEtaBound hBase hRdec
    intro e
    intro center scale
    intro hScale hCenter hPartition
    intro digit
    intro hDigitLeQ hDigitLtBase hCode hFloorBound
    intro decoded
    intro hDecodedDef hDecodedBnd hNetwork
    intro hReadout
    have hrawBody :=
      hraw M N Q base code floorBound eta Rdec hM hEta hQ hEtaBound hBase
        hRdec e center scale hScale hCenter hPartition digit hDigitLeQ
        hDigitLtBase hCode hFloorBound decoded hDecodedDef hDecodedBnd hNetwork
        hReadout
    rcases hrawBody with ⟨T, Dsub, Dtent, Wtent, Ptent, Dlocal, Wlocal, Plocal,
      Wmul, cMulDepth, cMulErr, etaW, R, nMulReal, Kcoeff, KlocTent,
      productDelta, nMul, coeffBudget, locTentBudget, coeffAccErr, locErr,
      tentErr, centerBlock, scaleBlock, decodedBlock, localApprox, weightApprox,
      hmain⟩
    rcases hmain with ⟨hDsub, hDtent, hWtent, hDlocal, hWlocal, hWmul,
      hCMulDepth, hCMulErr, hEtaW, hRpos, hProdDelta, hNmul, hNmulReal, hW0,
      hDblock, hDepthUniv, hAccum, hMulChain, hCErrNonneg, hLocErrNonneg,
      hTentErrNonneg, hProdLeTent, hCb, hLTb, hBudC, hBudLT, hKsum,
      hScaleNonneg, hLocNet, hTentNet, hLocBnd, hWeightBnd, hTentBnd,
      hWeightTentBnd, hLocErrBnd, hFineGrid⟩
    have hAggC :
        (∑ b : Fin (M ^ d), coeffAccErr b) ≤
          Kcoeff * shallowReLUResolutionRate M r beta := by
      exact h_s1 M beta coeffAccErr coeffBudget Kcoeff hCb hBudC
    have hAggLT :
        (∑ b : Fin (M ^ d), ∑ i : Fin T, (locErr b i + tentErr b i)) ≤
          KlocTent * shallowReLUResolutionRate M r beta := by
      exact h_s2 M T beta locErr tentErr locTentBudget KlocTent hLTb hBudLT
    refine ⟨T, Dsub, Dtent, Wtent, Ptent, Dlocal, Wlocal, Plocal, Wmul,
      cMulDepth, cMulErr, etaW, R, nMulReal, Kcoeff, KlocTent, productDelta,
      nMul, coeffAccErr, locErr, tentErr, centerBlock, scaleBlock, decodedBlock,
      localApprox, weightApprox, ?_⟩
    exact ⟨hDsub, hDtent, hWtent, hDlocal, hWlocal, hWmul, hCMulDepth, hCMulErr,
      hEtaW, hRpos, hProdDelta, hNmul, hNmulReal, hW0, hDblock, hDepthUniv,
      hAccum, hMulChain, hCErrNonneg, hLocErrNonneg, hTentErrNonneg,
      hProdLeTent, hAggC, hAggLT, hKsum, hScaleNonneg, hLocNet, hTentNet,
      hLocBnd, hWeightBnd, hTentBnd, hWeightTentBnd, hLocErrBnd, hFineGrid⟩
  exact h_s3

/-- Per-block evaluator schedule from local decoded-Taylor, tent-weight, and
product-gadget component schedules.

Proof route: for each scale and scheduled encoded coefficient table, destruct
`hcomponent`.  Set the block width to
`2*d + (Wlocal + Wtent + Wmul) + 3` and the common block parameter budget to
`fullyConnectedReLUParameterCount d Dsub Wblock`.  For each coarse block `b`,
apply `reluApprox_coarseBlock_evaluator_from_local_tent_product_gadgets` to
the local decoded Taylor approximants and tent-weight approximants indexed by
that block.  Use the component schedule's depth cap to get `Db <= Dsub`, and
pass through the component rate sums and flat fine-grid decomposition. -/
private theorem reluApprox_per_block_evaluator_schedule_from_local_tent_product_gadget_schedule
    {d r W0 Dblock : Nat} {beta A cState : Real}
    (hcomponent :
      forall (M N Q base code floorBound : Nat) (eta Rdec : Real),
        0 < M ->
        0 < eta ->
        0 < Q ->
        2 * A / (Q : Real) <= eta ->
        Q + 1 <= base ->
        2 <= Rdec ->
        forall e :
          (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
        forall center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
        (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
        (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
          center j q ∈ Set.Icc (0 : Real) 1) ->
        (forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
        forall digit : Fin N -> Nat,
        (forall k : Fin N, digit k <= Q) ->
        (forall k : Fin N, digit k < base) ->
        code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
        floorBound = code + 1 ->
        forall decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
        (forall j a, decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
        (forall j a, |decoded j a| <= A + eta) ->
        (fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
          reluNetworkClass 1 1 (2 * floorBound)
            (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ->
        (forall k : Fin N,
          let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real)
          0 <= readout /\
            readout < (floorBound : Real) + 1 /\
            awayFromFiniteIntegerGrid Rdec floorBound readout /\
            Nat.floor readout = code / base ^ k.val /\
            truncatedFloorReLUFunction Rdec floorBound readout =
              ((code / base ^ k.val : Nat) : Real) /\
            Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
              digit k) ->
        exists T Dsub Dtent Wtent Ptent Dlocal Wlocal Plocal Wmul : Nat,
        exists cMulDepth cMulErr etaW R nMulReal Kcoeff KlocTent productDelta : Real,
        exists nMul : Nat,
        exists coeffAccErr : Fin (M ^ d) -> Real,
        exists locErr tentErr : Fin (M ^ d) -> Fin T -> Real,
        exists centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real,
        exists decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real,
        exists localApprox weightApprox : Fin (M ^ d) -> Fin T -> (Fin d -> Real) -> Real,
          0 < Dsub /\
          0 < Dtent /\ 0 < Wtent /\
          0 < Dlocal /\ 0 < Wlocal /\ 0 < Wmul /\
          0 < cMulDepth /\ 0 < cMulErr /\
          0 <= etaW /\ 0 < R /\ 0 <= productDelta /\ 0 < nMul /\
          nMulReal = (nMul : Real) /\
          W0 = 2 * d + (2 * d + (Wlocal + Wtent + Wmul) + 3) + 3 /\
          2 * (Dsub + 1) <= Dblock + 1 /\
          (forall (Dprod Db : Nat),
            0 < Dprod ->
            (Dprod : Real) <= (Dlocal.max Dtent : Nat) + cMulDepth * nMulReal ->
            Db <= (T + 1) * (Dprod + 1) ->
            Db <= Dsub) /\
          cMulErr * R ^ 2 * (nMul : Real).rpow (-2) + R * etaW <= productDelta /\
          (forall n : Nat, 0 < n -> forall R : Real, 0 < R ->
            exists Dmul Pmul : Nat,
              0 < Dmul /\
              (Dmul : Real) <= cMulDepth * (n : Real) /\
              Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul /\
              exists gmul : (Fin 2 -> Real) -> Real,
                gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul /\
                forall y : Fin 2 -> Real, |y 0| <= R -> |y 1| <= R ->
                  |gmul y - y 0 * y 1| <= cMulErr * R ^ 2 * (n : Real).rpow (-2)) /\
          (forall b : Fin (M ^ d), 0 <= coeffAccErr b) /\
          (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i) /\
          (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i) /\
          (forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i) /\
          Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
            Kcoeff * shallowReLUResolutionRate M r beta /\
          Finset.univ.sum (fun b : Fin (M ^ d) =>
            Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
            KlocTent * shallowReLUResolutionRate M r beta /\
          Kcoeff + KlocTent <= cState /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (q : Fin d), 0 <= scaleBlock b i q) /\
          (forall (b : Fin (M ^ d)) (i : Fin T),
            localApprox b i ∈ reluNetworkClass d Dlocal Wlocal Plocal) /\
          (forall (b : Fin (M ^ d)) (i : Fin T),
            weightApprox b i ∈ reluNetworkClass d Dtent Wtent Ptent) /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
            x ∈ unitCubeSet d -> |localApprox b i x| <= R) /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
            x ∈ unitCubeSet d -> |weightApprox b i x| <= R) /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
            x ∈ unitCubeSet d ->
              |axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= R) /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
            x ∈ unitCubeSet d ->
              |weightApprox b i x -
                axisAlignedBoxTentWeight (centerBlock b i) (scaleBlock b i) x| <= etaW) /\
          (forall (b : Fin (M ^ d)) (i : Fin T) (x : Fin d -> Real),
            x ∈ unitCubeSet d ->
              |localApprox b i x -
                reluApproxDecodedTaylorTerm r d (decodedBlock b i) (centerBlock b i) x| <=
                locErr b i) /\
          (forall x : Fin d -> Real, x ∈ unitCubeSet d ->
            reluApproxFineGridDecodedTaylorSum r d (M ^ d) T
                decodedBlock centerBlock scaleBlock x =
              Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                axisAlignedBoxTentWeight (center j) (scale j) x *
                  finiteLinearCombination Finset.univ (decoded j)
                    (fun a y => Finset.univ.prod
                      (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x))) :
      forall (M N Q base code floorBound : Nat) (eta Rdec : Real),
        0 < M ->
        0 < eta ->
        0 < Q ->
        2 * A / (Q : Real) <= eta ->
        Q + 1 <= base ->
        2 <= Rdec ->
        forall e :
          (Fin (((M ^ 2) + 1) ^ d) × TaylorMultiindex r d) ≃ Fin N,
        forall center scale : Fin (((M ^ 2) + 1) ^ d) -> Fin d -> Real,
        (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d), 0 <= scale j q) ->
        (forall (j : Fin (((M ^ 2) + 1) ^ d)) (q : Fin d),
          center j q ∈ Set.Icc (0 : Real) 1) ->
        (forall x : Fin d -> Real, (forall q : Fin d, x q ∈ Set.Icc (0 : Real) 1) ->
          Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
            axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ->
        forall digit : Fin N -> Nat,
        (forall k : Fin N, digit k <= Q) ->
        (forall k : Fin N, digit k < base) ->
        code = Finset.univ.sum (fun k : Fin N => digit k * base ^ k.val) ->
        floorBound = code + 1 ->
        forall decoded : Fin (((M ^ 2) + 1) ^ d) -> TaylorMultiindex r d -> Real,
        (forall j a, decoded j a = -A + (2 * A / (Q : Real)) * (digit (e (j, a)) : Real)) ->
        (forall j a, |decoded j a| <= A + eta) ->
        (fun x : Fin 1 -> Real => truncatedFloorReLUFunction Rdec floorBound (x 0)) ∈
          reluNetworkClass 1 1 (2 * floorBound)
            (fullyConnectedReLUParameterCount 1 1 (2 * floorBound)) ->
        (forall k : Fin N,
          let readout : Real := ((code / base ^ k.val : Nat) : Real) + (1 / 2 : Real)
          0 <= readout /\
            readout < (floorBound : Real) + 1 /\
            awayFromFiniteIntegerGrid Rdec floorBound readout /\
            Nat.floor readout = code / base ^ k.val /\
            truncatedFloorReLUFunction Rdec floorBound readout =
              ((code / base ^ k.val : Nat) : Real) /\
            Nat.floor (truncatedFloorReLUFunction Rdec floorBound readout) % base =
              digit k) ->
        exists T Dsub Wblock Pblock : Nat,
        exists Kcoeff KlocTent productDelta : Real,
          0 < Dsub /\
          0 < Wblock /\
          W0 = 2 * d + Wblock + 3 /\
          Pblock = fullyConnectedReLUParameterCount d Dsub Wblock /\
          2 * (Dsub + 1) <= Dblock + 1 /\
          exists coeffAccErr : Fin (M ^ d) -> Real,
          exists locErr tentErr : Fin (M ^ d) -> Fin T -> Real,
          exists centerBlock scaleBlock : Fin (M ^ d) -> Fin T -> Fin d -> Real,
          exists decodedBlock : Fin (M ^ d) -> Fin T -> TaylorMultiindex r d -> Real,
            (forall b : Fin (M ^ d), 0 <= coeffAccErr b) /\
            (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= locErr b i) /\
            (forall (b : Fin (M ^ d)) (i : Fin T), 0 <= tentErr b i) /\
            (forall (b : Fin (M ^ d)) (i : Fin T), productDelta <= tentErr b i) /\
            Finset.univ.sum (fun b : Fin (M ^ d) => coeffAccErr b) <=
              Kcoeff * shallowReLUResolutionRate M r beta /\
            Finset.univ.sum (fun b : Fin (M ^ d) =>
              Finset.univ.sum (fun i : Fin T => locErr b i + tentErr b i)) <=
              KlocTent * shallowReLUResolutionRate M r beta /\
            Kcoeff + KlocTent <= cState /\
            (forall b : Fin (M ^ d),
              exists Db Pb : Nat,
                0 < Db /\
                Db <= Dsub /\
                Pb = fullyConnectedReLUParameterCount d Db Wblock /\
                exists gb : (Fin d -> Real) -> Real,
                  gb ∈ reluNetworkClass d Db Wblock Pb /\
                  forall x : Fin d -> Real, x ∈ unitCubeSet d ->
                    |gb x -
                      reluApproxCoarseBlockTarget r d T
                        (decodedBlock b) (centerBlock b) (scaleBlock b) x| <=
                      (Finset.univ.sum (fun _i : Fin T => productDelta)) +
                        (Finset.univ.sum (fun i : Fin T => locErr b i))) /\
            (forall x : Fin d -> Real, x ∈ unitCubeSet d ->
              reluApproxFineGridDecodedTaylorSum r d (M ^ d) T
                  decodedBlock centerBlock scaleBlock x =
                Finset.univ.sum (fun j : Fin (((M ^ 2) + 1) ^ d) =>
                  axisAlignedBoxTentWeight (center j) (scale j) x *
                    finiteLinearCombination Finset.univ (decoded j)
                      (fun a y => Finset.univ.prod
                        (fun q : Fin a.1.val => y (a.2 q) - center j (a.2 q))) x)) := by
  intro M N Q base code floorBound eta Rdec
  intro hM hEta hQ hAEta hQbase hRdec
  intro e center scale hscale hcenter hsum
  intro digit hdigitQ hdigitB hcode hfloor
  intro decoded hdecoded hbounded hfloorNet hreadout
  rcases hcomponent M N Q base code floorBound eta Rdec hM hEta hQ hAEta hQbase hRdec e
      center scale hscale hcenter hsum digit hdigitQ hdigitB hcode hfloor decoded
      hdecoded hbounded hfloorNet hreadout with
    ⟨T, Dsub, Dtent, Wtent, Ptent, Dlocal, Wlocal, Plocal, Wmul,
      cMulDepth, cMulErr, etaW, R, nMulReal, Kcoeff, KlocTent, productDelta,
      nMul, coeffAccErr, locErr, tentErr, centerBlock, scaleBlock, decodedBlock,
      localApprox, weightApprox, hProps⟩
  rcases hProps with
    ⟨hDsubPos, hDtentPos, hWtentPos, hDlocalPos, hWlocalPos, hWmulPos,
      hCMulDepthPos, hCMulErrPos, hEtaWNonneg, hRPos, hProdDeltaNonneg, hNMulPos,
      hnMulReal, hW0, hDepthBudget, hDepthCap, hProdDeltaBound, hMulGadget,
      hCoeffNonneg, hLocNonneg, hTentNonneg, hProdDeltaLE, hCoeffSum, hLocTentSum,
      hKsum, hScaleNonneg, hLocNet, hTentNet, hLocBounded, hTentBounded,
      hTentWeightBounded, hTentApprox, hLocApprox, hFineGrid⟩
  refine ⟨T, Dsub, 2 * d + (Wlocal + Wtent + Wmul) + 3,
    fullyConnectedReLUParameterCount d Dsub (2 * d + (Wlocal + Wtent + Wmul) + 3),
    Kcoeff, KlocTent, productDelta, ?scalars⟩
  refine ⟨hDsubPos, ?_, ?_, rfl, hDepthBudget, coeffAccErr, locErr, tentErr, centerBlock,
    scaleBlock, decodedBlock, ?fields⟩
  · omega
  · exact hW0
  · refine ⟨hCoeffNonneg, hLocNonneg, hTentNonneg, hProdDeltaLE, hCoeffSum, hLocTentSum,
      hKsum, ?_⟩
    constructor
    · intro b
      rcases reluApprox_coarseBlock_evaluator_from_local_tent_product_gadgets
          hDtentPos hWtentPos hDlocalPos hWlocalPos hWmulPos hCMulDepthPos hCMulErrPos
          hEtaWNonneg hRPos hProdDeltaNonneg nMul hNMulPos hProdDeltaBound hMulGadget
          (centerBlock b) (scaleBlock b) (decodedBlock b) (localApprox b) (weightApprox b)
          (locErr b) (hScaleNonneg b) (hLocNet b) (hTentNet b) (hLocBounded b)
          (hTentBounded b) (hTentWeightBounded b) (hTentApprox b) (hLocApprox b)
          (hLocNonneg b) with
        ⟨Dprod, _Pprod, D, P, hE1body⟩
      rcases hE1body with
        ⟨hDprodPos, hDprodBound, _hPprodEq, hDPos, hDle, hPEq, hgex⟩
      rcases hgex with ⟨g, hgNet, hgErr⟩
      refine ⟨D, P, hDPos, ?_, ?_, g, ?_⟩
      · exact hDepthCap Dprod D hDprodPos (by
          rw [hnMulReal]
          exact hDprodBound) hDle
      · exact hPEq
      · exact ⟨hgNet, hgErr⟩
