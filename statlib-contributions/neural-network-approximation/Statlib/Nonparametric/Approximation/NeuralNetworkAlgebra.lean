        -- @step s3b: Interchange the sum over f with the product over q (Finset.sum_prod_piFinset)
        have hs3b :
            (∑ f : Fin d → Fin (K + 1), ∏ q : Fin d,
                coordinateTentReLUFunction q (((f q : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x) =
              ∏ q : Fin d, ∑ i : Fin (K + 1),
                coordinateTentReLUFunction q (((i : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x := by
          simpa [Fintype.piFinset_univ] using
            (Finset.sum_prod_piFinset (s := (Finset.univ : Finset (Fin (K + 1))))
              (g := fun q i => coordinateTentReLUFunction q (((i : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x))
        -- @step s3c: Evaluate each inner sum via h_s2 at z = x q, conclude product = 1
        have hs3c :
            (∏ q : Fin d, ∑ i : Fin (K + 1),
                coordinateTentReLUFunction q (((i : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x) = 1 := by
          calc
            (∏ q : Fin d, ∑ i : Fin (K + 1),
                coordinateTentReLUFunction q (((i : ℕ) : ℝ) / (K : ℝ)) (K : ℝ) x)
                = ∏ q : Fin d, 1 := by
              apply Finset.prod_congr rfl
              intro q hq
              simpa [coordinateTentReLUFunction] using h_s2 q (x q) (hx q)
            _ = 1 := by simp
        rw [hs3a, hs3b, hs3c]
  -- @step s4: Prove the coordinate locality inequality: if
  --   scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1, then |x q - center j q| ≤ (K : ℝ)⁻¹.
  have h_s4 : ∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹ := by
        intro j x hx hactive q
        have hrelu_abs : ∀ a : ℝ, relu a + relu (-a) = |a| := by
          intro a
          rw [relu, relu]
          rcases le_total 0 a with h | h
          · have hneg : -a ≤ 0 := neg_nonpos.mpr h
            have h1 : max a 0 = a := max_eq_left h
            have h2 : max (-a) 0 = 0 := max_eq_right hneg
            rw [h1, h2, abs_of_nonneg h]
            ring
          · have hnonneg : 0 ≤ -a := neg_nonneg.mpr h
            have h1 : max a 0 = 0 := max_eq_right h
            have h2 : max (-a) 0 = -a := max_eq_left hnonneg
            rw [h1, h2, abs_of_nonpos h]
            ring
        have hKpos : (0 : ℝ) < (K : ℝ) := by exact_mod_cast hK
        have hneg_id : center j q - x q = -(x q - center j q) := by ring
        have hact' : (K : ℝ) * |x q - center j q| < 1 := by
          have h1 := hactive q
          dsimp [scale] at h1
          rw [hneg_id] at h1
          rw [hrelu_abs (x q - center j q)] at h1
          exact h1
        have hAbsLt : |x q - center j q| < (K : ℝ)⁻¹ := by
          have hK_neR : (K : ℝ) ≠ 0 := ne_of_gt hKpos
          have hinv : (0 : ℝ) < (K : ℝ)⁻¹ := inv_pos.mpr hKpos
          have hmul : (K : ℝ)⁻¹ * ((K : ℝ) * |x q - center j q|) < (K : ℝ)⁻¹ * 1 :=
            mul_lt_mul_of_pos_left hact' hinv
          calc
            |x q - center j q| = (K : ℝ)⁻¹ * ((K : ℝ) * |x q - center j q|) := by
              rw [← mul_assoc, inv_mul_cancel₀ hK_neR, one_mul]
            _ < (K : ℝ)⁻¹ := by
              simpa using hmul
        exact le_of_lt hAbsLt
  -- @step s5: Prove the Euclidean locality bound: under the same hypotheses,
  --   ‖x - center j‖ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹.
  have h_s5 : ∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ‖x - center j‖ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹ := by
      intro j x hx hactive
      have hcoord : ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹ := h_s4 j x hx hactive
      have hKposR : (0 : ℝ) < (K : ℝ) := by exact_mod_cast hK
      have hKinv_nonneg : (0 : ℝ) ≤ (K : ℝ)⁻¹ := inv_nonneg.mpr (le_of_lt hKposR)
      have hnorm_le : ‖x - center j‖ ≤ (K : ℝ)⁻¹ := by
        exact (pi_norm_le_iff_of_nonneg hKinv_nonneg).2 (fun q => by simpa using hcoord q)
      by_cases hd : d = 0
      · subst hd
        have hzero : x - center j = 0 := by
          funext q
          exact Fin.elim0 q
        rw [hzero]
        simp
      · have hdpos : 1 ≤ d := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hd)
        have hsqrt_ge_one : (1 : ℝ) ≤ Real.sqrt (d : ℝ) :=
          Real.one_le_sqrt.mpr (by exact_mod_cast hdpos)
        have hmul : (K : ℝ)⁻¹ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹ := by
          simpa using (mul_le_mul_of_nonneg_right hsqrt_ge_one hKinv_nonneg)
        exact le_trans hnorm_le hmul
  exact ⟨center, scale, h_s1, h_s3, h_s4, h_s5⟩

theorem exists_unitCube_axisAlignedBoxTentWeight_partition_data_with_domain_coord_bound
    (d K : ℕ) (hK : 0 < K) :
    ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
