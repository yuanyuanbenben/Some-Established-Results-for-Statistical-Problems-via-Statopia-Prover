                  ∀ x : Fin d → ℝ,
                    (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤ eps := by
  rcases (finite_holderSmooth_local_table_reluNetworkClass_fixed_width_active_cell_error_and_domain_output_bound_from_mul_gadget
      (d := d) (m := m) (r := r) (Wmul := Wmul) hWmul
      (cMulDepth := cMulDepth) (cMulErr := cMulErr) hcMulDepth hcMulErr hmul) with
    ⟨Wlocal, hWlocal_pos, hWlocal_eq, cLocalDepth, hcLocalDepth_pos, hlocal_universal⟩
  let W0 : ℕ := 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3
  have hW0_pos : 0 < W0 := by
    dsimp [W0]
    omega
