  -- Any depth-1 network (used as a filler for out-of-support indices and for padding).
  rcases hconst with ⟨L0, hL0d, _⟩
  -- Depth-1 two-input projection network realizing u ↦ u 0.
  let Mproj : FullyConnectedReLUNet 2 :=
    { depth := 1, width := 2,
      input := { weight := fun u k => if k = 0 then (if u = 0 then 1 else -1) else 0, bias := fun u => 0 },
      hidden := fun h => (nomatch h),
      outputWeight := fun u => if u = 0 then 1 else -1,
      outputBias := 0 }
  have hMprojd : Mproj.depth = 1 := rfl
  have hMproj_realize : ∀ u : Fin 2 → ℝ, Mproj.realize u = u 0 := by
    intro u
    have hsum0 : (∑ k : Fin 2, (if k = 0 then 1 else 0) * u k) = u 0 := by
      rw [Fin.sum_univ_two]
      simp
    have hsum1 : (∑ k : Fin 2, (if k = 0 then -1 else 0) * u k) = -u 0 := by
      rw [Fin.sum_univ_two]
      simp
    have happly0 : Mproj.input.apply u 0 = u 0 := by
      calc
        Mproj.input.apply u 0 = (∑ k : Fin 2, (if k = 0 then 1 else 0) * u k) + 0 := by
          simp [Mproj, DenseLayer.apply]
        _ = u 0 := by rw [hsum0]; ring
    have happly1 : Mproj.input.apply u 1 = -u 0 := by
      calc
        Mproj.input.apply u 1 = (∑ k : Fin 2, (if k = 0 then -1 else 0) * u k) + 0 := by
          simp [Mproj, DenseLayer.apply]
        _ = -u 0 := by rw [hsum1]; ring
    have hh0 : Mproj.hiddenState u 0 0 = relu (u 0) := by
      simp [Mproj, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, happly0]
    have hh1 : Mproj.hiddenState u 0 1 = relu (-(u 0)) := by
      simp [Mproj, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, happly1]
    calc
      Mproj.realize u = (∑ j : Fin 2, Mproj.outputWeight j * Mproj.hiddenState u 0 j) + 0 := by
        rw [FullyConnectedReLUNet.realize]
        simp [Mproj]
      _ = Mproj.outputWeight 0 * Mproj.hiddenState u 0 0 + Mproj.outputWeight 1 * Mproj.hiddenState u 0 1 := by
        rw [Fin.sum_univ_two]
        ring
      _ = 1 * relu (u 0) + (-1) * relu (-(u 0)) := by
        simp [Mproj, hh0, hh1]
      _ = relu (u 0) - relu (-(u 0)) := by ring
      _ = u 0 := by rw [hrelu_sub]
