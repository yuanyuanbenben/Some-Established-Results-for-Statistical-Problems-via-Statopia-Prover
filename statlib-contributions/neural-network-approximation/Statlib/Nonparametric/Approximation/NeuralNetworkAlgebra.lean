                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x -
                      finiteLinearCombination s coeff
                        (fun i : ι => fun y : Fin d → ℝ =>
                          ∏ q : Fin (degree i),
                            (y (coord i q) - center (coord i q))) x| ≤
                      finiteCenteredMonomialPolynomialFixedWidthApproxError
                        cMulErr R n s coeff degree := by
  let Wpoly : ℕ := finiteCenteredMonomialPolynomialFixedWidthBound Wmul s degree
  have hWpoly_pos : 0 < Wpoly := by
    dsimp [Wpoly, finiteCenteredMonomialPolynomialFixedWidthBound]
    exact lt_of_lt_of_le (by norm_num) (Nat.le_max_left 1
      (s.sum (fun r => centeredMonomialFixedWidthBound Wmul (degree r))))
  refine ⟨Wpoly, hWpoly_pos, rfl, ?_⟩
  have hmono : ∀ i : ι,
      ∃ Wmono : ℕ,
        0 < Wmono ∧ Wmono = centeredMonomialFixedWidthBound Wmul (degree i) ∧
          ∃ cDi : ℝ,
            0 < cDi ∧
            cDi = max 1 cMulDepth ∧
              ∀ (n : ℕ), 0 < n → ∀ (R : ℝ), 0 < R →
              ∀ (center : Fin d → ℝ) (coord : Fin (degree i) → Fin d),
                ∃ D P : ℕ,
                  0 < D ∧
                  (D : ℝ) ≤ cDi * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
                  P = fullyConnectedReLUParameterCount d D Wmono ∧
                  ∃ g : (Fin d → ℝ) → ℝ,
                    g ∈ reluNetworkClass d D Wmono P ∧
                      ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                        |g x - ∏ q : Fin (degree i),
                          (x (coord q) - center (coord q))| ≤
                            centeredMonomialFixedWidthApproxError cMulErr R n
                              (degree i) := by
    intro i
    exact exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget_explicit
      (d := d) (k := degree i) hWmul hcMulDepth hcMulErr hmul
  let Wmono : ι → ℕ := fun i => Classical.choose (hmono i)
  have hWmono_spec : ∀ i : ι,
      0 < Wmono i ∧ Wmono i = centeredMonomialFixedWidthBound Wmul (degree i) ∧
        ∃ cDi : ℝ,
          0 < cDi ∧
          cDi = max 1 cMulDepth ∧
            ∀ (n : ℕ), 0 < n → ∀ (R : ℝ), 0 < R →
            ∀ (center : Fin d → ℝ) (coord : Fin (degree i) → Fin d),
              ∃ D P : ℕ,
                0 < D ∧
                (D : ℝ) ≤ cDi * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
                P = fullyConnectedReLUParameterCount d D (Wmono i) ∧
                ∃ g : (Fin d → ℝ) → ℝ,
                  g ∈ reluNetworkClass d D (Wmono i) P ∧
                    ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                      |g x - ∏ q : Fin (degree i),
                        (x (coord q) - center (coord q))| ≤
                          centeredMonomialFixedWidthApproxError cMulErr R n
                            (degree i) :=
    fun i => Classical.choose_spec (hmono i)
  let cDi : ι → ℝ := fun i => Classical.choose (hWmono_spec i).2.2
  have hcDi_spec : ∀ i : ι,
      0 < cDi i ∧
      cDi i = max 1 cMulDepth ∧
        ∀ (n : ℕ), 0 < n → ∀ (R : ℝ), 0 < R →
        ∀ (center : Fin d → ℝ) (coord : Fin (degree i) → Fin d),
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDi i * ((degree i : ℝ) + 1) * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D (Wmono i) ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D (Wmono i) P ∧
                ∀ x : Fin d → ℝ, (∀ q : Fin d, |x q - center q| ≤ R) →
                  |g x - ∏ q : Fin (degree i),
                    (x (coord q) - center (coord q))| ≤
                      centeredMonomialFixedWidthApproxError cMulErr R n (degree i) :=
    fun i => Classical.choose_spec (hWmono_spec i).2.2
  have hcDi_pos : ∀ i, 0 < cDi i := fun i => (hcDi_spec i).1
