  -- @step s2: For every j and every x with x q ∈ Set.Icc 0 1 for all q, and for every q, |x q - center j q| ≤ 1.
  have h_s2 : ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
