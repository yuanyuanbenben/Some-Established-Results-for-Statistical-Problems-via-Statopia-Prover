                              apply Finset.sum_congr rfl
                              intro a ha
                              have ha_le : (a : ℕ) ≤ m := by simpa using ha
                              have ha_s : (a : ℝ) ≤ s := le_trans (by exact_mod_cast ha_le) hm_le_s
                              exact hphi_left a ha_s
                        _ = Statlib.Nonparametric.Vocabulary.relu ((m : ℝ) + 1 - s) := by
                              let a0 : Fin (K + 1) := ⟨m, hm_lt_K1⟩
                              exact Finset.sum_eq_single a0 (by
                                intro b hb hbne
                                have hb_le : (b : ℕ) ≤ m := by simpa using hb
                                have hb_le_m1 : (b : ℕ) + 1 ≤ m := by
                                  exact Nat.succ_le_of_lt (lt_of_le_of_ne hb_le (by
                                    intro hEq
                                    apply hbne
                                    exact Fin.ext hEq))
                                have hle : (b : ℝ) + 1 - s ≤ 0 := by
                                  have hb_le_m1' : (b : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hb_le_m1
                                  linarith [hb_le_m1', hm_le_s]
                                rw [hrelu_nonpos (u := (b : ℝ) + 1 - s) hle]
                              ) (by
                                intro ha0not
                                exfalso
                                apply ha0not
                                simp [a0]
                              )
                        _ = (m : ℝ) + 1 - s := by
                              rw [hrelu_nonneg (u := (m : ℝ) + 1 - s) (le_of_lt (sub_pos.mpr hs_lt_m1))]
                    have hsumR : (∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => ¬ (a : ℕ) ≤ m), phi a t) = s - (m : ℝ) := by
                      by_cases hm1 : m + 1 ≤ K
                      · let a1 : Fin (K + 1) := ⟨m + 1, Nat.lt_succ_of_le hm1⟩
                        calc
                          (∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => ¬ (a : ℕ) ≤ m), phi a t)
                              = ∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => ¬ (a : ℕ) ≤ m), Statlib.Nonparametric.Vocabulary.relu (s + 1 - (a : ℝ)) := by
                                apply Finset.sum_congr rfl
                                intro a ha
                                have ha_m : m < (a : ℕ) := not_le.mp (by simpa using ha)
                                have ha_m' : (m : ℕ) + 1 ≤ (a : ℕ) := Nat.succ_le_of_lt ha_m
                                have ha_m'' : (m : ℝ) + 1 ≤ (a : ℝ) := by exact_mod_cast ha_m'
                                have ha_s : s ≤ (a : ℝ) := le_trans (le_of_lt hs_lt_m1) ha_m''
                                exact hphi_right a ha_s
                          _ = Statlib.Nonparametric.Vocabulary.relu (s + 1 - ((m + 1 : ℕ) : ℝ)) := by
                                exact Finset.sum_eq_single a1 (by
                                  intro b hb hbne
                                  have hb_m : m < (b : ℕ) := not_le.mp (by simpa using hb)
                                  have hb_ge1 : m + 1 ≤ (b : ℕ) := Nat.succ_le_of_lt hb_m
                                  have hb_ge2 : m + 2 ≤ (b : ℕ) := by
                                    exact Nat.succ_le_of_lt (lt_of_le_of_ne hb_ge1 (by
                                      intro hEq
                                      apply hbne
                                      exact Fin.ext hEq.symm))
                                  have hle : s + 1 - (b : ℝ) ≤ 0 := by
                                    have hb_ge2' : (m : ℝ) + 2 ≤ (b : ℝ) := by exact_mod_cast hb_ge2
                                    linarith [hs_lt_m1, hb_ge2']
                                  rw [hrelu_nonpos (u := s + 1 - (b : ℝ)) hle]
                                ) (by
                                  intro ha1not
                                  exfalso
                                  apply ha1not
                                  simp [a1]
                                )
                          _ = Statlib.Nonparametric.Vocabulary.relu (s - (m : ℝ)) := by
                                congr 1
                                push_cast
                                ring
                          _ = s - (m : ℝ) := by
                                rw [hrelu_nonneg (u := s - (m : ℝ)) (sub_nonneg.mpr hm_le_s)]
                      · have hm_eq_K : m = K := by
                          exact le_antisymm hm_le_K (Nat.le_of_lt_succ (not_le.mp hm1))
                        have hs_eq_m : s = (m : ℝ) := by
                          exact le_antisymm (by rw [hm_eq_K]; exact hsK) hm_le_s
                        have hsum0 : (∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => ¬ (a : ℕ) ≤ m), phi a t) = 0 := by
                          apply Finset.sum_eq_zero
                          intro a ha
                          have hnot : ¬ (a : ℕ) ≤ m := by simpa using ha
                          have ha_le_m : (a : ℕ) ≤ m := by
                            exact le_trans (Nat.lt_succ_iff.mp a.isLt) (le_of_eq hm_eq_K.symm)
                          exact False.elim (hnot ha_le_m)
                        rw [hsum0, hs_eq_m]
                        simp
                    calc
                      (∑ a : Fin (K + 1), phi a t)
                          = (∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => (a : ℕ) ≤ m), phi a t) +
                            (∑ a ∈ Finset.univ.filter (fun a : Fin (K + 1) => ¬ (a : ℕ) ≤ m), phi a t) := hsplit
                      _ = ((m : ℝ) + 1 - s) + (s - (m : ℝ)) := by
                            rw [hsumL, hsumR]
                      _ = 1 := by ring
                  exact Finset.prod_eq_one (fun q _ => h1d (x q) (hx q))
          · -- C5: fine coordinate localization
            intro j x hx hsup q
            have hsum_abs : Statlib.Nonparametric.Vocabulary.relu (x q - center j q) +
                Statlib.Nonparametric.Vocabulary.relu (center j q - x q) = |x q - center j q| := by
              simpa using h_relu_abs (x q - center j q)
            have hscaled : scale j q * |x q - center j q| < 1 := by
              rw [← hsum_abs]
              exact hsup q
            have hscaledK : (K : ℝ) * |x q - center j q| < 1 := by
              simpa [scale] using hscaled
            have habs : |x q - center j q| < (K : ℝ)⁻¹ := by
              have hmul : (K : ℝ)⁻¹ * ((K : ℝ) * |x q - center j q|) < (K : ℝ)⁻¹ := by
                simpa using (mul_lt_mul_of_pos_left hscaledK (inv_pos.mpr hKpos))
              rwa [← mul_assoc, inv_mul_cancel₀ hKne, one_mul] at hmul
            exact le_of_lt habs
  -- @step s5: For every j and every x with x q ∈ Set.Icc 0 1 for all q, if scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1 for all q, then ‖x - center j‖ ≤ Real.sqrt d * (K : ℝ)⁻¹.
  have h_s5 : ∃ center scale : Fin ((K + 1) ^ d) → Fin d → ℝ,
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d), 0 ≤ scale j q) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (q : Fin d),
        center j q ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ q : Fin d, |x q - center j q| ≤ 1) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin ((K + 1) ^ d),
          Statlib.Nonparametric.Vocabulary.axisAlignedBoxTentWeight (center j) (scale j) x) = 1) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (Statlib.Nonparametric.Vocabulary.relu (x q - center j q) +
            Statlib.Nonparametric.Vocabulary.relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹) ∧
      (∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d,
          scale j q * (Statlib.Nonparametric.Vocabulary.relu (x q - center j q) +
            Statlib.Nonparametric.Vocabulary.relu (center j q - x q)) < 1) →
            ‖x - center j‖ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) := by
        rcases h_s4 with ⟨center, scale, hnn, hcc, hcb, hpart, hloc⟩
        refine ⟨center, scale, hnn, hcc, hcb, hpart, hloc, ?_⟩
        intro j x hx hsup
        have hKpos : 0 < (K : ℝ) := by exact_mod_cast hK
        by_cases hd0 : d = 0
        · subst d
          have hzero : ‖x - center j‖ = 0 := by
            rw [norm_eq_zero]
            funext q
            exact Fin.elim0 q
          rw [hzero]
          positivity
        · have hcoord : ∀ q : Fin d, |x q - center j q| ≤ (K : ℝ)⁻¹ := hloc j x hx hsup
          have hnorm_le : ‖x - center j‖ ≤ (K : ℝ)⁻¹ := by
            exact (pi_norm_le_iff_of_nonneg (inv_nonneg.mpr (le_of_lt hKpos))).2
              (fun q => by simpa using hcoord q)
          have hd_ge_one : (1 : ℝ) ≤ (d : ℝ) := by
            exact_mod_cast (Nat.succ_le_of_lt (Nat.pos_of_ne_zero hd0))
          have hsqrt_ge_one : (1 : ℝ) ≤ Real.sqrt (d : ℝ) := by
            simpa [Real.sqrt_one] using (Real.sqrt_monotone hd_ge_one)
          have hinv_nonneg : 0 ≤ (K : ℝ)⁻¹ := inv_nonneg.mpr (le_of_lt hKpos)
          have hle : (K : ℝ)⁻¹ ≤ Real.sqrt (d : ℝ) * (K : ℝ)⁻¹ := by
            simpa [one_mul] using (mul_le_mul_of_nonneg_right hsqrt_ge_one hinv_nonneg)
          exact le_trans hnorm_le hle
  -- @step fin
  exact h_s5


theorem unitCube_final_budget_constraints_from_exact_schedule
    {d m nWeight nMul Dbase
      weightDepthBudget weightWidthBudget
      localDepthBudget localWidthBudget
      productDepthBudget productWidthBudget productParameterBudget
      globalWidthBudget globalParameterBudget : ℕ}
    (hWeightDepthBudget_eq : weightDepthBudget = 2 + d)
    (hWeightWidthBudget_eq : weightWidthBudget = d * (2 + 2 * nWeight))
    (hProductDepthBudget_eq : productDepthBudget = Dbase + 1)
    (hProductWidthBudget_eq :
      productWidthBudget = weightWidthBudget + localWidthBudget + 2 * nMul)
    (hProductParameterBudget_eq :
      productParameterBudget =
        fullyConnectedReLUParameterCount d (Dbase + 1) productWidthBudget)
    (hGlobalWidthBudget_eq : globalWidthBudget = m * productWidthBudget)
    (hGlobalParameterBudget_eq :
      globalParameterBudget =
        fullyConnectedReLUParameterCount d productDepthBudget globalWidthBudget)
    (hWeightDepthToBase : 2 + d ≤ Dbase)
    (hLocalDepthToBase_input : localDepthBudget ≤ Dbase) :
    (2 + d ≤ weightDepthBudget) ∧
    (d * (2 + 2 * nWeight) ≤ weightWidthBudget) ∧
    (weightDepthBudget ≤ Dbase) ∧
    (localDepthBudget ≤ Dbase) ∧
    (Dbase + 1 ≤ productDepthBudget) ∧
    (weightWidthBudget + localWidthBudget + 2 * nMul ≤ productWidthBudget) ∧
    (∀ wWeight wLocal : ℕ,
      wWeight ≤ weightWidthBudget →
      wLocal ≤ localWidthBudget →
      fullyConnectedReLUParameterCount d (Dbase + 1)
        (wWeight + wLocal + 2 * nMul) ≤ productParameterBudget) ∧
    ((∑ j : Fin m, productWidthBudget) ≤ globalWidthBudget) ∧
    (fullyConnectedReLUParameterCount d productDepthBudget
      (∑ j : Fin m, productWidthBudget) ≤ globalParameterBudget) := by
  have hmono_gen : ∀ {w1 w2 : ℕ}, w1 ≤ w2 →
      fullyConnectedReLUParameterCount d (Dbase + 1) w1 ≤
      fullyConnectedReLUParameterCount d (Dbase + 1) w2 := by
    intro w1 w2 hw
    unfold fullyConnectedReLUParameterCount
    have hprod : (w1 + 1) * w1 ≤ (w2 + 1) * w2 := by
      exact Nat.mul_le_mul (Nat.succ_le_succ hw) hw
    exact add_le_add
      (add_le_add (Nat.mul_le_mul_left (d + 1) hw)
        (Nat.mul_le_mul_left ((Dbase + 1) - 1) hprod))
      (Nat.succ_le_succ hw)
  constructor
  · simp [hWeightDepthBudget_eq]
  · constructor
    · simp [hWeightWidthBudget_eq]
    · constructor
      · rw [hWeightDepthBudget_eq]
        exact hWeightDepthToBase
      · constructor
        · exact hLocalDepthToBase_input
        · constructor
          · simp [hProductDepthBudget_eq]
          · constructor
            · simp [hProductWidthBudget_eq]
            · constructor
              · intro wWeight wLocal hwWeight hwLocal
                have hsum : wWeight + wLocal + 2 * nMul ≤ productWidthBudget := by
                  omega
                rw [hProductParameterBudget_eq]
                exact hmono_gen hsum
              · constructor
                · rw [hGlobalWidthBudget_eq]
                  simp
                · rw [hGlobalParameterBudget_eq]
                  rw [hGlobalWidthBudget_eq]
                  simp

theorem exists_reluNetworkClass_holderSmooth_unitCube_approximation_from_geometry_and_coefficient_bound
    {d m r nLocal nWeight nMul Dbase
      weightDepthBudget weightWidthBudget
      localDepthBudget localWidthBudget localParameterBudget
      productDepthBudget productWidthBudget productParameterBudget
      globalWidthBudget globalParameterBudget : ℕ}
    (hd : 0 < d) (hnLocal : 0 < nLocal) (hnWeight : 0 < nWeight)
    (hnMul : 0 < nMul) (hDbase : 0 < Dbase)
    {beta C B coeffBound localEps productRadius weightRadius weightEta
      productDelta activeNormRadius : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (hactiveNorm_nonneg : 0 ≤ activeNormRadius)
    (hCoeff_nonneg : 0 ≤ coeffBound)
    (hWeightRadius : 1 < weightRadius) (hProductRadius : 0 < productRadius)
    (hWeightEta_nonneg : 0 ≤ weightEta)
    (hWeightStepError :
      (∑ k ∈ Finset.range d, weightRadius ^ k) *
        (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta)
    (hWeightEta_internal : weightEta ≤ weightRadius - 1)
    (hWeightApprox_bound : 1 + weightEta ≤ productRadius)
    (hLocalDepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localDepthBudget)
    (hLocalWidthBudget :
      finiteCenteredMonomialPolynomialWidthBound nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localWidthBudget)
    (hLocalParameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localParameterBudget)
    (hLocalErrBudget :
      coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError 1 nLocal a.1.val)
        + C / (Nat.factorial r : ℝ) *
          Real.rpow activeNormRadius ((r : ℝ) + beta) ≤ localEps)
    (hLocalOutputBudget :
      coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError 1 nLocal a.1.val)
        + coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            (1 : ℝ) ^ a.1.val) ≤ productRadius)
    (hProductErrBudget :
      2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 +
        productRadius * weightEta ≤ productDelta)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hWeightDepthBudget_eq : weightDepthBudget = 2 + d)
    (hWeightWidthBudget_eq : weightWidthBudget = d * (2 + 2 * nWeight))
    (hProductDepthBudget_eq : productDepthBudget = Dbase + 1)
    (hProductWidthBudget_eq :
      productWidthBudget = weightWidthBudget + localWidthBudget + 2 * nMul)
    (hProductParameterBudget_eq :
      productParameterBudget =
        fullyConnectedReLUParameterCount d (Dbase + 1) productWidthBudget)
    (hGlobalWidthBudget_eq : globalWidthBudget = m * productWidthBudget)
    (hGlobalParameterBudget_eq :
      globalParameterBudget =
        fullyConnectedReLUParameterCount d productDepthBudget globalWidthBudget)
    (hWeightDepthToBase : 2 + d ≤ Dbase)
    (hLocalDepthToBase_input : localDepthBudget ≤ Dbase)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center scale : Fin m → Fin d → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hdomain_coord : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      ∀ q : Fin d, |x q - center j q| ≤ 1)
    (hactive_coord : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ q : Fin d, |x q - center j q| ≤ 1)
    (hactive_norm : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ‖x - center j‖ ≤ activeNormRadius)
    (hcoeff :
      ∀ j : Fin m,
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f (center j))
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            coeffBound) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈
        reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
      ∀ x : Fin d → ℝ,
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        |g x - f x| ≤ (∑ j : Fin m, productDelta) + localEps := by
  let domain : (Fin d → ℝ) → Prop := fun x => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1
  have hbud : 2 + d ≤ weightDepthBudget ∧
      d * (2 + 2 * nWeight) ≤ weightWidthBudget ∧
      weightDepthBudget ≤ Dbase ∧
      localDepthBudget ≤ Dbase ∧
      Dbase + 1 ≤ productDepthBudget ∧
      weightWidthBudget + localWidthBudget + 2 * nMul ≤ productWidthBudget ∧
      (∀ (wWeight wLocal : ℕ),
          wWeight ≤ weightWidthBudget → wLocal ≤ localWidthBudget →
            fullyConnectedReLUParameterCount d (Dbase + 1)
              (wWeight + wLocal + 2 * nMul) ≤ productParameterBudget) ∧
      (∑ j : Fin m, productWidthBudget) ≤ globalWidthBudget ∧
      fullyConnectedReLUParameterCount d productDepthBudget
          (∑ j : Fin m, productWidthBudget) ≤ globalParameterBudget := by
    exact unitCube_final_budget_constraints_from_exact_schedule
      hWeightDepthBudget_eq hWeightWidthBudget_eq hProductDepthBudget_eq
      hProductWidthBudget_eq hProductParameterBudget_eq hGlobalWidthBudget_eq
      hGlobalParameterBudget_eq hWeightDepthToBase hLocalDepthToBase_input
  have hloc : ∃ localApprox : Fin m → (Fin d → ℝ) → ℝ,
      (∀ (j : Fin m),
          localApprox j ∈ reluNetworkClass d localDepthBudget localWidthBudget localParameterBudget) ∧
      (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        (∀ (q : Fin d),
            scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |localApprox j x - f x| ≤ localEps) ∧
      (∀ (j : Fin m) (x : Fin d → ℝ), domain x → |localApprox j x| ≤ productRadius) := by
    exact finite_holderSmooth_local_table_reluNetworkClass_active_cell_error_and_domain_output_bound
      hd hnLocal hbeta_nonneg hC hactiveNorm_nonneg hCoeff_nonneg
      (by norm_num : 0 < (1 : ℝ))
      hLocalDepthBudget hLocalWidthBudget hLocalParameterBudget
      domain f hf center scale hcoeff hLocalErrBudget
      hdomain_coord hactive_coord hactive_norm hLocalOutputBudget
  exact exists_reluNetworkClass_axisAligned_tent_partition_approximation_from_bounded_local_table_on_domain
    hnWeight hnMul hDbase hWeightRadius hProductRadius hWeightEta_nonneg
    domain f center scale hscale hpartition hloc
    hWeightStepError hWeightEta_internal hWeightApprox_bound
    hbud.1 hbud.2.1 hbud.2.2.1 hbud.2.2.2.1 hbud.2.2.2.2.1 hbud.2.2.2.2.2.1
    hbud.2.2.2.2.2.2.1 hProductErrBudget hProductDelta_nonneg
    hbud.2.2.2.2.2.2.2.1 hbud.2.2.2.2.2.2.2.2

theorem exists_reluNetworkClass_holderSmooth_unitCube_approximation_from_exact_grid
    {d K r nLocal nWeight nMul Dbase
      weightDepthBudget weightWidthBudget
      localDepthBudget localWidthBudget localParameterBudget
      productDepthBudget productWidthBudget productParameterBudget
      globalWidthBudget globalParameterBudget : ℕ}
    (hd : 0 < d) (hK : 0 < K)
    (hnLocal : 0 < nLocal) (hnWeight : 0 < nWeight)
    (hnMul : 0 < nMul) (hDbase : 0 < Dbase)
    {beta C B weightRadius weightEta : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (hWeightRadius : 1 < weightRadius)
    (hWeightEta_nonneg : 0 ≤ weightEta)
    (hWeightStepError :
      (∑ k ∈ Finset.range d, weightRadius ^ k) *
        (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta)
    (hWeightEta_internal : weightEta ≤ weightRadius - 1)
    (hLocalDepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localDepthBudget)
    (hLocalWidthBudget :
      finiteCenteredMonomialPolynomialWidthBound nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localWidthBudget)
    (hLocalParameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localParameterBudget)
    (hWeightDepthBudget_eq : weightDepthBudget = 2 + d)
    (hWeightWidthBudget_eq : weightWidthBudget = d * (2 + 2 * nWeight))
    (hProductDepthBudget_eq : productDepthBudget = Dbase + 1)
    (hProductWidthBudget_eq :
      productWidthBudget = weightWidthBudget + localWidthBudget + 2 * nMul)
    (hProductParameterBudget_eq :
      productParameterBudget =
        fullyConnectedReLUParameterCount d (Dbase + 1) productWidthBudget)
    (hGlobalWidthBudget_eq :
      globalWidthBudget = ((K + 1) ^ d) * productWidthBudget)
    (hGlobalParameterBudget_eq :
      globalParameterBudget =
        fullyConnectedReLUParameterCount d productDepthBudget globalWidthBudget)
    (hWeightDepthToBase : 2 + d ≤ Dbase)
    (hLocalDepthToBase_input : localDepthBudget ≤ Dbase)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B) :
    ∃ A productRadius productDelta : ℝ,
      0 ≤ A ∧
      1 + weightEta ≤ productRadius ∧
      A *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError 1 nLocal a.1.val)
        + A *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            (1 : ℝ) ^ a.1.val) ≤ productRadius ∧
      productDelta =
        2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 +
          productRadius * weightEta ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈
            reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
          ∀ x : Fin d → ℝ,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
            |g x - f x| ≤
              (∑ j : Fin ((K + 1) ^ d), productDelta) +
                (A *
                    (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      centeredMonomialApproxError 1 nLocal a.1.val)
                  + C / (Nat.factorial r : ℝ) *
                    Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹)
                      ((r : ℝ) + beta)) := by
  obtain ⟨center, scale, hscale_nonneg, hcenter_bounds, hcoord_bound1, hpartition, hactive_coord,
      hactive_norm⟩ :=
    exists_unitCube_axisAlignedBoxTentWeight_partition_data_with_domain_coord_bound d K hK
  obtain ⟨A, hA_nonneg, hA_bound⟩ :=
    finite_taylor_coefficient_table_admits_nonnegative_bound (r := r) f center
  let activeNormRadius : ℝ := Real.sqrt (d : ℝ) * (K : ℝ)⁻¹
  let localEps : ℝ :=
    A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialApproxError 1 nLocal a.1.val) +
      C / (Nat.factorial r : ℝ) * Real.rpow activeNormRadius ((r : ℝ) + beta)
  let localOutput : ℝ :=
    A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialApproxError 1 nLocal a.1.val) +
      A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val)
  let productRadius : ℝ := max (1 + weightEta) localOutput + 1
  let productDelta : ℝ := 2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 + productRadius * weightEta
  have h1_plus_eta_le : 1 + weightEta ≤ productRadius := by
    have h := le_max_left (1 + weightEta) localOutput
    dsimp [productRadius]
    linarith
  have h_activeNorm_nonneg : 0 ≤ activeNormRadius := by
    exact mul_nonneg (Real.sqrt_nonneg (d : ℝ)) (inv_nonneg.mpr (by exact_mod_cast (le_of_lt hK)))
  have h_productRadius_pos : 0 < productRadius := by
    have h := le_max_left (1 + weightEta) localOutput
    dsimp [productRadius]
    linarith [hWeightEta_nonneg, h]
  have h_localOutput_le : localOutput ≤ productRadius := by
    have h := le_max_right (1 + weightEta) localOutput
    dsimp [productRadius]
    linarith
  have h_productDelta_nonneg : 0 ≤ productDelta := by
    dsimp [productDelta]
    have h1 : 0 ≤ 2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 := by
      positivity
    have h2 : 0 ≤ productRadius * weightEta := by
      exact mul_nonneg (le_of_lt h_productRadius_pos) hWeightEta_nonneg
    linarith
  have h_active_coord : ∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
      (∀ (q : Fin d), x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ (q : Fin d), scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      ∀ (q : Fin d), |x q - center j q| ≤ 1 := by
    intro j x hx hact q
    have hq : |x q - center j q| ≤ (K : ℝ)⁻¹ := hactive_coord j x hx hact q
    have hKinv_le_one : (K : ℝ)⁻¹ ≤ 1 := by
      have hKpos : 0 < (K : ℝ) := by exact_mod_cast hK
      have hKge1 : (1 : ℝ) ≤ (K : ℝ) := by exact_mod_cast (Nat.succ_le_of_lt hK)
      simpa using (inv_le_inv₀ hKpos zero_lt_one).mpr hKge1
    calc
      |x q - center j q| ≤ (K : ℝ)⁻¹ := hq
      _ ≤ 1 := hKinv_le_one
  refine ⟨A, productRadius, productDelta, hA_nonneg, h1_plus_eta_le, ?_, ?_, ?_⟩
  · simpa [localOutput] using h_localOutput_le
  · rfl
  · exact
      exists_reluNetworkClass_holderSmooth_unitCube_approximation_from_geometry_and_coefficient_bound
        (d := d) (m := (K + 1) ^ d) (r := r) (nLocal := nLocal) (nWeight := nWeight)
        (nMul := nMul) (Dbase := Dbase)
        (weightDepthBudget := weightDepthBudget) (weightWidthBudget := weightWidthBudget)
        (localDepthBudget := localDepthBudget) (localWidthBudget := localWidthBudget)
        (localParameterBudget := localParameterBudget)
        (productDepthBudget := productDepthBudget) (productWidthBudget := productWidthBudget)
        (productParameterBudget := productParameterBudget)
        (globalWidthBudget := globalWidthBudget) (globalParameterBudget := globalParameterBudget)
        hd hnLocal hnWeight hnMul hDbase
        (beta := beta) (C := C) (B := B) (coeffBound := A) (localEps := localEps)
        (productRadius := productRadius) (weightRadius := weightRadius) (weightEta := weightEta)
        (productDelta := productDelta) (activeNormRadius := activeNormRadius)
        hbeta_nonneg hC h_activeNorm_nonneg hA_nonneg hWeightRadius h_productRadius_pos
        hWeightEta_nonneg hWeightStepError hWeightEta_internal h1_plus_eta_le
        hLocalDepthBudget hLocalWidthBudget hLocalParameterBudget
        (by rfl) h_localOutput_le (by rfl) h_productDelta_nonneg
        hWeightDepthBudget_eq hWeightWidthBudget_eq hProductDepthBudget_eq hProductWidthBudget_eq
        hProductParameterBudget_eq hGlobalWidthBudget_eq hGlobalParameterBudget_eq
        hWeightDepthToBase hLocalDepthToBase_input
      f hf center scale
      hscale_nonneg hpartition hcoord_bound1 h_active_coord hactive_norm hA_bound

theorem exists_reluNetworkClass_holderSmooth_unitCube_approximation_from_exact_grid_and_error_budget
    {d K r nLocal nWeight nMul Dbase
      weightDepthBudget weightWidthBudget localDepthBudget localWidthBudget localParameterBudget
      productDepthBudget productWidthBudget productParameterBudget
      globalWidthBudget globalParameterBudget : ℕ}
    (hd : 0 < d) (hK : 0 < K)
    (hnLocal : 0 < nLocal) (hnWeight : 0 < nWeight)
    (hnMul : 0 < nMul) (hDbase : 0 < Dbase)
    {beta C B coeffBound localEps productRadius weightRadius weightEta productDelta eps : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C)
    (hCoeff_nonneg : 0 ≤ coeffBound)
    (hWeightRadius : 1 < weightRadius) (hProductRadius : 0 < productRadius)
    (hWeightEta_nonneg : 0 ≤ weightEta)
    (hWeightStepError :
      (∑ k ∈ Finset.range d, weightRadius ^ k) *
        (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta)
    (hWeightEta_internal : weightEta ≤ weightRadius - 1)
    (hWeightApprox_bound : 1 + weightEta ≤ productRadius)
    (hLocalDepthBudget :
      finiteCenteredMonomialPolynomialDepthBound
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localDepthBudget)
    (hLocalWidthBudget :
      finiteCenteredMonomialPolynomialWidthBound nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localWidthBudget)
    (hLocalParameterBudget :
      finiteCenteredMonomialPolynomialParameterBound d nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => a.1.val) ≤ localParameterBudget)
    (hLocalErrBudget :
      coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError 1 nLocal a.1.val)
        + C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta) ≤ localEps)
    (hLocalOutputBudget :
      coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialApproxError 1 nLocal a.1.val)
        + coeffBound *
          (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            (1 : ℝ) ^ a.1.val) ≤ productRadius)
    (hProductErrBudget :
      2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 + productRadius * weightEta ≤ productDelta)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hGlobalErrBudget :
      (∑ j : Fin ((K + 1) ^ d), productDelta) + localEps ≤ eps)
    (hWeightDepthBudget_eq : weightDepthBudget = 2 + d)
    (hWeightWidthBudget_eq : weightWidthBudget = d * (2 + 2 * nWeight))
    (hProductDepthBudget_eq : productDepthBudget = Dbase + 1)
    (hProductWidthBudget_eq :
      productWidthBudget = weightWidthBudget + localWidthBudget + 2 * nMul)
    (hProductParameterBudget_eq :
      productParameterBudget =
        fullyConnectedReLUParameterCount d (Dbase + 1) productWidthBudget)
    (hGlobalWidthBudget_eq :
      globalWidthBudget = ((K + 1) ^ d) * productWidthBudget)
    (hGlobalParameterBudget_eq :
      globalParameterBudget =
        fullyConnectedReLUParameterCount d productDepthBudget globalWidthBudget)
    (hWeightDepthToBase : 2 + d ≤ Dbase)
    (hLocalDepthToBase_input : localDepthBudget ≤ Dbase)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (hCoeffBound :
      ∀ y : Fin d → ℝ,
        (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f y)
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            coeffBound) :
    ∃ g : (Fin d → ℝ) → ℝ,
      g ∈ reluNetworkClass d productDepthBudget globalWidthBudget globalParameterBudget ∧
        ∀ x : Fin d → ℝ,
          (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → |g x - f x| ≤ eps := by
  obtain ⟨center, scale, hscale_nonneg, hcenter_in_cube, hcoord_bound, hpartition,
      hactive_coord, hactive_norm⟩ :=
    exists_unitCube_axisAlignedBoxTentWeight_partition_data_with_domain_coord_bound d K hK
  let activeNormRadius : ℝ := Real.sqrt (d : ℝ) * (K : ℝ)⁻¹
  have hKcast_pos : 0 < (K : ℝ) := by exact_mod_cast hK
  have hKcast_one : (1 : ℝ) ≤ (K : ℝ) := by exact_mod_cast (Nat.succ_le_of_lt hK)
  have hKinv_le_one : (K : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hKcast_one
  have hactiveNormRadius_nonneg : 0 ≤ activeNormRadius := by
    dsimp [activeNormRadius]
    exact mul_nonneg (Real.sqrt_nonneg (d : ℝ)) (inv_nonneg.mpr (le_of_lt hKcast_pos))
  have hactive_coord_one :
      ∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
        (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∀ q : Fin d, scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        ∀ q : Fin d, |x q - center j q| ≤ 1 := by
    intro j x hx hactive q
    exact le_trans (hactive_coord j x hx hactive q) hKinv_le_one
  have hcoeff_centers :
      ∀ j : Fin ((K + 1) ^ d),
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f (center j))
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            coeffBound := by
    intro j a
    exact hCoeffBound (center j) (hcenter_in_cube j) a
  obtain ⟨g, hg_class, hg_err⟩ :=
    exists_reluNetworkClass_holderSmooth_unitCube_approximation_from_geometry_and_coefficient_bound
      (d := d) (m := (K + 1) ^ d) (r := r) (nLocal := nLocal) (nWeight := nWeight)
      (nMul := nMul) (Dbase := Dbase) (weightDepthBudget := weightDepthBudget)
      (weightWidthBudget := weightWidthBudget) (localDepthBudget := localDepthBudget)
      (localWidthBudget := localWidthBudget) (localParameterBudget := localParameterBudget)
      (productDepthBudget := productDepthBudget) (productWidthBudget := productWidthBudget)
      (productParameterBudget := productParameterBudget) (globalWidthBudget := globalWidthBudget)
      (globalParameterBudget := globalParameterBudget)
      hd hnLocal hnWeight hnMul hDbase
      (beta := beta) (C := C) (B := B) (coeffBound := coeffBound) (localEps := localEps)
      (productRadius := productRadius) (weightRadius := weightRadius) (weightEta := weightEta)
      (productDelta := productDelta) (activeNormRadius := activeNormRadius)
      hbeta_nonneg hC hactiveNormRadius_nonneg hCoeff_nonneg hWeightRadius hProductRadius
      hWeightEta_nonneg hWeightStepError hWeightEta_internal hWeightApprox_bound
      hLocalDepthBudget hLocalWidthBudget hLocalParameterBudget
      hLocalErrBudget hLocalOutputBudget hProductErrBudget hProductDelta_nonneg
      hWeightDepthBudget_eq hWeightWidthBudget_eq hProductDepthBudget_eq hProductWidthBudget_eq
      hProductParameterBudget_eq hGlobalWidthBudget_eq hGlobalParameterBudget_eq
      hWeightDepthToBase hLocalDepthToBase_input
      f hf (center := center) (scale := scale)
      hscale_nonneg hpartition hcoord_bound hactive_coord_one hactive_norm hcoeff_centers
  refine ⟨g, hg_class, ?_⟩
  intro x hx
  exact le_trans (hg_err x hx) hGlobalErrBudget

theorem holderSmoothBall_unitCube_taylor_coefficients_admit_function_bound
    {d r : ℕ} {beta C B : ℝ}
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B) :
    ∃ A : ℝ, 0 ≤ A ∧
      ∀ y : Fin d → ℝ,
        (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f y)
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            A := by
  cases r with
  | zero =>
      refine ⟨max B 0, ?_, ?_⟩
      · exact le_max_right B 0
      · intro y hy a
        rcases a with ⟨k, g⟩
        rcases k with ⟨kval, hklt⟩
        have hk0 : kval = 0 := by omega
        subst kval
        calc
          |((Nat.factorial 0 : ℝ)⁻¹) *
              (iteratedFDeriv ℝ 0 f y) (fun q : Fin 0 => fun u : Fin d => if u = g q then 1 else 0)|
              = |f y| := by
                  simp [iteratedFDeriv, ContinuousMultilinearMap.uncurry0_apply]
          _ ≤ B := hf.2 y
          _ ≤ max B 0 := le_max_left B 0
  | succ r' =>
      let CoeffIdx : Type := Sigma (fun k : Fin (r' + 1 + 1) => Fin k.val → Fin d)
      let cube : Set (Fin d → ℝ) := {y | ∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1}
      let coeff : CoeffIdx → (Fin d → ℝ) → ℝ :=
        fun a y =>
          ((Nat.factorial a.1.val : ℝ)⁻¹) *
            (iteratedFDeriv ℝ a.1.val f y)
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
      have hcube_compact : IsCompact cube := by
        simpa [cube] using
          (isCompact_pi_infinite (s := fun i : Fin d => Set.Icc (0 : ℝ) 1)
            (fun i : Fin d => isCompact_Icc))
      have hcont_iter :
          ∀ k : ℕ, k ≤ r' + 1 → Continuous (fun y : Fin d → ℝ => iteratedFDeriv ℝ k f y) := by
        intro k hk
        exact ContDiff.continuous_iteratedFDeriv (by exact_mod_cast hk) hf.1.1
      have hcont_coeff :
          ∀ a : CoeffIdx, Continuous (fun y : Fin d → ℝ => coeff a y) := by
        intro a
        have hk_le : a.1.val ≤ r' + 1 := by
          have hlt := a.1.isLt
          omega
        have hc_eval : Continuous
            (fun L : ContinuousMultilinearMap ℝ (fun _ : Fin a.1.val => Fin d → ℝ) ℝ =>
              L (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)) := by
          fun_prop
        have hc1 : Continuous (fun y : Fin d → ℝ =>
            (iteratedFDeriv ℝ a.1.val f y)
              (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)) := by
          exact hc_eval.comp (hcont_iter a.1.val hk_le)
        simpa [coeff] using (continuous_const.mul hc1)
      have hbound :
          ∀ a : CoeffIdx, ∃ M : ℝ, 0 ≤ M ∧ ∀ y ∈ cube, |coeff a y| ≤ M := by
        intro a
        have hcont_a : ContinuousOn (fun y : Fin d → ℝ => coeff a y) cube :=
          (hcont_coeff a).continuousOn
        rcases IsCompact.exists_bound_of_continuousOn hcube_compact hcont_a with ⟨M0, hM0⟩
        refine ⟨max M0 0, le_max_right M0 0, ?_⟩
        intro y hy
        have hnorm : |coeff a y| ≤ M0 := by
          simpa using hM0 y hy
        exact le_trans hnorm (le_max_left M0 0)
      let M : CoeffIdx → ℝ := fun a => Classical.choose (hbound a)
      have hM : ∀ (a : CoeffIdx) (y : Fin d → ℝ), y ∈ cube → |coeff a y| ≤ M a := by
        intro a y hy
        exact (Classical.choose_spec (hbound a)).2 y hy
      refine ⟨∑ a : CoeffIdx, max (M a) 0, ?_, ?_⟩
      · exact Finset.sum_nonneg (fun a _ => le_max_right (M a) 0)
      · intro y hy a
        have h1 : |coeff a y| ≤ M a := hM a y hy
        have h2 : M a ≤ max (M a) 0 := le_max_left (M a) 0
        have h3 : max (M a) 0 ≤ ∑ a' : CoeffIdx, max (M a') 0 := by
          exact Finset.single_le_sum (fun a' _ => le_max_right (M a') 0) (Finset.mem_univ a)
        exact le_trans (le_trans h1 h2) h3

private lemma succAbove_predAbove_zero {n : ℕ} [NeZero n] {j : Fin (n + 1)} (hj : j ≠ 0) :
    Fin.succAbove (0 : Fin (n + 1)) (Fin.predAbove (0 : Fin n) j) = j := by
  simpa using (Fin.succAbove_predAbove (p := (0 : Fin n)) (i := j) (by simpa using hj))


set_option maxHeartbeats 1000000 in
private lemma iteratedFDeriv_perm_symm {d n : ℕ} (f : (Fin d → ℝ) → ℝ)
    (hc : ContDiff ℝ (↑n) f) :
    ∀ (y : Fin d → ℝ) (v : Fin n → Fin d → ℝ) (σ : Equiv.Perm (Fin n)),
      (iteratedFDeriv ℝ n f y) (v ∘ σ) = (iteratedFDeriv ℝ n f y) v := by
  induction n generalizing f with
  | zero =>
      intro y v σ
      have hv : v ∘ σ = v := by
        funext q
        exact Fin.elim0 q
      rw [hv]
  | succ n ih =>
      intro y v τ
      have hcn : ContDiff ℝ (↑n) f := by
        exact hc.of_le (by
          exact_mod_cast (by omega : n ≤ n + 1))
      by_cases hn0 : n = 0
      · -- n = 0: the only permutation of Fin 1 is the identity
        have hτ : τ = 1 := by
          ext i
          have h1 : (1 : Equiv.Perm (Fin (n + 1))) i = i := rfl
          rw [h1]
          have hiτ : (τ i).val < 1 := by simpa [hn0] using (τ i).isLt
          have hii : i.val < 1 := by simpa [hn0] using i.isLt
          omega
        have hv : v ∘ τ = v := by
          rw [hτ]
          simp
        rw [hv]
      · -- n ≥ 1
        have hn : 1 ≤ n := by omega
        haveI : NeZero n := ⟨by omega⟩
        let one : Fin (n+1) := ⟨1, by omega⟩
        -- invariance under permutations that fix position 0
        have hfix0 : ∀ v : Fin (n+1) → Fin d → ℝ, ∀ τ : Equiv.Perm (Fin (n+1)), τ 0 = 0 →
            (iteratedFDeriv ℝ (n+1) f y) (v ∘ τ) = (iteratedFDeriv ℝ (n+1) f y) v := by
          intro v τ hτ0
          -- induced permutation on Fin n (drop position 0)
          have hτne0 : ∀ q : Fin n, τ (Fin.succ q) ≠ (0 : Fin (n+1)) := by
            intro q h
            exfalso
            apply (Fin.succ_ne_zero q)
            apply τ.injective
            rw [h, hτ0]
          let g : Fin n → Fin n :=
            fun q : Fin n => Fin.predAbove (0 : Fin n) (τ (Fin.succ q))
          have hgbij : Function.Bijective g := by
            constructor
            · intro q q' hqq
              apply Fin.succ_inj.mp
              apply τ.injective
              have h1 : Fin.succAbove (0 : Fin (n+1)) (Fin.predAbove (0 : Fin n) (τ (Fin.succ q))) = τ (Fin.succ q) := by
                exact succAbove_predAbove_zero (hτne0 q)
              have h2 : Fin.succAbove (0 : Fin (n+1)) (Fin.predAbove (0 : Fin n) (τ (Fin.succ q'))) = τ (Fin.succ q') := by
                exact succAbove_predAbove_zero (hτne0 q')
              have hh : Fin.succAbove (0 : Fin (n+1)) (Fin.predAbove (0 : Fin n) (τ (Fin.succ q))) =
                        Fin.succAbove (0 : Fin (n+1)) (Fin.predAbove (0 : Fin n) (τ (Fin.succ q'))) :=
                congrArg (Fin.succAbove (0 : Fin (n+1))) (by simpa using hqq)
              rwa [h1, h2] at hh
            · intro p
              let x : Fin (n+1) := Fin.succAbove (0 : Fin (n+1)) p
              have hx0 : x ≠ 0 := by
                simpa [x, Fin.succAbove_zero] using (Fin.succ_ne_zero p)
              rcases τ.surjective x with ⟨t, ht⟩
              have ht0 : t ≠ 0 := by
                intro ht0
                apply hx0
                rw [← ht]
                simpa [ht0, hτ0]
              let q : Fin n := Fin.predAbove (0 : Fin n) t
              refine ⟨q, ?_⟩
              have hqs : Fin.succ q = t := by
                have hs : Fin.succAbove (0 : Fin (n+1)) (Fin.predAbove (0 : Fin n) t) = t := by
                  exact succAbove_predAbove_zero ht0
                simpa [q, Fin.succAbove_zero] using hs
              change Fin.predAbove (0 : Fin n) (τ q.succ) = p
              rw [hqs, ht]
              simpa [x, Fin.succAbove_zero] using (Fin.predAbove_succAbove (0 : Fin n) p)
          let τ' : Equiv.Perm (Fin n) := Equiv.ofBijective g hgbij
          have hfixed : (v ∘ τ) 0 = v 0 := by simp [hτ0]
          have htail : Fin.tail (v ∘ τ) = (Fin.tail v) ∘ τ' := by
            funext q
            have hτsucc : τ (Fin.succ q) = (τ' q).succ := by
              calc
                τ q.succ = Fin.succAbove (0 : Fin (n + 1)) (Fin.predAbove (0 : Fin n) (τ q.succ)) :=
                  (succAbove_predAbove_zero (hτne0 q)).symm
                _ = Fin.succAbove (0 : Fin (n + 1)) (τ' q) := by
                  rfl
                _ = (τ' q).succ := by
                  rw [Fin.succAbove_zero]
            calc
              Fin.tail (v ∘ τ) q = v (τ q.succ) := rfl
              _ = v ((τ' q).succ) := by rw [hτsucc]
              _ = (Fin.tail v ∘ τ') q := rfl
          -- derived relation: (fderiv(D^n f) y a)(w∘τ') = (fderiv(D^n f) y a) w
          have hderiv : ∀ a : Fin d → ℝ, ∀ w : Fin n → Fin d → ℝ, ∀ τ' : Equiv.Perm (Fin n),
              (fderiv ℝ (iteratedFDeriv ℝ n f) y a) (w ∘ τ') = (fderiv ℝ (iteratedFDeriv ℝ n f) y a) w := by
            intro a w τ'
            let evw : ContinuousMultilinearMap ℝ (fun _ : Fin n => Fin d → ℝ) ℝ →L[ℝ] ℝ :=
              LinearMap.mkContinuous
                { toFun := fun L : ContinuousMultilinearMap ℝ (fun _ : Fin n => Fin d → ℝ) ℝ => L w
                  map_add' := by intro L M; rfl
                  map_smul' := by intro c L; rfl }
                (∏ i : Fin n, ‖w i‖)
                (by
                  intro L
                  simpa [mul_comm] using ContinuousMultilinearMap.le_opNorm L w)
            let evwt : ContinuousMultilinearMap ℝ (fun _ : Fin n => Fin d → ℝ) ℝ →L[ℝ] ℝ :=
              LinearMap.mkContinuous
                { toFun := fun L : ContinuousMultilinearMap ℝ (fun _ : Fin n => Fin d → ℝ) ℝ => L (w ∘ τ')
                  map_add' := by intro L M; rfl
                  map_smul' := by intro c L; rfl }
                (∏ i : Fin n, ‖(w ∘ τ') i‖)
                (by
                  intro L
                  simpa [mul_comm] using ContinuousMultilinearMap.le_opNorm L (w ∘ τ'))
            have hdiffDn : DifferentiableAt ℝ (iteratedFDeriv ℝ n f) y := by
              exact ContDiffAt.differentiableAt_iteratedFDeriv hc.contDiffAt (by
                exact_mod_cast (by omega : n < n + 1))
            have hfun : (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) w) =
                        fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) (w ∘ τ') := by
              funext x
              exact (ih f hcn x w τ').symm
            have hfd : fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) w) y =
                       fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) (w ∘ τ')) y := by
              rw [hfun]
            have hg1 : HasFDerivAt (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) w)
                (evw.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y)) y := by
              simpa [evw, Function.comp_def] using
                (HasFDerivAt.comp y (evw.hasFDerivAt) hdiffDn.hasFDerivAt)
            have hfd1 : fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) w) y =
                evw.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y) :=
              hg1.fderiv
            have hg2 : HasFDerivAt (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) (w ∘ τ'))
                (evwt.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y)) y := by
              simpa [evwt, Function.comp_def] using
                (HasFDerivAt.comp y (evwt.hasFDerivAt) hdiffDn.hasFDerivAt)
            have hfd2 : fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ n f x) (w ∘ τ')) y =
                evwt.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y) :=
              hg2.fderiv
            have hh : evwt.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y) =
                evw.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y) := by
              rw [← hfd2, ← hfd1]
              exact hfd.symm
            calc
              (fderiv ℝ (iteratedFDeriv ℝ n f) y a) (w ∘ τ') =
                  (evwt.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y)) a := by
                rfl
              _ = (evw.comp (fderiv ℝ (iteratedFDeriv ℝ n f) y)) a := by
                rw [hh]
              _ = (fderiv ℝ (iteratedFDeriv ℝ n f) y a) w := by
                rfl
          calc
            (iteratedFDeriv ℝ (n+1) f y) (v ∘ τ)
                = (fderiv ℝ (iteratedFDeriv ℝ n f) y ((v ∘ τ) 0)) (Fin.tail (v ∘ τ)) := by
                  rw [iteratedFDeriv_succ_apply_left]
            _ = (fderiv ℝ (iteratedFDeriv ℝ n f) y (v 0)) ((Fin.tail v) ∘ τ') := by
                  rw [hfixed, htail]
            _ = (fderiv ℝ (iteratedFDeriv ℝ n f) y (v 0)) (Fin.tail v) := by
                  rw [hderiv (v 0) (Fin.tail v) τ']
            _ = (iteratedFDeriv ℝ (n+1) f y) v := by
                  rw [iteratedFDeriv_succ_apply_left]
        -- (0 1)-invariance of D^{n+1} f y: Clairaut on h := D^{n-1} f.
        --   Bridge: (fderiv (D^n f) y a)(Fin.cons b m) = (fderiv (fderiv h) y a) b m via the
        --   chain rule through the evaluation functionals (LinearMap.mkContinuous), so no
        --   curry/uncurry naming is needed; then apply second_derivative_symmetric to h.
        have h01 : ∀ v : Fin (n+1) → Fin d → ℝ,
            (iteratedFDeriv ℝ (n+1) f y) (v ∘ Equiv.swap (0 : Fin (n+1)) one) =
              (iteratedFDeriv ℝ (n+1) f y) v := by
          -- @step s1: For a fixed tail z : Fin (n - 1) → (Fin d → ℝ), define g_z(x) = (iteratedFDeriv ℝ (n-1) f x) z and prove g_z is twice continuously differentiable (ContDiff ℝ 2 g_z), including the n = 1 case where n - 1 = 0 reduces g_z to f (use hc together with E8/E9).
          have hs1 : ∀ z : Fin (n - 1) → Fin d → ℝ,
              ContDiff ℝ 2 (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) := by
                intro z
                have hD : ContDiff ℝ 2 (fun x : Fin d → ℝ => iteratedFDeriv ℝ (n - 1) f x) := by
                  rw [contDiff_iff_contDiffAt]
                  intro x
                  apply ContDiffAt.iteratedFDeriv_right (i := n - 1) (m := 2)
                  · exact (contDiff_iff_contDiffAt.mp hc) x
                  · exact_mod_cast (by omega : (2 : ℕ) + (n - 1) ≤ n + 1)
                simpa using (ContinuousLinearMap.contDiff
                    (ContinuousMultilinearMap.apply ℝ (fun _ : Fin (n - 1) => Fin d → ℝ) ℝ z)).comp hD
          -- @step s2: Prove the derivative bridge: for every x and every u : Fin d → ℝ, (fderiv ℝ g_z x) u = (iteratedFDeriv ℝ n f x) (Fin.cons u z), via iteratedFDeriv_succ_apply_left (E7) and the differentiability of iteratedFDeriv (n-1) f (E9).
          have hs2 : ∀ (z : Fin (n - 1) → Fin d → ℝ) (x u : Fin d → ℝ),
              (fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) x) u =
                (iteratedFDeriv ℝ (n - 1 + 1) f x) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) u z) := by
            intro z x u
            rw [iteratedFDeriv_succ_apply_left (n := n - 1) (m := Fin.cons u z)]
            simp only [Fin.cons_zero, Fin.tail_cons]
            let L : (ContinuousMultilinearMap ℝ (fun _ : Fin (n - 1) => Fin d → ℝ) ℝ) →L[ℝ] ℝ :=
              ContinuousMultilinearMap.apply ℝ (fun _ : Fin (n - 1) => Fin d → ℝ) ℝ z
            let T : (Fin d → ℝ) → ContinuousMultilinearMap ℝ (fun _ : Fin (n - 1) => Fin d → ℝ) ℝ :=
              fun x => iteratedFDeriv ℝ (n - 1) f x
            have hT_diff : DifferentiableAt ℝ T x := by
              have hcAt : ContDiffAt ℝ (↑n) f x := (contDiff_iff_contDiffAt.mp hcn) x
              exact ContDiffAt.differentiableAt_iteratedFDeriv (𝕜 := ℝ) (f := f) (m := n - 1) (n := ↑n) (x := x)
                hcAt (by exact_mod_cast (by omega : (n - 1 : ℕ) < n))
            have hT_has : HasFDerivAt T (fderiv ℝ T x) x := hT_diff.hasFDerivAt
            have hchain : HasFDerivAt (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z)
                (L.comp (fderiv ℝ T x)) x := by
              simpa [T, L, Function.comp_def, ContinuousMultilinearMap.apply] using
                (HasFDerivAt.comp x (L.hasFDerivAt) hT_has)
            have hcomp : fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) x =
                L.comp (fderiv ℝ T x) := hchain.fderiv
            calc
              (fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) x) u
                  = (L.comp (fderiv ℝ T x)) u := by rw [hcomp]
              _ = ((fderiv ℝ T x) u) z := by
                simp [L, ContinuousLinearMap.comp_apply, ContinuousMultilinearMap.apply]
          -- @step s3: Apply second_derivative_symmetric (E5) to g_z at y with f' from s2, obtaining D² g_z(y)(a,b) = D² g_z(y)(b,a) for a = v 0 and b = v one; rewrite both sides using E7 twice and close by extensionality over v.
          have hs3 : ∀ v : Fin (n + 1) → Fin d → ℝ,
              (iteratedFDeriv ℝ (n + 1) f y) (v ∘ Equiv.swap (0 : Fin (n + 1)) one) =
                      (iteratedFDeriv ℝ (n + 1) f y) v := by
                -- @step s1: For fixed tail z and all a b, D²g_z(y)(a,b) = iteratedFDeriv ℝ (n+1) f y (Fin.cons a (Fin.cons b z)); obtained by differentiating the derivative identity hs2 at y and applying iteratedFDeriv_succ_apply_left (E7).
                have h_ab : ∀ (z : Fin (n - 1) → Fin d → ℝ) (a b : Fin d → ℝ),
                    ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) w) y) a) b =
                      (iteratedFDeriv ℝ ((n - 1) + 1 + 1) f y) (Fin.cons a (Fin.cons b z)) := by
                        intro z a b
                        let F : (Fin d → ℝ) → (Fin d → ℝ) →L[ℝ] ℝ :=
                          fun w => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) w
                        have hFdiff : DifferentiableAt ℝ F y := by
                          have hFc : ContDiff ℝ 1 F := by
                            simpa [F] using
                              ((contDiff_succ_iff_fderiv (n := (1 : ℕ∞))
                                  (f := fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z)).mp (hs1 z)).2.2
                          exact hFc.differentiable (by exact_mod_cast (by norm_num : (1 : ℕ) ≠ 0)) y
                        have hclm : ((fderiv ℝ F y) a) b =
                            (fderiv ℝ (fun w : Fin d → ℝ => F w b) y) a := by
                          rw [fderiv_clm_apply (𝕜 := ℝ) (E := Fin d → ℝ) (G := Fin d → ℝ) (H := ℝ) (x := y)
                              (c := F) (u := fun _ : Fin d → ℝ => b) hFdiff (by exact differentiableAt_const (𝕜 := ℝ) b)]
                          simp [ContinuousLinearMap.flip_apply]
                        have hfunext : (fun w : Fin d → ℝ => F w b) =
                            fun w : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f w) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z) := by
                          funext w
                          simp [F]
                          exact hs2 z w b
                        let A : (Fin d → ℝ) → ContinuousMultilinearMap ℝ (fun _ : Fin ((n - 1) + 1) => Fin d → ℝ) ℝ :=
                          fun x => iteratedFDeriv ℝ ((n - 1) + 1) f x
                        let Lc : (ContinuousMultilinearMap ℝ (fun _ : Fin ((n - 1) + 1) => Fin d → ℝ) ℝ) →L[ℝ] ℝ :=
                          ContinuousMultilinearMap.apply ℝ (fun _ : Fin ((n - 1) + 1) => Fin d → ℝ) ℝ (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)
                        have hA_diff : DifferentiableAt ℝ A y := by
                          have hcAt : ContDiffAt ℝ (↑(n + 1)) f y := (contDiff_iff_contDiffAt.mp hc) y
                          exact ContDiffAt.differentiableAt_iteratedFDeriv (𝕜 := ℝ) (f := f) (m := (n - 1) + 1) (n := ↑(n + 1)) (x := y) hcAt (by exact_mod_cast (by omega : (n - 1) + 1 < n + 1))
                        have hA_has : HasFDerivAt A (fderiv ℝ A y) y := hA_diff.hasFDerivAt
                        have hchain : HasFDerivAt (fun x : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f x) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)) (Lc.comp (fderiv ℝ A y)) y := by
                          simpa [A, Lc, Function.comp_def, ContinuousMultilinearMap.apply] using
                            (HasFDerivAt.comp y (Lc.hasFDerivAt) hA_has)
                        have hcomp : fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f x) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)) y = Lc.comp (fderiv ℝ A y) := hchain.fderiv
                        have hfact2 : (fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f x) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)) y) a = ((fderiv ℝ (iteratedFDeriv ℝ ((n - 1) + 1) f) y) a) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z) := by
                          calc
                            (fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f x) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)) y) a
                                = (Lc.comp (fderiv ℝ A y)) a := by rw [hcomp]
                            _ = ((fderiv ℝ A y) a) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z) := by
                              simp [Lc, ContinuousLinearMap.comp_apply, ContinuousMultilinearMap.apply]
                        calc
                          ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) w) y) a) b
                              = ((fderiv ℝ F y) a) b := by simp [F]
                          _ = (fderiv ℝ (fun w : Fin d → ℝ => F w b) y) a := hclm
                          _ = (fderiv ℝ (fun w : Fin d → ℝ => (iteratedFDeriv ℝ ((n - 1) + 1) f w) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z)) y) a := by rw [hfunext]
                          _ = ((fderiv ℝ (iteratedFDeriv ℝ ((n - 1) + 1) f) y) a) (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z) := hfact2
                          _ = (iteratedFDeriv ℝ ((n - 1) + 1 + 1) f y) (Fin.cons a (Fin.cons b z)) := by
                            rw [iteratedFDeriv_succ_apply_left (n := (n - 1) + 1) (m := Fin.cons a (Fin.cons (n := n - 1) (α := fun _ => Fin d → ℝ) b z))]
                            simp only [Fin.cons_zero, Fin.tail_cons]
                -- @step s2: The symmetric bridge D²g_z(y)(b,a) = iteratedFDeriv ℝ (n+1) f y (Fin.cons b (Fin.cons a z)) by the same argument with a and b interchanged.
                have h_ba : ∀ (z : Fin (n - 1) → Fin d → ℝ) (a b : Fin d → ℝ),
                    ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ (n - 1) f x) z) w) y) b) a =
                      (iteratedFDeriv ℝ ((n - 1) + 1 + 1) f y) (Fin.cons b (Fin.cons a z)) := by
                        intro z a b
                        exact h_ab z b a
                -- @step s3: Apply second_derivative_symmetric (E5) to the C² function g_z (via hs1, derivative data from hs2) to get D²g_z(y)(a,b) = D²g_z(y)(b,a); combine with s1/s2 and close over v by Fin.cons decomposition.
                have h_swap : ∀ v : Fin (n + 1) → Fin d → ℝ,
                    (iteratedFDeriv ℝ (n + 1) f y) (v ∘ Equiv.swap (0 : Fin (n + 1)) one) =
                      (iteratedFDeriv ℝ (n + 1) f y) v := by
                        rcases Nat.exists_eq_add_of_le' hn with ⟨m, rfl⟩
                        intro v
                        let a : Fin d → ℝ := v 0
                        let b : Fin d → ℝ := v one
                        let z : Fin m → Fin d → ℝ := Fin.tail (Fin.tail v)
                        have hone : one = Fin.succ (0 : Fin (m + 1)) := by
                          apply Fin.ext
                          rfl
                        have hz : ∀ k : Fin m, z k = v (Fin.succ (Fin.succ k)) := by
                          intro k
                          rfl
                        -- Clairaut: D²g_z(y)(a,b) = D²g_z(y)(b,a) for g_z(x) = (iteratedFDeriv ℝ m f x) z
                        have hsym : ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y) a) b =
                                    ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y) b) a := by
                          refine second_derivative_symmetric (𝕜 := ℝ)
                            (f := fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z)
                            (f' := fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w)
                            (f'' := fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y)
                            (x := y) ?h1 ?h2 a b
                          · intro y'
                            have hgdiff : DifferentiableAt ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) y' := by
                              exact (hs1 z).differentiable (by exact_mod_cast (by norm_num : (2 : ℕ) ≠ 0)) y'
                            exact hgdiff.hasFDerivAt
                          · have hf'diff : DifferentiableAt ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y := by
                              have hf'C : ContDiff ℝ 1 (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) := by
                                simpa using
                                  ((contDiff_succ_iff_fderiv (n := (1 : ℕ∞))
                                      (f := fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z)).mp (hs1 z)).2.2
                              exact hf'C.differentiable (by exact_mod_cast (by norm_num : (1 : ℕ) ≠ 0)) y
                            exact hf'diff.hasFDerivAt
                        -- bridge through h_ab / h_ba to iteratedFDeriv
                        have hdec : (iteratedFDeriv ℝ (m + 2) f y) (Fin.cons a (Fin.cons b z)) =
                                    (iteratedFDeriv ℝ (m + 2) f y) (Fin.cons b (Fin.cons a z)) := by
                          calc
                            (iteratedFDeriv ℝ (m + 2) f y) (Fin.cons a (Fin.cons b z))
                                = ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y) a) b := (h_ab z a b).symm
                            _ = ((fderiv ℝ (fun w : Fin d → ℝ => fderiv ℝ (fun x : Fin d → ℝ => (iteratedFDeriv ℝ m f x) z) w) y) b) a := hsym
                            _ = (iteratedFDeriv ℝ (m + 2) f y) (Fin.cons b (Fin.cons a z)) := h_ba z a b
                        -- decompose v and v ∘ swap 0 one
                        have hv : v = Fin.cons a (Fin.cons b z) := by
                          rw [← Fin.cons_self_tail v]
                          congr 1
                          · funext i
                            refine Fin.cases ?h0 ?hs i
                            · simp [b, Fin.tail, hone]
                            · intro k
                              simpa [Fin.tail, Fin.cons_succ] using (hz k).symm

                        have hvswap : v ∘ Equiv.swap (0 : Fin (m + 1 + 1)) one = Fin.cons b (Fin.cons a z) := by
                          funext i
                          refine Fin.cases ?_ ?_ i
                          · rw [Function.comp_apply, Fin.cons_zero]
                            rw [Equiv.swap_apply_left]

                          · intro j
                            refine Fin.cases ?_ ?_ j
                            · rw [Function.comp_apply, Fin.cons_succ, Fin.cons_zero]
                              rw [← hone]
                              rw [Equiv.swap_apply_right]

                            · intro k
                              have hne1 : Fin.succ (Fin.succ k) ≠ one := by
                                intro h
                                have hk0 : Fin.succ k = (0 : Fin (m + 1)) := Fin.succ_inj.mp (by simpa [hone] using h)
                                exact Fin.succ_ne_zero k hk0
                              rw [Function.comp_apply, Fin.cons_succ, Fin.cons_succ]
                              rw [hz]
                              congr 1

                        rw [hvswap, hv]
                        exact hdec.symm
                exact h_swap
          exact hs3
        by_cases hτ0 : τ 0 = 0
        · exact hfix0 v τ hτ0
        · let i : Fin (n+1) := τ 0
          have hi0 : i ≠ 0 := by simpa [i] using hτ0
          have hone0 : (0 : Fin (n+1)) ≠ one := by
            intro h
            simpa [one] using congrArg Fin.val h

          let τ₀ : Equiv.Perm (Fin (n+1)) := τ.trans (Equiv.swap (0 : Fin (n+1)) i)
          have hτ₀0 : τ₀ 0 = 0 := by
            dsimp [τ₀]
            exact Equiv.swap_apply_right (a := (0 : Fin (n+1))) (b := i)
          have hτ₀eq : τ = (Equiv.swap (0 : Fin (n+1)) i) ∘ τ₀ := by
            ext x
            dsimp [τ₀]
            have hsw2 : (Equiv.swap (0 : Fin (n+1)) i) ((Equiv.swap (0 : Fin (n+1)) i) (τ x)) = τ x := by
              simpa using congrArg (fun e : Equiv.Perm (Fin (n+1)) => e (τ x)) (Equiv.swap_swap (0 : Fin (n+1)) i)
            rw [hsw2]
          have hsw : Equiv.swap (0 : Fin (n+1)) i =
              (Equiv.swap one i) ∘ (Equiv.swap (0 : Fin (n+1)) one) ∘ (Equiv.swap one i) := by
            ext x
            by_cases hx0 : x = 0
            · subst x
              by_cases hi1 : i = one
              · simp [hi1, Equiv.swap_self]
              · exact congrArg (fun z : Fin (n+1) => (z : ℕ)) (by
                  calc
                    (Equiv.swap (0 : Fin (n+1)) i) (0 : Fin (n+1)) = i :=
                      Equiv.swap_apply_left (a := (0 : Fin (n+1))) (b := i)
                    _ = (Equiv.swap one i) one := by
                      rw [Equiv.swap_apply_left (a := one) (b := i)]
                    _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) (0 : Fin (n+1))) := by
                      rw [Equiv.swap_apply_left (a := (0 : Fin (n+1))) (b := one)]
                    _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) ((Equiv.swap one i) (0 : Fin (n+1)))) := by
                      rw [Equiv.swap_apply_of_ne_of_ne hone0 hi0.symm])
            · by_cases hx1 : x = one
              · subst x
                by_cases hi1 : i = one
                · simp [hi1, Equiv.swap_self]
                · exact congrArg (fun z : Fin (n+1) => (z : ℕ)) (by
                    calc
                      (Equiv.swap (0 : Fin (n+1)) i) one = one :=
                        Equiv.swap_apply_of_ne_of_ne hone0.symm (fun h => hi1 h.symm)
                      _ = (Equiv.swap one i) i := by
                        rw [Equiv.swap_apply_right (a := one) (b := i)]
                      _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) i) := by
                        rw [Equiv.swap_apply_of_ne_of_ne hi0 hi1]
                      _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) ((Equiv.swap one i) one)) := by
                        rw [Equiv.swap_apply_left (a := one) (b := i)])
              · by_cases hxi : x = i
                · subst x
                  by_cases hi1 : i = one
                  · contradiction
                  · exact congrArg (fun z : Fin (n+1) => (z : ℕ)) (by
                      calc
                        (Equiv.swap (0 : Fin (n+1)) i) i = (0 : Fin (n+1)) :=
                          Equiv.swap_apply_right (a := (0 : Fin (n+1))) (b := i)
                        _ = (Equiv.swap one i) (0 : Fin (n+1)) := by
                          rw [Equiv.swap_apply_of_ne_of_ne hone0 hi0.symm]
                        _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) one) := by
                          rw [Equiv.swap_apply_right (a := (0 : Fin (n+1))) (b := one)]
                        _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) ((Equiv.swap one i) i)) := by
                          rw [Equiv.swap_apply_right (a := one) (b := i)])
                · exact congrArg (fun z : Fin (n+1) => (z : ℕ)) (by
                    calc
                      (Equiv.swap (0 : Fin (n+1)) i) x = x :=
                        Equiv.swap_apply_of_ne_of_ne hx0 hxi
                      _ = (Equiv.swap one i) x := by
                        rw [Equiv.swap_apply_of_ne_of_ne hx1 hxi]
                      _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) x) := by
                        rw [Equiv.swap_apply_of_ne_of_ne hx0 hx1]
                      _ = (Equiv.swap one i) ((Equiv.swap (0 : Fin (n+1)) one) ((Equiv.swap one i) x)) := by
                        rw [Equiv.swap_apply_of_ne_of_ne hx1 hxi])
          have hswi : ∀ v : Fin (n+1) → Fin d → ℝ,
              (iteratedFDeriv ℝ (n+1) f y) (v ∘ Equiv.swap (0 : Fin (n+1)) i) =
                (iteratedFDeriv ℝ (n+1) f y) v := by
            intro v'
            calc
              (iteratedFDeriv ℝ (n+1) f y) (v' ∘ Equiv.swap (0 : Fin (n+1)) i)
                  = (iteratedFDeriv ℝ (n+1) f y) (v' ∘ ((Equiv.swap one i) ∘ (Equiv.swap (0 : Fin (n+1)) one) ∘ (Equiv.swap one i))) := by
                    rw [hsw]
              _ = (iteratedFDeriv ℝ (n+1) f y) (((v' ∘ Equiv.swap one i) ∘ Equiv.swap (0 : Fin (n+1)) one) ∘ Equiv.swap one i) := by
                    rfl
              _ = (iteratedFDeriv ℝ (n+1) f y) ((v' ∘ Equiv.swap one i) ∘ Equiv.swap (0 : Fin (n+1)) one) := by
                    exact hfix0 ((v' ∘ Equiv.swap one i) ∘ Equiv.swap (0 : Fin (n+1)) one)
                      (Equiv.swap one i) (by
                        exact Equiv.swap_apply_of_ne_of_ne hone0 hi0.symm)
              _ = (iteratedFDeriv ℝ (n+1) f y) (v' ∘ Equiv.swap one i) := by
                    exact h01 (v' ∘ Equiv.swap one i)
              _ = (iteratedFDeriv ℝ (n+1) f y) v' := by
                    exact hfix0 v' (Equiv.swap one i) (by
                      exact Equiv.swap_apply_of_ne_of_ne hone0 hi0.symm)
          calc
            (iteratedFDeriv ℝ (n+1) f y) (v ∘ τ)
                = (iteratedFDeriv ℝ (n+1) f y) ((v ∘ Equiv.swap (0 : Fin (n+1)) i) ∘ τ₀) := by
                  rw [hτ₀eq]
                  rfl
            _ = (iteratedFDeriv ℝ (n+1) f y) (v ∘ Equiv.swap (0 : Fin (n+1)) i) := by
                  exact hfix0 (v ∘ Equiv.swap (0 : Fin (n+1)) i) τ₀ hτ₀0
            _ = (iteratedFDeriv ℝ (n+1) f y) v := by
                  exact hswi v

set_option maxHeartbeats 1000000 in
theorem holderSmoothBall_taylor_coefficients_admit_uniform_bound
    (d r : ℕ) {beta C B : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hB : 0 ≤ B) :
    ∃ A : ℝ, 0 ≤ A ∧
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
        ∀ y : Fin d → ℝ,
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f y)
                  (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
              A := by
  -- ── Phase 1 outline (work top-to-bottom, one step at a time) ──
  -- @step s1 (CORRECTED): Pure linear-algebra interpolation/extraction lemma for SYMMETRIC
  -- coefficient families (the ordered-tuple version without symmetry is false: permuted tuples give
  -- the same monomial, cf. proof_guide / math review).  For fixed d and r, there exist rho0 > 0, a
  -- finite index set ι of offset vectors h_i : Fin d → ℝ with ‖h_i‖ ≤ rho0, and K1 ≥ 0 such that
  -- any symmetric Taylor coefficient family c_a satisfies |c_a| ≤ K1 * M whenever all evaluations
  -- |Σ_a c_a ∏_q h_i (a.snd q)| ≤ M.
  have h_s1 :
      ∃ rho0 : ℝ, 0 < rho0 ∧ ∃ K1 : ℝ, 0 ≤ K1 ∧
        ∃ (ι : Type) (_ : Fintype ι) (h : ι → Fin d → ℝ),
          (∀ i : ι, ‖h i‖ ≤ rho0) ∧
          ∀ (c : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ),
            (∀ (k : Fin (r + 1)) (u v : Fin k.val → Fin d),
                (∃ σ : Equiv.Perm (Fin k.val), ∀ q : Fin k.val, v q = u (σ q)) →
                c ⟨k, u⟩ = c ⟨k, v⟩) →
            ∀ (M : ℝ),
              (∀ i : ι,
                  |∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      c a * ∏ q : Fin a.1.val, h i (a.2 q)| ≤ M) →
              ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                |c a| ≤ K1 * M := by
    -- Construction (proof_guide repair): rho0 := 1; N := (r+1)^d; nodes t_i := i/(N+1) ∈ [0,1),
    -- offsets h_i : Fin d → ℝ, h_i l := t_i ^ ((r+1)^l); then ‖h_i‖ ≤ 1.  By symmetry reduce the
    -- evaluation sum to a univariate polynomial q(t) = Σ_e E_e t^{n(e)} (E_e := N_e * c_e,
    -- n(e) := Σ_l e_l * (r+1)^l distinct, natDegree q ≤ N-1).  Evaluation at the N distinct nodes
    -- t_i gives an injective linear map by univariate root-counting, and Lagrange interpolation
    -- (Polynomial.interpolate) yields an explicit K1 ≥ 0 with |E_e| ≤ K1*M; finally
    -- |c a| = |c_e| = |E_e|/N_e ≤ |E_e| since N_e ≥ 1.
    refine ⟨1, ?_⟩
    refine ⟨by norm_num, ?_⟩
    -- Setup (diagonal univariate reduction): N := (r+1)^d nodes t_i = i/(N+1) ∈ [0,1) distinct;
    -- weight w_l := (r+1)^l, tuple weight wt a := Σ_q w (a.snd q); offsets h_i l := t_i ^ w_l so
    -- ∏_q h_i (a.snd q) = t_i ^ (wt a) and the evaluation sum equals the univariate polynomial
    -- P(t) = Σ_a c a * t^(wt a) evaluated at t_i.  Next: K1 via Lagrange basis, ι := Fin N.
    let N : ℕ := (r + 1) ^ d
    let t : Fin N → ℝ := fun i => (i.val : ℝ) / (N + 1 : ℝ)
    let w : Fin d → ℕ := fun l => (r + 1) ^ l.val
    -- Tuple weight (wt a = Σ_q (r+1)^(a.snd q)); K1 := coefficient-extraction constant via the
    -- Lagrange basis — a single explicit nonnegative number depending only on d and r.
    let wt : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℕ :=
      fun a => ∑ q : Fin a.1.val, w (a.2 q)
    let K1 : ℝ :=
      ∑ i : Fin N, ∑ j : Fin N,
        |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff j.val|
    refine ⟨K1, ?_, ?_⟩
    · -- 0 ≤ K1: a finite sum of absolute values.
      exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
    · -- Remaining: ι := Fin N, h i l := t i ^ w l, ‖h i‖ ≤ 1 (each |t i ^ w l| ≤ 1 since
      -- 0 ≤ t i ≤ 1), and the extraction bound |c a| ≤ K1 * M via the univariate polynomial
      -- P(t) = Σ_a c a * t^(wt a) with Lagrange interpolation at the N distinct nodes.
      refine ⟨Fin N, inferInstance, fun i l => t i ^ w l, ?_⟩
      constructor
      · -- ‖h i‖ ≤ 1: each coordinate |t i ^ w l| ≤ 1 since 0 ≤ t i ≤ 1 (t i = i/(N+1) < 1).
        intro i
        dsimp
        rw [Pi.norm_def]
        have ht_nonneg : 0 ≤ t i := by
          dsimp [t]
          positivity
        have ht_le_one : t i ≤ 1 := by
          dsimp [t]
          exact (div_le_one (by positivity)).mpr (by exact_mod_cast (Nat.le_of_lt (lt_of_lt_of_le i.isLt (Nat.le_succ N))))
        have hsup : (Finset.univ : Finset (Fin d)).sup (fun b => ‖t i ^ w b‖₊) ≤ (1 : NNReal) := by
          apply Finset.sup_le
          intro b _
          have hnonneg : 0 ≤ t i ^ w b := pow_nonneg ht_nonneg _
          have hle : t i ^ w b ≤ 1 := pow_le_one₀ ht_nonneg ht_le_one
          rw [← Real.toNNReal_eq_nnnorm_of_nonneg hnonneg]
          simpa using Real.toNNReal_mono hle

        exact_mod_cast hsup
      · -- Extraction: |c a| ≤ K1 * M.  For each node i the hypothesis heval bounds the evaluation
        -- |∑_a c a * ∏_q t i ^ w (a.2 q)| = |∑_a c a * t i ^ (wt a)| ≤ M, i.e. the univariate
        -- polynomial P := ∑_a C (c a) * X ^ (wt a) satisfies |P.eval (t i)| ≤ M for every i.  By
        -- Lagrange interpolation on the nodes t i, P = ∑_i (P.eval (t i)) * Lagrange.basis univ t i,
        -- so each coefficient |P.coeff m| ≤ (∑_i |P.eval (t i)|) * (∑_i |(basis i).coeff m|) ≤ K1*M.
        -- Symmetry: for a fixed exponent vector e (with |e| ≤ r) all tuples realizing e have the
        -- same c-value (they are permutations), so P.coeff (wt ⟨k,u⟩) = N_e * c a, and with
        -- N_e ≥ 1 we get |c a| = |P.coeff (wt a)| / N_e ≤ |P.coeff (wt a)| ≤ K1 * M.
        intro c hsym M heval a

        -- Univariate reduction: P(t) := Σ_a c a * t^(wt a) is a polynomial of degree < N whose
        -- evaluations at the N distinct nodes t_i are bounded by M (heval).  We bound its
        -- coefficients via Lagrange interpolation, then use symmetry to recover |c a|.
        let P : Polynomial ℝ :=
          ∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            Polynomial.C (c a') * Polynomial.X ^ (wt a')
        -- The N nodes t_i = i/(N+1) are pairwise distinct.
        have ht_inj : Function.Injective t := by
          intro i j hij
          apply Fin.ext
          dsimp [t] at hij ⊢
          have hden : (N : ℝ) + 1 ≠ 0 := by positivity
          have hnum : (i.val : ℝ) = (j.val : ℝ) := by
            have h' : (i.val : ℝ) * (((N : ℝ) + 1)⁻¹) = (j.val : ℝ) * (((N : ℝ) + 1)⁻¹) := by
              simpa [div_eq_mul_inv] using hij
            exact mul_right_cancel₀ (inv_ne_zero hden) h'
          exact_mod_cast hnum
        -- wt a' < N for every tuple a' (used for the degree bound): each of the ≤ r digits is < d,
        -- so the base-(r+1) value is < (r+1)^d.
        have hwt_lt : ∀ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), wt a' < N := by
          intro a'
          dsimp [wt, w]
          by_cases hd : d = 0
          · -- d = 0: no coordinates, so the weight sum is empty.
            have hk0 : a'.1.val = 0 := by
              by_contra hk
              have hkpos : 0 < a'.1.val := Nat.pos_of_ne_zero hk
              exact Fin.elim0 (Fin.cast hd (a'.2 ⟨0, hkpos⟩))
            have hwt0 : (∑ q : Fin a'.1.val, (r + 1) ^ (a'.2 q).val) = 0 := by
              apply Finset.sum_eq_zero
              intro q _
              exfalso
              exact Fin.elim0 (by simpa [hk0] using q)
            rw [hwt0]
            simp [N, hd]
          · -- d ≥ 1: at most r digits, each < d, so the base-(r+1) value is
            -- ≤ r·(r+1)^(d-1) < (r+1)^d = N.
            have hmono : ∀ m n : ℕ, m ≤ n → (r + 1) ^ m ≤ (r + 1) ^ n := by
              intro m n hmn
              induction hmn with
              | refl => rfl
              | step hmn ih =>
                  -- ih : (r+1)^m ≤ (r+1)^n; goal: (r+1)^m ≤ (r+1)^(n+1)
                  rw [pow_succ]
                  simpa [pow_succ] using le_trans ih (Nat.le_mul_of_pos_right _ (Nat.succ_pos r))
            have hk_le : a'.1.val ≤ r := Nat.le_of_lt_succ a'.1.isLt
            calc
              (∑ q : Fin a'.1.val, (r + 1) ^ (a'.2 q).val)
                  ≤ ∑ q : Fin a'.1.val, (r + 1) ^ (d - 1) := by
                    exact Finset.sum_le_sum (fun q _ =>
                      hmono (a'.2 q).val (d - 1) (by simpa [Nat.pred_eq_sub_one] using Nat.le_pred_of_lt (a'.2 q).isLt))
              _ = a'.1.val * (r + 1) ^ (d - 1) := by
                    simp [Finset.sum_const, Fintype.card_fin, nsmul_eq_mul]
              _ ≤ r * (r + 1) ^ (d - 1) := by
                    exact Nat.mul_le_mul_right _ hk_le
              _ < (r + 1) ^ d := by
                    have hXpos : 0 < (r + 1) ^ (d - 1) :=
                      (Nat.pow_pos (Nat.succ_pos r) : 0 < (r + 1) ^ (d - 1))
                    have hmul : r * (r + 1) ^ (d - 1) < (r + 1) * (r + 1) ^ (d - 1) :=
                      Nat.mul_lt_mul_of_pos_right (Nat.lt_succ_self r) hXpos
                    have hrewrite : (r + 1) * (r + 1) ^ (d - 1) = (r + 1) ^ d := by
                      rw [mul_comm, ← pow_succ]
                      congr 1
                      omega
                    rw [← hrewrite]
                    exact hmul
              _ = N := rfl
        -- P has degree < N, so Lagrange interpolation applies.
        have hdeg : P.natDegree < N := by
          have hmono : ∀ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              (Polynomial.C (c a') * Polynomial.X ^ (wt a')).natDegree ≤ wt a' := by
            intro a'
            exact Polynomial.natDegree_C_mul_X_pow_le (c a') (wt a')
          have hdeg_le : P.natDegree ≤ N - 1 := by
            dsimp [P]
            refine (Polynomial.natDegree_sum_le_of_forall_le (s := Finset.univ) (n := N - 1)
              (fun a' => Polynomial.C (c a') * Polynomial.X ^ (wt a')) ?_)
            intro a' _
            exact (by simpa [Nat.pred_eq_sub_one] using
              (Nat.le_pred_of_lt (lt_of_le_of_lt (hmono a') (hwt_lt a'))))
          have hNpos : 0 < N := by
            dsimp [N]
            exact (Nat.pow_pos (Nat.succ_pos r) : 0 < (r + 1) ^ d)
          omega
        -- Evaluations of P at the nodes are bounded by M.
        have hevalP : ∀ i : Fin N, |P.eval (t i)| ≤ M := by
          intro i
          have hEq : P.eval (t i) = ∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), c a' * (t i) ^ (wt a') := by
            dsimp [P]
            simp [Polynomial.eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_pow,
              Polynomial.eval_C, Polynomial.eval_X]
          have hev2 : |∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), c a' * (t i) ^ (wt a')| ≤ M := by
            have hprod : (∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), c a' * ∏ q : Fin a'.1.val, t i ^ w (a'.2 q)) =
                (∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), c a' * (t i) ^ (wt a')) := by
              apply Finset.sum_congr rfl
              intro a' _
              congr 1
              rw [Finset.prod_pow_eq_pow_sum]
            rw [← hprod]
            simpa using heval i
          rwa [hEq]
        -- Remaining: Lagrange interpolation identity + coefficient extraction + symmetry grouping.
        -- Interpolation identity via Lagrange.
        have hInjOn : Set.InjOn t ↑(Finset.univ : Finset (Fin N)) := ht_inj.injOn
        have hDegLt : P.degree < ↑(Finset.univ : Finset (Fin N)).card := by
          have h1 : P.degree ≤ (P.natDegree : WithBot ℕ) := Polynomial.degree_le_natDegree
          have hcard : (Finset.univ : Finset (Fin N)).card = N := by simp
          have h2 : (P.natDegree : WithBot ℕ) < ↑(Finset.univ : Finset (Fin N)).card := by
            rw [hcard]
            exact_mod_cast hdeg
          exact lt_of_le_of_lt h1 h2
        have hinterp :
            (Lagrange.interpolate (Finset.univ : Finset (Fin N)) t (fun i => P.eval (t i))) = P := by
          exact Lagrange.interpolate_poly_eq_self (s := (Finset.univ : Finset (Fin N))) (v := t) hInjOn hDegLt
        have hcoeff_sum : ∀ {α : Type} (s : Finset α) (g : α → Polynomial ℝ) (n : ℕ),
            (∑ x ∈ s, g x).coeff n = ∑ x ∈ s, (g x).coeff n := by
          intro α s g n
          classical
          refine Finset.induction_on s ?_ ?_
          · simp
          · intro x s' hxs ih
            simp [Finset.sum_insert hxs, ih, Polynomial.coeff_add]
        have hcoeff (m : ℕ) : P.coeff m = ∑ i : Fin N, P.eval (t i) * (Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m := by
          calc
            P.coeff m = (Lagrange.interpolate (Finset.univ : Finset (Fin N)) t (fun i => P.eval (t i))).coeff m := by
              exact congrArg (fun Q : Polynomial ℝ => Q.coeff m) hinterp.symm
            _ = (∑ i : Fin N, Polynomial.C (P.eval (t i)) * Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m := by
              simp [Lagrange.interpolate]
            _ = ∑ i : Fin N, P.eval (t i) * (Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m := by
              rw [hcoeff_sum (Finset.univ : Finset (Fin N)) (fun i : Fin N => Polynomial.C (P.eval (t i)) * Lagrange.basis (Finset.univ : Finset (Fin N)) t i) m]
              apply Finset.sum_congr rfl
              intro i _
              rw [Polynomial.coeff_C_mul]
        have hcoeff_le (m : ℕ) : |P.coeff m| ≤ M * (∑ i : Fin N, |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m|) := by
          rw [hcoeff m]
          calc
            |∑ i : Fin N, P.eval (t i) * (Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m|
                ≤ ∑ i : Fin N, |P.eval (t i) * (Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m| := by
                  exact Finset.abs_sum_le_sum_abs (f := fun i : Fin N => P.eval (t i) * (Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m) (s := (Finset.univ : Finset (Fin N)))
            _ = ∑ i : Fin N, |P.eval (t i)| * |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m| := by
                  simp [abs_mul]
            _ ≤ ∑ i : Fin N, M * |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m| := by
                  exact Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (hevalP i) (abs_nonneg _))
            _ = M * (∑ i : Fin N, |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m|) := by
                  rw [Finset.mul_sum]
        have hNpos : 0 < N := by
          dsimp [N]
          exact (Nat.pow_pos (Nat.succ_pos r) : 0 < (r + 1) ^ d)
        let i0 : Fin N := ⟨0, hNpos⟩
        have hM : 0 ≤ M := le_trans (abs_nonneg _) (hevalP i0)
        have hmono_sums (m : ℕ) (hm : m < N) :
            (∑ i : Fin N, |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m|) ≤ K1 := by
          dsimp [K1]
          exact Finset.sum_le_sum (fun i _ => by
            let j0 : Fin N := ⟨m, hm⟩
            have hsingle : |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m| ≤
                ∑ j : Fin N, |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff j.val| := by
              simpa [j0] using (Finset.single_le_sum
                (f := fun j : Fin N => |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff j.val|)
                (s := (Finset.univ : Finset (Fin N)))
                (fun j _ => abs_nonneg _)
                (by simp : j0 ∈ (Finset.univ : Finset (Fin N))))
            exact hsingle)
        have hcoeff_K1 (m : ℕ) (hm : m < N) : |P.coeff m| ≤ K1 * M := by
          calc
            |P.coeff m| ≤ M * (∑ i : Fin N, |(Lagrange.basis (Finset.univ : Finset (Fin N)) t i).coeff m|) := hcoeff_le m
            _ ≤ M * K1 := mul_le_mul_of_nonneg_left (hmono_sums m hm) hM
            _ = K1 * M := by ring
        -- Digit-uniqueness machinery (base-(r+1) expansion).
        have hgroup : ∀ (k : ℕ) (f : Fin k → Fin d),
            (∑ q : Fin k, (r + 1) ^ (f q).val) =
              ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin k => f q = m)).card : ℕ) * (r + 1) ^ m.val := by
          intro k
          induction k with
          | zero =>
              intro f
              simp
          | succ k ih =>
              intro f
              have hcnt_split : ∀ m : Fin d,
                  ((Finset.univ.filter (fun q : Fin (k + 1) => f q = m)).card : ℕ) =
                    (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) +
                      ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) := by
                intro m
                have hcard_succ : ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) =
                    ∑ i : Fin k, (if f (Fin.succ i) = m then 1 else 0) := by
                  rw [Finset.card_filter]
                have h0 : (0 : Fin (k + 1)) = ⟨0, Nat.succ_pos k⟩ := by
                  apply Fin.ext
                  exact Nat.zero_mod (k + 1)

                calc
                  ((Finset.univ.filter (fun q : Fin (k + 1) => f q = m)).card : ℕ)
                      = ∑ q : Fin (k + 1), (if f q = m then 1 else 0) := by
                        rw [Finset.card_filter]
                  _ = (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) +
                        ∑ i : Fin k, (if f (Fin.succ i) = m then 1 else 0) := by
                        rw [Fin.sum_univ_succ]
                        rw [h0]
                  _ = (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) +
                        ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) := by
                        rw [hcard_succ]
              have hsum1 : (∑ m : Fin d, (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) * (r + 1) ^ m.val) =
                  (r + 1) ^ (f ⟨0, Nat.succ_pos k⟩).val := by
                have hrew : (∑ m : Fin d, (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) * (r + 1) ^ m.val) =
                    ∑ m : Fin d, (if f ⟨0, Nat.succ_pos k⟩ = m then (r + 1) ^ m.val else 0) := by
                  apply Finset.sum_congr rfl
                  intro m _
                  by_cases h : f ⟨0, Nat.succ_pos k⟩ = m
                  · simp [h]
                  · simp [h]
                rw [hrew]
                simpa [eq_comm] using (Finset.sum_ite_eq' (s := (Finset.univ : Finset (Fin d)))
                  (a := f ⟨0, Nat.succ_pos k⟩) (f := fun m : Fin d => (r + 1) ^ m.val))
              have hsum2 : (∑ m : Fin d, ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) * (r + 1) ^ m.val) =
                  ∑ q : Fin k, (r + 1) ^ (f (Fin.succ q)).val := by
                exact (ih (fun q : Fin k => f (Fin.succ q))).symm
              calc
                (∑ q : Fin (k + 1), (r + 1) ^ (f q).val)
                    = (r + 1) ^ (f ⟨0, Nat.succ_pos k⟩).val + ∑ q : Fin k, (r + 1) ^ (f (Fin.succ q)).val := by
                      simpa [Fin.sum_univ_succ]
                _ = ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin (k + 1) => f q = m)).card : ℕ) * (r + 1) ^ m.val := by
                      symm
                      calc
                        (∑ m : Fin d, ((Finset.univ.filter (fun q : Fin (k + 1) => f q = m)).card : ℕ) * (r + 1) ^ m.val)
                            = ∑ m : Fin d, ((if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) +
                                ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ)) * (r + 1) ^ m.val := by
                              apply Finset.sum_congr rfl
                              intro m _
                              rw [hcnt_split m]
                        _ = ∑ m : Fin d, ((if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) * (r + 1) ^ m.val +
                                ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) * (r + 1) ^ m.val) := by
                              apply Finset.sum_congr rfl
                              intro m _
                              rw [add_mul]
                        _ = (∑ m : Fin d, (if f ⟨0, Nat.succ_pos k⟩ = m then 1 else 0) * (r + 1) ^ m.val) +
                              (∑ m : Fin d, ((Finset.univ.filter (fun q : Fin k => f (Fin.succ q) = m)).card : ℕ) * (r + 1) ^ m.val) := by
                              rw [Finset.sum_add_distrib]
                        _ = (r + 1) ^ (f ⟨0, Nat.succ_pos k⟩).val + ∑ q : Fin k, (r + 1) ^ (f (Fin.succ q)).val := by
                              rw [hsum1, hsum2]
        have hlen : ∀ (k : ℕ) (f : Fin k → Fin d), k = ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin k => f q = m)).card : ℕ) := by
          intro k f
          calc
            k = (Finset.univ : Finset (Fin k)).card := by simp
            _ = ∑ q : Fin k, (1 : ℕ) := by simp
            _ = ∑ q : Fin k, (∑ m : Fin d, (if f q = m then (1 : ℕ) else 0)) := by
              apply Finset.sum_congr rfl
              intro q _
              simpa [eq_comm] using (Finset.sum_ite_eq' (s := (Finset.univ : Finset (Fin d))) (a := f q) (f := fun _ : Fin d => (1 : ℕ)))
            _ = ∑ m : Fin d, (∑ q : Fin k, (if f q = m then (1 : ℕ) else 0)) := by
              rw [Finset.sum_comm]
            _ = ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin k => f q = m)).card : ℕ) := by
              apply Finset.sum_congr rfl
              intro m _
              rw [← Finset.card_filter]
        have hdigits : ∀ (n : ℕ) (f g : Fin n → ℕ), (∀ m : Fin n, f m < r + 1) → (∀ m : Fin n, g m < r + 1) →
            (∑ m : Fin n, f m * (r + 1) ^ m.val) = (∑ m : Fin n, g m * (r + 1) ^ m.val) → f = g := by
          intro n
          induction n with
          | zero =>
              intro f g hf hg hsum
              apply funext
              intro m
              exact Fin.elim0 m
          | succ n ih =>
              intro f g hf hg hsum
              have hsum_f : (∑ m : Fin (n + 1), f m * (r + 1) ^ m.val) =
                  f 0 + ∑ m : Fin n, f (Fin.succ m) * ((r + 1) * (r + 1) ^ m.val) := by
                simpa [pow_succ'] using (Fin.sum_univ_succ (f := fun m : Fin (n + 1) => f m * (r + 1) ^ m.val))
              have hsum_g : (∑ m : Fin (n + 1), g m * (r + 1) ^ m.val) =
                  g 0 + ∑ m : Fin n, g (Fin.succ m) * ((r + 1) * (r + 1) ^ m.val) := by
                simpa [pow_succ'] using (Fin.sum_univ_succ (f := fun m : Fin (n + 1) => g m * (r + 1) ^ m.val))
              have htail_f : (r + 1) * (∑ m : Fin n, f (Fin.succ m) * (r + 1) ^ m.val) =
                  ∑ m : Fin n, f (Fin.succ m) * ((r + 1) * (r + 1) ^ m.val) := by
                rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro m _
                ring
              have htail_g : (r + 1) * (∑ m : Fin n, g (Fin.succ m) * (r + 1) ^ m.val) =
                  ∑ m : Fin n, g (Fin.succ m) * ((r + 1) * (r + 1) ^ m.val) := by
                rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro m _
                ring
              have hmod : f 0 % (r + 1) = g 0 % (r + 1) := by
                have hc := congrArg (fun z : ℕ => z % (r + 1)) hsum
                rw [hsum_f, hsum_g] at hc
                rw [← htail_f, ← htail_g] at hc
                simpa [Nat.add_mul_mod_self_left] using hc
              have h0 : f 0 = g 0 := by
                calc
                  f 0 = f 0 % (r + 1) := (Nat.mod_eq_of_lt (hf 0)).symm
                  _ = g 0 % (r + 1) := hmod
                  _ = g 0 := Nat.mod_eq_of_lt (hg 0)
              have hsum_t : (∑ m : Fin n, f (Fin.succ m) * (r + 1) ^ m.val) =
                  (∑ m : Fin n, g (Fin.succ m) * (r + 1) ^ m.val) := by
                have hc := hsum
                rw [hsum_f, hsum_g] at hc
                rw [← htail_f, ← htail_g] at hc
                rw [h0] at hc
                have hc' : (r + 1) * (∑ m : Fin n, f (Fin.succ m) * (r + 1) ^ m.val) =
                    (r + 1) * (∑ m : Fin n, g (Fin.succ m) * (r + 1) ^ m.val) := by
                  omega
                exact Nat.mul_left_cancel (Nat.succ_pos r) hc'
              have htail : (fun m : Fin n => f (Fin.succ m)) = (fun m : Fin n => g (Fin.succ m)) := by
                exact ih (fun m : Fin n => f (Fin.succ m)) (fun m : Fin n => g (Fin.succ m))
                  (fun m => hf (Fin.succ m)) (fun m => hg (Fin.succ m)) hsum_t
              apply funext
              intro m
              exact Fin.cases h0 (fun m' : Fin n => by simpa using congrFun htail m') m
        -- Permutation from equal fiber cardinalities.
        have hperm_of_counts : ∀ (k : ℕ) (u v : Fin k → Fin d),
            (∀ m : Fin d, (Finset.univ.filter (fun q : Fin k => u q = m)).card =
                (Finset.univ.filter (fun q : Fin k => v q = m)).card) →
            ∃ σ : Equiv.Perm (Fin k), ∀ q : Fin k, v q = u (σ q) := by
          intro k u v hfib
          -- ψ m : fiber of v at m ≃ fiber of u at m, from equal fiber cardinalities.
          let ψ : ∀ m : Fin d, {q : Fin k // v q = m} ≃ {q : Fin k // u q = m} := fun m =>
            Fintype.equivOfCardEq (by
              simpa [Fintype.card_subtype] using (hfib m).symm)
          -- Equiv.sigmaFiberEquiv f : (Σ m, {q // f q = m}) ≃ α; use its inverse as the
          -- canonical identification α ≃ (Σ m, {q // f q = m}).
          let Eu : Fin k ≃ (Σ m : Fin d, {q : Fin k // u q = m}) :=
            (Equiv.sigmaFiberEquiv u).symm
          let Ev : Fin k ≃ (Σ m : Fin d, {q : Fin k // v q = m}) :=
            (Equiv.sigmaFiberEquiv v).symm
          -- σ := Ev ; sigmaCongrRight ψ ; Eu.symm : a genuine permutation (composition of
          -- equivalences), so no separate bijectivity proof is required.
          let σ : Fin k ≃ Fin k := Ev.trans ((Equiv.sigmaCongrRight ψ).trans Eu.symm)
          refine ⟨σ, ?_⟩
          intro q
          have hcom : σ q = ((ψ (v q)) ⟨q, rfl⟩).val := by
            dsimp [σ, Eu, Ev]
            rfl
          rw [hcom]
          exact (((ψ (v q)) ⟨q, rfl⟩).property).symm
        -- Symmetric families: same weight ⟹ same coefficient.
        have hsym_group : ∀ (x y : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)), wt x = wt y → c x = c y := by
          intro x y hw
          rcases x with ⟨kx, ux⟩
          rcases y with ⟨ky, uy⟩
          have hw' : (∑ q : Fin kx.val, (r + 1) ^ (ux q).val) = (∑ q : Fin ky.val, (r + 1) ^ (uy q).val) := by
            simpa [wt, w] using hw
          have hA_x : (∑ q : Fin kx.val, (r + 1) ^ (ux q).val) =
              ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card : ℕ) * (r + 1) ^ m.val :=
            hgroup kx.val ux
          have hA_y : (∑ q : Fin ky.val, (r + 1) ^ (uy q).val) =
              ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card : ℕ) * (r + 1) ^ m.val :=
            hgroup ky.val uy
          have hsum_eq : (∑ m : Fin d, ((Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card : ℕ) * (r + 1) ^ m.val) =
              (∑ m : Fin d, ((Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card : ℕ) * (r + 1) ^ m.val) := by
            rw [← hA_x, ← hA_y]
            exact hw'
          have hcnt_eq : (fun m : Fin d => (Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card) =
              (fun m : Fin d => (Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card) := by
            apply hdigits d
              (fun m : Fin d => (Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card)
              (fun m : Fin d => (Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card)
            · intro m
              have hle1 : (Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card ≤ kx.val := by
                exact (Finset.card_filter_le (s := (Finset.univ : Finset (Fin kx.val))) (p := fun q => ux q = m)).trans ((by simp : (Finset.univ : Finset (Fin kx.val)).card = kx.val).le)
              have hk_le : kx.val ≤ r := Nat.le_of_lt_succ kx.isLt
              omega
            · intro m
              have hle1 : (Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card ≤ ky.val := by
                exact (Finset.card_filter_le (s := (Finset.univ : Finset (Fin ky.val))) (p := fun q => uy q = m)).trans ((by simp : (Finset.univ : Finset (Fin ky.val)).card = ky.val).le)
              have hk_le : ky.val ≤ r := Nat.le_of_lt_succ ky.isLt
              omega
            · exact hsum_eq
          have hk : kx.val = ky.val := by
            calc
              kx.val = ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card : ℕ) := hlen kx.val ux
              _ = ∑ m : Fin d, ((Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card : ℕ) := by rw [hcnt_eq]
              _ = ky.val := (hlen ky.val uy).symm
          have hcounts : ∀ m : Fin d, (Finset.univ.filter (fun q : Fin kx.val => ux q = m)).card =
              (Finset.univ.filter (fun q : Fin ky.val => uy q = m)).card := by
            intro m
            exact congrFun hcnt_eq m
          have hkfin : kx = ky := Fin.ext hk
          subst hkfin
          have hperm : ∃ σ : Equiv.Perm (Fin kx.val), ∀ q : Fin kx.val, uy q = ux (σ q) :=
            hperm_of_counts kx.val ux uy hcounts
          exact hsym kx ux uy hperm
        -- Coefficient of P at wt a is the (cardinality-scaled) symmetric coefficient c a.
        have hfiber : P.coeff (wt a) = ((Finset.univ.filter (fun a' => wt a' = wt a)).card : ℝ) * c a := by
          calc
            P.coeff (wt a) = ∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), c a' * (Polynomial.X ^ (wt a')).coeff (wt a) := by
              dsimp [P]
              rw [hcoeff_sum (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))) (fun a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => Polynomial.C (c a') * Polynomial.X ^ (wt a')) (wt a)]
              apply Finset.sum_congr rfl
              intro a' _
              rw [Polynomial.coeff_C_mul]
            _ = ∑ a' : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (if wt a' = wt a then c a' else 0) := by
              apply Finset.sum_congr rfl
              intro a' _
              rw [Polynomial.coeff_X_pow]
              by_cases h : wt a = wt a'
              · simp [h]
              · have h' : ¬ wt a' = wt a := fun h2 => h h2.symm
                simp [h, h']
            _ = ∑ a' ∈ (Finset.univ.filter (fun a' => wt a' = wt a)), c a' := by
              rw [← Finset.sum_filter]
            _ = ((Finset.univ.filter (fun a' => wt a' = wt a)).card : ℝ) * c a := by
              have hcongr : (∑ a' ∈ (Finset.univ.filter (fun a' => wt a' = wt a)), c a') =
                  (∑ _a' ∈ (Finset.univ.filter (fun a' => wt a' = wt a)), c a) := by
                exact Finset.sum_congr rfl (fun a' ha' => hsym_group a' a (Finset.mem_filter.mp ha').2)
              rw [hcongr]
              rw [Finset.sum_const]
              simp [nsmul_eq_mul]
        -- Final: |c a| ≤ |P.coeff (wt a)| (fiber has ≥ 1 element) ≤ K1 * M.
        have hc_le_coeff : |c a| ≤ |P.coeff (wt a)| := by
          rw [hfiber]
          have hmem : a ∈ (Finset.univ.filter (fun a' => wt a' = wt a)) := by simp
          have hcard_pos : 1 ≤ (Finset.univ.filter (fun a' => wt a' = wt a)).card := by
            exact Nat.succ_le_iff.mpr (Finset.card_pos.mpr ⟨a, hmem⟩)
          have hc : |((Finset.univ.filter (fun a' => wt a' = wt a)).card : ℝ) * c a| =
              (Finset.univ.filter (fun a' => wt a' = wt a)).card * |c a| := by
            rw [abs_mul]
            rw [abs_of_nonneg (by exact_mod_cast (Nat.zero_le ((Finset.univ.filter (fun a' => wt a' = wt a)).card)))]
          calc
            |c a| ≤ 1 * |c a| := by rw [one_mul]
            _ ≤ (Finset.univ.filter (fun a' => wt a' = wt a)).card * |c a| := by
              exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard_pos) (abs_nonneg _)
            _ = |((Finset.univ.filter (fun a' => wt a' = wt a)).card : ℝ) * c a| := hc.symm
        exact le_trans hc_le_coeff (hcoeff_K1 (wt a) (hwt_lt a))
  -- @step s2: For f in holderSmoothBall r beta C B and any unit-cube center y, with offsets h_i of
  -- norm ≤ rho0 from s1, apply E4 with rho = rho0 and the envelope bound |f(y+h_i)| ≤ B to show
  -- |Σ_a c_a ∏_q h_i (a.snd q)| ≤ B + C / r! * rho0^(r+beta) for every i.
  have h_s2 :
      ∀ (rho0 : ℝ) (ι : Type) (h : ι → Fin d → ℝ),
        (∀ i : ι, ‖h i‖ ≤ rho0) →
        ∀ f : (Fin d → ℝ) → ℝ,
          f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
          ∀ y : Fin d → ℝ,
            ∀ i : ι,
              |∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  ((Nat.factorial a.1.val : ℝ)⁻¹ *
                      (iteratedFDeriv ℝ a.1.val f y)
                        (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)) *
                    ∏ q : Fin a.1.val, h i (a.2 q)| ≤
                B + C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta) := by
    intro rho0 ι h hnorm f hf y i
    have hrho0_nonneg : 0 ≤ rho0 := le_trans (norm_nonneg (h i)) (hnorm i)
    have hxy : (y + h i) - y = h i := by
      ext q
      simp
    have hnorm_xy : ‖(y + h i) - y‖ ≤ rho0 := by
      rw [hxy]
      exact hnorm i
    have hE4 := Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
      (d := d) (r := r) (beta := beta) (C := C) (B := B) (rho := rho0)
      hbeta_nonneg hC hrho0_nonneg f hf y (y + h i) hnorm_xy
    let S : ℝ := ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        ((Nat.factorial a.1.val : ℝ)⁻¹ * (iteratedFDeriv ℝ a.1.val f y)
            (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)) *
          ∏ q : Fin a.1.val, h i (a.2 q)
    have hFLC : Statlib.Nonparametric.Vocabulary.finiteLinearCombination Finset.univ
        (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
          ((Nat.factorial a.fst.val : ℝ)⁻¹) * (iteratedFDeriv ℝ a.fst.val f y)
            (fun q : Fin a.fst.val => fun j : Fin d => if j = a.snd q then 1 else 0))
        (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
          fun x : Fin d → ℝ => ∏ q : Fin a.fst.val, (x (a.snd q) - y (a.snd q)))
        (y + h i) = S := by
      simp [Statlib.Nonparametric.Vocabulary.finiteLinearCombination, S]
    have hE4S : |f (y + h i) - S| ≤ C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta) := by
      change |f (y + h i) - S| ≤ C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta)
      rw [← hFLC]
      exact hE4
    have hBx : |f (y + h i)| ≤ B := hf.2 (y + h i)
    have htri : |S| ≤ |f (y + h i)| + |f (y + h i) - S| := by
      calc
        |S| = |f (y + h i) - (f (y + h i) - S)| := by congr 1; ring
        _ ≤ |f (y + h i)| + |f (y + h i) - S| := abs_sub (f (y + h i)) (f (y + h i) - S)
    exact htri.trans (add_le_add hBx hE4S)
  -- @step s3: Combine s1 and s2: for every f in the Holder ball, every unit-cube center y, and every
  -- a of degree ≤ r, |c_a| ≤ K1 * (B + C / r! * rho0^(r+beta)); choose
  -- A := K1 * (B + C / r! * rho0^(r+beta)) and prove 0 ≤ A using hC, hB, and hbeta_nonneg.
  have h_s3 : ∃ A : ℝ, 0 ≤ A ∧
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
        ∀ y : Fin d → ℝ,
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f y)
                  (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
              A := by
    -- @step s1: Prove the Taylor coefficient functional
    -- c a = (Nat.factorial a.1.val)⁻¹ * iteratedFDeriv ℝ a.1.val f y (basis tuple for a.2)
    -- satisfies h_s1's symmetry premise: if v = u ∘ σ for a permutation σ of Fin k, then c ⟨k,u⟩ = c ⟨k,v⟩.
    have hs1 : ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
        ∀ y : Fin d → ℝ,
          ∀ (k : Fin (r + 1)) (u v : Fin k.val → Fin d),
            (∃ σ : Equiv.Perm (Fin k.val), ∀ q : Fin k.val, v q = u (σ q)) →
                      ((Nat.factorial k.val : ℝ)⁻¹) * (iteratedFDeriv ℝ k.val f y) (fun q : Fin k.val => fun w : Fin d => if w = u q then 1 else 0) =
                      ((Nat.factorial k.val : ℝ)⁻¹) * (iteratedFDeriv ℝ k.val f y) (fun q : Fin k.val => fun w : Fin d => if w = v q then 1 else 0) := by
              intro f hf y k u v hperm
              rcases hperm with ⟨σ, hσ⟩
              by_cases hk0 : k.val = 0
              · -- k = 0: Fin k.val is empty, so u = v and both sides of the goal coincide.
                have huv : u = v := by
                  funext q
                  exfalso
                  exact Fin.elim0 (by simpa [hk0] using q)
                rw [huv]
              · -- k ≥ 1: prove the coefficient equality via finite-order permutation symmetry of
                -- the iterated derivative (Schwarz), using f ∈ holderSmoothBall r beta C B, which
                -- yields ContDiff ℝ (↑(r+1)) f and k.val ≤ r, hence ContDiffAt ℝ (↑k.val) f y.
                have hbv : (fun q : Fin k.val => fun w : Fin d => if w = v q then (1 : ℝ) else 0) =
                    (fun q : Fin k.val => fun w : Fin d => if w = u q then (1 : ℝ) else 0) ∘ σ := by
                  funext q w
                  rw [hσ q]
                  rfl
                -- Goal: c * D b_u = c * D b_v.  Cancel the common scalar factor...
                apply congrArg (fun t : ℝ => ((Nat.factorial k.val : ℝ)⁻¹) * t)
                -- ...and prove D b_u = D b_v via reindexing (D b_v = D (b_u ∘ σ), by congruence
                -- on hbv.symm) plus the finite-order permutation symmetry of the iterated
                -- derivative (Schwarz): for f C^k at y, D^k f(y) is symmetric in its arguments.
                calc
                  (iteratedFDeriv ℝ k.val f y) (fun q : Fin k.val => fun w : Fin d => if w = u q then 1 else 0) =
                      (iteratedFDeriv ℝ k.val f y)
                        ((fun q : Fin k.val => fun w : Fin d => if w = u q then 1 else 0) ∘ σ) := by
                      -- finite-order Schwarz symmetry of iteratedFDeriv (standalone top-level lemma)
                      have hcont : ContDiff ℝ (↑r) f := by
                        rcases hf with ⟨hHS, hbnd⟩
                        have hr : 1 ≤ r :=
                          le_trans (Nat.succ_le_of_lt (Nat.pos_of_ne_zero hk0)) (Nat.le_of_lt_succ k.isLt)
                        cases r with
                        | zero => omega
                        | succ r' => exact hHS.1
                      have hcont_k : ContDiff ℝ (↑k.val) f := by
                        exact hcont.of_le (by
                          exact_mod_cast (Nat.le_of_lt_succ k.isLt))
                      exact (iteratedFDeriv_perm_symm f hcont_k y
                        (fun q : Fin k.val => fun w : Fin d => if w = u q then 1 else 0) σ).symm
                  _ = (iteratedFDeriv ℝ k.val f y) (fun q : Fin k.val => fun w : Fin d => if w = v q then 1 else 0) :=
                    congrArg (iteratedFDeriv ℝ k.val f y) hbv.symm
    -- @step s2: Destruct h_s1 to obtain rho0 > 0, K1 ≥ 0, ι, h with ‖h i‖ ≤ rho0; define
    -- M := B + C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta) and prove 0 ≤ M using hB, hC,
    -- hbeta_nonneg and rho0 positivity (rpow_nonneg).
    have hs2 : ∀ rho0 : ℝ, 0 < rho0 → 0 ≤ B + C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta) := by
      intro rho0 hrho0
      have hfac : (0 : ℝ) < (Nat.factorial r : ℝ) := by
        exact_mod_cast (Nat.factorial_pos r)
      have hCdiv : 0 ≤ C / (Nat.factorial r : ℝ) := div_nonneg hC (le_of_lt hfac)
      have hrpow : 0 ≤ rho0.rpow (↑r + beta) := Real.rpow_nonneg (le_of_lt hrho0) ((r : ℝ) + beta)
      have hterm : 0 ≤ C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta) := mul_nonneg hCdiv hrpow
      linarith
    -- @step s3: Instantiate h_s2 with rho0, ι, h to bound each evaluation by M; feed the symmetry
    -- from s1 and this bound into h_s1 to get |c a| ≤ K1 * M for every a; choose A := K1 * M with
    -- 0 ≤ A and close the existential.
    have hs3 : ∃ A : ℝ, 0 ≤ A ∧
        ∀ f : (Fin d → ℝ) → ℝ,
          f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
          ∀ y : Fin d → ℝ,
            ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              |((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f y)
                    (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
                          A := by
                rcases h_s1 with ⟨rho0, hrho0, K1, hK1, ι, hι, hh_norm, hh_extract⟩
                let M : ℝ := B + C / (Nat.factorial r : ℝ) * rho0.rpow (↑r + beta)
                have hM : 0 ≤ M := by
                  dsimp [M]
                  exact hs2 rho0 hrho0
                refine ⟨K1 * M, mul_nonneg hK1 hM, ?_⟩
                intro f hf y a
                let c : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ :=
                  fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.1.val f y)
                      (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)
                have hsym : ∀ (k : Fin (r + 1)) (u v : Fin k.val → Fin d),
                    (∃ σ : Equiv.Perm (Fin k.val), ∀ q : Fin k.val, v q = u (σ q)) →
                      c ⟨k, u⟩ = c ⟨k, v⟩ := by
                  intro k u v hperm
                  simpa [c] using hs1 f hf y k u v hperm
                have heval : ∀ i : ι,
                    |∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                      c a * ∏ q : Fin a.1.val, hh_norm i (a.2 q)| ≤ M := by
                  intro i
                  simpa [c, M] using h_s2 rho0 ι hh_norm hh_extract.1 f hf y i
                have hbnd : |c a| ≤ K1 * M := hh_extract.2 c hsym M heval a
                simpa [c] using hbnd
    -- @step fin: close h_s3 with the final existential.
    exact hs3
  -- @step fin
  exact h_s3

/-- Compatibility form of the global Taylor-coefficient bound, specialized to
centers in the unit cube. -/
theorem holderSmoothBall_unitCube_taylor_coefficients_admit_uniform_bound
    (d r : ℕ) {beta C B : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hB : 0 ≤ B) :
    ∃ A : ℝ, 0 ≤ A ∧
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ Statlib.Nonparametric.Vocabulary.holderSmoothBall r beta C B →
        ∀ y : Fin d → ℝ,
          (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
          ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f y)
                  (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
              A := by
  rcases holderSmoothBall_taylor_coefficients_admit_uniform_bound
      d r hbeta_nonneg hC hB with ⟨A, hA, hcoeff⟩
  exact ⟨A, hA, fun f hf y _hy a => hcoeff f hf y a⟩


theorem exists_unitCube_grid_for_holder_remainder_budget
    {d r : ℕ} {beta C eta : ℝ}
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC : 0 ≤ C) (heta : 0 < eta) :
    ∃ K : ℕ, 0 < K ∧
      C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta) ≤
        eta := by
  have hKinv :
      Filter.Tendsto (fun K : ℕ => (K : ℝ)⁻¹) Filter.atTop (nhds (0 : ℝ)) := by
    exact (tendsto_natCast_atTop_atTop (R := ℝ)).inv_tendsto_atTop
  have hlim1 : Filter.Tendsto
      (fun K : ℕ => Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) Filter.atTop
      (nhds (0 : ℝ)) := by
    simpa using hKinv.const_mul (Real.sqrt (d : ℝ))
  have hlim2 : Filter.Tendsto
      (fun K : ℕ => Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta))
      Filter.atTop (nhds (Real.rpow 0 ((r : ℝ) + beta))) := by
    exact hlim1.rpow_const (Or.inr (le_of_lt hsmooth_pos))
  have hlim3 : Filter.Tendsto
      (fun K : ℕ =>
        C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta))
      Filter.atTop
      (nhds (C / (Nat.factorial r : ℝ) * Real.rpow 0 ((r : ℝ) + beta))) := by
    exact hlim2.const_mul (C / (Nat.factorial r : ℝ))
  have hzp : Real.rpow 0 ((r : ℝ) + beta) = 0 :=
    Real.zero_rpow (ne_of_gt hsmooth_pos)
  have hconst : C / (Nat.factorial r : ℝ) * Real.rpow 0 ((r : ℝ) + beta) = 0 := by
    rw [hzp, mul_zero]
  have hlim : Filter.Tendsto
      (fun K : ℕ =>
        C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta))
      Filter.atTop (nhds (0 : ℝ)) := by
    rw [hconst] at hlim3
    exact hlim3
  have hlt : ∀ᶠ K : ℕ in Filter.atTop,
      C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta) < eta := by
    exact hlim.eventually (Iio_mem_nhds heta)
  have hEv : ∀ᶠ K : ℕ in Filter.atTop,
      C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta) ≤ eta := by
    exact hlt.mono (fun _ hK => le_of_lt hK)
  have hEvPos : ∀ᶠ K : ℕ in Filter.atTop,
      (0 < K) ∧ C / (Nat.factorial r : ℝ) *
          Real.rpow (Real.sqrt (d : ℝ) * (K : ℝ)⁻¹) ((r : ℝ) + beta) ≤ eta := by
    exact (Filter.eventually_gt_atTop 0).and hEv
  exact hEvPos.exists

open Filter Topology in
theorem exists_centeredMonomialApproxError_unit_radius_sigma_sum_le
    {d r : ℕ} {A eta : ℝ}
    (hA_nonneg : 0 ≤ A) (heta : 0 < eta) :
    ∃ n : ℕ, 0 < n ∧
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n a.1.val) ≤
        eta := by
  have h_s1 : ∀ m : ℕ,
      Tendsto (fun n : ℕ => Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n m)
            atTop (𝓝 0) := by
    let S : ℕ → ℕ → ℝ :=
      fun n m => Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n m
    have hInv1 : Tendsto (fun n : ℕ => (n : ℝ)⁻¹) atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    have hInv2 : Tendsto (fun n : ℕ => ((n : ℝ) ^ 2)⁻¹) atTop (𝓝 0) := by
      simpa [pow_two, mul_inv_rev] using hInv1.mul hInv1
    have h_rec : ∀ n m : ℕ, S n (m + 2) =
        2 * (3 + S n (m + 1)) ^ 2 / (n : ℝ) ^ 2 +
          (3 + S n (m + 1)) * S n (m + 1) := by
      intro n m
      simp [S, Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError]
      ring
    have h_pair : ∀ m : ℕ,
        Tendsto (fun n : ℕ => S n m) atTop (𝓝 0) ∧
        Tendsto (fun n : ℕ => S n (m + 1)) atTop (𝓝 0) := by
      intro m
      induction m with
      | zero =>
          constructor
          · simpa [S, Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError] using
              (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
          · simpa [S, Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError] using
              (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
      | succ m ih =>
          constructor
          · exact ih.2
          · have hSm : Tendsto (fun n : ℕ => S n (m + 1)) atTop (𝓝 0) := ih.2
            have hB : Tendsto (fun n : ℕ => 3 + S n (m + 1)) atTop (𝓝 3) := by
              simpa using
                (tendsto_const_nhds : Tendsto (fun _ : ℕ => (3 : ℝ)) atTop (𝓝 3)).add hSm
            have hB2 : Tendsto (fun n : ℕ => (3 + S n (m + 1)) ^ 2)
                atTop (𝓝 (3 ^ 2)) := by
              simpa [pow_two] using hB.mul hB
            have h2B2 : Tendsto (fun n : ℕ => 2 * (3 + S n (m + 1)) ^ 2)
                atTop (𝓝 (2 * 3 ^ 2)) := by
              simpa using
                (tendsto_const_nhds : Tendsto (fun _ : ℕ => (2 : ℝ)) atTop (𝓝 2)).mul hB2
            have hterm1 : Tendsto
                (fun n : ℕ => 2 * (3 + S n (m + 1)) ^ 2 * ((n : ℝ) ^ 2)⁻¹)
                atTop (𝓝 0) := by
              simpa using h2B2.mul hInv2
            have hterm2 : Tendsto
                (fun n : ℕ => (3 + S n (m + 1)) * S n (m + 1)) atTop (𝓝 0) := by
              simpa using hB.mul hSm
            have hsum : Tendsto
                (fun n : ℕ =>
                  2 * (3 + S n (m + 1)) ^ 2 / (n : ℝ) ^ 2 +
                    (3 + S n (m + 1)) * S n (m + 1)) atTop (𝓝 0) := by
              simpa [div_eq_mul_inv] using hterm1.add hterm2
            have hgoal : Tendsto (fun n : ℕ => S n (m + 2)) atTop (𝓝 0) := by
              convert hsum using 1
              ext n
              rw [h_rec n m]
            exact hgoal
    intro m
    exact (h_pair m).1
  have h_s2 : Tendsto
      (fun n : ℕ =>
        ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n a.1.val)
        atTop (𝓝 0) := by
    simpa using
      tendsto_finset_sum
        (f := fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
          fun n : ℕ => Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n a.1.val)
        (a := fun _ : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (0 : ℝ))
        Finset.univ (fun a _ => h_s1 a.1.val)
  have h_s3 : ∃ n : ℕ, 0 < n ∧
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n a.1.val) ≤
        eta := by
    let eps : ℝ := eta / (A + 1)
    have hden : 0 < A + 1 := by linarith
    have heps : 0 < eps := by
      dsimp [eps]
      exact div_pos heta hden
    have h_ev : ∀ᶠ n in atTop,
        |∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n a.1.val| < eps := by
      have hdist := (Metric.tendsto_nhds.mp h_s2) eps heps
      filter_upwards [hdist] with n hn
      simpa [Real.dist_eq] using hn
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp h_ev
    let n0 : ℕ := max N 1
    have hn0_pos : 0 < n0 := by
      dsimp [n0]
      exact lt_of_lt_of_le (by norm_num : (0 : ℕ) < 1) (le_max_right N 1)
    have hn0_ge : N ≤ n0 := le_max_left N 1
    let s : ℝ := ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        Statlib.Nonparametric.Vocabulary.centeredMonomialApproxError 1 n0 a.1.val
    have hS_bound : |s| < eps := by
      simpa [s] using hN n0 hn0_ge
    have hA_eps_le : A * eps ≤ eta := by
      calc
        A * eps = (A / (A + 1)) * eta := by
          dsimp [eps]
          ring
        _ ≤ 1 * eta := by
          have hAfrac : A / (A + 1) ≤ 1 := by
            rw [div_le_iff₀ hden]
            linarith
          exact mul_le_mul_of_nonneg_right hAfrac (le_of_lt heta)
        _ = eta := by ring
    refine ⟨n0, hn0_pos, ?_⟩
    show A * s ≤ eta
    calc
      A * s ≤ A * |s| := by
        exact mul_le_mul_of_nonneg_left (le_abs_self s) hA_nonneg
      _ ≤ A * eps := by
        exact mul_le_mul_of_nonneg_left (le_of_lt hS_bound) hA_nonneg
      _ ≤ eta := hA_eps_le
  exact h_s3

theorem exists_unitCube_tent_product_error_budget
    {d K : ℕ} {productRadius weightRadius eta : ℝ}
    (hK : 0 < K)
    (hProductRadius : 1 < productRadius)
    (hWeightRadius : 1 < weightRadius)
    (heta : 0 < eta) :
    ∃ nWeight nMul : ℕ, 0 < nWeight ∧ 0 < nMul ∧
      ∃ weightEta productDelta : ℝ,
        0 ≤ weightEta ∧
        (∑ k ∈ Finset.range d, weightRadius ^ k) *
            (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta ∧
        weightEta ≤ weightRadius - 1 ∧
        1 + weightEta ≤ productRadius ∧
        2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 +
            productRadius * weightEta ≤ productDelta ∧
        0 ≤ productDelta ∧
        (∑ j : Fin ((K + 1) ^ d), productDelta) ≤ eta := by
  have h_s1 : ∃ productDelta : ℝ,
      0 < productDelta ∧
      (∑ j : Fin ((K + 1) ^ d), productDelta) ≤ eta := by
    have hm_pos : 0 < ((K + 1) ^ d : ℝ) := by
      positivity
    refine ⟨eta / ((K + 1) ^ d : ℝ), ?_, ?_⟩
    · positivity
    · rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
      simp [mul_div_cancel₀, hm_pos.ne']
  have h_s2 : ∀ productDelta : ℝ, 0 < productDelta →
      ∃ weightEta : ℝ,
        0 < weightEta ∧ weightEta ≤ weightRadius - 1 ∧
        1 + weightEta ≤ productRadius ∧
        productRadius * weightEta ≤ productDelta / 2 := by
    intro productDelta hpd_pos
    let weightEta : ℝ :=
      min (weightRadius - 1) (min (productRadius - 1) (productDelta / (2 * productRadius)))
    have hpr_pos : 0 < productRadius := by linarith [hProductRadius]
    have hwr_pos : 0 < weightRadius - 1 := by linarith [hWeightRadius]
    have hprm1_pos : 0 < productRadius - 1 := by linarith [hProductRadius]
    have hpd_div_pos : 0 < productDelta / (2 * productRadius) := by positivity
    have hwe_pos : 0 < weightEta := by
      dsimp [weightEta]
      exact lt_min hwr_pos (lt_min hprm1_pos hpd_div_pos)
    refine ⟨weightEta, hwe_pos, ?_, ?_, ?_⟩
    · dsimp [weightEta]
      exact min_le_left _ _
    · have hwe_le_prm1 : weightEta ≤ productRadius - 1 := by
        dsimp [weightEta]
        exact le_trans (min_le_right _ _) (min_le_left _ _)
      linarith
    · have hwe_le_div : weightEta ≤ productDelta / (2 * productRadius) := by
        dsimp [weightEta]
        exact le_trans (min_le_right _ _) (min_le_right _ _)
      calc
        productRadius * weightEta ≤ productRadius * (productDelta / (2 * productRadius)) := by
          exact mul_le_mul_of_nonneg_left hwe_le_div (le_of_lt hpr_pos)
        _ = productDelta / 2 := by
          field_simp [hpr_pos.ne']
  have h_s3 : ∀ weightEta : ℝ, 0 < weightEta →
      ∃ nWeight : ℕ, 0 < nWeight ∧
        (∑ k ∈ Finset.range d, weightRadius ^ k) *
            (2 * weightRadius ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta := by
    intro weightEta hwe_pos
    let S : ℝ := ∑ k ∈ Finset.range d, weightRadius ^ k
    let C : ℝ := S * (2 * weightRadius ^ 2)
    have hwr_pos : 0 < weightRadius := by linarith [hWeightRadius]
    have hS_nonneg : 0 ≤ S := by
      dsimp [S]
      exact Finset.sum_nonneg (by intro k hk; exact pow_nonneg hwr_pos.le k)
    have hC_nonneg : 0 ≤ C := by
      dsimp [C]
      exact mul_nonneg hS_nonneg (mul_nonneg (by norm_num) (sq_nonneg weightRadius))
    have hC_div_nonneg : 0 ≤ C / weightEta := by
      exact div_nonneg hC_nonneg (le_of_lt hwe_pos)
    rcases exists_nat_gt (C / weightEta) with ⟨nWeight, hn_gt⟩
    have hn_pos : 0 < nWeight := by
      have hnr_pos : (0 : ℝ) < (nWeight : ℝ) := lt_of_le_of_lt hC_div_nonneg hn_gt
      exact_mod_cast hnr_pos
    have hn_sq_pos : 0 < (nWeight : ℝ) ^ 2 := by
      exact pow_pos (by exact_mod_cast hn_pos) 2
    have hn_sq_ge : (nWeight : ℝ) ≤ (nWeight : ℝ) ^ 2 := by
      have hn1 : (1 : ℝ) ≤ (nWeight : ℝ) := by exact_mod_cast (Nat.succ_le_iff.mpr hn_pos)
      nlinarith
    have hC_lt : C < (nWeight : ℝ) * weightEta := by
      have h2 : (C / weightEta) * weightEta < (nWeight : ℝ) * weightEta :=
        mul_lt_mul_of_pos_right hn_gt hwe_pos
      rwa [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ hwe_pos.ne', mul_one] at h2
    have hC_lt_sq : C < weightEta * (nWeight : ℝ) ^ 2 := by
      calc
        C < (nWeight : ℝ) * weightEta := hC_lt
        _ = weightEta * (nWeight : ℝ) := by ring
        _ ≤ weightEta * (nWeight : ℝ) ^ 2 := by
          exact mul_le_mul_of_nonneg_left hn_sq_ge (le_of_lt hwe_pos)
    have hC_div_sq_lt : C / (nWeight : ℝ) ^ 2 < weightEta := by
      have h2 : C * ((nWeight : ℝ) ^ 2)⁻¹ < weightEta := by
        have h3 : C * ((nWeight : ℝ) ^ 2)⁻¹ <
            (weightEta * (nWeight : ℝ) ^ 2) * ((nWeight : ℝ) ^ 2)⁻¹ :=
          mul_lt_mul_of_pos_right hC_lt_sq (inv_pos.mpr hn_sq_pos)
        have hsimpl : (weightEta * (nWeight : ℝ) ^ 2) * ((nWeight : ℝ) ^ 2)⁻¹ =
            weightEta := by
          rw [mul_assoc, mul_inv_cancel₀ hn_sq_pos.ne', mul_one]
        rwa [hsimpl] at h3
      simpa [div_eq_mul_inv] using h2
    refine ⟨nWeight, hn_pos, ?_⟩
    dsimp [S, C] at hC_div_sq_lt
    rw [← mul_div_assoc]
    exact le_of_lt hC_div_sq_lt
  have h_s4 : ∀ (productDelta weightEta : ℝ), 0 < productDelta →
      productRadius * weightEta ≤ productDelta / 2 →
      ∃ nMul : ℕ, 0 < nMul ∧
        2 * productRadius ^ 2 / (nMul : ℝ) ^ 2 ≤
          productDelta - productRadius * weightEta := by
    intro productDelta weightEta hpd_pos hprwe
    let C : ℝ := 2 * productRadius ^ 2
    have hpr_pos : 0 < productRadius := lt_trans zero_lt_one hProductRadius
    have hC_pos : 0 < C := by
      dsimp [C]
      exact mul_pos (by norm_num) (sq_pos_of_pos hpr_pos)
    have hdenom_pos : 0 < productDelta - productRadius * weightEta := by
      have hge : productDelta / 2 ≤ productDelta - productRadius * weightEta := by
        linarith
      exact lt_of_lt_of_le (half_pos hpd_pos) hge
    have hnonneg : 0 ≤ C / (productDelta - productRadius * weightEta) :=
      div_nonneg (le_of_lt hC_pos) (le_of_lt hdenom_pos)
    rcases exists_nat_gt (C / (productDelta - productRadius * weightEta)) with ⟨nMul, hn_gt⟩
    have hn_pos : 0 < nMul := by
      exact_mod_cast lt_of_le_of_lt hnonneg hn_gt
    refine ⟨nMul, hn_pos, ?_⟩
    have hC_lt : C < (nMul : ℝ) * (productDelta - productRadius * weightEta) := by
      have h2 : (C / (productDelta - productRadius * weightEta)) *
          (productDelta - productRadius * weightEta) <
          (nMul : ℝ) * (productDelta - productRadius * weightEta) :=
        mul_lt_mul_of_pos_right hn_gt hdenom_pos
      rwa [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ hdenom_pos.ne', mul_one] at h2
    have hn_sq_pos : 0 < (nMul : ℝ) ^ 2 := sq_pos_of_pos (by exact_mod_cast hn_pos)
    have hn_sq_ge : (nMul : ℝ) ≤ (nMul : ℝ) ^ 2 := by
      have hge1 : (1 : ℝ) ≤ (nMul : ℝ) := by
        exact_mod_cast Nat.succ_le_of_lt hn_pos
      nlinarith
    have hC_lt_sq : C < (productDelta - productRadius * weightEta) * (nMul : ℝ) ^ 2 := by
      have h1 : (nMul : ℝ) * (productDelta - productRadius * weightEta) ≤
          (nMul : ℝ) ^ 2 * (productDelta - productRadius * weightEta) :=
        mul_le_mul_of_nonneg_right hn_sq_ge (le_of_lt hdenom_pos)
      have h2 : (nMul : ℝ) ^ 2 * (productDelta - productRadius * weightEta) =
          (productDelta - productRadius * weightEta) * (nMul : ℝ) ^ 2 := by
        rw [mul_comm]
      exact lt_of_lt_of_le hC_lt (le_trans h1 (le_of_eq h2))
    have hC_div_sq_lt : C * ((nMul : ℝ) ^ 2)⁻¹ <
        productDelta - productRadius * weightEta := by
      have h2 : C * ((nMul : ℝ) ^ 2)⁻¹ <
          (productDelta - productRadius * weightEta) * (nMul : ℝ) ^ 2 *
            ((nMul : ℝ) ^ 2)⁻¹ :=
        mul_lt_mul_of_pos_right hC_lt_sq (inv_pos.mpr hn_sq_pos)
      have hsimpl :
          (productDelta - productRadius * weightEta) * (nMul : ℝ) ^ 2 *
            ((nMul : ℝ) ^ 2)⁻¹ = productDelta - productRadius * weightEta := by
        rw [mul_assoc, mul_inv_cancel₀ hn_sq_pos.ne', mul_one]
      rwa [hsimpl] at h2
    dsimp [C] at hC_div_sq_lt
    exact le_of_lt hC_div_sq_lt
  rcases h_s1 with ⟨productDelta, hpd_pos, hpdsum⟩
  rcases h_s2 productDelta hpd_pos with ⟨weightEta, hwe_pos, hwe_wr, hwe_pr, hprwe⟩
  rcases h_s3 weightEta hwe_pos with ⟨nWeight, hnW, hsumW⟩
  rcases h_s4 productDelta weightEta hpd_pos hprwe with ⟨nMul, hnM, hbudget⟩
  refine ⟨nWeight, nMul, hnW, hnM, weightEta, productDelta,
    le_of_lt hwe_pos, hsumW, hwe_wr, hwe_pr, ?_, le_of_lt hpd_pos, hpdsum⟩
  linarith [hbudget]
set_option maxHeartbeats 1000000 in
theorem exists_reluNetworkClass_holderSmooth_unitCube_approximation_with_coefficient_bound
    {d r : ℕ} {beta C B A eps : ℝ}
    (hd : 0 < d) (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC : 0 ≤ C) (hA_nonneg : 0 ≤ A) (heps : 0 < eps)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (hCoeffBound :
      ∀ y : Fin d → ℝ,
        (∀ q : Fin d, y q ∈ Set.Icc (0 : ℝ) 1) →
        ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f y)
                (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| ≤
            A) :
    ∃ K nLocal nWeight nMul Dbase : ℕ,
      0 < K ∧ 0 < nLocal ∧ 0 < nWeight ∧ 0 < nMul ∧
      2 + d ≤ Dbase ∧
      finiteCenteredMonomialPolynomialDepthBound
          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) ≤ Dbase ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈
            reluNetworkClass d (Dbase + 1)
              (((K + 1) ^ d) *
                (d * (2 + 2 * nWeight) +
                  finiteCenteredMonomialPolynomialWidthBound nLocal
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => a.1.val) +
                  2 * nMul))
              (fullyConnectedReLUParameterCount d (Dbase + 1)
                (((K + 1) ^ d) *
                  (d * (2 + 2 * nWeight) +
                    finiteCenteredMonomialPolynomialWidthBound nLocal
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (fun a => a.1.val) +
                    2 * nMul))) ∧
          ∀ x : Fin d → ℝ,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              |g x - f x| ≤ eps := by
  -- @step s1: Obtain a positive grid size K such that the Hölder remainder budget is met.
  have h_s1 : ∃ K : ℕ,
      0 < K ∧ C / (Nat.factorial r : ℝ) * (√(d : ℝ) * (K : ℝ)⁻¹).rpow ((r : ℝ) + beta) ≤ eps / 4 := by
    exact exists_unitCube_grid_for_holder_remainder_budget hbeta_nonneg hsmooth_pos hC (div_pos heps (by norm_num))
  -- @step s2: Choose a positive nLocal such that the finite centered monomial approximation
  --   error at radius 1 is at most min (eps/4) 1 uniformly over the unit cube.
  have h_s2 : ∃ K' nLocal : ℕ,
      0 < K' ∧ 0 < nLocal ∧
        C / (Nat.factorial r : ℝ) * (√(d : ℝ) * (K' : ℝ)⁻¹).rpow ((r : ℝ) + beta) ≤ (min (eps / 4) 1) / 2 ∧
        ∀ center : Fin d → ℝ,
          (∀ q : Fin d, center q ∈ Set.Icc (0 : ℝ) 1) →
          ∃ N : FullyConnectedReLUNet d,
            0 < N.depth ∧
              N.depth ≤
                  finiteCenteredMonomialPolynomialDepthBound
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => a.1.val) ∧
              N.width ≤
                  finiteCenteredMonomialPolynomialWidthBound nLocal
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => a.1.val) ∧
              N.parameterCount ≤
                  finiteCenteredMonomialPolynomialParameterBound d nLocal
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => a.1.val) ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, |x q - center q| ≤ 1) →
                ‖x - center‖ ≤ √(d : ℝ) * (K' : ℝ)⁻¹ →
                |N.realize x - f x| ≤ min (eps / 4) 1 := by
    -- @step s1: Obtain a positive grid size K' such that the Hölder remainder budget is met:
    --   C / r.factorial * (√d * (K')⁻¹).rpow (r + beta) ≤ min (eps/4) 1 / 2.
    have h_s2_s1 : ∃ K' : ℕ,
        0 < K' ∧
          C / (Nat.factorial r : ℝ) * (√(d : ℝ) * (K' : ℝ)⁻¹).rpow ((r : ℝ) + beta) ≤ (min (eps / 4) 1) / 2 := by
      have hmin_pos : 0 < (min (eps / 4) 1) / 2 := by
        exact div_pos (lt_min (div_pos heps (by norm_num : (0 : ℝ) < 4)) (by norm_num : (0 : ℝ) < 1)) (by norm_num : (0 : ℝ) < 2)
      exact exists_unitCube_grid_for_holder_remainder_budget hbeta_nonneg hsmooth_pos hC hmin_pos
    -- @step s2: Choose a positive nLocal so that the finite centered monomial approximation
    --   error at radius 1 is at most min (eps/4) 1 / 2 for every center in the unit cube.
    have h_s2_s2 : ∃ nLocal : ℕ,
        0 < nLocal ∧
          ∀ center : Fin d → ℝ,
            (∀ q : Fin d, center q ∈ Set.Icc (0 : ℝ) 1) →
            finiteCenteredMonomialPolynomialApproxError (1 : ℝ) nLocal
                (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
                  (iteratedFDeriv ℝ a.1.val f center) (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
                (fun a => a.1.val) ≤ (min (eps / 4) 1) / 2 := by
      have hmin_pos : 0 < (min (eps / 4) 1) / 2 := by
        exact div_pos (lt_min (div_pos heps (by norm_num : (0 : ℝ) < 4)) (by norm_num : (0 : ℝ) < 1)) (by norm_num : (0 : ℝ) < 2)
      rcases exists_centeredMonomialApproxError_unit_radius_sigma_sum_le (d := d) (r := r)
          (A := A) (eta := (min (eps / 4) 1) / 2) hA_nonneg hmin_pos with ⟨nLocal, hnLocal_pos, hsum⟩
      have hErr_succ_succ : ∀ k : ℕ,
          centeredMonomialApproxError (1 : ℝ) nLocal (Nat.succ (Nat.succ k)) =
            2 * ((1 : ℝ) ^ (k + 1) + centeredMonomialApproxError (1 : ℝ) nLocal (Nat.succ k) + (1 : ℝ) + 1) ^ 2 / (nLocal : ℝ) ^ 2 +
              ((1 : ℝ) ^ (k + 1) + centeredMonomialApproxError (1 : ℝ) nLocal (Nat.succ k) + (1 : ℝ) + 1) * centeredMonomialApproxError (1 : ℝ) nLocal (Nat.succ k) := by
        intro k
        simp [centeredMonomialApproxError, Nat.brecOn, Nat.brecOn.go]
      have hErr_nonneg : ∀ k : ℕ, (0 : ℝ) ≤ centeredMonomialApproxError (1 : ℝ) nLocal k := by
        intro k
        induction k with
        | zero =>
            simp [centeredMonomialApproxError]
        | succ k ih =>
            cases k with
            | zero =>
                simp [centeredMonomialApproxError]
            | succ k' =>
                rw [hErr_succ_succ k']
                positivity
      refine ⟨nLocal, hnLocal_pos, ?_⟩
      intro center hcenter
      calc
        finiteCenteredMonomialPolynomialApproxError (1 : ℝ) nLocal
            (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
              (iteratedFDeriv ℝ a.1.val f center) (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
            (fun a => a.1.val)
            = ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                |((Nat.factorial a.1.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.1.val f center) (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0)| *
                  centeredMonomialApproxError (1 : ℝ) nLocal ↑a.fst := by
            simp [finiteCenteredMonomialPolynomialApproxError]
        _ ≤ ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                A * centeredMonomialApproxError (1 : ℝ) nLocal ↑a.fst := by
            exact Finset.sum_le_sum (by
              intro a _
              exact mul_le_mul_of_nonneg_right (hCoeffBound center hcenter a) (hErr_nonneg ↑a.fst))
        _ = A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialApproxError (1 : ℝ) nLocal ↑a.fst) := by
            rw [Finset.mul_sum]
        _ ≤ (min (eps / 4) 1) / 2 := hsum
    rcases h_s2_s1 with ⟨K', hK'_pos, hK'_rem⟩
    rcases h_s2_s2 with ⟨nLocal, hnLocal_pos, hnLocal_err⟩
    refine ⟨K', nLocal, hK'_pos, hnLocal_pos, hK'_rem, ?_⟩
    -- @step s3: For each center in the unit cube, apply E8 with R = 1 and
    --   rho = √d * (K')⁻¹. The local patch error is bounded by
    --   monomial error (s2) + Taylor remainder (s1) ≤ min (eps/4) 1 / 2 + min (eps/4) 1 / 2.
    intro center hcenter
    rcases exists_fullyConnectedReLUNet_holderSmooth_local_approx_on_centered_box_with_size_bound
        (d := d) (r := r) (n := nLocal) hd hnLocal_pos hbeta_nonneg hC
        (by positivity : 0 ≤ √(d : ℝ) * (K' : ℝ)⁻¹)
        (by norm_num : (0 : ℝ) < 1) f hf center with
      ⟨N, hNdepth_pos, hNdepth, hNwidth, hNparam, hNerr⟩
    refine ⟨N, hNdepth_pos, hNdepth, hNwidth, hNparam, ?_⟩
    intro x hxbox hxnorm
    have hbound := hNerr x hxbox hxnorm
    have hsum : finiteCenteredMonomialPolynomialApproxError (1 : ℝ) nLocal
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
          (iteratedFDeriv ℝ a.1.val f center) (fun q : Fin a.1.val => fun u : Fin d => if u = a.2 q then 1 else 0))
        (fun a => a.1.val) +
        C / (Nat.factorial r : ℝ) * (√(d : ℝ) * (K' : ℝ)⁻¹).rpow ((r : ℝ) + beta) ≤
        min (eps / 4) 1 := by
      linarith [hnLocal_err center hcenter, hK'_rem]
    exact le_trans hbound hsum
  -- @step s3: Obtain positive nWeight and nMul, together with weightEta and productDelta,
  --   so that the tent-product network over the K-grid accumulates error at most eps/2
  --   while satisfying the weight-radius and product-radius conditions.
  have h_s3 : ∃ nWeight nMul : ℕ,
      0 < nWeight ∧ 0 < nMul ∧
        ∃ weightEta productDelta : ℝ,
          0 ≤ weightEta ∧ 0 ≤ productDelta ∧
            (Finset.range d).sum (fun k : ℕ => (2 : ℝ) ^ k) *
                (2 * (2 : ℝ) ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta ∧
            weightEta ≤ (2 : ℝ) - 1 ∧
            1 + weightEta ≤
              A * Finset.univ.sum
                  (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) + 2 := by
    rcases exists_unitCube_grid_for_holder_remainder_budget (d := d) hbeta_nonneg hsmooth_pos hC
      (div_pos heps (by norm_num : (0 : ℝ) < 4)) with ⟨K, hK_pos, _⟩
    have hS_nonneg : (0 : ℝ) ≤
        ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val := by
      exact Finset.sum_nonneg (by
        intro a _
        exact pow_nonneg (by norm_num) a.1.val)
    have hAS_nonneg : (0 : ℝ) ≤
        A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) := by
      exact mul_nonneg hA_nonneg hS_nonneg
    have hprodRadius_pos : (1 : ℝ) <
        A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) + 2 := by
      nlinarith [hAS_nonneg]
    have hweightRadius_pos : (1 : ℝ) < (2 : ℝ) := by norm_num
    have heta_pos : (0 : ℝ) < eps / 2 := by
      exact div_pos heps (by norm_num)
    rcases exists_unitCube_tent_product_error_budget (d := d) (K := K)
        (productRadius :=
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), (1 : ℝ) ^ a.1.val) + 2)
        (weightRadius := (2 : ℝ)) (eta := eps / 2) hK_pos hprodRadius_pos hweightRadius_pos heta_pos with
      ⟨nWeight, nMul, hnWeight_pos, hnMul_pos, weightEta, productDelta, hwEta_nonneg, hwBudget,
        hwEta_le, hprod_slack, hprodDelta_ineq, hpd_nonneg, hpd_sum⟩
    refine ⟨nWeight, nMul, hnWeight_pos, hnMul_pos, weightEta, productDelta, hwEta_nonneg,
      hpd_nonneg, ?_, ?_, ?_⟩
    · simpa using hwBudget
    · simpa using hwEta_le
    · simpa using hprod_slack
  -- @step s4: Define Dbase and the width/parameter budgets exactly as in the conclusion and
  --   apply the assembly theorem to obtain the network g with the pointwise error bound.
  have h_s4 : ∃ K nLocal nWeight nMul Dbase : ℕ,
      0 < K ∧ 0 < nLocal ∧ 0 < nWeight ∧ 0 < nMul ∧
      2 + d ≤ Dbase ∧
      finiteCenteredMonomialPolynomialDepthBound
          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) ≤ Dbase ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈
            reluNetworkClass d (Dbase + 1)
              (((K + 1) ^ d) *
                (d * (2 + 2 * nWeight) +
                  finiteCenteredMonomialPolynomialWidthBound nLocal
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => a.1.val) +
                  2 * nMul))
              (fullyConnectedReLUParameterCount d (Dbase + 1)
                (((K + 1) ^ d) *
                  (d * (2 + 2 * nWeight) +
                    finiteCenteredMonomialPolynomialWidthBound nLocal
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (fun a => a.1.val) +
                    2 * nMul))) ∧
          ∀ x : Fin d → ℝ,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → |g x - f x| ≤ eps := by
    rcases h_s2 with ⟨K', nLocal, hK'_pos, hnLocal_pos, hK'_rem, hlocal⟩
    -- @step s1: Obtain the full tent-product error budget from E10 with K := K'
    --   (the grid index from h_s2): nWeight, nMul positive, weightEta nonnegative with
    --   the weight-sum budget, weightEta ≤ 1, the product-radius slack
    --   1 + weightEta ≤ A * (∑ a, 1 ^ a.fst) + 2, and ∑ productDelta ≤ eps/2.
    have h_s4_s1 : ∃ nWeight nMul : ℕ,
        0 < nWeight ∧ 0 < nMul ∧
        ∃ weightEta productDelta : ℝ,
          0 ≤ weightEta ∧
          (Finset.range d).sum (fun k : ℕ => (2 : ℝ) ^ k) *
              (2 * (2 : ℝ) ^ 2 / (nWeight : ℝ) ^ 2) ≤ weightEta ∧
          weightEta ≤ (2 : ℝ) - 1 ∧
          1 + weightEta ≤
            A * Finset.univ.sum
                (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) + 2 ∧
              (∑ j : Fin ((K' + 1) ^ d), productDelta) ≤ eps / 2 := by
          have hS_ge_one : (1 : ℝ) ≤ Finset.univ.sum
              (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) := by
            simp only [one_pow]
            exact Finset.single_le_sum (s := Finset.univ)
              (f := fun _ : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ))
              (by intro i hi; norm_num) (a := ⟨(0 : Fin (r + 1)), Fin.elim0⟩) (by simp)
          have hpr : 1 < A * Finset.univ.sum
              (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) + 2 := by
            have hAS : 0 ≤ A * Finset.univ.sum
                (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) := by
              exact mul_nonneg hA_nonneg (le_trans zero_le_one hS_ge_one)
            linarith
          rcases exists_unitCube_tent_product_error_budget (d := d) (K := K')
              (productRadius := A * Finset.univ.sum
                  (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (1 : ℝ) ^ a.1.val) + 2)
              (weightRadius := (2 : ℝ)) (eta := eps / 2) hK'_pos hpr (by norm_num)
              (by exact div_pos heps (by norm_num)) with
            ⟨nWeight, nMul, hnW, hnM, weightEta, productDelta, hweta0, hwsum, hweta1, hprodSlack,
              _hprodDeltaBound, _hprodDelta0, hsumBound⟩
          exact ⟨nWeight, nMul, hnW, hnM, weightEta, productDelta, hweta0, hwsum, hweta1, hprodSlack, hsumBound⟩
    -- @step s2: Assemble the final network by instantiating E4 with K := K' (grid cells of size
    --   1/K' covered by h_s2's local nets with radius √d * (K')⁻¹), nLocal from h_s2, nWeight/nMul
    --   from s1, Dbase := max (2 + d) depthBound, coeffBound := A, localEps := min (eps/4) 1,
    --   productRadius := A * (∑ a, 1^a.fst) + 2, weightRadius := 2, weightEta/productDelta from s1;
    --   the theorem returns g in reluNetworkClass with the stated budgets and |g x - f x| ≤ eps,
    --   which witnesses the existential.
    have h_s4_s2 : ∃ K nLocal nWeight nMul Dbase : ℕ,
        0 < K ∧ 0 < nLocal ∧ 0 < nWeight ∧ 0 < nMul ∧
        2 + d ≤ Dbase ∧
        finiteCenteredMonomialPolynomialDepthBound
            (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
            (fun a => a.1.val) ≤ Dbase ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈
              reluNetworkClass d (Dbase + 1)
                (((K + 1) ^ d) *
                  (d * (2 + 2 * nWeight) +
                    finiteCenteredMonomialPolynomialWidthBound nLocal
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (fun a => a.1.val) +
