      hd hbeta_nonneg hsmooth_pos hC hA_nonneg heps hA_bound with
    ⟨K, nLocal, nWeight, nMul, Dbase, hK, hnLocal, hnWeight, hnMul, hDepth, hDepthBound, hArch⟩
  refine ⟨K, nLocal, nWeight, nMul, Dbase, hK, hnLocal, hnWeight, hnMul, hDepth, hDepthBound, ?_⟩
  · intro f hf
    rcases hArch f hf with ⟨g, hg_mem, hg_approx⟩
    exact ⟨g, hg_mem, hg_approx⟩


theorem holderSmoothBall_unitCube_uniform_architecture_to_parameter_count
    {d r K nLocal nWeight nMul Dbase : ℕ} {beta C B eps : ℝ}
    (hRaw :
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ holderSmoothBall r beta C B →
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈
              reluNetworkClass d (Dbase + 1)
                (((K + 1) ^ d) *
                  (d * (2 + 2 * nWeight) +
                    finiteCenteredMonomialPolynomialWidthBound nLocal
                      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                      (fun a => a.1.val) +
                    2 * nMul))
                (fullyConnectedReLUParameterCount d (Dbase + 1)
                  (((K + 1) ^ d) *
                    (d * (2 + 2 * nWeight) +
                      finiteCenteredMonomialPolynomialWidthBound nLocal
                        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                        (fun a => a.1.val) +
                      2 * nMul))) ∧
            ∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ eps) :
    ∃ D W P : ℕ,
      0 < D ∧
        P = fullyConnectedReLUParameterCount d D W ∧
        ∀ f : (Fin d → ℝ) → ℝ,
          f ∈ holderSmoothBall r beta C B →
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d D W P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  |g x - f x| ≤ eps := by
  let W : ℕ := ((K + 1) ^ d) *
      (d * (2 + 2 * nWeight) +
        finiteCenteredMonomialPolynomialWidthBound nLocal
          (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) +
        2 * nMul)
  refine ⟨Dbase + 1, W, fullyConnectedReLUParameterCount d (Dbase + 1) W, ?_⟩
  constructor
  · exact Nat.succ_pos Dbase
  · constructor
    · rfl
    · intro f hf
      rcases hRaw f hf with ⟨g, hg_mem, hg_err⟩
      refine ⟨g, ?_, ?_⟩
      · simpa [W] using hg_mem
      · simpa using hg_err


theorem exists_reluNetworkClass_holderSmoothBall_unitCube_uniform_parameter_count
    {d r : ℕ} {beta C B eps : ℝ}
    (hd : 0 < d) (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (heps : 0 < eps) :
    ∃ D W P : ℕ,
      0 < D ∧
      P = fullyConnectedReLUParameterCount d D W ∧
      ∀ f : (Fin d → ℝ) → ℝ,
        f ∈ holderSmoothBall r beta C B →
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D W P ∧
            ∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ eps := by
  rcases exists_reluNetworkClass_holderSmoothBall_unitCube_uniform_architecture
      (d := d) (r := r) (beta := beta) (C := C) (B := B) (eps := eps)
      hd hbeta_nonneg hsmooth_pos hC hB heps with
    ⟨K, nLocal, nWeight, nMul, Dbase, _, _, _, _, _, _, hforallf⟩
  exact holderSmoothBall_unitCube_uniform_architecture_to_parameter_count
    (d := d) (r := r) (K := K) (nLocal := nLocal) (nWeight := nWeight)
    (nMul := nMul) (Dbase := Dbase) (beta := beta) (C := C) (B := B)
    (eps := eps) hforallf

theorem fullyConnectedReLUParameterCount_fixed_width_le_linear_depth
    (d W0 : ℕ) :
    ∃ c : ℝ, 0 < c ∧
      ∀ D : ℕ, 0 < D →
        (fullyConnectedReLUParameterCount d D W0 : ℝ) ≤ c * (D : ℝ) := by
  let Cn := (d + 1) * W0 + ((W0 + 1) * W0) + (W0 + 1) + 1
  refine ⟨(Cn : ℝ), ?pos, ?main⟩
  · have hc : 0 < Cn := by
      unfold Cn
      positivity
    exact_mod_cast hc
  · intro D hD
    have hNat : fullyConnectedReLUParameterCount d D W0 ≤ Cn * D := by
      unfold fullyConnectedReLUParameterCount Cn
      have hDge1 : 1 ≤ D := Nat.succ_le_of_lt hD
      have hDsub : D - 1 ≤ D := Nat.sub_le D 1
      have hA_le : (d + 1) * W0 ≤ D * ((d + 1) * W0) := by
        exact Nat.le_mul_of_pos_left ((d + 1) * W0) hD
      have hB_le : (D - 1) * ((W0 + 1) * W0) ≤ D * ((W0 + 1) * W0) := by
        exact Nat.mul_le_mul_right ((W0 + 1) * W0) hDsub
      have hC_le : W0 + 1 ≤ D * (W0 + 1) := by
        exact Nat.le_mul_of_pos_left (W0 + 1) hD
      nlinarith [hA_le, hB_le, hC_le, hD, hDge1]
    have hReal :
        (fullyConnectedReLUParameterCount d D W0 : ℝ) ≤ (Cn : ℝ) * (D : ℝ) := by
      exact_mod_cast hNat
    exact hReal

theorem exists_nat_scale_for_rpow_epsilon_rate
    {a p : ℝ} (d : ℕ)
    (ha : 0 < a) (hp : 0 < p) :
    ∃ cM : ℝ, 0 < cM ∧
      ∀ eps : ℝ, 0 < eps → eps ≤ 1 →
        ∃ M : ℕ, 0 < M ∧
          a * (M : ℝ).rpow (-(2 * p)) ≤ eps ∧
          ((M : ℝ) ^ d) ≤
            cM * eps.rpow (-(d : ℝ) / (2 * p)) := by
  let s : ℝ := a.rpow (1 / (2 * p))
  refine ⟨(1 + s) ^ d, ?_, ?_⟩
  · have hs0 : 0 < s := by
      dsimp [s]
      exact Real.rpow_pos_of_pos ha _
    exact pow_pos (by linarith) d
  · intro eps heps hele
    let q : ℝ := -(1 / (2 * p))
    let t : ℝ := (a / eps) ^ (1 / (2 * p))
    set M : ℕ := Nat.ceil t with hMdef
    have ht_pos : 0 < t := by
      dsimp [t]
      exact Real.rpow_pos_of_pos (div_pos ha heps) _
    have hMt : t ≤ (M : ℝ) := by
      exact (Nat.ceil_le.mp (by simpa [hMdef] using (le_refl M)))
    have hM0 : 0 < M := by
      have : (0 : ℝ) < (M : ℝ) := lt_of_lt_of_le ht_pos hMt
      exact_mod_cast this
    have hMcast : 0 < (M : ℝ) := by
      exact_mod_cast hM0
    refine ⟨M, hM0, ?_, ?_⟩
    · have hp2 : 0 < 2 * p := by positivity
      have hp2n : 0 ≤ 2 * p := le_of_lt hp2
      have ht2 : t ^ (2 * p) = a / eps := by
        dsimp [t]
        rw [← Real.rpow_mul (le_of_lt (div_pos ha heps))]
        rw [show (1 / (2 * p)) * (2 * p) = 1 by field_simp [ne_of_gt hp2]]
        exact Real.rpow_one (a / eps)
      have hMle : t ^ (2 * p) ≤ (M : ℝ) ^ (2 * p) :=
        Real.rpow_le_rpow (le_of_lt ht_pos) hMt hp2n
      have ha_le : a / eps ≤ (M : ℝ) ^ (2 * p) := by
        rw [← ht2]
        exact hMle
      have hB : 0 < (M : ℝ) ^ (2 * p) := Real.rpow_pos_of_pos hMcast (2 * p)
      have ha_eps : a ≤ eps * ((M : ℝ) ^ (2 * p)) := by
        have h2 : (a / eps) * eps ≤ ((M : ℝ) ^ (2 * p)) * eps :=
          mul_le_mul_of_nonneg_right ha_le (le_of_lt heps)
        have h3 : a ≤ ((M : ℝ) ^ (2 * p)) * eps := by
          rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ (ne_of_gt heps), mul_one] at h2
          exact h2
        simpa [mul_comm] using h3
      have hdiv : a * ((M : ℝ) ^ (2 * p))⁻¹ ≤ eps := by
        calc
          a * ((M : ℝ) ^ (2 * p))⁻¹
              ≤ (eps * ((M : ℝ) ^ (2 * p))) * ((M : ℝ) ^ (2 * p))⁻¹ := by
                exact mul_le_mul_of_nonneg_right ha_eps (inv_nonneg.mpr (le_of_lt hB))
          _ = eps := by
            rw [mul_assoc, mul_inv_cancel₀ (ne_of_gt hB), mul_one]
      change a * ((M : ℝ) ^ (-(2 * p))) ≤ eps
      rw [Real.rpow_neg (le_of_lt hMcast)]
      exact hdiv
    · have hs : 0 < s := by
        dsimp [s]
        exact Real.rpow_pos_of_pos ha _
      have hM_lt : (M : ℝ) < t + 1 := Nat.ceil_lt_add_one (le_of_lt ht_pos)
      have hM_le_t1 : (M : ℝ) ≤ t + 1 := le_of_lt hM_lt
      have hp2' : 0 < 1 / (2 * p) := by positivity
      have heps' : 0 ≤ eps := le_of_lt heps
      have hε : eps ^ (1 / (2 * p)) ≤ 1 := by
        simpa [Real.one_rpow] using (Real.rpow_le_rpow heps' hele (le_of_lt hp2'))
      have ht_eq : t = s * eps ^ q := by
        dsimp [t, s, q]
        rw [Real.div_rpow (le_of_lt ha) heps']
        rw [div_eq_mul_inv]
        rw [← Real.rpow_neg heps']
      have hqadd : q + (1 / (2 * p)) = 0 := by
        dsimp [q]
        ring
      have hprod : eps ^ q * eps ^ (1 / (2 * p)) = 1 := by
        rw [← Real.rpow_add heps, hqadd, Real.rpow_zero]
      have hht_le : t + 1 ≤ eps ^ q * (s + 1) := by
        calc
          t + 1 = s * eps ^ q + 1 := by rw [ht_eq]
          _ = s * eps ^ q + eps ^ q * eps ^ (1 / (2 * p)) := by rw [hprod]
          _ = eps ^ q * (s + eps ^ (1 / (2 * p))) := by ring
          _ ≤ eps ^ q * (s + 1) := by
            exact mul_le_mul_of_nonneg_left (add_le_add_right hε s)
              (le_of_lt (Real.rpow_pos_of_pos heps q))
      have hMm : (M : ℝ) ≤ (s + 1) * eps ^ q := by
        have h := le_trans hM_le_t1 hht_le
        rwa [mul_comm] at h
      have hMpow : (M : ℝ) ^ d ≤ ((s + 1) * eps ^ q) ^ d := by
        exact pow_le_pow_left₀ (le_of_lt hMcast) hMm d
      have hq_d : q * (d : ℝ) = -(d : ℝ) / (2 * p) := by
        dsimp [q]
        ring
      have hepsq_d : (eps ^ q) ^ d = eps ^ (q * (d : ℝ)) := by
        calc
          (eps ^ q) ^ d = (eps ^ q) ^ ((d : ℝ)) := by
            rw [← Real.rpow_natCast (eps ^ q) d]
          _ = eps ^ (q * (d : ℝ)) := by
            rw [← Real.rpow_mul heps']
      have hfin : ((s + 1) * eps ^ q) ^ d
          = (1 + s) ^ d * eps.rpow (-(d : ℝ) / (2 * p)) := by
        rw [mul_pow]
        rw [show s + 1 = 1 + s by ring]
        congr 1
        calc
          (eps ^ q) ^ d = eps ^ (q * (d : ℝ)) := hepsq_d
          _ = eps ^ (-(d : ℝ) / (2 * p)) := by rw [hq_d]
      calc
        (M : ℝ) ^ d ≤ ((s + 1) * eps ^ q) ^ d := hMpow
        _ = (1 + s) ^ d * eps.rpow (-(d : ℝ) / (2 * p)) := hfin

theorem holderSmoothBall_unitCube_epsilon_rate_from_M_rate
    {d r W0 : ℕ} {beta C B cDepth cErr : ℝ}
    (hd : 0 < d) (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hC : 0 ≤ C) (hB : 0 ≤ B)
    (hcDepth : 0 < cDepth) (hcErr : 0 < cErr)
    (hMrate :
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤
                      cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cParam : ℝ, 0 < cParam ∧
      ∀ eps : ℝ, 0 < eps → eps ≤ 1 →
        ∃ D W P : ℕ,
          0 < D ∧
          P = fullyConnectedReLUParameterCount d D W ∧
          (P : ℝ) ≤
            cParam *
              eps.rpow (-(d : ℝ) / (2 * ((r : ℝ) + beta))) ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤ eps := by
  rcases (exists_nat_scale_for_rpow_epsilon_rate d hcErr hsmooth_pos) with
    ⟨cM, hcM_pos, hcM_rate⟩
  rcases (fullyConnectedReLUParameterCount_fixed_width_le_linear_depth d W0) with
    ⟨cWidth, hcWidth_pos, hcWidth_le⟩
  let cParam : ℝ := cWidth * cDepth * cM
  have hcParam_pos : 0 < cParam := by
    positivity
  refine ⟨cParam, hcParam_pos, ?_⟩
  intro eps heps_pos heps_le1
  rcases (hcM_rate eps heps_pos heps_le1) with ⟨M, hM_pos, hM_rpow_le, hM_d⟩
  rcases (hMrate M hM_pos) with ⟨D, P, hD_pos, hD_le, hP_eq_M, hMrate_f⟩
  refine ⟨D, W0, P, hD_pos, ?_peq, ?_ple, ?_f⟩
  · exact hP_eq_M
  · have hP_le : (P : ℝ) ≤ cWidth * (D : ℝ) := by
      rw [hP_eq_M]
      exact hcWidth_le D hD_pos
    calc
      (P : ℝ) ≤ cWidth * (D : ℝ) := hP_le
      _ ≤ cWidth * (cDepth * (M : ℝ) ^ d) := by
        exact mul_le_mul_of_nonneg_left hD_le hcWidth_pos.le
      _ = cWidth * cDepth * (M : ℝ) ^ d := by ring
      _ ≤ cWidth * cDepth *
          (cM * eps.rpow (-(d : ℝ) / (2 * ((r : ℝ) + beta)))) := by
        exact mul_le_mul_of_nonneg_left hM_d (mul_nonneg hcWidth_pos.le hcDepth.le)
      _ = cParam * eps.rpow (-(d : ℝ) / (2 * ((r : ℝ) + beta))) := by
        simp [cParam]
        ring
  · intro f hf
    rcases (hMrate_f f hf) with ⟨g, hg_in, hg_approx⟩
    refine ⟨g, hg_in, ?_⟩
    intro x hx_mem
    exact le_trans (hg_approx x hx_mem) hM_rpow_le

/-- Fixed-width serial ReLU approximation of the square map on the unit interval.

There are fixed positive constants `W0`, `cDepth`, and `cErr` such that for every
`n ≥ 1`, the square map on `[0,1]` is approximated by a fully connected ReLU
network of fixed width `W0`, depth at most `cDepth * n`, and true fully connected
parameter count, with uniform error at most `cErr * n⁻²`. -/
theorem exists_reluNetworkClass_unitInterval_square_fixed_width_depth_rate :
    ∃ W0 : ℕ, 0 < W0 ∧
      ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
        ∀ n : ℕ, 0 < n →
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * (n : ℝ) ∧
            P = fullyConnectedReLUParameterCount 1 D W0 ∧
            ∃ g : (Fin 1 → ℝ) → ℝ,
              g ∈ reluNetworkClass 1 D W0 P ∧
                ∀ x : Fin 1 → ℝ,
                  x 0 ∈ Set.Icc (0 : ℝ) 1 →
                    |g x - (x 0) ^ 2| ≤ cErr * (n : ℝ).rpow (-2 : ℝ) := by
  -- @step s1: fixed width W0 = 2; for every n > 0 a fully connected net of depth D (0 < D, D ≤ c₁*n,
  -- width W0, parameter count ≤ full count) whose realize-map equals Fₙ = squareReLUHingeInterpolant n
  have h_s1 :
      ∃ W0 : ℕ, 0 < W0 ∧
        ∃ c₁ : ℝ, 0 < c₁ ∧
          ∀ n : ℕ, 0 < n →
            ∃ D : ℕ, 0 < D ∧ (D : ℝ) ≤ c₁ * (n : ℝ) ∧
              ∃ N : FullyConnectedReLUNet 1,
                N.depth = D ∧ N.width = W0 ∧
                  N.parameterCount ≤ fullyConnectedReLUParameterCount 1 D W0 ∧
                  ∀ x : Fin 1 → ℝ, N.realize x = squareReLUHingeInterpolant n (x 0) := by
    -- @step s1: construct the width-2 alternating-layer network N (depth D = 2n-1) for each n > 0
    let h_net : ∀ (n : ℕ), 0 < n →
        { N : FullyConnectedReLUNet 1 // N.depth = 2 * n - 1 ∧ N.width = 2 } :=
      fun n hn =>
        ⟨{ depth := 2 * n - 1
           width := 2
           input :=
             { weight := fun j _ => if (j : ℕ) = 0 then 1 else 1 / (n : ℝ)
               bias := fun _ => 0 }
           hidden := fun i =>
             if (i : ℕ) % 2 = 0 then
               { weight := fun j i => if (j : ℕ) = (i : ℕ) then 1 else 0
                 bias := fun j => if (j : ℕ) = 0 then -1 / (n : ℝ) else 0 }
             else
               { weight := fun j i =>
                   if (j : ℕ) = 0 then (if (i : ℕ) = 0 then 1 else 0)
                   else (if (i : ℕ) = 0 then 2 / (n : ℝ) else 1)
                 bias := fun _ => 0 }
           outputWeight := fun j => if (j : ℕ) = 1 then 1 else 0
           outputBias := 0 }, rfl, rfl⟩
    -- @step s2: serial-chain register invariant after m pairs of hidden layers (induction)
    have h_inv : ∀ (n : ℕ) (hn : 0 < n) (x : Fin 1 → ℝ) (m : ℕ), m ≤ n - 1 →
        ((h_net n hn).1.hiddenState x (2 * m) ⟨0, by have hw := (h_net n hn).2.2; omega⟩ =
            relu (x 0 - (m : ℝ) / (n : ℝ)) ∧
          (h_net n hn).1.hiddenState x (2 * m) ⟨1, by have hw := (h_net n hn).2.2; omega⟩ =
            (1 / (n : ℝ)) * relu (x 0) +
              ∑ j ∈ Finset.range m, (2 / (n : ℝ)) * relu (x 0 - ((j + 1 : ℕ) : ℝ) / (n : ℝ))) := by
      intro n hn x m hm
      let N : FullyConnectedReLUNet 1 := (h_net n hn).1
      have hN : N.depth = 2 * n - 1 ∧ N.width = 2 := (h_net n hn).2
      have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
      have h1n_nonneg : (0 : ℝ) ≤ 1 / (n : ℝ) := by
        exact div_nonneg (by norm_num) (le_of_lt hnR)
      have h2n_nonneg : (0 : ℝ) ≤ 2 / (n : ℝ) := by
        exact div_nonneg (by norm_num) (le_of_lt hnR)
      have hrelu_nonneg : ∀ u : ℝ, 0 ≤ relu u := by
        intro u
        unfold relu
        exact le_max_right u 0
      have hrelu_of_nonneg : ∀ u : ℝ, 0 ≤ u → relu u = u := by
        intro u hu
        unfold relu
        exact max_eq_left hu
      have hrelu_mul : ∀ a u : ℝ, 0 ≤ a → relu (a * u) = a * relu u := by
        intro a u ha
        unfold relu
        by_cases hu : 0 ≤ u
        · have h1 : max u 0 = u := max_eq_left hu
          rw [h1]
          rw [max_eq_left (mul_nonneg ha hu)]
        · have hu' : u ≤ 0 := le_of_not_ge hu
          have h1 : max u 0 = 0 := max_eq_right hu'
          rw [h1]
          rw [mul_zero]
          rw [max_eq_right (mul_nonpos_of_nonneg_of_nonpos ha hu')]
      have hrelu_slide : ∀ t a : ℝ, 0 ≤ a → relu (relu t - a) = relu (t - a) := by
        intro t a ha
        unfold relu
        by_cases ht : t ≤ 0
        · have hmax : max t 0 = 0 := max_eq_right ht
          rw [hmax]
          have h1 : 0 - a ≤ 0 := by linarith
          have h2 : t - a ≤ 0 := by linarith
          rw [max_eq_right h1, max_eq_right h2]
        · have ht' : 0 ≤ t := le_of_lt (lt_of_not_ge ht)
          have hmax : max t 0 = t := max_eq_left ht'
          rw [hmax]
      have hw2 : N.width = 2 := hN.2
      have hfin0 : (0 : ℕ) < N.width := by rw [hw2]; norm_num
      have hfin1 : (1 : ℕ) < N.width := by rw [hw2]; norm_num
      have hN_val : N =
          ({ depth := 2 * n - 1
             width := 2
             input :=
               { weight := fun j _ => if (j : ℕ) = 0 then 1 else 1 / (n : ℝ)
                 bias := fun _ => 0 }
             hidden := fun i =>
               if (i : ℕ) % 2 = 0 then
                 { weight := fun j i => if (j : ℕ) = (i : ℕ) then 1 else 0
                   bias := fun j => if (j : ℕ) = 0 then -1 / (n : ℝ) else 0 }
               else
                 { weight := fun j i =>
                     if (j : ℕ) = 0 then (if (i : ℕ) = 0 then 1 else 0)
                     else (if (i : ℕ) = 0 then 2 / (n : ℝ) else 1)
                   bias := fun _ => 0 }
             outputWeight := fun j => if (j : ℕ) = 1 then 1 else 0
             outputBias := 0 } : FullyConnectedReLUNet 1) := rfl
      change
        (N.hiddenState x (2 * m) ⟨0, hfin0⟩ = relu (x 0 - (m : ℝ) / (n : ℝ)) ∧
          N.hiddenState x (2 * m) ⟨1, hfin1⟩ =
            (1 / (n : ℝ)) * relu (x 0) +
              ∑ j ∈ Finset.range m, (2 / (n : ℝ)) * relu (x 0 - ((j + 1 : ℕ) : ℝ) / (n : ℝ)))
      induction m with
      | zero =>
          constructor
          · simp [N, h_net, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_one]
          · simp [N, h_net, FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_one]
            rw [hrelu_mul ((n : ℝ)⁻¹) (x 0) (inv_nonneg.mpr (le_of_lt hnR))]
      | succ m ih =>
          have hguard0 : 2 * m < N.depth - 1 := by
            rw [hN.1]
            omega
          have hguard1 : 2 * m + 1 < N.depth - 1 := by
            rw [hN.1]
            omega
          have hpar0 : (2 * m : ℕ) % 2 = 0 := by omega
          have hpar1 : (2 * m + 1 : ℕ) % 2 = 1 := by omega
          let st := N.hiddenState x (2 * m)
          have hst0 : st ⟨0, hfin0⟩ = relu (x 0 - (m : ℝ) / (n : ℝ)) := by
            simpa [st] using (ih (by omega)).1
          have hst1 : st ⟨1, hfin1⟩ = (1 / (n : ℝ)) * relu (x 0) +
              ∑ j ∈ Finset.range m, (2 / (n : ℝ)) * relu (x 0 - ((j + 1 : ℕ) : ℝ) / (n : ℝ)) := by
            simpa [st] using (ih (by omega)).2
          have hs0 : N.hiddenState x (2 * m + 1) =
              (N.hidden ⟨2 * m, hguard0⟩).reluApply (N.hiddenState x (2 * m)) := by
            simp [FullyConnectedReLUNet.hiddenState, hguard0]
          have hs1 : N.hiddenState x (2 * (m + 1)) =
              (N.hidden ⟨2 * m + 1, hguard1⟩).reluApply (N.hiddenState x (2 * m + 1)) := by
            have htwo : 2 * (m + 1) = 2 * m + 2 := by omega
            rw [htwo]
            simp [FullyConnectedReLUNet.hiddenState, hguard0, hguard1]
          have h_even : ∀ s : Fin N.width → ℝ,
              (N.hidden ⟨2 * m, hguard0⟩).reluApply s ⟨0, hfin0⟩ = relu (s ⟨0, hfin0⟩ - 1 / (n : ℝ)) ∧
              (N.hidden ⟨2 * m, hguard0⟩).reluApply s ⟨1, hfin1⟩ = relu (s ⟨1, hfin1⟩) := by
            intro s
            constructor
            · simp [N, h_net, hpar0, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_two]
              try (congr 1; ring)
            · simp [N, h_net, hpar0, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_two]
              try (congr 1; ring)
          have h_odd : ∀ s : Fin N.width → ℝ,
              (N.hidden ⟨2 * m + 1, hguard1⟩).reluApply s ⟨0, hfin0⟩ = relu (s ⟨0, hfin0⟩) ∧
              (N.hidden ⟨2 * m + 1, hguard1⟩).reluApply s ⟨1, hfin1⟩ =
                relu (s ⟨1, hfin1⟩ + (2 / (n : ℝ)) * s ⟨0, hfin0⟩) := by
            intro s
            constructor
            · simp [N, h_net, hpar1, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_two]
              try (congr 1; ring)
            · simp [N, h_net, hpar1, DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_two]
              try (congr 1; ring)
          have hst1_nonneg : 0 ≤ st ⟨1, hfin1⟩ := by
            rw [hst1]
            have h1 : (0 : ℝ) ≤ (1 / (n : ℝ)) * relu (x 0) := by
              exact mul_nonneg h1n_nonneg (hrelu_nonneg (x 0))
            have h2 : (0 : ℝ) ≤
                ∑ j ∈ Finset.range m, (2 / (n : ℝ)) * relu (x 0 - ((j + 1 : ℕ) : ℝ) / (n : ℝ)) := by
              exact Finset.sum_nonneg (fun j hj => mul_nonneg h2n_nonneg (hrelu_nonneg _))
            linarith
          have hmid0 : N.hiddenState x (2 * m + 1) ⟨0, hfin0⟩ =
              relu (x 0 - ((m + 1 : ℕ) : ℝ) / (n : ℝ)) := by
            rw [hs0]
            rw [(h_even (N.hiddenState x (2 * m))).1]
            change relu (st ⟨0, hfin0⟩ - 1 / (n : ℝ)) = relu (x 0 - ((m + 1 : ℕ) : ℝ) / (n : ℝ))
            rw [hst0]
            have hslide : relu (relu (x 0 - (m : ℝ) / (n : ℝ)) - 1 / (n : ℝ)) =
                relu (x 0 - ((m + 1 : ℕ) : ℝ) / (n : ℝ)) := by
              rw [hrelu_slide (x 0 - (m : ℝ) / (n : ℝ)) (1 / (n : ℝ)) h1n_nonneg]
              congr 1
              norm_num [Nat.cast_add]
              ring
            exact hslide
          have hmid1 : N.hiddenState x (2 * m + 1) ⟨1, hfin1⟩ = st ⟨1, hfin1⟩ := by
            rw [hs0]
            rw [(h_even (N.hiddenState x (2 * m))).2]
            exact hrelu_of_nonneg (st ⟨1, hfin1⟩) hst1_nonneg
          constructor
          · rw [hs1]
            rw [(h_odd (N.hiddenState x (2 * m + 1))).1]
            rw [hmid0]
            rw [hrelu_of_nonneg _ (hrelu_nonneg _)]
          · rw [hs1]
            rw [(h_odd (N.hiddenState x (2 * m + 1))).2]
            rw [hmid1, hmid0]
            have harg_nonneg : 0 ≤ st ⟨1, hfin1⟩ +
                (2 / (n : ℝ)) * relu (x 0 - ((m + 1 : ℕ) : ℝ) / (n : ℝ)) := by
              have h1 : (0 : ℝ) ≤ (2 / (n : ℝ)) * relu (x 0 - ((m + 1 : ℕ) : ℝ) / (n : ℝ)) := by
                exact mul_nonneg h2n_nonneg (hrelu_nonneg _)
              linarith
            rw [hrelu_of_nonneg _ harg_nonneg]
            rw [hst1]
            rw [Finset.sum_range_succ]
            ring
    -- @step s3: at the terminal counter m = n-1, the invariant and the output layer give the interpolant
    have h_realize : ∀ (n : ℕ) (hn : 0 < n) (x : Fin 1 → ℝ),
        (h_net n hn).1.realize x = squareReLUHingeInterpolant n (x 0) := by
      intro n hn x
      let N : FullyConnectedReLUNet 1 := (h_net n hn).1
      have hN : N.depth = 2 * n - 1 ∧ N.width = 2 := (h_net n hn).2
      have hcounter : N.depth - 1 = 2 * (n - 1) := by
        rw [hN.1]
        omega
      have hfin1 : (1 : ℕ) < N.width := by
        rw [hN.2]
        norm_num
      have hinv1 : N.hiddenState x (2 * (n - 1)) ⟨1, hfin1⟩ =
          (1 / (n : ℝ)) * relu (x 0) +
            ∑ j ∈ Finset.range (n - 1), (2 / (n : ℝ)) * relu (x 0 - ((j + 1 : ℕ) : ℝ) / (n : ℝ)) := by
        simpa [N, hfin1] using (h_inv n hn x (n - 1) (by omega)).2
      change N.realize x = squareReLUHingeInterpolant n (x 0)
      rw [FullyConnectedReLUNet.realize]
      have hzero_others : ∀ b : Fin N.width, b ≠ ⟨1, hfin1⟩ →
          N.outputWeight b * N.hiddenState x (N.depth - 1) b = 0 := by
        intro b hb
        have hbval : (b : ℕ) ≠ 1 := by
          intro hbv
          exact hb (Fin.ext hbv)
        simp [N, h_net, hbval]
      rw [Fintype.sum_eq_single ⟨1, hfin1⟩ hzero_others]
      rw [show N.outputWeight ⟨1, hfin1⟩ = 1 by simp [N, h_net]]
      rw [show N.outputBias = 0 by simp [N, h_net]]
      rw [one_mul]
      rw [add_zero]
      rw [hcounter]
      rw [hinv1]
      rfl
    -- @step s4: parameter-count bound for the constructed network (depth 2n-1, width 2)
    have h_params : ∀ (n : ℕ) (hn : 0 < n),
        (h_net n hn).1.parameterCount ≤ fullyConnectedReLUParameterCount 1 (2 * n - 1) 2 := by
      intro n hn
      unfold FullyConnectedReLUNet.parameterCount
      rw [(h_net n hn).2.1, (h_net n hn).2.2]
    -- @step s5: assemble witnesses W0 = 2, c₁ = 2, D = 2n-1 and the network from s1-s4
    have h_assemble : ∃ W0 : ℕ, 0 < W0 ∧ ∃ c₁ : ℝ, 0 < c₁ ∧
        ∀ n : ℕ, 0 < n → ∃ D : ℕ, 0 < D ∧ (D : ℝ) ≤ c₁ * (n : ℝ) ∧
          ∃ N : FullyConnectedReLUNet 1, N.depth = D ∧ N.width = W0 ∧
            N.parameterCount ≤ fullyConnectedReLUParameterCount 1 D W0 ∧
            ∀ x : Fin 1 → ℝ, N.realize x = squareReLUHingeInterpolant n (x 0) := by
      refine ⟨2, by norm_num, 2, by norm_num, ?_⟩
      intro n hn
      refine ⟨2 * n - 1, ?_, ?_, ?_⟩
      · omega
      · have hD : (2 * n - 1 : ℕ) ≤ 2 * n := by omega
        calc
          (↑(2 * n - 1) : ℝ) ≤ (↑(2 * n) : ℝ) := by exact_mod_cast hD
          _ = 2 * (n : ℝ) := by norm_num
      · refine ⟨(h_net n hn).1, ?_, ?_, ?_, ?_⟩
        · exact (h_net n hn).2.1
        · exact (h_net n hn).2.2
        · exact h_params n hn
        · exact h_realize n hn
    exact h_assemble
  -- @step s2: on [0,1] the hinge-comb Fₙ approximates the square: |Fₙ z - z²| ≤ 1/(4 n²)
  have h_s2 :
      ∀ n : ℕ, 0 < n → ∀ z : ℝ, 0 ≤ z → z ≤ 1 →
        |squareReLUHingeInterpolant n z - z ^ 2| ≤ 1 / (4 * (n : ℝ) ^ 2) := by
    intro n hn z hz0 hz1
    exact Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.squareReLUHingeInterpolant_error_le_of_mem_unitInterval hn hz0 hz1
  -- @step s3: an exact depth-D / width-W0 net with bounded parameter count realizes a class member
  have h_s3 :
      ∀ (D : ℕ), 0 < D → ∀ (W0 : ℕ) (N : FullyConnectedReLUNet 1),
        N.depth = D → N.width = W0 →
          N.parameterCount ≤ fullyConnectedReLUParameterCount 1 D W0 →
            N.realize ∈ reluNetworkClass 1 D W0 (fullyConnectedReLUParameterCount 1 D W0) := by
    intro D hD W0 N hdepth hwidth hparam
    rw [reluNetworkClass]
    change ∃ M : FullyConnectedReLUNet 1,
      0 < M.depth ∧ M.depth ≤ D ∧ M.width ≤ W0 ∧
        M.parameterCount ≤ fullyConnectedReLUParameterCount 1 D W0 ∧
          ∀ x : Fin 1 → ℝ, N.realize x = M.realize x
    refine ⟨N, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hdepth]
      exact hD
    · rw [hdepth]
    · rw [hwidth]
    · exact hparam
    · intro x
      rfl
  -- @step s4: assemble — cDepth := c₁, cErr := 1/4, P := fullyConnectedReLUParameterCount 1 D W0, g := N.realize
  have h_s4 :
      ∃ W0 : ℕ, 0 < W0 ∧
        ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
          ∀ n : ℕ, 0 < n →
            ∃ D P : ℕ,
              0 < D ∧ (D : ℝ) ≤ cDepth * (n : ℝ) ∧
                P = fullyConnectedReLUParameterCount 1 D W0 ∧
                ∃ g : (Fin 1 → ℝ) → ℝ,
                  g ∈ reluNetworkClass 1 D W0 P ∧
                    ∀ x : Fin 1 → ℝ,
                      x 0 ∈ Set.Icc (0 : ℝ) 1 →
                        |g x - (x 0) ^ 2| ≤ cErr * (n : ℝ).rpow (-2 : ℝ) := by
    rcases h_s1 with ⟨W0, hW0pos, c₁, hc₁pos, h_family⟩
    refine ⟨W0, hW0pos, c₁, 1 / 4, hc₁pos, ?_, ?_⟩
    · norm_num
    · intro n hn
      rcases h_family n hn with ⟨D, hDpos, hDbound, N, hdepth, hwidth, hparam, hrealize⟩
      refine ⟨D, fullyConnectedReLUParameterCount 1 D W0, hDpos, hDbound, rfl, N.realize, ?_, ?_⟩
      · exact h_s3 D hDpos W0 N hdepth hwidth hparam
      · intro x hx
        have hbnd := h_s2 n hn (x 0) hx.1 hx.2
        have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
        have hpow : (n : ℝ).rpow (-2 : ℝ) = 1 / (n : ℝ) ^ 2 := by
          simp [Real.rpow_neg (le_of_lt hnR), Real.rpow_natCast, one_div]
        rw [hrealize x]
        rw [hpow]
        convert hbnd using 1
        ring
  exact h_s4

theorem finite_linear_combination_reluNetworkClass_serial_fixed_width_approximation_bound
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {d D0 W0 P0 : ℕ}
    (hD0 : 0 < D0) (hW0 : 0 < W0)
    {domain : (Fin d → ℝ) → Prop}
    (coeff : ι → ℝ)
    (target approx : ι → (Fin d → ℝ) → ℝ)
    (eps : ι → ℝ)
    (heps : ∀ i : ι, 0 ≤ eps i)
    (hclass : ∀ i : ι, approx i ∈ reluNetworkClass d D0 W0 P0)
    (herr : ∀ i : ι, ∀ x : Fin d → ℝ, domain x → |approx i x - target i x| ≤ eps i) :
    ∃ cDepth : ℝ, 0 < cDepth ∧
      ∃ D P : ℕ,
        0 < D ∧
        (D : ℝ) ≤ cDepth * ((Fintype.card ι : ℝ) + 1) * ((D0 : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (2 * d + W0 + 3) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (2 * d + W0 + 3) P ∧
            ∀ x : Fin d → ℝ, domain x →
              |g x - (∑ i : ι, coeff i * target i x)| ≤ ∑ i : ι, |coeff i| * eps i := by
  -- @step s1: serial fixed-width combination lemma — exists N with depth/width/parameterCount
  -- bounds whose realize equals the finite linear combination of the approx networks.
  have h_comb : ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      N.width ≤ 2 * d + W0 + 3 ∧
      N.parameterCount ≤ fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) ∧
      ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x := by
    -- @step s1: for each index i, unfold hclass i via reluNetworkClass to obtain a witness network A i
    have h_witness : ∀ i : ι, ∃ A : FullyConnectedReLUNet d,
        0 < A.depth ∧ A.depth ≤ D0 ∧ A.width ≤ W0 ∧ A.parameterCount ≤ P0 ∧
            ∀ x : Fin d → ℝ, approx i x = A.realize x := by
          intro i
          simpa [reluNetworkClass] using hclass i
    -- @step s2: serial fixed-width combination lemma — combine per-index networks into one network
    have h_serial : ∀ (s : Finset ι) (B : ι → FullyConnectedReLUNet d),
        (∀ r ∈ s, (B r).depth ≤ D0) →
        (∀ r ∈ s, (B r).width ≤ W0) →
        ∃ N : FullyConnectedReLUNet d,
          N.depth = 2 + s.card * (D0 + 1) ∧
          N.width = 2 * d + W0 + 3 ∧
          N.parameterCount = fullyConnectedReLUParameterCount d N.depth N.width ∧
          ∀ x : Fin d → ℝ, N.realize x = finiteLinearCombination s coeff (fun r y => (B r).realize y) x := by
            intro s B hdepth hwidth
            let W : ℕ := 2 * d + W0 + 3
            let n : ℕ := s.card
            let e : s ≃ Fin n := Finset.equivFin s
            let xP : Fin d → Fin W := fun i => ⟨i.1, by omega⟩
            let xM : Fin d → Fin W := fun i => ⟨d + i.1, by omega⟩
            let c1 : Fin W := ⟨2 * d, by omega⟩
            let aP : Fin W := ⟨2 * d + 1, by omega⟩
            let aM : Fin W := ⟨2 * d + 2, by omega⟩
            let tS : Fin W0 → Fin W := fun j => ⟨2 * d + 3 + j.1, by omega⟩
            let idLayer : DenseLayer W W :=
              { weight := fun o i => if i = o then 1 else 0, bias := fun _ => 0 }
            let termInput (r : ι) : DenseLayer W W :=
              { weight := fun o i =>
                  if ho : o.1 < 2 * d + 3 then (if i = o then 1 else 0)
                  else if hb : o.1 - (2 * d + 3) < (B r).width then
                    let jT : Fin (B r).width := ⟨o.1 - (2 * d + 3), hb⟩
                    if hi : i.1 < d then (B r).input.weight jT ⟨i.1, hi⟩
                    else if hi2 : i.1 < 2 * d then - (B r).input.weight jT ⟨i.1 - d, by omega⟩
                    else 0
                  else 0
                bias := fun o =>
                  if ho : o.1 < 2 * d + 3 then 0
                  else if hb : o.1 - (2 * d + 3) < (B r).width then
                    (B r).input.bias ⟨o.1 - (2 * d + 3), hb⟩
                  else 0 }
            let embed (r : ι) (j : ℕ) (hj1 : j - 1 < (B r).depth - 1) : DenseLayer W W :=
              { weight := fun o i =>
                  if ho : o.1 < 2 * d + 3 then (if i = o then 1 else 0)
                  else if hb : o.1 - (2 * d + 3) < (B r).width then
                    let jE : Fin (B r).width := ⟨o.1 - (2 * d + 3), hb⟩
                    if hi : i.1 < 2 * d + 3 then 0
                    else if hb2 : i.1 - (2 * d + 3) < (B r).width then
                      let iE : Fin (B r).width := ⟨i.1 - (2 * d + 3), hb2⟩
                      ((B r).hidden ⟨j - 1, hj1⟩).weight jE iE
                    else 0
                  else 0
                bias := fun o =>
                  if ho : o.1 < 2 * d + 3 then 0
                  else if hb : o.1 - (2 * d + 3) < (B r).width then
                    ((B r).hidden ⟨j - 1, hj1⟩).bias ⟨o.1 - (2 * d + 3), hb⟩
                  else 0 }
            let update (r : ι) : DenseLayer W W :=
              { weight := fun o i =>
                  if ho : o.1 = 2 * d + 1 then
                    if i = aP then 1 else if i = aM then -1
                    else if hi : i.1 < 2 * d + 3 then 0
                    else if hb : i.1 - (2 * d + 3) < (B r).width then
                      (B r).outputWeight ⟨i.1 - (2 * d + 3), hb⟩ * coeff r
                    else 0
                  else if ho2 : o.1 = 2 * d + 2 then
                    if i = aP then -1 else if i = aM then 1
                    else if hi : i.1 < 2 * d + 3 then 0
                    else if hb : i.1 - (2 * d + 3) < (B r).width then
                      - ((B r).outputWeight ⟨i.1 - (2 * d + 3), hb⟩ * coeff r)
                    else 0
                  else if i = o then 1 else 0
                bias := fun o =>
                  if ho : o.1 = 2 * d + 1 then coeff r * (B r).outputBias
                  else if ho2 : o.1 = 2 * d + 2 then - (coeff r * (B r).outputBias)
                  else 0 }
            let blockLayer (r : ι) (j : ℕ) : DenseLayer W W :=
              if hj0 : j = 0 then termInput r
              else if hjl : j < (B r).depth then embed r j (by omega)
              else if hjd : j < D0 then idLayer
              else update r
            let inputLayer : DenseLayer d W :=
              { weight := fun o i =>
                  if ho : o.1 < d then (if i.1 = o.1 then 1 else 0)
                  else if ho2 : o.1 < 2 * d then (if i.1 = o.1 - d then -1 else 0)
                  else 0
                bias := fun o => if o = c1 then 1 else 0 }
            let N : FullyConnectedReLUNet d :=
              { depth := 2 + s.card * (D0 + 1)
                width := W
                input := inputLayer
                hidden := fun t =>
                  if ht : t.1 = s.card * (D0 + 1) then idLayer
                  else
                    let k : ℕ := t.1 / (D0 + 1)
                    let j : ℕ := t.1 % (D0 + 1)
                    have hk : k < s.card := by
                      have ht2 : t.1 < s.card * (D0 + 1) := by
                        have ht1 : t.1 ≤ s.card * (D0 + 1) := by omega
                        exact lt_of_le_of_ne ht1 ht
                      have hb : 0 < D0 + 1 := by omega
                      exact (Nat.div_lt_iff_lt_mul hb).2 ht2
                    blockLayer ((e.symm ⟨k, hk⟩).1) j
                outputWeight := fun o => if o = aP then 1 else if o = aM then -1 else 0
                outputBias := 0 }
            refine ⟨N, ?_, ?_, ?_, ?_⟩
            · rfl
            · rfl
            · rfl
            · intro x
              -- (1) every hidden state value is nonnegative (each layer applies ReLU)
              have h_nonneg : ∀ (t : ℕ) (q : Fin W), 0 ≤ N.hiddenState x t q := by
                intro t
                induction t with
                | zero =>
                    intro q
                    have h0 : N.hiddenState x 0 q = relu ((N.input.apply x) q) := by
                      dsimp [N]
                      simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec]
                    rw [h0]
                    exact le_max_right _ _
                | succ t ih =>
                    intro q
                    by_cases ht : t < N.depth - 1
                    · have h1 : N.hiddenState x (t + 1) q =
                        relu (((N.hidden ⟨t, ht⟩).apply (N.hiddenState x t)) q) := by
                        simp [FullyConnectedReLUNet.hiddenState, ht, DenseLayer.reluApply, reluVec]
                      rw [h1]
                      exact le_max_right _ _
                    · have h1 : N.hiddenState x (t + 1) q = N.hiddenState x t q := by
                        simp [FullyConnectedReLUNet.hiddenState, ht]
                      rw [h1]
                      exact ih q
              -- (2) max z 0 - max (-z) 0 = z
              have h_relu_sub : ∀ z : ℝ, max z 0 - max (-z) 0 = z := by
                intro z
                by_cases hz : 0 ≤ z
                · rw [max_eq_left hz, max_eq_right (neg_nonpos.mpr hz)]
                  ring
                · have hz' : z ≤ 0 := le_of_not_ge hz
                  rw [max_eq_right hz', max_eq_left (neg_nonneg.mpr hz')]
                  ring
              -- (3) identity-row layers preserve the persistent coordinates
              have h_ident_aux : ∀ (L : DenseLayer W W) (q : Fin W),
                  (∀ i : Fin W, L.weight q i = if i = q then 1 else 0) → L.bias q = 0 →
                  ∀ S : Fin W → ℝ, L.apply S q = S q := by
                intro L q hw hb S
                unfold DenseLayer.apply
                rw [hb]
                have hsum : (∑ i : Fin W, L.weight q i * S i) = S q := by
                  calc
                    (∑ i : Fin W, L.weight q i * S i) = L.weight q q * S q := by
                      apply Finset.sum_eq_single q
                      · intro i hi hneq
                        rw [hw i]
                        simp [hneq]
                      · simp
                    _ = S q := by
                      rw [hw q]
                      simp
                rw [hsum]
                simp
              have h_ident_idLayer : ∀ (q : Fin W) (S : Fin W → ℝ), (idLayer.apply S) q = S q := by
                intro q S
                apply h_ident_aux idLayer q
                · intro i
                  simp [idLayer]
                · simp [idLayer]
              have h_ident_termInput : ∀ (r : ι) (q : Fin W), q.1 ≤ 2 * d →
                  ∀ S : Fin W → ℝ, (termInput r).apply S q = S q := by
                intro r q hq S
                apply h_ident_aux (termInput r) q
                · intro i
                  have hq' : q.1 < 2 * d + 3 := by omega
                  simp [termInput, hq']
                · have hq' : q.1 < 2 * d + 3 := by omega
                  simp [termInput, hq']
              have h_ident_embed : ∀ (r : ι) (j : ℕ) (hj1 : j - 1 < (B r).depth - 1) (q : Fin W), q.1 ≤ 2 * d →
                  ∀ S : Fin W → ℝ, (embed r j hj1).apply S q = S q := by
                intro r j hj1 q hq S
                apply h_ident_aux (embed r j hj1) q
                · intro i
                  have hq' : q.1 < 2 * d + 3 := by omega
                  simp [embed, hq']
                · have hq' : q.1 < 2 * d + 3 := by omega
                  simp [embed, hq']
              have h_ident_update : ∀ (r : ι) (q : Fin W), q.1 ≤ 2 * d →
                  ∀ S : Fin W → ℝ, (update r).apply S q = S q := by
                intro r q hq S
                apply h_ident_aux (update r) q
                · intro i
                  have hq1 : q.1 ≠ 2 * d + 1 := by omega
                  have hq2 : q.1 ≠ 2 * d + 2 := by omega
                  simp [update, hq1, hq2]
                · have hq1 : q.1 ≠ 2 * d + 1 := by omega
                  have hq2 : q.1 ≠ 2 * d + 2 := by omega
                  simp [update, hq1, hq2]
              -- (4) every layer of N has identity rows on the persistent coordinates
              have h_layer_persist : ∀ (t : ℕ) (ht : t < N.depth - 1) (q : Fin W), q.1 ≤ 2 * d →
                  (N.hidden ⟨t, ht⟩).apply (N.hiddenState x t) q = N.hiddenState x t q := by
                intro t ht q hq
                have hident : ∀ (r : ι) (j : ℕ), (blockLayer r j).apply (N.hiddenState x t) q = N.hiddenState x t q := by
                  intro r j
                  by_cases hj0 : j = 0
                  · have hb : blockLayer r j = termInput r := by simp [blockLayer, hj0]
                    rw [hb]
                    exact h_ident_termInput r q hq (N.hiddenState x t)
                  · by_cases hjl : j < (B r).depth
                    · have hb : blockLayer r j = embed r j (by omega) := by simp [blockLayer, hj0, hjl]
                      rw [hb]
                      exact h_ident_embed r j (by omega) q hq (N.hiddenState x t)
                    · by_cases hjd : j < D0
                      · have hb : blockLayer r j = idLayer := by simp [blockLayer, hj0, hjl, hjd]
                        rw [hb]
                        exact h_ident_idLayer q (N.hiddenState x t)
                      · have hb : blockLayer r j = update r := by simp [blockLayer, hj0, hjl, hjd]
                        rw [hb]
                        exact h_ident_update r q hq (N.hiddenState x t)
                by_cases hmain : t = n * (D0 + 1)
                · subst hmain
                  have hL : N.hidden ⟨n * (D0 + 1), ht⟩ = idLayer := by
                    dsimp [N, n]
                    simp
                  rw [hL]
                  exact h_ident_idLayer q (N.hiddenState x (n * (D0 + 1)))
                · have hne1 : t ≠ s.card * (D0 + 1) := by
                    intro h
                    apply hmain
                    simpa [n] using h
                  have ht2 : t < s.card * (D0 + 1) := by
                    have hd : N.depth - 1 = s.card * (D0 + 1) + 1 := by
                      dsimp [N, n]
                      omega
                    have hle : t ≤ s.card * (D0 + 1) := by omega
                    exact lt_of_le_of_ne hle hne1
                  have hk2 : t / (D0 + 1) < s.card := by
                    have hb : 0 < D0 + 1 := by omega
                    exact (Nat.div_lt_iff_lt_mul hb).2 ht2
                  have hL : N.hidden ⟨t, ht⟩ =
                      blockLayer ((e.symm ⟨t / (D0 + 1), hk2⟩).1) (t % (D0 + 1)) := by
                    dsimp [N]
                    simp [hne1]
                  rw [hL]
                  exact hident ((e.symm ⟨t / (D0 + 1), hk2⟩).1) (t % (D0 + 1))
              -- (5) the input layer feeds x⁺/x⁻ and these persist through all layers
              have h_xP_val : ∀ i : Fin d, (xP i).1 ≤ 2 * d := by
                intro i
                have hi_lt : (xP i).1 < d := by simpa [xP] using i.2
                omega
              have h_xM_val : ∀ i : Fin d, (xM i).1 ≤ 2 * d := by
                intro i
                have hi_lt : i.1 < d := i.2
                dsimp [xM]
                omega
              have h_xP : ∀ t : ℕ, ∀ i : Fin d, N.hiddenState x t (xP i) = max (x i) 0 := by
                intro t
                induction t with
                | zero =>
                    intro i
                    have hbias : inputLayer.bias (xP i) = 0 := by
                      have hne : xP i ≠ c1 := by
                        intro h
                        have : (xP i).1 = c1.1 := congrArg Fin.val h
                        simp [xP, c1] at this
                        omega
                      simp [inputLayer, hne]
                    have hweight : ∀ j : Fin d, inputLayer.weight (xP i) j = if j.1 = i.1 then 1 else 0 := by
                      intro j
                      have hi' : (xP i).1 < d := by simpa [xP] using i.2
                      simp [inputLayer, xP, hi']
                    have hsum : (∑ j : Fin d, inputLayer.weight (xP i) j * x j) = x i := by
                      calc
                        (∑ j : Fin d, inputLayer.weight (xP i) j * x j)
                            = (∑ j : Fin d, (if j.1 = i.1 then 1 else 0) * x j) := by
                              apply Finset.sum_congr rfl
                              intro j hj
                              rw [hweight j]
                        _ = x i := by
                              simpa using (Finset.sum_eq_single (s := Finset.univ) (a := i)
                                (f := fun j => (if j.1 = i.1 then 1 else 0) * x j)
                                (by
                                  intro b hb hbne
                                  have : b.1 ≠ i.1 := by
                                    intro h
                                    exact hbne (Fin.ext h)
                                  simp [this])
                                (by simp))
                    have happly : inputLayer.apply x (xP i) = x i := by
                      unfold DenseLayer.apply
                      simp [hsum, hbias]
                    have h0 : N.hiddenState x 0 (xP i) = relu (x i) := by
                      dsimp [N]
                      simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, happly]
                    rw [h0]
                    rfl
                | succ t ih =>
                    intro i
                    by_cases ht : t < N.depth - 1
                    · have h1 : N.hiddenState x (t + 1) (xP i) =
                        relu ((N.hidden ⟨t, ht⟩).apply (N.hiddenState x t) (xP i)) := by
                        simp [FullyConnectedReLUNet.hiddenState, ht, DenseLayer.reluApply, reluVec]
                      rw [h1]
                      have hp : (N.hidden ⟨t, ht⟩).apply (N.hiddenState x t) (xP i) = N.hiddenState x t (xP i) :=
                        h_layer_persist t ht (xP i) (h_xP_val i)
                      rw [hp, ih i]
                      exact max_eq_left (le_max_right _ _)
                    · have h1 : N.hiddenState x (t + 1) (xP i) = N.hiddenState x t (xP i) := by
                        simp [FullyConnectedReLUNet.hiddenState, ht]
                      rw [h1, ih i]
              have h_xM : ∀ t : ℕ, ∀ i : Fin d, N.hiddenState x t (xM i) = max (-(x i)) 0 := by
                intro t
                induction t with
                | zero =>
                    intro i
                    have hbias : inputLayer.bias (xM i) = 0 := by
                      have hne : xM i ≠ c1 := by
                        intro h
                        have : (xM i).1 = c1.1 := congrArg Fin.val h
                        simp [xM, c1] at this
                        omega
                      simp [inputLayer, hne]
                    have hi_lt : i.1 < d := i.2
                    have hweight : ∀ j : Fin d, inputLayer.weight (xM i) j = if j.1 = i.1 then -1 else 0 := by
                      intro j
                      have hi1 : ¬ (xM i).1 < d := by
                        dsimp [xM]
                        omega
                      have hi2 : (xM i).1 < 2 * d := by
                        dsimp [xM]
                        omega
                      simp [inputLayer, xM, hi1, hi2]
                    have hsum : (∑ j : Fin d, inputLayer.weight (xM i) j * x j) = -(x i) := by
                      calc
                        (∑ j : Fin d, inputLayer.weight (xM i) j * x j)
                            = (∑ j : Fin d, (if j.1 = i.1 then -1 else 0) * x j) := by
                              apply Finset.sum_congr rfl
                              intro j hj
                              rw [hweight j]
                        _ = -(x i) := by
                              simpa using (Finset.sum_eq_single (s := Finset.univ) (a := i)
                                (f := fun j => (if j.1 = i.1 then -1 else 0) * x j)
                                (by
                                  intro b hb hbne
                                  have : b.1 ≠ i.1 := by
                                    intro h
                                    exact hbne (Fin.ext h)
                                  simp [this])
                                (by simp))
                    have happly : inputLayer.apply x (xM i) = -(x i) := by
                      unfold DenseLayer.apply
                      simp [hsum, hbias]
                    have h0 : N.hiddenState x 0 (xM i) = relu (-(x i)) := by
                      dsimp [N]
                      simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, happly]
                    rw [h0]
                    rfl
                | succ t ih =>
                    intro i
                    by_cases ht : t < N.depth - 1
                    · have h1 : N.hiddenState x (t + 1) (xM i) =
                        relu ((N.hidden ⟨t, ht⟩).apply (N.hiddenState x t) (xM i)) := by
                        simp [FullyConnectedReLUNet.hiddenState, ht, DenseLayer.reluApply, reluVec]
                      rw [h1]
                      have hp : (N.hidden ⟨t, ht⟩).apply (N.hiddenState x t) (xM i) = N.hiddenState x t (xM i) :=
                        h_layer_persist t ht (xM i) (h_xM_val i)
                      rw [hp, ih i]
                      exact max_eq_left (le_max_right _ _)
                    · have h1 : N.hiddenState x (t + 1) (xM i) = N.hiddenState x t (xM i) := by
                        simp [FullyConnectedReLUNet.hiddenState, ht]
                      rw [h1, ih i]
              -- (6) the final hidden layer is the identity on the (nonnegative) state
              have hid : ∀ (S : Fin W → ℝ), (∀ q : Fin W, 0 ≤ S q) → ∀ q : Fin W,
                  (idLayer.reluApply S) q = S q := by
                intro S hS q
                unfold DenseLayer.reluApply reluVec relu
                have hb : (idLayer.apply S) q = S q := h_ident_idLayer q S
                rw [hb]
                exact max_eq_left (hS q)
              have h_id_final : ∀ q : Fin W,
                  N.hiddenState x (N.depth - 1) q = N.hiddenState x (n * (D0 + 1)) q := by
                intro q
                have hd : N.depth - 1 = n * (D0 + 1) + 1 := by
                  dsimp [N, n]
                  omega
                rw [hd]
                have ht : n * (D0 + 1) < N.depth - 1 := by
                  rw [hd]
                  omega
                have hlayer : N.hidden ⟨n * (D0 + 1), ht⟩ = idLayer := by
                  dsimp [N, n]
                  simp
                have hstep : N.hiddenState x (n * (D0 + 1) + 1) q =
                    (idLayer.reluApply (N.hiddenState x (n * (D0 + 1)))) q := by
                  simp [FullyConnectedReLUNet.hiddenState, ht, hlayer]
                rw [hstep]
                exact hid (N.hiddenState x (n * (D0 + 1))) (h_nonneg (n * (D0 + 1))) q
              -- (7) the readout is the accumulator difference at the end of all blocks
              have h_realize : N.realize x =
                  N.hiddenState x (n * (D0 + 1)) aP - N.hiddenState x (n * (D0 + 1)) aM := by
                let S : Fin W → ℝ := N.hiddenState x (n * (D0 + 1))
                unfold FullyConnectedReLUNet.realize
                change (∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (N.depth - 1) j) + N.outputBias = S aP - S aM
                have hb0 : N.outputBias = 0 := rfl
                rw [hb0]
                simp
                have hswap : (∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (N.depth - 1) j) =
                    (∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (n * (D0 + 1)) j) := by
                  apply Finset.sum_congr rfl
                  intro j hj
                  rw [h_id_final j]
                rw [hswap]
                change (∑ j : Fin W, N.outputWeight j * S j) = S aP - S aM
                have hpt : ∀ j : Fin W, N.outputWeight j * S j =
                    (if j = aP then S aP else 0) + (if j = aM then -S aM else 0) := by
                  intro j
                  by_cases h1 : j = aP
                  · subst h1
                    have ha : aP ≠ aM := by
                      intro h
                      have : (2 * d + 1) = (2 * d + 2) := by
                        simpa [aP, aM] using congrArg Fin.val h
                      omega
                    dsimp [N]
                    simp [ha]
                  · by_cases h2 : j = aM
                    · subst h2
                      dsimp [N]
                      simp [h1]
                    · dsimp [N]
                      simp [h1, h2]
                have hsum1 : (∑ j : Fin W, if j = aP then S aP else 0) = S aP := by
                  simpa using (Finset.sum_eq_single (s := Finset.univ) (a := aP)
                    (f := fun j => if j = aP then S aP else 0)
                    (by intro b hb hbne; simp [hbne])
                    (by simp))
                have hsum2 : (∑ j : Fin W, if j = aM then -S aM else 0) = -S aM := by
                  simpa using (Finset.sum_eq_single (s := Finset.univ) (a := aM)
                    (f := fun j => if j = aM then -S aM else 0)
                    (by intro b hb hbne; simp [hbne])
                    (by simp))
                have hpt' : (∑ j : Fin W, N.outputWeight j * S j) =
                    (∑ j : Fin W, ((if j = aP then S aP else 0) + (if j = aM then -S aM else 0))) := by
                  apply Finset.sum_congr rfl
                  intro j hj
                  exact hpt j
                rw [hpt']
                rw [Finset.sum_add_distrib]
                rw [hsum1, hsum2]
                rw [sub_eq_add_neg]
              -- (8) the accumulator invariant: after the first k blocks the accumulator
              -- pair encodes the sum over the first k enumerated elements
              have h_in0 : N.hiddenState x 0 aP = 0 := by
                have happly : (inputLayer.apply x) aP = 0 := by
                  unfold DenseLayer.apply
                  have hb : inputLayer.bias aP = 0 := by
                    have hne : aP ≠ c1 := by
                      intro h
                      have : (2 * d + 1) = 2 * d := by
                        simpa [aP, c1] using congrArg Fin.val h
                      omega
                    simp [inputLayer, hne]
                  have hw : ∀ i : Fin d, inputLayer.weight aP i = 0 := by
                    intro i
                    have h1 : ¬ aP.1 < d := by dsimp [aP]; omega
                    have h2 : ¬ aP.1 < 2 * d := by dsimp [aP]; omega
                    simp [inputLayer, h1, h2]
                  have hsum : (∑ i : Fin d, inputLayer.weight aP i * x i) = 0 := by
                    simp [hw]
                  simp [hsum, hb]
                dsimp [N]
                simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, relu, happly]
              have h_inM0 : N.hiddenState x 0 aM = 0 := by
                have happly : (inputLayer.apply x) aM = 0 := by
                  unfold DenseLayer.apply
                  have hb : inputLayer.bias aM = 0 := by
                    have hne : aM ≠ c1 := by
                      intro h
                      have : (2 * d + 2) = 2 * d := by
                        simpa [aM, c1] using congrArg Fin.val h
                      omega
                    simp [inputLayer, hne]
                  have hw : ∀ i : Fin d, inputLayer.weight aM i = 0 := by
                    intro i
                    have h1 : ¬ aM.1 < d := by dsimp [aM]; omega
                    have h2 : ¬ aM.1 < 2 * d := by dsimp [aM]; omega
                    simp [inputLayer, h1, h2]
                  have hsum : (∑ i : Fin d, inputLayer.weight aM i * x i) = 0 := by
                    simp [hw]
                  simp [hsum, hb]
                dsimp [N]
                simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, reluVec, relu, happly]
              have h_acc : ∀ (k : ℕ) (hk : k ≤ n),
                  N.hiddenState x (k * (D0 + 1)) aP - N.hiddenState x (k * (D0 + 1)) aM =
                  ∑ j : Fin k, coeff (e.symm (Fin.castLE hk j)).1 * (B (e.symm (Fin.castLE hk j)).1).realize x := by
                intro k
                induction k with
                | zero =>
                    intro hk
                    have hsum0 : (∑ j : Fin 0, coeff (e.symm (Fin.castLE hk j)).1 * (B (e.symm (Fin.castLE hk j)).1).realize x) = 0 := by
                      apply Finset.sum_eq_zero
                      rintro ⟨jv, jp⟩ hj
                      omega
                    simp [h_in0, h_inM0, hsum0]
                | succ k ih =>
                    intro hk
                    have hk' : k ≤ n := by omega
                    have hik := ih hk'
                    have hklt : k < n := by omega
                    let r : ι := (e.symm ⟨k, hklt⟩).1
                    have hr : r ∈ s := (e.symm ⟨k, hklt⟩).2
                    have hdepth_r : (B r).depth ≤ D0 := hdepth r hr
                    have hwidth_r : (B r).width ≤ W0 := hwidth r hr
                    have hD0ne : D0 ≠ 0 := by omega
                    have hNcard : n = s.card := by rfl
                    have hNdepth : N.depth = 2 + n * (D0 + 1) := by rfl
                    have hk1 : k + 1 ≤ n := by omega
                    have hkeq : (k + 1) * (D0 + 1) = k * (D0 + 1) + (D0 + 1) := by ring
                    have hkmul : (k + 1) * (D0 + 1) ≤ n * (D0 + 1) := by
                      exact Nat.mul_le_mul_right (D0 + 1) hk1
                    have haP_val : aP.1 = 2 * d + 1 := by rfl
                    have haM_val : aM.1 = 2 * d + 2 := by rfl
                    have hblock : ∀ (j : ℕ) (hj : j ≤ D0),
                        N.hidden ⟨k * (D0 + 1) + j, by omega⟩ = blockLayer r j := by
                      intro j hj
                      have ht_ne : k * (D0 + 1) + j ≠ n * (D0 + 1) := by omega
                      have hdiv0 : j / (D0 + 1) = 0 := by
                        rw [Nat.div_eq_of_lt]
                        omega
                      have hdiv : (k * (D0 + 1) + j) / (D0 + 1) = k := by
                        calc
                          (k * (D0 + 1) + j) / (D0 + 1) = (j + k * (D0 + 1)) / (D0 + 1) := by rw [add_comm]
                          _ = j / (D0 + 1) + k := by rw [Nat.add_mul_div_right j k (by omega : 0 < D0 + 1)]
                          _ = k := by rw [hdiv0, zero_add]
                      have hmod0 : j % (D0 + 1) = j := by
                        rw [Nat.mod_eq_of_lt]
                        omega
                      have hmod : (k * (D0 + 1) + j) % (D0 + 1) = j := by
                        calc
                          (k * (D0 + 1) + j) % (D0 + 1) = (j + k * (D0 + 1)) % (D0 + 1) := by rw [add_comm]
                          _ = (j + (D0 + 1) * k) % (D0 + 1) := by rw [Nat.mul_comm]
                          _ = j % (D0 + 1) := by rw [Nat.add_mul_mod_self_left]
                          _ = j := hmod0
                      dsimp [N]
                      rw [dif_neg ht_ne]
                      congr 1
                      · have hfin : e.symm ⟨(k * (D0 + 1) + j) / (D0 + 1), by rw [hdiv]; exact hklt⟩ = e.symm ⟨k, hklt⟩ := by
                          congr 1
                          apply Fin.ext
                          exact hdiv
                        exact congrArg (fun q : s => q.1) hfin

                    have hident_block : ∀ (j : ℕ) (hj : j < D0) (S : Fin W → ℝ),
                        (blockLayer r j).apply S aP = S aP ∧ (blockLayer r j).apply S aM = S aM := by
                      intro j hj S
                      by_cases hj0 : j = 0
                      · have hltP : aP.1 < 2 * d + 3 := by omega
                        have hltM : aM.1 < 2 * d + 3 := by omega
                        have hwP : ∀ i : Fin W, (termInput r).weight aP i = if i = aP then 1 else 0 := by
                          intro i
                          simp [termInput, hltP]
                        have hbP : (termInput r).bias aP = 0 := by
                          simp [termInput, hltP]
                        have hwM : ∀ i : Fin W, (termInput r).weight aM i = if i = aM then 1 else 0 := by
                          intro i
                          simp [termInput, hltM]
                        have hbM : (termInput r).bias aM = 0 := by
                          simp [termInput, hltM]
                        have hP := h_ident_aux (termInput r) aP hwP hbP S
                        have hM := h_ident_aux (termInput r) aM hwM hbM S
                        simp [blockLayer, hj0]
                        exact ⟨hP, hM⟩
                      · by_cases hjemb : j < (B r).depth
                        · have hj1 : j - 1 < (B r).depth - 1 := by omega
                          have hltP : aP.1 < 2 * d + 3 := by omega
                          have hltM : aM.1 < 2 * d + 3 := by omega
                          have hwP : ∀ i : Fin W, (embed r j hj1).weight aP i = if i = aP then 1 else 0 := by
                            intro i
                            simp [embed, hltP]
                          have hbP : (embed r j hj1).bias aP = 0 := by
                            simp [embed, hltP]
                          have hwM : ∀ i : Fin W, (embed r j hj1).weight aM i = if i = aM then 1 else 0 := by
                            intro i
                            simp [embed, hltM]
                          have hbM : (embed r j hj1).bias aM = 0 := by
                            simp [embed, hltM]
                          have hP := h_ident_aux (embed r j hj1) aP hwP hbP S
                          have hM := h_ident_aux (embed r j hj1) aM hwM hbM S
                          simp [blockLayer, hj0, hjemb]
                          exact ⟨hP, hM⟩
                        · have hwP : ∀ i : Fin W, idLayer.weight aP i = if i = aP then 1 else 0 := by
                            intro i
                            simp [idLayer]
                          have hbP : idLayer.bias aP = 0 := by
                            simp [idLayer]
                          have hwM : ∀ i : Fin W, idLayer.weight aM i = if i = aM then 1 else 0 := by
                            intro i
                            simp [idLayer]
                          have hbM : idLayer.bias aM = 0 := by
                            simp [idLayer]
                          have hP := h_ident_aux idLayer aP hwP hbP S
                          have hM := h_ident_aux idLayer aM hwM hbM S
                          simp [blockLayer, hj0, hjemb, hj]
                          exact ⟨hP, hM⟩
                    have hpersist : ∀ (j : ℕ) (hj : j < D0),
                        N.hiddenState x (k * (D0 + 1) + j + 1) aP = N.hiddenState x (k * (D0 + 1) + j) aP ∧
                        N.hiddenState x (k * (D0 + 1) + j + 1) aM = N.hiddenState x (k * (D0 + 1) + j) aM := by
                      intro j hj
                      have hrec : k * (D0 + 1) + j < N.depth - 1 := by omega
