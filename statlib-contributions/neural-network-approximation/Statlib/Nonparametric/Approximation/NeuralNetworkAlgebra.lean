                                                                        (D : ℝ) ≤ (((2 * 1 : ℕ) : ℝ) + ((1 - 1 : ℕ) : ℝ) * cMulDepth * (n : ℝ)) ∧
                                                                        P = fullyConnectedReLUParameterCount d D (2 + (1 - 1) * (Wmul + 2)) ∧
                                                                        ∃ g : (Fin d → ℝ) → ℝ,
                                                                          g ∈ reluNetworkClass d D (2 + (1 - 1) * (Wmul + 2)) P ∧
                                                                          ∀ x : Fin d → ℝ,
                                                                            |g x - (∏ q : {q : Fin d // (q : ℕ) < 1}, coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x)| ≤
                                                                              K * (n : ℝ).rpow (-2 : ℝ) := by
                                                                                intro hd
                                                                                have hd_pos : 0 < d := by omega
                                                                                let q0 : Fin d := ⟨0, hd_pos⟩
                                                                                refine ⟨2, by norm_num, ?_⟩
                                                                                intro n hn center scale hscale
                                                                                let g : (Fin d → ℝ) → ℝ := fun x => coordinateTentReLUFunction q0 (center q0) (scale q0) x
                                                                                refine ⟨2, fullyConnectedReLUParameterCount d 2 2, by norm_num, ?_, ?_, ⟨g, ?_, ?_⟩⟩
                                                                                · have hzero : ((1 - 1 : ℕ) : ℝ) * cMulDepth * (n : ℝ) = 0 := by simp
                                                                                  rw [hzero]
                                                                                  norm_num
                                                                                · simp
                                                                                · have hg_mem : g ∈ reluNetworkClass d 2 2 (fullyConnectedReLUParameterCount d 2 2) := by
                                                                                    dsimp [g]
                                                                                    exact Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.coordinateTentReLUFunction_mem_reluNetworkClass_with_parameter_bound
                                                                                      (d := d) (depthBudget := 2) (widthBudget := 2)
                                                                                      (parameterBudget := fullyConnectedReLUParameterCount d 2 2)
                                                                                      q0 (center q0) (scale q0) (by norm_num) (by norm_num) (by rfl)
                                                                                  simpa using hg_mem
                                                                                · intro x
                                                                                  let a : {q : Fin d // (q : ℕ) < 1} := ⟨q0, by simp [q0]⟩
                                                                                  have hsub_single : ∀ b : {q : Fin d // (q : ℕ) < 1}, b = a := by
                                                                                    intro b
                                                                                    apply Subtype.ext
                                                                                    simp [a]
                                                                                    apply Fin.ext
                                                                                    simp [q0]
                                                                                    have hb : (b.1 : ℕ) < 1 := b.2
                                                                                    omega
                                                                                  have hprod : (∏ q : {q : Fin d // (q : ℕ) < 1}, coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x) = g x := by
                                                                                    calc
                                                                                      (∏ q : {q : Fin d // (q : ℕ) < 1}, coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x)
                                                                                          = coordinateTentReLUFunction a.1 (center a.1) (scale a.1) x := by
                                                                                            exact Fintype.prod_eq_single
                                                                                              (f := fun q => coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x) a
                                                                                              (fun b hb => False.elim (hb (hsub_single b)))
                                                                                      _ = coordinateTentReLUFunction q0 (center q0) (scale q0) x := by
                                                                                            simp [a]
                                                                                  rw [hprod]
                                                                                  have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
                                                                                  have hnpow : 0 < (n : ℝ).rpow (-2 : ℝ) := Real.rpow_pos_of_pos hnR (-2 : ℝ)
                                                                                  have hzero_abs : |g x - g x| = (0 : ℝ) := by simp
                                                                                  rw [hzero_abs]
                                                                                  have h2nonneg : (0 : ℝ) ≤ 2 := by norm_num
                                                                                  exact mul_nonneg h2nonneg (le_of_lt hnpow)
                                                              -- @step s2: assemble the combined induction: k = 1 via h_base (K := 2); successor k → k+1 via h_step_comb with K ↦ cMulErr*(1+K)^2 + (1+K)*K; widths 2+(k-1)*(Wmul+2) and depths 2k+(k-1)*cMulDepth*n telescope; exact h_ind closes h_comb
                                                              have h_ind :
                                                                  ∀ k : ℕ, 1 ≤ k → k ≤ d →
                                                                    ∃ K : ℝ, 0 < K ∧
                                                                      ∀ n : ℕ, 0 < n → ∀ center scale : Fin d → ℝ, (∀ q : Fin d, 0 ≤ scale q) →
                                                                        ∃ D P : ℕ,
                                                                          0 < D ∧
                                                                          (D : ℝ) ≤ (((2 * k : ℕ) : ℝ) + ((k - 1 : ℕ) : ℝ) * cMulDepth * (n : ℝ)) ∧
                                                                          P = fullyConnectedReLUParameterCount d D (2 + (k - 1) * (Wmul + 2)) ∧
                                                                          ∃ g : (Fin d → ℝ) → ℝ,
                                                                            g ∈ reluNetworkClass d D (2 + (k - 1) * (Wmul + 2)) P ∧
                                                                            ∀ x : Fin d → ℝ,
                                                                              |g x - (∏ q : {q : Fin d // (q : ℕ) < k}, coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x)| ≤
                                                                                K * (n : ℝ).rpow (-2 : ℝ) := by
                                                                                  intro k
                                                                                  induction k with
                                                                                  | zero =>
                                                                                      intro hk1 hkd
                                                                                      exfalso
                                                                                      omega
                                                                                  | succ m ih =>
                                                                                      intro hk1 hkd
                                                                                      by_cases hm0 : m = 0
                                                                                      · subst m
                                                                                        simpa using (h_base hkd)
                                                                                      · have hm1 : 1 ≤ m := by omega
                                                                                        have hmd : m ≤ d := by omega
                                                                                        have hmlt : m < d := by omega
                                                                                        rcases ih hm1 hmd with ⟨K, hKpos, hQm⟩
                                                                                        let K' : ℝ := cMulErr * (1 + K) ^ 2 + (1 + K) * K
                                                                                        have hK'pos : 0 < K' := by
                                                                                          dsimp [K']
                                                                                          have h1pK : 0 < 1 + K := by linarith
                                                                                          have hsq : 0 < (1 + K) ^ 2 := sq_pos_of_pos h1pK
                                                                                          have ht1 : 0 < cMulErr * (1 + K) ^ 2 := mul_pos hcMulErr hsq
                                                                                          have ht2 : 0 < (1 + K) * K := mul_pos h1pK hKpos
                                                                                          linarith
                                                                                        refine ⟨K', hK'pos, ?_⟩
                                                                                        intro n hn center scale hscale
                                                                                        simpa [K'] using
                                                                                          (h_step_comb K (le_of_lt hKpos) m hm1 hmlt hQm n hn center scale hscale)
                                                              exact h_ind
                                          -- @step s4: finish: specialize h_comb at k = d (using 0 < d), telescope width to Wtent, set cErr := K_d and cDepth := 2 + cMulDepth, verify final bounds
                                          have h_finish : 0 < d →
                                              ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
                                                ∀ n : ℕ, 0 < n → ∀ center scale : Fin d → ℝ, (∀ q : Fin d, 0 ≤ scale q) →
                                                  ∃ D P : ℕ,
                                                    0 < D ∧
                                                    (D : ℝ) ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) ∧
                                                    P = fullyConnectedReLUParameterCount d D Wtent ∧
                                                    ∃ g : (Fin d → ℝ) → ℝ,
                                                      g ∈ reluNetworkClass d D Wtent P ∧
                                                      ∀ x : Fin d → ℝ,
                                                        |g x - (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale q) x)| ≤
                                                          cErr * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) := by
                                                            intro hd
                                                            have hd1 : 1 ≤ d := Nat.succ_le_of_lt hd
                                                            have hd1ℝ : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd1
                                                            rcases h_comb d hd1 le_rfl with ⟨Kd, hKd_pos, hKd⟩
                                                            refine ⟨2 + cMulDepth, Kd, ?_, hKd_pos, ?_⟩
                                                            · linarith
                                                            · intro n hn center scale hscale
                                                              rcases hKd n hn center scale hscale with ⟨D, P, hD_pos, hD_depth, hP, g, hg_mem, hg_err⟩
                                                              refine ⟨D, P, hD_pos, ?_, ?_, g, ?_, ?_⟩
                                                              · have hn1ℝ : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (Nat.succ_le_of_lt hn)
                                                                have hcD_nonneg : 0 ≤ cMulDepth := le_of_lt hcMulDepth
                                                                have hineq : (2 : ℝ) * (d : ℝ) + ((d : ℝ) - 1) * cMulDepth * (n : ℝ)
                                                                    ≤ (2 + cMulDepth) * ((d : ℝ) + 1) * ((n : ℝ) + 1) := by
                                                                      nlinarith
                                                                have hD_depth' : (D : ℝ) ≤ (2 : ℝ) * (d : ℝ) + ((d : ℝ) - 1) * cMulDepth * (n : ℝ) := by
                                                                    have hc : (((2 * d : ℕ) : ℝ) + ((d - 1 : ℕ) : ℝ) * cMulDepth * (n : ℝ))
                                                                        = (2 : ℝ) * (d : ℝ) + ((d : ℝ) - 1) * cMulDepth * (n : ℝ) := by
                                                                          rw [Nat.cast_mul, Nat.cast_sub hd1]
                                                                          norm_num
                                                                    rw [← hc]
                                                                    exact hD_depth
                                                                exact le_trans hD_depth' hineq
                                                              · exact hP
                                                              · exact hg_mem
                                                              · intro x
                                                                have hmem : ∀ q : Fin d, q ∈ (Finset.univ : Finset (Fin d)) ↔ (q : ℕ) < d := by
                                                                  intro q
                                                                  constructor
                                                                  · intro _; exact q.isLt
                                                                  · intro _; simp
                                                                have hprod_eq : (∏ q : Fin d, coordinateTentReLUFunction q (center q) (scale q) x)
                                                                    = (∏ q : {q : Fin d // (q : ℕ) < d}, coordinateTentReLUFunction q.1 (center q.1) (scale q.1) x) := by
                                                                      symm
                                                                      rw [← Finset.prod_subtype (s := (Finset.univ : Finset (Fin d))) (p := fun q : Fin d => (q : ℕ) < d) hmem (fun q : Fin d => coordinateTentReLUFunction q (center q) (scale q) x)]
                                                                rw [hprod_eq]
                                                                have hKd_nonneg : 0 ≤ Kd := le_of_lt hKd_pos
                                                                have hd1p : (1 : ℝ) ≤ (d : ℝ) + 1 := by linarith
                                                                have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
                                                                have hnpow : 0 ≤ (n : ℝ).rpow (-2 : ℝ) :=
                                                                  le_of_lt (Real.rpow_pos_of_pos hnR (-2 : ℝ))
                                                                have hmul : Kd * (n : ℝ).rpow (-2 : ℝ) ≤ Kd * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) := by
                                                                  have hle : Kd * 1 ≤ Kd * ((d : ℝ) + 1) := by
                                                                    exact mul_le_mul_of_nonneg_left hd1p hKd_nonneg
                                                                  calc
                                                                    Kd * (n : ℝ).rpow (-2 : ℝ) = (Kd * 1) * (n : ℝ).rpow (-2 : ℝ) := by ring
                                                                    _ ≤ (Kd * ((d : ℝ) + 1)) * (n : ℝ).rpow (-2 : ℝ) :=
                                                                      mul_le_mul_of_nonneg_right hle hnpow
                                                                    _ = Kd * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) := by ring
                                                                exact le_trans (hg_err x) hmul
                                          -- finisher: branch on d = 0
                                          by_cases hd : d = 0
                                          · exact h_degenerate hd
                                          · exact h_finish (Nat.pos_of_ne_zero hd)
                                        exact h_asm
                        exact h_rate_asm
      -- @step s5: E1: product equals axisAlignedBoxTentWeight; assemble Wtent/cDepth/cErr/D/P/g
      have h_main :
          ∃ Wtent : ℕ, 0 < Wtent ∧
            ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
              ∀ n : ℕ, 0 < n → ∀ center scale : Fin d → ℝ, (∀ q : Fin d, 0 ≤ scale q) →
                ∃ D P : ℕ,
                  0 < D ∧
                  (D : ℝ) ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) ∧
                  P = fullyConnectedReLUParameterCount d D Wtent ∧
                  ∃ g : (Fin d → ℝ) → ℝ,
                    g ∈ reluNetworkClass d D Wtent P ∧
                    ∀ x : Fin d → ℝ,
                      |g x - axisAlignedBoxTentWeight center scale x| ≤
                        cErr * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) := by
        refine ⟨Wtent, hWtent_pos, ?_⟩
        rcases h_err with ⟨cDepth, cErr, hcDepth, hcErr, hrate⟩
        refine ⟨cDepth, cErr, hcDepth, hcErr, ?_⟩
        intro n hn center scale hscale
        rcases hrate n hn center scale hscale with ⟨D, P, hD, hDle, hP, g, hg, herr⟩
        refine ⟨D, P, hD, hDle, hP, g, hg, ?_⟩
        intro x
        simpa [axisAlignedBoxTentWeight] using herr x
      exact h_main

/-- Fixed-width serial global assembly for weighted local tent approximants.

Given one weighted local approximant per grid cell, all in the same fixed-width
ReLU class and each approximating `w_j(x) * l_j(x)`, serially assemble the
finite sum without making the width grow with the number of cells.  On a domain
where the tensor tent weights form a partition of unity and the local
approximants are accurate on active cells, the resulting fully connected ReLU
network has depth `O((m+1)(Dprod+1))`, width independent of `m`, true fully
connected parameter count, and error `∑ productDelta + localEps`. -/
theorem finite_axisAligned_tent_weighted_local_reluNetworkClass_serial_fixed_width_global_error_bound
    {d m Dprod Wprod Pprod : ℕ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    (center scale : Fin m → Fin d → ℝ)
    (localApprox : Fin m → (Fin d → ℝ) → ℝ)
    (target : (Fin d → ℝ) → ℝ)
    (productApprox : Fin m → (Fin d → ℝ) → ℝ)
    (productDelta localEps : ℝ)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    {domain : (Fin d → ℝ) → Prop}
    (hclass : ∀ j : Fin m, productApprox j ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hprodErr : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |productApprox j x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
        productDelta)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ, domain x →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      |localApprox j x - target x| ≤ localEps) :
    ∃ cDepth : ℝ, 0 < cDepth ∧
      ∃ D P : ℕ, 0 < D ∧
        (D : ℝ) ≤ cDepth * ((m : ℝ) + 1) * ((Dprod : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
            ∀ x : Fin d → ℝ, domain x →
              |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
  have h_serial_network :
      ∃ cDepth : ℝ, 0 < cDepth ∧
        ∃ D P : ℕ, 0 < D ∧
          (D : ℝ) ≤ cDepth * ((m : ℝ) + 1) * ((Dprod : ℝ) + 1) ∧
          P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
          ∃ g0 : (Fin d → ℝ) → ℝ,
            g0 ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
              ∀ x : Fin d → ℝ, domain x →
                |g0 x -
                    (∑ j : Fin m,
                      axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)| ≤
                  (∑ j : Fin m, productDelta) := by
    obtain ⟨cDepth, hcDepth, D, P, hDpos, hDbound, hP, g, hgclass, hgbound⟩ :=
      finite_linear_combination_reluNetworkClass_serial_fixed_width_approximation_bound
        (ι := Fin m) (d := d) (D0 := Dprod) (W0 := Wprod) (P0 := Pprod)
        (domain := domain)
        hDprod hWprod
        (fun _ : Fin m => (1 : ℝ))
        (fun j x => axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)
        productApprox
        (fun _ : Fin m => productDelta)
        (fun _ => hProductDelta_nonneg)
        hclass
        hprodErr
    refine ⟨cDepth, hcDepth, D, P, hDpos, ?_, hP, g, hgclass, ?_⟩
    · simpa [Fintype.card_fin] using hDbound
    · intro x hx
      simpa [one_mul] using hgbound x hx
  have h_weighted_local :
      ∀ x : Fin d → ℝ, domain x →
        |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) -
            target x| ≤ localEps := by
    intro x hx
    have hsupport :
        ∀ j : Fin m,
          axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 →
            |localApprox j x - target x| ≤ localEps := by
      intro j hw
      apply hlocal j x hx
      intro q
      by_contra hq
      have hqle :
          1 ≤ scale j q * (relu (x q - center j q) + relu (center j q - x q)) :=
        le_of_not_gt hq
      exact hw ((axisAlignedBoxTentWeight_bounds_and_support
        (center j) (scale j) x (hscale j)).2.2 ⟨q, hqle⟩)
    simpa using
      (Statlib.Nonparametric.Approximation.Sieve.partition_of_unity_weighted_function_pointwise_approximation_error_bound
          (X := Unit) m
          (fun j (_ : Unit) => axisAlignedBoxTentWeight (center j) (scale j) x)
          (fun j (_ : Unit) => localApprox j x)
          (fun (_ : Unit) => target x)
          localEps
          (fun j (_ : Unit) =>
            (axisAlignedBoxTentWeight_bounds_and_support
              (center j) (scale j) x (hscale j)).1)
          (fun (_ : Unit) => hpartition x hx)
          (fun j (_ : Unit) hw => hsupport j hw)
          ())
  have h_combine :
      ∃ cDepth : ℝ, 0 < cDepth ∧
        ∃ D P : ℕ, 0 < D ∧
          (D : ℝ) ≤ cDepth * ((m : ℝ) + 1) * ((Dprod : ℝ) + 1) ∧
          P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
          ∃ g : (Fin d → ℝ) → ℝ,
            g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
              ∀ x : Fin d → ℝ, domain x →
                |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
    obtain ⟨cDepth, hcDepth, D, P, hDpos, hDbound, hP, g, hgclass, hgbound⟩ :=
      h_serial_network
    refine ⟨cDepth, hcDepth, D, P, hDpos, hDbound, hP, g, hgclass, ?_⟩
    intro x hx
    calc
      |g x - target x|
          ≤ |g x -
              (∑ j : Fin m,
                axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)| +
              |(∑ j : Fin m,
                axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x) -
                  target x| :=
            abs_sub_le (g x)
              (∑ j : Fin m,
                axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)
              (target x)
      _ ≤ (∑ j : Fin m, productDelta) + localEps :=
            add_le_add (hgbound x hx) (h_weighted_local x hx)
  exact h_combine

theorem finite_axisAlignedBoxTentWeight_common_fixed_width_depth_rate_from_mul_gadget
    {d m Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (center scale : Fin m → Fin d → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q) :
    ∃ Wtent : ℕ, 0 < Wtent ∧
      ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
        ∀ n : ℕ, 0 < n →
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wtent ∧
            ∃ weightApprox : Fin m → (Fin d → ℝ) → ℝ,
              (∀ j : Fin m,
                weightApprox j ∈ reluNetworkClass d D Wtent P) ∧
              ∀ j : Fin m, ∀ x : Fin d → ℝ,
                |weightApprox j x -
                  axisAlignedBoxTentWeight (center j) (scale j) x| ≤
                    cErr * ((d : ℝ) + 1) *
                      (n : ℝ).rpow (-2 : ℝ) := by
  rcases (exists_reluNetworkClass_axisAlignedBoxTentWeight_fixed_width_depth_rate_from_mul_gadget
      (d := d) (Wmul := Wmul) hWmul (cMulDepth := cMulDepth) (cMulErr := cMulErr)
      hcMulDepth hcMulErr hmul) with
    ⟨Wtent, hWtent, cDepth0, cErr0, hcDepth0, hcErr0, hmain⟩
  let cDepth : ℝ := max cDepth0 1
  let cErr : ℝ := cErr0
  have hcDepth : 0 < cDepth := by
    dsimp [cDepth]
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) (le_max_right cDepth0 1)
  have hcDepth1 : (1 : ℝ) ≤ cDepth := by
    dsimp [cDepth]
    exact le_max_right cDepth0 1
  have hcDepth0le : cDepth0 ≤ cDepth := by
    dsimp [cDepth]
    exact le_max_left cDepth0 1
  have hcErr : 0 < cErr := by
    dsimp [cErr]
    exact hcErr0
  refine ⟨Wtent, hWtent, cDepth, cErr, hcDepth, hcErr, ?_⟩
  intro n hn
  have hj (j : Fin m) : ∃ D P : ℕ,
      0 < D ∧ (D : ℝ) ≤ cDepth0 * ((d : ℝ) + 1) * ((n : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D Wtent ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D Wtent P ∧
            ∀ x : Fin d → ℝ,
              |g x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤
                cErr0 * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ) :=
    hmain n hn (center j) (scale j) (hscale j)
  choose D_j P_j hDj using hj
  let g_j : Fin m → (Fin d → ℝ) → ℝ := fun j => (hDj j).2.2.2.choose
  let B : ℝ := cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1)
  have hd1 : (1 : ℝ) ≤ (d : ℝ) + 1 := by
    have h0 : (0 : ℝ) ≤ (d : ℝ) := by exact_mod_cast (Nat.zero_le d)
    nlinarith
  have hn1 : (1 : ℝ) ≤ (n : ℝ) + 1 := by
    have h0 : (0 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (Nat.zero_le n)
    nlinarith
  have hcpos : (0 : ℝ) ≤ cDepth := by linarith [hcDepth]
  have hB1 : (1 : ℝ) ≤ B := by
    dsimp [B]
    have hdpos : (0 : ℝ) ≤ (d : ℝ) + 1 := by linarith
    calc
      (1 : ℝ) ≤ cDepth * 1 := by simpa using hcDepth1
      _ ≤ cDepth * ((d : ℝ) + 1) := by
        exact mul_le_mul_of_nonneg_left hd1 hcpos
      _ ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) := by
        simpa [mul_one] using (mul_le_mul_of_nonneg_left hn1 (mul_nonneg hcpos hdpos))
  have hBpos : (0 : ℝ) ≤ B := by linarith [hB1]
  have hDjB (j : Fin m) : (D_j j : ℝ) ≤ B := by
    dsimp [B]
    have hX : (0 : ℝ) ≤ ((d : ℝ) + 1) * ((n : ℝ) + 1) := by positivity
    calc
      (D_j j : ℝ) ≤ cDepth0 * ((d : ℝ) + 1) * ((n : ℝ) + 1) := (hDj j).2.1
      _ ≤ cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) := by
        calc
          cDepth0 * ((d : ℝ) + 1) * ((n : ℝ) + 1) = cDepth0 * (((d : ℝ) + 1) * ((n : ℝ) + 1)) := by ring
          _ ≤ cDepth * (((d : ℝ) + 1) * ((n : ℝ) + 1)) := mul_le_mul_of_nonneg_right hcDepth0le hX
          _ = cDepth * ((d : ℝ) + 1) * ((n : ℝ) + 1) := by ring
  have hsup_cast (s : Finset (Fin m)) (hs : ∀ j ∈ s, (D_j j : ℝ) ≤ B) : ((s.sup D_j : ℕ) : ℝ) ≤ B := by
    induction s using Finset.induction_on with
    | empty =>
        simpa using hBpos
    | insert a t hat ih =>
        rw [Finset.sup_insert]
        rw [Nat.cast_max]
        exact max_le (hs a (by simp)) (ih (fun j hj => hs j (by simp [hj])))
  let D : ℕ := max 1 (Finset.univ.sup D_j)
  let P : ℕ := fullyConnectedReLUParameterCount d D Wtent
  have hDpos : 0 < D := by
    dsimp [D]
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_left 1 (Finset.univ.sup D_j))
  have hDleB : (D : ℝ) ≤ B := by
    dsimp [D]
    rw [Nat.cast_max]
    exact max_le (by simpa using hB1) (hsup_cast Finset.univ (fun j _ => hDjB j))
  have hparam_mono {D1 D2 : ℕ} (h : D1 ≤ D2) :
      fullyConnectedReLUParameterCount d D1 Wtent ≤ fullyConnectedReLUParameterCount d D2 Wtent := by
    unfold fullyConnectedReLUParameterCount
    exact Nat.add_le_add_right
      (Nat.add_le_add_left
        (Nat.mul_le_mul_right ((Wtent + 1) * Wtent) (Nat.sub_le_sub_right h 1)) ((d + 1) * Wtent))
      (Wtent + 1)
  refine ⟨D, P, hDpos, ?_, rfl, ?_⟩
  · simpa [B] using hDleB
  · refine ⟨g_j, ?_, ?_⟩
    · intro j
      have hDjD : D_j j ≤ D := by
        dsimp [D]
        exact le_trans (Finset.le_sup (by simp : j ∈ (Finset.univ : Finset (Fin m))))
          (le_max_right 1 (Finset.univ.sup D_j))
      have hPjP : P_j j ≤ P := by
        dsimp [P]
        calc
          P_j j = fullyConnectedReLUParameterCount d (D_j j) Wtent := (hDj j).2.2.1
          _ ≤ fullyConnectedReLUParameterCount d D Wtent := hparam_mono hDjD
      rcases (hDj j).2.2.2.choose_spec.1 with ⟨N, hNpos, hNdepth, hNwidth, hNparam, hNreal⟩
      refine ⟨N, hNpos, le_trans hNdepth hDjD, hNwidth, le_trans hNparam hPjP, ?_⟩
      intro x
      exact hNreal x
    · intro j x
      change |(hDj j).2.2.2.choose x - axisAlignedBoxTentWeight (center j) (scale j) x| ≤
        cErr * ((d : ℝ) + 1) * (n : ℝ).rpow (-2 : ℝ)
      simpa [cErr] using (hDj j).2.2.2.choose_spec.2 x

theorem finite_axisAligned_tent_weighted_local_products_fixed_width_depth_sum_bound
    {d m Dtent Wtent Ptent Dlocal Wlocal Plocal Wmul : ℕ}
    (hDtent : 0 < Dtent) (hWtent : 0 < Wtent)
    (hDlocal : 0 < Dlocal) (hWlocal : 0 < Wlocal)
    (hWmul : 0 < Wmul)
    {cMulDepth cMulErr ηw R productDelta : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hηw : 0 ≤ ηw) (hR : 0 < R)
    (nMul : ℕ) (hnMul : 0 < nMul)
    (hProductDelta :
      cMulErr * R ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) + R * ηw ≤ productDelta)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    {domain : (Fin d → ℝ) → Prop}
    (center scale : Fin m → Fin d → ℝ)
    (localApprox weightApprox : Fin m → (Fin d → ℝ) → ℝ)
    (hlocalClass : ∀ j : Fin m,
      localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal)
    (hweightClass : ∀ j : Fin m,
      weightApprox j ∈ reluNetworkClass d Dtent Wtent Ptent)
    (hlocalBound : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |localApprox j x| ≤ R)
    (hweightApproxBound : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |weightApprox j x| ≤ R)
    (hweightTargetBound : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |axisAlignedBoxTentWeight (center j) (scale j) x| ≤ R)
    (hweightErr : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |weightApprox j x -
        axisAlignedBoxTentWeight (center j) (scale j) x| ≤ ηw) :
    ∃ Dprod Pprod : ℕ,
      0 < Dprod ∧
      (Dprod : ℝ) ≤
        (Nat.max Dlocal Dtent : ℝ) + cMulDepth * (nMul : ℝ) ∧
      Pprod =
        fullyConnectedReLUParameterCount d Dprod (Wlocal + Wtent + Wmul) ∧
      ∃ productApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          productApprox j ∈
            reluNetworkClass d Dprod (Wlocal + Wtent + Wmul) Pprod) ∧
        ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
          |productApprox j x -
            axisAlignedBoxTentWeight (center j) (scale j) x *
              localApprox j x| ≤ productDelta := by
  classical
  let M : ℕ := Nat.max Dlocal Dtent
  let Wc : ℕ := Wlocal + Wtent + Wmul
  have hMpos : 0 < M := by
    dsimp [M]
    exact lt_of_lt_of_le hDlocal (Nat.le_max_left Dlocal Dtent)
  have hMge_one : (1 : ℝ) ≤ (M : ℝ) := by
    exact_mod_cast (Nat.succ_le_of_lt hMpos)
  have hbound_ge_one : (1 : ℝ) ≤ (M : ℝ) + cMulDepth * (nMul : ℝ) := by
    have hpos : 0 ≤ cMulDepth * (nMul : ℝ) := by
      exact mul_nonneg (le_of_lt hcMulDepth) (Nat.cast_nonneg nMul)
    exact le_trans hMge_one (le_add_of_nonneg_right hpos)
  have hpercell : ∀ j : Fin m, ∃ D P : ℕ,
      0 < D ∧ (D : ℝ) ≤ (M : ℝ) + cMulDepth * (nMul : ℝ) ∧
      P = fullyConnectedReLUParameterCount d D Wc ∧
      ∃ h : (Fin d → ℝ) → ℝ,
        h ∈ reluNetworkClass d D Wc P ∧
        ∀ x : Fin d → ℝ, domain x →
          |h x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
            cMulErr * R ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) + R * ηw := by
    intro j
    obtain ⟨D, P, hDpos, hDle, hP, h, hmem, herr⟩ :=
      exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget_depth_sum_bound
        (d := d) (Df := Dlocal) (Dg := Dtent) (Wf := Wlocal) (Wg := Wtent)
        (Pf := Plocal) (Pg := Ptent) (Wmul := Wmul)
        hDlocal hDtent hWlocal hWtent hWmul
        (cMulDepth := cMulDepth) (cMulErr := cMulErr) hcMulDepth hcMulErr hmul
        (domain := domain) (targetF := localApprox j)
        (targetG := axisAlignedBoxTentWeight (center j) (scale j))
        (approxF := localApprox j) (approxG := weightApprox j)
        (ηf := 0) (ηg := ηw) (R := R)
        (by norm_num) hηw hR
        (hlocalClass j) (hweightClass j)
        (hlocalBound j) (hweightApproxBound j) (hweightTargetBound j)
        (fun x hx => by simp)
        (hweightErr j)
        nMul hnMul
    refine ⟨D, P, hDpos, ?_, hP, h, hmem, ?_⟩
    · simpa [M] using hDle
    · intro x hx
      simpa [mul_comm] using herr x hx
  choose Dcell Pcell hcell using hpercell
  have hmem_all : ∀ j : Fin m, ∃ h : (Fin d → ℝ) → ℝ,
      h ∈ reluNetworkClass d (Dcell j) Wc (Pcell j) ∧
      ∀ x : Fin d → ℝ, domain x →
        |h x - axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
          cMulErr * R ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) + R * ηw := by
    intro j
    exact (hcell j).2.2.2
  choose h hmem herr using hmem_all
  let Dprod : ℕ := max 1 (Finset.univ.sup Dcell)
  let Pprod : ℕ := fullyConnectedReLUParameterCount d Dprod Wc
  have hsup_le : ((Finset.univ.sup Dcell : ℕ) : ℝ) ≤ (M : ℝ) + cMulDepth * (nMul : ℝ) := by
    refine Finset.induction_on Finset.univ ?_ ?_
    · have h0 : (0 : ℝ) ≤ (M : ℝ) + cMulDepth * (nMul : ℝ) :=
        le_trans zero_le_one hbound_ge_one
      simpa using h0
    · intro a s has ih
      simp [Finset.sup_insert, Nat.cast_max]
      exact ⟨(hcell a).2.1, ih⟩
  have hDprod_le : (Dprod : ℝ) ≤ (M : ℝ) + cMulDepth * (nMul : ℝ) := by
    dsimp [Dprod]
    rw [Nat.cast_max]
    simp only [Nat.cast_one]
    exact max_le hbound_ge_one hsup_le
  have hDprod_pos : 0 < Dprod := by
    dsimp [Dprod]
    exact lt_of_lt_of_le (by norm_num : (0 : ℕ) < 1) (Nat.le_max_left 1 (Finset.univ.sup Dcell))
  have hpc_depth_mono : ∀ {D D' : ℕ}, D ≤ D' →
      fullyConnectedReLUParameterCount d D Wc ≤ fullyConnectedReLUParameterCount d D' Wc := by
    intro D D' hD
    dsimp [fullyConnectedReLUParameterCount]
    have hsub : D - 1 ≤ D' - 1 := Nat.sub_le_sub_right hD 1
    have hmul : (D - 1) * ((Wc + 1) * Wc) ≤ (D' - 1) * ((Wc + 1) * Wc) :=
      Nat.mul_le_mul_right ((Wc + 1) * Wc) hsub
    have hstep : (d + 1) * Wc + (D - 1) * ((Wc + 1) * Wc) ≤
        (d + 1) * Wc + (D' - 1) * ((Wc + 1) * Wc) :=
      Nat.add_le_add_left hmul ((d + 1) * Wc)
    exact Nat.add_le_add_right hstep (Wc + 1)
  have hclass_promote : ∀ {D D' P P' : ℕ}, D ≤ D' → P ≤ P' →
      ∀ {h : (Fin d → ℝ) → ℝ}, h ∈ reluNetworkClass d D Wc P → h ∈ reluNetworkClass d D' Wc P' := by
    intro D D' P P' hD hP h hmem
    rcases hmem with ⟨N, hNpos, hNd, hNw, hNp, hNr⟩
    refine ⟨N, hNpos, le_trans hNd hD, hNw, le_trans hNp hP, hNr⟩
  have hDcell_le_Dprod : ∀ j : Fin m, Dcell j ≤ Dprod := by
    intro j
    exact le_trans (Finset.le_sup (s := (Finset.univ : Finset (Fin m))) (f := Dcell) (Finset.mem_univ j))
      (Nat.le_max_right 1 (Finset.univ.sup Dcell))
  have hPcell_le_Pprod : ∀ j : Fin m, Pcell j ≤ Pprod := by
    intro j
    dsimp [Pprod]
    rw [(hcell j).2.2.1]
    exact hpc_depth_mono (hDcell_le_Dprod j)
  refine ⟨Dprod, Pprod, hDprod_pos, hDprod_le, ?_, ?_⟩
  · rfl
  · refine ⟨fun j => h j, ?_, ?_⟩
    · intro j
      simpa [Wc] using hclass_promote (hDcell_le_Dprod j) (hPcell_le_Pprod j) (hmem j)
    · intro j x hx
      exact le_trans (herr j x hx) hProductDelta

theorem holderSmoothBall_unitCube_LM2_rate_from_M_rate
    {d r W0 : ℕ} {beta C B cDepth cErr : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcDepth : 0 < cDepth) (hcErr : 0 < cErr)
    (hMrate :
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤
                      cErr *
                        (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cRate : ℝ, 0 < cRate ∧
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
          W = W0 ∧
          P = fullyConnectedReLUParameterCount d L W ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d L W P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                        |g x - f x| ≤
                          cRate *
                            (((L : ℝ) * (W : ℝ) ^ 2).rpow
                              (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  let s : ℝ := (r : ℝ) + beta
  let e1 : ℝ := (2 * s) / (d : ℝ)
  let cRate : ℝ := cErr * cDepth ^ e1 * (W0 : ℝ) ^ (2 * e1)
  have hs_pos : 0 < s := hsmooth_pos
  have _hs_nonneg : 0 ≤ s := by
    dsimp [s]
    exact add_nonneg (by exact_mod_cast (Nat.zero_le r)) hbeta_nonneg
  have hdR : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd
  have hdR_ne : (d : ℝ) ≠ 0 := ne_of_gt hdR
  have he1_pos : 0 < e1 := div_pos (mul_pos two_pos hs_pos) hdR
  have he1_nonneg : 0 ≤ e1 := le_of_lt he1_pos
  have hneg_e1 : -e1 ≤ 0 := neg_nonpos.mpr he1_nonneg
  have hW0R : (0 : ℝ) < (W0 : ℝ) := by exact_mod_cast hW0
  have hW0R_nonneg : 0 ≤ (W0 : ℝ) := le_of_lt hW0R
  have hcDepth_nonneg : 0 ≤ cDepth := le_of_lt hcDepth
  have hcRate_pos : 0 < cRate := by
    dsimp [cRate]
    exact mul_pos (mul_pos hcErr (Real.rpow_pos_of_pos hcDepth e1))
      (Real.rpow_pos_of_pos hW0R (2 * e1))
  have hcRate_nonneg : 0 ≤ cRate := le_of_lt hcRate_pos
  refine ⟨cRate, hcRate_pos, ?_⟩
  intro M hM
  have hM_R : (0 : ℝ) < (M : ℝ) := by exact_mod_cast hM
  have hM_nonneg : 0 ≤ (M : ℝ) := le_of_lt hM_R
  rcases hMrate M hM with ⟨D, P, hDpos, hDle, hP, happrox⟩
  refine ⟨D, W0, P, hDpos, hW0, rfl, hP, ?_⟩
  intro f hf
  rcases happrox f hf with ⟨g, hg, hgapprox⟩
  refine ⟨g, hg, ?_⟩
  intro x hx
  change |g x - f x| ≤ cRate * ((D : ℝ) * (W0 : ℝ) ^ 2) ^ (-e1)
  have hMnat : ((M : ℝ) ^ d) ^ (-e1) = (M : ℝ) ^ (-(2 * s)) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul hM_nonneg]
    congr 1
    dsimp [e1]
    field_simp [hdR_ne]

  have hWnat : ((W0 : ℝ) ^ 2) ^ (-e1) = (W0 : ℝ) ^ (-(2 * e1)) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul hW0R_nonneg]
    congr 1
    ring
  have hdistrib :
      (cDepth * (M : ℝ) ^ d * (W0 : ℝ) ^ 2) ^ (-e1) =
        cDepth ^ (-e1) * ((M : ℝ) ^ d) ^ (-e1) * ((W0 : ℝ) ^ 2) ^ (-e1) := by
    rw [Real.mul_rpow (mul_nonneg hcDepth_nonneg (pow_nonneg hM_nonneg d)) (sq_nonneg (W0 : ℝ))]
    rw [Real.mul_rpow hcDepth_nonneg (pow_nonneg hM_nonneg d)]
  have hcollapse :
      cRate * (cDepth * (M : ℝ) ^ d * (W0 : ℝ) ^ 2) ^ (-e1) =
        cErr * (M : ℝ) ^ (-(2 * s)) := by
    dsimp [cRate]
    rw [hdistrib, hMnat, hWnat]
    calc
      (cErr * cDepth ^ e1 * (W0 : ℝ) ^ (2 * e1)) *
          (cDepth ^ (-e1) * (M : ℝ) ^ (-(2 * s)) * (W0 : ℝ) ^ (-(2 * e1)))
          = cErr * (M : ℝ) ^ (-(2 * s)) *
              (cDepth ^ e1 * cDepth ^ (-e1)) *
              ((W0 : ℝ) ^ (2 * e1) * (W0 : ℝ) ^ (-(2 * e1))) := by
        ring
      _ = cErr * (M : ℝ) ^ (-(2 * s)) * cDepth ^ (e1 + -e1) *
              (W0 : ℝ) ^ ((2 * e1) + -(2 * e1)) := by
        rw [← Real.rpow_add hcDepth, ← Real.rpow_add hW0R]
      _ = cErr * (M : ℝ) ^ (-(2 * s)) := by
        ring_nf
        rw [Real.rpow_zero, Real.rpow_zero]
        ring
  have hbase_le :
      (cDepth * (M : ℝ) ^ d * (W0 : ℝ) ^ 2) ^ (-e1) ≤ ((D : ℝ) * (W0 : ℝ) ^ 2) ^ (-e1) := by
    exact Real.rpow_le_rpow_of_nonpos
      (mul_pos (by exact_mod_cast hDpos) (sq_pos_of_pos hW0R))
      (mul_le_mul_of_nonneg_right hDle (sq_nonneg (W0 : ℝ)))
      hneg_e1
  calc
    |g x - f x| ≤ cErr * (M : ℝ) ^ (-(2 * s)) := by
      simpa [s] using hgapprox x hx
    _ = cRate * (cDepth * (M : ℝ) ^ d * (W0 : ℝ) ^ 2) ^ (-e1) := by
      exact hcollapse.symm
    _ ≤ cRate * ((D : ℝ) * (W0 : ℝ) ^ 2) ^ (-e1) := by
      exact mul_le_mul_of_nonneg_left hbase_le hcRate_nonneg

theorem exists_reluNetworkClass_holderSmooth_unitCube_fixed_width_exact_grid_and_error_budget
    {d m r Dlocal Wlocal Plocal Dtent Wtent Ptent Dprod Wprod Pprod : ℕ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    {beta C B localEps weightDelta productDelta eps : ℝ}
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hGlobalErrBudget : (∑ j : Fin m, productDelta) + localEps ≤ eps)
    (center scale : Fin m → Fin d → ℝ)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (localApprox weightApprox productApprox : Fin m → (Fin d → ℝ) → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocalClass : ∀ j : Fin m,
      localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal)
    (hweightClass : ∀ j : Fin m,
      weightApprox j ∈ reluNetworkClass d Dtent Wtent Ptent)
    (hproductClass : ∀ j : Fin m,
      productApprox j ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hproductErr : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        |productApprox j x -
          axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤ productDelta)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |localApprox j x - f x| ≤ localEps) :
    ∃ cDepth : ℝ, 0 < cDepth ∧
      ∃ D P : ℕ,
        0 < D ∧
        (D : ℝ) ≤ cDepth * ((m : ℝ) + 1) * ((Dprod : ℝ) + 1) ∧
        P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
            ∀ x : Fin d → ℝ,
              (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                |g x - f x| ≤ eps := by
  let domain : (Fin d → ℝ) → Prop := fun x => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1
  obtain ⟨cDepth, hcDepth, ⟨D, P, hDpos, hDle, hP, ⟨g, hgclass, hgerr⟩⟩⟩ :=
    finite_axisAligned_tent_weighted_local_reluNetworkClass_serial_fixed_width_global_error_bound
      (d := d) (m := m) (Dprod := Dprod) (Wprod := Wprod) (Pprod := Pprod)
      hDprod hWprod center scale localApprox f productApprox productDelta localEps
      hProductDelta_nonneg (domain := domain) hproductClass hproductErr hscale hpartition hlocal
  refine ⟨cDepth, hcDepth, D, P, hDpos, hDle, hP, g, hgclass, ?_⟩
  intro x hx
  exact le_trans (hgerr x hx) hGlobalErrBudget

theorem holderSmoothBall_unitCube_fixed_width_M_rate_from_exact_grid
    {d r W0 : ℕ} {beta C B cDepth cErr : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcDepth : 0 < cDepth) (hcErr : 0 < cErr)
    (hexact :
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤
                      cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ W : ℕ, 0 < W ∧
      ∃ cDepth' cErr' : ℝ, 0 < cDepth' ∧ 0 < cErr' ∧
        ∀ M : ℕ, 0 < M →
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth' * ((M : ℝ) ^ d) ∧
            P = fullyConnectedReLUParameterCount d D W ∧
            ∀ f : (Fin d → ℝ) → ℝ,
              f ∈ holderSmoothBall r beta C B →
              ∃ g : (Fin d → ℝ) → ℝ,
                g ∈ reluNetworkClass d D W P ∧
                  ∀ x : Fin d → ℝ,
                    (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                      |g x - f x| ≤
                        cErr' * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
  refine ⟨W0, hW0, cDepth, cErr, hcDepth, hcErr, ?_⟩
  intro M hM
  exact hexact M hM

theorem holderSmoothBall_unitCube_LW2_rate_from_depth_width_scale_rate
    {d r : ℕ} {beta C B cSize cErr : ℝ}
    (hd : 0 < d)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcSize : 0 < cSize)
    (hcErr : 0 < cErr)
    (hScale :
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
            ((L : ℝ) * (W : ℝ) ^ 2) ≤ cSize * ((M : ℝ) ^ d) ∧
            P = fullyConnectedReLUParameterCount d L W ∧
            ∀ f : (Fin d → ℝ) → ℝ,
              f ∈ holderSmoothBall r beta C B →
                ∃ g : (Fin d → ℝ) → ℝ,
                  g ∈ reluNetworkClass d L W P ∧
                    ∀ x : Fin d → ℝ,
                      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                        |g x - f x| ≤ cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cRate : ℝ, 0 < cRate ∧
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
            P = fullyConnectedReLUParameterCount d L W ∧
            ∀ f : (Fin d → ℝ) → ℝ,
              f ∈ holderSmoothBall r beta C B →
                ∃ g : (Fin d → ℝ) → ℝ,
                  g ∈ reluNetworkClass d L W P ∧
                    ∀ x : Fin d → ℝ,
                      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                        |g x - f x| ≤
                          cRate *
                            (((L : ℝ) * (W : ℝ) ^ 2).rpow
                              (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  let s : ℝ := (r : ℝ) + beta
  let e : ℝ := (2 * s) / (d : ℝ)
  refine ⟨cErr * cSize ^ e, ?_, ?_⟩
  · exact mul_pos hcErr (Real.rpow_pos_of_pos hcSize e)
  · intro M hM
    rcases hScale M hM with ⟨L, W, P, hL, hW, hLW, hP, hf⟩
    refine ⟨L, W, P, hL, hW, hP, ?_⟩
    intro f hfm
    rcases hf f hfm with ⟨g, hg, hb⟩
    refine ⟨g, hg, ?_⟩
    intro x hx
    let A : ℝ := (L : ℝ) * (W : ℝ) ^ 2
    change |g x - f x| ≤ cErr * cSize ^ e * A.rpow (-e)
    have hMpos : (0 : ℝ) < (M : ℝ) := by exact_mod_cast hM
    have hdR : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd
    have _hs_nonneg : 0 ≤ s := by
      dsimp [s]
      exact add_nonneg (by exact_mod_cast (Nat.zero_le r)) hbeta_nonneg
    have hs : 0 < s := by simpa [s] using hsmooth_pos
    have he : 0 < e := by
      dsimp [e]
      exact div_pos (mul_pos two_pos hs) hdR
    have hLpos : (0 : ℝ) < (L : ℝ) := by exact_mod_cast hL
    have hWpos : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
    have hA : 0 < A := by
      dsimp [A]
      exact mul_pos hLpos (pow_pos hWpos 2)
    have hLe : A / cSize ≤ (M : ℝ) ^ d := by
      exact (div_le_iff₀ hcSize).2 (by simpa [A, mul_comm] using hLW)
    have hAc : 0 < A / cSize := div_pos hA hcSize
    have hI : (M : ℝ) ^ (-(2 * s)) ≤ cSize ^ e * A ^ (-e) := by
      have hde : (d : ℝ) * e = 2 * s := by
        dsimp [e]
        field_simp [hdR.ne']
      have hse : -(2 * s) = (d : ℝ) * (-e) := by
        rw [← hde]
        ring
      have h1 : (M : ℝ) ^ (-(2 * s)) = ((M : ℝ) ^ d) ^ (-e) := by
        calc
          (M : ℝ) ^ (-(2 * s)) = (M : ℝ) ^ ((d : ℝ) * (-e)) := by rw [hse]
          _ = ((M : ℝ) ^ (d : ℝ)) ^ (-e) := by rw [Real.rpow_mul hMpos.le]
          _ = ((M : ℝ) ^ d) ^ (-e) := by rw [Real.rpow_natCast]
      have hneg : -e ≤ 0 := by linarith
      have hAnt : ((M : ℝ) ^ d) ^ (-e) ≤ (A / cSize) ^ (-e) := by
        exact Real.rpow_le_rpow_of_nonpos hAc hLe hneg
      have hDiv : (A / cSize) ^ (-e) = cSize ^ e * A ^ (-e) := by
        calc
          (A / cSize) ^ (-e) = A ^ (-e) / cSize ^ (-e) := by
            rw [Real.div_rpow hA.le hcSize.le]
          _ = A ^ (-e) * cSize ^ e := by
            rw [div_eq_mul_inv, Real.rpow_neg hcSize.le, inv_inv]
          _ = cSize ^ e * A ^ (-e) := by rw [mul_comm]
      calc
        (M : ℝ) ^ (-(2 * s)) = ((M : ℝ) ^ d) ^ (-e) := h1
        _ ≤ (A / cSize) ^ (-e) := hAnt
        _ = cSize ^ e * A ^ (-e) := hDiv
    calc
      |g x - f x| ≤ cErr * (M : ℝ).rpow (-(2 * s)) := by simpa [s] using hb x hx
      _ ≤ cErr * (cSize ^ e * A.rpow (-e)) := mul_le_mul_of_nonneg_left hI hcErr.le
      _ = cErr * cSize ^ e * A.rpow (-e) := by rw [← mul_assoc]

/- A serial fixed-width fully connected ReLU network realizes any finite linear combination
of common-class approximants, with explicit depth, width, and parameter-count bounds. -/
set_option maxHeartbeats 800000 in
theorem finite_linear_combination_reluNetworkClass_serial_fixed_width_network_witness_bound
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {d D0 W0 P0 : ℕ}
    (hD0 : 0 < D0) (hW0 : 0 < W0)
    (coeff : ι → ℝ)
    (approx : ι → (Fin d → ℝ) → ℝ)
    (hclass : ∀ i : ι, approx i ∈ reluNetworkClass d D0 W0 P0) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      N.width ≤ 2 * d + W0 + 3 ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d
          ((Fintype.card ι + 1) * (D0 + 1))
          (2 * d + W0 + 3) ∧
      ∀ x : Fin d → ℝ,
        N.realize x = ∑ i : ι, coeff i * approx i x := by
  let W : ℕ := 2 * d + W0 + 3
  let state : (Fin d → ℝ) → ℝ → ℝ → (Fin W0 → ℝ) → Fin W → ℝ :=
    fun x p n w k =>
      if hx : k.val < d then relu (x ⟨k.val, hx⟩)
      else if hxn : k.val < 2 * d then relu (-(x ⟨k.val - d, by omega⟩))
      else if hp : k.val = 2 * d then p
      else if hn : k.val = 2 * d + 1 then n
      else if hw : k.val < 2 * d + 2 + W0 then w ⟨k.val - (2 * d + 2), by omega⟩
      else 0
  -- @step s1: per-index witness networks from hclass
  have hwit : ∀ i : ι,
      ∃ A : FullyConnectedReLUNet d,
        0 < A.depth ∧ A.depth ≤ D0 ∧ A.width ≤ W0 ∧ A.parameterCount ≤ P0 ∧
          ∀ x : Fin d → ℝ, A.realize x = approx i x := by
    intro i
    rcases hclass i with ⟨A, hAd, hAdD, hAw, hAp, hAreal⟩
    refine ⟨A, hAd, hAdD, hAw, hAp, ?_⟩
    intro x
    exact (hAreal x).symm
  let wit : ι → FullyConnectedReLUNet d := fun i => Classical.choose (hwit i)
  -- @step s2: per-index accumulator block of depth D0+2 (input + D0+1 hidden), width W.
  -- Channel layout of the state: 0..d-1 = relu x, d..2d-1 = relu (-x), 2d = p, 2d+1 = n,
  -- 2d+2..2d+1+W0 = W0 witness working channels, W-1 = inert slack.  Every carried channel is
  -- ≥ 0 (relu outputs), so identity passes survive ReLU layers.  The block runs the witness
  -- network `wit i` on x across its first wD ≤ D0 hidden layers (padded to depth D0 with identity
  -- layers), then the last hidden layer rewrites the pair (p, n) ↦ (relu (p-n+a·g), relu (n-p-a·g))
  -- with a = coeff i and g = (wit i).realize x; the x-pair channels are preserved.
  have hblock : ∀ i : ι,
      ∃ B : FullyConnectedReLUNet W,
        ∃ hBw : B.width = W,
          B.depth = D0 + 2 ∧
          (∀ (v : Fin B.width → ℝ), (∀ c : Fin B.width, 0 ≤ v c) →
            ∀ (hidx : D0 - 1 < B.depth - 1), (B.hidden ⟨D0 - 1, hidx⟩).reluApply v = v) ∧
          B.parameterCount ≤ fullyConnectedReLUParameterCount W (D0 + 2) W ∧
          ∀ (x : Fin d → ℝ) (p n : ℝ) (w : Fin W0 → ℝ),
            0 ≤ p → 0 ≤ n → ∀ k : Fin B.width,
              (k.val < 2 * d ∨ k.val = 2 * d ∨ k.val = 2 * d + 1 ∨
                2 * d + 2 + W0 ≤ k.val) →
                B.hiddenState (state x p n w) (D0 + 1) k =
                  state x (relu (p - n + coeff i * (wit i).realize x))
                    (relu (n - p - coeff i * (wit i).realize x)) w (Fin.cast hBw k) := by
    intro i
    -- h1: per-index witness data from hwit (choice spec)
    have hwspec := Classical.choose_spec (hwit i)
    rcases hwspec with ⟨hwd_pos, hwd_le, hww_le, hwp_le, hwreal⟩
    let wW : ℕ := (wit i).width
    have hwW_le : wW ≤ W0 := by simpa [wW] using hww_le
    -- channel predicates and encodings
    let isState : Fin W → Prop := fun c => c.val < 2 * d ∨ c.val = 2 * d ∨ c.val = 2 * d + 1
    let isWork : Fin W → Prop := fun c => 2 * d + 2 ≤ c.val ∧ c.val < 2 * d + 2 + wW
    let wEnc : Fin wW → Fin W := fun t => ⟨2 * d + 2 + t.val, by omega⟩
    let wDec : (c : Fin W) → isWork c → Fin wW := fun c hc => ⟨c.val - (2 * d + 2), by
      rcases hc with ⟨h1, h2⟩; omega⟩
    have hwEnc_dec (c : Fin W) (hc : isWork c) : wEnc (wDec c hc) = c := by
      ext
      simp [wEnc, wDec, isWork] at hc ⊢
      omega
    have hwDec_enc (t : Fin wW) : wDec (wEnc t) (by simp [wEnc, isWork]) = t := by
      ext
      simp [wEnc, wDec]
    -- basic relu facts
    have hrelu_nonneg : ∀ x : ℝ, 0 ≤ relu x := by
      intro x
      dsimp [relu]
      exact le_max_right x 0
    have hrelu_of_nonneg : ∀ {x : ℝ}, 0 ≤ x → relu x = x := by
      intro x hx
      dsimp [relu]
      exact max_eq_left hx
    have hrelu_of_nonpos : ∀ {x : ℝ}, x ≤ 0 → relu x = 0 := by
      intro x hx
      dsimp [relu]
      exact max_eq_right hx
    -- h3: the block B : FullyConnectedReLUNet W, depth D0 + 2, width W
    let inLayer : DenseLayer W W :=
      { weight := fun c c' =>
          if hc : isState c then (if c = c' then 1 else 0)
          else if hcw : isWork c then
            if h1 : 0 ≤ c'.val ∧ c'.val < d then
              (wit i).input.weight (wDec c hcw) ⟨c'.val, by omega⟩
            else if h2 : d ≤ c'.val ∧ c'.val < 2 * d then
              -((wit i).input.weight (wDec c hcw) ⟨c'.val - d, by omega⟩)
            else 0
          else 0
        bias := fun c =>
          if hc : isState c then 0
          else if hcw : isWork c then (wit i).input.bias (wDec c hcw)
          else 0 }
    let idLayer : DenseLayer W W :=
      { weight := fun c c' => if c = c' then 1 else 0
        bias := fun _ => 0 }
    let witLayer (t : Fin (D0 + 1)) (ht : t.val < (wit i).depth - 1) : DenseLayer W W :=
      { weight := fun c c' =>
          if hcw : isWork c then
            if hcw' : isWork c' then
              ((wit i).hidden ⟨t.val, ht⟩).weight (wDec c hcw) (wDec c' hcw')
            else 0
          else if c = c' then 1 else 0
        bias := fun c =>
          if hcw : isWork c then ((wit i).hidden ⟨t.val, ht⟩).bias (wDec c hcw) else 0 }
    let rewLayer : DenseLayer W W :=
      { weight := fun c c' =>
          if c.val = 2 * d then
            if c'.val = 2 * d then 1
            else if c'.val = 2 * d + 1 then -1
            else if hcw' : isWork c' then coeff i * (wit i).outputWeight (wDec c' hcw')
            else 0
          else if c.val = 2 * d + 1 then
            if c'.val = 2 * d then -1
            else if c'.val = 2 * d + 1 then 1
            else if hcw' : isWork c' then -(coeff i * (wit i).outputWeight (wDec c' hcw'))
            else 0
          else if c = c' then 1 else 0
        bias := fun c =>
          if c.val = 2 * d then coeff i * (wit i).outputBias
          else if c.val = 2 * d + 1 then -(coeff i * (wit i).outputBias)
          else 0 }
    let hid : Fin (D0 + 1) → DenseLayer W W := fun t =>
      if ht : t.val < (wit i).depth - 1 then witLayer t ht
      else if ht2 : t.val = D0 then rewLayer
      else idLayer
    let B : FullyConnectedReLUNet W :=
      { depth := D0 + 2
        width := W
        input := inLayer
        hidden := hid
        outputWeight := fun _ => 0
        outputBias := 0 }
    refine ⟨B, rfl, ?_⟩
    · refine ⟨rfl, ?_, ?_, ?_⟩
      · -- the identity-padding layer (block hidden index D0-1) fixes all nonneg states
        intro v hv hidx
        have hdepth_pos : 0 < (wit i).depth := (Classical.choose_spec (hwit i)).1
        have hdepth_le : (wit i).depth ≤ D0 := (Classical.choose_spec (hwit i)).2.1
        have hnot_lt : ¬ (D0 - 1) < (wit i).depth - 1 := by
          intro h
          have hsub_le : (wit i).depth - 1 ≤ D0 - 1 := by omega
          omega
        have hnot_eq : ¬ (D0 - 1) = D0 := by omega
        have hid_pres_id (u : Fin W → ℝ) (c : Fin W) (hu : 0 ≤ u c) :
            idLayer.reluApply u c = u c := by
          unfold DenseLayer.reluApply reluVec DenseLayer.apply
          simp [idLayer]
          exact hrelu_of_nonneg hu
        funext c
        change (hid ⟨D0 - 1, hidx⟩).reluApply v c = v c
        simp [hid, hnot_lt, hnot_eq]
        exact hid_pres_id v c (hv c)
      · exact le_rfl
      · -- h4: pointwise claim (filled next)
        intro x p n w hp hn k hk

        have hcast : ∀ (h : B.width = W) (k : Fin B.width), Fin.cast h k = k := by
          intro h k
          apply Fin.ext
          rfl
        rw [hcast]
        -- relu reconstruction: every real u equals relu u - relu (-u)
        have hrelu_sub (u : ℝ) : relu u - relu (-u) = u := by
          by_cases hu : 0 ≤ u
          · rw [hrelu_of_nonneg hu, hrelu_of_nonpos (neg_nonpos.mpr hu)]
            ring
          · have hu' : u ≤ 0 := le_of_not_ge hu
            rw [hrelu_of_nonpos hu', hrelu_of_nonneg (neg_nonneg.mpr hu')]
            ring
        -- a dense layer with identity weight and zero bias fixes nonnegative inputs
        have hid_pres (L : DenseLayer W W)
            (hLw : L.weight = fun c c' => if c = c' then 1 else 0)
            (hLb : L.bias = fun _ => 0) :
            ∀ (u : Fin W → ℝ) (c : Fin W), 0 ≤ u c → L.reluApply u c = u c := by
          intro u c hu
          unfold DenseLayer.reluApply reluVec DenseLayer.apply
          simp [hLw, hLb]
          exact hrelu_of_nonneg hu
        have hid_pres_id : ∀ (u : Fin W → ℝ) (c : Fin W), 0 ≤ u c → idLayer.reluApply u c = u c := by
          intro u c hu
          exact hid_pres idLayer rfl rfl u c hu
        have hinLayer_pres (u : Fin W → ℝ) (c : Fin W) (hc : isState c) (hu : 0 ≤ u c) :
            inLayer.reluApply u c = u c := by
          unfold DenseLayer.reluApply reluVec DenseLayer.apply
          simp [inLayer, hc]
          exact hrelu_of_nonneg hu
        have hwitLayer_pres (t : Fin (D0 + 1)) (ht : t.val < (wit i).depth - 1)
            (u : Fin W → ℝ) (c : Fin W) (hnot : ¬ isWork c) (hu : 0 ≤ u c) :
            (witLayer t ht).reluApply u c = u c := by
          unfold DenseLayer.reluApply reluVec DenseLayer.apply
          simp [witLayer, hnot]
          exact hrelu_of_nonneg hu
        have hrewLayer_pres (u : Fin W → ℝ) (c : Fin W)
            (h1 : c.val ≠ 2 * d) (h2 : c.val ≠ 2 * d + 1) (hu : 0 ≤ u c) :
            rewLayer.reluApply u c = u c := by
          unfold DenseLayer.reluApply reluVec DenseLayer.apply
          simp [rewLayer, h1, h2]
          exact hrelu_of_nonneg hu
        -- carried channels are nonnegative in the input state
        have hs_nonneg (c : Fin W) (hc : isState c ∨ 2 * d + 2 + W0 ≤ c.val) :
            0 ≤ state x p n w c := by
          rcases hc with hstate | hslack
          · rcases hstate with h1 | h2 | h3
            · by_cases hx : c.val < d
              · simp [state, hx]
                apply hrelu_nonneg
              · simp [state, hx, h1]
                apply hrelu_nonneg
            · have hx1' : ¬ 2 * d < d := by omega
              have hx2' : ¬ 2 * d < 2 * d := by omega
              simp [state, h2, hx1', hx2']
              exact hp
            · have hx1' : ¬ (2 * d + 1) < d := by omega
              have hx2' : ¬ (2 * d + 1) < 2 * d := by omega
              have hp' : ¬ 2 * d + 1 = 2 * d := by omega
              simp [state, h3, hx1', hx2', hp']
              exact hn
          · have hx1 : ¬ c.val < d := by omega
            have hx2 : ¬ c.val < 2 * d := by omega
            have hp' : ¬ c.val = 2 * d := by omega
            have hn' : ¬ c.val = 2 * d + 1 := by omega
            have hw' : ¬ c.val < 2 * d + 2 + W0 := by omega
            simp [state, hx1, hx2, hp', hn', hw']
        -- the work region is disjoint from state and slack channels
        have hstate_not_work (c : Fin W) (hc : isState c) : ¬ isWork c := by
          intro hw
          rcases hw with ⟨h4, _⟩
          rcases hc with h1 | h2 | h3 <;> omega
        have hslack_not_work (c : Fin W) (hc : 2 * d + 2 + W0 ≤ c.val) : ¬ isWork c := by
          intro hw
          rcases hw with ⟨_, h2⟩
          omega
        have hx_rew (c : Fin W) (hc : c.val < 2 * d) : c.val ≠ 2 * d ∧ c.val ≠ 2 * d + 1 := by
          constructor <;> omega
        have hslack_rew (c : Fin W) (hc : 2 * d + 2 + W0 ≤ c.val) : c.val ≠ 2 * d ∧ c.val ≠ 2 * d + 1 := by
          constructor <;> omega
        -- pre-rewrite layers (input layer + hidden layers 0..D0-1) fix carried channels
        have hpres (c : Fin W) (hc : isState c ∨ 2 * d + 2 + W0 ≤ c.val) :
            ∀ t, t ≤ D0 → B.hiddenState (state x p n w) t c = state x p n w c := by
          intro t
          induction t with
          | zero =>
              intro ht
              rcases hc with hstate | hslack
              · exact hinLayer_pres (state x p n w) c hstate (hs_nonneg c (Or.inl hstate))
              · have hns : ¬ isState c := by
                  intro h
                  rcases h with h1 | h2 | h3 <;> omega
                have hnw : ¬ isWork c := hslack_not_work c hslack
                have hv0 : inLayer.reluApply (state x p n w) c = 0 := by
                  unfold DenseLayer.reluApply reluVec DenseLayer.apply
                  simp [inLayer, hns, hnw, relu]
                have hs0 : state x p n w c = 0 := by
                  have h1 : ¬ c.val < d := by omega
                  have h2 : ¬ c.val < 2 * d := by omega
                  have h3 : ¬ c.val = 2 * d := by omega
                  have h4 : ¬ c.val = 2 * d + 1 := by omega
                  have h5 : ¬ c.val < 2 * d + 2 + W0 := by omega
                  simp [state, h1, h2, h3, h4, h5]
                change inLayer.reluApply (state x p n w) c = state x p n w c
                rw [hv0, hs0]
          | succ t ih =>
              intro ht
              have hlt : t < D0 := by omega
              have htB : t < B.depth - 1 := by
                simp [B]
                omega
              have hv : B.hiddenState (state x p n w) (t + 1) c =
                  (B.hidden ⟨t, htB⟩).reluApply (B.hiddenState (state x p n w) t) c := by
                change (if ht : t < B.depth - 1 then (B.hidden ⟨t, ht⟩).reluApply (B.hiddenState (state x p n w) t) else B.hiddenState (state x p n w) t) c =
                  (B.hidden ⟨t, htB⟩).reluApply (B.hiddenState (state x p n w) t) c
                simp [htB]
              have hnotwork : ¬ isWork c := by
                rcases hc with hstate | hslack
                · exact hstate_not_work c hstate
                · exact hslack_not_work c hslack
              have hnonneg_t : 0 ≤ B.hiddenState (state x p n w) t c := by
                rw [ih (by omega)]
                exact hs_nonneg c hc
              by_cases htW : t < (wit i).depth - 1
              · have hBhid : B.hidden ⟨t, htB⟩ = witLayer ⟨t, htB⟩ htW := by
                  simp [B, hid, htW]
                rw [hv, hBhid]
                rw [hwitLayer_pres ⟨t, htB⟩ htW (B.hiddenState (state x p n w) t) c hnotwork hnonneg_t]
                exact ih (by omega)
              · have hneD : t ≠ D0 := by omega
                have hBhid : B.hidden ⟨t, htB⟩ = idLayer := by
                  simp [B, hid, htW, hneD]
                rw [hv, hBhid]
                rw [hid_pres_id (B.hiddenState (state x p n w) t) c hnonneg_t]
                exact ih (by omega)
        -- ============ (IV) witness simulation on the work channels ============
        have hwEnc_work (t' : Fin wW) : isWork (wEnc t') := by
          have ht' : t'.val < wW := t'.isLt
          simp [wEnc, isWork, ht']
        have hwDec_wEnc (t' : Fin wW) : wDec (wEnc t') (hwEnc_work t') = t' := by
          apply Fin.ext
          simp [wDec, wEnc]
        have hnotState_wEnc (t' : Fin wW) : ¬ isState (wEnc t') := by
          intro h
          rcases h with h1 | h2 | h3
          · simp [wEnc] at h1
            omega
          · simp [wEnc] at h2
            omega
          · simp [wEnc] at h3
            omega
        -- reindex a sum over all channels into the work channels
        have hwork_sum (g : Fin W → ℝ) (hzero : ∀ c' : Fin W, ¬ isWork c' → g c' = 0) :
            (∑ c' : Fin W, g c') = (∑ j : Fin wW, g (wEnc j)) := by
          calc
            (∑ c' : Fin W, g c') = (∑ c' : Fin W, if isWork c' then g c' else 0) := by
              apply Finset.sum_congr rfl
              intro c' hc'
              by_cases hw : isWork c'
              · simp [hw]
              · simp [hzero c' hw]
            _ = (∑ c' : Fin W with isWork c', g c') := by
              rw [Finset.sum_filter]
            _ = (∑ j : Fin wW, g (wEnc j)) := by
              let s : Finset (Fin W) := Finset.univ.filter isWork
              let hmem : ∀ a : Fin W, a ∈ s → isWork a :=
                fun a ha => by simpa [s] using (Finset.mem_filter.mp ha).2
              let i : (a : Fin W) → a ∈ s → Fin wW := fun a ha => wDec a (hmem a ha)
              change (∑ c' ∈ s, g c') = (∑ j : Fin wW, g (wEnc j))
              refine Finset.sum_bij i ?mem ?inj ?surj ?eq
              · intro a ha
                simp
              · intro a₁ ha₁ a₂ ha₂ h
                have h1 : wEnc (i a₁ ha₁) = a₁ := by
                  dsimp [i, hmem]
                  exact hwEnc_dec a₁ (hmem a₁ ha₁)
                have h2 : wEnc (i a₂ ha₂) = a₂ := by
                  dsimp [i, hmem]
                  exact hwEnc_dec a₂ (hmem a₂ ha₂)
                calc
                  a₁ = wEnc (i a₁ ha₁) := h1.symm
                  _ = wEnc (i a₂ ha₂) := congrArg wEnc h
                  _ = a₂ := h2
              · intro b hb
                refine ⟨wEnc b, ?_, ?_⟩
                · simp [s]
                  exact hwEnc_work b
                · dsimp [i, hmem]
                  simpa using hwDec_wEnc b
              · intro a ha
                have hia : wEnc (i a ha) = a := by
                  dsimp [i, hmem]
                  exact hwEnc_dec a (hmem a ha)
                rw [hia]
        have hwitLayer_apply (t : Fin (D0 + 1)) (ht : t.val < (wit i).depth - 1)
            (u : Fin W → ℝ) (t' : Fin wW) :
            (witLayer t ht).apply u (wEnc t') =
              ((wit i).hidden ⟨t.val, ht⟩).apply (fun j => u (wEnc j)) t' := by
          unfold DenseLayer.apply
          have hbias : (witLayer t ht).bias (wEnc t') = ((wit i).hidden ⟨t.val, ht⟩).bias t' := by
            simp [witLayer, hwEnc_work t', hwDec_wEnc t']
          have hsum : (∑ c' : Fin W, (witLayer t ht).weight (wEnc t') c' * u c')
              = (∑ j : Fin wW, ((wit i).hidden ⟨t.val, ht⟩).weight t' j * u (wEnc j)) := by
            let g : Fin W → ℝ := fun c' =>
              (if hcw' : isWork c' then
                 ((wit i).hidden ⟨t.val, ht⟩).weight t' (wDec c' hcw')
               else 0) * u c'
            have hg : ∀ c' : Fin W, (witLayer t ht).weight (wEnc t') c' * u c' = g c' := by
              intro c'
              by_cases hw : isWork c'
              · simp [g, witLayer, hwEnc_work t', hwDec_wEnc t', hw]
              · have hne : wEnc t' ≠ c' := by
                  intro h
                  apply hw
                  simpa [h] using hwEnc_work t'
                simp [g, witLayer, hwEnc_work t', hw, hne]
            calc
              (∑ c' : Fin W, (witLayer t ht).weight (wEnc t') c' * u c') = (∑ c' : Fin W, g c') := by
                apply Finset.sum_congr rfl
                intro c' hc'
                exact hg c'
              _ = (∑ j : Fin wW, g (wEnc j)) := by
                apply hwork_sum g
                intro c' hnot
                unfold g
                simp [hnot]
              _ = (∑ j : Fin wW, ((wit i).hidden ⟨t.val, ht⟩).weight t' j * u (wEnc j)) := by
                apply Finset.sum_congr rfl
                intro j hj
                unfold g
                simp [hwEnc_work j, hwDec_wEnc j]
          rw [hsum, hbias]
        have hinput_work (t' : Fin wW) :
            inLayer.reluApply (state x p n w) (wEnc t') = (wit i).input.reluApply x t' := by
          unfold DenseLayer.reluApply reluVec

          congr 1
          unfold DenseLayer.apply
          have hbias : inLayer.bias (wEnc t') = (wit i).input.bias t' := by
            simp [inLayer, hnotState_wEnc t', hwEnc_work t', hwDec_wEnc t']
          have hsum : (∑ c' : Fin W, inLayer.weight (wEnc t') c' * state x p n w c')
              = (∑ j : Fin d, (wit i).input.weight t' j * x j) := by
            let f : Fin W → ℝ := fun c' => inLayer.weight (wEnc t') c' * state x p n w c'
            let A : Fin d → ℝ := fun j => (wit i).input.weight t' j
            have hf1 (c' : Fin W) (hc : c'.val < d) :
                f c' = A ⟨c'.val, by omega⟩ * relu (x ⟨c'.val, by omega⟩) := by
              unfold f A
              have hw : inLayer.weight (wEnc t') c' = (wit i).input.weight t' ⟨c'.val, by omega⟩ := by
                simp [inLayer, hnotState_wEnc t', hwEnc_work t', hwDec_wEnc t', hc]
              have hs : state x p n w c' = relu (x ⟨c'.val, by omega⟩) := by
                simp [state, hc]
              rw [hw, hs]
            have hf2 (c' : Fin W) (hc : d ≤ c'.val ∧ c'.val < 2 * d) :
                f c' = -(A ⟨c'.val - d, by omega⟩) * relu (-(x ⟨c'.val - d, by omega⟩)) := by
              unfold f A
              have hw : inLayer.weight (wEnc t') c' = -((wit i).input.weight t' ⟨c'.val - d, by omega⟩) := by
                simp [inLayer, hnotState_wEnc t', hwEnc_work t', hwDec_wEnc t', hc]
              have hs : state x p n w c' = relu (-(x ⟨c'.val - d, by omega⟩)) := by
                have h1 : ¬ c'.val < d := by omega
                simp [state, h1, hc.2]
              rw [hw, hs]
            have hf3 (c' : Fin W) (hc : 2 * d ≤ c'.val) : f c' = 0 := by
              unfold f
              have hw : inLayer.weight (wEnc t') c' = 0 := by
                simp [inLayer, hnotState_wEnc t', hwEnc_work t']
                by_cases h1 : 0 ≤ c'.val ∧ c'.val < d
                · exfalso
                  omega
                · by_cases h2 : d ≤ c'.val ∧ c'.val < 2 * d
                  · exfalso
                    omega
                  · simp [h1, h2]
                    intro h
                    exfalso
                    omega
              rw [hw]
              ring
            have hsplit : (∑ c' : Fin W, f c') = (∑ c' : Fin W with c'.val < d, f c')
                + (∑ c' : Fin W with d ≤ c'.val ∧ c'.val < 2 * d, f c')
                + (∑ c' : Fin W with 2 * d ≤ c'.val, f c') := by
              have hsplit1 := Finset.sum_filter_add_sum_filter_not (Finset.univ : Finset (Fin W))
                  (fun c' : Fin W => c'.val < d) f
              rw [← hsplit1, add_assoc]
              congr 1
              have hsplit2 := Finset.sum_filter_add_sum_filter_not
                  (Finset.univ.filter (fun c' : Fin W => ¬ c'.val < d))
                  (fun c' : Fin W => d ≤ c'.val ∧ c'.val < 2 * d) f
              rw [← hsplit2]
              have hf1' : (Finset.univ.filter (fun c' : Fin W => ¬ c'.val < d)).filter
                  (fun c' : Fin W => d ≤ c'.val ∧ c'.val < 2 * d)
                  = Finset.univ.filter (fun c' : Fin W => d ≤ c'.val ∧ c'.val < 2 * d) := by
                rw [Finset.filter_filter]
                apply Finset.filter_congr
                intro c' hc'
                constructor
                · intro h
                  exact h.2
                · intro h
                  exact ⟨by omega, h⟩
              have hf2' : (Finset.univ.filter (fun c' : Fin W => ¬ c'.val < d)).filter
                  (fun c' : Fin W => ¬ (d ≤ c'.val ∧ c'.val < 2 * d))
                  = Finset.univ.filter (fun c' : Fin W => 2 * d ≤ c'.val) := by
                rw [Finset.filter_filter]
                apply Finset.filter_congr
                intro c' hc'
                constructor
                · intro h
                  omega
                · intro h
                  constructor <;> omega
              rw [hf1', hf2']
            calc
              (∑ c' : Fin W, inLayer.weight (wEnc t') c' * state x p n w c')
                  = (∑ c' : Fin W, f c') := by rfl
              _ = (∑ c' : Fin W with c'.val < d, f c')
                  + (∑ c' : Fin W with d ≤ c'.val ∧ c'.val < 2 * d, f c')
                  + (∑ c' : Fin W with 2 * d ≤ c'.val, f c') := hsplit
              _ = (∑ c' : Fin W with c'.val < d, f c')
                  + (∑ c' : Fin W with d ≤ c'.val ∧ c'.val < 2 * d, f c')
                  + 0 := by
                have hz : (∑ c' : Fin W with 2 * d ≤ c'.val, f c') = 0 := by
                  apply Finset.sum_eq_zero
                  intro c' hc'
                  exact hf3 c' (by simpa using (Finset.mem_filter.mp hc').2)
                rw [hz]
              _ = (∑ j : Fin d, A j * relu (x j))
                  + (∑ j : Fin d, -(A j) * relu (-(x j))) + 0 := by
                have hr1 : (∑ c' : Fin W with c'.val < d, f c') = (∑ j : Fin d, A j * relu (x j)) := by
                  calc
                    (∑ c' : Fin W with c'.val < d, f c') = (∑ j : Fin d, f ⟨j.val, by omega⟩) := by
                      let s : Finset (Fin W) := Finset.univ.filter (fun c' : Fin W => c'.val < d)
                      let hmem : ∀ a : Fin W, a ∈ s → a.val < d :=
                        fun a ha => by simpa [s] using (Finset.mem_filter.mp ha).2
                      let i : (a : Fin W) → a ∈ s → Fin d := fun a ha => ⟨a.val, hmem a ha⟩
                      change (∑ c' ∈ s, f c') = (∑ j : Fin d, f ⟨j.val, by omega⟩)
                      refine Finset.sum_bij i ?_ ?_ ?_ ?_
                      · intro a ha
                        simp
                      · intro a₁ ha₁ a₂ ha₂ h
                        apply Fin.ext
                        have hv : (i a₁ ha₁).val = (i a₂ ha₂).val := congrArg Fin.val h
                        simpa [i, hmem] using hv
                      · intro b hb
                        refine ⟨⟨b.val, by omega⟩, ?_, ?_⟩
                        · simp [s]
                        · dsimp [i, hmem]
                      · intro a ha
                        have hval : (i a ha).val = a.val := by
                          dsimp [i, hmem]
                        congr 1
                    _ = (∑ j : Fin d, A j * relu (x j)) := by
                      apply Finset.sum_congr rfl
                      intro j hj
                      simpa [A] using hf1 ⟨j.val, by omega⟩ j.isLt
                have hr2 : (∑ c' : Fin W with d ≤ c'.val ∧ c'.val < 2 * d, f c')
                    = (∑ j : Fin d, -(A j) * relu (-(x j))) := by
                  calc
                    (∑ c' : Fin W with d ≤ c'.val ∧ c'.val < 2 * d, f c')
                        = (∑ j : Fin d, f ⟨d + j.val, by omega⟩) := by
                      let s : Finset (Fin W) := Finset.univ.filter (fun c' : Fin W => d ≤ c'.val ∧ c'.val < 2 * d)
                      let hmem : ∀ a : Fin W, a ∈ s → a.val - d < d :=
                        fun a ha => by
                          have h := (Finset.mem_filter.mp ha).2
                          omega
                      let i : (a : Fin W) → a ∈ s → Fin d := fun a ha => ⟨a.val - d, hmem a ha⟩
                      change (∑ c' ∈ s, f c') = (∑ j : Fin d, f ⟨d + j.val, by omega⟩)
                      refine Finset.sum_bij i ?_ ?_ ?_ ?_
                      · intro a ha
                        simp
                      · intro a₁ ha₁ a₂ ha₂ h
                        apply Fin.ext
                        have hv : (i a₁ ha₁).val = (i a₂ ha₂).val := congrArg Fin.val h
                        have h1 : a₁.val = (a₁.val - d) + d := by
                          have hd : d ≤ a₁.val := by
                            have h := (Finset.mem_filter.mp ha₁).2
                            omega
                          omega
                        have h2 : a₂.val = (a₂.val - d) + d := by
                          have hd : d ≤ a₂.val := by
                            have h := (Finset.mem_filter.mp ha₂).2
                            omega
                          omega
                        calc
                          a₁.val = (a₁.val - d) + d := h1
                          _ = (a₂.val - d) + d := by
                            dsimp [i, hmem] at hv
                            rw [hv]
                          _ = a₂.val := h2.symm
                      · intro b hb
                        refine ⟨⟨d + b.val, by omega⟩, ?_, ?_⟩
                        · simp [s]
                          omega
                        · dsimp [i, hmem]
                          apply Fin.ext
                          simp
                      · intro a ha
                        have hval : (i a ha).val = a.val - d := by
                          dsimp [i, hmem]
                        have hd : d ≤ a.val := (Finset.mem_filter.mp ha).2.1
                        congr 1
                        apply Fin.ext
                        change a.val = d + (i a ha).val
                        rw [hval]
                        omega
                    _ = (∑ j : Fin d, -(A j) * relu (-(x j))) := by
                      apply Finset.sum_congr rfl
                      intro j hj
                      have hjd : j.val < d := j.isLt
                      simpa [A] using hf2 ⟨d + j.val, by omega⟩ (by constructor <;> dsimp <;> omega)
                rw [hr1, hr2]
              _ = (∑ j : Fin d, (wit i).input.weight t' j * x j) := by
                have hcomb : (∑ j : Fin d, A j * relu (x j)) + (∑ j : Fin d, -(A j) * relu (-(x j))) + 0
                    = (∑ j : Fin d, A j * x j) := by
                  rw [add_zero]
                  calc
                    (∑ j : Fin d, A j * relu (x j)) + (∑ j : Fin d, -(A j) * relu (-(x j)))
                        = (∑ j : Fin d, A j * relu (x j)) - (∑ j : Fin d, A j * relu (-(x j))) := by
                          have hneg : (∑ j : Fin d, -(A j) * relu (-(x j))) = -(∑ j : Fin d, A j * relu (-(x j))) := by
                            calc
                              (∑ j : Fin d, -(A j) * relu (-(x j))) = (∑ j : Fin d, -(A j * relu (-(x j)))) := by
                                apply Finset.sum_congr rfl
                                intro j hj
                                ring
                              _ = -(∑ j : Fin d, A j * relu (-(x j))) := by
                                rw [Finset.sum_neg_distrib]
                          rw [hneg]
                          ring
                    _ = (∑ j : Fin d, A j * (relu (x j) - relu (-(x j)))) := by
                          rw [← Finset.sum_sub_distrib]
                          apply Finset.sum_congr rfl
                          intro j hj
                          ring
                    _ = (∑ j : Fin d, A j * x j) := by
                          apply Finset.sum_congr rfl
                          intro j hj
                          rw [hrelu_sub (x j)]
                simpa [A] using hcomb
          rw [hsum, hbias]
        have hnonneg_all : ∀ t : ℕ, ∀ c : Fin W, 0 ≤ B.hiddenState (state x p n w) t c := by
          intro t
          induction t with
          | zero =>
              intro c
              change 0 ≤ inLayer.reluApply (state x p n w) c
              unfold DenseLayer.reluApply reluVec

              exact hrelu_nonneg (inLayer.apply (state x p n w) c)
          | succ t ih =>
              intro c
              by_cases ht : t < B.depth - 1
              · have hv : B.hiddenState (state x p n w) (t + 1) c =
                    (B.hidden ⟨t, ht⟩).reluApply (B.hiddenState (state x p n w) t) c := by
                  simp [FullyConnectedReLUNet.hiddenState, ht]
                rw [hv]
                unfold DenseLayer.reluApply reluVec

                exact hrelu_nonneg ((B.hidden ⟨t, ht⟩).apply (B.hiddenState (state x p n w) t) c)
              · have hv : B.hiddenState (state x p n w) (t + 1) c = B.hiddenState (state x p n w) t c := by
                  simp [FullyConnectedReLUNet.hiddenState, ht]
                rw [hv]
                exact ih c
        have hsim (t : ℕ) (t' : Fin wW) :
            B.hiddenState (state x p n w) t (wEnc t') = (wit i).hiddenState x t t' := by
          revert t'
          induction t with
          | zero =>
              intro t'
              simp [B, hinput_work t', FullyConnectedReLUNet.hiddenState]
          | succ t ih =>
              intro t'
              by_cases htW : t < (wit i).depth - 1
              · have htB : t < B.depth - 1 := by
                  have hd_le' : (wit i).depth ≤ D0 := by
                    dsimp [wit]
                    exact hwd_le
                  simp [B]
                  omega
                have hBhid : B.hidden ⟨t, htB⟩ = witLayer ⟨t, htB⟩ htW := by
                  simp [B, hid, htW]
                have hrecB : B.hiddenState (state x p n w) (t + 1) (wEnc t') =
                    (witLayer ⟨t, htB⟩ htW).reluApply (B.hiddenState (state x p n w) t) (wEnc t') := by
                  simp [FullyConnectedReLUNet.hiddenState, htB, hBhid]
                have hrecW : (wit i).hiddenState x (t + 1) t' =
                    ((wit i).hidden ⟨t, htW⟩).reluApply ((wit i).hiddenState x t) t' := by
                  simp [FullyConnectedReLUNet.hiddenState, htW]
                rw [hrecB, hrecW]
                unfold DenseLayer.reluApply reluVec
                congr 1
                calc
                  (witLayer ⟨t, htB⟩ htW).apply (B.hiddenState (state x p n w) t) (wEnc t')
                      = ((wit i).hidden ⟨t, htW⟩).apply (fun j => B.hiddenState (state x p n w) t (wEnc j)) t' := by
                        exact hwitLayer_apply ⟨t, htB⟩ htW (B.hiddenState (state x p n w) t) t'
                  _ = ((wit i).hidden ⟨t, htW⟩).apply ((wit i).hiddenState x t) t' := by
                        congr 1
                        funext j
                        exact ih j
              · have hrecW : (wit i).hiddenState x (t + 1) t' = (wit i).hiddenState x t t' := by
                  simp [FullyConnectedReLUNet.hiddenState, htW]
                by_cases htB : t < B.depth - 1
                · have hBhid : B.hidden ⟨t, htB⟩ = rewLayer ∨ B.hidden ⟨t, htB⟩ = idLayer := by
                    by_cases htD : t = D0
                    · left
                      have htW' : ¬ D0 < (wit i).depth - 1 := by simpa [htD] using htW
                      simp [B, hid, htW', htD]
                    · right
                      simp [B, hid, htW, htD]
                  have hu : 0 ≤ B.hiddenState (state x p n w) t (wEnc t') := hnonneg_all t (wEnc t')
                  have hrecB : B.hiddenState (state x p n w) (t + 1) (wEnc t') =
                      (B.hidden ⟨t, htB⟩).reluApply (B.hiddenState (state x p n w) t) (wEnc t') := by
                    simp [FullyConnectedReLUNet.hiddenState, htB]
                  rw [hrecB, hrecW]
                  rcases hBhid with hBhid | hBhid
                  · rw [hBhid]
                    have hfix : rewLayer.reluApply (B.hiddenState (state x p n w) t) (wEnc t') =
                        B.hiddenState (state x p n w) t (wEnc t') := by
                      have hne1 : (wEnc t').val ≠ 2 * d := by
                        simp [wEnc]
                        omega
                      have hne2 : (wEnc t').val ≠ 2 * d + 1 := by
                        simp [wEnc]
                        omega
                      unfold DenseLayer.reluApply reluVec DenseLayer.apply
                      simp [rewLayer, hne1, hne2]
                      exact hrelu_of_nonneg hu
                    rw [hfix]
                    exact ih t'
                  · rw [hBhid]
                    have hfix : idLayer.reluApply (B.hiddenState (state x p n w) t) (wEnc t') =
                        B.hiddenState (state x p n w) t (wEnc t') := by
                      unfold DenseLayer.reluApply reluVec DenseLayer.apply
                      simp [idLayer]
                      exact hrelu_of_nonneg hu
                    rw [hfix]
                    exact ih t'
                · have hrecB : B.hiddenState (state x p n w) (t + 1) (wEnc t') =
                      B.hiddenState (state x p n w) t (wEnc t') := by
                    simp [FullyConnectedReLUNet.hiddenState, htB]
                  rw [hrecB, hrecW]
                  exact ih t'
        -- witness hidden state stabilizes after depth-1
        have hstab_step (n : ℕ) (hn : (wit i).depth - 1 ≤ n) :
            (wit i).hiddenState x (n + 1) = (wit i).hiddenState x n := by
          funext t'
          have hnot : ¬ n < (wit i).depth - 1 := by omega
          simp [FullyConnectedReLUNet.hiddenState, hnot]
        have hstab : (wit i).hiddenState x D0 = (wit i).hiddenState x ((wit i).depth - 1) := by
          have hge : (wit i).depth - 1 ≤ D0 := by
            dsimp [wit]
            omega
          let m := D0 - ((wit i).depth - 1)
          have hm : D0 = (wit i).depth - 1 + m := by
            dsimp [m]
            omega
          rw [hm]
          induction m with
          | zero => simp
          | succ m ih =>
              calc
                (wit i).hiddenState x ((wit i).depth - 1 + (m + 1))
                    = (wit i).hiddenState x (((wit i).depth - 1 + m) + 1) := by
                      congr 1

                _ = (wit i).hiddenState x ((wit i).depth - 1 + m) := by
                      exact hstab_step ((wit i).depth - 1 + m) (by omega)
                _ = (wit i).hiddenState x ((wit i).depth - 1) := ih
        -- ============ rewrite layer: p and n channels ============
        have hrew_p (u : Fin W → ℝ)
            (hu_p : u ⟨2 * d, by omega⟩ = p)
            (hu_n : u ⟨2 * d + 1, by omega⟩ = n)
            (hu_work : ∀ j : Fin wW, u (wEnc j) = (wit i).hiddenState x D0 j) :
            rewLayer.reluApply u ⟨2 * d, by omega⟩ = relu (p - n + coeff i * (wit i).realize x) := by
          unfold DenseLayer.reluApply reluVec

          congr 1
          unfold DenseLayer.apply
          have hbias : rewLayer.bias ⟨2 * d, by omega⟩ = coeff i * (wit i).outputBias := by
            simp [rewLayer]
          have hsum : (∑ c' : Fin W, rewLayer.weight ⟨2 * d, by omega⟩ c' * u c')
              = p - n + coeff i * (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j) := by
            let f : Fin W → ℝ := fun c' => rewLayer.weight ⟨2 * d, by omega⟩ c' * u c'
            have hf_point_p : f ⟨2 * d, by omega⟩ = p := by
              unfold f
              simp [rewLayer, hu_p]
            have hf_point_n : f ⟨2 * d + 1, by omega⟩ = -n := by
              unfold f
              simp [rewLayer, hu_n]
            have hf_work (c' : Fin W) (hw : isWork c') :
                f c' = coeff i * ((wit i).outputWeight (wDec c' hw)) * u c' := by
              unfold f
              have hne1 : c'.val ≠ 2 * d := by
                rcases hw with ⟨h1, h2⟩
                omega
              have hne2 : c'.val ≠ 2 * d + 1 := by
                rcases hw with ⟨h1, h2⟩
                omega
              simp [rewLayer, hne1, hne2, hw]
            have hf_else (c' : Fin W)
                (h1 : c'.val ≠ 2 * d) (h2 : c'.val ≠ 2 * d + 1) (h3 : ¬ isWork c') :
                f c' = 0 := by
              unfold f
              simp [rewLayer, h1, h2, h3]
            have hsummand (c' : Fin W) :
                (if (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c') then f c' else 0)
                  = (if c'.val = 2 * d then f c' else 0)
                    + (if c'.val = 2 * d + 1 then f c' else 0)
                    + (if isWork c' then f c' else 0) := by
              by_cases hA : c'.val = 2 * d
              · have hB : ¬ c'.val = 2 * d + 1 := by omega
                have hC : ¬ isWork c' := by
                  intro hw
                  rcases hw with ⟨h1, h2⟩
                  omega
                simp [hA, hB, hC]
              · by_cases hB : c'.val = 2 * d + 1
                · have hC : ¬ isWork c' := by
                    intro hw
                    rcases hw with ⟨h1, h2⟩
                    omega
                  simp [hA, hB, hC]
                · by_cases hC : isWork c'
                  · simp [hA, hB, hC]
                  · simp [hA, hB, hC]
            calc
              (∑ c' : Fin W, rewLayer.weight ⟨2 * d, by omega⟩ c' * u c')
                  = (∑ c' : Fin W, f c') := by rfl
              _ = (∑ c' : Fin W with (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'), f c') := by
                rw [Finset.sum_filter]
                apply Finset.sum_congr rfl
                intro c' hc'
                by_cases hp : c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'
                · simp [hp]
                · have h1 : c'.val ≠ 2 * d := by
                    intro h
                    exact hp (Or.inl h)
                  have h2 : c'.val ≠ 2 * d + 1 := by
                    intro h
                    exact hp (Or.inr (Or.inl h))
                  have h3 : ¬ isWork c' := by
                    intro h
                    exact hp (Or.inr (Or.inr h))
                  rw [hf_else c' h1 h2 h3]
                  simp [hp]
              _ = p + (-n) + (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                calc
                  (∑ c' : Fin W with (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'), f c')
                      = (∑ c' : Fin W, (if c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c' then f c' else 0)) := by
                        rw [Finset.sum_filter]
                  _ = (∑ c' : Fin W, ((if c'.val = 2 * d then f c' else 0) + (if c'.val = 2 * d + 1 then f c' else 0) + (if isWork c' then f c' else 0))) := by
                        apply Finset.sum_congr rfl
                        intro c' hc'
                        exact hsummand c'
                  _ = (∑ c' : Fin W, if c'.val = 2 * d then f c' else 0) + (∑ c' : Fin W, if c'.val = 2 * d + 1 then f c' else 0) + (∑ c' : Fin W, if isWork c' then f c' else 0) := by
                        rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
                  _ = f ⟨2 * d, by omega⟩ + f ⟨2 * d + 1, by omega⟩ + (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                        have hA : (∑ c' : Fin W, if c'.val = 2 * d then f c' else 0) = f ⟨2 * d, by omega⟩ := by
                          have hrewrite : (fun c' : Fin W => if c'.val = 2 * d then f c' else 0)
                              = fun c' : Fin W => if c' = ⟨2 * d, by omega⟩ then f c' else 0 := by
                            funext c'
                            by_cases h : c'.val = 2 * d
                            · have h' : c' = ⟨2 * d, by omega⟩ := by
                                apply Fin.ext
                                simpa using h
                              simp [h, h']
                            · have h' : c' ≠ ⟨2 * d, by omega⟩ := by
                                intro hc
                                apply h
                                simpa using congrArg Fin.val hc
                              simp [h, h']
                          rw [hrewrite]
                          simp
                        have hB : (∑ c' : Fin W, if c'.val = 2 * d + 1 then f c' else 0) = f ⟨2 * d + 1, by omega⟩ := by
                          have hrewrite : (fun c' : Fin W => if c'.val = 2 * d + 1 then f c' else 0)
                              = fun c' : Fin W => if c' = ⟨2 * d + 1, by omega⟩ then f c' else 0 := by
                            funext c'
                            by_cases h : c'.val = 2 * d + 1
                            · have h' : c' = ⟨2 * d + 1, by omega⟩ := by
                                apply Fin.ext
                                simpa using h
                              simp [h, h']
                            · have h' : c' ≠ ⟨2 * d + 1, by omega⟩ := by
                                intro hc
                                apply h
                                simpa using congrArg Fin.val hc
                              simp [h, h']
                          rw [hrewrite]
                          simp
                        have hC : (∑ c' : Fin W, if isWork c' then f c' else 0)
                            = (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                          calc
                            (∑ c' : Fin W, if isWork c' then f c' else 0)
                                = (∑ c' : Fin W, if hcw : isWork c' then coeff i * ((wit i).outputWeight (wDec c' hcw)) * u c' else 0) := by
                                  apply Finset.sum_congr rfl
                                  intro c' hc'
                                  by_cases hw : isWork c'
                                  · simp [hw, hf_work c' hw]
                                  · simp [hw]
                            _ = (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                                  have hwsum := hwork_sum
                                    (fun c' : Fin W => if hcw : isWork c' then coeff i * ((wit i).outputWeight (wDec c' hcw)) * u c' else 0)
                                    (by intro c' hnot; simp [hnot])
                                  calc
                                    (∑ c' : Fin W, if hcw : isWork c' then coeff i * ((wit i).outputWeight (wDec c' hcw)) * u c' else 0)
                                        = (∑ j : Fin wW, (if hcw : isWork (wEnc j) then coeff i * ((wit i).outputWeight (wDec (wEnc j) hcw)) * u (wEnc j) else 0)) := hwsum
                                    _ = (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                                          apply Finset.sum_congr rfl
                                          intro j hj
                                          simp [hwEnc_work j, hwDec_wEnc j]
                        rw [hA, hB, hC]
                  _ = p + (-n) + (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j)) := by
                        rw [hf_point_p, hf_point_n]
              _ = p - n + coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j)) := by
                have hS : (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j))
                    = coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j)) := by
                  calc
                    (∑ j : Fin wW, coeff i * ((wit i).outputWeight j) * u (wEnc j))
                        = (∑ j : Fin wW, coeff i * ((wit i).outputWeight j * u (wEnc j))) := by
                          apply Finset.sum_congr rfl
                          intro j hj
                          ring
                    _ = coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j)) := by
                          rw [Finset.mul_sum]
                rw [hS]
                ring
              _ = p - n + coeff i * (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j) := by
                simp [hu_work]
          rw [hsum, hbias]
          rw [FullyConnectedReLUNet.realize]
          have hS : (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j)
              = (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x ((wit i).depth - 1) j) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [hstab]
          rw [hS]
          ring
        have hrew_n (u : Fin W → ℝ)
            (hu_p : u ⟨2 * d, by omega⟩ = p)
            (hu_n : u ⟨2 * d + 1, by omega⟩ = n)
            (hu_work : ∀ j : Fin wW, u (wEnc j) = (wit i).hiddenState x D0 j) :
            rewLayer.reluApply u ⟨2 * d + 1, by omega⟩ = relu (n - p - coeff i * (wit i).realize x) := by
          unfold DenseLayer.reluApply reluVec

          congr 1
          unfold DenseLayer.apply
          have hbias : rewLayer.bias ⟨2 * d + 1, by omega⟩ = -(coeff i * (wit i).outputBias) := by
            simp [rewLayer]
          have hsum : (∑ c' : Fin W, rewLayer.weight ⟨2 * d + 1, by omega⟩ c' * u c')
              = n - p - coeff i * (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j) := by
            let f : Fin W → ℝ := fun c' => rewLayer.weight ⟨2 * d + 1, by omega⟩ c' * u c'
            have hf_point_p : f ⟨2 * d, by omega⟩ = -p := by
              unfold f
              simp [rewLayer, hu_p]
            have hf_point_n : f ⟨2 * d + 1, by omega⟩ = n := by
              unfold f
              simp [rewLayer, hu_n]
            have hf_work (c' : Fin W) (hw : isWork c') :
                f c' = -(coeff i * ((wit i).outputWeight (wDec c' hw))) * u c' := by
              unfold f
              have hne1 : c'.val ≠ 2 * d := by
                rcases hw with ⟨h1, h2⟩
                omega
              have hne2 : c'.val ≠ 2 * d + 1 := by
                rcases hw with ⟨h1, h2⟩
                omega
              simp [rewLayer, hne1, hne2, hw]
            have hf_else (c' : Fin W)
                (h1 : c'.val ≠ 2 * d) (h2 : c'.val ≠ 2 * d + 1) (h3 : ¬ isWork c') :
                f c' = 0 := by
              unfold f
              simp [rewLayer, h1, h2, h3]
            have hsummand (c' : Fin W) :
                (if (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c') then f c' else 0)
                  = (if c'.val = 2 * d then f c' else 0)
                    + (if c'.val = 2 * d + 1 then f c' else 0)
                    + (if isWork c' then f c' else 0) := by
              by_cases hA : c'.val = 2 * d
              · have hB : ¬ c'.val = 2 * d + 1 := by omega
                have hC : ¬ isWork c' := by
                  intro hw
                  rcases hw with ⟨h1, h2⟩
                  omega
                simp [hA, hB, hC]
              · by_cases hB : c'.val = 2 * d + 1
                · have hC : ¬ isWork c' := by
                    intro hw
                    rcases hw with ⟨h1, h2⟩
                    omega
                  simp [hA, hB, hC]
                · by_cases hC : isWork c'
                  · simp [hA, hB, hC]
                  · simp [hA, hB, hC]
            calc
              (∑ c' : Fin W, rewLayer.weight ⟨2 * d + 1, by omega⟩ c' * u c')
                  = (∑ c' : Fin W, f c') := by rfl
              _ = (∑ c' : Fin W with (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'), f c') := by
                rw [Finset.sum_filter]
                apply Finset.sum_congr rfl
                intro c' hc'
                by_cases hp : c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'
                · simp [hp]
                · have h1 : c'.val ≠ 2 * d := by
                    intro h
                    exact hp (Or.inl h)
                  have h2 : c'.val ≠ 2 * d + 1 := by
                    intro h
                    exact hp (Or.inr (Or.inl h))
                  have h3 : ¬ isWork c' := by
                    intro h
                    exact hp (Or.inr (Or.inr h))
                  rw [hf_else c' h1 h2 h3]
                  simp [hp]
              _ = (-p) + n + (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                calc
                  (∑ c' : Fin W with (c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c'), f c')
                      = (∑ c' : Fin W, (if c'.val = 2 * d ∨ c'.val = 2 * d + 1 ∨ isWork c' then f c' else 0)) := by
                        rw [Finset.sum_filter]
                  _ = (∑ c' : Fin W, ((if c'.val = 2 * d then f c' else 0) + (if c'.val = 2 * d + 1 then f c' else 0) + (if isWork c' then f c' else 0))) := by
                        apply Finset.sum_congr rfl
                        intro c' hc'
                        exact hsummand c'
                  _ = (∑ c' : Fin W, if c'.val = 2 * d then f c' else 0) + (∑ c' : Fin W, if c'.val = 2 * d + 1 then f c' else 0) + (∑ c' : Fin W, if isWork c' then f c' else 0) := by
                        rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
                  _ = f ⟨2 * d, by omega⟩ + f ⟨2 * d + 1, by omega⟩ + (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                        have hA : (∑ c' : Fin W, if c'.val = 2 * d then f c' else 0) = f ⟨2 * d, by omega⟩ := by
                          have hrewrite : (fun c' : Fin W => if c'.val = 2 * d then f c' else 0)
                              = fun c' : Fin W => if c' = ⟨2 * d, by omega⟩ then f c' else 0 := by
                            funext c'
                            by_cases h : c'.val = 2 * d
                            · have h' : c' = ⟨2 * d, by omega⟩ := by
                                apply Fin.ext
                                simpa using h
                              simp [h, h']
                            · have h' : c' ≠ ⟨2 * d, by omega⟩ := by
                                intro hc
                                apply h
                                simpa using congrArg Fin.val hc
                              simp [h, h']
                          rw [hrewrite]
                          simp
                        have hB : (∑ c' : Fin W, if c'.val = 2 * d + 1 then f c' else 0) = f ⟨2 * d + 1, by omega⟩ := by
                          have hrewrite : (fun c' : Fin W => if c'.val = 2 * d + 1 then f c' else 0)
                              = fun c' : Fin W => if c' = ⟨2 * d + 1, by omega⟩ then f c' else 0 := by
                            funext c'
                            by_cases h : c'.val = 2 * d + 1
                            · have h' : c' = ⟨2 * d + 1, by omega⟩ := by
                                apply Fin.ext
                                simpa using h
                              simp [h, h']
                            · have h' : c' ≠ ⟨2 * d + 1, by omega⟩ := by
                                intro hc
                                apply h
                                simpa using congrArg Fin.val hc
                              simp [h, h']
                          rw [hrewrite]
                          simp
                        have hC : (∑ c' : Fin W, if isWork c' then f c' else 0)
                            = (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                          calc
                            (∑ c' : Fin W, if isWork c' then f c' else 0)
                                = (∑ c' : Fin W, if hcw : isWork c' then -(coeff i * ((wit i).outputWeight (wDec c' hcw))) * u c' else 0) := by
                                  apply Finset.sum_congr rfl
                                  intro c' hc'
                                  by_cases hw : isWork c'
                                  · simp [hw, hf_work c' hw]
                                  · simp [hw]
                            _ = (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                                  have hwsum := hwork_sum
                                    (fun c' : Fin W => if hcw : isWork c' then -(coeff i * ((wit i).outputWeight (wDec c' hcw))) * u c' else 0)
                                    (by intro c' hnot; simp [hnot])
                                  calc
                                    (∑ c' : Fin W, if hcw : isWork c' then -(coeff i * ((wit i).outputWeight (wDec c' hcw))) * u c' else 0)
                                        = (∑ j : Fin wW, (if hcw : isWork (wEnc j) then -(coeff i * ((wit i).outputWeight (wDec (wEnc j) hcw))) * u (wEnc j) else 0)) := hwsum
                                    _ = (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                                          apply Finset.sum_congr rfl
                                          intro j hj
                                          simp [hwEnc_work j, hwDec_wEnc j]
                        rw [hA, hB, hC]
                  _ = (-p) + n + (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j)) := by
                        rw [hf_point_p, hf_point_n]
              _ = n - p - coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j)) := by
                have hS : (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j))
                    = -(coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j))) := by
                  calc
                    (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j)) * u (wEnc j))
                        = (∑ j : Fin wW, -(coeff i * ((wit i).outputWeight j * u (wEnc j)))) := by
                          apply Finset.sum_congr rfl
                          intro j hj
                          ring
                    _ = -(∑ j : Fin wW, coeff i * ((wit i).outputWeight j * u (wEnc j))) := by
                          rw [Finset.sum_neg_distrib]
                    _ = -(coeff i * (∑ j : Fin wW, (wit i).outputWeight j * u (wEnc j))) := by
                          rw [Finset.mul_sum]
                rw [hS]
                ring
              _ = n - p - coeff i * (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j) := by
                simp [hu_work]
          rw [hsum, hbias]
          rw [FullyConnectedReLUNet.realize]
          have hS : (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x D0 j)
              = (∑ j : Fin wW, (wit i).outputWeight j * (wit i).hiddenState x ((wit i).depth - 1) j) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [hstab]
          rw [hS]
          ring
        -- ============ last layer and final case split ============
        have hD0_lt : D0 < B.depth - 1 := by
          simp [B]

        have hBhid_D0 : B.hidden ⟨D0, hD0_lt⟩ = rewLayer := by
          have hnot : ¬ D0 < (wit i).depth - 1 := by
            dsimp [wit]
            omega
          simp [B, hid, hnot]
        have hu_D0_p : B.hiddenState (state x p n w) D0 ⟨2 * d, by dsimp [B]; omega⟩ = p := by
          have hc : isState ⟨2 * d, by omega⟩ := by
            simp [isState]

          have hs := hpres ⟨2 * d, by omega⟩ (Or.inl hc) D0 (by omega)
          have hnot1 : ¬ 2 * d < d := by omega
          have hnot2 : ¬ 2 * d < 2 * d := by omega
          simpa [state, hnot1, hnot2] using hs
        have hu_D0_n : B.hiddenState (state x p n w) D0 ⟨2 * d + 1, by dsimp [B]; omega⟩ = n := by
          have hc : isState ⟨2 * d + 1, by omega⟩ := by
            simp [isState]

          have hs := hpres ⟨2 * d + 1, by omega⟩ (Or.inl hc) D0 (by omega)
          have hnot1 : ¬ 2 * d + 1 < d := by omega
          have hnot2 : ¬ 2 * d + 1 < 2 * d := by omega
          have hnot3 : ¬ 2 * d + 1 = 2 * d := by omega
          simpa [state, hnot1, hnot2, hnot3] using hs
        have hu_D0_work (j : Fin wW) :
            B.hiddenState (state x p n w) D0 (wEnc j) = (wit i).hiddenState x D0 j := hsim D0 j
        rcases hk with hk1 | hk2 | hk3 | hk4
        · -- k in the x-pair channels
          have hc : isState k := Or.inl hk1
          have hk_rew : k.val ≠ 2 * d ∧ k.val ≠ 2 * d + 1 := hx_rew k hk1
          have hu : 0 ≤ B.hiddenState (state x p n w) D0 k := by
            rw [hpres k (Or.inl hc) D0 (by omega)]
            exact hs_nonneg k (Or.inl hc)
          have hstep : B.hiddenState (state x p n w) (D0 + 1) k =
              rewLayer.reluApply (B.hiddenState (state x p n w) D0) k := by
            have hv : B.hiddenState (state x p n w) (D0 + 1) k =
                (B.hidden ⟨D0, hD0_lt⟩).reluApply (B.hiddenState (state x p n w) D0) k := by
              simp [FullyConnectedReLUNet.hiddenState, hD0_lt]
            rw [hv, hBhid_D0]
          rw [hstep]
          have hfix : rewLayer.reluApply (B.hiddenState (state x p n w) D0) k =
              B.hiddenState (state x p n w) D0 k := by
            exact hrewLayer_pres (B.hiddenState (state x p n w) D0) k hk_rew.1 hk_rew.2 hu
          rw [hfix, hpres k (Or.inl hc) D0 (by omega)]
          by_cases hx : k.val < d
          · simp [state, hx]
          · simp [state, hx, hk1]
        · -- k = 2d (p channel)
          have hkp : k = ⟨2 * d, by omega⟩ := by
            apply Fin.ext
            simpa using hk2
          rw [hkp]
          have hstep : B.hiddenState (state x p n w) (D0 + 1) ⟨2 * d, by omega⟩ =
              rewLayer.reluApply (B.hiddenState (state x p n w) D0) ⟨2 * d, by omega⟩ := by
            have hv : B.hiddenState (state x p n w) (D0 + 1) ⟨2 * d, by omega⟩ =
                (B.hidden ⟨D0, hD0_lt⟩).reluApply (B.hiddenState (state x p n w) D0) ⟨2 * d, by omega⟩ := by
              simp [FullyConnectedReLUNet.hiddenState, hD0_lt]
            rw [hv, hBhid_D0]
          rw [hstep]
          have hrew := hrew_p (B.hiddenState (state x p n w) D0) hu_D0_p hu_D0_n hu_D0_work
          rw [hrew]
          simp [state]
          intro h
          exfalso
          omega
        · -- k = 2d+1 (n channel)
          have hkp : k = ⟨2 * d + 1, by omega⟩ := by
            apply Fin.ext
            simpa using hk3
          rw [hkp]
          have hstep : B.hiddenState (state x p n w) (D0 + 1) ⟨2 * d + 1, by omega⟩ =
              rewLayer.reluApply (B.hiddenState (state x p n w) D0) ⟨2 * d + 1, by omega⟩ := by
            have hv : B.hiddenState (state x p n w) (D0 + 1) ⟨2 * d + 1, by omega⟩ =
                (B.hidden ⟨D0, hD0_lt⟩).reluApply (B.hiddenState (state x p n w) D0) ⟨2 * d + 1, by omega⟩ := by
              simp [FullyConnectedReLUNet.hiddenState, hD0_lt]
            rw [hv, hBhid_D0]
          rw [hstep]
          have hrew := hrew_n (B.hiddenState (state x p n w) D0) hu_D0_p hu_D0_n hu_D0_work
          rw [hrew]
          simp [state]
          intro h
          exfalso
          omega
        · -- slack channel
          have hk_rew : k.val ≠ 2 * d ∧ k.val ≠ 2 * d + 1 := hslack_rew k hk4
          have hu : 0 ≤ B.hiddenState (state x p n w) D0 k := by
            rw [hpres k (Or.inr hk4) D0 (by omega)]
            exact hs_nonneg k (Or.inr hk4)
          have hstep : B.hiddenState (state x p n w) (D0 + 1) k =
              rewLayer.reluApply (B.hiddenState (state x p n w) D0) k := by
            have hv : B.hiddenState (state x p n w) (D0 + 1) k =
                (B.hidden ⟨D0, hD0_lt⟩).reluApply (B.hiddenState (state x p n w) D0) k := by
              simp [FullyConnectedReLUNet.hiddenState, hD0_lt]
            rw [hv, hBhid_D0]
          rw [hstep]
          have hfix : rewLayer.reluApply (B.hiddenState (state x p n w) D0) k =
              B.hiddenState (state x p n w) D0 k := by
            exact hrewLayer_pres (B.hiddenState (state x p n w) D0) k hk_rew.1 hk_rew.2 hu
          rw [hfix, hpres k (Or.inr hk4) D0 (by omega)]
          have hz1 : state x p n w k = 0 := by
            have h1 : ¬ k.val < d := by omega
            have h2 : ¬ k.val < 2 * d := by omega
            have h3 : ¬ k.val = 2 * d := by omega
            have h4 : ¬ k.val = 2 * d + 1 := by omega
            have h5 : ¬ k.val < 2 * d + 2 + W0 := by omega
            simp [state, h1, h2, h3, h4, h5]
          have hz2 : state x (relu (p - n + coeff i * (wit i).realize x))
              (relu (n - p - coeff i * (wit i).realize x)) w k = 0 := by
            have h1 : ¬ k.val < d := by omega
            have h2 : ¬ k.val < 2 * d := by omega
            have h3 : ¬ k.val = 2 * d := by omega
            have h4 : ¬ k.val = 2 * d + 1 := by omega
            have h5 : ¬ k.val < 2 * d + 2 + W0 := by omega
            simp [state, h1, h2, h3, h4, h5]
          rw [hz1, hz2]
  -- @step s3: serial-splice blocks to one network with depth 1 + |ι|*(D0+1), width W
  have hsplice : ∃ N : FullyConnectedReLUNet d,
      N.depth = 1 + Fintype.card ι * (D0 + 1) ∧
      N.width = W ∧
      N.parameterCount ≤ fullyConnectedReLUParameterCount d (1 + Fintype.card ι * (D0 + 1)) W ∧
      ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * (wit i).realize x := by
    -- @step s1: construct the spliced network N with depth 1 + |ι|*(D0+1) and width W
    have hN : ∃ N : FullyConnectedReLUNet d,
        N.depth = 1 + Fintype.card ι * (D0 + 1) ∧ N.width = W := by
      let c : ℕ := Fintype.card ι
      let hc : ℕ := D0 + 1
      let blk : ι → FullyConnectedReLUNet W := fun i => Classical.choose (hblock i)
      have hblk_w : ∀ i, (blk i).width = W := by
        intro i
        exact (Classical.choose_spec (hblock i)).1
      have hblk_d : ∀ i, (blk i).depth = D0 + 2 := by
        intro i
        exact (Classical.choose_spec (hblock i)).2.1
      let layerOf : (i : ι) → Fin hc → DenseLayer W W :=
        fun i l =>
          by
            have hd : (blk i).depth - 1 = hc := by
              rw [hblk_d i]
              omega
            have hl : Fin ((blk i).depth - 1) := by
              rw [hd]
              exact l
            rw [← hblk_w i]
            exact (blk i).hidden hl
      let hidden : Fin (c * hc) → DenseLayer W W :=
        fun k =>
          let jl : Fin c × Fin hc := (finProdFinEquiv (m := c) (n := hc)).symm k
          layerOf ((Fintype.equivFin ι).symm jl.1) jl.2
      let inputWeight : Fin W → Fin d → ℝ :=
        fun k j =>
          if k.val < d then (if j.val = k.val then 1 else 0)
          else if k.val < 2 * d then (if j.val = k.val - d then -1 else 0)
          else 0
      let outputWeight : Fin W → ℝ :=
        fun k => if k.val = 2 * d then 1 else if k.val = 2 * d + 1 then -1 else 0
      let N : FullyConnectedReLUNet d :=
        { depth := c * hc + 1
          width := W
          input := { weight := inputWeight, bias := 0 }
          hidden := hidden
          outputWeight := outputWeight
          outputBias := 0 }
      refine ⟨N, ?hDepth, ?hWidth⟩
      · change c * hc + 1 = 1 + c * hc
        omega
      · rfl
    -- @step s2: accumulator invariant over the first k blocks ⇒ realize equality for N
    have hrealize : ∃ N : FullyConnectedReLUNet d,
        N.depth = 1 + Fintype.card ι * (D0 + 1) ∧ N.width = W ∧
        ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * (wit i).realize x := by
      -- @step s1: fix the spliced network N from hN: record depth/width, the accumulator invariant over the first k blocks, and the output combiner structure
      have hNspec : ∃ N : FullyConnectedReLUNet d,
          ∃ hNw : N.width = W,
            N.depth = 1 + Fintype.card ι * (D0 + 1) ∧
            (∀ x : Fin d → ℝ, ∀ k : ℕ, k ≤ Fintype.card ι →
              let S : ℝ := ∑ i : ι, if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0;
              ∀ k' : Fin N.width,
                (k'.val < 2 * d ∨ k'.val = 2 * d ∨ k'.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ k'.val) →
                N.hiddenState x (k * (D0 + 1)) k' =
                  state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw k')) ∧
            N.outputBias = 0 ∧
            (∀ k : Fin N.width, N.outputWeight k =
              if k.val = 2 * d then 1 else if k.val = 2 * d + 1 then -1 else 0) := by
        let c : ℕ := Fintype.card ι
        let hc : ℕ := D0 + 1
        let blk : ι → FullyConnectedReLUNet W := fun i => Classical.choose (hblock i)
        have hblk_w : ∀ i : ι, (blk i).width = W := by
          intro i
          exact (Classical.choose_spec (hblock i)).1
        have hblk_d : ∀ i : ι, (blk i).depth = D0 + 2 := by
          intro i
          exact (Classical.choose_spec (hblock i)).2.1
        let layerOf : (i : ι) → Fin hc → DenseLayer W W := fun i l => by
          by_cases hl0 : l.val = 0
          · exact (cast (by rw [hblk_w i]) (blk i).input)
          · by_cases hlast : l.val + 1 = hc
            · -- last slot: the block's final hidden layer (the accumulator rewrite layer)
              have hl : Fin ((blk i).depth - 1) := ⟨l.val, by
                rw [hblk_d i]
                omega⟩
              exact (cast (by rw [hblk_w i]) ((blk i).hidden hl))
            · -- interior slot: hidden layer t-1 of the block
              have hl : Fin ((blk i).depth - 1) := ⟨l.val - 1, by
                rw [hblk_d i]
                omega⟩
              exact (cast (by rw [hblk_w i]) ((blk i).hidden hl))
        let hidden : Fin (c * hc) → DenseLayer W W := fun k =>
          let jl : Fin c × Fin hc := (finProdFinEquiv (m := c) (n := hc)).symm k
          layerOf ((Fintype.equivFin ι).symm jl.1) jl.2
        let inputWeight : Fin W → Fin d → ℝ := fun k j =>
          if k.val < d then (if j.val = k.val then 1 else 0)
          else if k.val < 2 * d then (if j.val = k.val - d then -1 else 0)
          else 0
        let outputWeight : Fin W → ℝ :=
          fun k => if k.val = 2 * d then 1 else if k.val = 2 * d + 1 then -1 else 0
        let N : FullyConnectedReLUNet d :=
          { depth := c * hc + 1
            width := W
            input := { weight := inputWeight, bias := 0 }
            hidden := hidden
            outputWeight := outputWeight
            outputBias := 0 }
        let hNw : N.width = W := rfl
        have hNd : N.depth = 1 + Fintype.card ι * (D0 + 1) := by
          change c * hc + 1 = 1 + c * hc
          omega
        have hbias : N.outputBias = 0 := rfl
        have hweight : ∀ k : Fin N.width, N.outputWeight k =
            if k.val = 2 * d then 1 else if k.val = 2 * d + 1 then -1 else 0 := by
          intro k
          rfl
        have hinv : ∀ x : Fin d → ℝ, ∀ k : ℕ, k ≤ Fintype.card ι →
            let S : ℝ := ∑ i : ι, if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0;
            ∀ k' : Fin N.width,
              (k'.val < 2 * d ∨ k'.val = 2 * d ∨ k'.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ k'.val) →
              N.hiddenState x (k * (D0 + 1)) k' =
                state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw k') := by
          intro x k
          induction k with
          | zero =>
              intro hk0
              change ∀ k' : Fin N.width,
                (k'.val < 2 * d ∨ k'.val = 2 * d ∨ k'.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ k'.val) →
                N.hiddenState x (0 * (D0 + 1)) k' =
                  state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < 0 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < 0 then coeff i * (wit i).realize x else 0))) (fun _ => 0) (Fin.cast hNw k')
              have hinput0 : ∀ ch : Fin N.width,
                  N.input.reluApply x ch =
                    state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) := by
                intro ch
                have hcast_id : ∀ ch : Fin N.width, Fin.cast hNw ch = ch := by
                  intro ch
                  apply Fin.ext
                  rfl
                by_cases h1 : ch.val < d
                · -- coordinate channel: relu (x ⟨ch.val, h1⟩)
                  have hsum : (∑ j : Fin d, if j.val = ch.val then x j else 0) = x ⟨ch.val, h1⟩ := by
                    rw [Finset.sum_eq_single ⟨ch.val, h1⟩]
                    · simp
                    · intro j hj hne
                      have hjv : j.val ≠ ch.val := by
                        intro hv
                        apply hne
                        apply Fin.ext
                        exact hv
                      simp [hjv]
                    · intro hmem
                      exfalso
                      exact hmem (by simp)
                  have hlhs : N.input.reluApply x ch = relu (x ⟨ch.val, h1⟩) := by
                    simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, h1, add_zero, hsum]
                  have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = relu (x ⟨ch.val, h1⟩) := by
                    rw [hcast_id]
                    simp [state, h1]
                  rw [hlhs, hrhs]
                · by_cases h2 : ch.val < 2 * d
                  · -- relu(-x) coordinate channel
                    have hcd : ch.val - d < d := by omega
                    have hsum : (∑ j : Fin d, if j.val = ch.val - d then -x j else 0) = -x ⟨ch.val - d, hcd⟩ := by
                      rw [Finset.sum_eq_single ⟨ch.val - d, hcd⟩]
                      · simp
                      · intro j hj hne
                        have hjv : j.val ≠ ch.val - d := by
                          intro hv
                          apply hne
                          apply Fin.ext
                          exact hv
                        simp [hjv]
                      · intro hmem
                        exfalso
                        exact hmem (by simp)
                    have hlhs : N.input.reluApply x ch = relu (-(x ⟨ch.val - d, hcd⟩)) := by
                      simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, h1, h2, add_zero, hsum]
                    have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = relu (-(x ⟨ch.val - d, hcd⟩)) := by
                      rw [hcast_id]
                      simp [state, h1, h2]
                    rw [hlhs, hrhs]
                  · by_cases h3 : ch.val = 2 * d
                    · -- accumulator p channel
                      have hlhs : N.input.reluApply x ch = relu 0 := by
                        simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, h1, h2, add_zero]
                      have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = relu 0 := by
                        rw [hcast_id]
                        simp [state, h1, h2]
                        rw [h3]
                        simp
                      rw [hlhs, hrhs]
                    · by_cases h4 : ch.val = 2 * d + 1
                      · -- accumulator n channel
                        have hlhs : N.input.reluApply x ch = relu 0 := by
                          simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, h1, h2, add_zero]
                        have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = relu 0 := by
                          rw [hcast_id]
                          simp [state, h1, h2, h3]
                          rw [h4]
                          simp
                        rw [hlhs, hrhs]
                      · by_cases h5 : ch.val < 2 * d + 2 + W0
                        · -- working channel
                          have hlhs : N.input.reluApply x ch = 0 := by
                            simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, relu, h1, h2, add_zero]
                          have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = 0 := by
                            rw [hcast_id]
                            simp [state, relu, h1, h2, h3, h4, h5]
                          rw [hlhs, hrhs]
                        · -- slack channel
                          have hlhs : N.input.reluApply x ch = 0 := by
                            simp [DenseLayer.reluApply, DenseLayer.apply, reluVec, N, inputWeight, relu, h1, h2, add_zero]
                          have hrhs : state x (relu 0) (relu (-0)) (fun _ => 0) (Fin.cast hNw ch) = 0 := by
                            rw [hcast_id]
                            simp [state, relu, h1, h2, h3, h4, h5]
                          rw [hlhs, hrhs]
              intro k' hk'
              let S0 : ℝ := ∑ i : ι, if (Fintype.equivFin ι i).val < 0 then coeff i * (wit i).realize x else 0
              have hS0 : S0 = 0 := by simp [S0]
              change N.hiddenState x (0 * (D0 + 1)) k' = state x (relu S0) (relu (-S0)) (fun _ => 0) (Fin.cast hNw k')
              have hhs : N.hiddenState x (0 * (D0 + 1)) k' = N.input.reluApply x k' := by
                simp [FullyConnectedReLUNet.hiddenState]
              rw [hhs, hS0]
              exact hinput0 k'
          | succ k ih =>
              intro hk1
              have hk_le : k ≤ Fintype.card ι := by omega
              have hk_lt : k < Fintype.card ι := by omega
              let i_k : ι := (Fintype.equivFin ι).symm ⟨k, hk_lt⟩
              let Sk : ℝ := ∑ i : ι, if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0
              have hS : (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)
                  = Sk + coeff i_k * (wit i_k).realize x := by
                have hsplit : ∀ i : ι,
                    (if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)
                      = (if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0)
                        + (if (Fintype.equivFin ι i).val = k then coeff i * (wit i).realize x else 0) := by
                  intro i
                  by_cases hlt : (Fintype.equivFin ι i).val < k
                  · have hlt1 : (Fintype.equivFin ι i).val < k + 1 := by omega
                    have hne : (Fintype.equivFin ι i).val ≠ k := by omega
                    simp [hlt, hlt1, hne]
                  · by_cases heq : (Fintype.equivFin ι i).val = k
                    · have hlt1 : (Fintype.equivFin ι i).val < k + 1 := by omega
                      simp [hlt, heq, hlt1]
                    · have hgt1 : k + 1 ≤ (Fintype.equivFin ι i).val := by omega
                      have hnlt1 : ¬ (Fintype.equivFin ι i).val < k + 1 := by omega
                      simp [hlt, heq, hnlt1]
                calc
                  (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)
                      = (∑ i : ι, ((if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0)
                          + (if (Fintype.equivFin ι i).val = k then coeff i * (wit i).realize x else 0))) := by
                        apply Finset.sum_congr rfl
                        intro i hi
                        exact hsplit i
                  _ = (∑ i : ι, if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0)
                      + (∑ i : ι, if (Fintype.equivFin ι i).val = k then coeff i * (wit i).realize x else 0) := by
                        rw [Finset.sum_add_distrib]
                  _ = Sk + coeff i_k * (wit i_k).realize x := by
                        rw [show (∑ i : ι, if (Fintype.equivFin ι i).val < k then coeff i * (wit i).realize x else 0) = Sk from rfl]
                        congr 1
                        rw [Finset.sum_eq_single i_k]
                        · have heq : (Fintype.equivFin ι i_k).val = k := by
                            simp [i_k]
                          simp [heq]
                        · intro j hj hne
                          have hfj : (Fintype.equivFin ι j).val ≠ k := by
                            intro hk'
                            apply hne
                            have hfin : Fintype.equivFin ι j = ⟨k, hk_lt⟩ := by
                              apply Fin.ext
                              exact hk'
                            calc j = (Fintype.equivFin ι).symm (Fintype.equivFin ι j) := by simp
                                 _ = (Fintype.equivFin ι).symm ⟨k, hk_lt⟩ := by rw [hfin]
                                 _ = i_k := rfl
                          simp [hfj]
                        · intro hmem
                          exfalso
                          exact hmem (by simp)
              let u : Fin N.width → ℝ := fun ch => N.hiddenState x (k * hc) ch
              let p : ℝ := relu Sk
              let n : ℝ := relu (-Sk)
              let wEnc : Fin W0 → Fin W := fun j => ⟨2 * d + 2 + j.val, by
                change 2 * d + 2 + j.val < 2 * d + W0 + 3
                have hj : j.val < W0 := j.isLt
                omega⟩
              let w : Fin W0 → ℝ := fun j => u (wEnc j)
              have hcanon : ∀ ch : Fin N.width, u ch = state x p n w ch := by
                intro ch
                by_cases hwk : 2 * d + 2 ≤ ch.val ∧ ch.val < 2 * d + 2 + W0
                · have h1 : ¬ ch.val < d := by omega
                  have h2 : ¬ ch.val < 2 * d := by omega
                  have h3 : ¬ ch.val = 2 * d := by omega
                  have h4 : ¬ ch.val = 2 * d + 1 := by omega
                  have h5 : ch.val < 2 * d + 2 + W0 := hwk.2
                  have hwd : ch.val - (2 * d + 2) < W0 := by omega
                  have hstate_def : state x p n w ch = w ⟨ch.val - (2 * d + 2), hwd⟩ := by
                    unfold state
                    simp [p, n, h1, h2, h3, h4, h5]
                  rw [hstate_def]
                  simp [w]
                  congr 1
                  symm
                  apply Fin.ext
                  simp [wEnc]
                  omega
                · have hprot : ch.val < 2 * d ∨ ch.val = 2 * d ∨ ch.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ ch.val := by omega
                  have hi := ih hk_le
                  dsimp at hi
                  have hval := hi ch hprot
                  change N.hiddenState x (k * (D0 + 1)) ch = state x p n w ch
                  rw [hval]

                  by_cases h1 : ch.val < d
                  · simp [state, p, n, h1]
                  · by_cases h2 : ch.val < 2 * d
                    · simp [state, p, n, h1, h2]
                    · by_cases h3 : ch.val = 2 * d
                      · have h2d_lt_d : ¬ 2 * d < d := by omega
                        simp [state, p, n, Sk, h1, h2, h3, h2d_lt_d]
                      · by_cases h4 : ch.val = 2 * d + 1
                        · have h2d1_lt_d : ¬ 2 * d + 1 < d := by omega
                          simp [state, p, n, Sk, h1, h2, h3, h4, h2d1_lt_d]
                        · have h5 : ¬ ch.val < 2 * d + 2 + W0 := by omega
                          simp [state, p, n, h1, h2, h3, h4, h5]
              change ∀ k' : Fin N.width,
                  (k'.val < 2 * d ∨ k'.val = 2 * d ∨ k'.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ k'.val) →
                  N.hiddenState x ((k + 1) * (D0 + 1)) k' =
                    state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0))) (fun _ => 0) (Fin.cast hNw k')
              intro k' hk'
              -- basic relu facts (re-declared: not in scope in this branch)
              have hrelu_nonneg : ∀ x : ℝ, 0 ≤ relu x := by
                intro x
                dsimp [relu]
                exact le_max_right x 0
              have hrelu_of_nonneg : ∀ {x : ℝ}, 0 ≤ x → relu x = x := by
                intro x hx
                dsimp [relu]
                exact max_eq_left hx
              have hrelu_of_nonpos : ∀ {x : ℝ}, x ≤ 0 → relu x = 0 := by
                intro x hx
                dsimp [relu]
                exact max_eq_right hx
              have hrelu_sub : ∀ t : ℝ, relu t - relu (-t) = t := by
                intro t
                by_cases ht : 0 ≤ t
                · have h1 : relu t = t := hrelu_of_nonneg ht
                  have h2 : relu (-t) = 0 := by
                    apply hrelu_of_nonpos
                    linarith
                  rw [h1, h2]
                  ring
                · have h1 : relu t = 0 := by
                    apply hrelu_of_nonpos
                    linarith
                  have h2 : relu (-t) = -t := by
                    apply hrelu_of_nonneg
                    linarith
                  rw [h1, h2]
                  ring
              -- block data for i_k
              have hbk := Classical.choose_spec (hblock i_k)
              rcases hbk with ⟨hBw_k, hBd_k, hidFact_k, hparam_k, hlaw_k⟩
              -- cast round-trips for the block width
              have hround : ∀ j : Fin (blk i_k).width, Fin.cast hBw_k.symm (Fin.cast hBw_k j) = j := by
                intro j
                apply Fin.ext
                simp [Fin.coe_cast]
              have hroundN : ∀ j : Fin W, Fin.cast hBw_k (Fin.cast hBw_k.symm j) = j := by
                intro j
                apply Fin.ext
                simp [Fin.coe_cast]
              -- index arithmetic: the (k, t) layer of block k lives at global index k*hc + t
              have hlt_c : ∀ t : ℕ, t < hc → k * hc + t < c * hc := by
                intro t ht
                calc
                  k * hc + t < k * hc + hc := by omega
                  _ = (k + 1) * hc := by ring
                  _ ≤ c * hc := by
                    exact Nat.mul_le_mul_right hc (by omega)
              have hpair (t : ℕ) (ht : t < hc) :
                  (finProdFinEquiv (m := c) (n := hc)).symm ⟨k * hc + t, hlt_c t ht⟩ = (⟨k, hk_lt⟩, ⟨t, ht⟩) := by
                apply (finProdFinEquiv (m := c) (n := hc)).injective
                rw [Equiv.apply_symm_apply]
                apply Fin.ext
                rw [finProdFinEquiv_apply_val]
                ring
              have hhidden_layer (t : ℕ) (ht : t < hc) :
                  hidden ⟨k * hc + t, hlt_c t ht⟩ = layerOf i_k ⟨t, ht⟩ := by
                change layerOf ((Fintype.equivFin ι).symm ((finProdFinEquiv (m := c) (n := hc)).symm ⟨k * hc + t, hlt_c t ht⟩).1) ((finProdFinEquiv (m := c) (n := hc)).symm ⟨k * hc + t, hlt_c t ht⟩).2 = layerOf i_k ⟨t, ht⟩
                rw [hpair t ht]

              -- width-cast transport through reluApply
              have hcast_relu_in : ∀ (w : ℕ) (h : w = W) (L : DenseLayer W w) (v : Fin W → ℝ) (c : Fin W),
                  DenseLayer.reluApply (cast (by rw [h]) L) v c = DenseLayer.reluApply L v (Fin.cast h.symm c) := by
                intro w h L v c
                cases h
                simp
              have hcast_relu_hi : ∀ (w : ℕ) (h : w = W) (L : DenseLayer w w) (v : Fin W → ℝ) (c : Fin W),
                  DenseLayer.reluApply (cast (by rw [h]) L) v c = DenseLayer.reluApply L (fun j : Fin w => v (Fin.cast h j)) (Fin.cast h.symm c) := by
                intro w h L v c
                cases h
                simp
              -- all block hidden states are nonnegative (needed for the padding-identity layer)
              have hBnonneg : ∀ (t : ℕ) (ch : Fin (blk i_k).width), 0 ≤ (blk i_k).hiddenState (state x p n w) t ch := by
                intro t
                induction t with
                | zero =>
                    intro ch
                    simp [FullyConnectedReLUNet.hiddenState, DenseLayer.reluApply, DenseLayer.apply, reluVec]
                    exact hrelu_nonneg _
                | succ t ih =>
                    intro ch
                    by_cases ht : t < (blk i_k).depth - 1
                    · have hs : (blk i_k).hiddenState (state x p n w) (t + 1) ch = ((blk i_k).hidden ⟨t, ht⟩).reluApply ((blk i_k).hiddenState (state x p n w) t) ch := by
                        simp [FullyConnectedReLUNet.hiddenState, ht]
                      rw [hs]
                      simp [DenseLayer.reluApply, DenseLayer.apply, reluVec]
                      exact hrelu_nonneg _
                    · have hs : (blk i_k).hiddenState (state x p n w) (t + 1) ch = (blk i_k).hiddenState (state x p n w) t ch := by
                        simp [FullyConnectedReLUNet.hiddenState, ht]
                      rw [hs]
                      exact ih ch
              -- layer-advance chain: N's stage (k*hc + t + 1) equals the block's stage t (shifted past the input layer)
              have hchain : ∀ t : ℕ, t < D0 → ∀ ch : Fin W,
                  N.hiddenState x (k * hc + (t + 1)) ch = (blk i_k).hiddenState (state x p n w) t (Fin.cast hBw_k.symm ch) := by
                intro t htD0
                have hNhid : N.hidden = hidden := rfl
                induction t with
                | zero =>
                    intro ch
                    have hguardN : k * hc + 0 < N.depth - 1 := hlt_c 0 (by omega)
                    have hNrec : N.hiddenState x (k * hc + 1) ch = (hidden ⟨k * hc + 0, hguardN⟩).reluApply (N.hiddenState x (k * hc + 0)) ch := by
                      have ht : k * hc < N.depth - 1 := by
                        simpa using hguardN
                      simp [FullyConnectedReLUNet.hiddenState, ht, hNhid, Nat.add_zero]
                    have hhl : hidden ⟨k * hc + 0, hguardN⟩ = layerOf i_k ⟨0, by omega⟩ := hhidden_layer 0 (by omega)
                    have hlo0 : layerOf i_k ⟨0, by omega⟩ = cast (by rw [hblk_w i_k]) (blk i_k).input := by
                      simp [layerOf]
                    have hs0 : (blk i_k).hiddenState (state x p n w) 0 (Fin.cast hBw_k.symm ch) = (blk i_k).input.reluApply (state x p n w) (Fin.cast hBw_k.symm ch) := by
                      simp [FullyConnectedReLUNet.hiddenState]
                    have hu : u = state x p n w := by
                      funext ch2
                      exact hcanon ch2
                    calc
                      N.hiddenState x (k * hc + 1) ch = (hidden ⟨k * hc + 0, hguardN⟩).reluApply (N.hiddenState x (k * hc + 0)) ch := hNrec
                      _ = (layerOf i_k ⟨0, by omega⟩).reluApply (N.hiddenState x (k * hc + 0)) ch := by rw [hhl]
                      _ = DenseLayer.reluApply (cast (by rw [hblk_w i_k]) (blk i_k).input) (N.hiddenState x (k * hc + 0)) ch := by rw [hlo0]
                      _ = (blk i_k).input.reluApply (N.hiddenState x (k * hc + 0)) (Fin.cast (hblk_w i_k).symm ch) := by
                            rw [hcast_relu_in (blk i_k).width (hblk_w i_k) (blk i_k).input (N.hiddenState x (k * hc + 0)) ch]
                      _ = (blk i_k).input.reluApply (state x p n w) (Fin.cast hBw_k.symm ch) := by
                            rw [show N.hiddenState x (k * hc + 0) = u from rfl]
                            rw [hu]
                      _ = (blk i_k).hiddenState (state x p n w) 0 (Fin.cast hBw_k.symm ch) := by
                            rw [hs0]
                | succ t ih =>
                    intro ch
                    have hih : ∀ ch : Fin W, N.hiddenState x (k * hc + (t + 1)) ch = (blk i_k).hiddenState (state x p n w) t (Fin.cast hBw_k.symm ch) := ih (by omega)
                    have hguardB : t < (blk i_k).depth - 1 := by
                      rw [hBd_k]
                      omega
                    have hBrec : (blk i_k).hiddenState (state x p n w) (t + 1) (Fin.cast hBw_k.symm ch) = ((blk i_k).hidden ⟨t, hguardB⟩).reluApply ((blk i_k).hiddenState (state x p n w) t) (Fin.cast hBw_k.symm ch) := by
                      simp [FullyConnectedReLUNet.hiddenState, hguardB]
                    have hguardN : k * hc + (t + 1) < N.depth - 1 := hlt_c (t + 1) (by omega)
                    have hNrec : N.hiddenState x (k * hc + (t + 2)) ch = (hidden ⟨k * hc + (t + 1), hguardN⟩).reluApply (N.hiddenState x (k * hc + (t + 1))) ch := by
                      have ht_inner : k * hc + t < N.depth - 1 := hlt_c t (by omega)
                      simp [FullyConnectedReLUNet.hiddenState, hguardN, ht_inner, hNhid, Nat.add_assoc]
                    have hhl : hidden ⟨k * hc + (t + 1), hguardN⟩ = layerOf i_k ⟨t + 1, by omega⟩ := hhidden_layer (t + 1) (by omega)
                    have ht1 : t + 1 ≠ 0 := by omega
                    have ht2 : t + 1 + 1 ≠ hc := by omega
                    have hlo : layerOf i_k ⟨t + 1, by omega⟩ = cast (by rw [hblk_w i_k]) ((blk i_k).hidden ⟨t, hguardB⟩) := by
                      simp [layerOf, ht1, ht2, Fin.cast_mk]
                    have hinput : (fun j : Fin (blk i_k).width => N.hiddenState x (k * hc + (t + 1)) (Fin.cast hBw_k j)) = (blk i_k).hiddenState (state x p n w) t := by
                      funext j
                      exact (hih (Fin.cast hBw_k j)).trans (congrArg ((blk i_k).hiddenState (state x p n w) t) (hround j))
                    calc
                      N.hiddenState x (k * hc + (t + 2)) ch = (hidden ⟨k * hc + (t + 1), hguardN⟩).reluApply (N.hiddenState x (k * hc + (t + 1))) ch := hNrec
                      _ = (layerOf i_k ⟨t + 1, by omega⟩).reluApply (N.hiddenState x (k * hc + (t + 1))) ch := by rw [hhl]
                      _ = DenseLayer.reluApply (cast (by rw [hblk_w i_k]) ((blk i_k).hidden ⟨t, hguardB⟩)) (N.hiddenState x (k * hc + (t + 1))) ch := by rw [hlo]
                      _ = ((blk i_k).hidden ⟨t, hguardB⟩).reluApply (fun j : Fin (blk i_k).width => N.hiddenState x (k * hc + (t + 1)) (Fin.cast hBw_k j)) (Fin.cast hBw_k.symm ch) := by
                            rw [hcast_relu_hi (blk i_k).width hBw_k ((blk i_k).hidden ⟨t, hguardB⟩) (N.hiddenState x (k * hc + (t + 1))) ch]
                      _ = ((blk i_k).hidden ⟨t, hguardB⟩).reluApply ((blk i_k).hiddenState (state x p n w) t) (Fin.cast hBw_k.symm ch) := by rw [hinput]
                      _ = (blk i_k).hiddenState (state x p n w) (t + 1) (Fin.cast hBw_k.symm ch) := by rw [hBrec]
              -- final layer advance: stage (k+1)*hc of N equals the block's full (D0+1)-hidden-layer pass
              have hadv : N.hiddenState x ((k + 1) * hc) k' = (blk i_k).hiddenState (state x p n w) (D0 + 1) (Fin.cast hBw_k.symm k') := by
                have hguard : k * hc + D0 < N.depth - 1 := by
                  exact hlt_c D0 (by omega)
                have hNhid : N.hidden = hidden := rfl
                have hNrec : N.hiddenState x (k * hc + (D0 + 1)) k' = (hidden ⟨k * hc + D0, hguard⟩).reluApply (N.hiddenState x (k * hc + D0)) k' := by
                  simp [FullyConnectedReLUNet.hiddenState, hguard, hNhid]
                have hpred : (D0 - 1) + 1 = D0 := by
                  exact Nat.sub_add_cancel (by omega)
                have hchainD : ∀ ch : Fin W, N.hiddenState x (k * hc + D0) ch = (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm ch) := by
                  intro ch
                  have hc2 := hchain (D0 - 1) (by omega) ch
                  rw [hpred] at hc2
                  exact hc2
                have hhiddenD : hidden ⟨k * hc + D0, hguard⟩ = layerOf i_k ⟨D0, by omega⟩ := hhidden_layer D0 (by omega)
                have hD0idx : D0 < (blk i_k).depth - 1 := by
                  rw [hBd_k]
                  omega
                have hloD : layerOf i_k ⟨D0, by omega⟩ = cast (by rw [hblk_w i_k]) ((blk i_k).hidden ⟨D0, hD0idx⟩) := by
                  have ht1 : D0 ≠ 0 := by omega
                  have hlast : D0 + 1 = hc := rfl
                  simp [layerOf, ht1, hlast, Fin.cast_mk]
                have hinputD : (fun j : Fin (blk i_k).width => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm (Fin.cast hBw_k j))) = (blk i_k).hiddenState (state x p n w) (D0 - 1) := by
                  funext j
                  exact @congrArg (Fin (blk i_k).width) ℝ (Fin.cast hBw_k.symm (Fin.cast hBw_k j)) j ((blk i_k).hiddenState (state x p n w) (D0 - 1)) (hround j)
                have hidx : D0 - 1 < (blk i_k).depth - 1 := by
                  rw [hBd_k]
                  omega
                have hid_step : (blk i_k).hiddenState (state x p n w) D0 = (blk i_k).hiddenState (state x p n w) (D0 - 1) := by
                  have hrec' : (blk i_k).hiddenState (state x p n w) D0 = ((blk i_k).hidden ⟨D0 - 1, hidx⟩).reluApply ((blk i_k).hiddenState (state x p n w) (D0 - 1)) := by
                    have hrec : (blk i_k).hiddenState (state x p n w) ((D0 - 1) + 1) = ((blk i_k).hidden ⟨D0 - 1, hidx⟩).reluApply ((blk i_k).hiddenState (state x p n w) (D0 - 1)) := by
                      simp [FullyConnectedReLUNet.hiddenState, hidx]
                    rwa [hpred] at hrec
                  rw [hrec']
                  exact hidFact_k ((blk i_k).hiddenState (state x p n w) (D0 - 1)) (hBnonneg (D0 - 1)) hidx
                have hBrec : (blk i_k).hiddenState (state x p n w) (D0 + 1) (Fin.cast hBw_k.symm k') = ((blk i_k).hidden ⟨D0, hD0idx⟩).reluApply ((blk i_k).hiddenState (state x p n w) D0) (Fin.cast hBw_k.symm k') := by
                  simp [FullyConnectedReLUNet.hiddenState, hD0idx]
                calc
                  N.hiddenState x ((k + 1) * hc) k' = N.hiddenState x (k * hc + (D0 + 1)) k' := by
                    rw [show (k + 1) * hc = k * hc + hc from by ring]

                  _ = (hidden ⟨k * hc + D0, hguard⟩).reluApply (N.hiddenState x (k * hc + D0)) k' := hNrec
                  _ = (hidden ⟨k * hc + D0, hguard⟩).reluApply (fun ch : Fin W => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm ch)) k' := by
                        apply congrArg (fun v => (hidden ⟨k * hc + D0, hguard⟩).reluApply v k')
                        funext ch
                        exact hchainD ch
                  _ = (layerOf i_k ⟨D0, by omega⟩).reluApply (fun ch : Fin W => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm ch)) k' := by rw [hhiddenD]
                  _ = DenseLayer.reluApply (cast (by rw [hblk_w i_k]) ((blk i_k).hidden ⟨D0, hD0idx⟩)) (fun ch : Fin W => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm ch)) k' := by rw [hloD]
                  _ = ((blk i_k).hidden ⟨D0, hD0idx⟩).reluApply (fun j : Fin (blk i_k).width => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm (Fin.cast hBw_k j))) (Fin.cast hBw_k.symm k') := by
                        rw [hcast_relu_hi (blk i_k).width hBw_k ((blk i_k).hidden ⟨D0, hD0idx⟩) (fun ch : Fin W => (blk i_k).hiddenState (state x p n w) (D0 - 1) (Fin.cast hBw_k.symm ch)) k']
                  _ = ((blk i_k).hidden ⟨D0, hD0idx⟩).reluApply ((blk i_k).hiddenState (state x p n w) (D0 - 1)) (Fin.cast hBw_k.symm k') := by rw [hinputD]
                  _ = ((blk i_k).hidden ⟨D0, hD0idx⟩).reluApply ((blk i_k).hiddenState (state x p n w) D0) (Fin.cast hBw_k.symm k') := by rw [← hid_step]
                  _ = (blk i_k).hiddenState (state x p n w) (D0 + 1) (Fin.cast hBw_k.symm k') := by rw [hBrec]
              -- instantiate the block transition law
              have hp' : 0 ≤ p := by
                change 0 ≤ relu Sk
                exact hrelu_nonneg Sk
              have hn' : 0 ≤ n := by
                change 0 ≤ relu (-Sk)
                exact hrelu_nonneg (-Sk)
              have hk'c : (Fin.cast hBw_k.symm k').val < 2 * d ∨ (Fin.cast hBw_k.symm k').val = 2 * d ∨ (Fin.cast hBw_k.symm k').val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ (Fin.cast hBw_k.symm k').val := by
                simpa [Fin.coe_cast] using hk'
              have hbv := hlaw_k x p n w hp' hn' (Fin.cast hBw_k.symm k') hk'c
              have hbv' : (blk i_k).hiddenState (state x p n w) (D0 + 1) (Fin.cast hBw_k.symm k') = state x (relu (p - n + coeff i_k * (wit i_k).realize x)) (relu (n - p - coeff i_k * (wit i_k).realize x)) w k' := by
                rw [hroundN k'] at hbv
                exact hbv
              -- accumulator algebra
              have hpn : p - n = Sk := by
                simpa [p, n] using hrelu_sub Sk
              have hnp : n - p = -Sk := by
                have hsub' : relu (-Sk) - relu Sk = -Sk := by
                  calc
                    relu (-Sk) - relu Sk = -(relu Sk - relu (-Sk)) := by ring
                    _ = -Sk := by rw [hrelu_sub Sk]
                simpa [p, n] using hsub'
              have hrelu1 : relu (p - n + coeff i_k * (wit i_k).realize x) = relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0) := by
                rw [hpn, ← hS]
              have hneg : -Sk - coeff i_k * (wit i_k).realize x = -(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0) := by
                calc
                  -Sk - coeff i_k * (wit i_k).realize x = -(Sk + coeff i_k * (wit i_k).realize x) := by ring
                  _ = -(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0) := by rw [← hS]
              have hrelu2 : relu (n - p - coeff i_k * (wit i_k).realize x) = relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) := by
                rw [hnp, hneg]
              -- w is irrelevant on protected channels
              have hw_irrel : state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0))) w k' = state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0))) (fun _ => 0) k' := by
                unfold state
                by_cases h1 : k'.val < d
                · simp [h1]
                · by_cases h2 : k'.val < 2 * d
                  · simp [h1, h2]
                  · by_cases h3 : k'.val = 2 * d
                    · simp [h1, h2, h3]
                    · by_cases h4 : k'.val = 2 * d + 1
                      · simp [h1, h2, h3, h4]
                      · have hprot : 2 * d + 2 + W0 ≤ k'.val := by
                          rcases hk' with h | h | h | h
                          · omega
                          · omega
                          · omega
                          · exact h
                        have hw_false : ¬ k'.val < 2 * d + 2 + W0 := by omega
                        simp [h1, h2, h3, h4, hw_false]
              have hfinal_state : state x (relu (p - n + coeff i_k * (wit i_k).realize x)) (relu (n - p - coeff i_k * (wit i_k).realize x)) w k' = state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0))) (fun _ => 0) (Fin.cast hNw k') := by
                rw [hrelu1, hrelu2]
                rw [hw_irrel]
                simp
              calc
                N.hiddenState x ((k + 1) * (D0 + 1)) k' = N.hiddenState x ((k + 1) * hc) k' := rfl
                _ = (blk i_k).hiddenState (state x p n w) (D0 + 1) (Fin.cast hBw_k.symm k') := hadv
                _ = state x (relu (p - n + coeff i_k * (wit i_k).realize x)) (relu (n - p - coeff i_k * (wit i_k).realize x)) w k' := hbv'
                _ = state x (relu (∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0)) (relu (-(∑ i : ι, if (Fintype.equivFin ι i).val < k + 1 then coeff i * (wit i).realize x else 0))) (fun _ => 0) (Fin.cast hNw k') := hfinal_state
        exact ⟨N, hNw, hNd, hinv, hbias, hweight⟩
      -- @step s2: destructure the spliced network from hNspec and derive the realize equality for THIS specific network
      rcases hNspec with ⟨N, hNw, hNd, hinv, hbias, hweight⟩
      have hrealEq : ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * (wit i).realize x := by
        intro x
        have hdepth : N.depth - 1 = Fintype.card ι * (D0 + 1) := by
          rw [hNd]
          omega
        have hinv_card := hinv x (Fintype.card ι) (le_rfl)
        dsimp at hinv_card
        let S : ℝ := ∑ i : ι, if (Fintype.equivFin ι i).val < Fintype.card ι then coeff i * (wit i).realize x else 0
        have hS : S = ∑ i : ι, coeff i * (wit i).realize x := by
          apply Finset.sum_congr rfl
          intro i hi
          have hlt : (Fintype.equivFin ι i).val < Fintype.card ι := (Fintype.equivFin ι i).isLt
          simp [hlt]
        have hrelu_sub : ∀ t : ℝ, relu t - relu (-t) = t := by
          intro t
          by_cases ht : 0 ≤ t
          · have h1 : relu t = t := by
              dsimp [relu]
              exact max_eq_left ht
            have h2 : relu (-t) = 0 := by
              dsimp [relu]
              apply max_eq_right
              linarith
            rw [h1, h2]
            ring
          · have h1 : relu t = 0 := by
              dsimp [relu]
              apply max_eq_right
              linarith
            have h2 : relu (-t) = -t := by
              dsimp [relu]
              apply max_eq_left
              linarith
            rw [h1, h2]
            ring
        have hterm : ∀ j : Fin N.width,
            N.outputWeight j * N.hiddenState x (Fintype.card ι * (D0 + 1)) j
              = (if j.val = 2 * d then relu S else if j.val = 2 * d + 1 then -relu (-S) else 0) := by
          intro j
          rw [hweight j]
          by_cases h2d : j.val = 2 * d
          · have hprem : j.val < 2 * d ∨ j.val = 2 * d ∨ j.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ j.val := by omega
            have hv : N.hiddenState x (Fintype.card ι * (D0 + 1)) j = state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw j) := by
              simpa [S] using hinv_card j hprem
            have hstate : state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw j) = relu S := by
              unfold state
              have hc1 : ¬ (Fin.cast hNw j).val < d := by
                rw [Fin.coe_cast]
                omega
              have hc2 : ¬ (Fin.cast hNw j).val < 2 * d := by
                rw [Fin.coe_cast]
                omega
              have hc3 : (Fin.cast hNw j).val = 2 * d := by
                rw [Fin.coe_cast]
                exact h2d
              rw [dif_neg hc1, dif_neg hc2, dif_pos hc3]
            rw [hv, hstate]
            simp [h2d]
          · by_cases h2d1 : j.val = 2 * d + 1
            · have hprem : j.val < 2 * d ∨ j.val = 2 * d ∨ j.val = 2 * d + 1 ∨ 2 * d + 2 + W0 ≤ j.val := by omega
              have hv : N.hiddenState x (Fintype.card ι * (D0 + 1)) j = state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw j) := by
                simpa [S] using hinv_card j hprem
              have hstate : state x (relu S) (relu (-S)) (fun _ => 0) (Fin.cast hNw j) = relu (-S) := by
                unfold state
                have hc1 : ¬ (Fin.cast hNw j).val < d := by
                  rw [Fin.coe_cast]
                  omega
                have hc2 : ¬ (Fin.cast hNw j).val < 2 * d := by
                  rw [Fin.coe_cast]
                  omega
                have hc3 : ¬ (Fin.cast hNw j).val = 2 * d := by
                  rw [Fin.coe_cast]
                  omega
                have hc4 : (Fin.cast hNw j).val = 2 * d + 1 := by
                  rw [Fin.coe_cast]
                  exact h2d1
                rw [dif_neg hc1, dif_neg hc2, dif_neg hc3, dif_pos hc4]
              rw [hv, hstate]
              simp [h2d, h2d1]
            · simp [h2d, h2d1]
        have h2d_lt_W : 2 * d < W := by
          dsimp [W]
          omega
        have h2d1_lt_W : 2 * d + 1 < W := by
          dsimp [W]
          omega

        let j2d : Fin N.width := ⟨2 * d, by
          rw [hNw]
          exact h2d_lt_W⟩
        let j2d1 : Fin N.width := ⟨2 * d + 1, by
          rw [hNw]
          exact h2d1_lt_W⟩
        have hsum1 : (∑ j : Fin N.width, if j.val = 2 * d then relu S else 0) = relu S := by
          rw [Finset.sum_eq_single j2d]
          · have hj2d : (j2d : ℕ) = 2 * d := rfl
            simp [hj2d]
          · intro j hj hne
            have hjv : j.val ≠ 2 * d := by
              intro hv
              apply hne
              apply Fin.ext
              exact hv
            simp [hjv]
          · intro hmem
            exfalso
            exact hmem (by simp)
        have hsum2 : (∑ j : Fin N.width, if j.val = 2 * d + 1 then -relu (-S) else 0) = -relu (-S) := by
          rw [Finset.sum_eq_single j2d1]
          · have hj2d1 : (j2d1 : ℕ) = 2 * d + 1 := rfl
            simp [hj2d1]
          · intro j hj hne
            have hjv : j.val ≠ 2 * d + 1 := by
              intro hv
              apply hne
              apply Fin.ext
              exact hv
            simp [hjv]
          · intro hmem
            exfalso
            exact hmem (by simp)
        have hsum_collapse :
            (∑ j : Fin N.width, (if j.val = 2 * d then relu S else if j.val = 2 * d + 1 then -relu (-S) else 0))
              = relu S - relu (-S) := by
          calc
            (∑ j : Fin N.width, (if j.val = 2 * d then relu S else if j.val = 2 * d + 1 then -relu (-S) else 0))
                = (∑ j : Fin N.width, (if j.val = 2 * d then relu S else 0))
                    + (∑ j : Fin N.width, (if j.val = 2 * d + 1 then -relu (-S) else 0)) := by
                  rw [← Finset.sum_add_distrib]
                  apply Finset.sum_congr rfl
                  intro j hj
                  by_cases h2d : j.val = 2 * d
                  · have hne21 : j.val ≠ 2 * d + 1 := by omega
                    simp [h2d, hne21]
                  · by_cases h2d1 : j.val = 2 * d + 1
                    · have hne2d : j.val ≠ 2 * d := by omega
                      simp [h2d, h2d1, hne2d]
                    · simp [h2d, h2d1]
            _ = relu S + -relu (-S) := by
                  rw [hsum1, hsum2]
            _ = relu S - relu (-S) := by ring
        calc
          N.realize x = ∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (N.depth - 1) j + N.outputBias := rfl
          _ = ∑ j : Fin N.width, N.outputWeight j * N.hiddenState x (Fintype.card ι * (D0 + 1)) j := by
            rw [hdepth, hbias]
            simp
          _ = ∑ j : Fin N.width, (if j.val = 2 * d then relu S else if j.val = 2 * d + 1 then -relu (-S) else 0) := by
            apply Finset.sum_congr rfl
            intro j hj
            exact hterm j
          _ = relu S - relu (-S) := hsum_collapse
          _ = S := hrelu_sub S
          _ = ∑ i : ι, coeff i * (wit i).realize x := hS
      -- @step s3: assemble the existential witness from the destructured hNspec
      exact ⟨N, hNd, hNw, hrealEq⟩
    -- @step s3: parameter-count bound via the closed-form fullyConnectedReLUParameterCount
    have hparam : ∃ N : FullyConnectedReLUNet d,
        N.depth = 1 + Fintype.card ι * (D0 + 1) ∧ N.width = W ∧
        N.parameterCount ≤ fullyConnectedReLUParameterCount d (1 + Fintype.card ι * (D0 + 1)) W ∧
        ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * (wit i).realize x := by
      rcases hrealize with ⟨N, hNd, hNw, hrealEq⟩
      refine ⟨N, hNd, hNw, ?_, hrealEq⟩
      rw [FullyConnectedReLUNet.parameterCount, hNd, hNw]
    exact hparam
  -- @step s4: conclude the target existential with all bounds and exact realize
  have hfinal : ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      N.width ≤ 2 * d + W0 + 3 ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) ∧
      ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x := by
    rcases hsplice with ⟨N, hNd, hNw, hNp, hNreal⟩
    have hd1 : 1 + Fintype.card ι * (D0 + 1) ≤ (Fintype.card ι + 1) * (D0 + 1) := by
      rw [Nat.add_mul, one_mul]
      omega
    have hparam_mono : fullyConnectedReLUParameterCount d (1 + Fintype.card ι * (D0 + 1)) W ≤
        fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) := by
      unfold fullyConnectedReLUParameterCount
      rw [show W = 2 * d + W0 + 3 from rfl]
      have hsub : (1 + Fintype.card ι * (D0 + 1)) - 1 ≤ ((Fintype.card ι + 1) * (D0 + 1)) - 1 := by
        exact Nat.sub_le_sub_right hd1 1
      have hmul : ((1 + Fintype.card ι * (D0 + 1)) - 1) * ((2 * d + W0 + 3 + 1) * (2 * d + W0 + 3)) ≤
          (((Fintype.card ι + 1) * (D0 + 1)) - 1) * ((2 * d + W0 + 3 + 1) * (2 * d + W0 + 3)) := by
        exact Nat.mul_le_mul_right ((2 * d + W0 + 3 + 1) * (2 * d + W0 + 3)) hsub
      omega
    refine ⟨N, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hNd]
      omega
    · rw [hNd]
      rw [Nat.add_mul, one_mul]
      omega
    · rw [hNw]

    · exact le_trans hNp hparam_mono
    · intro x
      calc
        N.realize x = ∑ i : ι, coeff i * (wit i).realize x := hNreal x
        _ = ∑ i : ι, coeff i * approx i x := by
          apply Finset.sum_congr rfl
          intro i hi
          rcases (Classical.choose_spec (hwit i)) with ⟨_, _, _, _, hwreal⟩
          rw [hwreal x]
  exact hfinal

/-- Finite linear combinations of common-class approximants admit the same
serial fixed-width error bound with an explicit natural depth envelope. -/
theorem finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {d D0 W0 P0 : ℕ}
    (hD0 : 0 < D0) (hW0 : 0 < W0)
    {domain : (Fin d → ℝ) → Prop}
    (coeff : ι → ℝ)
    (target approx : ι → (Fin d → ℝ) → ℝ)
    (eps : ι → ℝ)
    (heps : ∀ i : ι, 0 ≤ eps i)
    (hclass : ∀ i : ι, approx i ∈ reluNetworkClass d D0 W0 P0)
    (herr : ∀ i : ι, ∀ x : Fin d → ℝ, domain x →
      |approx i x - target i x| ≤ eps i) :
    ∃ D P : ℕ,
      0 < D ∧
      D ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + W0 + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + W0 + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - (∑ i : ι, coeff i * target i x)| ≤
              ∑ i : ι, |coeff i| * eps i := by
  -- @step s1: apply the serial fixed-width witness lemma to coeff/approx/hclass
  have h_wit : ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      N.width ≤ 2 * d + W0 + 3 ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) ∧
      ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x := by
    exact finite_linear_combination_reluNetworkClass_serial_fixed_width_network_witness_bound
      hD0 hW0 coeff approx hclass
  -- @step s2: repackage the witness into the exact depth/width/parameter-count class
  have h_mem : (∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      N.width ≤ 2 * d + W0 + 3 ∧
      N.parameterCount ≤
        fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1)) (2 * d + W0 + 3) ∧
      ∀ x : Fin d → ℝ, N.realize x = ∑ i : ι, coeff i * approx i x) →
      ∃ D P : ℕ,
        0 < D ∧
        D ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
        P = fullyConnectedReLUParameterCount d D (2 * d + W0 + 3) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (2 * d + W0 + 3) P ∧
          ∀ x : Fin d → ℝ, g x = ∑ i : ι, coeff i * approx i x := by
    rintro ⟨N, hN0, hNd, hNw, hNp, hNr⟩
    refine ⟨(Fintype.card ι + 1) * (D0 + 1),
      fullyConnectedReLUParameterCount d ((Fintype.card ι + 1) * (D0 + 1))
        (2 * d + W0 + 3), ?_, ?_, ?_, N.realize, ?_, ?_⟩
    · exact Nat.mul_pos (Nat.succ_pos _) (Nat.succ_pos _)
    · rfl
    · rfl
    · simp [reluNetworkClass]
      exact ⟨N, hN0, hNd, hNw, hNp, fun x => rfl⟩
    · exact hNr
  -- @step s3: finite-sum error estimate from the exact identity and herr
  have h_err : (∃ D P : ℕ,
      0 < D ∧
      D ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + W0 + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + W0 + 3) P ∧
        ∀ x : Fin d → ℝ, g x = ∑ i : ι, coeff i * approx i x) →
      ∃ D P : ℕ,
        0 < D ∧
        D ≤ (Fintype.card ι + 1) * (D0 + 1) ∧
        P = fullyConnectedReLUParameterCount d D (2 * d + W0 + 3) ∧
        ∃ g : (Fin d → ℝ) → ℝ,
          g ∈ reluNetworkClass d D (2 * d + W0 + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - (∑ i : ι, coeff i * target i x)| ≤
              ∑ i : ι, |coeff i| * eps i := by
    intro hEx
    rcases hEx with ⟨D, P, hDpos, hDbound, hP, hg⟩
    rcases hg with ⟨g, hgmem, hgid⟩
    refine ⟨D, P, hDpos, hDbound, hP, ⟨g, hgmem, ?_⟩⟩
    intro x hx
    calc
      |g x - (∑ i : ι, coeff i * target i x)|
          = |(∑ i : ι, coeff i * approx i x) -
              (∑ i : ι, coeff i * target i x)| := by
            rw [hgid x]
      _ = |∑ i : ι, coeff i * (approx i x - target i x)| := by
            rw [← Finset.sum_sub_distrib]
            congr 1
            simp [← mul_sub]
      _ ≤ ∑ i : ι, |coeff i * (approx i x - target i x)| := by
            simpa using
              (Finset.abs_sum_le_sum_abs
                (fun i : ι => coeff i * (approx i x - target i x)) Finset.univ)
      _ = ∑ i : ι, |coeff i| * |approx i x - target i x| := by
            simp [abs_mul]
      _ ≤ ∑ i : ι, |coeff i| * eps i := by
            apply Finset.sum_le_sum
            intro i hi
            exact mul_le_mul_of_nonneg_left (herr i x hx) (abs_nonneg (coeff i))
  exact h_err (h_mem h_wit)

/-- Explicit-depth fixed-width serial global assembly for weighted local tent
approximants. -/
theorem finite_axisAligned_tent_weighted_local_reluNetworkClass_serial_fixed_width_explicit_depth_global_error_bound
    {d m Dprod Wprod Pprod : ℕ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    (center scale : Fin m → Fin d → ℝ)
    (localApprox : Fin m → (Fin d → ℝ) → ℝ)
    (target : (Fin d → ℝ) → ℝ)
    (productApprox : Fin m → (Fin d → ℝ) → ℝ)
    (productDelta localEps : ℝ)
    (hProductDelta_nonneg : 0 ≤ productDelta)
    {domain : (Fin d → ℝ) → Prop}
    (hclass : ∀ j : Fin m,
      productApprox j ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hprodErr : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |productApprox j x -
        axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤
          productDelta)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ, domain x →
      (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
      (∀ q : Fin d,
        scale j q *
          (relu (x q - center j q) + relu (center j q - x q)) < 1) →
      |localApprox j x - target x| ≤ localEps) :
    ∃ D P : ℕ,
      0 < D ∧
      D ≤ (m + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - target x| ≤
              (∑ j : Fin m, productDelta) + localEps := by
  have hs1 : ∃ D P : ℕ,
      0 < D ∧
      D ≤ (m + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - (∑ j : Fin m,
              axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)| ≤
              (∑ j : Fin m, productDelta) := by
    obtain ⟨D, P, hDpos, hDle, hP, g, hg_class, hg_err⟩ :=
      finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
        (ι := Fin m) (d := d) (D0 := Dprod) (W0 := Wprod) (P0 := Pprod)
        hDprod hWprod
        (fun _ => (1 : ℝ))
        (fun j x => axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)
        productApprox
        (fun _ => productDelta)
        (fun _ => hProductDelta_nonneg) hclass hprodErr
    refine ⟨D, P, hDpos, ?_, hP, g, hg_class, ?_⟩
    · simpa using hDle
    · intro x hx
      simpa using hg_err x hx
  have hs2 : ∀ x : Fin d → ℝ, domain x →
      |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x *
          localApprox j x) - target x| ≤ localEps := by
    have hs2a : ∀ (j : Fin m) (x : Fin d → ℝ),
        0 ≤ axisAlignedBoxTentWeight (center j) (scale j) x := by
      intro j x
      exact (axisAlignedBoxTentWeight_bounds_and_support
        (center j) (scale j) x (hscale j)).1
    have hs2b : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 →
        (∀ q : Fin d,
          scale j q *
            (relu (x q - center j q) + relu (center j q - x q)) < 1) := by
      intro j x hx hw
      by_contra hneg
      push_neg at hneg
      have hsup :
          (∃ q : Fin d,
            1 ≤ scale j q *
              (relu (x q - center j q) + relu (center j q - x q))) →
            axisAlignedBoxTentWeight (center j) (scale j) x = 0 :=
        (axisAlignedBoxTentWeight_bounds_and_support
          (center j) (scale j) x (hscale j)).2.2
      exact hw (hsup hneg)
    have hs2c : ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
        axisAlignedBoxTentWeight (center j) (scale j) x ≠ 0 →
        |localApprox j x - target x| ≤ localEps := by
      intro j x hx hw
      exact hlocal j x hx (hs2b j x hx hw)
    have hs2d : ∀ x : Fin d → ℝ, domain x →
        |(∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x *
            localApprox j x) - target x| ≤ localEps := by
      intro x hx
      simpa using
        (Statlib.Nonparametric.Approximation.Sieve.partition_of_unity_weighted_function_pointwise_approximation_error_bound
          (X := {y : Fin d → ℝ // domain y}) m
          (fun j y => axisAlignedBoxTentWeight (center j) (scale j) y.1)
          (fun j y => localApprox j y.1)
          (fun y => target y.1) localEps
          (by intro j y; exact hs2a j y.1)
          (by intro y; simpa using hpartition y.1 y.2)
          (by intro j y hw; simpa using hs2c j y.1 y.2 hw)
          ⟨x, hx⟩)
    exact hs2d
  have hs3 : ∃ D P : ℕ,
      0 < D ∧
      D ≤ (m + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
    rcases hs1 with ⟨D, P, hDpos, hDle, hP, g, hgmem, hgErr⟩
    refine ⟨D, P, hDpos, hDle, hP, g, hgmem, ?_⟩
    intro x hx
    exact
      (abs_sub_le (g x)
        (∑ j : Fin m,
          axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x)
        (target x)).trans
        (add_le_add (hgErr x hx) (hs2 x hx))
  exact hs3

/-- Explicit-depth fixed-width exact-grid Holder assembly from common
tent/product tables. -/
theorem exists_reluNetworkClass_holderSmooth_unitCube_fixed_width_exact_grid_explicit_depth_and_error_budget
    {d m r Dlocal Wlocal Plocal Dtent Wtent Ptent Dprod Wprod Pprod : ℕ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    {beta C B localEps weightDelta productDelta eps : ℝ}
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (hGlobalErrBudget : (∑ j : Fin m, productDelta) + localEps ≤ eps)
    (center scale : Fin m → Fin d → ℝ)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (localApprox weightApprox productApprox : Fin m → (Fin d → ℝ) → ℝ)
    (hscale : ∀ (j : Fin m) (q : Fin d), 0 ≤ scale j q)
    (hpartition : ∀ x : Fin d → ℝ,
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        (∑ j : Fin m, axisAlignedBoxTentWeight (center j) (scale j) x) = 1)
    (hlocalClass : ∀ j : Fin m, localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal)
    (hweightClass : ∀ j : Fin m, weightApprox j ∈ reluNetworkClass d Dtent Wtent Ptent)
    (hproductClass : ∀ j : Fin m, productApprox j ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hproductErr : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
        |productApprox j x -
          axisAlignedBoxTentWeight (center j) (scale j) x * localApprox j x| ≤ productDelta)
    (hlocal : ∀ (j : Fin m) (x : Fin d → ℝ),
      (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
      (∀ q : Fin d,
        scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) →
        |localApprox j x - f x| ≤ localEps) :
    ∃ D P : ℕ,
      0 < D ∧
      D ≤ (m + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
          ∀ x : Fin d → ℝ,
            (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
              |g x - f x| ≤ eps := by
  let domain : (Fin d → ℝ) → Prop := fun x => ∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1
  rcases finite_axisAligned_tent_weighted_local_reluNetworkClass_serial_fixed_width_explicit_depth_global_error_bound
      (d := d) (m := m) (Dprod := Dprod) (Wprod := Wprod) (Pprod := Pprod)
      hDprod hWprod center scale localApprox f productApprox productDelta localEps
      hProductDelta_nonneg (domain := domain)
      hproductClass hproductErr hscale hpartition hlocal with
    ⟨D, P, hDpos, hDbound, hPcount, g, hgclass, hgbound⟩
  refine ⟨D, P, hDpos, hDbound, hPcount, g, hgclass, ?_⟩
  intro x hx
  exact le_trans (hgbound x hx) hGlobalErrBudget

/-- Fixed-width M-rate implies the L W^2 display rate. -/
theorem holderSmoothBall_unitCube_LW2_rate_from_fixed_width_M_rate
    {d r W0 : ℕ} {beta C B cDepth cErr : ℝ}
    (hd : 0 < d) (hW0 : 0 < W0)
    (hbeta_nonneg : 0 ≤ beta)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcDepth : 0 < cDepth) (hcErr : 0 < cErr)
    (hMrate :
      ∀ M : ℕ, 0 < M →
        ∃ D P : ℕ,
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          P = fullyConnectedReLUParameterCount d D W0 ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D W0 P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  |g x - f x| ≤ cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))) :
    ∃ cRate : ℝ, 0 < cRate ∧
      ∀ M : ℕ, 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
          P = fullyConnectedReLUParameterCount d L W ∧
          ∀ f : (Fin d → ℝ) → ℝ,
            f ∈ holderSmoothBall r beta C B →
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d L W P ∧
              ∀ x : Fin d → ℝ,
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                  |g x - f x| ≤ cRate *
                    (((L : ℝ) * (W : ℝ) ^ 2).rpow
                      (-(2 * ((r : ℝ) + beta) / (d : ℝ)))) := by
  have hcSize : 0 < cDepth * (W0 : ℝ) ^ 2 :=
    mul_pos hcDepth (sq_pos_of_pos (by exact_mod_cast hW0))
  have hscale :
      ∀ (M : ℕ), 0 < M →
        ∃ L W P : ℕ,
          0 < L ∧ 0 < W ∧
            (L : ℝ) * (W : ℝ) ^ 2 ≤ (cDepth * (W0 : ℝ) ^ 2) * (M : ℝ) ^ d ∧
            P = fullyConnectedReLUParameterCount d L W ∧
            ∀ f : (Fin d → ℝ) → ℝ,
              f ∈ holderSmoothBall r beta C B →
              ∃ g : (Fin d → ℝ) → ℝ,
                g ∈ reluNetworkClass d L W P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) →
                    |g x - f x| ≤
                      cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
    intro M hM
    rcases hMrate M hM with ⟨D, P, hDpos, hDsize, hP, hApprox⟩
    refine ⟨D, W0, P, hDpos, hW0, ?_, hP, hApprox⟩
    have hW2 : 0 ≤ (W0 : ℝ) ^ 2 := sq_nonneg (W0 : ℝ)
    have hDsizeW : (D : ℝ) * (W0 : ℝ) ^ 2 ≤
        (cDepth * (M : ℝ) ^ d) * (W0 : ℝ) ^ 2 :=
      mul_le_mul_of_nonneg_right hDsize hW2
    nlinarith [hDsizeW]
  exact holderSmoothBall_unitCube_LW2_rate_from_depth_width_scale_rate
    (cSize := cDepth * (W0 : ℝ) ^ 2) (cErr := cErr)
    hd hbeta_nonneg hsmooth_pos hcSize hcErr hscale

/-- Fixed-width centered coordinate monomial approximants from a multiplication gadget. -/
theorem exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget_explicit
    {d k Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ)) :
    ∃ Wmono : ℕ,
      0 < Wmono ∧
      Wmono = centeredMonomialFixedWidthBound Wmul k ∧
      ∃ cDepth : ℝ,
        0 < cDepth ∧
        cDepth = max 1 cMulDepth ∧
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
        ∀ center : Fin d → ℝ, ∀ coord : Fin k → Fin d,
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((k : ℝ) + 1) * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wmono ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D Wmono P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x - ∏ q : Fin k, (x (coord q) - center (coord q))| ≤
                      centeredMonomialFixedWidthApproxError cMulErr R n k := by
  let Wmono : ℕ := centeredMonomialFixedWidthBound Wmul k
  have hWmono_pos : 0 < Wmono := by
    dsimp [Wmono]
    refine Nat.strong_induction_on k ?_
    intro m ih
    cases m with
    | zero =>
        norm_num [centeredMonomialFixedWidthBound]
    | succ m =>
        cases m with
        | zero =>
            norm_num [centeredMonomialFixedWidthBound]
        | succ m =>
            have ih' : 0 < centeredMonomialFixedWidthBound Wmul (m + 1) :=
              ih (m + 1) (by omega)
            simp [centeredMonomialFixedWidthBound]
  let cDepth : ℝ := max 1 cMulDepth
  have hcDepth_pos : 0 < cDepth := by
    dsimp [cDepth]
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) (le_max_left 1 cMulDepth)
  refine ⟨Wmono, hWmono_pos, rfl, cDepth, hcDepth_pos, rfl, ?_⟩
  intro n hn R hR center coord
  have hrelu_sub : ∀ z : ℝ, relu z - relu (-z) = z := by
    intro z
    by_cases hz : 0 ≤ z
    · have h1 : relu z = z := by
        simp [relu, hz]
      have h2 : relu (-z) = 0 := by
        have hneg : -z ≤ 0 := by linarith
        simp [relu, hneg]
      linarith
    · have hzle : z ≤ 0 := le_of_not_ge hz
      have h1 : relu z = 0 := by
        simp [relu, hzle]
      have h2 : relu (-z) = -z := by
        have hpos : 0 ≤ -z := by linarith
        simp [relu, hpos]
      linarith
  have hrelu_sub' : ∀ z w : ℝ, w = -z → relu z - relu w = z := by
    intro z w hw
    rw [hw]
    exact hrelu_sub z
  have hBound_pos : ∀ j : ℕ, 0 < centeredMonomialFixedWidthBound Wmul j := by
    intro j
    refine Nat.strong_induction_on j ?_
    intro m ih
    cases m with
    | zero =>
        norm_num [centeredMonomialFixedWidthBound]
    | succ m =>
        cases m with
        | zero =>
            norm_num [centeredMonomialFixedWidthBound]
        | succ m =>
            have ih' : 0 < centeredMonomialFixedWidthBound Wmul (m + 1) :=
              ih (m + 1) (by omega)
            simp [centeredMonomialFixedWidthBound]
  have hErr_nonneg : ∀ j : ℕ, 0 ≤ centeredMonomialFixedWidthApproxError cMulErr R n j := by
    intro j
    refine Nat.strong_induction_on j ?_
    intro j ihj
    cases j with
    | zero =>
        simp [centeredMonomialFixedWidthApproxError]
    | succ j =>
        cases j with
        | zero =>
            simp [centeredMonomialFixedWidthApproxError]
        | succ j =>
            have ih' : 0 ≤ centeredMonomialFixedWidthApproxError cMulErr R n (j + 1) :=
              ihj (j + 1) (by omega)
            have hnRpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
            have hpow : 0 < (n : ℝ) ^ (-2 : ℝ) := by
              exact Real.rpow_pos_of_pos hnRpos (-2 : ℝ)
            have hmain :
                0 ≤ cMulErr * (R ^ (j + 1) +
                    centeredMonomialFixedWidthApproxError cMulErr R n (j + 1) +
                    R + 1) ^ 2 *
                    (n : ℝ) ^ (-2 : ℝ) +
                  (R ^ (j + 1) +
                    centeredMonomialFixedWidthApproxError cMulErr R n (j + 1) +
                    R + 1) *
                    centeredMonomialFixedWidthApproxError cMulErr R n (j + 1) := by
              positivity
            simpa [centeredMonomialFixedWidthApproxError] using hmain
  have hprod_le : ∀ (m : ℕ) (f : Fin m → ℝ), (∀ q : Fin m, |f q| ≤ R) →
      |∏ q : Fin m, f q| ≤ R ^ m := by
    intro m f hf
    calc
      |∏ q : Fin m, f q| = ∏ q : Fin m, |f q| := by
        rw [Finset.abs_prod]
      _ ≤ ∏ q : Fin m, R := by
        exact Finset.prod_le_prod (fun q hq => abs_nonneg (f q)) (fun q hq => hf q)
      _ = R ^ m := by
        simp
  have const_one_mem :
      (fun x : Fin d → ℝ => 1) ∈
        reluNetworkClass d 1 1 (fullyConnectedReLUParameterCount d 1 1) := by
    let Nc : FullyConnectedReLUNet d :=
      { depth := 1
        width := 1
        input := { weight := fun (_ : Fin 1) (_ : Fin d) => 0, bias := fun _ => 1 }
        hidden := fun i => (Nat.not_lt_zero i.val i.isLt).elim
        outputWeight := fun _ => 1
        outputBias := 0 }
    have hrealize : ∀ x, Nc.realize x = 1 := by
      intro x
      simp [Nc, FullyConnectedReLUNet.realize, FullyConnectedReLUNet.hiddenState,
        DenseLayer.reluApply, DenseLayer.apply, reluVec, relu, Fin.sum_univ_one]
    refine ⟨Nc, ?_, ?_, ?_, ?_, ?_⟩
    · norm_num [Nc]
    · norm_num [Nc]
    · norm_num [Nc]
    · rfl
    · intro x
      rw [hrealize x]
  have exact_affine_mem :
      ∀ j : Fin d,
        (fun x : Fin d → ℝ => x j - center j) ∈
          reluNetworkClass d 1 2 (fullyConnectedReLUParameterCount d 1 2) := by
    intro j
    let Na : FullyConnectedReLUNet d :=
      { depth := 1
        width := 2
        input :=
          { weight := fun o i => if i = j then (if o = 0 then 1 else -1) else 0
            bias := fun o => if o = 0 then -center j else center j }
        hidden := fun i => (Nat.not_lt_zero i.val i.isLt).elim
        outputWeight := fun o => if o = 0 then 1 else -1
        outputBias := 0 }
    have hrealize : ∀ x, Na.realize x = x j - center j := by
      intro x
      simp [Na, FullyConnectedReLUNet.realize, FullyConnectedReLUNet.hiddenState,
        DenseLayer.reluApply, DenseLayer.apply, reluVec, Fin.sum_univ_two]
      ring_nf
      apply hrelu_sub' (x j - center j)
      ring
    refine ⟨Na, ?_, ?_, ?_, ?_, ?_⟩
    · norm_num [Na]
    · norm_num [Na]
    · norm_num [Na]
    · rfl
    · intro x
      rw [hrealize x]
  have hcDepth_ge_one : (1 : ℝ) ≤ cDepth := by
    dsimp [cDepth]
    exact le_max_left 1 cMulDepth
  have hnR : (1 : ℝ) ≤ (n : ℝ) + 1 := by
    have h : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (Nat.succ_le_of_lt hn)
    nlinarith
  have hDle_base : (1 : ℝ) ≤ cDepth * ((n : ℝ) + 1) := by
    have h0 : (0 : ℝ) ≤ cDepth := le_of_lt hcDepth_pos
    calc
      1 = 1 * 1 := by norm_num
      _ ≤ cDepth * ((n : ℝ) + 1) := mul_le_mul hcDepth_ge_one hnR (by norm_num) h0
  dsimp [Wmono]
  clear Wmono hWmono_pos
  induction k with
  | zero =>
      refine ⟨1, fullyConnectedReLUParameterCount d 1 1, by norm_num, ?_, ?_, ?_⟩
      · simpa using hDle_base
      · simp [centeredMonomialFixedWidthBound]
      · refine ⟨fun x => 1, ?_, ?_⟩
        · simpa [centeredMonomialFixedWidthBound] using const_one_mem
        · intro x hbox
          simp [centeredMonomialFixedWidthApproxError, Fin.prod_univ_zero]
  | succ k ih =>
      cases k with
      | zero =>
          let j0 : Fin d := coord 0
          refine ⟨1, fullyConnectedReLUParameterCount d 1 2, by norm_num, ?_, ?_, ?_⟩
          · norm_num
            nlinarith [hDle_base]
          · simp [centeredMonomialFixedWidthBound]
          · refine ⟨fun x => x j0 - center j0, ?_, ?_⟩
            · simpa [centeredMonomialFixedWidthBound] using exact_affine_mem j0
            · intro x hbox
              simp [centeredMonomialFixedWidthApproxError, Fin.prod_univ_one, j0]
      | succ m =>
          let coord' : Fin (m + 1) → Fin d := fun q => coord (Fin.castSucc q)
          let jlast : Fin d := coord (Fin.last (m + 1))
          rcases ih coord' with ⟨Df, Pf, hDf_pos, hDf_le, hPf, hgf⟩
          rcases hgf with ⟨gf, hgf_mem, hgf_err⟩
          let R' : ℝ := R ^ (m + 1) +
            centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) + R + 1
          have hnRpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
          have hRpow_nonneg : 0 ≤ R ^ (m + 1) := by positivity
          have hR'_pos : 0 < R' := by
            dsimp [R']
            nlinarith [hR, hErr_nonneg (m + 1), hRpow_nonneg]
          have hcmul_le_cDepth : cMulDepth ≤ cDepth := le_max_right 1 cMulDepth
          have hsum_le_R' :
              centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) +
                  R ^ (m + 1) ≤ R' := by
            dsimp [R']
            nlinarith [hErr_nonneg (m + 1), hRpow_nonneg, hR]
          have hR_le_R' : R ≤ R' := by
            dsimp [R']
            nlinarith [hErr_nonneg (m + 1), hRpow_nonneg, hR]
          have happroxF_le : ∀ x : Fin d → ℝ,
              (∀ q : Fin d, |x q - center q| ≤ R) → |gf x| ≤ R' := by
            intro x hbox
            have htri :
                |gf x| ≤
                  |gf x - (∏ q : Fin (m + 1),
                    (x (coord' q) - center (coord' q)))| +
                    |∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))| := by
              simpa [sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using
                (abs_add_le
                  (gf x - (∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))))
                  (∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))))
            have hdiff :
                |gf x - ∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))| ≤
                  centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) := by
              exact hgf_err x hbox
            have htarget :
                |∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))| ≤
                  R ^ (m + 1) := by
              exact hprod_le (m + 1)
                (fun q => x (coord' q) - center (coord' q)) (fun q => hbox (coord' q))
            nlinarith [htri, hdiff, htarget, hsum_le_R']
          have happroxG_le : ∀ x : Fin d → ℝ,
              (∀ q : Fin d, |x q - center q| ≤ R) → |x jlast - center jlast| ≤ R' := by
            intro x hbox
            nlinarith [hbox jlast, hR_le_R']
          rcases exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget_depth_sum_bound
              (d := d) (Df := Df) (Dg := 1)
              (Wf := centeredMonomialFixedWidthBound Wmul (m + 1)) (Wg := 2)
              (Pf := Pf) (Pg := fullyConnectedReLUParameterCount d 1 2) (Wmul := Wmul)
              hDf_pos (by norm_num) (hBound_pos (m + 1)) (by norm_num) hWmul
              hcMulDepth hcMulErr hmul
              (domain := fun x : Fin d → ℝ => ∀ q : Fin d, |x q - center q| ≤ R)
              (targetF := fun x : Fin d → ℝ =>
                ∏ q : Fin (m + 1), (x (coord' q) - center (coord' q)))
              (approxF := gf)
              (targetG := fun x : Fin d → ℝ => x jlast - center jlast)
              (approxG := fun x : Fin d → ℝ => x jlast - center jlast)
              (ηf := centeredMonomialFixedWidthApproxError cMulErr R n (m + 1))
              (ηg := (0 : ℝ))
              (R := R')
              (hErr_nonneg (m + 1)) (by norm_num) hR'_pos
              hgf_mem
              (by simpa [jlast] using exact_affine_mem jlast)
              happroxF_le happroxG_le
              (fun x hbox => by nlinarith [hbox jlast, hR_le_R'])
              (fun x hbox => hgf_err x hbox)
              (fun x hbox => by simp)
              n hn
          with ⟨D, P, hD_pos, hD_le, hP, hg⟩
          rcases hg with ⟨hnet, hnet_mem, hnet_err⟩
          have hm_nonneg : (0 : ℝ) ≤ (↑(m + 1) : ℝ) := by
            exact_mod_cast (Nat.zero_le (m + 1))
          have hDmax_le : (↑(Df.max 1) : ℝ) ≤
              cDepth * (↑(m + 1) + 1) * (↑n + 1) := by
            rw [Nat.cast_max]
            apply max_le
            · exact hDf_le
            · have hDle_nonneg : (0 : ℝ) ≤ cDepth * ((↑n : ℝ) + 1) := by
                nlinarith [hcDepth_pos, hnRpos]
              have hone_le : (1 : ℝ) ≤ (↑(m + 1) : ℝ) + 1 := by
                nlinarith [hm_nonneg]
              have hprod : (1 : ℝ) ≤
                  cDepth * ((↑n : ℝ) + 1) * ((↑(m + 1) : ℝ) + 1) := by
                simpa using (mul_le_mul hDle_base hone_le (by norm_num) hDle_nonneg)
              simpa [mul_assoc, mul_comm, mul_left_comm] using hprod
          have hcMul_n : cMulDepth * (↑n : ℝ) ≤ cDepth * ((↑n : ℝ) + 1) := by
            have hn_nonneg : (0 : ℝ) ≤ (↑n : ℝ) := by exact_mod_cast (Nat.zero_le n)
            calc
              cMulDepth * (↑n : ℝ) ≤ cDepth * (↑n : ℝ) :=
                mul_le_mul_of_nonneg_right hcmul_le_cDepth hn_nonneg
              _ ≤ cDepth * ((↑n : ℝ) + 1) :=
                mul_le_mul_of_nonneg_left (by linarith) (le_of_lt hcDepth_pos)
          have hD_rhs : (↑(Df.max 1) : ℝ) + cMulDepth * (↑n : ℝ) ≤
              cDepth * (↑(m + 1 + 1) + 1) * (↑n + 1) := by
            calc
              (↑(Df.max 1) : ℝ) + cMulDepth * (↑n : ℝ)
                  ≤ cDepth * ((↑(m + 1) : ℝ) + 1) * ((↑n : ℝ) + 1) +
                      cDepth * ((↑n : ℝ) + 1) := by
                    nlinarith [hDmax_le, hcMul_n]
              _ = cDepth * ((↑(m + 1) : ℝ) + 2) * ((↑n : ℝ) + 1) := by
                ring
              _ = cDepth * (↑(m + 1 + 1) + 1) * ((↑n : ℝ) + 1) := by
                norm_cast
          have hDle : (D : ℝ) ≤ cDepth * (↑(m + 1 + 1) + 1) * (↑n + 1) := by
            nlinarith [hD_le, hD_rhs]
          have hm_succ : m + 1 + 1 = m + 2 := by omega
          refine ⟨D, P, hD_pos, hDle, ?_, ?_⟩
          · rw [hm_succ]
            exact hP
          · refine ⟨hnet, ?_, ?_⟩
            · rw [hm_succ]
              exact hnet_mem
            · intro x hbox
              have hprod : ∏ q : Fin (m + 1 + 1),
                    (x (coord q) - center (coord q)) =
                  (∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))) *
                    (x jlast - center jlast) := by
                rw [Fin.prod_univ_succAbove
                    (fun q : Fin (m + 1 + 1) => x (coord q) - center (coord q))
                    (Fin.last (m + 1))]
                simp [coord', jlast, Fin.succAbove_last]
                rw [mul_comm]
              calc
                |hnet x - ∏ q : Fin (m + 1 + 1),
                    (x (coord q) - center (coord q))|
                    = |hnet x -
                        (∏ q : Fin (m + 1), (x (coord' q) - center (coord' q))) *
                          (x jlast - center jlast)| := by
                        rw [hprod]
                _ ≤ cMulErr * R' ^ 2 * (↑n : ℝ).rpow (-2 : ℝ) +
                    R' * (0 : ℝ) + R' *
                      centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) := by
                        exact hnet_err x hbox
                _ = cMulErr * (R ^ (m + 1) +
                        centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) +
                        R + 1) ^ 2 *
                      (↑n : ℝ).rpow (-2 : ℝ) +
                    (R ^ (m + 1) +
                        centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) +
                        R + 1) *
                      centeredMonomialFixedWidthApproxError cMulErr R n (m + 1) := by
                        simp [R']
                _ = centeredMonomialFixedWidthApproxError cMulErr R n (m + 2) := by
                        rfl

/-- Compatibility form of
`exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget_explicit`.
The companion theorem exposes the depth constant selected by the construction;
this declaration retains the original public interface. -/
theorem exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget
    {d k Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ)) :
    ∃ Wmono : ℕ,
      0 < Wmono ∧
      Wmono = centeredMonomialFixedWidthBound Wmul k ∧
      ∃ cDepth : ℝ,
        0 < cDepth ∧
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
        ∀ center : Fin d → ℝ, ∀ coord : Fin k → Fin d,
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((k : ℝ) + 1) * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wmono ∧
            ∃ g : (Fin d → ℝ) → ℝ,
              g ∈ reluNetworkClass d D Wmono P ∧
                ∀ x : Fin d → ℝ,
                  (∀ q : Fin d, |x q - center q| ≤ R) →
                    |g x - ∏ q : Fin k, (x (coord q) - center (coord q))| ≤
                      centeredMonomialFixedWidthApproxError cMulErr R n k := by
  rcases
      exists_reluNetworkClass_centered_monomial_fixed_width_depth_rate_from_mul_gadget_explicit
        (d := d) (k := k) hWmul hcMulDepth hcMulErr hmul with
    ⟨Wmono, hWmono_pos, hWmono_eq, cDepth, hcDepth_pos, _hcDepth_eq, hspec⟩
  exact ⟨Wmono, hWmono_pos, hWmono_eq, cDepth, hcDepth_pos, hspec⟩

open Filter Topology

/-- Unit-radius fixed-width monomial approximation errors have a finite Taylor-index
sum that can be made arbitrarily small. -/
theorem exists_centeredMonomialFixedWidthApproxError_unit_radius_sigma_sum_le
    {d r : ℕ} {cMulErr A eta : ℝ}
    (hcMulErr_nonneg : 0 ≤ cMulErr) (hA_nonneg : 0 ≤ A) (heta : 0 < eta) :
    ∃ n : ℕ, 0 < n ∧
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialFixedWidthApproxError cMulErr 1 n a.1.val) ≤ eta := by
  have h_s1 : ∀ m : ℕ,
      Tendsto (fun n : ℕ =>
        Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n m)
        atTop (𝓝 0) := by
    let S : ℕ → ℕ → ℝ :=
      fun n m =>
        Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError cMulErr 1 n m
    have hInv1 : Tendsto (fun n : ℕ => (n : ℝ)⁻¹) atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    have hInv2 : Tendsto (fun n : ℕ => ((n : ℝ) ^ 2)⁻¹) atTop (𝓝 0) := by
      simpa [pow_two, mul_inv_rev] using hInv1.mul hInv1
    have hInv2r : Tendsto (fun n : ℕ => (n : ℝ).rpow (-2 : ℝ)) atTop (𝓝 0) := by
      simpa [Real.rpow_neg, Real.rpow_two] using hInv2
    have h_rec : ∀ n m : ℕ, S n (m + 2) =
        cMulErr * (3 + S n (m + 1)) ^ 2 * (n : ℝ).rpow (-2 : ℝ) +
          (3 + S n (m + 1)) * S n (m + 1) := by
      intro n m
      simp [S, Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError]
      ring
    have h_pair : ∀ m : ℕ,
        Tendsto (fun n : ℕ => S n m) atTop (𝓝 0) ∧
        Tendsto (fun n : ℕ => S n (m + 1)) atTop (𝓝 0) := by
      intro m
      induction m with
      | zero =>
          constructor
          · simpa [S, Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError] using
              (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
          · simpa [S, Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError] using
              (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
      | succ m ih =>
          constructor
          · exact ih.2
          · have hSm : Tendsto (fun n : ℕ => S n (m + 1)) atTop (𝓝 0) := ih.2
            have hB : Tendsto (fun n : ℕ => 3 + S n (m + 1)) atTop (𝓝 3) := by
              simpa using
                (tendsto_const_nhds : Tendsto (fun _ : ℕ => (3 : ℝ)) atTop (𝓝 3)).add hSm
            have hB2 : Tendsto (fun n : ℕ => (3 + S n (m + 1)) ^ 2)
                atTop (𝓝 (3 ^ 2)) := by
              simpa [pow_two] using hB.mul hB
            have hcB2 : Tendsto
                (fun n : ℕ => cMulErr * (3 + S n (m + 1)) ^ 2)
                atTop (𝓝 (cMulErr * 3 ^ 2)) := by
              simpa using
                (tendsto_const_nhds :
                  Tendsto (fun _ : ℕ => (cMulErr : ℝ)) atTop (𝓝 cMulErr)).mul hB2
            have hterm1 : Tendsto
                (fun n : ℕ =>
                  cMulErr * (3 + S n (m + 1)) ^ 2 * (n : ℝ).rpow (-2 : ℝ))
                atTop (𝓝 0) := by
              simpa using hcB2.mul hInv2r
            have hterm2 : Tendsto
                (fun n : ℕ => (3 + S n (m + 1)) * S n (m + 1))
                atTop (𝓝 0) := by
              simpa using hB.mul hSm
            have hsum : Tendsto
                (fun n : ℕ =>
                  cMulErr * (3 + S n (m + 1)) ^ 2 * (n : ℝ).rpow (-2 : ℝ) +
                    (3 + S n (m + 1)) * S n (m + 1))
                atTop (𝓝 0) := by
              simpa using hterm1.add hterm2
            have hgoal : Tendsto (fun n : ℕ => S n (m + 2)) atTop (𝓝 0) := by
              convert hsum using 1
              ext n
              rw [h_rec n m]
            exact hgoal
    intro m
    exact (h_pair m).1
  have h_s2 : Tendsto
      (fun n : ℕ =>
        ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError
            cMulErr 1 n a.1.val)
      atTop (𝓝 0) := by
    simpa using
      tendsto_finset_sum
        (f := fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
          fun n : ℕ =>
            Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError
              cMulErr 1 n a.1.val)
        (a := fun _ : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) => (0 : ℝ))
        Finset.univ (fun a _ => h_s1 a.1.val)
  have h_s3 : ∃ n : ℕ, 0 < n ∧
      A *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError
            cMulErr 1 n a.1.val) ≤
        eta := by
    let eps : ℝ := eta / (A + 1)
    have hden : 0 < A + 1 := by linarith
    have heps : 0 < eps := by
      dsimp [eps]
      exact div_pos heta hden
    have h_ev : ∀ᶠ n in atTop,
        |∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError
              cMulErr 1 n a.1.val| < eps := by
      have hdist := (Metric.tendsto_nhds.mp h_s2) eps heps
      filter_upwards [hdist] with n hn
      simpa [Real.dist_eq] using hn
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp h_ev
    let n0 : ℕ := max N 1
    have hn0_pos : 0 < n0 := by
      dsimp [n0]
      exact lt_of_lt_of_le (by norm_num : (0 : ℕ) < 1) (le_max_right N 1)
    have hn0_ge : N ≤ n0 := le_max_left N 1
    let s : ℝ := ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        Statlib.Nonparametric.Vocabulary.centeredMonomialFixedWidthApproxError
          cMulErr 1 n0 a.1.val
    have hS_bound : |s| < eps := by
      simpa [s] using hN n0 hn0_ge
    have hA_eps_le : A * eps ≤ eta := by
      calc
        A * eps = (A / (A + 1)) * eta := by
          dsimp [eps]
          ring
        _ ≤ 1 * eta := by
          have hAfrac : A / (A + 1) ≤ 1 := by
            rw [div_le_iff₀ hden]
            linarith
          exact mul_le_mul_of_nonneg_right hAfrac (le_of_lt heta)
        _ = eta := by ring
    refine ⟨n0, hn0_pos, ?_⟩
    show A * s ≤ eta
    calc
      A * s ≤ A * |s| := by
        exact mul_le_mul_of_nonneg_left (le_abs_self s) hA_nonneg
      _ ≤ A * eps := by
        exact mul_le_mul_of_nonneg_left (le_of_lt hS_bound) hA_nonneg
      _ ≤ eta := hA_eps_le
  exact h_s3

/-- Fixed-width finite centered-monomial polynomial approximants from a
multiplication gadget. -/
theorem exists_reluNetworkClass_finite_centered_monomial_polynomial_fixed_width_depth_rate_from_mul_gadget_explicit
    {ι : Type*} [DecidableEq ι]
    {d Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    (s : Finset ι) (degree : ι → ℕ)
    (coord : (i : ι) → Fin (degree i) → Fin d) (coeff : ι → ℝ) :
    ∃ Wpoly : ℕ,
      0 < Wpoly ∧
      Wpoly = finiteCenteredMonomialPolynomialFixedWidthBound Wmul s degree ∧
      ∃ cDepth : ℝ,
        0 < cDepth ∧
        cDepth = 1 + s.sum (fun i => max 1 cMulDepth * ((degree i : ℝ) + 1)) ∧
        ∀ n : ℕ, 0 < n →
        ∀ R : ℝ, 0 < R →
        ∀ center : Fin d → ℝ,
          ∃ D P : ℕ,
            0 < D ∧
            (D : ℝ) ≤ cDepth * ((n : ℝ) + 1) ∧
            P = fullyConnectedReLUParameterCount d D Wpoly ∧
            ∃ g : (Fin d → ℝ) → ℝ,
