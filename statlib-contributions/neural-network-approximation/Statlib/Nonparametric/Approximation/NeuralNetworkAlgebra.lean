                  intro j
                  exact (Classical.choose_spec (hg j)).2.1
                have hDc_mem : ∀ j : Fin m, g j ∈ reluNetworkClass d (Dc j) Wlocal (fullyConnectedReLUParameterCount d (Dc j) Wlocal) := by
                  intro j
                  exact (Classical.choose_spec (hg j)).2.2
                let S : ℕ := Finset.univ.sup Dc
                have hS_eq : S = (Finset.univ.sup Dc : ℕ) := rfl
                have hDc_le : ∀ j : Fin m, Dc j ≤ S := by
                  intro j
                  exact Finset.le_sup (s := Finset.univ) (f := Dc) (b := j) (by simp)
                exact ⟨S, Dc, hS_eq, hDc_le, hDc_pos, hDc_real, hDc_mem⟩
          -- @step s2: prove the cast bound (S : ℝ) ≤ M from the per-center real bounds
          have hSReal : ∀ (S : ℕ) (Dc : Fin m → ℕ),
              S = (Finset.univ.sup Dc : ℕ) →
              (∀ j : Fin m, (Dc j : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1)) →
              (S : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) := by
            intro S Dc hS_eq hDc_real
            let M : ℝ := cLocalDepth * ((n : ℝ) + 1)
            have hc_nonneg : 0 ≤ cLocalDepth := by linarith
            have hn_nonneg : 0 ≤ (n : ℝ) + 1 := by
              have hn_real : 0 < (n : ℝ) := by exact_mod_cast hn
              linarith
            have hM_nonneg : 0 ≤ M := by
              dsimp [M]
              exact mul_nonneg hc_nonneg hn_nonneg
            have hsub : ∀ s : Finset (Fin m), ((s.sup Dc : ℕ) : ℝ) ≤ M := by
              intro s
              exact Finset.induction_on s
                (by simp [Finset.sup_empty, hM_nonneg])
                (by
                  intro a s' ha_notin ih
                  rw [Finset.sup_insert]
                  rw [show (Dc a ⊔ s'.sup Dc : ℕ) = max (Dc a) (s'.sup Dc) by rfl]
                  rw [Nat.cast_max]
                  exact max_le (hDc_real a) ih)
            rw [hS_eq]
            exact hsub Finset.univ
          -- @step s3: Dlocal = max D0 S with positivity and budget from hDepthBound and hSReal
          have hDlocal : ∀ (S : ℕ),
              (S : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) →
              ∃ Dlocal : ℕ,
                0 < Dlocal ∧
                (Dlocal : ℝ) ≤ cLocalDepth * ((n : ℝ) + 1) ∧
                S ≤ Dlocal := by
            intro S hS
            rcases hDepthBound with ⟨D0, hD0pos, hD0bound⟩
            refine ⟨max D0 S, ?_, ?_, ?_⟩
            · exact lt_of_lt_of_le hD0pos (le_max_left D0 S)
            · rw [Nat.cast_max]
              exact max_le hD0bound hS
            · exact le_max_right D0 S
          -- @step s4: promote per-center memberships to the common Dlocal / Plocal and assemble the final existential
          have hAssemble : ∀ (Dlocal : ℕ) (S : ℕ) (Dc : Fin m → ℕ),
              (∀ j : Fin m, Dc j ≤ S) →
              (∀ j : Fin m, 0 < Dc j) →
              (∀ j : Fin m, g j ∈ reluNetworkClass d (Dc j) Wlocal (fullyConnectedReLUParameterCount d (Dc j) Wlocal)) →
              S ≤ Dlocal →
              ∃ Plocal : ℕ,
                Plocal = fullyConnectedReLUParameterCount d Dlocal Wlocal ∧
                (∀ j : Fin m, g j ∈ reluNetworkClass d Dlocal Wlocal Plocal) := by
                  intro Dlocal S Dc hDc_le_S hDcPos hDcMem hS_le_Dlocal
                  refine ⟨fullyConnectedReLUParameterCount d Dlocal Wlocal, rfl, ?_⟩
                  intro j
                  have hDc_le_Dlocal : Dc j ≤ Dlocal := le_trans (hDc_le_S j) hS_le_Dlocal
                  have hParamLe : fullyConnectedReLUParameterCount d (Dc j) Wlocal ≤
                      fullyConnectedReLUParameterCount d Dlocal Wlocal :=
                    hParamMono (Dc j) Dlocal (hDcPos j) hDc_le_Dlocal
                  rcases hDcMem j with ⟨N, hNdepthPos, hNdepth, hNwidth, hNparam, hNrealize⟩
                  exact ⟨N, hNdepthPos, le_trans hNdepth hDc_le_Dlocal, hNwidth,
                    le_trans hNparam hParamLe, hNrealize⟩
          rcases hS with ⟨S, Dc, hS_eq, hDc_le_S, hDcPos, hDcReal, hDcMem⟩
          rcases hDlocal S (hSReal S Dc hS_eq hDcReal) with ⟨Dlocal, hDlocalPos, hDlocalReal, hS_le_Dlocal⟩
          rcases hAssemble Dlocal S Dc hDc_le_S hDcPos hDcMem hS_le_Dlocal with ⟨Plocal, hPlocal, hMem⟩
          exact ⟨Dlocal, Plocal, hDlocalPos, hDlocalReal, hPlocal, hMem⟩
    exact hFinal
  -- @step s4: active-cell error bound |g j x - f x| ≤ localEps via network-to-Taylor-polynomial error, Taylor remainder and the first budget
  have hs4 :
      ∀ (beta C B R rho A : ℝ) (n : ℕ) (localEps : ℝ),
        0 ≤ beta → 0 ≤ C → 0 ≤ rho → 0 ≤ A → 0 < R → 0 < n →
        ∀ (domain : (Fin d → ℝ) → Prop) (f : (Fin d → ℝ) → ℝ),
          f ∈ holderSmoothBall r beta C B →
          ∀ (center scale : Fin m → Fin d → ℝ) (g : Fin m → (Fin d → ℝ) → ℝ),
            (∀ j : Fin m,
              ∀ (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
                |g j x - finiteLinearCombination
                    (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                    (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
                      (iteratedFDeriv ℝ a.1.val f (center j))
                        (fun q : Fin a.1.val =>
                          fun u : Fin d => if u = a.2 q then 1 else 0))
                    (fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                    x| ≤
                  A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                    centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)) →
            (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
              ∀ q : Fin d, |x q - center j q| ≤ R) →
            (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
              (∀ q : Fin d,
                scale j q *
                  (relu (x q - center j q) + relu (center j q - x q)) < 1) →
              ‖x - center j‖ ≤ rho) →
            A *
                (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)
              + C / (Nat.factorial r : ℝ) *
                  Real.rpow rho ((r : ℝ) + beta) ≤
                localEps →
            ∀ (j : Fin m) (x : Fin d → ℝ), domain x →
              (∀ q : Fin d,
                scale j q *
                  (relu (x q - center j q) + relu (center j q - x q)) < 1) →
              |g j x - f x| ≤ localEps := by
    intro beta C B R rho A n localEps hbeta hC hrho hA hR hn
    intro domain f hf
    intro center scale g hNet hBox hActive hBudget
    intro j x hdom hActiveCell
    let T : (Fin d → ℝ) → ℝ :=
      finiteLinearCombination
        (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
          (iteratedFDeriv ℝ a.1.val f (center j))
            (fun q : Fin a.1.val =>
              fun u : Fin d => if u = a.2 q then 1 else 0))
        (fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
    have hbox : ∀ q : Fin d, |x q - center j q| ≤ R := hBox j x hdom
    have hnorm : ‖x - center j‖ ≤ rho := hActive j x hdom hActiveCell
    have htaylor : |f x - T x| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
      exact (Statlib.Nonparametric.Approximation.NeuralNetworkAlgebra.holderSmoothBall_finite_centered_coordinate_polynomial_error_on_norm_ball
        hbeta hC hrho f hf (center j) x hnorm)
    have htaylor' : |T x - f x| ≤ C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
      rw [abs_sub_comm]
      exact htaylor
    calc
      |g j x - f x| = |(g j x - T x) + (T x - f x)| := by
        congr 1
        ring
      _ ≤ |g j x - T x| + |T x - f x| := by
        exact abs_add_le (g j x - T x) (T x - f x)
      _ ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) +
          C / (Nat.factorial r : ℝ) * Real.rpow rho ((r : ℝ) + beta) := by
        exact add_le_add (hNet j x hbox) htaylor'
      _ ≤ localEps := hBudget
  -- @step s5: output bound |g j x| ≤ productRadius via the Taylor-polynomial bound, the network error and the second budget
  have hs5 :
      ∀ (R A : ℝ) (n : ℕ) (productRadius : ℝ),
        0 ≤ A → 0 < R → 0 < n →
        ∀ (domain : (Fin d → ℝ) → Prop) (f : (Fin d → ℝ) → ℝ)
          (center : Fin m → Fin d → ℝ) (g : Fin m → (Fin d → ℝ) → ℝ),
          (∀ j : Fin m,
            ∀ (x : Fin d → ℝ), (∀ q : Fin d, |x q - center j q| ≤ R) →
              |g j x - finiteLinearCombination
                  (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
                  (fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
                    (iteratedFDeriv ℝ a.1.val f (center j))
                      (fun q : Fin a.1.val =>
                        fun u : Fin d => if u = a.2 q then 1 else 0))
                  (fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q)))
                  x| ≤
                A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                  centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)) →
          (∀ j : Fin m,
            ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
              |((Nat.factorial a.1.val : ℝ)⁻¹) *
                (iteratedFDeriv ℝ a.1.val f (center j))
                  (fun q : Fin a.1.val =>
                    fun u : Fin d => if u = a.2 q then 1 else 0)| ≤ A) →
          (∀ (j : Fin m) (x : Fin d → ℝ), domain x →
            ∀ q : Fin d, |x q - center j q| ≤ R) →
          A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                centeredMonomialFixedWidthApproxError cMulErr R n a.1.val)
            + A *
              (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
                R ^ a.1.val) ≤
              productRadius →
          ∀ (j : Fin m) (x : Fin d → ℝ), domain x → |g j x| ≤ productRadius := by
    intro R A n productRadius hA hR hn
    intro domain f center g hErr hCoeff hBox hBudget
    intro j x hdom
    let coeff : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ :=
      fun a => ((Nat.factorial a.1.val : ℝ)⁻¹) *
        (iteratedFDeriv ℝ a.1.val f (center j))
          (fun q : Fin a.1.val =>
            fun u : Fin d => if u = a.2 q then 1 else 0)
    let term : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → (Fin d → ℝ) → ℝ :=
      fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center j (a.2 q))
    let T : ℝ := finiteLinearCombination
      (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
      coeff term x
    have hbox : ∀ q : Fin d, |x q - center j q| ≤ R := hBox j x hdom
    have hErrb : |g j x - T| ≤
        A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) := by
      simpa [T] using hErr j x hbox
    have hmono : ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |term a x| ≤ R ^ a.1.val := by
      intro a
      calc
        |term a x| = ∏ q : Fin a.1.val, |x (a.2 q) - center j (a.2 q)| := by
          simp only [term]
          exact Finset.abs_prod Finset.univ
            (fun q : Fin a.1.val => x (a.2 q) - center j (a.2 q))
        _ ≤ ∏ q : Fin a.1.val, R := by
          exact Finset.prod_le_prod
            (fun q _ => abs_nonneg (x (a.2 q) - center j (a.2 q)))
            (fun q _ => hbox (a.2 q))
        _ = R ^ a.1.val := by
          simp
    have hprod : ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |coeff a * term a x| ≤ A * |term a x| := by
      intro a
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right (hCoeff j a) (abs_nonneg (term a x))
    have hTb : |T| ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        R ^ a.1.val) := by
      calc
        |T| ≤ ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            |coeff a * term a x| := by
          simp only [T, finiteLinearCombination]
          exact Finset.abs_sum_le_sum_abs
            (fun a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
              coeff a * term a x)
            Finset.univ
        _ ≤ ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            A * |term a x| := by
          exact Finset.sum_le_sum (fun a _ => hprod a)
        _ ≤ ∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            A * R ^ a.1.val := by
          exact Finset.sum_le_sum (fun a _ => mul_le_mul_of_nonneg_left (hmono a) hA)
        _ = A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            R ^ a.1.val) := by
          rw [← Finset.mul_sum]
    calc
      |g j x| = |(g j x - T) + T| := by rw [sub_add_cancel]
      _ ≤ |g j x - T| + |T| := abs_add_le _ _
      _ ≤ A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            centeredMonomialFixedWidthApproxError cMulErr R n a.1.val) +
          A * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
            R ^ a.1.val) := add_le_add hErrb hTb
      _ ≤ productRadius := hBudget
  -- finisher: compose hs1..hs5 into the conclusion
  rcases hs1 with ⟨Wlocal, hWpos, hWeq, cLocalDepth, hcLocalDepth_pos, hcLocalDepth_ge1, happrox⟩
  refine ⟨Wlocal, hWpos, hWeq, cLocalDepth, hcLocalDepth_pos, ?_⟩
  intro beta C B R rho A localEps productRadius hbeta hC hrho hA hR n hn domain f hf center scale hcoeff herrBudget houtputBudget hdom hcell
  rcases hs2 Wlocal cLocalDepth happrox beta C B R rho A localEps productRadius hbeta hC hrho hA hR n hn domain f hf center scale hcoeff with ⟨g, hgD, hgapprox⟩
  rcases hs3 Wlocal cLocalDepth n g hcLocalDepth_ge1 hn hgD with ⟨Dlocal, Plocal, hDpos, hDbudget, hPdef, hclass⟩
  refine ⟨Dlocal, Plocal, hDpos, hDbudget, hPdef, g, hclass, ?_, ?_⟩
  · exact hs4 beta C B R rho A n localEps hbeta hC hrho hA hR hn domain f hf center scale g hgapprox hdom hcell herrBudget
  · exact hs5 R A n productRadius hA hR hn domain f center g hgapprox hcoeff hdom houtputBudget


/-! ## Paper-Route Coding Gadgets and Two-Scale Budgets -/

theorem truncatedFloorReLUFunction_reluNetworkClass_and_eq_floor_on_away_integer_grid
    {B : ℕ} {R : ℝ} (hB : 0 < B) (hR : 0 < R) :
    (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R B (x 0)) ∈
        reluNetworkClass 1 1 (2 * B)
          (fullyConnectedReLUParameterCount 1 1 (2 * B)) ∧
      ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 →
        awayFromFiniteIntegerGrid R B z →
          truncatedFloorReLUFunction R B z = (Nat.floor z : ℝ) := by
  -- @step s1: construct the one-hidden-layer ReLU network and prove membership in reluNetworkClass
  have h_net : (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R B (x 0)) ∈
      reluNetworkClass 1 1 (2 * B) (fullyConnectedReLUParameterCount 1 1 (2 * B)) := by
    -- @step s1: construct the one-hidden-layer ReLU network N and prove its size bounds + pointwise identity
    have h_net_s1 : ∃ N : FullyConnectedReLUNet 1,
        0 < N.depth ∧ N.depth ≤ 1 ∧ N.width ≤ 2 * B ∧
          N.parameterCount ≤ fullyConnectedReLUParameterCount 1 1 (2 * B) ∧
          ∀ x : Fin 1 → ℝ, N.realize x = truncatedFloorReLUFunction R B (x 0) := by
      let N₀ : FullyConnectedReLUNet 1 :=
        { depth := 1,
          width := 2 * B,
          input :=
            { weight := fun _ _ => 1,
              bias := fun k : Fin (2 * B) =>
                -(((k.val / 2 + 1 : ℕ) : ℝ)) - (if k.val % 2 = 0 then 0 else R⁻¹) },
          hidden := Fin.elim0,
          outputWeight := fun k : Fin (2 * B) => if k.val % 2 = 0 then R else -R,
          outputBias := 0 }
      refine ⟨N₀, ?_, ?_, ?_, ?_, ?_⟩
      · norm_num [N₀]
      · norm_num [N₀]
      · exact le_rfl
      · exact le_rfl
      · intro x
        calc
          N₀.realize x
              = ∑ j : Fin (2 * B),
                  (if j.val % 2 = 0 then R else -R) *
                    relu (x 0 - ((j.val / 2 + 1 : ℕ) : ℝ) -
                      (if j.val % 2 = 0 then 0 else R⁻¹)) := by
            dsimp [N₀]
            simp only [FullyConnectedReLUNet.realize, FullyConnectedReLUNet.hiddenState,
              DenseLayer.reluApply, reluVec, DenseLayer.apply, Fin.sum_univ_one, add_zero]
            apply Finset.sum_congr rfl
            intro j hj
            congr 1
            · congr 1
              ring

          _ = ∑ i : Fin B, (R * relu (x 0 - ((i.val + 1 : ℕ) : ℝ)) + (-R) * relu (x 0 - ((i.val + 1 : ℕ) : ℝ) - R⁻¹)) := by
            let F : Fin (2 * B) → ℝ := fun j =>
              (if j.val % 2 = 0 then R else -R) *
                relu (x 0 - ((j.val / 2 + 1 : ℕ) : ℝ) -
                  (if j.val % 2 = 0 then 0 else R⁻¹))
            let H0 : Fin B → ℝ := fun i => R * relu (x 0 - ((i.val + 1 : ℕ) : ℝ))
            let H1 : Fin B → ℝ := fun i =>
              (-R) * relu (x 0 - ((i.val + 1 : ℕ) : ℝ) - R⁻¹)
            let e : Fin B × Fin 2 ≃ Fin (2 * B) :=
              { toFun := fun p => ⟨p.2.val + 2 * p.1.val, by omega⟩,
                invFun := fun j => (⟨j.val / 2, by omega⟩, ⟨j.val % 2, by omega⟩),
                left_inv := by
                  intro p
                  apply Prod.ext
                  · apply Fin.ext
                    simp
                    omega
                  · apply Fin.ext
                    simp
                right_inv := by
                  intro j
                  apply Fin.ext
                  simp
                  omega }
            calc
              (∑ j : Fin (2 * B), F j) = ∑ p : Fin B × Fin 2, F (e p) := by
                exact (Equiv.sum_comp e F).symm
              _ = ∑ p : Fin B × Fin 2, (if p.2.val = 0 then H0 p.1 else H1 p.1) := by
                apply Finset.sum_congr rfl
                intro p hp
                rcases p with ⟨i, a⟩
                fin_cases a
                · have h_eval : (e (i, 0)).val = 2 * i.val := by
                    simp [e]
                  simp [F, H0, H1]
                  rw [h_eval]
                  have hmod : (2 * i.val) % 2 = 0 := by omega
                  have hdiv : (2 * i.val) / 2 = i.val := by omega
                  rw [hmod, hdiv]
                  simp
                · have h_eval : (e (i, 1)).val = 1 + 2 * i.val := by
                    simp [e]
                  simp [F, H0, H1]
                  rw [h_eval]
                  have hmod : (1 + 2 * i.val) % 2 = 1 := by omega
                  have hdiv : (1 + 2 * i.val) / 2 = i.val := by omega
                  rw [hmod, hdiv]
                  simp
              _ = ∑ i : Fin B, (H0 i + H1 i) := by
                simp [Fintype.sum_prod_type, Fin.sum_univ_two]
              _ = ∑ i : Fin B, (R * relu (x 0 - ((i.val + 1 : ℕ) : ℝ)) + (-R) * relu (x 0 - ((i.val + 1 : ℕ) : ℝ) - R⁻¹)) := by
                rfl
          _ = ∑ i : Fin B, reluStepFunctionApprox R (i.val + 1 : ℝ) (x 0) := by
            apply Finset.sum_congr rfl
            intro i hi
            simp [reluStepFunctionApprox]
            ring
          _ = ∑ j ∈ Finset.Icc 1 B, reluStepFunctionApprox R (j : ℝ) (x 0) := by
            refine Finset.sum_bij (s := Finset.univ) (t := Finset.Icc 1 B)
              (i := fun a _ => a.val + 1) ?_ ?_ ?_ ?_
            · intro a ha
              simp
            · intro a₁ ha₁ a₂ ha₂ h
              apply Fin.ext
              have h' : a₁.val + 1 = a₂.val + 1 := by
                simpa using h
              omega
            · intro b hb
              have hb' : 1 ≤ b ∧ b ≤ B := by
                simpa using hb
              refine ⟨⟨b - 1, by omega⟩, by simp, ?_⟩
              change (b - 1) + 1 = b
              omega
            · intro a ha
              simpa
          _ = truncatedFloorReLUFunction R B (x 0) := by
            rfl
    rcases h_net_s1 with ⟨N, hN_depth_pos, hN_depth_le, hN_width_le, hN_param_le, hN_realize⟩
    -- @step s2: prove the pointwise realized-output identity N.realize x = the step-sum
    have h_net_s2 : ∀ x : Fin 1 → ℝ,
        N.realize x = Finset.sum (Finset.Icc 1 B)
          (fun j : ℕ => reluStepFunctionApprox R (j : ℝ) (x 0)) := by
      intro x
      change N.realize x = Statlib.Nonparametric.Vocabulary.truncatedFloorReLUFunction R B (x 0)
      exact hN_realize x
    -- @step s3: instantiate reluNetworkClass with N, the size facts, and the identity
    have h_net_s3 : (fun x : Fin 1 → ℝ => truncatedFloorReLUFunction R B (x 0)) ∈
        reluNetworkClass 1 1 (2 * B) (fullyConnectedReLUParameterCount 1 1 (2 * B)) := by
      refine ⟨N, hN_depth_pos, hN_depth_le, hN_width_le, hN_param_le, ?_⟩
      intro x
      exact (hN_realize x).symm
    exact h_net_s3
  -- @step s2: prove the per-threshold step identity for each j = 1..B
  have h_step : ∀ z : ℝ, 0 ≤ z → awayFromFiniteIntegerGrid R B z →
      ∀ j ∈ Finset.Icc 1 B,
        R * (relu (z - (j : ℝ)) - relu (z - (j : ℝ) - R⁻¹)) = (if (j : ℝ) ≤ z then 1 else 0 : ℝ) := by
    intro z hz haway
    intro j hj
    by_cases h : (j : ℝ) ≤ z
    · have hzsub : 0 ≤ z - (j : ℝ) := sub_nonneg.mpr h
      have hzsub_R : 0 ≤ z - (j : ℝ) - R⁻¹ := by
        have haway_j : R⁻¹ ≤ |z - (j : ℝ)| := haway j hj
        have haway_j' : R⁻¹ ≤ z - (j : ℝ) := by
          simpa [abs_of_nonneg hzsub] using haway_j
        linarith
      have hrelu1 : relu (z - (j : ℝ)) = z - (j : ℝ) := by
        unfold relu
        exact max_eq_left hzsub
      have hrelu2 : relu (z - (j : ℝ) - R⁻¹) = z - (j : ℝ) - R⁻¹ := by
        unfold relu
        exact max_eq_left hzsub_R
      have hcalc : R * (relu (z - (j : ℝ)) - relu (z - (j : ℝ) - R⁻¹)) = 1 := by
        rw [hrelu1, hrelu2]
        have hdiff : (z - (j : ℝ)) - (z - (j : ℝ) - R⁻¹) = R⁻¹ := by ring
        rw [hdiff]
        field_simp [ne_of_gt hR]
      rw [if_pos h]
      exact hcalc
    · have hzlt : z < (j : ℝ) := lt_of_not_ge h
      have hzsub_neg : z - (j : ℝ) < 0 := sub_neg.mpr hzlt
      have hzsub_R_neg : z - (j : ℝ) - R⁻¹ < 0 := by
        have hRinv : 0 < R⁻¹ := inv_pos.mpr hR
        linarith
      have hrelu1 : relu (z - (j : ℝ)) = 0 := by
        unfold relu
        exact max_eq_right (le_of_lt hzsub_neg)
      have hrelu2 : relu (z - (j : ℝ) - R⁻¹) = 0 := by
        unfold relu
        exact max_eq_right (le_of_lt hzsub_R_neg)
      have hcalc : R * (relu (z - (j : ℝ)) - relu (z - (j : ℝ) - R⁻¹)) = 0 := by
        rw [hrelu1, hrelu2]
        ring
      rw [if_neg h]
      exact hcalc
  -- @step s3: prove the finite sum identity (count of j in 1..B with j ≤ z equals Nat.floor z)
  have h_sum : ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 →
      Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if (j : ℝ) ≤ z then 1 else 0 : ℝ)) = (Nat.floor z : ℝ) := by
      -- @step s1: prove the floor upper bound ⌊z⌋₊ < B+1 (hence ⌊z⌋₊ ≤ B) from z < B+1
      have h_floor_lt : ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 → Nat.floor z < B + 1 := by
        intro z hz0 hzB
        have hzB' : z < ((B + 1 : ℕ) : ℝ) := by
          simpa using hzB
        exact (Nat.floor_lt (a := z) (n := B + 1) hz0).mpr hzB'
      -- @step s2: prove the real-vs-natural threshold equivalence (j:ℝ) ≤ z ↔ j ≤ ⌊z⌋₊
      have h_threshold : ∀ z : ℝ, 0 ≤ z → ∀ j : ℕ, ((j : ℝ) ≤ z ↔ j ≤ Nat.floor z) := by
        intro z hz0 j
        constructor
        · intro h
          exact Nat.le_floor h
        · intro h
          have hcast : (j : ℝ) ≤ (Nat.floor z : ℝ) := by
            exact_mod_cast h
          have hfloor : (Nat.floor z : ℝ) ≤ z := Nat.floor_le hz0
          linarith
      -- @step s3: transform the indicator sum over Icc 1 B into the constant sum over range ⌊z⌋₊
      have h_transform : ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 →
          Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if (j : ℝ) ≤ z then 1 else 0 : ℝ)) =
            Finset.sum (Finset.range (Nat.floor z)) (fun _ : ℕ => (1 : ℝ)) := by
        intro z hz0 hzB
        have hfloorleB : Nat.floor z ≤ B := by
          have hlt : Nat.floor z < B + 1 := h_floor_lt z hz0 hzB
          omega
        have hsum_rewrite :
            Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if (j : ℝ) ≤ z then 1 else 0 : ℝ)) =
              Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if j ≤ Nat.floor z then 1 else 0 : ℝ)) := by
          apply Finset.sum_congr rfl
          intro j hj
          simp [h_threshold z hz0 j]
        have hfilter :
            Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if j ≤ Nat.floor z then 1 else 0 : ℝ)) =
              Finset.sum ((Finset.Icc 1 B).filter (fun j => j ≤ Nat.floor z)) (fun _ : ℕ => (1 : ℝ)) := by
          exact (Finset.sum_filter (s := Finset.Icc 1 B) (p := fun j => j ≤ Nat.floor z)
            (f := fun _ : ℕ => (1 : ℝ))).symm
        have hbij :
            Finset.sum ((Finset.Icc 1 B).filter (fun j => j ≤ Nat.floor z)) (fun _ : ℕ => (1 : ℝ)) =
              Finset.sum (Finset.range (Nat.floor z)) (fun _ : ℕ => (1 : ℝ)) := by
          apply Finset.sum_bij (fun a ha => a - 1)
          · intro a ha
            rw [Finset.mem_range]
            rw [Finset.mem_filter] at ha
            rcases ha with ⟨haIcc, haLe⟩
            change a ≤ Nat.floor z at haLe
            rw [Finset.mem_Icc] at haIcc
            rcases haIcc with ⟨h1a, _⟩
            omega
          · intro a₁ ha₁ a₂ ha₂ hEq
            rw [Finset.mem_filter] at ha₁ ha₂
            rcases ha₁ with ⟨haIcc₁, _⟩
            rcases ha₂ with ⟨haIcc₂, _⟩
            rw [Finset.mem_Icc] at haIcc₁ haIcc₂
            rcases haIcc₁ with ⟨h1a₁, _⟩
            rcases haIcc₂ with ⟨h1a₂, _⟩
            omega
          · intro b hb
            rw [Finset.mem_range] at hb
            refine ⟨b + 1, ?_, ?_⟩
            · rw [Finset.mem_filter]
              constructor
              · rw [Finset.mem_Icc]
                constructor
                · omega
                · exact le_trans (Nat.succ_le_of_lt hb) hfloorleB
              · exact Nat.succ_le_of_lt hb
            · omega
          · intro a ha
            rfl
        exact hsum_rewrite.trans (hfilter.trans hbij)
      -- @step s4: collapse the constant sum over range ⌊z⌋₊ to the cast (⌊z⌋₊ : ℝ)
      have h_collapse : ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 →
          Finset.sum (Finset.range (Nat.floor z)) (fun _ : ℕ => (1 : ℝ)) = (Nat.floor z : ℝ) := by
        intro z hz hzB
        rw [Finset.sum_const, Finset.card_range]
        simp
      exact fun z hz hzB => (h_transform z hz hzB).trans (h_collapse z hz hzB)
  -- @step s4: combine s1, s2, s3 into the target conjunction
  have h_eq : ∀ z : ℝ, 0 ≤ z → z < (B : ℝ) + 1 → awayFromFiniteIntegerGrid R B z →
      truncatedFloorReLUFunction R B z = (Nat.floor z : ℝ) := by
    intro z hz hzB haz
    unfold truncatedFloorReLUFunction
    calc
      (∑ j ∈ Finset.Icc 1 B, reluStepFunctionApprox R (j : ℝ) z)
          = Finset.sum (Finset.Icc 1 B) (fun j : ℕ => (if (j : ℝ) ≤ z then 1 else 0 : ℝ)) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            rw [reluStepFunctionApprox, ← mul_sub]
            exact h_step z hz haz j hj
      _ = (Nat.floor z : ℝ) := by
            exact h_sum z hz hzB
  exact ⟨h_net, h_eq⟩

theorem axisAlignedBoxIndicatorRamp_reluNetworkClass_and_exact_on_margin
    {d : ℕ} {R : ℝ} (hR : 0 < R) (lower upper : Fin d → ℝ) :
    (fun x : Fin d → ℝ => axisAlignedBoxIndicatorRamp R lower upper x) ∈
        reluNetworkClass d 2 (2 * d + 1)
          (fullyConnectedReLUParameterCount d 2 (2 * d + 1)) ∧
      (∀ x : Fin d → ℝ,
        (∀ q : Fin d, lower q ≤ x q ∧ x q ≤ upper q) →
          axisAlignedBoxIndicatorRamp R lower upper x = 1) ∧
      (∀ x : Fin d → ℝ,
        (∃ q : Fin d, x q ≤ lower q - R⁻¹ ∨ upper q + R⁻¹ ≤ x q) →
          axisAlignedBoxIndicatorRamp R lower upper x = 0) := by
  constructor
  · -- membership
    · -- membership
      let w : ℕ := 2 * d + 1
      let loIdx : Fin d → Fin w := fun q => ⟨q.val + 1, by
        dsimp [w]
        omega⟩
      let hiIdx : Fin d → Fin w := fun q => ⟨d + 1 + q.val, by
        dsimp [w]
        omega⟩
      let inputLayer : DenseLayer d w :=
        { weight := fun j i =>
            if j.val = i.val + 1 then -1
            else if j.val = d + 1 + i.val then 1
            else 0
          bias := fun j =>
            if hz : j.val = 0 then 0
            else if hl : j.val ≤ d then lower ⟨j.val - 1, by omega⟩
            else -(upper ⟨j.val - 1 - d, by
              have hjw : j.val < 2 * d + 1 := by simpa [w] using j.isLt
              omega⟩) }
      let H : DenseLayer w w :=
        { weight := fun j k => if j.val = 0 then -R else 0
          bias := fun j => if j.val = 0 then 1 else 0 }
      let N : FullyConnectedReLUNet d :=
        { depth := 2
          width := w
          input := inputLayer
          hidden := fun _ : Fin (2 - 1) => H
          outputWeight := fun j => if j.val = 0 then 1 else 0
          outputBias := 0 }
      change ∃ N : FullyConnectedReLUNet d,
        0 < N.depth ∧ N.depth ≤ 2 ∧ N.width ≤ 2 * d + 1 ∧
          N.parameterCount ≤ fullyConnectedReLUParameterCount d 2 (2 * d + 1) ∧
            ∀ x : Fin d → ℝ, axisAlignedBoxIndicatorRamp R lower upper x = N.realize x
      refine ⟨N, ?_, ?_, ?_, ?_, ?_⟩
      · norm_num [N]
      · norm_num [N]
      · rfl
      · simp [N, FullyConnectedReLUNet.parameterCount, w]
      · intro x
        have hinput_zero : inputLayer.apply x (0 : Fin w) = 0 := by
          have hw : ∀ i : Fin d, inputLayer.weight (0 : Fin w) i = 0 := by
            intro i
            have h1 : ¬(0 = i.val + 1) := by omega
            have h2 : ¬(0 = d + 1 + i.val) := by omega
            simp [inputLayer, w, h1, h2]
          have hb : inputLayer.bias (0 : Fin w) = 0 := by
            simp [inputLayer, w]
          simp [DenseLayer.apply, hw, hb, w]
        have hinput_lo : ∀ q : Fin d, inputLayer.apply x (loIdx q) = lower q - x q := by
          intro q
          have hw : (∑ i : Fin d, inputLayer.weight (loIdx q) i * x i) = -x q := by
            have hweight : ∀ i : Fin d, inputLayer.weight (loIdx q) i = if i = q then -1 else 0 := by
              intro i
              by_cases h : i = q
              · subst h
                simp [inputLayer, loIdx, w]
              · have hneq : ¬(q.val + 1 = i.val + 1) := by
                  intro hh
                  apply h
                  ext
                  omega
                have hnot : ¬(q.val + 1 = d + 1 + i.val) := by omega
                have hval : ¬(q.val = i.val) := by
                  intro hv
                  apply h
                  ext
                  exact hv.symm
                simp [inputLayer, loIdx, w, hneq, hnot, hval, h]
            calc
              (∑ i : Fin d, inputLayer.weight (loIdx q) i * x i)
                  = ∑ i : Fin d, (if i = q then -1 else 0) * x i := by
                    apply Finset.sum_congr rfl
                    intro i hi
                    rw [hweight i]
              _ = -x q := by
                    simp
          have hb : inputLayer.bias (loIdx q) = lower q := by
            have hz : ¬(q.val + 1 = 0) := by omega
            have hl : q.val + 1 ≤ d := by omega
            have hq : ⟨q.val + 1 - 1, by omega⟩ = q := by
              ext
              change q.val + 1 - 1 = q.val
              omega
            simp [inputLayer, loIdx, w, hz, hl, hq]
          calc
            inputLayer.apply x (loIdx q)
                = (∑ i : Fin d, inputLayer.weight (loIdx q) i * x i) + inputLayer.bias (loIdx q) := by
                  simp [DenseLayer.apply]
            _ = -x q + lower q := by
                  rw [hw, hb]
            _ = lower q - x q := by
                  ring
        have hinput_hi : ∀ q : Fin d, inputLayer.apply x (hiIdx q) = x q - upper q := by
          intro q
          have hw : (∑ i : Fin d, inputLayer.weight (hiIdx q) i * x i) = x q := by
            have hweight : ∀ i : Fin d, inputLayer.weight (hiIdx q) i = if i = q then 1 else 0 := by
              intro i
              by_cases h : i = q
              · subst h
                have hnot : ¬(d + 1 + i.val = i.val + 1) := by omega
                simp [inputLayer, hiIdx, w, hnot]
              · have hneq : ¬(d + 1 + q.val = i.val + 1) := by omega
                have hnot : ¬(d + 1 + q.val = d + 1 + i.val) := by
                  intro hh
                  apply h
                  ext
                  omega
                have hval : ¬(q.val = i.val) := by
                  intro hv
                  apply h
                  ext
                  exact hv.symm
                simp [inputLayer, hiIdx, w, hneq, hnot, hval, h]
            calc
              (∑ i : Fin d, inputLayer.weight (hiIdx q) i * x i)
                  = ∑ i : Fin d, (if i = q then 1 else 0) * x i := by
                    apply Finset.sum_congr rfl
                    intro i hi
                    rw [hweight i]
              _ = x q := by
                    simp
          have hb : inputLayer.bias (hiIdx q) = -(upper q) := by
            have hz : ¬(d + 1 + q.val = 0) := by omega
            have hnhl : ¬(d + 1 + q.val ≤ d) := by omega
            have hq : ⟨d + 1 + q.val - 1 - d, by omega⟩ = q := by
              ext
              change d + 1 + q.val - 1 - d = q.val
              omega
            simp [inputLayer, hiIdx, w, hz, hnhl, hq]
          calc
            inputLayer.apply x (hiIdx q)
                = (∑ i : Fin d, inputLayer.weight (hiIdx q) i * x i) + inputLayer.bias (hiIdx q) := by
                  simp [DenseLayer.apply]
            _ = x q + (-(upper q)) := by
                  rw [hw, hb]
            _ = x q - upper q := by
                  ring
        let v : Fin w → ℝ := fun k => relu (inputLayer.apply x k)
        have hv_zero : v (0 : Fin w) = 0 := by
          simp [v, hinput_zero, relu]
        have hv_lo : ∀ q : Fin d, v (loIdx q) = relu (lower q - x q) := by
          intro q
          simp [v, hinput_lo q]
        have hv_hi : ∀ q : Fin d, v (hiIdx q) = relu (x q - upper q) := by
          intro q
          simp [v, hinput_hi q]
        have hdecomp :
            (∑ k : Fin w, v k) =
              v (0 : Fin w) + (∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q)) := by
          have h0 : (∑ k : Fin w, (if k.val = 0 then v k else 0)) = v (0 : Fin w) := by
            refine Finset.sum_eq_single (0 : Fin w) ?_ ?_
            · intro k hk hne
              have hk0 : ¬k.val = 0 := by
                intro hz
                apply hne
                apply Fin.ext
                simpa using hz
              simp [hk0]
            · simp
          have hrest : (∑ k : Fin w, (if k.val ≠ 0 then v k else 0)) =
              (∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q)) := by
            have hbij :
                ((Finset.univ : Finset (Fin w)).filter (fun k : Fin w => k.val ≠ 0)).sum v =
                  (∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q)) := by
              let e : Fin d ⊕ Fin d → Fin w := fun a =>
                match a with
                | Sum.inl q => loIdx q
                | Sum.inr q => hiIdx q
              have he : ∀ a : Fin d ⊕ Fin d,
                  e a ∈ (Finset.univ : Finset (Fin w)).filter (fun k : Fin w => k.val ≠ 0) := by
                intro a
                rcases a with q | q
                · simp [e, loIdx]
                · simp [e, hiIdx]
              have hinj : ∀ a b : Fin d ⊕ Fin d, e a = e b → a = b := by
                intro a b hab
                rcases a with q | q <;> rcases b with q' | q'
                · apply congrArg Sum.inl
                  ext
                  have hval : q.val + 1 = q'.val + 1 := by
                    have hh := congrArg Fin.val hab
                    simpa [e, loIdx] using hh
                  omega
                · exfalso
                  have hval : q.val + 1 = d + 1 + q'.val := by
                    have hh := congrArg Fin.val hab
                    simpa [e, loIdx, hiIdx] using hh
                  omega
                · exfalso
                  have hval : d + 1 + q.val = q'.val + 1 := by
                    have hh := congrArg Fin.val hab
                    simpa [e, loIdx, hiIdx] using hh
                  omega
                · apply congrArg Sum.inr
                  ext
                  have hval : d + 1 + q.val = d + 1 + q'.val := by
                    have hh := congrArg Fin.val hab
                    simpa [e, hiIdx] using hh
                  omega
              have hsurj : ∀ b : Fin w,
                  b ∈ (Finset.univ : Finset (Fin w)).filter (fun k : Fin w => k.val ≠ 0) →
                    ∃ a : Fin d ⊕ Fin d, e a = b := by
                intro b hb
                have hb0 : b.val ≠ 0 := by simpa using (Finset.mem_filter.mp hb).2
                by_cases hbl : b.val ≤ d
                · refine ⟨Sum.inl ⟨b.val - 1, ?_⟩, ?_⟩
                  · omega
                  · simp [e, loIdx]
                    ext
                    simp
                    omega
                · refine ⟨Sum.inr ⟨b.val - 1 - d, ?_⟩, ?_⟩
                  · have hbw : b.val < 2 * d + 1 := by simpa [w] using b.isLt
                    omega
                  · simp [e, hiIdx]
                    ext
                    simp
                    omega
              calc
                ((Finset.univ : Finset (Fin w)).filter (fun k : Fin w => k.val ≠ 0)).sum v
                    = (Finset.univ : Finset (Fin d ⊕ Fin d)).sum (fun a => v (e a)) := by
                      exact (Finset.sum_bij (fun a _ => e a) (fun a ha => he a)
                        (fun a ha b hb hab => hinj a b hab)
                        (fun b hb => by rcases hsurj b hb with ⟨a, hab⟩; exact ⟨a, Finset.mem_univ a, hab⟩)
                        (by intro a ha; rfl)).symm
                _ = (∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q)) := by
                      simp [e, Fintype.sum_sum_type]
            rw [← Finset.sum_filter (fun k : Fin w => k.val ≠ 0) v]
            exact hbij
          calc
            (∑ k : Fin w, v k)
                = (∑ k : Fin w, (if k.val = 0 then v k else 0)) + (∑ k : Fin w, (if k.val ≠ 0 then v k else 0)) := by
                  rw [← Finset.sum_add_distrib]
                  apply Finset.sum_congr rfl
                  intro k hk
                  by_cases h : k.val = 0 <;> simp [h]
            _ = v (0 : Fin w) + ((∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q))) := by
                  rw [h0, hrest]
            _ = v (0 : Fin w) + (∑ q : Fin d, v (loIdx q)) + (∑ q : Fin d, v (hiIdx q)) := by
                  abel

        have happly : H.apply v (0 : Fin w) = 1 - R * (∑ k : Fin w, v k) := by
          calc
            H.apply v (0 : Fin w)
                = (∑ k : Fin w, H.weight (0 : Fin w) k * v k) + H.bias (0 : Fin w) := by
                  simp [DenseLayer.apply]
            _ = (∑ k : Fin w, (-R) * v k) + 1 := by
                  simp [H]
            _ = -R * (∑ k : Fin w, v k) + 1 := by
                  rw [← Finset.mul_sum]
            _ = 1 - R * (∑ k : Fin w, v k) := by
                  ring
        have hreluH : H.reluApply v (0 : Fin w) = relu (1 - R * (∑ k : Fin w, v k)) := by
          simp [DenseLayer.reluApply, reluVec, happly]
        have hvdef : N.input.reluApply x = v := by
          funext k
          simp [N, v, DenseLayer.reluApply, reluVec, w]
        have hdepth1 : N.depth - 1 = 1 := by norm_num [N]
        have hstate0 : N.hiddenState x 0 = v := by
          simp [N, FullyConnectedReLUNet.hiddenState, hvdef, w]
        have hstate : N.hiddenState x 1 = H.reluApply v := by
          simp [N, FullyConnectedReLUNet.hiddenState, hstate0, w]
          change H.reluApply (N.input.reluApply x) = H.reluApply v
          rw [hvdef]
        have hrealize : N.realize x = relu (1 - R * (∑ k : Fin w, v k)) := by
          calc
            N.realize x = ∑ j : Fin w, (if j.val = 0 then 1 else 0) * H.reluApply v j := by
              simp [N, FullyConnectedReLUNet.realize, hdepth1, hstate, w]
            _ = H.reluApply v (0 : Fin w) := by
              let f : Fin w → ℝ := fun j => (if j.val = 0 then 1 else 0) * H.reluApply v j
              have hf0 : f (0 : Fin w) = H.reluApply v (0 : Fin w) := by
                simp [f]
              rw [← hf0]
              refine Finset.sum_eq_single (0 : Fin w) ?_ ?_
              · intro j hj hne
                have hj0 : ¬j.val = 0 := by
                  intro hz
                  apply hne
                  apply Fin.ext
                  simpa using hz
                simp [f, hj0]
              · simp
            _ = relu (1 - R * (∑ k : Fin w, v k)) := hreluH
        have hfinal : axisAlignedBoxIndicatorRamp R lower upper x = N.realize x := by
          calc
            axisAlignedBoxIndicatorRamp R lower upper x
                = relu (1 - R * (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q)))) := by
                  rfl
            _ = relu (1 - R * (∑ k : Fin w, v k)) := by
                  apply congrArg relu; simp [hdecomp, hv_zero, hv_lo, hv_hi, Finset.sum_add_distrib]
            _ = N.realize x := hrealize.symm
        exact hfinal
  · constructor
    · -- inside box -> 1
      intro x hx
      unfold axisAlignedBoxIndicatorRamp
      have hsum : (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) = 0 := by
        refine Finset.sum_eq_zero ?_
        intro q _
        have hl : lower q - x q ≤ 0 := by linarith [(hx q).1]
        have hu : x q - upper q ≤ 0 := by linarith [(hx q).2]
        simp [relu, hl, hu, max_eq_left]
      rw [hsum]
      simp [relu, max_eq_left]
    · -- outside by margin -> 0
      intro x hx
      rcases hx with ⟨q, hq⟩
      unfold axisAlignedBoxIndicatorRamp
      have hRinv : 0 < R⁻¹ := inv_pos.mpr hR
      have hrelu_nonneg : ∀ t : ℝ, 0 ≤ relu t := by
        intro t
        simp [relu, le_max_right]
      have hsum_ge : R⁻¹ ≤ (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) := by
        have hterm : R⁻¹ ≤ relu (lower q - x q) + relu (x q - upper q) := by
          rcases hq with hlow | hup
          · have hge : R⁻¹ ≤ lower q - x q := by linarith
            have hpos : 0 ≤ lower q - x q := by linarith [hge, hRinv]
            have hrelu1 : relu (lower q - x q) = lower q - x q := by
              simp [relu, hpos, max_eq_right]
            rw [hrelu1]
            linarith [hge, hrelu_nonneg (x q - upper q)]
          · have hge : R⁻¹ ≤ x q - upper q := by linarith
            have hpos : 0 ≤ x q - upper q := by linarith [hge, hRinv]
            have hrelu2 : relu (x q - upper q) = x q - upper q := by
              simp [relu, hpos, max_eq_right]
            rw [hrelu2]
            linarith [hge, hrelu_nonneg (lower q - x q)]
        exact le_trans hterm (Finset.single_le_sum (by
          intro q' _
          exact add_nonneg (hrelu_nonneg (lower q' - x q')) (hrelu_nonneg (x q' - upper q'))) (Finset.mem_univ q))
      have hmul : R * R⁻¹ ≤ R * (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) := by
        exact mul_le_mul_of_nonneg_left hsum_ge (le_of_lt hR)
      have hone : 1 ≤ R * (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) := by
        calc
          1 = R * R⁻¹ := (mul_inv_cancel₀ hR.ne').symm
          _ ≤ R * (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) := hmul
      have hnonpos : 1 - R * (∑ q : Fin d, (relu (lower q - x q) + relu (x q - upper q))) ≤ 0 := by
        linarith
      have hnonpos' : 1 - R * (∑ q : Fin d, (max (lower q - x q) 0 + max (x q - upper q) 0)) ≤ 0 := by
        simpa [relu] using hnonpos
      simp [relu, hnonpos', max_eq_right]

theorem finite_bounded_real_table_quantization_and_base_code
    {ι : Type*} [Fintype ι] {N Q base : ℕ}
    (e : ι ≃ Fin N) {A eta : ℝ}
    (hA : 0 ≤ A) (heta : 0 < eta) (hQ : 0 < Q)
    (hmesh : 2 * A / (Q : ℝ) ≤ eta)
    (hbase : Q + 1 ≤ base)
    (table : ι → ℝ)
    (htable : ∀ i : ι, |table i| ≤ A) :
    ∃ digit : Fin N → ℕ,
      (∀ k : Fin N, digit k ≤ Q) ∧
      (∀ k : Fin N, digit k < base) ∧
      (∃ code : ℕ,
        code = ∑ k : Fin N, digit k * base ^ k.val ∧
        ∀ k : Fin N, (code / base ^ k.val) % base = digit k) ∧
      ∃ decoded : ι → ℝ,
        (∀ i : ι,
          decoded i = -A + (2 * A / (Q : ℝ)) * (digit (e i) : ℝ)) ∧
        (∀ i : ι, |decoded i - table i| ≤ eta) ∧
        (∀ i : ι, |decoded i| ≤ A + eta) := by
  by_cases hAz : A = 0
  · refine ⟨fun _ => 0, ?_, ?_, ?_, ?_⟩
    · intro k
      simpa using (le_of_lt hQ)
    · intro k
      simpa using (by omega : 0 < base)
    · refine ⟨0, ?_, ?_⟩
      · simp
      · intro k
        simp
    · refine ⟨fun _ => 0, ?_, ?_, ?_⟩
      · intro i
        simp [hAz]
      · intro i
        have ht0 : table i = 0 := by
          have hle : |table i| ≤ 0 := by simpa [hAz] using htable i
          exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
        simpa [ht0] using (le_of_lt heta)
      · intro i
        simpa [hAz] using (le_of_lt heta)
  · have hApos : 0 < A := lt_of_le_of_ne hA (Ne.symm hAz)
    let mesh : ℝ := 2 * A / (Q : ℝ)
    have hQne : (Q : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hQ)
    have hmesh_pos : 0 < mesh := by
      dsimp [mesh]
      exact div_pos (mul_pos (by norm_num) hApos) (by exact_mod_cast hQ)
    let digit : Fin N → ℕ := fun k => Nat.floor ((table (e.symm k) + A) / mesh)
    let f : Fin N → ℕ := fun j => digit j * base ^ j.val
    have hdig_le : ∀ k : Fin N, digit k ≤ Q := by
      intro k
      have hxge0 : 0 ≤ (table (e.symm k) + A) / mesh := by
        exact div_nonneg (by linarith [(abs_le.mp (htable (e.symm k))).1]) (le_of_lt hmesh_pos)
      have hxle : (table (e.symm k) + A) / mesh ≤ Q := by
        have hdiv : (table (e.symm k) + A) / mesh ≤ (2 * A) / mesh := by
          exact div_le_div_of_nonneg_right (by linarith [(abs_le.mp (htable (e.symm k))).2]) (le_of_lt hmesh_pos)
        have h2A : (2 * A) / mesh = (Q : ℝ) := by
          have hmeshQ' : mesh * (Q : ℝ) = 2 * A := by
            dsimp [mesh]
            field_simp [hQne]
          calc
            (2 * A) / mesh = (mesh * (Q : ℝ)) / mesh := by rw [hmeshQ']
            _ = (Q : ℝ) := by
              rw [mul_comm]
              rw [div_eq_mul_inv]
              rw [mul_assoc]
              rw [mul_inv_cancel₀ (ne_of_gt hmesh_pos)]
              rw [mul_one]
        linarith
      have hfl : (Nat.floor ((table (e.symm k) + A) / mesh) : ℝ) ≤ Q := by
        exact le_trans (Nat.floor_le hxge0) hxle
      exact_mod_cast hfl
    have hdig_lt_base : ∀ k : Fin N, digit k < base := by
      intro k
      exact lt_of_le_of_lt (hdig_le k) (Nat.lt_of_succ_le hbase)
    let code : ℕ := ∑ k : Fin N, digit k * base ^ k.val
    have hrecover : ∀ k : Fin N, (code / base ^ k.val) % base = digit k := by
      intro k
      have hbase_pos : 0 < base := by omega
      have hpow_pos : 0 < base ^ k.val := pow_pos hbase_pos k.val
      let Thi : ℕ := (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => digit j * base ^ (j.val - k.val))
      have hsplit : code = (Finset.univ.filter (fun j : Fin N => j < k)).sum f
          + digit k * base ^ k.val
          + (Finset.univ.filter (fun j : Fin N => k < j)).sum f := by
        dsimp [code, f]
        rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun j : Fin N => j < k) (fun j => digit j * base ^ j.val)]
        have hnot : (Finset.univ.filter (fun j : Fin N => ¬ j < k)) = (Finset.univ.filter (fun j : Fin N => k ≤ j)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_univ, true_and]
          omega
        rw [hnot, add_assoc]
        congr 1
        have hs' : (Finset.univ.filter (fun j : Fin N => k ≤ j)) = insert k (Finset.univ.filter (fun j : Fin N => k < j)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
          constructor
          · intro hj
            by_cases hjk : j = k
            · exact Or.inl hjk
            · exact Or.inr (lt_of_le_of_ne hj (Ne.symm hjk))
          · intro h
            rcases h with rfl | hj
            · rfl
            · exact le_of_lt hj
        rw [hs']
        rw [Finset.sum_insert (by
          simp only [Finset.mem_filter, Finset.mem_univ, true_and]
          exact lt_irrefl k)]

      have hgeom1 : ∀ n : ℕ, (Finset.range n).sum (fun i : ℕ => (base - 1) * base ^ i) + 1 = base ^ n := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          rw [Finset.sum_range_succ]
          have hreassoc : (Finset.range n).sum (fun i : ℕ => (base - 1) * base ^ i) + (base - 1) * base ^ n + 1
              = (Finset.range n).sum (fun i : ℕ => (base - 1) * base ^ i) + 1 + (base - 1) * base ^ n := by omega
          rw [hreassoc]
          rw [ih]
          have hbase_ge1 : 1 ≤ base := by omega
          have hmul : (base - 1) * base ^ n + base ^ n = base ^ (n + 1) := by
            rw [pow_succ]
            have hsucc1 : base - 1 + 1 = base := by omega
            calc
              (base - 1) * base ^ n + base ^ n = (base - 1) * base ^ n + 1 * base ^ n := by rw [one_mul]
              _ = ((base - 1) + 1) * base ^ n := by rw [← Nat.add_mul]
              _ = base * base ^ n := by rw [hsucc1]
              _ = base ^ n * base := by rw [mul_comm]
          have hle : base ^ n ≤ base ^ (n + 1) := by
            exact pow_le_pow_right₀ hbase_ge1 (by omega)
          have hstep : (base - 1) * base ^ n = base ^ (n + 1) - base ^ n := by omega
          rw [hstep]
          omega
      have hgeom : (Finset.range k.val).sum (fun i : ℕ => (base - 1) * base ^ i) = base ^ k.val - 1 := by
        have hg := hgeom1 k.val
        omega
      have hreindex :
          (Finset.univ.filter (fun j : Fin N => j < k)).sum (fun j => (base - 1) * base ^ j.val)
            = (Finset.range k.val).sum (fun i : ℕ => (base - 1) * base ^ i) := by
        refine Finset.sum_bij (fun j _ => j.val) ?_ ?_ ?_ ?_
        · intro a ha
          exact Finset.mem_range.mpr (Finset.mem_filter.mp ha).2
        · intro a ha b hb h
          exact Fin.ext h
        · intro b hb
          refine ⟨⟨b, lt_trans (Finset.mem_range.mp hb) k.isLt⟩, ?_, rfl⟩
          rw [Finset.mem_filter]
          exact ⟨Finset.mem_univ _, Finset.mem_range.mp hb⟩
        · intro a ha
          rfl
      have hSlo_lt : (Finset.univ.filter (fun j : Fin N => j < k)).sum f < base ^ k.val := by
        calc
          (Finset.univ.filter (fun j : Fin N => j < k)).sum f
              ≤ (Finset.univ.filter (fun j : Fin N => j < k)).sum (fun j => (base - 1) * base ^ j.val) := by
                exact Finset.sum_le_sum (by
                  intro j hj
                  have hdj : digit j ≤ Q := hdig_le j
                  have hbd : digit j ≤ base - 1 := by
                    simpa using Nat.le_pred_of_lt (Nat.lt_of_succ_le (le_trans (Nat.succ_le_succ hdj) hbase))
                  exact mul_le_mul_of_nonneg_right hbd (Nat.zero_le _))
          _ = (Finset.range k.val).sum (fun i : ℕ => (base - 1) * base ^ i) := hreindex
          _ = base ^ k.val - 1 := hgeom
          _ < base ^ k.val := by
                have hp : 0 < base ^ k.val := pow_pos hbase_pos k.val
                omega
      have hterm (j : Fin N) (hj : k < j) :
          digit j * base ^ j.val = base ^ k.val * (digit j * base ^ (j.val - k.val)) := by
        have hkj : k.val ≤ j.val := by
          exact le_of_lt hj
        have hpow := Nat.pow_sub_mul_pow base (m := k.val) (n := j.val) hkj
        calc
          digit j * base ^ j.val = digit j * (base ^ (j.val - k.val) * base ^ k.val) := by rw [← hpow]
          _ = base ^ k.val * (digit j * base ^ (j.val - k.val)) := by ring
      have hfac : digit k * base ^ k.val + (Finset.univ.filter (fun j : Fin N => k < j)).sum f
          = base ^ k.val * (digit k + Thi) := by
        calc
          digit k * base ^ k.val + (Finset.univ.filter (fun j : Fin N => k < j)).sum f
              = base ^ k.val * digit k + (Finset.univ.filter (fun j : Fin N => k < j)).sum f := by rw [mul_comm (digit k) (base ^ k.val)]
          _ = base ^ k.val * digit k + (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => base ^ k.val * (digit j * base ^ (j.val - k.val))) := by
                rw [Finset.sum_congr rfl (by intro j hj; exact hterm j (Finset.mem_filter.mp hj).2)]
          _ = base ^ k.val * digit k + base ^ k.val * (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => digit j * base ^ (j.val - k.val)) := by
                rw [← Finset.mul_sum]
          _ = base ^ k.val * (digit k + Thi) := by
                dsimp [Thi]
                rw [mul_add]
      have hdiv : code / base ^ k.val
          = (Finset.univ.filter (fun j : Fin N => j < k)).sum f / base ^ k.val + (digit k + Thi) := by
        rw [hsplit]
        rw [add_assoc]
        rw [hfac]
        have hmul : base ^ k.val * (digit k + Thi) = (digit k + Thi) * base ^ k.val := by rw [mul_comm]
        rw [hmul]
        rw [Nat.add_mul_div_right ((Finset.univ.filter (fun j : Fin N => j < k)).sum f) (digit k + Thi) hpow_pos]
      have hSlo_div : (Finset.univ.filter (fun j : Fin N => j < k)).sum f / base ^ k.val = 0 := by
        exact Nat.div_eq_of_lt hSlo_lt
      have hcode_div : code / base ^ k.val = digit k + Thi := by
        rw [hdiv, hSlo_div, zero_add]
      have hThi_mul : Thi = base * (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => digit j * base ^ (j.val - k.val - 1)) := by
        dsimp [Thi]
        have hterm2 (j : Fin N) (hj : k < j) :
            digit j * base ^ (j.val - k.val) = base * (digit j * base ^ (j.val - k.val - 1)) := by
          have hpos : 0 < j.val - k.val := by
            have : k.val < j.val := by exact hj
            omega
          have hsucc : j.val - k.val = (j.val - k.val - 1) + 1 := by omega
          calc
            digit j * base ^ (j.val - k.val) = digit j * base ^ ((j.val - k.val - 1) + 1) := by
              nth_rewrite 1 [hsucc]
              rfl
            _ = digit j * (base ^ (j.val - k.val - 1) * base) := by rw [pow_succ]
            _ = base * (digit j * base ^ (j.val - k.val - 1)) := by ring
        calc
          (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => digit j * base ^ (j.val - k.val))
              = (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => base * (digit j * base ^ (j.val - k.val - 1))) := by
                rw [Finset.sum_congr rfl (by intro j hj; exact hterm2 j (Finset.mem_filter.mp hj).2)]
          _ = base * (Finset.univ.filter (fun j : Fin N => k < j)).sum (fun j => digit j * base ^ (j.val - k.val - 1)) := by
                rw [← Finset.mul_sum]
      have hmod : (digit k + Thi) % base = digit k := by
        rw [hThi_mul]
        rw [Nat.add_mul_mod_self_left]
        exact Nat.mod_eq_of_lt (hdig_lt_base k)
      calc
        (code / base ^ k.val) % base = (digit k + Thi) % base := by rw [hcode_div]
        _ = digit k := hmod
    let decoded : ι → ℝ := fun i => -A + mesh * (digit (e i) : ℝ)
    have hdigit_floor (i : ι) : digit (e i) = Nat.floor ((table i + A) / mesh) := by
      dsimp [digit]
      rw [Equiv.symm_apply_apply e i]
    have hfloor_bound (i : ι) : |mesh * (Nat.floor ((table i + A) / mesh) : ℝ) - (table i + A)| ≤ mesh := by
      let x : ℝ := (table i + A) / mesh
      have hxge0 : 0 ≤ x := by
        dsimp [x]
        exact div_nonneg (by linarith [(abs_le.mp (htable i)).1]) (le_of_lt hmesh_pos)
      have hfl_le : (Nat.floor x : ℝ) ≤ x := Nat.floor_le hxge0
      have hx_lt : x < ((Nat.floor x + 1 : ℕ) : ℝ) := (Nat.floor_lt hxge0).1 (Nat.lt_succ_self (Nat.floor x))
      have hx_lt' : x < (Nat.floor x : ℝ) + 1 := by
        exact_mod_cast hx_lt
      have hdiff : x - (Nat.floor x : ℝ) ≤ 1 := by linarith
      have hmulx : mesh * x = table i + A := by
        dsimp [x]
        rw [mul_comm]
        field_simp [ne_of_gt hmesh_pos]
      calc
        |mesh * (Nat.floor x : ℝ) - (table i + A)| = |mesh * (Nat.floor x : ℝ) - mesh * x| := by rw [hmulx]
        _ = mesh * (x - (Nat.floor x : ℝ)) := by
              rw [← mul_sub, abs_mul, abs_of_pos hmesh_pos, abs_of_nonpos (sub_nonpos.mpr hfl_le), neg_sub]

        _ ≤ mesh * 1 := by
              exact mul_le_mul_of_nonneg_left hdiff (le_of_lt hmesh_pos)
        _ = mesh := by ring
    have herr (i : ι) : |decoded i - table i| ≤ eta := by
      calc
        |decoded i - table i| = |mesh * (digit (e i) : ℝ) - (table i + A)| := by
              rw [show decoded i - table i = mesh * (digit (e i) : ℝ) - (table i + A) by
                dsimp [decoded]
                ring]
        _ ≤ mesh := by
              rw [hdigit_floor i]
              exact hfloor_bound i
        _ ≤ eta := by
              dsimp [mesh]
              exact hmesh
    have hdec_abs (i : ι) : |decoded i| ≤ A := by
      let d : ℝ := (digit (e i) : ℝ)
      have hmeshQ : mesh * (Q : ℝ) = 2 * A := by
        dsimp [mesh]
        field_simp [hQne]
      have hmd0 : 0 ≤ mesh * d := by
        have hd0 : (0 : ℝ) ≤ d := by
          dsimp [d]
          exact_mod_cast (Nat.zero_le (digit (e i)))
        exact mul_nonneg (le_of_lt hmesh_pos) hd0
      have hmdle : mesh * d ≤ 2 * A := by
        calc
          mesh * d ≤ mesh * (Q : ℝ) := by
            dsimp [d]
            exact mul_le_mul_of_nonneg_left (by exact_mod_cast hdig_le (e i)) (le_of_lt hmesh_pos)
          _ = 2 * A := hmeshQ
      have hdec_eq : decoded i = -A + mesh * d := by
        dsimp [decoded, d]
      rw [hdec_eq]
      rw [abs_le]
      constructor
      · linarith
      · linarith [hmdle]
    have hdec_abs_eta (i : ι) : |decoded i| ≤ A + eta := by
      exact le_trans (hdec_abs i) (by linarith [hA, heta])
    refine ⟨digit, hdig_le, hdig_lt_base, ⟨code, rfl, hrecover⟩, ⟨decoded, ?_, herr, hdec_abs_eta⟩⟩
    · intro i
      simp only [decoded, mesh]

theorem two_scale_depth_and_error_budget_from_block_schedule
    {d r Dblock : ℕ} {beta cTaylor cQuant cDecoder cSelector : ℝ}
    (hd : 0 < d)
    (hsmooth_pos : 0 < (r : ℝ) + beta)
    (hcTaylor : 0 ≤ cTaylor) (hcQuant : 0 ≤ cQuant)
    (hcDecoder : 0 ≤ cDecoder) (hcSelector : 0 ≤ cSelector) :
    ∃ cDepth cErr : ℝ, 0 < cDepth ∧ 0 < cErr ∧
      ∀ M : ℕ, 0 < M →
        ∃ coarseCells fineCells D : ℕ,
          coarseCells = M ^ d ∧
          fineCells = (M ^ 2) ^ d ∧
          D = coarseCells * (Dblock + 1) ∧
          0 < D ∧
          (D : ℝ) ≤ cDepth * ((M : ℝ) ^ d) ∧
          cTaylor *
              (Real.sqrt (d : ℝ) *
                (M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta)
            + cQuant *
                (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
            + cDecoder *
                (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
            + cSelector *
                (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
              ≤
            cErr * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
      refine ⟨(Dblock : ℝ) + 1,
        cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) + cQuant + cDecoder + cSelector + 1,
        ?_, ?_, ?_⟩
      · positivity
      · have hsqrt_nonneg : 0 ≤ (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) :=
          Real.rpow_nonneg (Real.sqrt_nonneg (d : ℝ)) ((r : ℝ) + beta)
        have hA_nonneg : 0 ≤ cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) :=
          mul_nonneg hcTaylor hsqrt_nonneg
        nlinarith [hA_nonneg, hcQuant, hcDecoder, hcSelector]
      · intro M hM
        refine ⟨M ^ d, (M ^ 2) ^ d, (M ^ d) * (Dblock + 1), ?_, ?_, ?_, ?_, ?_, ?_⟩
        · rfl
        · rfl
        · rfl
        · have hMpow : 0 < M ^ d := pow_pos hM d
          exact Nat.mul_pos hMpow (Nat.succ_pos Dblock)
        · have hdepth_eq : (((M ^ d) * (Dblock + 1) : ℕ) : ℝ) =
              ((Dblock : ℝ) + 1) * (M : ℝ) ^ d := by
            norm_cast
            ring
          exact le_of_eq hdepth_eq
        · have hMpos : 0 < (M : ℝ) := by exact_mod_cast hM
          have hMnonneg : 0 ≤ (M : ℝ) := le_of_lt hMpos
          have hsqrt_nonneg : 0 ≤ Real.sqrt (d : ℝ) := Real.sqrt_nonneg (d : ℝ)
          have hMinv_nonneg : 0 ≤ (M : ℝ).rpow (-2 : ℝ) :=
            Real.rpow_nonneg hMnonneg (-2 : ℝ)
          have hPpos : 0 < (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) :=
            Real.rpow_pos_of_pos hMpos (-(2 * ((r : ℝ) + beta)))
          have hPnonneg : 0 ≤ (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := le_of_lt hPpos
          have hMinv_pow_nonneg : 0 ≤ (M : ℝ) ^ (-2 : ℝ) := by
            simpa [Real.rpow_eq_pow] using hMinv_nonneg
          have hmul :
              (Real.sqrt (d : ℝ) * (M : ℝ).rpow (-2 : ℝ)).rpow ((r : ℝ) + beta) =
                (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) *
                  (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
            simp only [Real.rpow_eq_pow]
            rw [Real.mul_rpow hsqrt_nonneg hMinv_pow_nonneg]
            congr 1
            rw [← Real.rpow_mul hMnonneg (-2 : ℝ) ((r : ℝ) + beta)]
            congr 1
            ring
          rw [hmul]
          calc
            cTaylor * ((Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) *
                  (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))))
                + cQuant * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                + cDecoder * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                + cSelector * (M : ℝ).rpow (-(2 * ((r : ℝ) + beta)))
                = (cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) +
                      cQuant + cDecoder + cSelector) *
                    (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
                  ring
            _ ≤ (cTaylor * (Real.sqrt (d : ℝ)).rpow ((r : ℝ) + beta) +
                      cQuant + cDecoder + cSelector + 1) *
                    (M : ℝ).rpow (-(2 * ((r : ℝ) + beta))) := by
                  nlinarith [hPnonneg]


/-! ## Paper-Route Selector Products and Quantized Coefficients -/

theorem finite_axisAlignedBoxIndicatorRamp_local_products_fixed_width_depth_sum_bound
    {d m Dlocal Wlocal Plocal Wmul : ℕ}
    (hDlocal : 0 < Dlocal) (hWlocal : 0 < Wlocal) (hWmul : 0 < Wmul)
    {Rbox cMulDepth cMulErr productRadius productDelta : ℝ}
    (hRbox : 0 < Rbox)
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hProductRadius : 0 < productRadius)
    (hProductRadius_one : 1 ≤ productRadius)
    (nMul : ℕ) (hnMul : 0 < nMul)
    (hProductDelta :
      cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) ≤
        productDelta)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ))
    {domain : (Fin d → ℝ) → Prop}
    (lower upper : Fin m → Fin d → ℝ)
    (localApprox : Fin m → (Fin d → ℝ) → ℝ)
    (hlocalClass : ∀ j : Fin m,
      localApprox j ∈ reluNetworkClass d Dlocal Wlocal Plocal)
    (hlocalBound : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |localApprox j x| ≤ productRadius) :
    ∃ Dprod Pprod : ℕ,
      0 < Dprod ∧
      (Dprod : ℝ) ≤
        (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) ∧
      Pprod =
        fullyConnectedReLUParameterCount d Dprod
          (Wlocal + (2 * d + 1) + Wmul) ∧
      ∃ productApprox : Fin m → (Fin d → ℝ) → ℝ,
        (∀ j : Fin m,
          productApprox j ∈
            reluNetworkClass d Dprod
              (Wlocal + (2 * d + 1) + Wmul) Pprod) ∧
          ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
            |productApprox j x -
              axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x *
                localApprox j x| ≤ productDelta := by
  -- @step s1: For each cell j build a product network prodApprox j of some depth D_j:
  -- the ramp axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) is in reluNetworkClass,
  -- takes values in [0,1], hence bounded by productRadius; apply the product-construction
  -- lemma with localApprox j, radius productRadius, resolution nMul.
  have hprod_approx : ∀ j : Fin m,
      ∃ D_j : ℕ,
        0 < D_j ∧
        (D_j : ℝ) ≤ (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) ∧
        ∃ g_j : (Fin d → ℝ) → ℝ,
          g_j ∈ reluNetworkClass d D_j (Wlocal + (2 * d + 1) + Wmul)
              (fullyConnectedReLUParameterCount d D_j (Wlocal + (2 * d + 1) + Wmul)) ∧
          ∀ x : Fin d → ℝ, domain x →
            |g_j x - axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x * localApprox j x| ≤
              cMulErr * productRadius ^ 2 * (nMul : ℝ).rpow (-2 : ℝ) := by
    intro j
    have hrampClass :
        (fun x => axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x) ∈
          reluNetworkClass d 2 (2 * d + 1)
            (fullyConnectedReLUParameterCount d 2 (2 * d + 1)) :=
      (axisAlignedBoxIndicatorRamp_reluNetworkClass_and_exact_on_margin hRbox (lower j) (upper j)).1
    have hrampBound : ∀ x : Fin d → ℝ, domain x →
        |axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x| ≤ productRadius := by
      intro x hx
      have hramp_nonneg : 0 ≤ axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x := by
        unfold axisAlignedBoxIndicatorRamp relu
        exact le_max_right
          (1 - Rbox * (∑ q : Fin d, (max (lower j q - x q) 0 + max (x q - upper j q) 0))) 0
      have hramp_le_one : axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x ≤ 1 := by
        unfold axisAlignedBoxIndicatorRamp relu
        have hs_nonneg : 0 ≤ ∑ q : Fin d,
            (max (lower j q - x q) 0 + max (x q - upper j q) 0) := by
          exact Finset.sum_nonneg (fun q hq => by
            have h1 : 0 ≤ max (lower j q - x q) 0 := le_max_right (lower j q - x q) 0
            have h2 : 0 ≤ max (x q - upper j q) 0 := le_max_right (x q - upper j q) 0
            linarith)
        have hprod_nonneg : 0 ≤ Rbox * ∑ q : Fin d,
            (max (lower j q - x q) 0 + max (x q - upper j q) 0) :=
          mul_nonneg (le_of_lt hRbox) hs_nonneg
        have harg_le_one : 1 - Rbox * (∑ q : Fin d,
            (max (lower j q - x q) 0 + max (x q - upper j q) 0)) ≤ 1 := by
          linarith
        exact max_le harg_le_one (by norm_num)
      have hramp_abs_le_one : |axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x| ≤ 1 := by
        exact abs_le.mpr ⟨by linarith [hramp_nonneg], hramp_le_one⟩
      exact le_trans hramp_abs_le_one hProductRadius_one
    have hramp_exact : ∀ x : Fin d → ℝ, domain x →
        |axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x -
          axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x| ≤ 0 := by
      intro x hx
      simp
    have hlocal_exact : ∀ x : Fin d → ℝ, domain x → |localApprox j x - localApprox j x| ≤ 0 := by
      intro x hx
      simp
    rcases exists_reluNetworkClass_product_two_fixed_width_from_mul_gadget_depth_sum_bound
      (d := d) (Df := 2) (Dg := Dlocal) (Wf := 2 * d + 1) (Wg := Wlocal)
      (Pf := fullyConnectedReLUParameterCount d 2 (2 * d + 1)) (Pg := Plocal)
      (Wmul := Wmul)
      (by norm_num : 0 < (2 : ℕ)) hDlocal (by omega : 0 < 2 * d + 1) hWlocal hWmul
      hcMulDepth hcMulErr hmul
      (domain := domain)
      (targetF := fun x => axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x)
      (targetG := localApprox j)
      (approxF := fun x => axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x)
      (approxG := localApprox j)
      (ηf := 0) (ηg := 0) (R := productRadius)
      (by norm_num : 0 ≤ (0 : ℝ)) (by norm_num : 0 ≤ (0 : ℝ))
      hProductRadius
      hrampClass
      (hlocalClass j)
      hrampBound
      (hlocalBound j)
      (hlocalBound j)
      hramp_exact
      hlocal_exact
      nMul hnMul with
      ⟨D_j, P_j, hD_j_pos, hD_j_le, hP_j, h_j, h_j_mem, h_j_err⟩
    have hwidth : (2 * d + 1) + Wlocal + Wmul = Wlocal + (2 * d + 1) + Wmul := by omega
    refine ⟨D_j, hD_j_pos, ?_, h_j, ?_, ?_⟩
    · have hmax : Nat.max 2 Dlocal = Nat.max Dlocal 2 := Nat.max_comm 2 Dlocal
      rw [hmax] at hD_j_le
      exact hD_j_le
    · rw [hwidth] at hP_j h_j_mem
      rw [hP_j] at h_j_mem
      exact h_j_mem
    · intro x hx
      simpa using h_j_err x hx
  -- @step s2: Let Dprod be the finite supremum of the depths D_j over Fin m (default 2);
  -- then 0 < Dprod, Dprod satisfies the same real depth upper bound, and D_j ≤ Dprod for every j.
  have hDprod : ∃ Dprod : ℕ,
      0 < Dprod ∧
      (Dprod : ℝ) ≤ (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) ∧
      ∀ j : Fin m, (hprod_approx j).choose ≤ Dprod := by
    -- @step s1: Define default = max Dlocal 2, bound, f j = (hprod_approx j).choose,
    -- supD = Finset.univ.sup f, Dprod = max default supD; then 0 < Dprod.
    let default : ℕ := Nat.max Dlocal 2
    let bound : ℝ := (default : ℝ) + cMulDepth * (nMul : ℝ)
    let f : Fin m → ℕ := fun j => (hprod_approx j).choose
    let supD : ℕ := Finset.univ.sup f
    let Dprod : ℕ := Nat.max default supD
    have hDprod_pos : 0 < Dprod := by
      have hDlocal_le_default : Dlocal ≤ default := by
        dsimp [default]
        exact Nat.le_max_left Dlocal 2
      have hdefault_pos : 0 < default := by
        dsimp [default]
        exact lt_of_lt_of_le hDlocal hDlocal_le_default
      have hdefault_le_Dprod : default ≤ Dprod := by
        dsimp [Dprod]
        exact Nat.le_max_left default supD
      exact lt_of_lt_of_le hdefault_pos hdefault_le_Dprod
    -- @step s2: pointwise floor bound: every chosen depth is ≤ ⌊bound⌋₊
    have hDprod_floor : ∀ j : Fin m, (hprod_approx j).choose ≤ ⌊bound⌋₊ := by
      intro j
      apply Nat.le_floor
      dsimp [bound, default]
      exact (hprod_approx j).choose_spec.2.1
    -- @step s3: supD ≤ ⌊bound⌋₊, Dprod ≤ ⌊bound⌋₊, hence (Dprod : ℝ) ≤ bound
    have hDprod_budget : (Dprod : ℝ) ≤ bound := by
      have hdefault_floor : default ≤ ⌊bound⌋₊ := by
        apply Nat.le_floor
        dsimp [bound]
        have hprod_nonneg : 0 ≤ cMulDepth * (nMul : ℝ) := by
          positivity
        linarith
      have hsupD_floor : supD ≤ ⌊bound⌋₊ := by
        dsimp [supD, f]
        exact Finset.sup_le (fun j _ => hDprod_floor j)
      have hDprod_floor' : Dprod ≤ ⌊bound⌋₊ := by
        dsimp [Dprod]
        exact (Nat.max_le).mpr ⟨hdefault_floor, hsupD_floor⟩
      calc
        (Dprod : ℝ) ≤ (⌊bound⌋₊ : ℝ) := by
          exact_mod_cast hDprod_floor'
        _ ≤ bound := by
          exact Nat.floor_le (by
            dsimp [bound]
            positivity)
    -- @step s4: every chosen depth is ≤ Dprod
    have hDprod_dom : ∀ j : Fin m, (hprod_approx j).choose ≤ Dprod := by
      intro j
      have hle_sup : (hprod_approx j).choose ≤ supD := by
        dsimp [supD]
        exact Finset.le_sup (α := ℕ) (s := (Finset.univ : Finset (Fin m))) (f := f) (b := j)
          (Finset.mem_univ j)
      have hsup_le_Dprod : supD ≤ Dprod := by
        dsimp [Dprod]
        exact le_max_right default supD
      exact le_trans hle_sup hsup_le_Dprod
    exact ⟨Dprod, hDprod_pos, hDprod_budget, hDprod_dom⟩
  -- @step s3: By depth padding/monotonicity of reluNetworkClass, each prodApprox j is
  -- representable in reluNetworkClass d Dprod (Wlocal + (2*d+1) + Wmul) Pprod; collecting
  -- these gives productApprox, and the per-cell errors are at most
  -- cMulErr * productRadius^2 * (nMul).rpow (-2), which is ≤ productDelta by hProductDelta.
  have hfinal : ∀ Dprod : ℕ,
      0 < Dprod →
      (Dprod : ℝ) ≤ (Nat.max Dlocal 2 : ℝ) + cMulDepth * (nMul : ℝ) →
      (∀ j : Fin m, (hprod_approx j).choose ≤ Dprod) →
        ∃ Pprod : ℕ,
          Pprod = fullyConnectedReLUParameterCount d Dprod (Wlocal + (2 * d + 1) + Wmul) ∧
          ∃ productApprox : Fin m → (Fin d → ℝ) → ℝ,
            (∀ j : Fin m,
              productApprox j ∈
                reluNetworkClass d Dprod (Wlocal + (2 * d + 1) + Wmul) Pprod) ∧
            ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
              |productApprox j x -
                  axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x * localApprox j x| ≤
                productDelta := by
    intro Dprod hDprod_pos hDprod_budget hsup
    refine
      ⟨fullyConnectedReLUParameterCount d Dprod (Wlocal + (2 * d + 1) + Wmul), rfl, ?_⟩
    refine ⟨fun j => (hprod_approx j).choose_spec.2.2.choose, ?_, ?_⟩
    · intro j
      let D_j : ℕ := (hprod_approx j).choose
      let hg_j_mem :
          (hprod_approx j).choose_spec.2.2.choose ∈
            reluNetworkClass d D_j (Wlocal + (2 * d + 1) + Wmul)
              (fullyConnectedReLUParameterCount d D_j (Wlocal + (2 * d + 1) + Wmul)) :=
        (hprod_approx j).choose_spec.2.2.choose_spec.1
      have hDj_le_Dprod : D_j ≤ Dprod := hsup j
      have hpar_mono :
          fullyConnectedReLUParameterCount d D_j (Wlocal + (2 * d + 1) + Wmul) ≤
            fullyConnectedReLUParameterCount d Dprod (Wlocal + (2 * d + 1) + Wmul) := by
        unfold fullyConnectedReLUParameterCount
        exact
          Nat.add_le_add_right
            (Nat.add_le_add_left
              (Nat.mul_le_mul_right
                ((Wlocal + (2 * d + 1) + Wmul + 1) * (Wlocal + (2 * d + 1) + Wmul))
                (Nat.sub_le_sub_right hDj_le_Dprod 1))
              ((d + 1) * (Wlocal + (2 * d + 1) + Wmul)))
            ((Wlocal + (2 * d + 1) + Wmul) + 1)
      simp [reluNetworkClass] at hg_j_mem ⊢
      rcases hg_j_mem with ⟨N, hN_pos, hN_depth, hN_width, hN_param, hN_eq⟩
      exact ⟨N, hN_pos, le_trans hN_depth hDj_le_Dprod, hN_width,
        le_trans hN_param hpar_mono, hN_eq⟩
    · intro j x hx
      exact le_trans ((hprod_approx j).choose_spec.2.2.choose_spec.2 x hx) hProductDelta
  rcases hDprod with ⟨Dprod, hDprod_pos, hDprod_le, hsup⟩
  rcases hfinal Dprod hDprod_pos hDprod_le hsup with ⟨Pprod, hPprod, productApprox, hProdApprox⟩
  exact ⟨Dprod, Pprod, hDprod_pos, hDprod_le, hPprod, productApprox, hProdApprox⟩

theorem finite_axisAlignedBoxIndicatorRamp_selector_reluNetworkClass_serial_fixed_width_global_error_bound
    {d m Dprod Wprod Pprod : ℕ}
    (hDprod : 0 < Dprod) (hWprod : 0 < Wprod)
    {Rbox productDelta localEps : ℝ}
    (hProductDelta_nonneg : 0 ≤ productDelta)
    (lower upper : Fin m → Fin d → ℝ)
    (localApprox : Fin m → (Fin d → ℝ) → ℝ)
    (target : (Fin d → ℝ) → ℝ)
    (productApprox : Fin m → (Fin d → ℝ) → ℝ)
    {domain : (Fin d → ℝ) → Prop}
    (hclass : ∀ j : Fin m,
      productApprox j ∈ reluNetworkClass d Dprod Wprod Pprod)
    (hprodErr : ∀ j : Fin m, ∀ x : Fin d → ℝ, domain x →
      |productApprox j x -
        axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x *
          localApprox j x| ≤ productDelta)
    (hunique : ∀ x : Fin d → ℝ, domain x →
      ∃ j0 : Fin m,
        axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x = 1 ∧
        (∀ j : Fin m, j ≠ j0 →
          axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x = 0) ∧
        |localApprox j0 x - target x| ≤ localEps) :
    ∃ D P : ℕ,
      0 < D ∧
      D ≤ (m + 1) * (Dprod + 1) ∧
      P = fullyConnectedReLUParameterCount d D (2 * d + Wprod + 3) ∧
      ∃ g : (Fin d → ℝ) → ℝ,
        g ∈ reluNetworkClass d D (2 * d + Wprod + 3) P ∧
          ∀ x : Fin d → ℝ, domain x →
            |g x - target x| ≤ (∑ j : Fin m, productDelta) + localEps := by
  classical
  rcases finite_linear_combination_reluNetworkClass_serial_fixed_width_explicit_depth_bound
      (ι := Fin m) hDprod hWprod (domain := domain)
      (coeff := fun _ : Fin m => 1)
      (target := fun j : Fin m => fun x : Fin d → ℝ =>
        axisAlignedBoxIndicatorRamp Rbox (lower j) (upper j) x * localApprox j x)
      (approx := productApprox)
      (eps := fun _ : Fin m => productDelta)
      (fun _ : Fin m => hProductDelta_nonneg) hclass hprodErr
    with ⟨D, P, hDpos, hDbound, hP, g, hgclass, hgsum⟩
  refine ⟨D, P, hDpos, ?_, hP, g, hgclass, ?_⟩
  · simpa using hDbound
  · intro x hx
    rcases hunique x hx with ⟨j0, hsel, hzero, hloc⟩
    let Sx : ℝ := ∑ i : Fin m, axisAlignedBoxIndicatorRamp Rbox (lower i) (upper i) x * localApprox i x
    have hsum0 : (∑ i : Fin m, axisAlignedBoxIndicatorRamp Rbox (lower i) (upper i) x * localApprox i x)
        = axisAlignedBoxIndicatorRamp Rbox (lower j0) (upper j0) x * localApprox j0 x := by
      refine Finset.sum_eq_single j0 ?_ ?_
      · intro b hb hbne
        rw [hzero b hbne]
        simp
      · simp
    have hg1 : |g x - Sx| ≤ ∑ j : Fin m, productDelta := by
      simpa [Sx] using hgsum x hx
    have hS_target : |Sx - target x| ≤ localEps := by
      dsimp [Sx]
      rw [hsum0, hsel]
      simpa using hloc
    have htri : |g x - target x| ≤ |g x - Sx| + |Sx - target x| := by
      calc
        |g x - target x| = |(g x - Sx) + (Sx - target x)| := by
          congr 1
          ring
        _ ≤ |g x - Sx| + |Sx - target x| := by
          exact abs_add_le _ _
    calc
      |g x - target x| ≤ |g x - Sx| + |Sx - target x| := htri
      _ ≤ (∑ j : Fin m, productDelta) + localEps := by
        exact add_le_add hg1 hS_target

theorem finite_centered_monomial_polynomial_quantized_coeff_error_bound
    {d r : ℕ}
    (center x : Fin d → ℝ)
    (coeff decoded :
      Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) → ℝ)
    {eta R : ℝ}
    (heta_nonneg : 0 ≤ eta) (hR_nonneg : 0 ≤ R)
    (hdecoded : ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
      |decoded a - coeff a| ≤ eta)
    (hbox : ∀ q : Fin d, |x q - center q| ≤ R) :
    |finiteLinearCombination
        (Finset.univ :
          Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        decoded
        (fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q)))
        x -
      finiteLinearCombination
        (Finset.univ :
          Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
        coeff
        (fun a y => ∏ q : Fin a.1.val, (y (a.2 q) - center (a.2 q)))
        x| ≤
      eta *
        (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          R ^ a.1.val) := by
  unfold finiteLinearCombination
  rw [← Finset.sum_sub_distrib]
  simp_rw [← sub_mul]
  have hmono :
      ∀ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        |∏ q : Fin a.1.val, (x (a.2 q) - center (a.2 q))| ≤ R ^ a.1.val := by
    intro a
    calc
      |∏ q : Fin a.1.val, (x (a.2 q) - center (a.2 q))| =
          ∏ q : Fin a.1.val, |x (a.2 q) - center (a.2 q)| := by
        exact Finset.abs_prod Finset.univ (fun q => x (a.2 q) - center (a.2 q))
      _ ≤ ∏ q : Fin a.1.val, R := by
        apply Finset.prod_le_prod
        · intro q hq
          exact abs_nonneg (x (a.2 q) - center (a.2 q))
        · intro q hq
          exact hbox (a.2 q)
      _ = R ^ a.1.val := by
        simp
  calc
    |∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
        (decoded i - coeff i) * (∏ q : Fin i.1.val, (x (i.2 q) - center (i.2 q)))| ≤
        ∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d),
          |(decoded i - coeff i) * (∏ q : Fin i.1.val, (x (i.2 q) - center (i.2 q)))| := by
      exact Finset.abs_sum_le_sum_abs
        (fun i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d) =>
          (decoded i - coeff i) * (∏ q : Fin i.1.val, (x (i.2 q) - center (i.2 q))))
        Finset.univ
    _ ≤ ∑ i : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), eta * R ^ i.1.val := by
      apply Finset.sum_le_sum
      intro a ha
      rw [abs_mul]
      exact mul_le_mul (hdecoded a) (hmono a) (abs_nonneg _) heta_nonneg
    _ = eta * (∑ a : Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d), R ^ a.1.val) := by
      rw [Finset.mul_sum]

theorem exists_reluNetworkClass_holderSmooth_unitCube_box_selector_from_local_table_and_mul_gadget
    {d m r Wmul : ℕ} (hWmul : 0 < Wmul)
    {cMulDepth cMulErr : ℝ}
    (hcMulDepth : 0 < cMulDepth) (hcMulErr : 0 < cMulErr)
    (hmul :
      ∀ n : ℕ, 0 < n →
      ∀ R : ℝ, 0 < R →
        ∃ Dmul Pmul : ℕ,
          0 < Dmul ∧
          (Dmul : ℝ) ≤ cMulDepth * (n : ℝ) ∧
          Pmul = fullyConnectedReLUParameterCount 2 Dmul Wmul ∧
          ∃ gmul : (Fin 2 → ℝ) → ℝ,
            gmul ∈ reluNetworkClass 2 Dmul Wmul Pmul ∧
              ∀ y : Fin 2 → ℝ,
                |y 0| ≤ R → |y 1| ≤ R →
                  |gmul y - y 0 * y 1| ≤
                    cMulErr * R ^ 2 * (n : ℝ).rpow (-2 : ℝ)) :
    ∃ Wlocal : ℕ,
      0 < Wlocal ∧
      Wlocal =
        finiteCenteredMonomialPolynomialFixedWidthBound Wmul
          (Finset.univ :
            Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d)))
          (fun a => a.1.val) ∧
      ∃ W0 : ℕ,
        0 < W0 ∧
        W0 = 2 * d + (Wlocal + (2 * d + 1) + Wmul) + 3 ∧
        ∃ cLocalDepth : ℝ,
          0 < cLocalDepth ∧
          ∀ {beta C B R rho A localEps productRadius productDelta eps Rbox : ℝ},
            0 ≤ beta → 0 ≤ C → 0 ≤ rho → 0 ≤ A → 0 < R →
            0 < Rbox → 0 < productRadius → 1 ≤ productRadius →
            ∀ nLocal : ℕ, 0 < nLocal →
            ∀ nMul : ℕ, 0 < nMul →
