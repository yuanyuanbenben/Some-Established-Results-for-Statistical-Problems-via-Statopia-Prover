              intro j q
              dsimp [center]
              constructor
              · exact div_nonneg (Nat.cast_nonneg (idx j q : ℕ)) (Nat.cast_nonneg K)
              · have hle' : ((idx j q : ℕ) : ℝ) ≤ (K : ℝ) := by
