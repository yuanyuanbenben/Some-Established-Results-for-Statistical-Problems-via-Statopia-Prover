              let localDepthBudget : ℕ := finiteCenteredMonomialPolynomialDepthBound (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))) (fun a => a.1.val)
              let localWidthBudget : ℕ := finiteCenteredMonomialPolynomialWidthBound nLocal (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))) (fun a => a.1.val)
              let localParameterBudget : ℕ := finiteCenteredMonomialPolynomialParameterBound d nLocal (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))) (fun a => a.1.val)
