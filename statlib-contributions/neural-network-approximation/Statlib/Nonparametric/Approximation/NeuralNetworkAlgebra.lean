                  (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ), (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → ∀ q : Fin d, |x q - center j q| ≤ R) ∧
                  (∀ (j : Fin (M ^ d)) (x : Fin d → ℝ), (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → (∀ q : Fin d, scale j q * (relu (x q - center j q) + relu (center j q - x q)) < 1) → ‖x - center j‖ ≤ rho) ∧
