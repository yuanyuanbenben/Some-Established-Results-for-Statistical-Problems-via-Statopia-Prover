                    have hupdate : N.hiddenState x ((k + 1) * (D0 + 1)) aP - N.hiddenState x ((k + 1) * (D0 + 1)) aM =
                        (N.hiddenState x (k * (D0 + 1)) aP - N.hiddenState x (k * (D0 + 1)) aM) + coeff r * (B r).realize x := by
                      have hkm : (k + 1) * (D0 + 1) = k * (D0 + 1) + D0 + 1 := by rw [hkeq]; omega
