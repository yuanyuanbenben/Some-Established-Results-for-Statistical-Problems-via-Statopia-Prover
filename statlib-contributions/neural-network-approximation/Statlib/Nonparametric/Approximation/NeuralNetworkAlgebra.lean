        refine ⟨A, ?_, ?_⟩
        · rw [hAd, haD]
        · intro x
          rfl
  by_cases hs_empty : s = ∅
  · -- Empty support: the target polynomial is identically zero; use a depth-1 zero network.
    let N0 : FullyConnectedReLUNet d :=
