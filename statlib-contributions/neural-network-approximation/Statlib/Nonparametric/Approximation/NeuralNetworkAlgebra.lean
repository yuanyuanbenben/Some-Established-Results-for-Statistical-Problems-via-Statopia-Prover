  have hpad : ∀ (A : FullyConnectedReLUNet d) (a D : ℕ), A.depth = a → 0 < a → a ≤ D →
      ∃ P : FullyConnectedReLUNet d, P.depth = D ∧ ∀ x : Fin d → ℝ, P.realize x = A.realize x := by
    intro A a D hAd ha hale
    revert A a hAd ha
    induction' D with D ih
    · intro A a hAd ha hale
      exfalso
      omega
    · intro A a hAd ha hale
