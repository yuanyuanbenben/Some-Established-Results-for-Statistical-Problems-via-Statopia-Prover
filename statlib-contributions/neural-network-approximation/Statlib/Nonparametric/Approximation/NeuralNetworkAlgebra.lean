theorem exists_fullyConnectedReLUNet_holderSmooth_local_approx_on_centered_box_with_depth_bound
    {d r : ℕ} (hd : 0 < d) {beta C B R rho ε : ℝ}
    (hbeta_nonneg : 0 ≤ beta) (hC : 0 ≤ C) (hrho : 0 ≤ rho)
    (hR : 0 < R) (hε : 0 < ε)
    (f : (Fin d → ℝ) → ℝ)
    (hf : f ∈ holderSmoothBall r beta C B)
    (center : Fin d → ℝ) :
    ∃ N : FullyConnectedReLUNet d,
      0 < N.depth ∧
      N.depth ≤
        (∑ a ∈ (Finset.univ : Finset (Sigma (fun k : Fin (r + 1) => Fin k.val → Fin d))),
