            have hcoarse : ∀ (j : Fin ((K + 1) ^ d)) (x : Fin d → ℝ),
                (∀ q : Fin d, x q ∈ Set.Icc (0 : ℝ) 1) → ∀ q : Fin d, |x q - center j q| ≤ 1 := by
              intro j x hx q
