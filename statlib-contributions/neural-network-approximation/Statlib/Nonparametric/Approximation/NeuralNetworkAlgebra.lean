            rw [Finset.sum_eq_add_sum_diff_singleton (s := (Finset.univ : Finset (Fin (K + 1)))) (i := en) (by simp)]
            rw [Finset.sum_eq_add_sum_diff_singleton (s := ((Finset.univ : Finset (Fin (K + 1))) \ {en})) (i := en1) (by simp [hen1_ne_en])]
            ring
