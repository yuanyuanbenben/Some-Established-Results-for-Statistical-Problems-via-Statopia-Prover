noncomputable def standardNormalDensity (x : ℝ) : ℝ :=
  ProbabilityTheory.gaussianPDFReal 0 1 x

noncomputable def standardNormalUpperTail (x : ℝ) : ℝ :=
  ∫ y in Set.Ioi x, standardNormalDensity y

noncomputable def standardNormalCDF (x : ℝ) : ℝ :=
  ∫ y in Set.Iic x, standardNormalDensity y

noncomputable def dobribanBin0PThreshold : ℝ :=
  2 * standardNormalUpperTail ((3642 : ℝ) / 1000)

noncomputable def dobribanBin0NullTail : ℝ :=
  2 * standardNormalUpperTail (((3644 : ℝ) / 1000) / (Real.sqrt 91 / 10))

noncomputable def dobribanBin0ZMass : ℝ :=
  standardNormalCDF ((1 : ℝ) / 100) - standardNormalCDF 0

structure DobribanBin0TailBounds : Prop where
  p_threshold_pos : 0 < dobribanBin0PThreshold
  p_threshold_upper : dobribanBin0PThreshold ≤ (271 : ℝ) / 1000000
  null_tail_lower : (133 : ℝ) / 1000000 ≤ dobribanBin0NullTail
  z_mass_lower : (3989 : ℝ) / 1000000 ≤ dobribanBin0ZMass

noncomputable def dobribanBin0CertifiedContribution : ℝ :=
  ((24 : ℝ) / 2500) * dobribanBin0NullTail /
    dobribanBin0PThreshold * dobribanBin0ZMass

theorem dobriban_appendix_b_bin0_contribution_floor_of_numeric_tails
    (h : DobribanBin0TailBounds) :
    (1879 : ℝ) / 100000000 < dobribanBin0CertifiedContribution := by
  exact bin0_tail_bounds_imply_contribution_floor
    h.p_threshold_pos h.p_threshold_upper h.null_tail_lower h.z_mass_lower

theorem dobriban_appendix_b_bin0_numeric_vocabulary
    (h : DobribanBin0TailBounds) :
    (1879 : ℝ) / 100000000 < dobribanBin0CertifiedContribution := by
  exact dobriban_appendix_b_bin0_contribution_floor_of_numeric_tails h

end Statlib.MultipleTesting.Dobriban.AppendixB
