open MeasureTheory

namespace Statlib.MultipleTesting

structure IsValidPValue {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (p : Ω → ℝ) : Prop where
  measurable : Measurable p
  prob_le : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → μ {ω | p ω ≤ t} ≤ ENNReal.ofReal t

noncomputable def fwer {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) {m : ℕ}
    (isNull : Fin m → Prop) (reject : Ω → Fin m → Prop) : ENNReal :=
  μ {ω | ∃ i : Fin m, isNull i ∧ reject ω i}

noncomputable def rejectionCount {m : ℕ}
    (reject : Fin m → Prop) [DecidablePred reject] : ℕ :=
  (Finset.univ.filter reject).card

noncomputable def falseDiscoveryCount {m : ℕ}
    (isNull reject : Fin m → Prop)
    [DecidablePred isNull] [DecidablePred reject] : ℕ :=
  (Finset.univ.filter (fun i : Fin m => isNull i ∧ reject i)).card

noncomputable def fdp {m : ℕ}
    (isNull reject : Fin m → Prop)
    [DecidablePred isNull] [DecidablePred reject] : ℝ :=
  if h : rejectionCount reject = 0 then 0
  else (falseDiscoveryCount isNull reject : ℝ) / (rejectionCount reject : ℝ)

noncomputable def fdr {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) {m : ℕ}
    (isNull : Fin m → Prop) (reject : Ω → Fin m → Prop)
    [DecidablePred isNull] [∀ ω, DecidablePred (reject ω)] : ℝ :=
  ∫ ω, fdp isNull (reject ω) ∂μ

noncomputable def bonferroniReject {m : ℕ}
    (p : Fin m → ℝ) (alpha : ℝ) (i : Fin m) : Prop :=
  p i ≤ alpha / (m : ℝ)

noncomputable def bhCutoff {m : ℕ}
    (p : Fin m → ℝ) (alpha : ℝ) : ℝ :=
  alpha *
    (Nat.findGreatest
      (fun k : ℕ =>
        k ≤ m ∧
          k ≤ (Finset.univ.filter
            (fun i : Fin m => p i ≤ alpha * (k : ℝ) / (m : ℝ))).card)
      m : ℝ) / (m : ℝ)

noncomputable def bhReject {m : ℕ}
    (p : Fin m → ℝ) (alpha : ℝ) (i : Fin m) : Prop :=
  p i ≤ bhCutoff p alpha

theorem multiple_testing_core_available
    {m : ℕ}
    (isNull reject : Fin m → Prop)
    [DecidablePred isNull] [DecidablePred reject]
    (p : Fin m → ℝ) (alpha : ℝ) :
    (rejectionCount reject = 0 → fdp isNull reject = 0) ∧
    (∀ i : Fin m, bonferroniReject p alpha i ↔ p i ≤ alpha / (m : ℝ)) ∧
    (∀ i : Fin m, bhReject p alpha i ↔ p i ≤ bhCutoff p alpha) ∧
    (∀ {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (rejectΩ : Ω → Fin m → Prop),
      fwer μ isNull rejectΩ = μ {ω | ∃ i : Fin m, isNull i ∧ rejectΩ ω i}) ∧
    (∀ {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (rejectΩ : Ω → Fin m → Prop)
      [∀ ω, DecidablePred (rejectΩ ω)],
      fdr μ isNull rejectΩ = ∫ ω, fdp isNull (rejectΩ ω) ∂μ) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro h
    dsimp [fdp]
    simp [h]
  · intro i
    dsimp [bonferroniReject]
    rfl
  · intro i
    dsimp [bhReject]
    rfl
  · intro Ω _ μ rejectΩ
    rfl
  · intro Ω _ μ rejectΩ _
    rfl

