    (p : ℕ) (hp : 2 ≤ p) (SigmaY : Matrix (Fin p) (Fin p) ℝ)
    (Y : Ω → Fin p → ℝ)
    (hY : Statlib.StatFoundation.RandomVariable.Gaussian.IsCenteredGaussianVector μ Y SigmaY)
    (sigma : ℝ) (hsigma : 0 < sigma) (hvar : ∀ j, sigma ^ 2 ≤ SigmaY j j) :
    HasIntervalAntiConcentration ((Real.sqrt (2 * Real.log (p : ℝ)) + 2) / sigma)
      (maxCoordLaw (μ.map (fun ω => (WithLp.toLp 2 (Y ω) : EuclideanSpace ℝ (Fin p))))) := by
  haveI : Nonempty (Fin p) := ⟨⟨0, by omega⟩⟩
  let M : Ω → ℝ := fun ω => ⨆ j : Fin p, Y ω j
  have hM : Measurable M := by
    exact (Statlib.StatFoundation.Convergence.maxCoord_measurable p).comp
      ((WithLp.measurable_toLp 2 (Fin p → ℝ)).comp hY.measurable)
  have hle : ∀ (ω : Ω) (t : ℝ), M ω ≤ t ↔ ∀ j, Y ω j ≤ t := by
    intro ω t
    exact ciSup_le_iff (Set.finite_range (fun j => Y ω j)).bddAbove
  have hYlp : Measurable (fun ω => (WithLp.toLp 2 (Y ω) : EuclideanSpace ℝ (Fin p))) :=
    (WithLp.measurable_toLp 2 (Fin p → ℝ)).comp hY.measurable
  have hlaw : maxCoordLaw (μ.map (fun ω => (WithLp.toLp 2 (Y ω) : EuclideanSpace ℝ (Fin p))))
      = μ.map M := by
    unfold maxCoordLaw
    rw [Measure.map_map (Statlib.StatFoundation.Convergence.maxCoord_measurable p)
      hYlp]
    rfl
  intro t ε hε
  have hs : MeasurableSet {x : ℝ | t < x ∧ x ≤ t + ε} := by measurability
  rw [hlaw, Measure.map_apply hM hs]
  have hdiff : {ω : Ω | t < M ω ∧ M ω ≤ t + ε} =
      {ω | M ω ≤ t + ε} \ {ω | M ω ≤ t} := by
    ext ω
    simp only [Set.mem_setOf_eq, Set.mem_diff, not_le]
    tauto
  have hsub : {ω : Ω | M ω ≤ t} ⊆ {ω | M ω ≤ t + ε} := by
    intro ω hω
    change M ω ≤ t at hω
    exact le_trans hω (by linarith)
  have hbound := Statlib.StatFoundation.Convergence.gaussianVector_rectangle_increment_le
    p (by omega) μ SigmaY Y hY sigma ε hsigma hε hvar (fun _ => t)
  have hset (u : ℝ) : {ω : Ω | ∀ j : Fin p, Y ω j ≤ u} = {ω | M ω ≤ u} := by
    ext ω
    exact (hle ω u).symm
  simp only [hset] at hbound
  have hreal : (μ {ω : Ω | t < M ω ∧ M ω ≤ t + ε}).toReal
      ≤ ((Real.sqrt (2 * Real.log (p : ℝ)) + 2) / sigma) * ε := by
    rw [hdiff]
    change μ.real ({ω | M ω ≤ t + ε} \ {ω | M ω ≤ t}) ≤ _
    rw [measureReal_diff hsub (measurableSet_le hM measurable_const)]
    simpa only [Measure.real] using (show
      (μ {ω | M ω ≤ t + ε}).toReal - (μ {ω | M ω ≤ t}).toReal ≤
        ((Real.sqrt (2 * Real.log (p : ℝ)) + 2) / sigma) * ε from by
          convert hbound using 1 <;> ring)
  exact (ENNReal.le_ofReal_iff_toReal_le (measure_ne_top _ _) (by positivity)).mpr hreal

end Statlib.Imported

namespace Statlib.Imported

open MeasureTheory

set_option maxHeartbeats 1600000 in
theorem cck_covariance_comparison_uniform :
    ∃ Cprime : ℝ → ℝ → ℝ,
      (∀ a b : ℝ, 0 < a → 0 < Cprime a b) ∧
      ∀ (Ω : Type*) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
        (p : ℕ) (hp : 2 ≤ p)
        (SigmaY : Matrix (Fin p) (Fin p) ℝ) (Y : Ω → Fin p → ℝ),
          Statlib.StatFoundation.RandomVariable.Gaussian.IsCenteredGaussianVector μ Y SigmaY →
          SigmaY.IsSymm →
          (∀ j : Fin p, 0 < SigmaY j j) →
          ∀ (SigmaX : Matrix (Fin p) (Fin p) ℝ) (X : Ω → Fin p → ℝ),
            Statlib.StatFoundation.RandomVariable.Gaussian.IsCenteredGaussianVector μ X SigmaX →
            SigmaX.IsSymm →
            ∀ x : ℝ,
              |(μ {ω | ∀ j : Fin p, X ω j ≤ x}).toReal
                  - (μ {ω | ∀ j : Fin p, Y ω j ≤ x}).toReal| ≤
                Cprime (covDiagMin SigmaY) (covDiagMax SigmaY) *
                  (if covEntryMaxDiff SigmaX SigmaY = 0 then 0
                   else (covEntryMaxDiff SigmaX SigmaY) ^ ((1 : ℝ) / 3) *
                     (max 1 (Real.log ((p : ℝ) / covEntryMaxDiff SigmaX SigmaY))) ^
                                             ((2 : ℝ) / 3)) := by
  classical
  let D : ℝ := 3 * (5 : ℝ) ^ ((1 : ℝ) / 3) * (4 : ℝ) ^ ((2 : ℝ) / 3) + 1
  have hD : 1 < D := by
    have hh : 0 < 3 * (5 : ℝ) ^ ((1 : ℝ) / 3) * (4 : ℝ) ^ ((2 : ℝ) / 3) := by positivity
    dsimp [D]
    linarith only [hh]
  refine ⟨fun a _ => D * (1 + a ^ (-((1 : ℝ) / 3))), ?_, ?_⟩
  · intro a b ha
    exact mul_pos (lt_trans zero_lt_one hD) (by positivity)
  intro Ω _ μ _ p hp SigmaY Y hY hSymmY hpos SigmaX X hX hSymmX x
  haveI : Nonempty (Fin p) := ⟨⟨0, by omega⟩⟩
  have hpR : (0 : ℝ) < (p : ℝ) := by exact_mod_cast (show 0 < p by omega)
  have hlogp : 0 < Real.log (p : ℝ) := Real.log_pos (by exact_mod_cast hp)
  let a : ℝ := covDiagMin SigmaY
  let Δ : ℝ := covEntryMaxDiff SigmaX SigmaY
  have hale (j : Fin p) : a ≤ SigmaY j j := csInf_le (Set.finite_range _).bddBelow ⟨j, rfl⟩
  have hapos : 0 < a := by
    obtain ⟨v, hv⟩ := (Set.finite_range (fun j : Fin p => SigmaY j j)).isClosed.csInf_mem
      (Set.range_nonempty _) (Set.finite_range _).bddBelow
    change 0 < sInf (Set.range (fun j : Fin p => SigmaY j j))
    rw [← hv]
    exact hpos v
  have hΔnn : 0 ≤ Δ := Real.sSup_nonneg (by rintro _ ⟨q, rfl⟩; exact abs_nonneg _)
  let sigma : ℝ := Real.sqrt a
  have hsigma : 0 < sigma := Real.sqrt_pos.mpr hapos
  have hvar : ∀ j : Fin p, sigma ^ 2 ≤ SigmaY j j := by
    intro j
    simpa only [sigma, Real.sq_sqrt hapos.le] using hale j
  let C : ℝ := (Real.sqrt (2 * Real.log (p : ℝ)) + 2) / sigma
  have hC : 0 < C := div_pos (by positivity) hsigma
  have hAC := cck_nazarov_interval_bridge Ω μ p hp SigmaY Y hY sigma hsigma hvar
  have hb := cck_generic_cube_root_bound Ω μ p hp SigmaY hpos Y hY SigmaX X hX C hC hAC x
  change |(μ {ω | ∀ j : Fin p, X ω j ≤ x}).toReal - (μ {ω | ∀ j : Fin p, Y ω j ≤ x}).toReal| ≤
    3 * (3 + (3 / 2) * Real.log (p : ℝ)) ^ ((1 : ℝ) / 3) * C ^ ((2 : ℝ) / 3) * Δ ^ ((1 : ℝ) / 3) at hb
  change |(μ {ω | ∀ j : Fin p, X ω j ≤ x}).toReal - (μ {ω | ∀ j : Fin p, Y ω j ≤ x}).toReal| ≤
    D * (1 + a ^ (-((1 : ℝ) / 3))) *
      (if Δ = 0 then 0 else Δ ^ ((1 : ℝ) / 3) * (max 1 (Real.log ((p : ℝ) / Δ))) ^ ((2 : ℝ) / 3))
  by_cases hΔ : Δ = 0
  · rw [if_pos hΔ, mul_zero]
    simpa only [hΔ, Real.zero_rpow (by norm_num : (1 : ℝ) / 3 ≠ 0), mul_zero] using hb
  rw [if_neg hΔ]
  have hΔpos : 0 < Δ := lt_of_le_of_ne hΔnn (Ne.symm hΔ)
  let L : ℝ := max 1 (Real.log ((p : ℝ) / Δ))
  have hL1 : 1 ≤ L := le_max_left _ _
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hLpow : 1 ≤ L ^ ((2 : ℝ) / 3) := by
    simpa using Real.rpow_le_rpow (by norm_num : (0 : ℝ) ≤ 1) hL1 (by norm_num : (0 : ℝ) ≤ 2 / 3)
  have haq : 0 < a ^ (-((1 : ℝ) / 3)) := Real.rpow_pos_of_pos hapos _
  by_cases hsmall : Δ ≤ 1
  · have hlogle : Real.log (p : ℝ) ≤ L := by
      have hlogΔ : Real.log Δ ≤ 0 := Real.log_nonpos hΔpos.le hsmall
      have hh : Real.log (p : ℝ) ≤ Real.log ((p : ℝ) / Δ) := by
        rw [Real.log_div hpR.ne' hΔpos.ne']
        linarith only [hlogΔ]
      exact le_trans hh (le_max_right _ _)
    have hKle : 3 + (3 / 2) * Real.log (p : ℝ) ≤ 5 * L := by nlinarith only [hlogle, hL1]
    have hKpow : (3 + (3 / 2) * Real.log (p : ℝ)) ^ ((1 : ℝ) / 3) ≤
        (5 : ℝ) ^ ((1 : ℝ) / 3) * L ^ ((1 : ℝ) / 3) := by
      calc _ ≤ (5 * L) ^ ((1 : ℝ) / 3) := Real.rpow_le_rpow (by positivity) hKle (by norm_num)
           _ = _ := Real.mul_rpow (by norm_num) hLpos.le
    have hLs : 1 ≤ Real.sqrt L := by simpa using Real.sqrt_le_sqrt hL1
    have hsqrtle : Real.sqrt (2 * Real.log (p : ℝ)) + 2 ≤ 4 * Real.sqrt L := by
      have hh : Real.sqrt (2 * Real.log (p : ℝ)) ≤ 2 * Real.sqrt L := by
        calc _ ≤ Real.sqrt (4 * L) := Real.sqrt_le_sqrt (by nlinarith only [hlogle, hL1])
             _ = _ := by rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]; norm_num
      linarith
    have hCle : C ≤ 4 * Real.sqrt L / sigma := div_le_div_of_nonneg_right hsqrtle hsigma.le
    have hspow (z : ℝ) (hz : 0 ≤ z) :
        (Real.sqrt z) ^ ((2 : ℝ) / 3) = z ^ ((1 : ℝ) / 3) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hz]
      norm_num
    have hCpow : C ^ ((2 : ℝ) / 3) ≤
        (4 : ℝ) ^ ((2 : ℝ) / 3) * L ^ ((1 : ℝ) / 3) * a ^ (-((1 : ℝ) / 3)) := by
      calc _ ≤ (4 * Real.sqrt L / sigma) ^ ((2 : ℝ) / 3) :=
             Real.rpow_le_rpow hC.le hCle (by norm_num)
           _ = _ := by
             rw [Real.div_rpow (by positivity) hsigma.le, Real.mul_rpow (by norm_num) (Real.sqrt_nonneg L),
               hspow L hLpos.le, show sigma = Real.sqrt a from rfl, hspow a hapos.le,
               div_eq_mul_inv, ← Real.rpow_neg hapos.le]
    have hLmul : L ^ ((1 : ℝ) / 3) * L ^ ((1 : ℝ) / 3) = L ^ ((2 : ℝ) / 3) := by
      rw [← Real.rpow_add hLpos]
      norm_num
    have hprod := mul_le_mul hKpow hCpow (Real.rpow_nonneg hC.le _) (by positivity : 0 ≤ (5 : ℝ) ^ ((1 : ℝ) / 3) * L ^ ((1 : ℝ) / 3))
    have hcoef : 3 * (3 + (3 / 2) * Real.log (p : ℝ)) ^ ((1 : ℝ) / 3) * C ^ ((2 : ℝ) / 3) ≤
        (D - 1) * a ^ (-((1 : ℝ) / 3)) * L ^ ((2 : ℝ) / 3) := by
      calc _ ≤ 3 * (((5 : ℝ) ^ ((1 : ℝ) / 3) * L ^ ((1 : ℝ) / 3)) *
               ((4 : ℝ) ^ ((2 : ℝ) / 3) * L ^ ((1 : ℝ) / 3) * a ^ (-((1 : ℝ) / 3)))) := by
             convert mul_le_mul_of_nonneg_left hprod (by norm_num : (0 : ℝ) ≤ 3) using 1 <;> ring
           _ = _ := by dsimp [D]; rw [show (2 : ℝ) / 3 = 1 / 3 + 1 / 3 by norm_num, Real.rpow_add hLpos]; ring
    have hcoef' : (D - 1) * a ^ (-((1 : ℝ) / 3)) ≤ D * (1 + a ^ (-((1 : ℝ) / 3))) := by nlinarith only [hD, haq]
    calc _ ≤ 3 * (3 + (3 / 2) * Real.log (p : ℝ)) ^ ((1 : ℝ) / 3) * C ^ ((2 : ℝ) / 3) * Δ ^ ((1 : ℝ) / 3) := hb
         _ ≤ ((D - 1) * a ^ (-((1 : ℝ) / 3)) * L ^ ((2 : ℝ) / 3)) * Δ ^ ((1 : ℝ) / 3) :=
           mul_le_mul_of_nonneg_right hcoef (Real.rpow_nonneg hΔnn _)
         _ = ((D - 1) * a ^ (-((1 : ℝ) / 3))) * (Δ ^ ((1 : ℝ) / 3) * L ^ ((2 : ℝ) / 3)) := by ring
         _ ≤ _ := mul_le_mul_of_nonneg_right hcoef' (by positivity)
  · have hΔ1 : 1 ≤ Δ := le_of_lt (lt_of_not_ge hsmall)
    have hΔpow : 1 ≤ Δ ^ ((1 : ℝ) / 3) := by
      simpa using Real.rpow_le_rpow (by norm_num : (0 : ℝ) ≤ 1) hΔ1 (by norm_num : (0 : ℝ) ≤ 1 / 3)
    have hPX : (μ {ω | ∀ j : Fin p, X ω j ≤ x}).toReal ≤ 1 := by
      simpa using ENNReal.toReal_mono ENNReal.one_ne_top (show μ {ω | ∀ j : Fin p, X ω j ≤ x} ≤ 1 from prob_le_one)
    have hPY : (μ {ω | ∀ j : Fin p, Y ω j ≤ x}).toReal ≤ 1 := by
      simpa using ENNReal.toReal_mono ENNReal.one_ne_top (show μ {ω | ∀ j : Fin p, Y ω j ≤ x} ≤ 1 from prob_le_one)
    have hprob : |(μ {ω | ∀ j : Fin p, X ω j ≤ x}).toReal - (μ {ω | ∀ j : Fin p, Y ω j ≤ x}).toReal| ≤ 1 := by
      rw [abs_le]
      constructor <;> linarith [ENNReal.toReal_nonneg (a := μ {ω | ∀ j : Fin p, X ω j ≤ x}), ENNReal.toReal_nonneg (a := μ {ω | ∀ j : Fin p, Y ω j ≤ x})]
    have hC1 : 1 ≤ D * (1 + a ^ (-((1 : ℝ) / 3))) := by nlinarith only [hD, haq]
    have hf : 1 ≤ Δ ^ ((1 : ℝ) / 3) * L ^ ((2 : ℝ) / 3) := by nlinarith only [hΔpow, hLpow]
    exact le_trans hprob (by nlinarith only [hC1, hf])

end Statlib.Imported

