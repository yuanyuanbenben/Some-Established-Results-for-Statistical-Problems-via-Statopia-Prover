/-!
# Smooth maximum (log-sum-exp) and its derivatives

Source: `supp.tex`, Lemma — the smooth max
`F_β(z) = β⁻¹ log (∑_m e^{β z_m})` on `ℝ^p`, together with the weights
`π_j(z) = e^{β z_j} / (∑_m e^{β z_m})`, the source-defined matrix
`w_{jk}(z) = 1(j = k) π_j(z) - π_j(z) π_k(z)`, its first and second
coordinate partial derivatives, and the elementary properties
`π_j ≥ 0`, `∑_j π_j = 1`, `∑_{j,k} |w_{jk}| ≤ 2`.

This is a purely deterministic pointwise statement: no random vector,
distribution, sample size, filter or asymptotic parameter occurs.
-/

namespace Statlib.Imported


open scoped BigOperators

/-- The smooth maximum `F_β(z) = β⁻¹ log (∑_{m=1}^p e^{β z_m})` on `ℝ^p = (Fin p → ℝ)`.
The ordinary (natural) logarithm is used and the sum (not an average) sits
inside the logarithm. -/
noncomputable def smoothMaxFn (β : ℝ) {p : ℕ} (z : Fin p → ℝ) : ℝ :=
  β⁻¹ * Real.log (∑ m : Fin p, Real.exp (β * z m))

/-- The softmax weight `π_j(z) = e^{β z_j} / (∑_{m=1}^p e^{β z_m})`. -/
noncomputable def softmaxWt (β : ℝ) {p : ℕ} (z : Fin p → ℝ) (j : Fin p) : ℝ :=
  Real.exp (β * z j) / (∑ m : Fin p, Real.exp (β * z m))

/-- The source-defined matrix entry
`w_{jk}(z) = 1(j = k) π_j(z) - π_j(z) π_k(z)`, where `1(j = k)` is the
indicator of equality. -/
noncomputable def wMatEntry (β : ℝ) {p : ℕ} (z : Fin p → ℝ) (j k : Fin p) : ℝ :=
  (if j = k then (1 : ℝ) else 0) * softmaxWt β z j - softmaxWt β z j * softmaxWt β z k

/-- The `j`-th coordinate partial derivative `∂_j F(z) = ∂F(z)/∂z_j`
of a function `F` on `ℝ^p = (Fin p → ℝ)`. -/
noncomputable def coordPartial {p : ℕ} (F : (Fin p → ℝ) → ℝ) (j : Fin p)
    (z : Fin p → ℝ) : ℝ :=
  fderiv ℝ F z (Pi.single j 1)

/-- The iterated mixed coordinate partial derivative
`∂_j∂_k F(z) = ∂_j (∂_k F)(z)`. -/
noncomputable def mixedCoordPartial {p : ℕ} (F : (Fin p → ℝ) → ℝ) (j k : Fin p)
    (z : Fin p → ℝ) : ℝ :=
  coordPartial (fun w => coordPartial F k w) j z

