/-- The coordinatewise maximum `max_{1 ≤ j ≤ p} X_j(ω)` in `ℝ^p`
(an ordinary real maximum over the displayed coordinates, not `max_j |X_j|`). -/
noncomputable def coordMax {Ω : Type*} {p : ℕ} (X : Ω → Fin p → ℝ) (ω : Ω) : ℝ :=
  ⨆ j : Fin p, X ω j

/-- `σ_j = √(E[X_j²])`, the *standard deviation* of the `j`-th coordinate. -/
noncomputable def coordStdDev {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Fin p → ℝ) (j : Fin p) : ℝ :=
  Real.sqrt (∫ ω, (X ω j) ^ 2 ∂μ)

/-- `σ̲ = min_{1 ≤ j ≤ p} σ_j`. -/
noncomputable def sigmaUnder {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Fin p → ℝ) : ℝ :=
  ⨅ j : Fin p, coordStdDev μ X j

/-- `σ̄ = max_{1 ≤ j ≤ p} σ_j`. -/
noncomputable def sigmaOver {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, coordStdDev μ X j

/-- `a_p = E[max_{1 ≤ j ≤ p} X_j / σ_j]`: the expectation of the maximum of the
*standardized* coordinates. -/
noncomputable def standardizedMaxMean {Ω : Type*} [MeasurableSpace Ω] {p : ℕ}
    (μ : Measure Ω) (X : Ω → Fin p → ℝ) : ℝ :=
  ∫ ω, (⨆ j : Fin p, X ω j / coordStdDev μ X j) ∂μ

/-- The Lévy concentration function `L(ξ, ε) = sup_{x ∈ ℝ} Pr(|ξ - x| ≤ ε)`,
where the supremum is over a real center `x` and `|·|` is the real absolute value. -/
noncomputable def levyConcentration {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (ξ : Ω → ℝ) (ε : ℝ) : ℝ :=
  ⨆ x : ℝ, (μ {ω | |ξ ω - x| ≤ ε}).toReal

