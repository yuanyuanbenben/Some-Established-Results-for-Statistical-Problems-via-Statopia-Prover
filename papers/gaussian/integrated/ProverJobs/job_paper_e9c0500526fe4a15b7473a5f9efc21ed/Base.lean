    (G : (n : ℕ) → Om' n → Fin (p n) → ℝ)
    (tau : ℕ → ℝ) (perm : ∀ n, Equiv.Perm (Fin (p n))) (n : ℕ) : ℝ :=
  kolmogorovDist
    (Measure.map
      (fun om => maxOverJ (perm n) (kIdx p a n) (sdOf (S n)) (tau n) (SnVec (X n) (muv n) om))
      (Pm n))
