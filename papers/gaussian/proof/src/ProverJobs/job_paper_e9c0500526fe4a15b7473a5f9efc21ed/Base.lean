/-- `k_n ≤ p`. -/
lemma kIdx_le (p : ℕ → ℕ) (a : ℝ) (n : ℕ) : kIdx p a n ≤ p n :=
  Nat.ceil_le.mpr (min_le_right _ _)

/-- `ℓ_n ≥ 1` (since `p n ≥ 1`). -/
lemma one_le_ellIdx (p : ℕ → ℕ) (hp : ∀ n, 1 ≤ p n) (n : ℕ) : 1 ≤ ellIdx p n := by
