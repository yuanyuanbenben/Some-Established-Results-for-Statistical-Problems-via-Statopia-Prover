/-! ### The `II_n` term of the Gaussian approximation theorem

  Source: `supp.tex`, Proposition `prop:bentkus`, the `II_n` part.
  `II_n = d_K(L(M_{k_n}), L(M̃_{k_n})) ≲ n^{-1/2+δ}`. -/

/-- One-dimensional Kolmogorov (Kolmogorov–Smirnov) distance between two
probability measures on `ℝ`: `sup_t |P(U ≤ t) - P(V ≤ t)|`. -/
def kolmogorovDist (mu nu : Measure ℝ) : ℝ :=
  ⨆ t : ℝ, |(mu (Set.Iic t)).toReal - (nu (Set.Iic t)).toReal|

/-- `a_n ≲ b_n`: eventual domination by `c * b_n` with `c > 0` independent of `n`. -/
def LessSim (u v : ℕ → ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∃ n0 : ℕ, 1 ≤ n0 ∧ ∀ n, n0 ≤ n → u n ≤ c * v n

/-- The standard deviations `σ_j = √(Σ_jj)` (square roots of the diagonal of `Σ`,
  which is the variance of the `j`-th coordinate, since `X_i = μ + Σ^{1/2} Z_i`). -/
def sdOf {pn : ℕ} (S : Matrix (Fin pn) (Fin pn) ℝ) : Fin pn → ℝ :=
  fun j => Real.sqrt (S j j)

/-- The symmetric positive semidefinite square root `Σ^{1/2}`. -/
def sqrtCovMat {pn : ℕ} {S : Matrix (Fin pn) (Fin pn) ℝ} (hS : S.PosSemidef) :
    Matrix (Fin pn) (Fin pn) ℝ :=
  Matrix.PosSemidef.sqrt hS

/-- `S_n = n^{-1/2} ∑_{i=1}^n (X_i - E[X_i])`, coordinatewise
  (here `E[X_i] = μ`, so we subtract `μ`). -/
def SnVec {pn n : ℕ} {Om : Type*} (X : Fin n → Om → Fin pn → ℝ) (muv : Fin pn → ℝ)
    (om : Om) : Fin pn → ℝ :=
  fun j => (Real.sqrt (n : ℝ))⁻¹ * ∑ i : Fin n, (X i om j - muv j)

/-- `S̃_n = Σ^{1/2} G`, where `G ~ N(0, I_p)`, so that `S̃_n ~ N(0, Σ)`. -/
def StildeVec {pn : ℕ} {S : Matrix (Fin pn) (Fin pn) ℝ} (hS : S.PosSemidef)
    {Om : Type} (G : Om → Fin pn → ℝ) (om : Om) : Fin pn → ℝ :=
  (sqrtCovMat hS).mulVec (G om)

/-- The positions `{0, …, d-1}` of the decreasing rearrangement of `σ`. -/
def Jpos {pn : ℕ} (d : ℕ) : Finset (Fin pn) :=
  Finset.univ.filter (fun i => i.1 < d)

/-- `J(d)`: the set of the `d` coordinate indices carrying the `d` largest standard
deviations, as given by the decreasing-rearrangement permutation `perm`. -/
def Jset {pn : ℕ} (perm : Equiv.Perm (Fin pn)) (d : ℕ) : Finset (Fin pn) :=
  (Jpos (pn := pn) d).image perm

/-- `M_d = max_{j ∈ J(d)} v_j / σ_j^{τ}` (the junk value `sSup ∅ = 0` is never
  used, since `1 ≤ k_n ≤ p`). -/
def maxOverJ {pn : ℕ} (perm : Equiv.Perm (Fin pn)) (d : ℕ) (sd : Fin pn → ℝ) (tau : ℝ)
    (v : Fin pn → ℝ) : ℝ :=
  sSup (((Jset perm d).image (fun j => v j / (sd j) ^ tau)) : Set ℝ)

/-- `ℓ_n = ⌈min(max 1 (log n)^3, p)⌉`. -/
def ellIdx (p : ℕ → ℕ) (n : ℕ) : ℕ :=
  Nat.ceil (min (max 1 ((Real.log (n : ℝ)) ^ 3)) (p n : ℝ))

/-- `k_n = ⌈min(max ℓ_n n^{1/(log n)^a}, p)⌉`. -/
def kIdx (p : ℕ → ℕ) (a : ℝ) (n : ℕ) : ℕ :=
  Nat.ceil (min (max (ellIdx p n : ℝ) ((n : ℝ) ^ (1 / (Real.log (n : ℝ)) ^ a))) (p n : ℝ))

/-- `ℓ_n ≤ p`. -/
lemma ellIdx_le (p : ℕ → ℕ) (n : ℕ) : ellIdx p n ≤ p n :=
  Nat.ceil_le.mpr (min_le_right _ _)

/-- Position `i : Fin d` read as a coordinate index `Fin p`, under `d ≤ p`. -/
def posIn {pn d : ℕ} (hdp : d ≤ pn) (i : Fin d) : Fin pn :=
  ⟨i.1, lt_of_lt_of_le i.2 hdp⟩

/-- The correlation matrix `R(d)` of the coordinates `{X_{1,j} : j ∈ J(d)}`, in the
ordering `perm` (a correlation matrix, `Σ_{j_i j_j} / (σ_{j_i} σ_{j_j})`, neither the
covariance matrix nor the QR factor of the proof). -/
def Rcorr {pn : ℕ} (S : Matrix (Fin pn) (Fin pn) ℝ) (perm : Equiv.Perm (Fin pn))
    (d : ℕ) (hdp : d ≤ pn) : Matrix (Fin d) (Fin d) ℝ :=
  Matrix.of (fun i j =>
    S (perm (posIn hdp i)) (perm (posIn hdp j)) /
      (sdOf S (perm (posIn hdp i)) * sdOf S (perm (posIn hdp j))))

/-- The entrywise positive part `R⁺(d)`, `R⁺_{ij} = max{R_{ij}, 0}`. -/
def Rpos {pn : ℕ} (S : Matrix (Fin pn) (Fin pn) ℝ) (perm : Equiv.Perm (Fin pn))
    (d : ℕ) (hdp : d ≤ pn) : Matrix (Fin d) (Fin d) ℝ :=
  Matrix.of (fun i j => max (Rcorr S perm d hdp i j) 0)

/-- `II_n = d_K(L(M_{k_n}), L(M̃_{k_n}))`. -/
def IIn (p : ℕ → ℕ) (a : ℝ)
    (Om : ℕ → Type u₀) [mOm : ∀ n, MeasurableSpace.{u₀} (Om n)]
    (Pm : ∀ n, MeasureTheory.Measure.{u₀} (Om n))
    (Om' : ℕ → Type) [mOm' : ∀ n, MeasurableSpace (Om' n)]
    (Pm' : ∀ n, MeasureTheory.Measure (Om' n))
    (X : (n : ℕ) → Fin n → Om n → Fin (p n) → ℝ) (muv : (n : ℕ) → Fin (p n) → ℝ)
    (S : (n : ℕ) → Matrix (Fin (p n)) (Fin (p n)) ℝ) (hS : ∀ n, (S n).PosSemidef)
    (G : (n : ℕ) → Om' n → Fin (p n) → ℝ)
    (tau : ℕ → ℝ) (perm : ∀ n, Equiv.Perm (Fin (p n))) (n : ℕ) : ℝ :=
  kolmogorovDist
    (Measure.map
      (fun om => maxOverJ (perm n) (kIdx p a n) (sdOf (S n)) (tau n) (SnVec (X n) (muv n) om))
      (Pm n))
    (Measure.map
      (fun om => maxOverJ (perm n) (kIdx p a n) (sdOf (S n)) (tau n)
        (StildeVec (hS n) (G n) om))
      (Pm' n))

