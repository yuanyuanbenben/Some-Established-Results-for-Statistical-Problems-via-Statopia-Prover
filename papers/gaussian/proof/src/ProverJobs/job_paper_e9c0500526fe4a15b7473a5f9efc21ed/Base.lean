/-- `ℓ_n ≤ k_n`. -/
lemma ellIdx_le_kIdx (p : ℕ → ℕ) (a : ℝ) (n : ℕ) : ellIdx p n ≤ kIdx p a n := by
  have h : (ellIdx p n : ℝ) ≤
      min (max (ellIdx p n : ℝ) ((n : ℝ) ^ (1 / (Real.log (n : ℝ)) ^ a))) (p n : ℝ) :=
    le_min (le_max_left _ _) (by exact_mod_cast ellIdx_le p n)
  have h2 : ((ellIdx p n : ℕ) : ℝ) ≤ ((kIdx p a n : ℕ) : ℝ) :=
    le_trans h
      (Nat.le_ceil (min (max (ellIdx p n : ℝ) ((n : ℝ) ^ (1 / (Real.log (n : ℝ)) ^ a)))
        (p n : ℝ)))
