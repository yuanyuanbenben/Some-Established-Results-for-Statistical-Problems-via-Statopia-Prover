/-- Density of an `s`-component mixture with weights `q` and latent parameters `θs`:
`x ↦ ∑_{j=1}^s q_j k(x | θ_j)`. -/
noncomputable def dpMixDensity {Θ X : Type*} (k : Θ → X → ℝ) {s : ℕ}
    (q : Fin s → ℝ) (θs : Fin s → Θ) : X → ℝ :=
  fun x => ∑ j : Fin s, q j * k (θs j) x

/-- A probability measure whose `μ`-density is an *exact* `s`-component mixture:
positive weights `q_j > 0`, weights summing to one, pairwise distinct parameters
`θ_1, …, θ_s`, and `P(dx) = p_0(x) μ(dx)` with `p_0 = ∑_j q_j k(·|θ_j)`. -/
def IsMixtureMeasure {Θ X : Type*} [MeasurableSpace X] (μ : Measure X) (k : Θ → X → ℝ)
    {s : ℕ} (q : Fin s → ℝ) (θs : Fin s → Θ) (P : Measure X) : Prop :=
  (∀ j : Fin s, 0 < q j) ∧ (∑ j : Fin s, q j = 1) ∧ Function.Injective θs ∧
    P = μ.withDensity (fun x => ENNReal.ofReal (dpMixDensity k q θs x))

/-- `𝔾_s`: the set of *exact* `s`-component mixtures, viewed as probability measures via
the density-to-measure identification `g ↦ g dμ` (not "at most `s`", not a closure). -/
def Gset {Θ X : Type*} [MeasurableSpace X] (μ : Measure X) (k : Θ → X → ℝ) (s : ℕ) :
    Set (ProbabilityMeasure X) :=
  {P | ∃ (q : Fin s → ℝ) (θs : Fin s → Θ), IsMixtureMeasure μ k q θs P.toMeasure}

/-- The mixture density `p_0 = ∑_{j=1}^s q_j k(·|θ_j)` as an `ℝ≥0∞`-valued `μ`-density
(the `ℝ≥0∞`-valued twin of `dpMixDensity`). -/
noncomputable def mixtureDensity {Θ X : Type*} (k : Θ → X → ℝ) {s : ℕ}
    (q : Fin s → ℝ) (θs : Fin s → Θ) : X → ℝ≥0∞ :=
  fun x => ∑ j : Fin s, ENNReal.ofReal (q j) * ENNReal.ofReal (k (θs j) x)

/-- The KL neighbourhood
`KL_ε(P) = {h : ∫ log(p_0(x) / h(x)) P(dx) < ε}` of the `μ`-density `p_0` of an exact
`t`-component mixture `P`, for `ε > 0`.  It is expressed through the extended-real
Kullback–Leibler divergence `∫ log (dP/dQ) dP`, so a density `h` whose KL divergence from
`P` is infinite (in particular one that is not absolutely continuous with respect to `P`)
is **excluded**, while a density with finite — possibly negative — KL divergence is
admitted.  No junk value of a real Bochner integral is involved.  Positivity of `h` and
absolute continuity are left implicit, as in the source. -/
noncomputable def KLneighborhood {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (p0 : X → ℝ≥0∞) (ε : ℝ) : Set (X → ℝ≥0∞) :=
  {h | InformationTheory.klDiv (μ.withDensity p0) (μ.withDensity h) < ENNReal.ofReal ε}

/-- `ν` is the law `DP(α, Q_0)` of a Dirichlet process with concentration parameter
`α > 0` and base measure `Q_0`: the standard characterisation through the
finite-dimensional Dirichlet distributions, i.e. for pairwise disjoint measurable
`A_1, …, A_s` the moment identity
`E[∏_j P̃(A_j)^{m_j}] = (∏_j ∏_{r<m_j} (α Q_0(A_j) + r)) / ∏_{r<m} (α + r)` with
`m = ∑_j m_j` (`α^{(m)} = α(α+1)⋯(α+m-1)` the rising factorial). -/
def IsDirichletProcessLaw {Θ : Type*} [MeasurableSpace Θ] (α : ℝ) (Q0 : Measure Θ)
    (ν : Measure (ProbabilityMeasure Θ)) : Prop :=
  IsProbabilityMeasure ν ∧
    ∀ (s : ℕ) (A : Fin s → Set Θ), (∀ j : Fin s, MeasurableSet (A j)) →
      (∀ i j : Fin s, i ≠ j → Disjoint (A i) (A j)) →
        ∀ m : Fin s → ℕ,
          ∫⁻ P : ProbabilityMeasure Θ, (∏ j : Fin s, (P.toMeasure (A j)) ^ (m j)) ∂ν =
            ENNReal.ofReal
              ((∏ j : Fin s, (Finset.range (m j)).prod
                  (fun r : ℕ => α * (Q0 (A j)).toReal + (r : ℝ))) /
                (Finset.range (∑ j : Fin s, m j)).prod (fun r : ℕ => α + (r : ℝ)))

/-- The Dirichlet process mixture random density `h(x) = ∫ k(x | θ) P̃(dθ)` of a draw `P̃`
of the Dirichlet process.  It retains an infinite residual-mixture component and is in
general *not* an `s`-component mixture, even when `K_n = s`. -/
noncomputable def dpmDensity {Θ X : Type*} [MeasurableSpace Θ] (k : Θ → X → ℝ)
    (P : ProbabilityMeasure Θ) : X → ℝ≥0∞ :=
  fun x => ∫⁻ θ, ENNReal.ofReal (k θ x) ∂P.toMeasure

/-- `K_n`: the number of clusters, i.e. the number of distinct latent parameters among
`θ_1, …, θ_n`. -/
noncomputable def clusterCount {Θ : Type*} (θt : ℕ → Θ) (n : ℕ) : ℕ :=
  (Set.range (fun i : Fin n => θt i)).ncard

/-- The Dirichlet process mixture model: the base measure `Q_0`, the prior `π` on the
concentration parameter `α > 0`, and the conditional law `dpLaw` of the Dirichlet process
draw.  The joint law of `(P̃, θ_{1:∞})` (`latentLaw` below) is the composition
`∫∫ DP(α, Q_0)(dP̃) ⊗ P̃^{⊗∞} π(dα)`: `α ~ π`, `P̃ | α ~ DP(α, Q_0)`, and
`θ_1, θ_2, … | P̃ ~iid P̃`. -/
structure DPMModel (Θ : Type*) [MeasurableSpace Θ] [TopologicalSpace Θ] where
  /-- base measure `Q_0` on the latent parameter space -/
  Q0 : Measure Θ
  hQ0 : IsProbabilityMeasure Q0
  /-- prior `π` on the concentration parameter `α > 0` -/
  π : Measure ℝ
  hπ : IsProbabilityMeasure π
  hπ_pos : ∀ᵐ a ∂π, 0 < a
  /-- the conditional law of `P̃` given `α = a` -/
  dpLaw : ℝ → Measure (ProbabilityMeasure Θ)
  dpLaw_meas : Measurable dpLaw
  /-- `P̃ | α = a ~ DP(a, Q_0)` for `π`-almost every `a` -/
  dpLaw_dirichlet : ∀ᵐ a ∂π, IsDirichletProcessLaw a Q0 (dpLaw a)

namespace DPMModel

/-- The joint law of `(P̃, θ_{1:∞})` under the Dirichlet process mixture prior:
`α ~ π`, `P̃ | α ~ DP(α, Q_0)`, and `θ_1, θ_2, … | P̃ ~iid P̃` (independently of `α` given
`P̃`).  Both components are the canonical measurable projections of this law. -/
noncomputable def latentLaw {Θ : Type*} [MeasurableSpace Θ] [TopologicalSpace Θ]
    (M : DPMModel Θ) : Measure (ProbabilityMeasure Θ × (ℕ → Θ)) :=
  M.π.bind fun a =>
    (M.dpLaw a).bind fun P =>
      (Measure.dirac P).prod (Measure.infinitePi (fun _ : ℕ => P.toMeasure))

end DPMModel

/-- Posterior probability `pr(K_n < t | X_{1:n})` under the Dirichlet process mixture model
`M`: the Bayes ratio `pr(K_n < t ∧ X_{1:n}) / pr(X_{1:n})` with the mixture likelihood
`∏_{i<n} k(x_i | θ_i)` and the DPM prior `M.latentLaw` on `(P̃, θ_{1:∞})`.  This fixes one
version of the posterior (a null marginal denominator gives the junk value `0`); the source
leaves the choice of regular conditional version unspecified. -/
noncomputable def posteriorProb {Θ X : Type*} [TopologicalSpace Θ] [MeasurableSpace Θ]
    [MeasurableSpace X] (M : DPMModel Θ) (k : Θ → X → ℝ) (t n : ℕ) (x : Fin n → X) : ℝ≥0∞ :=
  (∫⁻ ξ : ProbabilityMeasure Θ × (ℕ → Θ),
      (if clusterCount ξ.2 n < t then
        ∏ i : Fin n, ENNReal.ofReal (k (ξ.2 i) (x i)) else 0) ∂M.latentLaw) /
    (∫⁻ ξ : ProbabilityMeasure Θ × (ℕ → Θ),
      (∏ i : Fin n, ENNReal.ofReal (k (ξ.2 i) (x i))) ∂M.latentLaw)

/-- `P^{(∞)}`: the law of the infinite i.i.d. sequence `X_{1:∞}` under sampling from the
*true* density `P` (not under the Dirichlet process prior). -/
noncomputable def truthLaw {X : Type*} [MeasurableSpace X] (P : Measure X) : Measure (ℕ → X) :=
  Measure.infinitePi (fun _ : ℕ => P)

/-- Assumption `H4`: for every `t ≥ 1` and every exact `t`-component mixture
`p_0 = ∑_j q_j k(·|θ_j)` whose parameters lie in `supp Q_0`, the Dirichlet process mixture
prior puts positive mass on every KL neighbourhood `KL_ε(P)` of the probability measure
with density `p_0`, `ε > 0`.  This asserts positive prior mass, not a lower bound uniform in
`ε`, `P` or `t`. -/
def H4Condition {Θ X : Type*} [MeasurableSpace Θ] [TopologicalSpace Θ] [MeasurableSpace X]
    (M : DPMModel Θ) (μ : Measure X) (k : Θ → X → ℝ) : Prop :=
  ∀ (t : ℕ), 1 ≤ t → ∀ (q : Fin t → ℝ) (θs : Fin t → Θ),
    (∀ j : Fin t, 0 < q j) → (∑ j : Fin t, q j = 1) → Function.Injective θs →
      (∀ j : Fin t, θs j ∈ M.Q0.support) →
        ∀ ε : ℝ, 0 < ε →
          0 < M.latentLaw {ξ : ProbabilityMeasure Θ × (ℕ → Θ) |
            dpmDensity k ξ.1 ∈ KLneighborhood μ (mixtureDensity k q θs) ε}


