/-- The *unnormalized* lower incomplete Gamma function
`γ(x,y) = ∫_0^y z^(x-1) e^{-z} dz`. -/
noncomputable def lowerGamma (x y : ℝ) : ℝ :=
  ∫ z in Set.Ioc (0 : ℝ) y, z ^ (x - 1) * Real.exp (-z)

/-- The prior integral `∫_0^∞ α^e / α^(n) π(α) dα`, valued in the extended
nonnegative reals so that no finiteness of the integral is assumed. -/
