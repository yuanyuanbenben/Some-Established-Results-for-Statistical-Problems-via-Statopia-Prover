/-- Finite exchangeability of an infinite sequence of random variables with values in an
arbitrary measurable space: for every `m`, every permutation of the first `m` coordinates
leaves the law of the resulting `m`-tuple unchanged.  (No independence is assumed.) -/
def ExchangeableSeq {Ω 𝒳 : Type*} [MeasurableSpace Ω] [MeasurableSpace 𝒳]
    (X : ℕ → Ω → 𝒳) (μ : Measure Ω) : Prop :=
  ∀ (m : ℕ) (σ : Equiv.Perm (Fin m)),
    Measure.map (fun ω (i : Fin m) => X ((σ i).val) ω) μ
      = Measure.map (fun ω (i : Fin m) => X (i.val) ω) μ

/-- Restriction of a sequence to the first `n` indices. -/
def restrictSeq {Ω 𝒳 : Type*} (X : ℕ → Ω → 𝒳) (n : ℕ) : Fin n → Ω → 𝒳 :=
  fun i => X (i.val)

/-- The marginal likelihood of a block `A` of observations,
`m(X_A) = ∫ ∏_{i ∈ A} k(X_i | θ) Q₀(dθ)`: an integral in the latent parameter `θ` against the
mixing measure `Q₀` (never `q₀(θ) dθ` unless a density assumption is added). -/
noncomputable def margLikelihood {ι Ω 𝒳 Θ : Type*} [MeasurableSpace 𝒳] [MeasurableSpace Θ]
    (X : ι → Ω → 𝒳) (k : Θ → 𝒳 → ℝ) (Q0 : Measure Θ) (A : Finset ι) (ω : Ω) : ℝ :=
  ∫ θ, ∏ i ∈ A, k θ (X i ω) ∂Q0

/-- Product of the marginal likelihoods of the blocks of a partition `P`. -/
noncomputable def blockProduct {ι Ω 𝒳 Θ : Type*} [MeasurableSpace 𝒳] [MeasurableSpace Θ]
    (X : ι → Ω → 𝒳) (k : Θ → 𝒳 → ℝ) (Q0 : Measure Θ)
    (P : Finset (Finset ι)) (ω : Ω) : ℝ :=
  ∏ B ∈ P, margLikelihood X k Q0 B ω

/-- `τ_s(n)`: the set of partitions of `{1,…,n}` (here `Fin n`) into exactly `s` nonempty
blocks, each partition counted once, with the block labels forgotten. -/
noncomputable def partitionsInto (n s : ℕ) : Finset (Finset (Finset (Fin n))) := by
  classical
  exact (Finset.univ : Finset (Finset (Finset (Fin n)))).filter (fun P =>
    P.card = s ∧ (∀ B ∈ P, B.Nonempty) ∧ P.sup id = Finset.univ ∧
      (∀ B ∈ P, ∀ C ∈ P, B ≠ C → Disjoint B C))

/-- `𝓕_s(n)`: the set of ordered positive compositions of `n` into `s` parts,
`{a ∈ {1,…,n}^s : ∑_j a_j = n}`, each ordering counted separately. -/
noncomputable def orderedCompositions (n s : ℕ) : Finset (Fin s → Fin (n + 1)) :=
  (Finset.univ : Finset (Fin s → Fin (n + 1))).filter
    (fun a => (∀ j, 1 ≤ (a j).val) ∧ (∑ j : Fin s, (a j).val) = n)

/-- The partial sum `a_1 + ⋯ + a_j` of an ordered composition `a`. -/
def partialSum {s : ℕ} (n : ℕ) (a : Fin s → Fin (n + 1)) (j : ℕ) : ℕ :=
  ∑ k : Fin s, if (k : ℕ) < j then (a k).val else 0

/-- A canonical partition `A^a` realising the ordered composition `a`: the `j`-th block
consists of the indices lying in the `j`-th interval determined by the partial sums of `a`. -/
def canonBlock (n s : ℕ) (a : Fin s → Fin (n + 1)) (j : Fin s) : Finset (Fin n) :=
  Finset.univ.filter (fun i => partialSum n a (j : ℕ) ≤ (i : ℕ) ∧
    (i : ℕ) < partialSum n a ((j : ℕ) + 1))

