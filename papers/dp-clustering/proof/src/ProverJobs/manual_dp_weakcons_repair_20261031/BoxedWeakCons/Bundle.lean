    Tendsto (fun i => ∫ x, φ x ∂(μseq i)) atTop (𝓝 (∫ x, φ x ∂ν))

/-- The exceptional set `B = {θ̄ ∈ closure Θ \ Θ : lim_{θ→θ̄} sup_x k(x|θ) = ∞}`. -/
def BSet (k : ℝ → ℝ → ℝ) (Θ : Set ℝ) : Set ℝ :=
