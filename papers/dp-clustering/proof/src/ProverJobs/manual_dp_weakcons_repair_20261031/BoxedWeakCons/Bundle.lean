        = (∫ x, ∏ i : Fin m, (x.ofLp i) ^ (k i) ∂mu)),
    nu = mu := by
  /- @proof-region region.target-node.session.2a0f921467a7279c begin -/
  intro m mu nu hmu_prob hnu_prob hmu_K hnu_K hmom
  classical
  let K : Set (EuclideanSpace ℝ (Fin m)) := {x | (∀ i, 0 ≤ x.ofLp i) ∧ (∑ i, x.ofLp i) = 1}
  have hmu_K' : mu K = 1 := by simpa [K] using hmu_K
  have hnu_K' : nu K = 1 := by simpa [K] using hnu_K
  haveI hfinmu : IsFiniteMeasure mu := ⟨by rw [hmu_prob]; exact ENNReal.one_lt_top⟩
  haveI hfinnu : IsFiniteMeasure nu := ⟨by rw [hnu_prob]; exact ENNReal.one_lt_top⟩
  have hcoord : ∀ i : Fin m, Continuous fun x : EuclideanSpace ℝ (Fin m) => x.ofLp i := by
    intro i
    fun_prop
  have hK_closed : IsClosed K := by
    have h1 : IsClosed {x : EuclideanSpace ℝ (Fin m) | ∀ i, 0 ≤ x.ofLp i} := by
      have heq : {x : EuclideanSpace ℝ (Fin m) | ∀ i, 0 ≤ x.ofLp i}
          = ⋂ i, {x : EuclideanSpace ℝ (Fin m) | 0 ≤ x.ofLp i} := by
        ext x
        simp
      rw [heq]
      exact isClosed_iInter fun i => isClosed_le continuous_const (hcoord i)
    have h2 : IsClosed {x : EuclideanSpace ℝ (Fin m) | (∑ i, x.ofLp i) = 1} :=
      isClosed_eq (continuous_finset_sum _ fun i _ => hcoord i) continuous_const
    exact h1.inter h2
  have hK_meas : MeasurableSet K := hK_closed.measurableSet
  have hK_coord : ∀ x ∈ K, ∀ i, x.ofLp i ∈ Set.Icc (0 : ℝ) 1 := by
    intro x hx i
    refine ⟨hx.1 i, ?_⟩
    have h := Finset.single_le_sum (f := fun j => x.ofLp j) (fun j _ => hx.1 j) (Finset.mem_univ i)
    calc x.ofLp i ≤ ∑ j, x.ofLp j := by simpa using h
      _ = 1 := hx.2
  have hnorm_le : ∀ x ∈ K, ‖x‖ ≤ 1 := by
    intro x hx
    rw [EuclideanSpace.norm_eq, Real.sqrt_le_one]
    calc ∑ i, ‖x.ofLp i‖ ^ 2 ≤ ∑ i, x.ofLp i := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [Real.norm_eq_abs, abs_of_nonneg (hx.1 i)]
          nlinarith [(hK_coord x hx i).1, (hK_coord x hx i).2]
      _ = 1 := hx.2
  have hK_bdd : Bornology.IsBounded K := by
    rw [Metric.isBounded_iff_subset_closedBall (0 : EuclideanSpace ℝ (Fin m))]
    exact ⟨1, fun x hx => by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hnorm_le x hx⟩
  have hK_compact : IsCompact K := (Metric.isCompact_iff_isClosed_bounded).mpr ⟨hK_closed, hK_bdd⟩
  have hnu_Kc : nu Kᶜ = 0 := by
    rw [measure_compl hK_meas (by rw [hnu_K']; exact ENNReal.one_ne_top), hnu_prob, hnu_K']
    simp
  have hmu_Kc : mu Kᶜ = 0 := by
    rw [measure_compl hK_meas (by rw [hmu_K']; exact ENNReal.one_ne_top), hmu_prob, hmu_K']
    simp
  haveI hcs : CompactSpace ↥K := isCompact_iff_compactSpace.mp hK_compact
  let hcoordC : Fin m → C(EuclideanSpace ℝ (Fin m), ℝ) :=
    fun i => ⟨fun x => x.ofLp i, hcoord i⟩
  let amon : (Fin m → ℕ) → C(EuclideanSpace ℝ (Fin m), ℝ) := fun k => ∏ i, (hcoordC i) ^ (k i)
  have hamon_apply : ∀ (k : Fin m → ℕ) (x : EuclideanSpace ℝ (Fin m)),
      (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x = ∏ i, x.ofLp i ^ k i := by
    intro k x
    simp [amon, hcoordC]
  have hae : ∀ (mu' : Measure (EuclideanSpace ℝ (Fin m))), mu' Kᶜ = 0 →
      ∀ᵐ x ∂mu', x ∈ K := by
    intro mu' h
    rw [MeasureTheory.ae_iff]
    simpa using h
  have hint : ∀ (mu' : Measure (EuclideanSpace ℝ (Fin m))), IsFiniteMeasure mu' → mu' Kᶜ = 0 →
      ∀ (f : C(EuclideanSpace ℝ (Fin m), ℝ)) (C : ℝ),
        (∀ x ∈ K, ‖(f : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ≤ C) →
        Integrable (fun x => (f : EuclideanSpace ℝ (Fin m) → ℝ) x) mu' := by
    intro mu' hfin hKc f C hC
    exact Integrable.of_bound f.continuous.aestronglyMeasurable C (by
      filter_upwards [hae mu' hKc] with x hx
      exact hC x hx)
  have hmon_bound : ∀ (k : Fin m → ℕ) (x : EuclideanSpace ℝ (Fin m)), x ∈ K →
      ‖(amon k : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ≤ 1 := by
    intro k x hx
    rw [hamon_apply k x, Real.norm_eq_abs,
      abs_of_nonneg (Finset.prod_nonneg fun i _ => pow_nonneg (hx.1 i) _)]
    exact Finset.prod_le_one (fun i _ => pow_nonneg (hx.1 i) _)
      (fun i _ => pow_le_one₀ (hx.1 i) (hK_coord x hx i).2)
  have hamon : ∀ k : Fin m → ℕ,
      (∫ x, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu)
        = ∫ x, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := by
    intro k
    simpa only [hamon_apply] using hmom k
  have hmonK : ∀ k : Fin m → ℕ,
      ∫ x in K, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        = ∫ x in K, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := by
    intro k
    have hνi : Integrable (fun x => (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x) nu :=
      hint nu hfinnu hnu_Kc (amon k) 1 (hmon_bound k)
    have hμi : Integrable (fun x => (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x) mu :=
      hint mu hfinmu hmu_Kc (amon k) 1 (hmon_bound k)
    have h0ν : ∫ x in Kᶜ, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu = 0 := by
      rw [Measure.restrict_eq_zero.mpr hnu_Kc]
      simp
    have h0μ : ∫ x in Kᶜ, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu = 0 := by
      rw [Measure.restrict_eq_zero.mpr hmu_Kc]
      simp
    calc ∫ x in K, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        = ∫ x, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu := by
          rw [← integral_add_compl hK_meas hνi, h0ν, add_zero]
      _ = ∫ x, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := hamon k
      _ = ∫ x in K, (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := by
          rw [← integral_add_compl hK_meas hμi, h0μ, add_zero]
  have hPK : ∀ P : C(EuclideanSpace ℝ (Fin m), ℝ), ∃ C,
      ∀ x ∈ K, ‖(P : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ≤ C := by
    intro P
    let Q : C(↥K, ℝ) :=
      ⟨fun y => (P : EuclideanSpace ℝ (Fin m) → ℝ) y, P.continuous.comp continuous_subtype_val⟩
    refine ⟨‖Q‖, fun x hx => ?_⟩
    simpa [Q] using ContinuousMap.norm_coe_le_norm Q ⟨x, hx⟩
  have hIntK : ∀ P : C(EuclideanSpace ℝ (Fin m), ℝ),
      Integrable (fun x => (P : EuclideanSpace ℝ (Fin m) → ℝ) x) (nu.restrict K) ∧
        Integrable (fun x => (P : EuclideanSpace ℝ (Fin m) → ℝ) x) (mu.restrict K) := by
    have hfinν : IsFiniteMeasure (nu.restrict K) :=
      isFiniteMeasure_restrict.mpr (by rw [hnu_K']; exact ENNReal.one_ne_top)
    have hfinμ : IsFiniteMeasure (mu.restrict K) :=
      isFiniteMeasure_restrict.mpr (by rw [hmu_K']; exact ENNReal.one_ne_top)
    have hνc : (nu.restrict K) Kᶜ = 0 := by
      rw [Measure.restrict_apply' hK_meas]
      simp
    have hμc : (mu.restrict K) Kᶜ = 0 := by
      rw [Measure.restrict_apply' hK_meas]
      simp
    intro P
    obtain ⟨C, hC⟩ := hPK P
    exact ⟨hint (nu.restrict K) hfinν hνc P C hC, hint (mu.restrict K) hfinμ hμc P C hC⟩
  have hW_int : ∀ P ∈ Submodule.span ℝ (Set.range amon),
      ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        = ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := by
    intro P hP
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hP
    · intro p hp
      obtain ⟨k, rfl⟩ := hp
      exact hmonK k
    · simp
    · intro p q hp hq ihp ihq
      have hpq : ((p + q : C(EuclideanSpace ℝ (Fin m), ℝ)) : EuclideanSpace ℝ (Fin m) → ℝ)
          = fun x => (p : EuclideanSpace ℝ (Fin m) → ℝ) x + (q : EuclideanSpace ℝ (Fin m) → ℝ) x :=
        rfl
      rw [hpq, integral_add (hIntK p).1 (hIntK q).1, integral_add (hIntK p).2 (hIntK q).2, ihp, ihq]
    · intro c p hp ih
      have hcp : ((c • p : C(EuclideanSpace ℝ (Fin m), ℝ)) : EuclideanSpace ℝ (Fin m) → ℝ)
          = fun x => c * (p : EuclideanSpace ℝ (Fin m) → ℝ) x := by
        ext x
        simp
      rw [hcp, integral_const_mul, integral_const_mul, ih]
  have hamon_mul : ∀ k l : Fin m → ℕ, amon k * amon l = amon (k + l) := by
    intro k l
    ext x
    have h4 : ((amon k * amon l : C(EuclideanSpace ℝ (Fin m), ℝ)) :
        EuclideanSpace ℝ (Fin m) → ℝ) x
        = (amon k : EuclideanSpace ℝ (Fin m) → ℝ) x
          * (amon l : EuclideanSpace ℝ (Fin m) → ℝ) x := rfl
    rw [h4, hamon_apply k x, hamon_apply l x, hamon_apply (k + l) x, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ => by rw [Pi.add_apply, pow_add]
  have hamon_zero : amon (0 : Fin m → ℕ) = 1 := by
    ext x
    rw [hamon_apply]
    simp
  have hone_mem : (1 : C(EuclideanSpace ℝ (Fin m), ℝ)) ∈ Submodule.span ℝ (Set.range amon) := by
    rw [← hamon_zero]
    exact Submodule.subset_span (Set.mem_range_self 0)
  have hleft : ∀ a ∈ Submodule.span ℝ (Set.range amon), ∀ s ∈ Set.range amon,
      s * a ∈ Submodule.span ℝ (Set.range amon) := by
    intro a ha
    refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
    · intro x hx s hs
      obtain ⟨k, rfl⟩ := hx
      obtain ⟨l, rfl⟩ := hs
      rw [hamon_mul l k]
      exact Submodule.subset_span (Set.mem_range_self (l + k))
    · intro s hs
      simp
    · intro x y hx hy ihx ihy s hs
      rw [mul_add]
      exact Submodule.add_mem _ (ihx s hs) (ihy s hs)
    · intro c x hx ih s hs
      rw [mul_smul_comm]
      exact Submodule.smul_mem _ c (ih s hs)
  have hW_mul : ∀ P ∈ Submodule.span ℝ (Set.range amon),
      ∀ Q ∈ Submodule.span ℝ (Set.range amon), P * Q ∈ Submodule.span ℝ (Set.range amon) := by
    intro P hP
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hP
    · intro p hp Q hQ
      exact hleft Q hQ p hp
    · intro Q hQ
      simp
    · intro p q hp hq ihp ihq Q hQ
      rw [add_mul]
      exact Submodule.add_mem _ (ihp Q hQ) (ihq Q hQ)
    · intro c p hp ih Q hQ
      rw [smul_mul_assoc]
      exact Submodule.smul_mem _ c (ih Q hQ)
  have hcoord_in_W : ∀ i : Fin m, hcoordC i ∈ Submodule.span ℝ (Set.range amon) := by
    intro i
    have hki : amon (fun j => if j = i then 1 else 0) = hcoordC i := by
      ext x
      rw [hamon_apply, Finset.prod_eq_single i]
      · simp [hcoordC]
      · intro j _ hji
        simp [hji]
      · intro h
        exact absurd (Finset.mem_univ i) h
    rw [← hki]
    exact Submodule.subset_span (Set.mem_range_self _)
  let rho : C(EuclideanSpace ℝ (Fin m), ℝ) → C(↥K, ℝ) :=
    fun P => ⟨fun y => (P : EuclideanSpace ℝ (Fin m) → ℝ) y, P.continuous.comp continuous_subtype_val⟩
  have hrho : ∀ (P : C(EuclideanSpace ℝ (Fin m), ℝ)) (y : ↥K),
      (rho P : ↥K → ℝ) y = (P : EuclideanSpace ℝ (Fin m) → ℝ) y := fun P y => rfl
  let B : Subalgebra ℝ C(↥K, ℝ) :=
    { carrier := {a : C(↥K, ℝ) | ∃ P ∈ Submodule.span ℝ (Set.range amon), a = rho P}
      add_mem' := by
        rintro a b ⟨P, hP, rfl⟩ ⟨Q, hQ, rfl⟩
        exact ⟨P + Q, Submodule.add_mem _ hP hQ, by ext y; rfl⟩
      zero_mem' := ⟨0, Submodule.zero_mem _, by ext y; rfl⟩
      one_mem' := ⟨1, hone_mem, by ext y; rfl⟩
      mul_mem' := by
        rintro a b ⟨P, hP, rfl⟩ ⟨Q, hQ, rfl⟩
        exact ⟨P * Q, hW_mul P hP Q hQ, by ext y; rfl⟩
      algebraMap_mem' := by
        intro r
        refine ⟨algebraMap ℝ C(EuclideanSpace ℝ (Fin m), ℝ) r, ?_, by ext y; rfl⟩
        have h : algebraMap ℝ C(EuclideanSpace ℝ (Fin m), ℝ) r
            = r • (1 : C(EuclideanSpace ℝ (Fin m), ℝ)) := by
          ext x
          simp
        rw [h]
        exact Submodule.smul_mem _ r hone_mem }
  have hB_sep : B.SeparatesPoints := by
    intro a b hab
    have hne : (a : EuclideanSpace ℝ (Fin m)) ≠ (b : EuclideanSpace ℝ (Fin m)) :=
      fun h => hab (Subtype.ext h)
    obtain ⟨i, hi⟩ : ∃ i : Fin m,
        (a : EuclideanSpace ℝ (Fin m)).ofLp i ≠ (b : EuclideanSpace ℝ (Fin m)).ofLp i := by
      by_contra h
      push_neg at h
      exact hne (WithLp.ofLp_injective 2 (funext h))
    exact ⟨(rho (hcoordC i) : ↥K → ℝ), ⟨rho (hcoordC i), ⟨hcoordC i, hcoord_in_W i, rfl⟩, rfl⟩,
      by simpa [hrho, hcoordC] using hi⟩
  have hSW : B.topologicalClosure = ⊤ :=
    ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints B hB_sep
  have hdens : ∀ (g : C(↥K, ℝ)) (ε : ℝ), 0 < ε → ∃ P : C(EuclideanSpace ℝ (Fin m), ℝ),
      P ∈ Submodule.span ℝ (Set.range amon) ∧ ∀ y : ↥K, ‖(rho P : ↥K → ℝ) y - g y‖ < ε := by
    intro g ε hε
    have hmemB : g ∈ B.topologicalClosure := by
      rw [hSW]
      simp
    have hcl : g ∈ closure (B : Set C(↥K, ℝ)) := hmemB
    obtain ⟨b, hb, hdist⟩ := Metric.mem_closure_iff.mp hcl ε hε
    obtain ⟨P, hP, rfl⟩ := hb
    refine ⟨P, hP, fun y => ?_⟩
    have h2 : ‖(rho P : ↥K → ℝ) y - g y‖ ≤ ‖rho P - g‖ := by
      have h3 := ContinuousMap.norm_coe_le_norm (rho P - g) y
      simpa using h3
    calc ‖(rho P : ↥K → ℝ) y - g y‖ ≤ ‖rho P - g‖ := h2
      _ = dist (rho P) g := by rw [dist_eq_norm]
      _ = dist g (rho P) := dist_comm _ _
      _ < ε := hdist
  have hbnd : ∀ (mu' : Measure (EuclideanSpace ℝ (Fin m))), IsFiniteMeasure mu' → mu' Kᶜ = 0 →
      mu' K = 1 → ∀ (G : C(EuclideanSpace ℝ (Fin m), ℝ)) (ε : ℝ),
      (∀ x ∈ K, ‖(G : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ≤ ε) →
      ‖∫ x in K, (G : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu'‖ ≤ ε := by
    intro mu' hfin hKc hK1 G ε hG
    have hfinK : IsFiniteMeasure (mu'.restrict K) :=
      isFiniteMeasure_restrict.mpr (by rw [hK1]; exact ENNReal.one_ne_top)
    haveI : IsFiniteMeasure (mu'.restrict K) := hfinK
    have hKcK : (mu'.restrict K) Kᶜ = 0 := by
      rw [Measure.restrict_apply' hK_meas]
      simp
    obtain ⟨C, hC⟩ := hPK G
    have hGint : Integrable (fun x => (G : EuclideanSpace ℝ (Fin m) → ℝ) x) (mu'.restrict K) :=
      hint (mu'.restrict K) hfinK hKcK G C hC
    have hNormInt : Integrable (fun x => ‖(G : EuclideanSpace ℝ (Fin m) → ℝ) x‖)
        (mu'.restrict K) := hGint.norm
    have hConstInt : Integrable (fun _ => ε) (mu'.restrict K) := integrable_const ε
    have hreal : (mu'.restrict K).real Set.univ = 1 := by
      have h1 : (mu'.restrict K) Set.univ = 1 := by
        rw [Measure.restrict_apply MeasurableSet.univ]
        simpa using hK1
      simp only [Measure.real, h1, ENNReal.toReal_one]
    refine le_trans (norm_integral_le_integral_norm (fun x => (G : EuclideanSpace ℝ (Fin m) → ℝ) x)) ?_
    have hnn : 0 ≤ ∫ x in K, (ε - ‖(G : EuclideanSpace ℝ (Fin m) → ℝ) x‖) ∂mu' := by
      refine integral_nonneg_of_ae ?_
      filter_upwards [ae_restrict_mem hK_meas] with x hx
      exact sub_nonneg.mpr (hG x hx)
    rw [integral_sub hConstInt hNormInt, integral_const, hreal] at hnn
    have h2 : 0 ≤ ε - ∫ x in K, ‖(G : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ∂mu' := by simpa using hnn
    linarith
  have hseteq : ∀ f : C(EuclideanSpace ℝ (Fin m), ℝ),
      ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        = ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := by
    intro f
    have hmain : ∀ ε : ℝ, 0 < ε →
        |∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
          - ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu| ≤ 2 * ε := by
      intro ε hε
      obtain ⟨P, hPmem, hPclose⟩ := hdens (rho f) ε hε
      have hGclose : ∀ x ∈ K, ‖(f - P : C(EuclideanSpace ℝ (Fin m), ℝ)) x‖ ≤ ε := by
        intro x hx
        have h := hPclose ⟨x, hx⟩
        have h2 : ‖(P : EuclideanSpace ℝ (Fin m) → ℝ) x
            - (f : EuclideanSpace ℝ (Fin m) → ℝ) x‖ ≤ ε := by
          refine le_of_lt ?_
          simpa [hrho] using h
        simpa [norm_sub_rev] using h2
      have hGclose' : ∀ x ∈ K, ‖(P - f : C(EuclideanSpace ℝ (Fin m), ℝ)) x‖ ≤ ε := by
        intro x hx
        have h := hGclose x hx
        simpa [norm_sub_rev] using h
      set A := ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu with hA
      set B := ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu with hB
      have hdiffν : |A - ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu| ≤ ε := by
        rw [hA, ← integral_sub (hIntK f).1 (hIntK P).1]
        simpa [Real.norm_eq_abs] using hbnd nu hfinnu hnu_Kc hnu_K' (f - P) ε hGclose
      have hdiffμ : |∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu - B| ≤ ε := by
        rw [hB, ← integral_sub (hIntK P).2 (hIntK f).2]
        simpa [Real.norm_eq_abs] using hbnd mu hfinmu hmu_Kc hmu_K' (P - f) ε hGclose'
      have hzero : (∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu)
          = ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu := hW_int P hPmem
      have hAB : A - B
          = (A - ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu)
            + (∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu - B) := by
        rw [hA, hB, ← hzero]
        ring
      calc |A - B|
          = |(A - ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu)
            + (∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu - B)| := by rw [hAB]
        _ ≤ |A - ∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu|
            + |∫ x in K, (P : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu - B| := abs_add_le _ _
        _ ≤ ε + ε := add_le_add hdiffν hdiffμ
        _ = 2 * ε := by ring
    have hle : |∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        - ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu| ≤ 0 := by
      refine le_of_forall_pos_le_add ?_
      intro ε hε
      have h := hmain (ε / 2) (by linarith)
      linarith
    have hzero : ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
        - ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu = 0 := by
      have h1 : 0 ≤ |∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
          - ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu| := abs_nonneg _
      have h2 : |∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂nu
          - ∫ x in K, (f : EuclideanSpace ℝ (Fin m) → ℝ) x ∂mu| = 0 := le_antisymm hle h1
