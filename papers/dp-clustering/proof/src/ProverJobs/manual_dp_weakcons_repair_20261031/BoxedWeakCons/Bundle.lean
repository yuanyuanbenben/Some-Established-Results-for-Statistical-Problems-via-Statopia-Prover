/-- The ascending factorial `x^{(n)} = x (x+1) ⋯ (x+n-1)` (as used for Dirichlet process
moment formulas; note: ascending, not falling). -/
def risingFactorial (x : ℝ) (n : ℕ) : ℝ := (Finset.range n).prod fun j => (x + (j : ℝ))

/-- `A : Fin m → Set ℝ` is a finite measurable partition of `ℝ`. -/
def IsFinitePartition (m : ℕ) (A : Fin m → Set ℝ) : Prop :=
  (∀ i, MeasurableSet (A i)) ∧
    (∀ i j, i ≠ j → Disjoint (A i) (A j)) ∧
      (⋃ i, A i) = Set.univ

/-- `Λ` is the law of a Dirichlet process with concentration parameter `α > 0` and base
measure `Q0`: for every finite family of pairwise disjoint measurable sets `A₁,…,A_m` and
nonnegative integers `k₁,…,k_m` with `∑ k_i = n`,
`E[∏_i P̃(A_i)^{k_i}] = ∏_i (α Q0(A_i))^{(k_i)} / α^{(n)}`
with `x^{(n)}` the ascending factorial.  This is the `∫⁻` moment identity over
pairwise-disjoint families used by the consuming Dirichlet-process prior bundle; the
covering-partition form follows from it by inclusion–exclusion. -/
def IsDirichletProcessLaw (Λ : Measure (ProbabilityMeasure ℝ)) (α : ℝ)
    (Q0 : Measure ℝ) : Prop :=
  ∀ (m n : ℕ) (A : Fin m → Set ℝ) (k : Fin m → ℕ),
    1 ≤ m → (∀ i, MeasurableSet (A i)) → (∀ i j, i ≠ j → Disjoint (A i) (A j)) →
      (∑ i, k i) = n →
        ∫⁻ P, ENNReal.ofReal (∏ i, ((P : Measure ℝ) (A i)).toReal ^ (k i)) ∂Λ =
          ENNReal.ofReal
            ((∏ i, risingFactorial (α * (Q0 (A i)).toReal) (k i)) / risingFactorial α n)

/-- The Dirichlet process mixture prior: `Λfun α` is the law of `P̃ | α ~ DP(α, Q0)` for
every `α > 0`, `α ~ π`, and `prior` is the law of the random density
`h(x) = ∫ k(x|θ) P̃(dθ)` under the joint law of `(α, P̃)`, i.e.
`prior = π.bind (fun α => (Λfun α).map (fun P̃ x => ∫ θ, k x θ ∂P̃))`. -/
def DPMPriorLaw (prior : Measure (ℝ → ℝ)) (π : Measure ℝ)
    (Λfun : ℝ → Measure (ProbabilityMeasure ℝ)) (Q0 : Measure ℝ)
    (k : ℝ → ℝ → ℝ) : Prop :=
  (∀ α : ℝ, 0 < α → IsDirichletProcessLaw (Λfun α) α Q0) ∧
    prior =
      π.bind (fun α =>
        (Λfun α).map
          (fun P : ProbabilityMeasure ℝ => fun x : ℝ => ∫ θ, k x θ ∂(P : Measure ℝ)))


