variable {X Θ : Type*} [MeasurableSpace X] [MeasurableSpace Θ]

/-- `k(·|θ)` as a probability measure on `X`. -/
noncomputable def kernel (M : DPMModel X Θ) (θ : Θ) : Measure X :=
  kernelMeasure M.μ M.kdens θ

end DPMModel

variable {X Θ : Type*} [MeasurableSpace X] [MeasurableSpace Θ]

/-- `K_n`: the number of distinct latent parameters among `θ_1,…,θ_n`
(equivalently the number of clusters in a sample of size `n`). -/
noncomputable def clusterCard {n : ℕ} (θ : Fin n → Θ) : ℕ := (Set.range θ).ncard

/-- `Π̲_n = pr(K_n < t | X_{1:n})`: the posterior probability under the Dirichlet
process mixture model that fewer than `t` distinct latent parameters occur in a
sample of size `n`. -/
noncomputable def underPi (M : DPMModel X Θ) (t n : ℕ) (xs : Fin n → X) : ℝ≥0∞ :=
  (M.posterior n xs) {θ : Fin n → Θ | clusterCard θ < t}

/-- Density `x ↦ ∑_j q_j k(x|θ_j)` of a finite mixture. -/
noncomputable def mixDens (M : DPMModel X Θ) {s : ℕ} (q : Fin s → ℝ) (θ : Fin s → Θ) :
    X → ℝ :=
  fun x => ∑ j : Fin s, q j * M.kdens (θ j) x

/-- The probability measure `∑_j q_j k(·|θ_j)` with density `mixDens M q θ`. -/
noncomputable def mixtureMeasure (M : DPMModel X Θ) {s : ℕ} (q : Fin s → ℝ)
    (θ : Fin s → Θ) : Measure X :=
  ∑ j : Fin s, ENNReal.ofReal (q j) • M.kernel (θ j)

/-- `𝔾_s`, the set of densities of mixtures of *exactly* `s` elements of the kernel
family `Ψ = {k(·|θ) : θ ∈ Θ}`: `f = ∑_{j=1}^s q_j k(·|θ_j)` with `q_j > 0` for every
`j`, `∑_j q_j = 1`, and `θ_i ≠ θ_h` for every `i ≠ h`. Exact component count, not
"at most `s`". -/
def Gset (M : DPMModel X Θ) (s : ℕ) : Set (X → ℝ) :=
  {f : X → ℝ | ∃ (q : Fin s → ℝ) (θ : Fin s → Θ),
    (∀ j, 0 < q j) ∧ (∑ j, q j = 1) ∧
      (∀ i j : Fin s, i ≠ j → θ i ≠ θ j) ∧ f = mixDens M q θ}

/-- The Kullback–Leibler neighbourhood `KL_ε(P)` of the `s`-component mixture
`P = ∑_j q_j k(·|θ_j)` (with density `mixDens M q θ` w.r.t. `μ`): the set of
probability densities `h` w.r.t. `μ` whose genuine Kullback–Leibler divergence
`∫ log((∑_j q_j k(x|θ_j)) / h(x)) P(dx)` from `P` is less than `ε`.

The divergence used is the (extended-valued) `InformationTheory.klDiv` of the
measures with densities `mixDens M q θ` and `h`, so this is the source's KL
neighbourhood and *not* a weak neighbourhood; the direction of the ratio is the
source's (`P` in the numerator, the prior random density `h` in the denominator).
A candidate `h` must be a genuine probability density: nonnegative, of integral
one, and positive `P`-almost everywhere. -/
noncomputable def KLneighborhood (M : DPMModel X Θ) {s : ℕ} (q : Fin s → ℝ)
    (θ : Fin s → Θ) (ε : ℝ) : Set (X → ℝ) :=
  {h : X → ℝ |
    (∀ x : X, 0 ≤ h x) ∧
      (∫⁻ x, ENNReal.ofReal (h x) ∂M.μ = 1) ∧
      (∀ᵐ x ∂(M.μ.withDensity (fun x => ENNReal.ofReal (mixDens M q θ x))), 0 < h x) ∧
      InformationTheory.klDiv
          (M.μ.withDensity (fun x => ENNReal.ofReal (mixDens M q θ x)))
          (M.μ.withDensity (fun x => ENNReal.ofReal (h x))) < ENNReal.ofReal ε}



variable [MetricSpace X] [BorelSpace X] [MeasureSpace X] [CompleteSpace X]
  [SecondCountableTopology X] [ProperSpace X] [TopologicalSpace.SeparableSpace X]
  [MetricSpace Θ] [BorelSpace Θ] [StandardBorelSpace Θ] [ProperSpace Θ]

/-- Weak convergence of a sequence of measures to a limit measure, in the
test-function (portmanteau) form: the integrals against every bounded continuous
real-valued test function converge. This is used to express the singular-boundary
part of `H2`, namely `k(·|θ_i) → δ_{x*}` weakly. -/
def WeakTendsto (μseq : ℕ → Measure X) (μlim : Measure X) : Prop :=
  ∀ φ : X → ℝ, Continuous φ → (∃ B : ℝ, ∀ x : X, |φ x| ≤ B) →
    Tendsto (fun i => ∫ x, φ x ∂(μseq i)) atTop (𝓝 (∫ x, φ x ∂μlim))


/-- The boundary set `𝔹` of singular kernels:
`{θ̄ ∈ closure Θ \ Θ : lim_{θ → θ̄} sup_x k(x|θ) = ∞}`. -/
def singularBoundary (M : DPMModel X Θ) : Set Θ :=
  {θbar | θbar ∈ closure M.Θset ∧ θbar ∉ M.Θset ∧
    Tendsto (fun θ => ⨆ x : X, ENNReal.ofReal (M.kdens θ x)) (𝓝[≠] θbar) atTop}

/-- The source's branch `B1`–`B3`, in the rescaled working form `T1`–`T4`, carried in
full as the bundle `(B1)`–`(B6)`: a location kernel `k(x|θ) = g(x - θ)` with `x, θ` on
the real line and a baseline `Q₀(dθ) = q₀(θ) dθ` on the rescaled support interval
`[-c,c]`.

* (B1) `hμ`, `hloc`: `μ` is the transport of Lebesgue measure through `eX` and
  `k(x|θ) = g(x - θ)`;
* (B2) `hg_meas`, `hg_nonneg`, `hg_int`, `hB1_zero`: `g` is a measurable nonnegative
  probability density, supported in `[-c,c]` (vanishing off it);
* (B3) `T1`, `T2_diff`, `T2_bound`: `0 < m ≤ g ≤ M` on `[-c,c]`, `g` differentiable on
  `(-c,c)` with `|g'(x)/g(x)| ≤ R` there;
* (B4) `hQ0`, `hq0_meas`, `hq0_bdd`, `T3`, `T4`: the density-side data of `Q₀`, i.e.
  `q₀(y) + q₀(-y) ≤ U` for `y ∈ [0,2c]` and a common `L > 0` with `q₀ ≥ L` on a
  neighbourhood of each `θ_j^*`;
* (B5) `hLambda`, `hdpLaw`, `hLam_aemeas`, `hDPMPrior`, `hpriorH`: the Dirichlet-process
  prior law, stated with the source's real-integral mixture density
  `y ↦ ∫ θ, g(y - θ) ∂P̃(θ)`;
* (B6) `hTheta_cont`, `hTheta_cocompact`, `hX_cont`: the identifications `eTheta`, `eX`
  are topologically faithful (not merely measurable), so cocompact escape in `Θ` is
  escape to infinity in the `g`-coordinate and compact images remain compact.

The remaining fields tie the abstract model `M` (its Dirichlet process law `dpLaw`,
concentration prior `piAlpha` and prior law `priorH` of `h`) to the location-model
Dirichlet process mixture prior transported through the rescalings `eX`, `eTheta`:
`Lambdafun α` is the location-model law `DP(α, q₀(y)dy)`, `M.dpLaw α` is its pushforward
through `P' ↦ P' ∘ eTheta⁻¹`, `M.piAlpha = pi` is the prior of `α`, and `M.priorH` is
the pushforward of the location-model prior of `h` through `f ↦ f ∘ eX`. -/
structure BranchB (M : DPMModel X Θ) (t : ℕ) (θs : Fin t → Θ) where
  eX : X ≃ᵐ ℝ
  eTheta : Θ ≃ᵐ ℝ
  c : ℝ
  hc : 0 < c
  g : ℝ → ℝ
  q0 : ℝ → ℝ
  /-- (B1) the dominating measure is the transport of Lebesgue measure. -/
  hμ : M.μ = Measure.map (eX.symm : ℝ → X) volume
  /-- (B1) the kernel is the location kernel `k(x|θ) = g(x - θ)`. -/
  hloc : ∀ (θ : Θ) (x : X), M.kdens θ x = g (eX x - eTheta θ)
  /-- (B2) `g` is measurable. -/
  hg_meas : Measurable g
  /-- (B2) `g` is nonnegative everywhere. -/
  hg_nonneg : ∀ x : ℝ, 0 ≤ g x
  /-- (B2) `g` is a probability density: total mass one. -/
  hg_int : ∫⁻ x, ENNReal.ofReal (g x) ∂volume = 1
  /-- (B2) `g` is supported in the rescaled interval `[-c,c]`. -/
  hB1_zero : ∀ x : ℝ, x ∉ Set.Icc (-c) c → g x = 0
  /-- (B3) the baseline is `Q₀(dθ) = q₀(θ)dθ` after the rescaling. -/
  hQ0 : M.Q0 = Measure.map (eTheta.symm : ℝ → Θ)
    (volume.withDensity (fun y => ENNReal.ofReal (q0 y)))
  /-- (T1) `0 < m ≤ g ≤ M` on `[-c,c]`. -/
  T1 : ∃ m M0 : ℝ, 0 < m ∧ ∀ x ∈ Set.Icc (-c) c, m ≤ g x ∧ g x ≤ M0
  /-- (T2) differentiability of `g` on `(-c,c)`. -/
  T2_diff : DifferentiableOn ℝ g (Set.Ioo (-c) c)
  /-- (T2) bound on the logarithmic derivative of `g` on `(-c,c)`. -/
  T2_bound : ∃ R : ℝ, ∀ x ∈ Set.Ioo (-c) c, |deriv g x / g x| ≤ R
  /-- (T3) `q₀(y) + q₀(-y) ≤ U` on `[0,2c]`. -/
  T3 : ∃ U : ℝ, 0 < U ∧ ∀ y ∈ Set.Icc 0 (2 * c), q0 y + q0 (-y) ≤ U
  /-- (T4) `q₀ ≥ L > 0` near each true parameter `θ_j^*`. -/
  T4 : ∃ L : ℝ, 0 < L ∧ ∀ j : Fin t, ∃ V : Set ℝ, V ∈ 𝓝 (eTheta (θs j)) ∧ ∀ y ∈ V, L ≤ q0 y
  /-- (B4) `q₀` is a.e. measurable. -/
  hq0_meas : AEMeasurable q0 volume
  /-- (B4) `q₀` is a.e. bounded. -/
  hq0_bdd : ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ᵐ y ∂volume, ENNReal.ofReal (q0 y) ≤ C
  pi : Measure ℝ
  hpi_prob : IsProbabilityMeasure pi
  hpiAlpha : M.piAlpha = pi
  Lambdafun : ℝ → Measure (ProbabilityMeasure ℝ)
  hLambda : ∀ α : ℝ, 0 < α →
    IsDirichletProcessLaw α (Measure.map (eTheta : Θ → ℝ) M.Q0) (Lambdafun α)
  hdpLaw : ∀ α : ℝ, 0 < α → M.dpLaw α = (Lambdafun α).map
    (fun P' : ProbabilityMeasure ℝ => Measure.map (eTheta.symm : ℝ → Θ) (P' : Measure ℝ))
  /-- (B5) the Dirichlet-process family is a.e. measurable in `α` w.r.t. `π`. -/
  hLam_aemeas : AEMeasurable (fun α : ℝ => Lambdafun α) pi
  prior : Measure (ℝ → ℝ)
  hDPMPrior : DPMPriorLaw prior pi Lambdafun
    (Measure.map (eTheta : Θ → ℝ) M.Q0) (fun y θ => g (y - θ))
  hpriorH : M.priorH = prior.map (fun f : ℝ → ℝ => fun x : X => f (eX x))
  /-- (B6) the `Θ`-identification is continuous in the given metric topology. -/
  hTheta_cont : Continuous (eTheta : Θ → ℝ)
  /-- (B6) cocompact escape in `Θ` is escape to infinity in the `g`-coordinate. -/
  hTheta_cocompact : Tendsto (eTheta : Θ → ℝ) (cocompact Θ) (cocompact ℝ)
  /-- (B6) the `X`-identification is continuous, so compact images are compact. -/
  hX_cont : Continuous (eX : X → ℝ)

/-- The supplemental conditions `H1`–`H4`.

* `hμ`: the framework dichotomy of the source for the dominating measure `μ` of the
  kernel family, recorded in the form the source's proof consumes: either every
  singleton is `μ`-null — true for Lebesgue measure, and precisely the `P{x^*} = 0`
  input needed to eliminate the `H2_dirac` limit point `x^*` by a small ball — or `μ` is
  counting measure (the case in which the singular boundary is empty);
* `H1`: continuity of `θ ↦ k(x|θ)` on a neighborhood inside `Θ \ 𝔹` for
  `μ`-almost every `x`, and `𝔹` is closed;
* `H2`: divergence of `k(·|θ_i)` on compacts when `θ_i` leaves every compact set,
  and weak convergence to a Dirac mass when `θ_i → θ̄ ∈ 𝔹`;
* `H3`: a `t`-component mixture is not a.e. equal to any `s`-component mixture
  with `s < t` (exact component counts, distinct parameters);
* `H4`: KL prior support at every well-specified `s`-component mixture whose
  parameters lie in `supp Q₀`. -/
structure BranchH (M : DPMModel X Θ) (t : ℕ) (θs : Fin t → Θ) : Prop where
  hμ : (∀ x : X, M.μ {x} = 0) ∨ M.μ = Measure.count
  H1_cont : ∀ θbar ∈ M.Θset, θbar ∉ singularBoundary M →
