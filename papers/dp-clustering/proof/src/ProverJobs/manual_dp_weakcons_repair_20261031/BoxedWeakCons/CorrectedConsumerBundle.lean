/-- Raw fixed-atom producer conclusion, before transport along eX/eTheta. -/
def LocationKLAt (M : DPMModel X Θ) (t : ℕ) (θs : Fin t → Θ)
    (hB : BranchB M t θs) (p : Fin t → ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → 0 < hB.prior {h : ℝ → ℝ |
      AEMeasurable h volume ∧
        (∀ y : ℝ, 0 ≤ h y) ∧
          (∫⁻ y, ENNReal.ofReal (h y) ∂volume = 1) ∧
            (∀ᵐ y ∂(volume.withDensity (fun y : ℝ =>
                ENNReal.ofReal (∑ j : Fin t, p j * hB.g (y - hB.eTheta (θs j))))),
              0 < h y) ∧
                InformationTheory.klDiv
                  (volume.withDensity (fun y : ℝ =>
                    ENNReal.ofReal (∑ j : Fin t, p j * hB.g (y - hB.eTheta (θs j)))))
                  (volume.withDensity (fun y : ℝ => ENNReal.ofReal (h y)))
                    < ENNReal.ofReal ε}

/-- Reuse the verified KL transport at exactly the original true atoms. -/
theorem location_KL_to_model (M : DPMModel X Θ) (t : ℕ) (θs : Fin t → Θ)
    (hB : BranchB M t θs) (p : Fin t → ℝ) (hKLloc : LocationKLAt M t θs hB p) :
    ∀ ε : ℝ, 0 < ε → 0 < M.priorH (KLneighborhood M p θs ε) := by
  intro ε hε
  exact lt_of_lt_of_le (hKLloc ε hε)
    (statopia_math_node_2384949649_b8b4abd1 M t θs hB t p θs ε)

/-- The B-side bridge does not require positivity at any other Q0 support point. -/
theorem branchB_to_at (M : DPMModel X Θ)
    (hmu_finite : ∀ K : Set X, IsCompact K → M.μ K < ∞)
    (t : ℕ) (θs : Fin t → Θ) (hB : BranchB M t θs) (p : Fin t → ℝ)
    (hKLloc : LocationKLAt M t θs hB p) : BranchHAt M t θs p :=
  branchB_to_at_of_local_KL M hmu_finite t θs hB p
    (location_KL_to_model M t θs hB p hKLloc)

/-- Main's original B-or-H input is preserved as the input to this adapter. -/
theorem original_branch_to_at (M : DPMModel X Θ)
    (hmu_finite : ∀ K : Set X, IsCompact K → M.μ K < ∞)
    (t : ℕ) (θs : Fin t → Θ) (p : Fin t → ℝ) (ht : 1 ≤ t)
    (hp : ∀ j, 0 < p j) (hp1 : ∑ j, p j = 1)
    (hinj : Function.Injective θs) (hsupp : ∀ j, θs j ∈ M.Q0.support)
    (localB : ∀ hB : BranchB M t θs, LocationKLAt M t θs hB p)
    (hbranch : Nonempty (BranchB M t θs) ∨ BranchH M t θs) :
    BranchHAt M t θs p := by
  rcases hbranch with hB | H
  · obtain ⟨hB⟩ := hB
    exact branchB_to_at M hmu_finite t θs hB p (localB hB)
  · exact branchH_to_at M t θs p ht hp hp1 hinj hsupp H

/-- T4 is needed only at the actual fixed true locations, as in original BranchB. -/
theorem branchB_fixed_atom_lower_bounds (M : DPMModel X Θ) (t : ℕ)
    (θs : Fin t → Θ) (hB : BranchB M t θs) :
    ∀ j : Fin t, ∃ L eta : ℝ, 0 < L ∧ 0 < eta ∧
      ∀ᵐ theta ∂volume,
        theta ∈ Set.Ioo (hB.eTheta (θs j) - eta) (hB.eTheta (θs j) + eta) →
          ENNReal.ofReal L ≤ ENNReal.ofReal (hB.q0 theta) := by
  obtain ⟨L, hL, hV⟩ := hB.T4
  intro j
  obtain ⟨V, hVnhds, hq⟩ := hV j
  obtain ⟨eta, heta, hball⟩ := Metric.mem_nhds_iff.mp hVnhds
  refine ⟨L, eta, hL, heta, Filter.Eventually.of_forall ?_⟩
  intro theta htheta
  apply ENNReal.ofReal_le_ofReal (hq theta (hball ?_))
  rw [Metric.mem_ball, Real.dist_eq]
  exact abs_lt.mpr ⟨by linarith [htheta.1], by linarith [htheta.2]⟩

/-- Distinct true measures imply injective true parameters, already from Main inputs. -/
theorem true_parameters_injective (M : DPMModel X Θ) (t : ℕ)
    (R : Fin t → Measure X) (θs : Fin t → Θ)
    (hRne : ∀ i j : Fin t, i ≠ j → R i ≠ R j)
    (hwellspec : ∀ j, R j = M.kernel (θs j)) : Function.Injective θs := by
  intro i j hij
  by_contra hne
  apply hRne i j hne
  rw [hwellspec i, hwellspec j, hij]

/-- Correct empirical kernel uses every latent coordinate with weight 1/n. -/
def fullEmpiricalKernel (M : DPMModel X Θ) (n : ℕ) (theta : Fin n → Θ) : Measure X :=
  ∑ i : Fin n, ENNReal.ofReal ((n : ℝ)⁻¹) • M.kernel (theta i)

/-- Replacement obligation only: uniformly exponentially consistent tests against
full latent vectors with fewer than t occupied atoms. This is a proposition,
not a claimed/proved theorem. T n is the rejection region for the truth. -/
def FullLatentTestingTarget (M : DPMModel X Θ) (t : ℕ) (P0 : Measure X) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∃ T : (n : ℕ) → Set (Fin n → X),
    (∀ n, MeasurableSet (T n)) ∧
    (∀ᶠ n in atTop, (Measure.pi (fun _ : Fin n => P0)) (T n) ≤
      ENNReal.ofReal (Real.exp (-((n : ℝ) * c)))) ∧
    (∀ᶠ n in atTop, ∀ theta : Fin n → Θ, clusterCard theta < t →
      (Measure.pi (fun i : Fin n => M.kernel (theta i))) ((T n)ᶜ) ≤
        ENNReal.ofReal (Real.exp (-((n : ℝ) * c))))

