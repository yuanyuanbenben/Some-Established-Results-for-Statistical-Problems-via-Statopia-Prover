/-- The measure with density `k(·|θ)` with respect to the dominating measure `μ`. -/
noncomputable def kernelMeasure {X Θ : Type*} [MeasurableSpace X] (μ : Measure X)
    (kdens : Θ → X → ℝ) (θ : Θ) : Measure X :=
  μ.withDensity (fun x => ENNReal.ofReal (kdens θ x))

/-- The likelihood `∏_{i} k(x_i|θ_i)` of a latent parameter vector `θ` for the sample
`X_{1:n} = xs`, expressed with the densities `k(·|θ)` w.r.t. the dominating measure `μ`.
This is the likelihood of the Dirichlet process mixture model. -/
noncomputable def dpmLikelihood {X Θ : Type*} (kdens : Θ → X → ℝ) (n : ℕ)
    (xs : Fin n → X) (θ : Fin n → Θ) : ℝ≥0∞ :=
  ∏ i : Fin n, ENNReal.ofReal (kdens (θ i) (xs i))

/-- The mixture density `x ↦ ∫ k(x|θ) P̃(dθ)` attached to a mixing distribution `P̃`,
i.e. the density of the random `h` of the Dirichlet process mixture model. -/
noncomputable def mixDensOf {X Θ : Type*} [MeasurableSpace Θ] (kdens : Θ → X → ℝ)
    (P' : Measure Θ) (x : X) : ℝ :=
  ∫ θ, kdens θ x ∂P'
/-- The rising factorial `a (a+1) ⋯ (a+m-1)`, the unnormalized Dirichlet moment
`(a)_m`. -/
noncomputable def risingFac (a : ℝ) (m : ℕ) : ℝ :=
  Finset.prod (Finset.range m) (fun i => (a + (i : ℝ)))

/-- The finite-dimensional Dirichlet moment identity characterising the law
`Λ` of a random probability measure with law `DP(α,Q₀)`: for every finite family of
measurable pairwise disjoint sets `A_1,…,A_k` and every tuple of multiplicities
`m_1,…,m_k`,
`∫ ∏_i P'(A_i)^{m_i} Λ(dP') = ∏_i (α Q₀(A_i))_{m_i} / (α)_{∑_i m_i}`.
The random probability measure is reached through `toMeasure` (e.g. the coercion
`ProbabilityMeasure Θ → Measure Θ`). -/
def HasDirichletProcessMoments {Θ : Type*} [MeasurableSpace Θ] {ρ : Type*}
    [MeasurableSpace ρ] (toMeasure : ρ → Measure Θ)
    (α : ℝ) (Q0 : Measure Θ) (Λ : Measure ρ) : Prop :=
  ∀ (k : ℕ) (A : Fin k → Set Θ) (m : Fin k → ℕ),
    (∀ i, MeasurableSet (A i)) → (∀ i j : Fin k, i ≠ j → Disjoint (A i) (A j)) →
    ∫⁻ P' : ρ, ∏ i : Fin k, ((toMeasure P') (A i)) ^ (m i) ∂Λ =
      ENNReal.ofReal
        ((∏ i : Fin k, risingFac (α * (Q0 (A i)).toReal) (m i)) / risingFac α (∑ i, m i))

/-- `Λ` is the law `DP(α,Q₀)` of the Dirichlet process with concentration `α` and
baseline `Q₀`, in the finite-dimensional Dirichlet moment form for random
probability measures. -/
def IsDirichletProcessLaw {Θ : Type*} [MeasurableSpace Θ] (α : ℝ) (Q0 : Measure Θ)
    (Λ : Measure (ProbabilityMeasure Θ)) :
    Prop :=
  HasDirichletProcessMoments (fun P' : ProbabilityMeasure Θ => (P' : Measure Θ)) α Q0 Λ

/-- `Λ` is the law `DP(α,Q₀)` of the Dirichlet process, in the finite-dimensional
Dirichlet moment form for random measures that are almost surely probability
measures. -/
def IsDirichletProcessLawMeasure {Θ : Type*} [MeasurableSpace Θ] (α : ℝ) (Q0 : Measure Θ)
    (Λ : Measure (Measure Θ)) : Prop :=
  (∀ᵐ P' ∂Λ, (fun x : Set Θ => P' x) Set.univ = 1) ∧
    HasDirichletProcessMoments (fun P' : Measure Θ => P') α Q0 Λ

/-- The random density `h(x) = ∫ k(x|θ) P̃(dθ)` of the Dirichlet process mixture. -/
noncomputable def dpmDensity {X Θ : Type*} [MeasurableSpace Θ] (kdens : Θ → X → ℝ)
    (P' : Measure Θ) (x : X) : ℝ :=
  mixDensOf kdens P' x

/-- The prior law of the random mixture density `h = ∫ k(·|θ) P̃(dθ)` in the
location branch: `P̃ ~ DP(α,Q₀)` with `α ~ π`, so that `prior` is the pushforward of
`π.bind (fun α => Λfun α)` through the density map. -/
def DPMPriorLaw (prior : Measure (ℝ → ℝ)) (π : Measure ℝ)
    (Λfun : ℝ → Measure (ProbabilityMeasure ℝ)) (Q0 : Measure ℝ) (k : ℝ → ℝ → ℝ) : Prop :=
  (∀ α : ℝ, 0 < α → IsDirichletProcessLaw α Q0 (Λfun α)) ∧
    prior = π.bind (fun α : ℝ => (Λfun α).map (fun P' : ProbabilityMeasure ℝ =>
      fun y : ℝ => ∫ θ, k y θ ∂(P' : Measure ℝ)))


/-- Ingredients of the Dirichlet process mixture model of the paper,
`X_i|θ_i ~ind k(·|θ_i)`, `θ_i|P̃ ~iid P̃`, `P̃|α ~ DP(α,Q₀)`, `α ~ π`.

* `μ` is the dominating measure of the kernel family (Lebesgue or counting measure in
  the `H` framework) and `kdens θ` is the density `k(·|θ)` of the kernel w.r.t. `μ`;
  `Θset = Set.univ`, i.e. the source's normalisation at every parameter (`kdens_prob`);
* `Q0` is the Dirichlet process baseline on the latent parameter space `Θ`;
* `dpLaw α` is the law of `P̃` given `α`, namely `DP(α,Q₀)`;
* `piAlpha` is the prior `π` of the concentration parameter `α > 0`;
* `priorLatent n` is the prior law of `θ_1,…,θ_n`, namely the law of iid draws from
  `P̃` with `P̃ ~ DP(α,Q₀)` and `α ~ π` (`priorLatent_law`);
* `priorH` is the prior law of the random mixture density `h = ∫ k(·|θ) P̃(dθ)`,
  pushed forward from `DP(α,Q₀)` and `π` (`priorH_law`);
* `posterior n xs` is the posterior law of the latent parameters `θ_1,…,θ_n` given
  `X_{1:n} = xs`, i.e. the normalized product of the prior `priorLatent n` and the
  likelihood `dpmLikelihood` (`posterior_bayes`).

Mathlib provides no construction of the Dirichlet process, so the law `dpLaw α` of `P̃`
is carried as data of the model, together with the finite-dimensional Dirichlet moment
identity (`IsDirichletProcessLawMeasure`) characterising `DP(α,Q₀)`; the prior on the
latent parameters, the prior law of `h` and the posterior are then *defined* from it,
not assumed. -/
structure DPMModel (X Θ : Type*) [MeasurableSpace X] [MeasurableSpace Θ] where
  μ : Measure X
  kdens : Θ → X → ℝ
  kdens_nonneg : ∀ (θ : Θ) (x : X), 0 ≤ kdens θ x
  hk_meas : Measurable (Function.uncurry kdens)
  Θset : Set Θ
  /-- The source framework normalises the kernel family at *every* parameter: the same
  paper's verified lemma has hypothesis `∀ θ, ∫⁻ x, ENNReal.ofReal (k θ x) ∂μ = 1`, and
  the `H1`–`H4` development is carried out on the full parameter set `Set.univ`. So the
  parameter set is all of `Θ`; in particular the singular boundary set is empty and the
  closure of the parameter set is itself. -/
  Θset_univ : Θset = Set.univ
  Θset_ne : Θset.Nonempty
  /-- Source normalisation on the whole parameter space: for every `θ : Θ` the density
  `x ↦ kdens θ x` is a probability density with respect to `μ`, i.e.
  `∫⁻ x, ENNReal.ofReal (kdens θ x) ∂μ = 1`, so that every `M.kernel θ` is a
  probability measure. -/
  kdens_prob : ∀ θ : Θ, IsProbabilityMeasure (kernelMeasure μ kdens θ)
  Q0 : Measure Θ
  Q0_prob : IsProbabilityMeasure Q0
  dpLaw : ℝ → Measure (Measure Θ)
  dpLaw_prob : ∀ α : ℝ, IsProbabilityMeasure (dpLaw α)
  dpLaw_meas : Measurable dpLaw
  dpLaw_dirichlet : ∀ α : ℝ, 0 < α → IsDirichletProcessLawMeasure α Q0 (dpLaw α)
  piAlpha : Measure ℝ
  piAlpha_prob : IsProbabilityMeasure piAlpha
  piAlpha_pos : ∀ᵐ a ∂piAlpha, 0 < a
  priorLatent : ∀ n : ℕ, Measure (Fin n → Θ)
  priorLatent_prob : ∀ n : ℕ, IsProbabilityMeasure (priorLatent n)
  priorLatent_law : ∀ n : ℕ,
    priorLatent n = piAlpha.bind (fun α : ℝ =>
      (dpLaw α).bind (fun P' : Measure Θ => Measure.pi (fun _ : Fin n => P')))
  priorH : Measure (X → ℝ)
  priorH_prob : IsProbabilityMeasure priorH
  priorH_law : priorH = piAlpha.bind (fun α : ℝ =>
    (dpLaw α).map (fun P' : Measure Θ => dpmDensity kdens P'))
  posterior : ∀ n : ℕ, Kernel (Fin n → X) (Fin n → Θ)
  posterior_markov : ∀ n : ℕ, IsMarkovKernel (posterior n)
  posterior_bayes : ∀ (n : ℕ) (xs : Fin n → X) (A : Set (Fin n → Θ)), MeasurableSet A →
    (posterior n) xs A =
      (∫⁻ θ in A, dpmLikelihood kdens n xs θ ∂(priorLatent n)) /
        (∫⁻ θ, dpmLikelihood kdens n xs θ ∂(priorLatent n))

