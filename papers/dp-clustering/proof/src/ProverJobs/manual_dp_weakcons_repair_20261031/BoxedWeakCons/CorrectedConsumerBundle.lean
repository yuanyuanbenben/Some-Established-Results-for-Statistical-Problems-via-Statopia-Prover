    θbar ∈ singularBoundary M → Tendsto θ atTop (𝓝 θbar) →
      ∃ xstar : X,
        WeakTendsto (fun i => M.kernel (θ i)) (Measure.dirac xstar)
  H3 : ∀ (q : Fin t → ℝ) (θ : Fin t → Θ), (∀ j, 0 < q j) → (∑ j, q j = 1) →
