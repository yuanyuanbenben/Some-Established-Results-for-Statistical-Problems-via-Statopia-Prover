      (∀ j, 0 < q' j) → (∑ j, q' j = 1) →
      (∀ i j : Fin s, i ≠ j → θ' i ≠ θ' j) →
      ¬ ∀ᵐ x ∂M.μ, mixDens M q θ x = mixDens M q' θ' x
