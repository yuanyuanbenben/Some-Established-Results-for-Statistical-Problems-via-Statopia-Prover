`sup_{|f| ≤ 1} |E_μ f - E_ν f|` (no factor `1/2`). -/

/-- The state space `ℝ^d` of the chain, carrying the Euclidean (ℓ²) norm. -/
abbrev HMCState (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- The Hamiltonian `H(x,p) = U(x) + (1/2) ‖p‖²`, i.e. `M = I` so that `pᵀ M⁻¹ p / 2 = ‖p‖²/2`. -/
def hmcHamiltonian {d : ℕ} (U : HMCState d → ℝ) (x p : HMCState d) : ℝ :=
  U x + (1 / 2) * ‖p‖ ^ 2

/-- A single leapfrog (Störmer--Verlet) step with step-size `ε > 0`:
`p_{t+ε/2} = p_t - (ε/2) ∇U(x_t)`, `x_{t+ε} = x_t + ε p_{t+ε/2}`,
`p_{t+ε} = p_{t+ε/2} - (ε/2) ∇U(x_{t+ε})`. -/
def leapStep {d : ℕ} (U : HMCState d → ℝ) (ε : ℝ) (xp : HMCState d × HMCState d) :
    HMCState d × HMCState d :=
  let x := xp.1
  let p := xp.2
  let pHalf := p - (ε / 2) • gradient U x
  let x' := x + ε • pHalf
  let p' := pHalf - (ε / 2) • gradient U x'
  (x', p')

/-- The approximate flow map `φ_{Lε} = (leapStep U ε)^[L]`: `L` leapfrog steps of size `ε`,
i.e. integration time `T = L ε`. -/
def leapFlow {d : ℕ} (U : HMCState d → ℝ) (ε : ℝ) (L : ℕ) (xp : HMCState d × HMCState d) :
    HMCState d × HMCState d :=
  (leapStep U ε)^[L] xp

/-- The HMC acceptance probability
`α(x₀, x_{Lε}) = 1 ∧ exp(U x₀ - U x_{Lε} + ‖p₀‖²/2 - ‖p_{Lε}‖²/2)`
(the density ratio `π(x_{Lε})/π(x₀)` written through the `U`-difference, so that the
unspecified normalisation of `π` cancels). -/
def hmcAlpha {d : ℕ} (U : HMCState d → ℝ) (L : ℕ) (ε : ℝ) (x p0 : HMCState d) : ℝ :=
  let q := leapFlow U ε L (x, p0)
  min 1 (Real.exp (U x - U q.1 + (1 / 2) * ‖p0‖ ^ 2 - (1 / 2) * ‖q.2‖ ^ 2))

/-- The initial momentum law `μ_G = N(0, I)` on `ℝ^d`. -/
def standardGaussianMomentum (d : ℕ) : Measure (HMCState d) :=
