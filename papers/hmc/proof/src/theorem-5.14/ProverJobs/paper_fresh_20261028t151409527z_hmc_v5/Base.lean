`α(x, x_{Lε})`, otherwise stay at `x`. -/
def hmcKernel {d : ℕ} (U : HMCState d → ℝ) (L : ℕ) (ε : ℝ) (x : HMCState d) :
    Measure (HMCState d) :=
  (standardGaussianMomentum d).bind fun p0 =>
    let q := leapFlow U ε L (x, p0)
    let a := min 1 (Real.exp (U x - U q.1 + (1 / 2) * ‖p0‖ ^ 2 - (1 / 2) * ‖q.2‖ ^ 2))
