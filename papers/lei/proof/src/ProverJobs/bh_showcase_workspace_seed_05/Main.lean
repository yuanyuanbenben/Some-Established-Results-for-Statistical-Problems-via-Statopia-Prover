            _ = |(100000/39893 : ℝ)| := Real.sqrt_sq_eq_abs _
            _ = (100000/39893 : ℝ) := abs_of_nonneg (by norm_num)
        have h_inv_bound : (39893/100000 : ℝ) ≤ (Real.sqrt (Real.pi * 2))⁻¹ := by
          have ha : 0 < (100000/39893 : ℝ) := by norm_num
          have hb : 0 < Real.sqrt (Real.pi * 2) := Real.sqrt_pos.mpr (by positivity : 0 < Real.pi * 2)
          have h_order : Real.sqrt (Real.pi * 2) ≤ (100000/39893 : ℝ) := by linarith
          calc
            (39893/100000 : ℝ) = ((100000/39893 : ℝ)⁻¹) := by norm_num
            _ ≤ (Real.sqrt (Real.pi * 2))⁻¹ := by
              simpa using (one_div_le_one_div ha hb).mpr h_order
        have h_exp_bound : (19999/20000 : ℝ) ≤ Real.exp (((1/100 : ℝ)^2) * (-1 / 2 : ℝ)) := by
          have h := Real.add_one_le_exp (((1/100 : ℝ)^2) * (-1 / 2 : ℝ))
          norm_num at h ⊢
          exact h
        have h_formula : standardNormalDensity ((1 : ℝ) / 100) =
            (Real.sqrt (Real.pi * 2))⁻¹ * Real.exp (((1/100 : ℝ)^2) * (-1 / 2 : ℝ)) := by
          dsimp [standardNormalDensity, ProbabilityTheory.gaussianPDFReal]
          ring_nf
        rw [h_formula]
        calc
          (3989 : ℝ) / 10000 ≤ (39893/100000 : ℝ) * (19999/20000 : ℝ) := by norm_num
          _ ≤ (Real.sqrt (Real.pi * 2))⁻¹ * Real.exp (((1/100 : ℝ)^2) * (-1 / 2 : ℝ)) := by
            exact mul_le_mul h_inv_bound h_exp_bound (by positivity) (by positivity)
      calc
        (3989 : ℝ) / 1000000 = ((3989 : ℝ)/10000) * ((1 : ℝ)/100) := by norm_num
        _ ≤ standardNormalDensity ((1 : ℝ)/100) * ((1 : ℝ)/100) := by
          exact mul_le_mul_of_nonneg_right h_density_lower (by norm_num)
        _ ≤ dobribanBin0ZMass := by
          simpa [dobribanBin0ZMass] using h_s3
  exact h_s4

