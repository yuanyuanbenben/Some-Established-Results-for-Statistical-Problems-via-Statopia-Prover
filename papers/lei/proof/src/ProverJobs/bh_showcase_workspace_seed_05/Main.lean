          have hxt : x < t' := Set.mem_Ioi.mp ht'
          have htpos : t' > 0 := by linarith
          have htgt1 : t' > 1 := by linarith
          have h_pow_ge_one : t' ^ (2*n : ℕ) ≥ 1 := by
            have h_one_le_t' : 1 ≤ t' := by linarith
            have htpos' : 0 < t' := htpos
            have h_t'2_ge_one : t' ^ 2 ≥ 1 := by
