/-! ## lei_fdr_le_of_pointwise_fdp_bound_inputs -/

open MeasureTheory

namespace Statlib.MultipleTesting.Lei

def leiFdrPointwiseUpperInputs
    {Omega : Type*} [MeasurableSpace Omega] (mu : Measure Omega) {m : Nat}
    (isNull : Fin m -> Prop) [DecidablePred isNull]
    (reject : Omega -> Fin m -> Prop) [forall omega, DecidablePred (reject omega)]
    (rhs : Real) : Prop :=
  Integrable (fun omega => Statlib.MultipleTesting.fdp isNull (reject omega)) mu /\
    0 <= rhs /\
    mu.real Set.univ <= 1 /\
    (∀ᵐ omega ∂mu,
      Statlib.MultipleTesting.fdp isNull (reject omega) <= rhs)

theorem lei_fdr_le_of_pointwise_fdp_bound_inputs
    {Omega : Type*} [MeasurableSpace Omega] (mu : Measure Omega)
    [IsFiniteMeasure mu] {m : Nat}
    (isNull : Fin m -> Prop) [DecidablePred isNull]
    (reject : Omega -> Fin m -> Prop) [forall omega, DecidablePred (reject omega)]
    (rhs : Real)
    (hinputs : leiFdrPointwiseUpperInputs mu isNull reject rhs) :
    Statlib.MultipleTesting.fdr mu isNull reject <= rhs := by
  rcases hinputs with ⟨h_int, hrhs_nonneg, hmu, hpoint⟩
  unfold Statlib.MultipleTesting.fdr
  have hconst_int : Integrable (fun _ : Omega => rhs) mu := by
    exact MeasureTheory.integrable_const rhs
  have hmono :
      (∫ omega, Statlib.MultipleTesting.fdp isNull (reject omega) ∂mu) <=
        ∫ _ : Omega, rhs ∂mu := by
    exact MeasureTheory.integral_mono_ae h_int hconst_int hpoint
  calc
    (∫ omega, Statlib.MultipleTesting.fdp isNull (reject omega) ∂mu) <=
        ∫ _ : Omega, rhs ∂mu := hmono
    _ = mu.real Set.univ * rhs := by
      simp [MeasureTheory.integral_const, smul_eq_mul]
    _ <= 1 * rhs := by
      exact mul_le_mul_of_nonneg_right hmu hrhs_nonneg
    _ = rhs := by ring

end Statlib.MultipleTesting.Lei
