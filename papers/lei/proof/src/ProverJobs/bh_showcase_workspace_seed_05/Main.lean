      p_threshold_pos := ?_,
      p_threshold_upper := ?_,
      null_tail_lower := ?_,
      z_mass_lower := ?_
    }
    · -- p_threshold_pos: 0 < dobribanBin0PThreshold = 2 * standardNormalUpperTail (3642/1000)
      -- standardNormalUpperTail is strictly positive for any finite x
      have h_tail_pos : 0 < standardNormalUpperTail ((3642 : ℝ) / 1000) := by
        let x : ℝ := (3642 : ℝ) / 1000
        let μ := volume.restrict (Set.Ioi x)
        let φ := standardNormalDensity
        have hf_nonneg_ae : 0 ≤ᶠ[ae μ] φ := by
          exact Filter.Eventually.of_forall fun y => by
            have h : 0 ≤ ProbabilityTheory.gaussianPDFReal (0 : ℝ) (1 : NNReal) y :=
              ProbabilityTheory.gaussianPDFReal_nonneg (0 : ℝ) (1 : NNReal) y
            simpa [φ, standardNormalDensity] using h
        have h_int : Integrable φ μ := by
          have h_glob : Integrable φ volume := by
            simpa [φ, standardNormalDensity] using
              (ProbabilityTheory.integrable_gaussianPDFReal (μ := (0 : ℝ)) (v := (1 : NNReal)))
          simpa [μ] using (h_glob.integrableOn (s := Set.Ioi x))
        have h_support_pos : 0 < μ (Function.support φ) := by
          have hIoc_sub_support : Set.Ioc x (x + 1) ⊆ Function.support φ := by
            intro y hy
            have hpos : 0 < φ y := by
              have hpos' : 0 < ProbabilityTheory.gaussianPDFReal (0 : ℝ) (1 : NNReal) y :=
                ProbabilityTheory.gaussianPDFReal_pos (0 : ℝ) (1 : NNReal) y (by norm_num : (1 : NNReal) ≠ 0)
              simpa [φ, standardNormalDensity] using hpos'
            exact ne_of_gt hpos
          have hmeasure_Ioc_pos : 0 < μ (Set.Ioc x (x + 1)) := by
            dsimp [μ]
            rw [MeasureTheory.Measure.restrict_apply measurableSet_Ioc]
            have h_inter : Set.Ioc x (x + 1) ∩ Set.Ioi x = Set.Ioc x (x + 1) := by
              ext y
              constructor
              · intro hy
                exact hy.1
              · intro hy
                exact ⟨hy, hy.1⟩
            rw [h_inter, Real.volume_Ioc]
            norm_num
