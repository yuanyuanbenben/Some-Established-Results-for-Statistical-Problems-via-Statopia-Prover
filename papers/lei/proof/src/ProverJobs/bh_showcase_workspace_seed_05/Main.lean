            _ ≤ (b - b^3) + 3*b^5*(1 - 5*b^2) := add_le_add h_cubic_ineq h_high
            _ = b - b^3 + 3*b^5 - 15*b^7 := by ring
            _ = (1/x - 1/x^3 + 3/x^5 - 15/x^7) := by
              rw [hb]
              simp [div_pow, one_pow]
              field_simp [hx_pos.ne']
        exact h_s3
      -- @step s_combine: combine the two rational bounds and verify ≥ 133/1000000
      have h_combine : (133 : ℝ)/1000000 ≤
          2 * ((3989/10000 : ℝ) * (((20000 : ℝ) - (829921/113750 : ℝ)) / (20000 : ℝ)) ^ (20000 : ℕ)) *
            ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
              3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := by
        norm_num
      have h_nonneg_phi : 0 ≤ standardNormalDensity x := by
        have hpos' : 0 < ProbabilityTheory.gaussianPDFReal (0 : ℝ) (1 : NNReal) x :=
          ProbabilityTheory.gaussianPDFReal_pos (0 : ℝ) (1 : NNReal) x (by norm_num : (1 : NNReal) ≠ 0)
        simpa [standardNormalDensity] using hpos'.le
      have h_nonneg_LP : 0 ≤
          ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
            3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := by
        norm_num
      calc
        (133 : ℝ) / 1000000 ≤
            2 * ((3989/10000 : ℝ) * (((20000 : ℝ) - (829921/113750 : ℝ)) / (20000 : ℝ)) ^ (20000 : ℕ)) *
              ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
                3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := h_combine
        _ = (2 * ((3989/10000 : ℝ) * (((20000 : ℝ) - (829921/113750 : ℝ)) / (20000 : ℝ)) ^ (20000 : ℕ))) *
              ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
                3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := by ring
        _ ≤ (2 * standardNormalDensity x) *
              ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
                3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := by
          have h_temp : 2 * ((3989/10000 : ℝ) * (((20000 : ℝ) - (829921/113750 : ℝ)) / (20000 : ℝ)) ^ (20000 : ℕ)) ≤ 2 * standardNormalDensity x := by
            nlinarith [h_phi_low]
          exact mul_le_mul_of_nonneg_right h_temp h_nonneg_LP
        _ = 2 * standardNormalDensity x *
              ((238475/911000 : ℝ) - (238475/911000 : ℝ)^(3 : ℕ) +
                3*(238475/911000 : ℝ)^5 * (1 - 5*(56875/829921 : ℝ))) := by ring
        _ ≤ 2 * standardNormalDensity x * (1/x - 1/x^3 + 3/x^5 - 15/x^7) := by
          exact mul_le_mul_of_nonneg_left h_P_low (by nlinarith [h_nonneg_phi])
    have hs4 : (133 : ℝ) / 1000000 ≤ 2 * standardNormalUpperTail x := by
      calc
        (133 : ℝ) / 1000000 ≤ 2 * standardNormalDensity x * (1/x - 1/x^3 + 3/x^5 - 15/x^7) := h_combined
        _ ≤ 2 * standardNormalUpperTail x := by
          nlinarith [hs1]
    exact hs4
  -- @step s3: standardNormalCDF (1/100) - standardNormalCDF 0 ≥ standardNormalDensity (1/100) * (1/100) by monotonicity of standardNormalDensity on [0, 1/100].
  have h_s3 : standardNormalCDF ((1 : ℝ) / 100) - standardNormalCDF 0 ≥ standardNormalDensity ((1 : ℝ) / 100) * ((1 : ℝ) / 100) := by
    let a : ℝ := (1 : ℝ) / 100
    let φ := standardNormalDensity
    have ha_nonneg : 0 ≤ a := by dsimp [a]; norm_num
    have h0a : (0 : ℝ) ≤ a := ha_nonneg
    have h_int_global : Integrable φ volume := by
      simpa [φ, standardNormalDensity] using
        (ProbabilityTheory.integrable_gaussianPDFReal (μ := (0 : ℝ)) (v := (1 : NNReal)))
    have h_int_Iic_a : IntegrableOn φ (Set.Iic a) volume := h_int_global.integrableOn
    have h_split := MeasureTheory.integral_inter_add_diff (f := φ) (s := Set.Iic a) (t := Set.Iic (0 : ℝ)) measurableSet_Iic h_int_Iic_a
    have h_inter : Set.Iic a ∩ Set.Iic (0 : ℝ) = Set.Iic (0 : ℝ) := by
      ext y
      constructor
      · intro hy
        exact hy.2
      · intro hy
        exact ⟨le_trans hy h0a, hy⟩
    have h_diff : Set.Iic a \ Set.Iic (0 : ℝ) = Set.Ioc (0 : ℝ) a := by
      simpa [a] using (Set.Iic_diff_Iic (a := (0 : ℝ)) (b := a))
    have h_cdf_diff : standardNormalCDF a - standardNormalCDF 0 = ∫ y in Set.Ioc (0 : ℝ) a, φ y := by
      have h_split' := h_split
      rw [h_inter, h_diff] at h_split'
      dsimp [standardNormalCDF, φ]
      linarith
    have h_set_to_interval : (∫ y in Set.Ioc (0 : ℝ) a, φ y) = ∫ y in (0 : ℝ)..a, φ y := by
      symm
      exact intervalIntegral.integral_of_le h0a
    have hφ_formula (y : ℝ) : φ y = (Real.sqrt (Real.pi * 2))⁻¹ * Real.exp (y ^ 2 * (-1 / 2)) := by
      dsimp [φ, standardNormalDensity, ProbabilityTheory.gaussianPDFReal]
      ring_nf
    have h_lower_on : ∀ y ∈ Set.Icc (0 : ℝ) a, φ a ≤ φ y := by
      intro y hy
      have hy_nonneg : 0 ≤ y := hy.1
      have hy_le_a : y ≤ a := hy.2
      have hsq : y^2 ≤ a^2 := by nlinarith
      have hexp_arg : a^2 * (-1 / 2 : ℝ) ≤ y^2 * (-1 / 2 : ℝ) := by
        exact mul_le_mul_of_nonpos_right hsq (by norm_num : (-1 / 2 : ℝ) ≤ 0)
      have hexp : Real.exp (a^2 * (-1 / 2 : ℝ)) ≤ Real.exp (y^2 * (-1 / 2 : ℝ)) := Real.exp_le_exp.mpr hexp_arg
      have hcoef_nonneg : 0 ≤ (Real.sqrt (Real.pi * 2))⁻¹ := by positivity
      rw [hφ_formula a, hφ_formula y]
      exact mul_le_mul_of_nonneg_left hexp hcoef_nonneg
    have hφ_deriv (s : ℝ) : HasDerivAt φ (-s * φ s) s := by
      have h := Statlib.StatFoundation.RandomVariable.Gaussian.hasDerivAt_standardGaussianPDFReal s
      simpa [φ, standardNormalDensity, ProbabilityTheory.gaussianPDFReal] using h
    have h_cont_φ : Continuous φ := by
      refine continuous_iff_continuousAt.mpr fun s => ?_
      exact (hφ_deriv s).continuousAt
    have h_const_int : IntervalIntegrable (fun _ : ℝ => φ a) volume (0 : ℝ) a := by
      exact intervalIntegrable_const (c := φ a)
    have h_int_mono : (∫ y in (0 : ℝ)..a, φ a) ≤ (∫ y in (0 : ℝ)..a, φ y) := by
      refine intervalIntegral.integral_mono_on h0a h_const_int (h_cont_φ.intervalIntegrable (a := (0 : ℝ)) (b := a)) ?_
      intro y hy
      exact h_lower_on y hy
    have h_const : (∫ y in (0 : ℝ)..a, φ a) = φ a * a := by
      rw [intervalIntegral.integral_const]
      simp [a, mul_comm]
    calc
      standardNormalDensity ((1 : ℝ) / 100) * ((1 : ℝ) / 100)
          = φ a * a := by simp [φ, a]
      _ = (∫ y in (0 : ℝ)..a, φ a) := h_const.symm
      _ ≤ ∫ y in (0 : ℝ)..a, φ y := h_int_mono
      _ = ∫ y in Set.Ioc (0 : ℝ) a, φ y := h_set_to_interval.symm
      _ = standardNormalCDF a - standardNormalCDF 0 := h_cdf_diff.symm
      _ = standardNormalCDF ((1 : ℝ) / 100) - standardNormalCDF 0 := by simp [a]
  -- @step s4: Numeric bounds for sqrt 91 / 10 and the exponential appearing in the Mills series are proved by rational interval squaring and Taylor certificates, respectively.
  have h_s4 : DobribanBin0TailBounds := by
    -- use h_s1, h_s2, h_s3 to construct the structure
