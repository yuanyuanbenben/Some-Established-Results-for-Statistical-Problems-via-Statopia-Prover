          have h_simp : ((-1 : ℝ) / (t^3)^2) * (3*t^2) = -3/t^4 := by
            field_simp [ht]
          simpa [h_simp] using h_chain
        have h5 : HasDerivAt (fun (u : ℝ) => 1/u^5) (-5/t^6) t := by
          have h_comp : HasDerivAt (fun (u : ℝ) => u^5) (5*t^4) t := by
            simpa using hasDerivAt_pow 5 t
          have h_inv : HasDerivAt (fun (v : ℝ) => 1/v) (-1/(t^5)^2) (t^5) := by
            have ht5 : t^5 ≠ 0 := pow_ne_zero 5 ht
            simpa [one_div, neg_div] using hasDerivAt_inv ht5
          have h_chain : HasDerivAt (fun (u : ℝ) => 1/(u^5)) ((-1/(t^5)^2) * (5*t^4)) t :=
            HasDerivAt.comp (x := t) h_inv h_comp
          have h_simp : ((-1 : ℝ) / (t^5)^2) * (5*t^4) = -5/t^6 := by
            field_simp [ht]
          simpa [h_simp] using h_chain
        have h7 : HasDerivAt (fun (u : ℝ) => 1/u^7) (-7/t^8) t := by
          have h_comp : HasDerivAt (fun (u : ℝ) => u^7) (7*t^6) t := by
            simpa using hasDerivAt_pow 7 t
          have h_inv : HasDerivAt (fun (v : ℝ) => 1/v) (-1/(t^7)^2) (t^7) := by
            have ht7 : t^7 ≠ 0 := pow_ne_zero 7 ht
            simpa [one_div, neg_div] using hasDerivAt_inv ht7
          have h_chain : HasDerivAt (fun (u : ℝ) => 1/(u^7)) ((-1/(t^7)^2) * (7*t^6)) t :=
            HasDerivAt.comp (x := t) h_inv h_comp
          have h_simp : ((-1 : ℝ) / (t^7)^2) * (7*t^6) = -7/t^8 := by
            field_simp [ht]
          simpa [h_simp] using h_chain
        have hP_eq : P = (fun (u : ℝ) => 1/u - 1/u^3 + 3/u^5 - 15/u^7) := by
          ext u; simp [P, hP_def, div_eq_mul_inv]
        rw [hP_eq]
        have h_neg3 : HasDerivAt (fun (u : ℝ) => -1/u^3) (3/t^4) t := by
          simpa [neg_div] using h3.neg
        have h_term5 : HasDerivAt (fun (u : ℝ) => 3/u^5) (-15/t^6) t := by
          have h := h5.const_mul (3 : ℝ)
          have h_simp_fun : (fun (u : ℝ) => 3 * (1 / u^5)) = (fun (u : ℝ) => 3 / u^5) := by
            ext u; simp [div_eq_mul_inv]
          have h_simp_deriv : (3 : ℝ) * (-5 / t^6) = (-15 : ℝ) / t^6 := by ring
          simpa [h_simp_fun, h_simp_deriv] using h
        have h_term7 : HasDerivAt (fun (u : ℝ) => -15/u^7) (105/t^8) t := by
          have h : HasDerivAt (fun (u : ℝ) => 15/u^7) (-105/t^8) t := by
            have h_raw := h7.const_mul (15 : ℝ)
            have h_simp_fun : (fun (u : ℝ) => 15 * (1 / u^7)) = (fun (u : ℝ) => 15 / u^7) := by
              ext u; simp [div_eq_mul_inv]
            have h_simp_deriv : (15 : ℝ) * (-7 / t^8) = (-105 : ℝ) / t^8 := by ring
            simpa [h_simp_fun, h_simp_deriv] using h_raw
          simpa [neg_div] using h.neg
        have h_total : HasDerivAt (fun (u : ℝ) => 1/u - 1/u^3 + 3/u^5 - 15/u^7) (-1/t^2 + 3/t^4 - 15/t^6 + 105/t^8) t := by
          have h1' : HasDerivAt (fun u : ℝ => u⁻¹) (-(t ^ 2)⁻¹) t := by
            simpa using hasDerivAt_inv ht
          have h_neg3' : HasDerivAt (fun u : ℝ => -(u ^ 3)⁻¹) (3 * (t ^ 4)⁻¹) t := by
            have h_inv3 : HasDerivAt (fun u : ℝ => (u ^ 3)⁻¹) (-3 * (t ^ 4)⁻¹) t := by
              have h_comp : HasDerivAt (fun u : ℝ => u ^ 3) (3 * t ^ 2) t := by
                simpa using hasDerivAt_pow 3 t
              have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 3)⁻¹ ^ 2) (t ^ 3) := by
                simpa using hasDerivAt_inv (pow_ne_zero 3 ht)
              have h_chain : HasDerivAt (fun u : ℝ => (u ^ 3)⁻¹) ((-(t ^ 3)⁻¹ ^ 2) * (3 * t ^ 2)) t :=
                HasDerivAt.comp (x := t) h_inv h_comp
              have h_eq : ((-(t ^ 3)⁻¹ ^ 2) * (3 * t ^ 2)) = (-3 * (t ^ 4)⁻¹) := by
                field_simp [ht]
              rw [h_eq] at h_chain
              exact h_chain
            simpa using h_inv3.neg
          have h_term5' : HasDerivAt (fun u : ℝ => 3 / u ^ 5) (-15 / t ^ 6) t := by
            have h_inv5 : HasDerivAt (fun u : ℝ => (u ^ 5)⁻¹) (-5 * (t ^ 6)⁻¹) t := by
              have h_comp : HasDerivAt (fun u : ℝ => u ^ 5) (5 * t ^ 4) t := by
                simpa using hasDerivAt_pow 5 t
              have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 5)⁻¹ ^ 2) (t ^ 5) := by
                simpa using hasDerivAt_inv (pow_ne_zero 5 ht)
              have h_chain' : HasDerivAt (fun u : ℝ => (u ^ 5)⁻¹) ((-(t ^ 5)⁻¹ ^ 2) * (5 * t ^ 4)) t :=
                HasDerivAt.comp (x := t) h_inv h_comp
              have h_simp : (-(t ^ 5)⁻¹ ^ 2) * (5 * t ^ 4) = -5 * (t ^ 6)⁻¹ := by
                field_simp [ht]
              rw [h_simp] at h_chain'
              exact h_chain'
            have h_deriv_simp : -(3 * (5 * (t ^ 6)⁻¹)) = -15 * (t ^ 6)⁻¹ := by ring
            simpa [div_eq_mul_inv, h_deriv_simp] using h_inv5.const_mul (3 : ℝ)
          have h_term7' : HasDerivAt (fun u : ℝ => -15 / u ^ 7) (105 / t ^ 8) t := by
            have h_inv7 : HasDerivAt (fun u : ℝ => (u ^ 7)⁻¹) (-7 * (t ^ 8)⁻¹) t := by
              have h_comp : HasDerivAt (fun u : ℝ => u ^ 7) (7 * t ^ 6) t := by
                simpa using hasDerivAt_pow 7 t
              have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 7)⁻¹ ^ 2) (t ^ 7) := by
                simpa using hasDerivAt_inv (pow_ne_zero 7 ht)
              have h_chain' : HasDerivAt (fun u : ℝ => (u ^ 7)⁻¹) ((-(t ^ 7)⁻¹ ^ 2) * (7 * t ^ 6)) t :=
                HasDerivAt.comp (x := t) h_inv h_comp
              have h_simp : (-(t ^ 7)⁻¹ ^ 2) * (7 * t ^ 6) = -7 * (t ^ 8)⁻¹ := by
                field_simp [ht]
              rw [h_simp] at h_chain'
              exact h_chain'
            have h_deriv_simp7 : (15 : ℝ) * (7 * (t ^ 8)⁻¹) = (105 : ℝ) * (t ^ 8)⁻¹ := by ring
            simpa [div_eq_mul_inv, h_deriv_simp7] using h_inv7.const_mul (-15 : ℝ)
          have h_add_raw : HasDerivAt (fun u : ℝ => u⁻¹ + (-(u ^ 3)⁻¹) + (3 / u ^ 5) + (-15 / u ^ 7))
              ((-(t ^ 2)⁻¹) + (3 * (t ^ 4)⁻¹) + (-15 / t ^ 6) + (105 / t ^ 8)) t :=
            ((h1'.add h_neg3').add h_term5').add h_term7'
          have h_funeq : (fun u : ℝ => u⁻¹ + (-(u ^ 3)⁻¹) + (3 / u ^ 5) + (-15 / u ^ 7)) =
            (fun u : ℝ => u⁻¹ - (u ^ 3)⁻¹ + 3 / u ^ 5 - 15 / u ^ 7) := by
            ext u; simp [sub_eq_add_neg, neg_div]
          have h_add : HasDerivAt (fun u : ℝ => u⁻¹ - (u ^ 3)⁻¹ + 3 / u ^ 5 - 15 / u ^ 7)
              ((-(t ^ 2)⁻¹) + (3 * (t ^ 4)⁻¹) + (-15 / t ^ 6) + (105 / t ^ 8)) t := by
            simpa [h_funeq] using h_add_raw
          have h_simp_fun : (fun u : ℝ => u⁻¹ - (u ^ 3)⁻¹ + 3 / u ^ 5 - 15 / u ^ 7) =
            (fun u : ℝ => 1/u - 1/u^3 + 3/u^5 - 15/u^7) := by
            ext u; simp [div_eq_mul_inv]
          have h_simp_deriv : (-(t ^ 2)⁻¹) + (3 * (t ^ 4)⁻¹) + (-15 / t ^ 6) + (105 / t ^ 8) =
            -1/t^2 + 3/t^4 - 15/t^6 + 105/t^8 := by
            field_simp [ht]; ring
          simpa [h_simp_fun, h_simp_deriv] using h_add
        simpa using h_total
      -- We prove the inequality using integration by parts on intervals [x, R] then taking R→∞.
      have hφ_integrable_on_Ioi : IntegrableOn φ (Set.Ioi x) := by
        have h_int_gauss : Integrable (ProbabilityTheory.gaussianPDFReal (0 : ℝ) (1 : NNReal)) :=
          ProbabilityTheory.integrable_gaussianPDFReal (μ := (0 : ℝ)) (v := (1 : NNReal))
        have h_int : Integrable φ := by
          simpa [φ, standardNormalDensity] using h_int_gauss
        exact h_int.integrableOn
      have hφ_tendsto_zero : Filter.Tendsto φ atTop (nhds 0) := by
        have h_sq_tendsto : Filter.Tendsto (fun (t : ℝ) => t ^ 2) atTop atTop :=
          tendsto_pow_atTop (by norm_num : (2 : ℕ) ≠ 0)
        have h_sq_div_tendsto : Filter.Tendsto (fun (t : ℝ) => t ^ 2 / 2) atTop atTop := by
          have h_pos : (0 : ℝ) < 1/2 := by norm_num
          simpa [div_eq_mul_inv] using h_sq_tendsto.atTop_mul_const h_pos
        have h_exp_tendsto : Filter.Tendsto (fun (t : ℝ) => Real.exp (-(t ^ 2 / 2))) atTop (nhds 0) :=
          Real.tendsto_exp_neg_atTop_nhds_zero.comp h_sq_div_tendsto
        have h_scale : φ = fun t : ℝ => Real.exp (-(t ^ 2 / 2)) / Real.sqrt (2 * Real.pi) := by
          ext t
          calc
            φ t = (Real.sqrt (2 * Real.pi * (1 : ℝ)))⁻¹ * Real.exp (-(t - 0) ^ 2 / (2 * (1 : ℝ))) := by
              unfold φ standardNormalDensity ProbabilityTheory.gaussianPDFReal
              norm_num
            _ = (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(t ^ 2) / 2) := by
              simp [sub_zero]
            _ = Real.exp (-(t ^ 2 / 2)) / Real.sqrt (2 * Real.pi) := by ring
        rw [h_scale]
        simpa using h_exp_tendsto.div_const (Real.sqrt (2 * Real.pi))
      -- φ*P → 0 (simpler: P → 0 via tendsto_inv_atTop_zero, then φ*P → 0 by product rule)
      have hP_tendsto_zero : Filter.Tendsto (fun (R : ℝ) => P R) atTop (nhds 0) := by
        have h_inv_tendsto : Filter.Tendsto (fun (R : ℝ) => 1 / R) atTop (nhds 0) := by
          simpa using tendsto_inv_atTop_zero
        have h_pow3_tendsto : Filter.Tendsto (fun (R : ℝ) => R ^ 3) atTop atTop :=
          tendsto_pow_atTop (by norm_num : (3 : ℕ) ≠ 0)
        have h_inv3_tendsto : Filter.Tendsto (fun (R : ℝ) => 1 / R ^ 3) atTop (nhds 0) :=
          h_inv_tendsto.comp h_pow3_tendsto
        have h_pow5_tendsto : Filter.Tendsto (fun (R : ℝ) => R ^ 5) atTop atTop :=
          tendsto_pow_atTop (by norm_num : (5 : ℕ) ≠ 0)
        have h_inv5_tendsto : Filter.Tendsto (fun (R : ℝ) => 3 / R ^ 5) atTop (nhds 0) := by
          have h_base : Filter.Tendsto (fun (R : ℝ) => 1 / R ^ 5) atTop (nhds 0) :=
            h_inv_tendsto.comp h_pow5_tendsto
          simpa [div_eq_mul_inv, mul_comm] using Filter.Tendsto.const_mul (3 : ℝ) h_base
        have h_pow7_tendsto : Filter.Tendsto (fun (R : ℝ) => R ^ 7) atTop atTop :=
          tendsto_pow_atTop (by norm_num : (7 : ℕ) ≠ 0)
        have h_inv7_tendsto : Filter.Tendsto (fun (R : ℝ) => 15 / R ^ 7) atTop (nhds 0) := by
          have h_base : Filter.Tendsto (fun (R : ℝ) => 1 / R ^ 7) atTop (nhds 0) :=
            h_inv_tendsto.comp h_pow7_tendsto
          simpa [div_eq_mul_inv, mul_comm] using Filter.Tendsto.const_mul (15 : ℝ) h_base
        have h_raw : Filter.Tendsto (fun (R : ℝ) => 1 / R - 1 / R ^ 3 + 3 / R ^ 5 - 15 / R ^ 7) atTop (nhds 0) := by
          simpa using ((h_inv_tendsto.sub h_inv3_tendsto).add h_inv5_tendsto).sub h_inv7_tendsto
        simpa [P, hP_def] using h_raw
      have h_φP_tendsto_zero : Filter.Tendsto (fun (R : ℝ) => φ R * P R) atTop (nhds 0) := by
        simpa [mul_zero] using hφ_tendsto_zero.mul hP_tendsto_zero
      -- Derivatives of φ(s)/s^k for k = 1, 3, 5, 7
      have h_deriv_φ_div_s (t : ℝ) (ht : t ≠ 0) : HasDerivAt (fun s : ℝ => φ s / s) (-φ t - φ t / t ^ 2) t := by
        have h_inv' : HasDerivAt (Inv.inv : ℝ → ℝ) (-(t ^ 2)⁻¹) t := by
          simpa using hasDerivAt_inv ht
        have h_raw : HasDerivAt (fun s : ℝ => φ s * s⁻¹) ((-t * φ t) * t⁻¹ + φ t * (-(t ^ 2)⁻¹)) t :=
          HasDerivAt.mul (hφ_deriv t) h_inv'
        have h_deriv_simp1 : ((-t * φ t) * t⁻¹ + φ t * (-(t ^ 2)⁻¹)) = (-φ t - φ t / t ^ 2) := by
          field_simp [ht]; ring
        rw [h_deriv_simp1] at h_raw
        simpa [div_eq_mul_inv] using h_raw
      have h_deriv_φ_div_s3 (t : ℝ) (ht : t ≠ 0) : HasDerivAt (fun s : ℝ => φ s / s ^ 3) (-(φ t / t ^ 2) - 3 * φ t / t ^ 4) t := by
        have h_inv3 : HasDerivAt (fun s : ℝ => (s ^ 3)⁻¹) (-3 * (t ^ 4)⁻¹) t := by
          have h_comp : HasDerivAt (fun s : ℝ => s ^ 3) (3 * t ^ 2) t := by
            simpa using hasDerivAt_pow 3 t
          have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 3)⁻¹ ^ 2) (t ^ 3) := by
            simpa using hasDerivAt_inv (pow_ne_zero 3 ht)
          have h_chain : HasDerivAt (fun s : ℝ => (s ^ 3)⁻¹) ((-(t ^ 3)⁻¹ ^ 2) * (3 * t ^ 2)) t :=
            HasDerivAt.comp (x := t) h_inv h_comp
          have h_simp : (-(t ^ 3)⁻¹ ^ 2) * (3 * t ^ 2) = -3 * (t ^ 4)⁻¹ := by
            field_simp [ht]
          rw [h_simp] at h_chain
          exact h_chain
        have h_raw : HasDerivAt (fun s : ℝ => φ s * (s ^ 3)⁻¹) ((-t * φ t) * (t ^ 3)⁻¹ + φ t * (-3 * (t ^ 4)⁻¹)) t :=
          HasDerivAt.mul (hφ_deriv t) h_inv3
        have h_deriv_simp3 : ((-t * φ t) * (t ^ 3)⁻¹ + φ t * (-3 * (t ^ 4)⁻¹)) = (-(φ t / t ^ 2) - 3 * φ t / t ^ 4) := by
          field_simp [ht]; ring
        rw [h_deriv_simp3] at h_raw
        simpa [div_eq_mul_inv] using h_raw
      have h_deriv_φ_div_s5 (t : ℝ) (ht : t ≠ 0) : HasDerivAt (fun s : ℝ => φ s / s ^ 5) (-(φ t / t ^ 4) - 5 * φ t / t ^ 6) t := by
        have h_inv5 : HasDerivAt (fun s : ℝ => (s ^ 5)⁻¹) (-5 * (t ^ 6)⁻¹) t := by
          have h_comp : HasDerivAt (fun s : ℝ => s ^ 5) (5 * t ^ 4) t := by
            simpa using hasDerivAt_pow 5 t
          have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 5)⁻¹ ^ 2) (t ^ 5) := by
            simpa using hasDerivAt_inv (pow_ne_zero 5 ht)
          have h_chain : HasDerivAt (fun s : ℝ => (s ^ 5)⁻¹) ((-(t ^ 5)⁻¹ ^ 2) * (5 * t ^ 4)) t :=
            HasDerivAt.comp (x := t) h_inv h_comp
          have h_simp : (-(t ^ 5)⁻¹ ^ 2) * (5 * t ^ 4) = -5 * (t ^ 6)⁻¹ := by
            field_simp [ht]
          rw [h_simp] at h_chain
          exact h_chain
        have h_raw : HasDerivAt (fun s : ℝ => φ s * (s ^ 5)⁻¹) ((-t * φ t) * (t ^ 5)⁻¹ + φ t * (-5 * (t ^ 6)⁻¹)) t :=
          HasDerivAt.mul (hφ_deriv t) h_inv5
        have h_deriv_simp5 : ((-t * φ t) * (t ^ 5)⁻¹ + φ t * (-5 * (t ^ 6)⁻¹)) = (-(φ t / t ^ 4) - 5 * φ t / t ^ 6) := by
          field_simp [ht]; ring
        rw [h_deriv_simp5] at h_raw
        simpa [div_eq_mul_inv] using h_raw
      have h_deriv_φ_div_s7 (t : ℝ) (ht : t ≠ 0) : HasDerivAt (fun s : ℝ => φ s / s ^ 7) (-(φ t / t ^ 6) - 7 * φ t / t ^ 8) t := by
        have h_inv7 : HasDerivAt (fun s : ℝ => (s ^ 7)⁻¹) (-7 * (t ^ 8)⁻¹) t := by
          have h_comp : HasDerivAt (fun s : ℝ => s ^ 7) (7 * t ^ 6) t := by
            simpa using hasDerivAt_pow 7 t
          have h_inv : HasDerivAt (fun (v : ℝ) => v⁻¹) (-(t ^ 7)⁻¹ ^ 2) (t ^ 7) := by
            simpa using hasDerivAt_inv (pow_ne_zero 7 ht)
          have h_chain : HasDerivAt (fun s : ℝ => (s ^ 7)⁻¹) ((-(t ^ 7)⁻¹ ^ 2) * (7 * t ^ 6)) t :=
            HasDerivAt.comp (x := t) h_inv h_comp
          have h_simp : (-(t ^ 7)⁻¹ ^ 2) * (7 * t ^ 6) = -7 * (t ^ 8)⁻¹ := by
            field_simp [ht]
          rw [h_simp] at h_chain
          exact h_chain
        have h_raw : HasDerivAt (fun s : ℝ => φ s * (s ^ 7)⁻¹) ((-t * φ t) * (t ^ 7)⁻¹ + φ t * (-7 * (t ^ 8)⁻¹)) t :=
          HasDerivAt.mul (hφ_deriv t) h_inv7
        have h_deriv_simp7 : ((-t * φ t) * (t ^ 7)⁻¹ + φ t * (-7 * (t ^ 8)⁻¹)) = (-(φ t / t ^ 6) - 7 * φ t / t ^ 8) := by
          field_simp [ht]; ring
        rw [h_deriv_simp7] at h_raw
        simpa [div_eq_mul_inv] using h_raw
      -- Helper: for any R > x, prove the key inequality ∫_x^R φ ≥ φ(x)P(x) - φ(R)P(R)
      have h_key_ineq (R : ℝ) (hR_gt_x : x < R) : (∫ (s : ℝ) in x..R, φ s) ≥ φ x * P x - φ R * P R := by
        have hxR_pos (s : ℝ) (hs : s ∈ Set.uIcc x R) : 0 < s := by
          rcases Set.mem_uIcc.mp hs with (⟨hs_left, hs_right⟩ | ⟨hs_left', hs_right'⟩)
          · exact hx_pos.trans_le hs_left
          · have hR_pos : 0 < R := hx_pos.trans hR_gt_x
            have hs_pos : 0 < s := hR_pos.trans_le hs_left'
            exact hs_pos
        have h_deriv_φ_div_s_Icc (s : ℝ) (hs : s ∈ Set.uIcc x R) : HasDerivAt (fun u : ℝ => φ u / u) (-φ s - φ s / s^2) s :=
          h_deriv_φ_div_s s (ne_of_gt (hxR_pos s hs))
        have h_deriv_φ_div_s3_Icc (s : ℝ) (hs : s ∈ Set.uIcc x R) : HasDerivAt (fun u : ℝ => φ u / u^3) (-(φ s / s^2) - 3 * φ s / s^4) s :=
          h_deriv_φ_div_s3 s (ne_of_gt (hxR_pos s hs))
        have h_deriv_φ_div_s5_Icc (s : ℝ) (hs : s ∈ Set.uIcc x R) : HasDerivAt (fun u : ℝ => φ u / u^5) (-(φ s / s^4) - 5 * φ s / s^6) s :=
          h_deriv_φ_div_s5 s (ne_of_gt (hxR_pos s hs))
        have h_deriv_φ_div_s7_Icc (s : ℝ) (hs : s ∈ Set.uIcc x R) : HasDerivAt (fun u : ℝ => φ u / u^7) (-(φ s / s^6) - 7 * φ s / s^8) s :=
          h_deriv_φ_div_s7 s (ne_of_gt (hxR_pos s hs))
        have h_int_φ : IntervalIntegrable φ volume x R :=
          (h_cont_φ.continuousOn).intervalIntegrable
        have h_int_φ_div_s2 : IntervalIntegrable (fun s : ℝ => φ s / s ^ 2) volume x R := by
          refine (ContinuousOn.intervalIntegrable ?_)
          refine (h_cont_φ.continuousOn.div (continuousOn_id.pow 2) (fun s hs => ?_))
          exact pow_ne_zero 2 (ne_of_gt (hxR_pos s hs))
        have h_int_φ_div_s4 : IntervalIntegrable (fun s : ℝ => φ s / s ^ 4) volume x R := by
          refine (ContinuousOn.intervalIntegrable ?_)
          refine (h_cont_φ.continuousOn.div (continuousOn_id.pow 4) (fun s hs => ?_))
          exact pow_ne_zero 4 (ne_of_gt (hxR_pos s hs))
        have h_int_φ_div_s6 : IntervalIntegrable (fun s : ℝ => φ s / s ^ 6) volume x R := by
          refine (ContinuousOn.intervalIntegrable ?_)
          refine (h_cont_φ.continuousOn.div (continuousOn_id.pow 6) (fun s hs => ?_))
          exact pow_ne_zero 6 (ne_of_gt (hxR_pos s hs))
        have h_int_φ_div_s8 : IntervalIntegrable (fun s : ℝ => φ s / s ^ 8) volume x R := by
          refine (ContinuousOn.intervalIntegrable ?_)
          refine (h_cont_φ.continuousOn.div (continuousOn_id.pow 8) (fun s hs => ?_))
          exact pow_ne_zero 8 (ne_of_gt (hxR_pos s hs))
        -- Identity 1: ∫_x^R φ + ∫_x^R φ/s^2 = φ x / x - φ R / R
        have int_id1 : (∫ (s : ℝ) in x..R, φ s) + (∫ (s : ℝ) in x..R, φ s / s^2) = φ x / x - φ R / R := by
          have h_int : IntervalIntegrable (fun s : ℝ => -φ s - φ s / s ^ 2) volume x R :=
