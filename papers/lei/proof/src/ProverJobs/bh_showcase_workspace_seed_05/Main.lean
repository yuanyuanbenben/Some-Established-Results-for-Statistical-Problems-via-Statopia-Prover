        simpa [standardNormalUpperTail, μ, φ, x] using h
      unfold dobribanBin0PThreshold
      positivity
    · -- p_threshold_upper: h_s1 gives this after rewriting the definition
      -- dobribanBin0PThreshold = 2 * standardNormalUpperTail ((3642 : ℝ) / 1000)
      simpa [dobribanBin0PThreshold] using h_s1
    · -- null_tail_lower: h_s2 gives this after rewriting the definition
      simpa [dobribanBin0NullTail] using h_s2
    · -- z_mass_lower: (3989 : ℝ) / 1000000 ≤ dobribanBin0ZMass
      -- need h_s3 plus numeric bound on the density value; the density value comes from step s4's Taylor certificate
      have h_density_lower : (3989 : ℝ) / 10000 ≤ standardNormalDensity ((1 : ℝ) / 100) := by
        have h_sqrt2pi_lt : Real.sqrt (Real.pi * 2) < (100000/39893 : ℝ) := by
