  (∫⁻ ω, ENorm.enorm (signedRankStatistic X ω) ^ 2 ∂P) = ∫⁻ ω, ENNReal.ofReal ((signedRankStatistic X ω) ^ 2) ∂P :=
  by
  apply MeasureTheory.lintegral_congr_ae
  refine ae_of_all _ ?_
  intro ω
  have hnorm : |signedRankStatistic X ω| ^ 2 = (signedRankStatistic X ω) ^ 2 :=
    by
    by_cases h : 0 ≤ signedRankStatistic X ω
    · rw [abs_of_nonneg h]
    · have h' : signedRankStatistic X ω < 0 := lt_of_not_ge h
      rw [abs_of_neg h']
      ring
  calc
    ENorm.enorm (signedRankStatistic X ω) ^ 2 = (ENNReal.ofReal |signedRankStatistic X ω|) ^ 2 := by
      rw [Real.enorm_eq_ofReal_abs]
    _ = ENNReal.ofReal (|signedRankStatistic X ω| ^ 2) := by rw [← ENNReal.ofReal_pow (abs_nonneg _) 2]
