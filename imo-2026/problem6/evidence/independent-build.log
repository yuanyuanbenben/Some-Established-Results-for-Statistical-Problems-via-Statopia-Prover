    t⁻¹ • ((∑' m : ℕ, c m • (P t) ^ m) - (∑' m : ℕ, c m • A ^ m)) = ∑' m : ℕ, c m • (t⁻¹ • ((P t) ^ m - A ^ m)) :=
  by
  have hpow_le : ∀ n : ℕ, ∀ {a b : ℝ}, 0 ≤ a → a ≤ b → a ^ n ≤ b ^ n :=
    by
    intro n a b ha hab
    induction n with
    | zero => simp
    | succ n ih =>
      calc
        a ^ (n + 1) = a ^ n * a := by rw [pow_succ]
        _ ≤ b ^ n * b := mul_le_mul ih hab ha (pow_nonneg (le_trans ha hab) n)
  have hPC' : ∀ᶠ t in 𝓝[≠] 0, ‖P t‖ ≤ C₁ := by
    rw [eventually_nhdsWithin_iff]
    filter_upwards [hPC] with t ht
    intro hmem
    exact ht
  filter_upwards [hPC'] with t ht
  have hc_nonneg : ∀ m : ℕ, 0 ≤ c m := by
    intro m
    dsimp [c]
    positivity
  have hpow_norm_le : ∀ (x : Matrix (Fin n) (Fin n) ℝ) (m : ℕ), ‖x ^ (m + 1)‖ ≤ ‖x‖ ^ (m + 1) :=
    by
    intro x m
    induction m with
    | zero => simp
    | succ m ih =>
      calc
        ‖x ^ (m + 1 + 1)‖ = ‖x ^ (m + 1) * x‖ := by rw [← pow_succ]
