info: Statlib/StatFoundation/Probability/FDistribution.lean:89:2: 'have h_subst :
  (∫⁻ a in Set.Ici 0, ENNReal.ofReal (fPdfReal ν₁ ν₂ a) ∂volume) =
    ENNReal.ofReal (ν₂ / ν₁) * (∫⁻ u in Set.Ici 0, ENNReal.ofReal (fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u)) ∂volume) :=
  by
  calc
    (∫⁻ a in Set.Ici 0, ENNReal.ofReal (fPdfReal ν₁ ν₂ a) ∂volume) =
        ∫⁻ a, (Set.Ici 0).indicator (fun a : ℝ => ENNReal.ofReal (fPdfReal ν₁ ν₂ a)) a ∂volume :=
      by rw [← MeasureTheory.lintegral_indicator measurableSet_Ici]
    _ =
        ENNReal.ofReal (ν₂ / ν₁) *
          ∫⁻ a,
            (Set.Ici 0).indicator (fun a : ℝ => ENNReal.ofReal (fPdfReal ν₁ ν₂ a))
              a ∂(volume.map (fun u : ℝ => (ν₂ / ν₁) * u)) :=
      by
      conv_lhs => rw [← h_vol]
      rw [MeasureTheory.lintegral_smul_measure]
      simp
    _ =
        ENNReal.ofReal (ν₂ / ν₁) *
          ∫⁻ u, (Set.Ici 0).indicator (fun a : ℝ => ENNReal.ofReal (fPdfReal ν₁ ν₂ a)) ((ν₂ / ν₁) * u) ∂volume :=
      by
      congr 1
      rw [MeasureTheory.lintegral_map hGmeas hφmeas]
    _ = ENNReal.ofReal (ν₂ / ν₁) * (∫⁻ u in Set.Ici 0, ENNReal.ofReal (fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u)) ∂volume) :=
      by
      congr 1
      rw [←
        MeasureTheory.lintegral_indicator (s := Set.Ici 0) (f := fun u : ℝ =>
          ENNReal.ofReal (fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u))) measurableSet_Ici]
      apply MeasureTheory.lintegral_congr
      intro u
      by_cases hu : 0 ≤ u
      · have hφ : 0 ≤ (ν₂ / ν₁) * u := mul_nonneg (le_of_lt hc_pos) hu
        simp [Set.indicator, hu, hφ]
      · have hφ : ¬0 ≤ (ν₂ / ν₁) * u := by
          intro hnon
          have hc' : 0 < (ν₂ / ν₁)⁻¹ := inv_pos.mpr hc_pos
          have hmul : 0 ≤ (ν₂ / ν₁)⁻¹ * ((ν₂ / ν₁) * u) := mul_nonneg (le_of_lt hc') hnon
          have hu_nonneg : (0 : ℝ) ≤ u := by
            have h := hmul
            rw [← mul_assoc, inv_mul_cancel₀ hc_ne, one_mul] at h
            exact h
          exact hu hu_nonneg
        simp [Set.indicator, hu, hφ]' uses '⊢'!
