info: Statlib/StatFoundation/Probability/FDistribution.lean:56:2: 'have hmeasF : Measurable (fun a : ℝ => ENNReal.ofReal (fPdfReal ν₁ ν₂ a)) :=
  by
  unfold fPdfReal
  simp only [apply_ite, ENNReal.ofReal_zero]
  apply Measurable.ite measurableSet_Ici
  · have hν1a : Measurable (fun a : ℝ => ν₁ * a) := measurable_const.mul measurable_id
    have hpowa : Measurable (fun a : ℝ => (ν₁ * a) ^ ν₁) := Measurable.pow_const hν1a ν₁
    have hpowc : Measurable (fun a : ℝ => ν₂ ^ ν₂) := Measurable.pow_const measurable_const ν₂
    have hnum : Measurable (fun a : ℝ => (ν₁ * a) ^ ν₁ * ν₂ ^ ν₂) := hpowa.mul hpowc
    have hden : Measurable (fun a : ℝ => (ν₁ * a + ν₂) ^ (ν₁ + ν₂)) :=
      Measurable.pow_const (hν1a.add measurable_const) (ν₁ + ν₂)
    have hquot : Measurable (fun a : ℝ => ((ν₁ * a) ^ ν₁ * ν₂ ^ ν₂) / ((ν₁ * a + ν₂) ^ (ν₁ + ν₂))) := hnum.div hden
    have hsqrt : Measurable (fun a : ℝ => √(((ν₁ * a) ^ ν₁ * ν₂ ^ ν₂) / ((ν₁ * a + ν₂) ^ (ν₁ + ν₂)))) :=
      Real.continuous_sqrt.measurable.comp hquot
    have hΓ : Measurable (fun a : ℝ => a * (Real.Gamma (ν₁ / 2) * Real.Gamma (ν₂ / 2) / Real.Gamma ((ν₁ + ν₂) / 2))) :=
      measurable_id.mul measurable_const
    have h_inner :
      Measurable
        (fun a : ℝ =>
          √(((ν₁ * a) ^ ν₁ * ν₂ ^ ν₂) / ((ν₁ * a + ν₂) ^ (ν₁ + ν₂))) /
            (a * (Real.Gamma (ν₁ / 2) * Real.Gamma (ν₂ / 2) / Real.Gamma ((ν₁ + ν₂) / 2)))) :=
      hsqrt.div hΓ
    exact (ENNReal.measurable_ofReal.comp h_inner)
  · exact measurable_const' uses '⊢'!
