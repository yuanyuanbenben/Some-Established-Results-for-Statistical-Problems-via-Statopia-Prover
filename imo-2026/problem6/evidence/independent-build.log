info: Statlib/StatFoundation/Probability/FDistribution.lean:214:2: 'have h_ae : ∀ᵐ u ∂volume, u ∈ Set.Ici 0 → P u := by
  rw [ae_iff]
  have hsubset : {a : ℝ | ¬(a ∈ Set.Ici 0 → P a)} ⊆ {0} :=
    by
    intro a ha
    by_cases hz : a = 0
    · simp [hz]
    · exfalso
      have hmem : a ∈ Set.Ici 0 := by
        by_contra hnotmem
        exact ha (fun hm => False.elim (hnotmem hm))
      change 0 ≤ a at hmem
      have hpos : 0 < a := lt_of_le_of_ne hmem (Ne.symm hz)
      exact ha (fun _ => h_all a hpos)
  have hle : volume {a : ℝ | ¬(a ∈ Set.Ici 0 → P a)} ≤ 0 := by
    calc
      volume {a : ℝ | ¬(a ∈ Set.Ici 0 → P a)} ≤ volume ({0} : Set ℝ) := measure_mono hsubset
      _ = 0 := by simp
