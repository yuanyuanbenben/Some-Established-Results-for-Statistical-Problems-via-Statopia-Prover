            by
            rw [gaussianPDFReal]
            rw [hcv]
            simp
            congr 1
            rw [neg_div]
          _ = ENNReal.ofReal ((√(2 * Real.pi) * c⁻¹)⁻¹ * Real.exp (-(u ^ 2 * c ^ 2 / 2))) :=
            by
            congr 1
            rw [Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi) ((c⁻¹) ^ 2)]
            rw [hsqrt_v]
            rw [h_exp_arg]
          _ = ENNReal.ofReal ((√(2 * Real.pi))⁻¹ * c * Real.exp (-(u ^ 2 * c ^ 2 / 2))) :=
            by
            congr 1
            rw [mul_inv, inv_inv]
          _ = ENNReal.ofReal ((√(2 * Real.pi))⁻¹ * Real.exp (-(u ^ 2 * c ^ 2 / 2))) * ENNReal.ofReal c :=
            by
            rw [show
                (√(2 * Real.pi))⁻¹ * c * Real.exp (-(u ^ 2 * c ^ 2 / 2)) =
                  (√(2 * Real.pi))⁻¹ * Real.exp (-(u ^ 2 * c ^ 2 / 2)) * c
                by ring]
            rw [ENNReal.ofReal_mul]
            ·
              exact
                mul_nonneg (inv_nonneg.mpr (le_of_lt (Real.sqrt_pos.mpr (by positivity : 0 < 2 * Real.pi))))
                  (Real.exp_nonneg _)
          _ = ENNReal.ofReal (gaussianPDFReal 0 1 (u * c)) * ENNReal.ofReal c :=
            by
            congr 1
            rw [gaussianPDFReal]
            simp [mul_pow, mul_assoc]
            congr 1
            rw [neg_div]
          _ =
              ENNReal.ofReal (gaussianPDFReal 0 1 (u * (Real.sqrt w / Real.sqrt νr))) *
                ENNReal.ofReal (Real.sqrt w / Real.sqrt νr) :=
            by rw [← hcdef]
      · have hsqrt0 : Real.sqrt w = 0 := Real.sqrt_eq_zero_of_nonpos (le_of_not_gt hw)
        simp [hsqrt0, gaussianPDFReal, Real.toNNReal_of_nonneg]
          -- pointwise identity: χ²_ν(w) · φ_{ν/w}(u) = tPdfReal(ν,u) · γ((ν+1)/2, (1+u²/ν)/2, w)
          
    have hpt (w : ℝ) (hw : 0 < w) (u : ℝ) :
      gammaPDF (νr / 2) 2⁻¹ w * ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) =
        ENNReal.ofReal (tPdfReal νr u) * gammaPDF ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w :=
      by
      let c : ℝ := Real.sqrt w / Real.sqrt νr
      have hcdef : c = Real.sqrt w / Real.sqrt νr := rfl
      have hc : 0 < c := by
        dsimp [c]
        exact div_pos (Real.sqrt_pos.mpr hw) (Real.sqrt_pos.mpr hνrpos)
      have hcne : c ≠ 0 := ne_of_gt hc
      have hcv : (((c⁻¹) ^ 2).toNNReal : ℝ) = (c⁻¹) ^ 2 := by
        simp
        exact sq_nonneg c
      have hw' : 0 ≤ w := le_of_lt hw
      have hBpos : 0 < 1 + u ^ 2 / νr := by positivity
      have hB : 0 ≤ 1 + u ^ 2 / νr := le_of_lt hBpos
      have hsqrtν_pos : 0 < √νr := Real.sqrt_pos.mpr hνrpos
      have htPdf_nonneg : 0 ≤ tPdfReal νr u := by
        unfold tPdfReal
        have h1 : 0 ≤ Real.Gamma ((νr + 1) / 2) / (√(νr * Real.pi) * Real.Gamma (νr / 2)) := by
          exact
            div_nonneg (le_of_lt hΓb_pos)
              (mul_nonneg (le_of_lt (Real.sqrt_pos.mpr (mul_pos hνrpos Real.pi_pos))) (le_of_lt hΓa_pos))
        have h2 : 0 ≤ (1 + u ^ 2 / νr) ^ (-(νr + 1) / 2) := Real.rpow_nonneg hB _
        exact mul_nonneg h1 h2
      have h2inv : (2 : ℝ)⁻¹ ^ (νr / 2) = (2 : ℝ) ^ (-(νr / 2)) :=
        by
        rw [Real.inv_rpow (by norm_num : 0 ≤ (2 : ℝ)) (νr / 2)]
        rw [← Real.rpow_neg (by norm_num : 0 ≤ (2 : ℝ)) (νr / 2)]
      have h2b : (2 : ℝ) ^ (-(νr + 1) / 2) = (2 : ℝ) ^ (-(νr / 2)) * (2 : ℝ) ^ (-(1 / 2 : ℝ)) :=
        by
        rw [← Real.rpow_add (by norm_num : 0 < (2 : ℝ)) (-(νr / 2)) (-(1 / 2 : ℝ))]
        congr 1
        ring
      have h2invhalf : (2 : ℝ) ^ (-(1 / 2 : ℝ)) = (√2)⁻¹ :=
        by
        rw [Real.rpow_neg (by norm_num : 0 ≤ (2 : ℝ)) (1 / 2 : ℝ)]
        rw [← Real.sqrt_eq_rpow (2 : ℝ)]
      have hsqrt2π : √(2 * Real.pi) = √2 * √Real.pi := by rw [Real.sqrt_mul (by norm_num : 0 ≤ (2 : ℝ)) Real.pi]
      have hsqrtνπ : √(νr * Real.pi) = √νr * √Real.pi := by rw [Real.sqrt_mul hνrpos.le Real.pi]
      have hwpow : w ^ (νr / 2 - 1) * √w = w ^ ((νr - 1) / 2) :=
        by
        rw [Real.sqrt_eq_rpow]
        rw [← Real.rpow_add hw]
        congr 1
        ring
      have hwpow2 : w ^ (νr / 2 - 1) * (√w / √νr) = w ^ ((νr - 1) / 2) * (√νr)⁻¹ := by
        calc
          w ^ (νr / 2 - 1) * (√w / √νr) = (w ^ (νr / 2 - 1) * √w) / √νr := by ring
          _ = w ^ ((νr - 1) / 2) / √νr := by rw [hwpow]
          _ = w ^ ((νr - 1) / 2) * (√νr)⁻¹ := by rw [div_eq_mul_inv]
      have hc_inv_sq : (c⁻¹) ^ 2 = νr / w := by
        rw [hcdef]
        have h1 : (√w / √νr)⁻¹ = √νr / √w := by field_simp [ne_of_gt (Real.sqrt_pos.mpr hw), ne_of_gt hsqrtν_pos]
        rw [h1]
        rw [div_pow]
        rw [Real.sq_sqrt hνrpos.le, Real.sq_sqrt hw']
      have hsqrt_inv : (√(2 * Real.pi * (c⁻¹) ^ 2))⁻¹ = (√(2 * Real.pi))⁻¹ * c :=
        by
        rw [Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi) ((c⁻¹) ^ 2)]
        rw [Real.sqrt_sq_eq_abs]
        rw [abs_of_pos (inv_pos.mpr hc)]
        rw [mul_inv]
        rw [inv_inv]
      have h_exparg : u ^ 2 / (2 * (c⁻¹) ^ 2) = u ^ 2 * w / (2 * νr) :=
        by
        rw [hc_inv_sq]
        field_simp [hw.ne', ne_of_gt hνrpos, (by norm_num : (2 : ℝ) ≠ 0)]
      have h_expcomb :
        Real.exp (-(2⁻¹ * w)) * Real.exp (-(u ^ 2 * w / (2 * νr))) = Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
        by
        rw [← Real.exp_add]
        congr 1
        ring
      have hrpow : (1 + u ^ 2 / νr) ^ (-(νr + 1) / 2) * ((1 + u ^ 2 / νr) / 2) ^ ((νr + 1) / 2) = 2 ^ (-(νr + 1) / 2) :=
        by
        rw [show (1 + u ^ 2 / νr) / 2 = (1 + u ^ 2 / νr) * 2⁻¹ by ring]
        rw [Real.mul_rpow hB (by norm_num : 0 ≤ (2⁻¹ : ℝ))]
        rw [Real.inv_rpow (by norm_num : 0 ≤ (2 : ℝ)) ((νr + 1) / 2)]
        rw [← Real.rpow_neg (by norm_num : 0 ≤ (2 : ℝ)) ((νr + 1) / 2)]
        rw [← mul_assoc]
        rw [← Real.rpow_add hBpos]
        rw [show -(νr + 1) / 2 + (νr + 1) / 2 = 0 by ring]
        rw [Real.rpow_zero]
        ring
      have hconst2 :
        2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * (√(2 * Real.pi))⁻¹ * (√νr)⁻¹ =
          2 ^ (-(νr + 1) / 2) / (√(νr * Real.pi) * Real.Gamma (νr / 2)) :=
        by
        rw [h2inv]
        rw [h2b]
        rw [h2invhalf]
        rw [hsqrt2π]
        rw [hsqrtνπ]
        field_simp [hΓa_pos.ne', ne_of_gt hsqrtν_pos, ne_of_gt (Real.sqrt_pos.mpr Real.pi_pos),
          ne_of_gt (Real.sqrt_pos.mpr (by norm_num : 0 < (2 : ℝ)))]
      have hwprod :
        w ^ (νr / 2 - 1) * (√(2 * Real.pi))⁻¹ * (√w / √νr) = (√(2 * Real.pi))⁻¹ * (√νr)⁻¹ * w ^ ((νr - 1) / 2) := by
        calc
          w ^ (νr / 2 - 1) * (√(2 * Real.pi))⁻¹ * (√w / √νr) = (√(2 * Real.pi))⁻¹ * w ^ (νr / 2 - 1) * (√w / √νr) := by
            ring
          _ = (√(2 * Real.pi))⁻¹ * (w ^ (νr / 2 - 1) * (√w / √νr)) := by ring
          _ = (√(2 * Real.pi))⁻¹ * (w ^ ((νr - 1) / 2) * (√νr)⁻¹) := by rw [hwpow2]
          _ = (√(2 * Real.pi))⁻¹ * (√νr)⁻¹ * w ^ ((νr - 1) / 2) := by ring
      have hrR :
        tPdfReal νr u * gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w =
          2 ^ (-(νr + 1) / 2) / (√(νr * Real.pi) * Real.Gamma (νr / 2)) * w ^ ((νr - 1) / 2) *
            Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
        by
        calc
          tPdfReal νr u * gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w =
              (Real.Gamma ((νr + 1) / 2) / (√(νr * Real.pi) * Real.Gamma (νr / 2)) *
                  (1 + u ^ 2 / νr) ^ (-(νr + 1) / 2)) *
                ((((1 + u ^ 2 / νr) / 2) ^ ((νr + 1) / 2) / Real.Gamma ((νr + 1) / 2)) * w ^ ((νr + 1) / 2 - 1) *
                  Real.exp (-(((1 + u ^ 2 / νr) / 2) * w))) :=
            by
            rw [tPdfReal, gammaPDFReal]
            rw [if_pos hw']
          _ =
              (1 + u ^ 2 / νr) ^ (-(νr + 1) / 2) * ((1 + u ^ 2 / νr) / 2) ^ ((νr + 1) / 2) /
                    (√(νr * Real.pi) * Real.Gamma (νr / 2)) *
                  w ^ ((νr - 1) / 2) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by
            field_simp [hΓb_pos.ne', hΓa_pos.ne', ne_of_gt (Real.sqrt_pos.mpr (mul_pos hνrpos Real.pi_pos))]
            exact congrArg (fun e : ℝ => w ^ e) (by ring)
          _ =
              2 ^ (-(νr + 1) / 2) / (√(νr * Real.pi) * Real.Gamma (νr / 2)) * w ^ ((νr - 1) / 2) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by rw [hrpow]
      have hr :
        gammaPDFReal (νr / 2) 2⁻¹ w * gaussianPDFReal 0 (((c⁻¹) ^ 2).toNNReal) u =
          tPdfReal νr u * gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w :=
        by
        calc
          gammaPDFReal (νr / 2) 2⁻¹ w * gaussianPDFReal 0 (((c⁻¹) ^ 2).toNNReal) u =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * w ^ (νr / 2 - 1) * Real.exp (-(2⁻¹ * w)) *
                  (√(2 * Real.pi * (c⁻¹) ^ 2))⁻¹ *
                Real.exp (-(u ^ 2 / (2 * (c⁻¹) ^ 2))) :=
            by
            rw [gammaPDFReal, gaussianPDFReal]
            rw [if_pos hw']
            rw [hcv]
            ring_nf
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * w ^ (νr / 2 - 1) * Real.exp (-(2⁻¹ * w)) * (√(2 * Real.pi))⁻¹ * c *
                Real.exp (-(u ^ 2 / (2 * (c⁻¹) ^ 2))) :=
            by
            rw [hsqrt_inv]
            ring
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * w ^ (νr / 2 - 1) * Real.exp (-(2⁻¹ * w)) * (√(2 * Real.pi))⁻¹ *
                  (√w / √νr) *
                Real.exp (-(u ^ 2 * w / (2 * νr))) :=
            by
            rw [hcdef]
            rw [h_exparg]
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * w ^ (νr / 2 - 1) * (√(2 * Real.pi))⁻¹ * (√w / √νr) *
                (Real.exp (-(2⁻¹ * w)) * Real.exp (-(u ^ 2 * w / (2 * νr)))) :=
            by ring_nf
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * w ^ (νr / 2 - 1) * (√(2 * Real.pi))⁻¹ * (√w / √νr) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by rw [h_expcomb]
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * (w ^ (νr / 2 - 1) * (√(2 * Real.pi))⁻¹ * (√w / √νr)) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by ring
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * ((√(2 * Real.pi))⁻¹ * (√νr)⁻¹ * w ^ ((νr - 1) / 2)) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by rw [hwprod]
          _ =
              2⁻¹ ^ (νr / 2) / Real.Gamma (νr / 2) * (√(2 * Real.pi))⁻¹ * (√νr)⁻¹ * w ^ ((νr - 1) / 2) *
                Real.exp (-(((1 + u ^ 2 / νr) / 2) * w)) :=
            by ring
          _ = tPdfReal νr u * gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w :=
            by
            rw [hrR]
            rw [hconst2]
      calc
        gammaPDF (νr / 2) 2⁻¹ w *
              ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) =
            gammaPDF (νr / 2) 2⁻¹ w * ENNReal.ofReal (gaussianPDFReal 0 (((c⁻¹) ^ 2).toNNReal) u) :=
          by rw [← hcdef]
        _ =
            ENNReal.ofReal (gammaPDFReal (νr / 2) 2⁻¹ w) *
              ENNReal.ofReal (gaussianPDFReal 0 (((c⁻¹) ^ 2).toNNReal) u) :=
          by simp [gammaPDF]
        _ = ENNReal.ofReal (gammaPDFReal (νr / 2) 2⁻¹ w * gaussianPDFReal 0 (((c⁻¹) ^ 2).toNNReal) u) :=
          by
          rw [ENNReal.ofReal_mul]
          exact gammaPDFReal_nonneg (by positivity : 0 < νr / 2) (by positivity : 0 < (2⁻¹ : ℝ)) w
        _ = ENNReal.ofReal (tPdfReal νr u * gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w) := by rw [hr]
        _ = ENNReal.ofReal (tPdfReal νr u) * ENNReal.ofReal (gammaPDFReal ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w) :=
          by
          rw [ENNReal.ofReal_mul]
          exact htPdf_nonneg
        _ = ENNReal.ofReal (tPdfReal νr u) * gammaPDF ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w := by
          simp [gammaPDF]
            -- integrate w: ∫⁻ w, χ²_ν(w)·φ_{ν/w}(u) dw = tPdfReal(ν,u)
            
    have hcore (u : ℝ) :
      (∫⁻ w : ℝ,
          gammaPDF (νr / 2) 2⁻¹ w *
            ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) ∂ℙ) =
        ENNReal.ofReal (tPdfReal νr u) :=
      by
      calc
        (∫⁻ w : ℝ,
              gammaPDF (νr / 2) 2⁻¹ w *
                ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) ∂ℙ) =
            ∫⁻ w : ℝ, ENNReal.ofReal (tPdfReal νr u) * gammaPDF ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w ∂ℙ :=
          by
          apply lintegral_congr_ae
          filter_upwards [hsplit] with w hw
          rcases hw with hwpos | hwneg
          · exact hpt w hwpos u
          · have hγ0 : gammaPDF (νr / 2) 2⁻¹ w = 0 := gammaPDF_of_neg hwneg
            have hγ20 : gammaPDF ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w = 0 := gammaPDF_of_neg hwneg
            simp [hγ0, hγ20]
        _ = ENNReal.ofReal (tPdfReal νr u) * (∫⁻ w : ℝ, gammaPDF ((νr + 1) / 2) ((1 + u ^ 2 / νr) / 2) w ∂ℙ) :=
          by
          rw [MeasureTheory.lintegral_const_mul]
          exact hmgammaR ((1 + u ^ 2 / νr) / 2)
        _ = ENNReal.ofReal (tPdfReal νr u) * 1 := by
          rw [ProbabilityTheory.lintegral_gammaPDF_eq_one (by positivity : 0 < (νr + 1) / 2)
              (by positivity : 0 < (1 + u ^ 2 / νr) / 2)]
        _ = ENNReal.ofReal (tPdfReal νr u) := by simp
    let F2 : ℝ × ℝ → ENNReal := fun p : ℝ × ℝ =>
      s.indicator (fun _ => (1 : ENNReal)) p.2 *
        (gammaPDF (νr / 2) 2⁻¹ p.1 *
          ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt p.1 / Real.sqrt νr)⁻¹) ^ 2).toNNReal) p.2))
    have hF2meas : Measurable F2 :=
      by
      let f' : ℝ × ℝ → ENNReal := fun p : ℝ × ℝ =>
        s.indicator (fun _ => (1 : ENNReal)) p.2 *
          (gammaPDF (νr / 2) 2⁻¹ p.1 * ENNReal.ofReal (gaussianPDFReal 0 1 (p.2 * (Real.sqrt p.1 / Real.sqrt νr))) *
            ENNReal.ofReal (Real.sqrt p.1 / Real.sqrt νr))
      have hF' : Measurable f' := by
        dsimp [f']
        have hsqrtcomp : Measurable (fun p : ℝ × ℝ => Real.sqrt p.1 / Real.sqrt νr) :=
          (Real.continuous_sqrt.measurable.comp measurable_fst).div measurable_const
        have hgausscomp :
          Measurable (fun p : ℝ × ℝ => ENNReal.ofReal (gaussianPDFReal 0 1 (p.2 * (Real.sqrt p.1 / Real.sqrt νr)))) :=
          (ENNReal.measurable_ofReal.comp (ProbabilityTheory.measurable_gaussianPDFReal 0 1)).comp
            (measurable_snd.mul hsqrtcomp)
        simpa [mul_assoc] using
          (((measurable_const.indicator hs).comp measurable_snd).mul
            ((hmgamma.comp measurable_fst).mul (hgausscomp.mul (ENNReal.measurable_ofReal.comp hsqrtcomp))))
      have h_eq : F2 = f' := by
        funext p
        dsimp [F2, f']
        rw [hscaling p.1 p.2]
        simp [mul_assoc, mul_comm, mul_left_comm]
      rw [h_eq]
      exact hF'
    have hA2E : AEMeasurable F2 (Measure.prod ℙ ℙ) := hF2meas.aemeasurable
    have hA2E2 : AEMeasurable (fun p : ℝ × ℝ => F2 p.swap) (Measure.prod ℙ ℙ) := AEMeasurable.prod_swap hA2E
    have hM (u : ℝ) :
      Measurable
        (fun w : ℝ =>
          gammaPDF (νr / 2) 2⁻¹ w *
            ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u)) :=
      by
      let f' : ℝ → ENNReal := fun w : ℝ =>
        gammaPDF (νr / 2) 2⁻¹ w * ENNReal.ofReal (gaussianPDFReal 0 1 (u * (Real.sqrt w / Real.sqrt νr))) *
          ENNReal.ofReal (Real.sqrt w / Real.sqrt νr)
      have hM' : Measurable f' := by
        dsimp [f']
        have hsqrtcomp : Measurable (fun w : ℝ => Real.sqrt w / Real.sqrt νr) :=
          (Real.continuous_sqrt.measurable.comp measurable_id).div measurable_const
        have hgausscomp :
          Measurable (fun w : ℝ => ENNReal.ofReal (gaussianPDFReal 0 1 (u * (Real.sqrt w / Real.sqrt νr)))) :=
          (ENNReal.measurable_ofReal.comp (ProbabilityTheory.measurable_gaussianPDFReal 0 1)).comp
            (measurable_const.mul hsqrtcomp)
        simpa [mul_assoc] using (hmgamma.mul (hgausscomp.mul (ENNReal.measurable_ofReal.comp hsqrtcomp)))
      have h_eq :
        (fun w : ℝ =>
            gammaPDF (νr / 2) 2⁻¹ w *
              ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u)) =
          f' :=
        by
        funext w
        dsimp [f']
        rw [hscaling w u]
        simp [mul_assoc, mul_comm, mul_left_comm]
      rw [h_eq]
      exact hM'
    calc
      (∫⁻ w : ℝ,
            gammaPDF (νr / 2) 2⁻¹ w *
              (∫⁻ u in s,
                ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) ∂ℙ) ∂ℙ) =
          ∫⁻ w : ℝ,
            ∫⁻ u : ℝ,
              s.indicator (fun _ => (1 : ENNReal)) u *
                (gammaPDF (νr / 2) 2⁻¹ w *
                  ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u)) ∂ℙ ∂ℙ :=
        by
        apply lintegral_congr
        intro w
        calc
          gammaPDF (νr / 2) 2⁻¹ w *
                (∫⁻ u in s, ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) ∂ℙ) =
              gammaPDF (νr / 2) 2⁻¹ w *
                (∫⁻ u : ℝ,
                  s.indicator (fun _ => (1 : ENNReal)) u *
                    ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u) ∂ℙ) :=
            by
            rw [← MeasureTheory.lintegral_indicator hs]
            exact
              congrArg (fun x : ENNReal => gammaPDF (νr / 2) 2⁻¹ w * x)
                (by
                  apply lintegral_congr
                  intro a
                  by_cases ha : a ∈ s <;> simp [Set.indicator, ha])
          _ =
              ∫⁻ u : ℝ,
                gammaPDF (νr / 2) 2⁻¹ w *
                  (s.indicator (fun _ => (1 : ENNReal)) u *
                    ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u)) ∂ℙ :=
            by
            rw [← MeasureTheory.lintegral_const_mul]
            exact (measurable_const.indicator hs).mul (hφRealmeas ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal))
          _ =
              ∫⁻ u : ℝ,
                s.indicator (fun _ => (1 : ENNReal)) u *
                  (gammaPDF (νr / 2) 2⁻¹ w *
                    ENNReal.ofReal (gaussianPDFReal 0 ((((Real.sqrt w / Real.sqrt νr)⁻¹) ^ 2).toNNReal) u)) ∂ℙ :=
            by
            apply lintegral_congr
