info: Statlib/StatFoundation/Probability/FDistribution.lean:144:2: 'have h_all :
  ∀ u : ℝ,
    0 < u →
      ENNReal.ofReal (ν₂ / ν₁) * ENNReal.ofReal (fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u)) =
        ENNReal.ofReal (u ^ (ν₁ / 2 - 1) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * G)) :=
  by
  intro u hu
  have h1p : 0 < 1 + u := by linarith
  have hB_ne : (1 + u) ^ ((ν₁ + ν₂) / 2) ≠ 0 := (Real.rpow_pos_of_pos h1p ((ν₁ + ν₂) / 2)).ne'
  have hx : 0 ≤ (ν₂ / ν₁) * u := le_of_lt (mul_pos hc_pos hu)
  have hcu_ne : (ν₂ / ν₁) * u ≠ 0 := mul_ne_zero hc_ne hu.ne'
  have hnum1 : ν₁ * ((ν₂ / ν₁) * u) = ν₂ * u := by field_simp [hν₁_pos.ne']
  have hden1 : ν₁ * ((ν₂ / ν₁) * u) + ν₂ = ν₂ * (1 + u) :=
    by
    rw [hnum1]
    ring
  have hcore :
    ((ν₁ * ((ν₂ / ν₁) * u)) ^ ν₁ * ν₂ ^ ν₂) / ((ν₁ * ((ν₂ / ν₁) * u) + ν₂) ^ (ν₁ + ν₂)) =
      u ^ ν₁ / (1 + u) ^ (ν₁ + ν₂) :=
    by
    rw [hden1, hnum1]
    rw [Real.mul_rpow (le_of_lt hν₂_pos) hu.le]
    rw [Real.mul_rpow (le_of_lt hν₂_pos) (le_of_lt h1p)]
    rw [Real.rpow_add hν₂_pos ν₁ ν₂]
    have hν2p₁ : 0 < ν₂ ^ ν₁ := Real.rpow_pos_of_pos hν₂_pos ν₁
    have hν2p₂ : 0 < ν₂ ^ ν₂ := Real.rpow_pos_of_pos hν₂_pos ν₂
    have h1pp : 0 < (1 + u) ^ (ν₁ + ν₂) := Real.rpow_pos_of_pos h1p (ν₁ + ν₂)
    field_simp [hν2p₁.ne', hν2p₂.ne', h1pp.ne']
  have hsqrt : √(u ^ ν₁ / (1 + u) ^ (ν₁ + ν₂)) = u ^ (ν₁ / 2) / (1 + u) ^ ((ν₁ + ν₂) / 2) :=
    by
    rw [Real.sqrt_eq_rpow]
    rw [Real.div_rpow (le_of_lt (Real.rpow_pos_of_pos hu ν₁)) (le_of_lt (Real.rpow_pos_of_pos h1p (ν₁ + ν₂))) (1 / 2)]
    rw [← Real.rpow_mul hu.le ν₁ (1 / 2)]
    rw [← Real.rpow_mul (le_of_lt h1p) (ν₁ + ν₂) (1 / 2)]
    have he1 : ν₁ * (1 / 2 : ℝ) = ν₁ / 2 := by ring
    have he2 : (ν₁ + ν₂) * (1 / 2 : ℝ) = (ν₁ + ν₂) / 2 := by ring
    rw [he1, he2]
  have hf : fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u) = u ^ (ν₁ / 2) / ((1 + u) ^ ((ν₁ + ν₂) / 2)) / (((ν₂ / ν₁) * u) * G) :=
    by
    unfold fPdfReal
    rw [if_pos hx]
    congr 1
    · rw [hcore]
      exact hsqrt
  have h_rat :
    (ν₂ / ν₁) * (u ^ (ν₁ / 2) / ((1 + u) ^ ((ν₁ + ν₂) / 2)) / (((ν₂ / ν₁) * u) * G)) =
      u ^ (ν₁ / 2 - 1) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * G) :=
    by
    have h1 :
      (ν₂ / ν₁) * (u ^ (ν₁ / 2) / ((1 + u) ^ ((ν₁ + ν₂) / 2)) / (((ν₂ / ν₁) * u) * G)) =
        u ^ (ν₁ / 2) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * (u * G)) :=
      by field_simp [hc_ne, hu.ne', hcu_ne, hB_ne, hG_ne]
    rw [h1]
    rw [show u ^ (ν₁ / 2) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * (u * G)) = (u ^ (ν₁ / 2) / u) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * G)
        by field_simp [hu.ne', hB_ne, hG_ne]]
    rw [show u ^ (ν₁ / 2) / u = u ^ (ν₁ / 2 - 1) by rw [Real.rpow_sub hu (ν₁ / 2) 1, Real.rpow_one]]
  calc
    ENNReal.ofReal (ν₂ / ν₁) * ENNReal.ofReal (fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u)) =
        ENNReal.ofReal ((ν₂ / ν₁) * fPdfReal ν₁ ν₂ ((ν₂ / ν₁) * u)) :=
      by rw [← ENNReal.ofReal_mul (le_of_lt hc_pos)]
    _ = ENNReal.ofReal (u ^ (ν₁ / 2 - 1) / ((1 + u) ^ ((ν₁ + ν₂) / 2) * G)) :=
      by
      congr 1
      rw [hf, h_rat]' uses '⊢'!
