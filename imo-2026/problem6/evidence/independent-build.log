warning: Statlib/HypothesisTesting/Nonparametric/MannWhitney.lean:2048:2: '/-- Wilcoxon rank-sum variance: Var[W] = m·n·(m+n+1)/12 where W = rankSum X Y is the sum
  of the ranks of the Y-observations in the pooled sample (ranks from 1, ties counted by
  strict <).

  Under the null that both samples are i.i.d. from a common atomless distribution and are
  jointly independent at the vector level, Var[W] = m·n·(m+n+1)/12. The proof reduces Var[W]
  to Var[U] via the affine identity W = mn − U + n(n+1)/2 (`rank_sum_eq_mn_sub_u`) and the
  affine-invariance of the variance (`variance_congr` + `variance_const_sub`), then reuses
  `mann_whitney_u_variance`. -/
theorem wilcoxon_rank_sum_variance {Ω : Type*} [MeasurableSpace Ω] {m n : ℕ} [NeZero m] [NeZero n] (P : Measure Ω)
    [IsProbabilityMeasure P] (X : Fin m → Ω → ℝ) (hXmeas : ∀ i : Fin m, Measurable (X i)) (Y : Fin n → Ω → ℝ)
    (hYmeas : ∀ j : Fin n, Measurable (Y j)) (hXindep : iIndepFun X P) (hYindep : iIndepFun Y P)
    (hXid : ∀ i j : Fin m, Measure.map (X i) P = Measure.map (X j) P)
    (hYid : ∀ i j : Fin n, Measure.map (Y i) P = Measure.map (Y j) P)
    (hXYindep : IndepFun (fun ω i => X i ω) (fun ω j => Y j ω) P) (hnull : Measure.map (X 0) P = Measure.map (Y 0) P)
    (hNoTieXY : P {ω | X 0 ω = Y 0 ω} = 0) (hNoTieY : ∀ j j' : Fin n, j ≠ j' → P {ω | Y j ω = Y j' ω} = 0) :
    ProbabilityTheory.variance (fun ω => (rankSum X Y ω : ℝ)) P = (m * n * (m + n + 1) : ℝ) / 12 :=
  by
  have hTieXY_meas : ∀ i : Fin m, ∀ j : Fin n, P {ω | X i ω = Y j ω} = 0 :=
    by
    intro i j
    have hXYpt : IndepFun (X i) (Y j) P := by
      exact
        IndepFun.comp (β := Fin m → ℝ) (β' := Fin n → ℝ) (γ := ℝ) (γ' := ℝ) (f := fun ω : Ω => fun k : Fin m => X k ω)
          (g := fun ω : Ω => fun k : Fin n => Y k ω) (φ := fun v : Fin m → ℝ => v i) (ψ := fun v : Fin n → ℝ => v j)
          hXYindep (measurable_pi_apply i) (measurable_pi_apply j)
    have hXYpt00 : IndepFun (X 0) (Y 0) P := by
      exact
        IndepFun.comp (β := Fin m → ℝ) (β' := Fin n → ℝ) (γ := ℝ) (γ' := ℝ) (f := fun ω : Ω => fun k : Fin m => X k ω)
          (g := fun ω : Ω => fun k : Fin n => Y k ω) (φ := fun v : Fin m → ℝ => v 0) (ψ := fun v : Fin n → ℝ => v 0)
          hXYindep (measurable_pi_apply 0) (measurable_pi_apply 0)
    have hjoint_ij : Measure.map (fun ω => (X i ω, Y j ω)) P = (Measure.map (X i) P).prod (Measure.map (Y j) P) := by
      exact
        Statlib.HypothesisTesting.indepFun_map_pair (P := P) (X := X i) (Y := Y j) (hXmeas i).aemeasurable
          (hYmeas j).aemeasurable hXYpt
    have hjoint_00 : Measure.map (fun ω => (X 0 ω, Y 0 ω)) P = (Measure.map (X 0) P).prod (Measure.map (Y 0) P) := by
      exact
        Statlib.HypothesisTesting.indepFun_map_pair (P := P) (X := X 0) (Y := Y 0) (hXmeas 0).aemeasurable
          (hYmeas 0).aemeasurable hXYpt00
    have hjoint_eq : Measure.map (fun ω => (X i ω, Y j ω)) P = Measure.map (fun ω => (X 0 ω, Y 0 ω)) P :=
      by
      rw [hjoint_ij, hjoint_00]
      rw [hXid i 0, hYid 0 j, hnull]
    have hdiag_meas : MeasurableSet {p : ℝ × ℝ | p.1 = p.2} := by
      exact measurableSet_eq_fun measurable_fst measurable_snd
    have hjoint_meas_ij : Measurable (fun ω : Ω => (X i ω, Y j ω)) := by exact (hXmeas i).prod (hYmeas j)
    have hjoint_meas_00 : Measurable (fun ω : Ω => (X 0 ω, Y 0 ω)) := by exact (hXmeas 0).prod (hYmeas 0)
    calc
      P {ω | X i ω = Y j ω} = (Measure.map (fun ω => (X i ω, Y j ω)) P) {p : ℝ × ℝ | p.1 = p.2} :=
        by
        rw [MeasureTheory.Measure.map_apply hjoint_meas_ij hdiag_meas]
        rfl
      _ = (Measure.map (fun ω => (X 0 ω, Y 0 ω)) P) {p : ℝ × ℝ | p.1 = p.2} := by rw [hjoint_eq]
      _ = P {ω | X 0 ω = Y 0 ω} :=
        by
        rw [MeasureTheory.Measure.map_apply hjoint_meas_00 hdiag_meas]
        rfl
      _ = 0 := hNoTieXY
  have hXYne_ae : ∀ᵐ ω ∂P, ∀ i : Fin m, ∀ j : Fin n, X i ω ≠ Y j ω :=
    by
    rw [ae_iff]
    have hset : {ω | ¬∀ (i : Fin m) (j : Fin n), X i ω ≠ Y j ω} = ⋃ i : Fin m, ⋃ j : Fin n, {ω | X i ω = Y j ω} :=
      by
      ext ω
      simp
    rw [hset]
    apply MeasureTheory.measure_iUnion_null
    intro i
    apply MeasureTheory.measure_iUnion_null
    intro j
    exact hTieXY_meas i j
  have hYne2_ae : ∀ᵐ ω ∂P, ∀ j : Fin n, ∀ j' : Fin n, j ≠ j' → Y j ω ≠ Y j' ω :=
    by
    rw [ae_iff]
    have hset :
      {ω | ¬∀ (j : Fin n) (j' : Fin n), j ≠ j' → Y j ω ≠ Y j' ω} =
        ⋃ j : Fin n, ⋃ j' : Fin n, {ω | j ≠ j' ∧ Y j ω = Y j' ω} :=
      by
      ext ω
      simp
    rw [hset]
    apply MeasureTheory.measure_iUnion_null
    intro j
    apply MeasureTheory.measure_iUnion_null
    intro j'
    by_cases hjj : j = j'
    · subst j'
      simp
    · exact MeasureTheory.measure_mono_null (by intro ω hω; exact hω.2) (hNoTieY j j' hjj)
  have hW_eq_ae :
    (fun ω => (rankSum X Y ω : ℝ)) =ᵐ[P]
      (fun ω => ((↑m * ↑n : ℤ) - (mannWhitneyU X Y ω : ℤ) + (↑n * (↑n + 1) / 2 : ℤ) : ℝ)) :=
    by
    filter_upwards [hXYne_ae, hYne2_ae] with ω hXYω hYω
    exact_mod_cast rank_sum_eq_mn_sub_u m n X Y ω hXYω hYω
  have hU_meas : Measurable (fun ω => (mannWhitneyU X Y ω : ℝ)) :=
    by
    have hU_eq_sum :
      (fun ω => (mannWhitneyU X Y ω : ℝ)) =
        (fun ω =>
          ∑ p ∈ ((Finset.univ : Finset (Fin m)).product (Finset.univ : Finset (Fin n))),
            if X p.1 ω > Y p.2 ω then (1 : ℝ) else 0) :=
      by
      funext ω
      rw [mannWhitneyU]
      rw [Finset.card_filter]
      norm_cast
    rw [hU_eq_sum]
    refine Finset.measurable_sum (s := ((Finset.univ : Finset (Fin m)).product (Finset.univ : Finset (Fin n)))) ?_
    intro p hp
    exact Measurable.ite (measurableSet_lt (hYmeas p.2) (hXmeas p.1)) measurable_const measurable_const
  have hU_aesm : AEStronglyMeasurable (fun ω => (mannWhitneyU X Y ω : ℝ)) P := hU_meas.aestronglyMeasurable
  have hAff :
    ProbabilityTheory.variance (fun ω => ((↑m * ↑n : ℤ) - (mannWhitneyU X Y ω : ℤ) + (↑n * (↑n + 1) / 2 : ℤ) : ℝ)) P =
      ProbabilityTheory.variance (fun ω => (mannWhitneyU X Y ω : ℝ)) P :=
    by
    have hpt :
      (fun ω => ((↑m * ↑n : ℤ) - (mannWhitneyU X Y ω : ℤ) + (↑n * (↑n + 1) / 2 : ℤ) : ℝ)) =
        (fun ω => ((↑m * ↑n : ℤ) : ℝ) - (mannWhitneyU X Y ω : ℝ) + (((↑n * (↑n + 1) / 2 : ℤ)) : ℝ)) :=
      by
      funext ω
      norm_cast
    rw [hpt]
    set A : ℝ := ((↑m * ↑n : ℤ) : ℝ)
    set B : ℝ := (((↑n * (↑n + 1) / 2 : ℤ)) : ℝ)
    have hpt2 : (fun ω => A - (mannWhitneyU X Y ω : ℝ) + B) = (fun ω => (A + B) - (mannWhitneyU X Y ω : ℝ)) :=
      by
      funext ω
      ring
    rw [hpt2]
    exact ProbabilityTheory.variance_const_sub (X := fun ω => (mannWhitneyU X Y ω : ℝ)) (μ := P) hU_aesm (A + B)
  calc
    ProbabilityTheory.variance (fun ω => (rankSum X Y ω : ℝ)) P =
        ProbabilityTheory.variance (fun ω => ((↑m * ↑n : ℤ) - (mannWhitneyU X Y ω : ℤ) + (↑n * (↑n + 1) / 2 : ℤ) : ℝ))
          P :=
      by exact ProbabilityTheory.variance_congr hW_eq_ae
    _ = ProbabilityTheory.variance (fun ω => (mannWhitneyU X Y ω : ℝ)) P := hAff
    _ = (m * n * (m + n + 1) : ℝ) / 12 := by
      exact
        mann_whitney_u_variance P X hXmeas Y hYmeas hXindep hYindep hXid hYid hXYindep hnull hTieXY_meas
          hNoTieXY' starts on column 2, but all commands should start at the beginning of the line.

